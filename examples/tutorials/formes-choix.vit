form Point {
    x: i64,
    y: i64,
}

pick Resultat {
    Ok(i64),
    Echec,
}

proc somme(point: Point) -> i64 {
    return point.x + point.y;
}

proc valeur(resultat: Resultat) -> i64 {
    match resultat {
        Resultat::Ok(nombre) => { return nombre; },
        Resultat::Echec => { return -1; },
    }
    return -2;
}

proc main() -> i64 {
    let point: Point = Point { x: 20, y: 22 };
    let resultat: Resultat = Resultat::Ok(42);

    if somme(point) == 42 and valeur(resultat) == 42 {
        return 0;
    }
    return 1;
}
