proc sous_total(prix: i64, quantite: i64) -> i64 {
    return prix * quantite;
}

proc avec_livraison(prix: i64, quantite: i64, livraison: i64) -> i64 {
    return sous_total(prix, quantite) + livraison;
}

proc main() -> i64 {
    if avec_livraison(6, 6, 6) == 42 {
        return 0;
    }
    return 1;
}
