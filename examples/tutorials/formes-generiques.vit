form Box<T> {
    value: T,
}

proc main() -> i64 {
    let boxed: Box<i64> = Box<i64> { value: 42 };
    let enabled: Box<bool> = Box<bool> { value: true };
    let count: Box<u64> = Box<u64> { value: 42 };
    let ratio: Box<f64> = Box<f64> { value: 4.5 };
    let label: Box<string> = Box<string> { value: "vitte" };
    let initial: Box<char> = Box<char> { value: 'V' };

    if not enabled.value {
        return 1;
    }
    if count.value != 42 {
        return 2;
    }
    if ratio.value != 4.5 {
        return 3;
    }
    if label.value != "vitte" {
        return 4;
    }
    if initial.value != 'V' {
        return 5;
    }
    return boxed.value - 42;
}
