proc main() -> i64 {
    let mut indice: i64 = 0;
    let mut total: i64 = 0;

    while indice < 6 {
        set indice += 1;
        if indice == 3 {
            continue;
        }
        if indice == 6 {
            break;
        }
        set total += indice;
    }

    if total == 12 {
        return 0;
    }
    return 1;
}
