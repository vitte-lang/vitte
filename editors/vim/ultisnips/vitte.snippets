# Vitte UltiSnips
# Filetype: vitte

snippet proc "Procedure"
proc ${1:name}(${2:value}: ${3:int}) -> ${4:void} {
    ${0}
}
endsnippet

snippet aproc "Async procedure"
async proc ${1:name}() {
    ${0}
}
endsnippet

snippet uproc "Unsafe procedure"
unsafe proc ${1:name}() {
    ${0}
}
endsnippet

snippet extern "Extern procedure"
extern "C" proc ${1:name}(${2:value}: ${3:int}) -> ${4:void};
endsnippet

snippet const "Constant"
const ${1:NAME}: ${2:int} = ${3:0};
endsnippet

snippet static "Static"
static ${1:name}: ${2:type} = ${3:value};
endsnippet

snippet let "Local binding"
let ${1:name}: ${2:type} = ${3:value};
endsnippet

snippet letm "Mutable local binding"
let mut ${1:name}: ${2:type} = ${3:value};
endsnippet

snippet set "Assignment"
set ${1:name} = ${2:value};
endsnippet

snippet form "Form"
form ${1:Name} {
    ${2:field}: ${3:type},
    ${0}
}
endsnippet

snippet pick "Pick"
pick ${1:Name} {
    ${2:Ready},
    ${3:Failed(${4:i32})},
}
endsnippet

snippet type "Type alias"
type ${1:Name} = ${2:type};
endsnippet

snippet opaque "Opaque type"
opaque ${1:Name};
endsnippet

snippet trait "Trait"
trait ${1:Name} {
    ${0}
}
endsnippet

snippet impl "Implementation"
impl ${1:Type} {
    ${0}
}
endsnippet

snippet match "Match"
match ${1:expr} {
    ${2:pattern} => ${3:expression},
    _ => ${0},
}
endsnippet

snippet if "If"
if ${1:condition} {
    ${0}
}
endsnippet

snippet ife "If / else"
if ${1:condition} {
    ${2}
} else {
    ${0}
}
endsnippet

snippet while "While loop"
while ${1:condition} {
    ${0}
}
endsnippet

snippet loop "Loop"
loop {
    ${0}
}
endsnippet

snippet for "For loop"
for ${1:item} in ${2:items} {
    ${0}
}
endsnippet

snippet unsafe "Unsafe block"
unsafe {
    ${0}
}
endsnippet

snippet defer "Defer"
defer {
    ${0}
}
endsnippet

snippet give "Return value"
give ${1:value};
endsnippet

snippet assert "Assertion"
assert(${1:condition});
endsnippet

snippet main "Entry procedure"
proc main() {
    ${0}
}
endsnippet

snippet use "Use module"
use ${1:module}::{${2:item}};
endsnippet

snippet export "Export"
export ${1:name};
endsnippet

snippet space "Space"
space ${1:app};
endsnippet

snippet test "Test"
test ${1:name} {
    ${0}
}
endsnippet

snippet macro "Macro"
macro ${1:name}(${2:value}: ${3:type}) {
    ${0}
}
endsnippet

snippet intrinsic "Intrinsic"
intrinsic ${1:name}(${2:value}: ${3:type}) -> ${4:void};
endsnippet

snippet asm "Assembly"
asm("${1:instruction}");
endsnippet
