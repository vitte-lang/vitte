# ============================================================
# Vitte UltiSnips
# Filetype: vitte
# ============================================================

snippet proc "Procedure"
proc ${1:name}(${2:args})${3: -> ${4:type}} {
    ${0}
}
endsnippet

snippet aproc "Async procedure"
async proc ${1:name}(${2:args})${3: -> ${4:type}} {
    ${0}
}
endsnippet

snippet uproc "Unsafe procedure"
unsafe proc ${1:name}(${2:args})${3: -> ${4:type}} {
    ${0}
}
endsnippet

snippet extern "Extern procedure"
extern proc ${1:name}(${2:args})${3: -> ${4:type}}
endsnippet

snippet const "Constant"
const ${1:NAME}: ${2:int} = ${3:0}
endsnippet

snippet static "Static"
static ${1:name}: ${2:type} = ${3:value}
endsnippet

snippet global "Global"
global ${1:name}: ${2:type} = ${3:value}
endsnippet

snippet let "Local binding"
let ${1:name}: ${2:type} = ${3:value}
endsnippet

snippet set "Assignment"
set ${1:name} = ${2:value}
endsnippet

snippet form "Form"
form ${1:Name} {
    ${0}
}
endsnippet

snippet field "Field"
field ${1:name}: ${2:type}
endsnippet

snippet pick "Pick"
pick ${1:Name} {
    case ${2:Variant}
    ${0}
}
endsnippet

snippet type "Type"
type ${1:Name} = ${2:type}
endsnippet

snippet opaque "Opaque type"
opaque type ${1:Name}
endsnippet

snippet trait "Trait"
trait ${1:Name} {
    ${0}
}
endsnippet

snippet impl "Trait implementation"
impl ${1:Trait} for ${2:Type} {
    ${0}
}
endsnippet

snippet match "Match"
match ${1:expr} {
    case ${2:pattern} {
        ${0}
    }
    otherwise {
    }
}
endsnippet

snippet if "If"
if ${1:condition} {
    ${0}
}
endsnippet

snippet ife "If / else"
if ${1:condition} {
    ${2}
} else {
    ${0}
}
endsnippet

snippet while "While loop"
while ${1:condition} {
    ${0}
}
endsnippet

snippet loop "Loop"
loop {
    ${0}
}
endsnippet

snippet for "For loop"
for ${1:item} in ${2:items} {
    ${0}
}
endsnippet

snippet select "Select"
select ${1:expr} {
    ${0}
}
endsnippet

snippet when "When"
when ${1:condition} {
    ${0}
}
endsnippet

snippet unsafe "Unsafe block"
unsafe {
    ${0}
}
endsnippet

snippet critical "Critical block"
critical {
    ${0}
}
endsnippet

snippet defer "Defer"
defer {
    ${0}
}
endsnippet

snippet try "Try"
try ${1:expr}
endsnippet

snippet give "Give"
give ${1:value}
endsnippet

snippet emit "Emit"
emit ${1:value}
endsnippet

snippet assert "Assertion"
assert ${1:condition}
endsnippet

snippet panic "Panic"
panic ${1:message}
endsnippet

snippet unreachable "Unreachable"
unreachable
endsnippet

snippet entry "Entry point"
entry ${1:main} at ${2:core/app} {
    ${0}
}
endsnippet

snippet use "Use module"
use ${1:vitte/core}
endsnippet

snippet export "Export"
export ${1:name}
endsnippet

snippet share "Share"
share ${1:name}
endsnippet

snippet space "Space"
space ${1:vitte/app}
endsnippet

snippet test "Test"
test ${1:name} {
    ${0}
}
endsnippet

snippet bench "Benchmark"
bench ${1:name} {
    ${0}
}
endsnippet

snippet query "Query"
query ${1:name} {
    ${0}
}
endsnippet

snippet macro "Macro"
macro ${1:name}(${2:args}) {
    ${0}
}
endsnippet

snippet intrinsic "Intrinsic"
intrinsic proc ${1:name}(${2:args})${3: -> ${4:type}}
endsnippet

snippet compiler "Compiler"
compiler ${1:name} {
    ${0}
}
endsnippet

snippet pass "Compiler pass"
pass ${1:name} {
    ${0}
}
endsnippet

snippet backend "Backend"
backend ${1:name} {
    ${0}
}
endsnippet

snippet diagnostic "Diagnostic"
diagnostic ${1:name} {
    ${0}
}
endsnippet

snippet asm "Assembly block"
asm {
    ${0}
}
endsnippet

snippet contract "ROLE-CONTRACT"
<<< ROLE-CONTRACT
package: ${1:vitte.app}
role: ${2:module-role}
source_of_truth: ${3:path/to/file.vit}
status: ${4:draft}
>>>
endsnippet
