## AUTO-GENERATED by tools/generate_editor_highlights.py; DO NOT EDIT
## Nano syntax highlighting for the Vitte programming language

syntax "vitte" "\.vit$" "\.vitl$" "\.vitte$"

comment "// "
tabgives "  "

# ============================================================================
# Core keywords
# ============================================================================

color brightcyan "\<(space|use|export|share|const|static|global|region|type|opaque|extern|form|pick|trait|impl|proc|intrinsic|compiler|query|pass|backend|diagnostic|macro|comptime|static_assert|test|bench|entry)\>"

color brightcyan "\<(pub|priv|unsafe|async|inline|noinline|naked|interrupt|where|effects|requires|operator|noexcept)\>"

color brightcyan "\<(as|for|at|let|set|give|try|defer|asm|emit|assert|panic|unreachable)\>"

color brightcyan "\<(if|elif|else|while|loop|in|break|continue|select|when|match|case|with|critical)\>"

color brightcyan "\<(mut|owned|borrow|move|await|not|and|or|is|self|ref|dyn)\>"

color brightcyan "\<(sizeof|alignof|offsetof|typeof|nameof|map|resource|volatile|atomic|user|kernel|phys|mmio|dma)\>"

# ============================================================================
# Declaration keywords
# ============================================================================

color white,blue "\<(space|use|export|share|const|static|global|region|type|opaque|extern|form|pick|trait|impl|proc|intrinsic|compiler|query|pass|backend|diagnostic|macro|comptime|static_assert|test|bench|entry)\>"

# ============================================================================
# Deprecated keywords
# ============================================================================

color brightred "\<(class|union|bits|flags)\>"

# ============================================================================
# Contextual keywords
# ============================================================================

color brightyellow "\<(C|sysv64|win64|package|module|super|stack|heap|arena|Self)\>"

# ============================================================================
# Declaration names
# ============================================================================

color brightblue "^[[:space:]]*proc[[:space:]]+[A-Za-z_][A-Za-z0-9_]*"

color brightblue "^[[:space:]]*intrinsic[[:space:]]+[A-Za-z_][A-Za-z0-9_]*"

color brightblue "^[[:space:]]*macro[[:space:]]+[A-Za-z_][A-Za-z0-9_]*"

color brightblue "^[[:space:]]*(compiler|query|pass|backend|diagnostic|comptime|test|bench|entry)[[:space:]]+[A-Za-z_][A-Za-z0-9_]*"

color brightblue "^[[:space:]]*(form|pick|trait|type|opaque)[[:space:]]+[A-Za-z_][A-Za-z0-9_]*"

# Deprecated declaration forms remain recognizable.
color red "^[[:space:]]*(class|union|bits|flags)[[:space:]]+[A-Za-z_][A-Za-z0-9_]*"

# ============================================================================
# Types
# ============================================================================

color brightblue "\<(void|never|unit|bool|char|rune|str|string|bytes|cstr|int)\>"

color brightblue "\<(i8|i16|i32|i64|i128|u8|u16|u32|u64|u128|usize|isize|intptr|uintptr)\>"

color brightblue "\<(f16|f32|f64|f128)\>"

color brightblue "\<(c_char|c_int|c_uint|c_long|c_ulong|c_void)\>"

# Compiler/frontend identifiers exposed by the tooling manifest.
color brightblue "\<(TokenId|NodeId|DefId|HirId|MirId|TypeId|SymbolId|ScopeId|BlockId|ValueId|InstrId)\>"

# ============================================================================
# Literals
# ============================================================================

color brightgreen "\<(true|false|null)\>"

# ============================================================================
# Numbers
# ============================================================================

# Hexadecimal.
color brightmagenta "\<0[xX][0-9A-Fa-f][0-9A-Fa-f_]*\>"

# Binary.
color brightmagenta "\<0[bB][01][01_]*\>"

# Octal.
color brightmagenta "\<0[oO][0-7][0-7_]*\>"

# Decimal integers.
color brightmagenta "\<[0-9][0-9_]*\>"

# Floating-point numbers.
color brightmagenta "\<[0-9][0-9_]*\.[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)?\>"

# Scientific notation without a decimal point.
color brightmagenta "\<[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*\>"

# Numeric literals with suffixes.
color brightmagenta "\<(0[xX][0-9A-Fa-f][0-9A-Fa-f_]*|0[bB][01][01_]*|0[oO][0-7][0-7_]*|[0-9][0-9_]*(\.[0-9][0-9_]*)?([eE][+-]?[0-9][0-9_]*)?)[A-Za-z][A-Za-z0-9]*\>"

# ============================================================================
# Strings / characters
# ============================================================================

color yellow start="\"" end="\""

color yellow start="'" end="'"

# Common escape sequences.
color brightyellow "\\(n|r|t|0|\"|'|\\)"

color brightyellow "\\x[0-9A-Fa-f][0-9A-Fa-f]"

color brightyellow "\\u\{[0-9A-Fa-f]+\}"

# ============================================================================
# Paths / namespaces
# ============================================================================

color cyan "\<space\>[[:space:]]+[A-Za-z_][A-Za-z0-9_./:]*"

color cyan "\<use\>[[:space:]]+[A-Za-z_][A-Za-z0-9_./:]*"

color cyan "\<share\>[[:space:]]+[A-Za-z_][A-Za-z0-9_./:]*"

color cyan "\<export\>[[:space:]]+[*A-Za-z0-9_./:]+"

# Import/cast aliases.
color magenta "\<as\>[[:space:]]+[A-Za-z_][A-Za-z0-9_]*"

# ============================================================================
# Bindings
# ============================================================================

color brightwhite "\<(let|const|static|global)\>[[:space:]]+(mut[[:space:]]+|owned[[:space:]]+|borrow[[:space:]]+|move[[:space:]]+|ref[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*"

color brightwhite "\<set\>[[:space:]]+[A-Za-z_][A-Za-z0-9_]*"

# ============================================================================
# Loops
# ============================================================================

color brightwhite "\<for\>[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]+in\>"

# ============================================================================
# Pattern matching
# ============================================================================

color brightwhite "\<(case|when)\>[[:space:]]+[A-Za-z_][A-Za-z0-9_]*"

# ============================================================================
# Parameters
# ============================================================================

color brightwhite "[(,][[:space:]]*[A-Za-z_][A-Za-z0-9_]*[[:space:]]*:"

# ============================================================================
# Function calls
# ============================================================================

color brightcyan "\<[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\("

# ============================================================================
# Qualified names / properties
# ============================================================================

color cyan "\.[[:space:]]*[A-Za-z_][A-Za-z0-9_]*"

color magenta "::[[:space:]]*[A-Za-z_][A-Za-z0-9_]*"

# ============================================================================
# Constants
# ============================================================================

color magenta "\<[A-Z][A-Z0-9_]+\>"

# ============================================================================
# Operators
# ============================================================================

color brightyellow "(\|>|\?\?|\.\.=|\.\.|->|=>|::|:=|==|!=|<=|>=|&&|\|\||<<=|>>=|<<|>>|\+=|-=|\*=|/=|%=|&=|\|=|\^=|[+*/%=<>!&|^~?.-])"

# Word operators.
color brightyellow "\<(not|and|or|as|is)\>"

# ============================================================================
# Delimiters
# ============================================================================

color normal "[][(){},;:]"

# ============================================================================
# Compiler / diagnostics infrastructure
# ============================================================================

color red "\<VITTE-[A-Z]+[0-9][0-9][0-9][0-9]\>"

color red "\<[EWI][0-9][0-9][0-9][0-9]\>"

color brightyellow "^[[:space:]]*<<<[[:space:]]+ROLE-CONTRACT"

color cyan "\<(diagnostics_|quickfix_|doctor_)[A-Za-z0-9_]*\>"

color magenta "\<[A-Za-z_][A-Za-z0-9_]*_pkg\>"

# ============================================================================
# Editor diagnostics
# ============================================================================

# Trailing whitespace.
color ,red "[[:space:]]+$"

# ============================================================================
# Comments
# ============================================================================

# Documentation comments must precede ordinary // highlighting.
color brightblack "^([[:space:]]*)///.*$"

# Standard line comments.
color brightblack "//.*$"

# Hash comments are part of the current Vitte editor manifest.
color brightblack "#.*$"

# Block comments.
color brightblack start="/\*" end="\*/"

# Vitte contract/documentation zones.
color brightblack start="<<<" end=">>>"

# ============================================================================
# TODO markers
# ============================================================================

color red "\<(TODO|FIXME|BUG|HACK|NOTE|XXX)\>"