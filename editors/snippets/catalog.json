[
  {
    "prefix": "aproc",
    "description": "Async procedure",
    "body": "async proc ${1:name}() {\n    $0\n}"
  },
  {
    "prefix": "asm",
    "description": "Assembly",
    "body": "asm(\"${1:nop}\");"
  },
  {
    "prefix": "assert",
    "description": "Assertion",
    "body": "assert(${1:true});"
  },
  {
    "prefix": "attr",
    "description": "Outer attribute",
    "body": "#[${1:feature}]"
  },
  {
    "prefix": "blockcomment",
    "description": "Block comment",
    "body": "/* ${1:comment} */"
  },
  {
    "prefix": "break",
    "description": "Break loop",
    "body": "break;"
  },
  {
    "prefix": "const",
