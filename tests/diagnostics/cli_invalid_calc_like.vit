proc add(left: int, right: int) -> int {
  give left + right
}

pick invalid_pick(left: int, right: int) -> int {
  give left + right
}

proc divide(left: int, right: int) -> int {
  if right == 0 {
    give 0
  }

  give return left / right
}

proc main() -> int {
  let total: int = add(40, 2)
  give divide(total, 0)
}
