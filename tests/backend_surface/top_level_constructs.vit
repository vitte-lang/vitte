space backend.surface.top_level;

use vitte/stdlib/core/index.{ core_version }

export *

const BACKEND_SURFACE_VALUE: i32 = 7

form BackendSurfaceNode {
  value: i32
}

pick BackendSurfaceChoice {
  Ready
  Done
}

proc main() -> i32 {
  let node: BackendSurfaceNode = BackendSurfaceNode { value: BACKEND_SURFACE_VALUE }
  give node.value
}
