space demo.structures

form Pair {
    left: int,
    right: int,
}

pick State {
    case Ready,
    case Failed,
}

proc make_pair() -> Pair {
    give Pair {
        left: 19,
        right: 23,
    };
}

proc select_state(value: int) -> State {
    if value == 42 {
        give Ready;
    }
    give Failed;
}

proc main() -> int {
    let pair: Pair = make_pair();
    match select_state(pair.left + pair.right) {
        case Ready {
            give 0;
        }
        case Failed {
            give 1;
        }
    }
}
