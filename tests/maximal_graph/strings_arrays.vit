space demo.strings

proc main() -> int {
    let parts: [string] = ["vi", "tte"];
    let joined: string = parts[0] + parts[1];
    let values: [int] = [2, 4, 6];

    if joined == "vitte" and len(parts) == 2 and values[1] == 4 and len(values) == 3 {
        print(joined);
        give 0;
    }

    give 1;
}
