space demo.constants

const SCALE: int = 3;
const OFFSET: int = 2;

proc square(value: int) -> int {
    give value * value;
}

proc accumulate(value: int) -> int {
    let total: int = OFFSET;
    let i: int = 1;
    while i <= value {
        set total = total + square(i) * SCALE;
        set i = i + 1;
    }
    give total;
}

proc main() -> int {
    if accumulate(3) == 44 {
        give 0;
    }
    give 1;
}
