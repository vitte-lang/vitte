space tests/truth_triangle/stdlib_runtime_deep/collections_json

use src/vitte/stdlib/collections/hashmap as hashmap
use src/vitte/stdlib/collections/vector as vector
use src/vitte/stdlib/json as json

proc main() -> int {
  let map: hashmap.HashMap = hashmap.hashmap_new()
  if not hashmap.hashmap_insert(map, "json", json.json_module_count() as i64) { give 1 }
  give vector.vector_push(vector.vector_new(2), 7) - 1
}
