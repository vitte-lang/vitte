space tests/truth_triangle/stdlib_runtime/collections_map_set

use src/vitte/stdlib/collections/hashmap as hashmap

// stdlib-runtime: real map collection call scenario
proc main() -> int {
  let map: hashmap.HashMap = hashmap.hashmap_new()
  if not hashmap.hashmap_insert(map, "vitte", 1) { give 1 }
  if hashmap.hashmap_get(map, "vitte") != 1 { give 2 }
  give 0
}
