space games::dungeon

/*
 * Vitte Dungeon
 *
 * Jeu de donjon en Vitte.
 * Aucun appel extern C.
 *
 * Intrinsics requis dans le runtime :
 *   io_print
 *   io_print_i64
 *   io_read_i64
 *   random_i64
 */

intrinsic io_print(text: str);
intrinsic io_print_i64(value: i64);
intrinsic io_read_i64() -> i64;
intrinsic random_i64(minimum: i64, maximum: i64) -> i64;

/* ============================================================
 * Constants
 * ============================================================ */

const PLAYER_MAX_HEALTH: i64 = 120
const PLAYER_BASE_ATTACK: i64 = 14
const PLAYER_BASE_DEFENSE: i64 = 5

const POTION_HEAL_MIN: i64 = 20
const POTION_HEAL_MAX: i64 = 35

const CRITICAL_CHANCE: i64 = 15
const DODGE_CHANCE: i64 = 8

const MAX_LEVEL: i64 = 20
const LAST_FLOOR: i64 = 15

/* ============================================================
 * Enumerations
 * ============================================================ */

pick GameState {
    Playing,
    Victory,
    Defeat,
    Quit
}

pick EnemyKind {
    Rat,
    Goblin,
    Skeleton,
    Orc,
    Knight,
    Demon,
    Dragon
}

pick ItemKind {
    None,
    Potion,
    Sword,
    Shield,
    Crystal
}

pick Action {
    Invalid,
    Attack,
    PowerAttack,
    Heal,
    Statistics,
    Inspect,
    Quit
}

/* ============================================================
 * Player
 * ============================================================ */

form Player {
    health: i64,
    max_health: i64,
    attack: i64,
    defense: i64,
    level: i64,
    experience: i64,
    gold: i64,
    potions: i64,
    kills: i64,
    floor: i64
}

/* ============================================================
 * Enemy
 * ============================================================ */

form Enemy {
    kind: EnemyKind,
    health: i64,
    max_health: i64,
    attack: i64,
    defense: i64,
    experience: i64,
    gold: i64
}

/* ============================================================
 * Game
 * ============================================================ */

form Game {
    player: Player,
    enemy: Enemy,
    state: GameState,
    turn: i64,
    rooms: i64
}

/* ============================================================
 * Utility
 * ============================================================ */

proc println() {
    io_print("\n");
}

proc print_line() {
    io_print("==================================================\n");
}

proc print_small_line() {
    io_print("--------------------------------------------------\n");
}

proc clamp_i64(
    value: i64,
    minimum: i64,
    maximum: i64
) -> i64 {
    if value < minimum {
        return minimum;
    }

    if value > maximum {
        return maximum;
    }

    return value;
}

proc min_i64(left: i64, right: i64) -> i64 {
    if left < right {
        return left;
    }

    return right;
}

proc max_i64(left: i64, right: i64) -> i64 {
    if left > right {
        return left;
    }

    return right;
}

proc abs_i64(value: i64) -> i64 {
    if value < 0 {
        return -value;
    }

    return value;
}

/* ============================================================
 * Player creation
 * ============================================================ */

proc create_player() -> Player {
    return Player {
        health: PLAYER_MAX_HEALTH,
        max_health: PLAYER_MAX_HEALTH,
        attack: PLAYER_BASE_ATTACK,
        defense: PLAYER_BASE_DEFENSE,
        level: 1,
        experience: 0,
        gold: 0,
        potions: 3,
        kills: 0,
        floor: 1
    };
}

/* ============================================================
 * Enemy creation
 * ============================================================ */

proc enemy_rat(floor: i64) -> Enemy {
    let hp: i64 = 18 + floor * 2;

    return Enemy {
        kind: EnemyKind::Rat,
        health: hp,
        max_health: hp,
        attack: 5 + floor,
        defense: 1 + floor / 3,
        experience: 10 + floor * 2,
        gold: 3 + floor
    };
}

proc enemy_goblin(floor: i64) -> Enemy {
    let hp: i64 = 30 + floor * 3;

    return Enemy {
        kind: EnemyKind::Goblin,
        health: hp,
        max_health: hp,
        attack: 8 + floor,
        defense: 2 + floor / 2,
        experience: 18 + floor * 3,
        gold: 7 + floor * 2
    };
}

proc enemy_skeleton(floor: i64) -> Enemy {
    let hp: i64 = 45 + floor * 4;

    return Enemy {
        kind: EnemyKind::Skeleton,
        health: hp,
        max_health: hp,
        attack: 11 + floor,
        defense: 4 + floor / 2,
        experience: 28 + floor * 4,
        gold: 10 + floor * 2
    };
}

proc enemy_orc(floor: i64) -> Enemy {
    let hp: i64 = 70 + floor * 5;

    return Enemy {
        kind: EnemyKind::Orc,
        health: hp,
        max_health: hp,
        attack: 15 + floor * 2,
        defense: 6 + floor,
        experience: 45 + floor * 5,
        gold: 18 + floor * 3
    };
}

proc enemy_knight(floor: i64) -> Enemy {
    let hp: i64 = 100 + floor * 7;

    return Enemy {
        kind: EnemyKind::Knight,
        health: hp,
        max_health: hp,
        attack: 20 + floor * 2,
        defense: 10 + floor,
        experience: 70 + floor * 6,
        gold: 30 + floor * 4
    };
}

proc enemy_demon(floor: i64) -> Enemy {
    let hp: i64 = 150 + floor * 9;

    return Enemy {
        kind: EnemyKind::Demon,
        health: hp,
        max_health: hp,
        attack: 27 + floor * 2,
        defense: 13 + floor,
        experience: 110 + floor * 8,
        gold: 50 + floor * 5
    };
}

proc enemy_dragon(floor: i64) -> Enemy {
    let hp: i64 = 300 + floor * 15;

    return Enemy {
        kind: EnemyKind::Dragon,
        health: hp,
        max_health: hp,
        attack: 35 + floor * 3,
        defense: 18 + floor,
        experience: 300 + floor * 15,
        gold: 200 + floor * 10
    };
}

/* ============================================================
 * Random enemy
 * ============================================================ */

proc create_enemy(floor: i64) -> Enemy {
    if floor >= 10 and random_i64(1, 100) <= 10 {
        return enemy_dragon(floor);
    }

    let roll: i64 = random_i64(1, 100);

    if floor <= 2 {
        if roll <= 60 {
            return enemy_rat(floor);
        }

        return enemy_goblin(floor);
    }

    if floor <= 4 {
        if roll <= 30 {
            return enemy_rat(floor);
        }

        if roll <= 70 {
            return enemy_goblin(floor);
        }

        return enemy_skeleton(floor);
    }

    if floor <= 7 {
        if roll <= 30 {
            return enemy_goblin(floor);
        }

        if roll <= 65 {
            return enemy_skeleton(floor);
        }

        return enemy_orc(floor);
    }

    if floor <= 10 {
        if roll <= 25 {
            return enemy_skeleton(floor);
        }

        if roll <= 60 {
            return enemy_orc(floor);
        }

        return enemy_knight(floor);
    }

    if roll <= 30 {
        return enemy_orc(floor);
    }

    if roll <= 70 {
        return enemy_knight(floor);
    }

    return enemy_demon(floor);
}

/* ============================================================
 * Enemy names
 * ============================================================ */

proc print_enemy_name(enemy: &Enemy) {
    if enemy.kind == EnemyKind::Rat {
        io_print("Rat");
    } elif enemy.kind == EnemyKind::Goblin {
        io_print("Gobelin");
    } elif enemy.kind == EnemyKind::Skeleton {
        io_print("Squelette");
    } elif enemy.kind == EnemyKind::Orc {
        io_print("Orc");
    } elif enemy.kind == EnemyKind::Knight {
        io_print("Chevalier noir");
    } elif enemy.kind == EnemyKind::Demon {
        io_print("Demon");
    } elif enemy.kind == EnemyKind::Dragon {
        io_print("Dragon");
    } else {
        io_print("Creature inconnue");
    }
}

/* ============================================================
 * Health
 * ============================================================ */

proc player_alive(player: &Player) -> bool {
    return player.health > 0;
}

proc enemy_alive(enemy: &Enemy) -> bool {
    return enemy.health > 0;
}

proc player_missing_health(player: &Player) -> i64 {
    return player.max_health - player.health;
}

/* ============================================================
 * Damage
 * ============================================================ */

proc calculate_damage(
    attack: i64,
    defense: i64
) -> i64 {
    let variance: i64 = random_i64(-2, 3);

    let mut damage: i64 = attack - defense + variance;

    if damage < 1 {
        set damage = 1;
    }

    return damage;
}

proc critical_roll() -> bool {
    return random_i64(1, 100) <= CRITICAL_CHANCE;
}

proc dodge_roll() -> bool {
    return random_i64(1, 100) <= DODGE_CHANCE;
}

/* ============================================================
 * Apply damage
 * ============================================================ */

proc damage_player(
    player: &mut Player,
    amount: i64
) {
    if amount <= 0 {
        return;
    }

    if amount >= player.health {
        set player.health = 0;
        return;
    }

    set player.health = player.health - amount;
}

proc damage_enemy(
    enemy: &mut Enemy,
    amount: i64
) {
    if amount <= 0 {
        return;
    }

    if amount >= enemy.health {
        set enemy.health = 0;
        return;
    }

    set enemy.health = enemy.health - amount;
}

/* ============================================================
 * Healing
 * ============================================================ */

proc heal_player(
    player: &mut Player,
    amount: i64
) -> i64 {
    if amount <= 0 {
        return 0;
    }

    let missing: i64 = player_missing_health(player);

    if missing <= 0 {
        return 0;
    }

    let restored: i64 = min_i64(amount, missing);

    set player.health = player.health + restored;

    return restored;
}

/* ============================================================
 * Experience
 * ============================================================ */

proc experience_required(level: i64) -> i64 {
    return 40 + level * level * 20;
}

proc level_up(player: &mut Player) {
    if player.level >= MAX_LEVEL {
        return;
    }

    set player.level = player.level + 1;
    set player.max_health = player.max_health + 15;
    set player.health = player.max_health;
    set player.attack = player.attack + 3;
    set player.defense = player.defense + 2;
    set player.potions = player.potions + 1;

    io_print("\n*** NIVEAU SUPERIEUR ***\n");
    io_print("Niveau ");
    io_print_i64(player.level);
    println();

    io_print("+15 HP maximum\n");
    io_print("+3 attaque\n");
    io_print("+2 defense\n");
    io_print("+1 potion\n");
}

proc update_level(player: &mut Player) {
    while player.level < MAX_LEVEL {
        let required: i64 = experience_required(player.level);

        if player.experience < required {
            return;
        }

        set player.experience = player.experience - required;

        level_up(player);
    }
}

/* ============================================================
 * Player attack
 * ============================================================ */

proc player_attack(game: &mut Game) {
    let mut damage: i64 = calculate_damage(
        game.player.attack,
        game.enemy.defense
    );

    if critical_roll() {
        set damage = damage * 2;
        io_print("COUP CRITIQUE !\n");
    }

    damage_enemy(&mut game.enemy, damage);

    io_print("Vous infligez ");
    io_print_i64(damage);
    io_print(" degats a ");
    print_enemy_name(&game.enemy);
    io_print(".\n");
}

/* ============================================================
 * Power attack
 * ============================================================ */

proc player_power_attack(game: &mut Game) {
    if random_i64(1, 100) > 70 {
        io_print("Votre attaque puissante manque sa cible !\n");
        return;
    }

    let mut damage: i64 = calculate_damage(
        game.player.attack,
        game.enemy.defense
    );

    set damage = damage + game.player.attack / 2;

    if critical_roll() {
        set damage = damage * 2;
        io_print("CRITIQUE DEVASTATEUR !\n");
    }

    damage_enemy(&mut game.enemy, damage);

    io_print("Attaque puissante : ");
    io_print_i64(damage);
    io_print(" degats.\n");
}

/* ============================================================
 * Potion
 * ============================================================ */

proc player_use_potion(game: &mut Game) {
    if game.player.potions <= 0 {
        io_print("Vous n'avez plus de potion.\n");
        return;
    }

    if game.player.health >= game.player.max_health {
        io_print("Vos points de vie sont deja au maximum.\n");
        return;
    }

    set game.player.potions = game.player.potions - 1;

    let amount: i64 = random_i64(
        POTION_HEAL_MIN,
        POTION_HEAL_MAX
    );

    let restored: i64 = heal_player(
        &mut game.player,
        amount
    );

    io_print("Potion : +");
    io_print_i64(restored);
    io_print(" HP.\n");
}

/* ============================================================
 * Enemy attack
 * ============================================================ */

proc enemy_attack(game: &mut Game) {
    if dodge_roll() {
        io_print("Vous esquivez l'attaque !\n");
        return;
    }

    let mut damage: i64 = calculate_damage(
        game.enemy.attack,
        game.player.defense
    );

    if critical_roll() {
        set damage = damage * 2;
        io_print("L'ennemi porte un coup critique !\n");
    }

    damage_player(&mut game.player, damage);

    print_enemy_name(&game.enemy);
    io_print(" vous inflige ");
    io_print_i64(damage);
    io_print(" degats.\n");
}

/* ============================================================
 * Player statistics
 * ============================================================ */

proc print_player(player: &Player) {
    print_small_line();

    io_print("Niveau : ");
    io_print_i64(player.level);

    io_print("   XP : ");
    io_print_i64(player.experience);

    io_print("/");
    io_print_i64(experience_required(player.level));
    println();

    io_print("HP : ");
    io_print_i64(player.health);

    io_print("/");
    io_print_i64(player.max_health);
    println();

    io_print("Attaque : ");
    io_print_i64(player.attack);

    io_print("   Defense : ");
    io_print_i64(player.defense);
    println();

    io_print("Or : ");
    io_print_i64(player.gold);

    io_print("   Potions : ");
    io_print_i64(player.potions);
    println();

    io_print("Victimes : ");
    io_print_i64(player.kills);

    io_print("   Etage : ");
    io_print_i64(player.floor);
    println();

    print_small_line();
}

/* ============================================================
 * Enemy statistics
 * ============================================================ */

proc print_enemy(enemy: &Enemy) {
    io_print("\nENNEMI : ");
    print_enemy_name(enemy);
    println();

    io_print("HP : ");
    io_print_i64(enemy.health);

    io_print("/");
    io_print_i64(enemy.max_health);
    println();

    io_print("Attaque : ");
    io_print_i64(enemy.attack);

    io_print("   Defense : ");
    io_print_i64(enemy.defense);
    println();
}

/* ============================================================
 * Menu
 * ============================================================ */

proc print_actions() {
    io_print("\n");
    io_print("1. Attaquer\n");
    io_print("2. Attaque puissante\n");
    io_print("3. Utiliser une potion\n");
    io_print("4. Statistiques\n");
    io_print("5. Examiner l'ennemi\n");
    io_print("6. Quitter\n");
    io_print("\n> ");
}

proc read_action() -> Action {
    let value: i64 = io_read_i64();

    if value == 1 {
        return Action::Attack;
    }

    if value == 2 {
        return Action::PowerAttack;
    }

    if value == 3 {
        return Action::Heal;
    }

    if value == 4 {
        return Action::Statistics;
    }

    if value == 5 {
        return Action::Inspect;
    }

    if value == 6 {
        return Action::Quit;
    }

    return Action::Invalid;
}

/* ============================================================
 * Rewards
 * ============================================================ */

proc reward_player(game: &mut Game) {
    io_print("\nEnnemi vaincu !\n");

    set game.player.experience =
        game.player.experience + game.enemy.experience;

    set game.player.gold =
        game.player.gold + game.enemy.gold;

    set game.player.kills =
        game.player.kills + 1;

    io_print("+");
    io_print_i64(game.enemy.experience);
    io_print(" XP\n");

    io_print("+");
    io_print_i64(game.enemy.gold);
    io_print(" or\n");

    let loot: i64 = random_i64(1, 100);

    if loot <= 20 {
        set game.player.potions = game.player.potions + 1;
        io_print("Vous trouvez une potion !\n");
    } elif loot <= 27 {
        set game.player.attack = game.player.attack + 1;
        io_print("Vous trouvez une meilleure arme : +1 attaque.\n");
    } elif loot <= 34 {
        set game.player.defense = game.player.defense + 1;
        io_print("Vous trouvez une armure : +1 defense.\n");
    }

    update_level(&mut game.player);
}

/* ============================================================
 * Player turn
 * ============================================================ */

proc player_turn(game: &mut Game) {
    let mut completed: bool = false;

    while not completed {
        print_actions();

        let action: Action = read_action();

        if action == Action::Attack {
            player_attack(game);
            set completed = true;
        } elif action == Action::PowerAttack {
            player_power_attack(game);
            set completed = true;
        } elif action == Action::Heal {
            player_use_potion(game);
            set completed = true;
        } elif action == Action::Statistics {
            print_player(&game.player);
        } elif action == Action::Inspect {
            print_enemy(&game.enemy);
        } elif action == Action::Quit {
            set game.state = GameState::Quit;
            set completed = true;
        } else {
            io_print("Commande inconnue.\n");
        }
    }
}

/* ============================================================
 * Combat
 * ============================================================ */

proc combat(game: &mut Game) {
    io_print("\nUne creature apparait : ");
    print_enemy_name(&game.enemy);
    io_print(" !\n");

    while player_alive(&game.player)
        and enemy_alive(&game.enemy)
        and game.state == GameState::Playing
    {
        print_small_line();

        io_print("Vos HP : ");
        io_print_i64(game.player.health);

        io_print("/");
        io_print_i64(game.player.max_health);
        println();

        io_print("HP ennemi : ");
        io_print_i64(game.enemy.health);

        io_print("/");
        io_print_i64(game.enemy.max_health);
        println();

        player_turn(game);

        if game.state != GameState::Playing {
            return;
        }

        if not enemy_alive(&game.enemy) {
            reward_player(game);
            return;
        }

        enemy_attack(game);

        if not player_alive(&game.player) {
            set game.state = GameState::Defeat;
            return;
        }

        set game.turn = game.turn + 1;
    }
}

/* ============================================================
 * Treasure room
 * ============================================================ */

proc treasure_room(game: &mut Game) {
    io_print("\nVous trouvez un coffre.\n");

    let gold: i64 = random_i64(
        10,
        50 + game.player.floor * 5
    );

    set game.player.gold = game.player.gold + gold;

    io_print("Le coffre contient ");
    io_print_i64(gold);
    io_print(" pieces d'or.\n");

    if random_i64(1, 100) <= 30 {
        set game.player.potions = game.player.potions + 1;
        io_print("Une potion se trouve egalement dans le coffre.\n");
    }
}

/* ============================================================
 * Fountain room
 * ============================================================ */

proc fountain_room(game: &mut Game) {
    io_print("\nVous trouvez une fontaine ancienne.\n");

    let heal_amount: i64 = game.player.max_health / 3;

    let restored: i64 = heal_player(
        &mut game.player,
        heal_amount
    );

    io_print("La fontaine restaure ");
    io_print_i64(restored);
    io_print(" HP.\n");
}

/* ============================================================
 * Trap room
 * ============================================================ */

proc trap_room(game: &mut Game) {
    io_print("\nUn piege se declenche !\n");

    let damage: i64 = random_i64(
        5,
        15 + game.player.floor
    );

    damage_player(&mut game.player, damage);

    io_print("Vous perdez ");
    io_print_i64(damage);
    io_print(" HP.\n");

    if not player_alive(&game.player) {
        set game.state = GameState::Defeat;
    }
}

/* ============================================================
 * Empty room
 * ============================================================ */

proc empty_room(game: &mut Game) {
    io_print("\nLa salle est silencieuse...\n");

    if random_i64(1, 100) <= 15 {
        io_print("Vous trouvez quelques pieces d'or.\n");

        let gold: i64 = random_i64(1, 10);

        set game.player.gold = game.player.gold + gold;
    }
}

/* ============================================================
 * Room generation
 * ============================================================ */

proc enter_room(game: &mut Game) {
    set game.rooms = game.rooms + 1;

    println();
    print_line();

    io_print("ETAGE ");
    io_print_i64(game.player.floor);

    io_print(" - SALLE ");
    io_print_i64(game.rooms);
    println();

    print_line();

    let room: i64 = random_i64(1, 100);

    if room <= 55 {
        set game.enemy = create_enemy(game.player.floor);
        combat(game);
    } elif room <= 70 {
        treasure_room(game);
    } elif room <= 82 {
        fountain_room(game);
    } elif room <= 92 {
        trap_room(game);
    } else {
        empty_room(game);
    }
}

/* ============================================================
 * Floor
 * ============================================================ */

proc floor_complete(game: &Game) -> bool {
    return game.rooms >= 5 + game.player.floor / 2;
}

proc next_floor(game: &mut Game) {
    set game.player.floor = game.player.floor + 1;
    set game.rooms = 0;

    println();
    print_line();

    io_print("VOUS DESCENDEZ A L'ETAGE ");
    io_print_i64(game.player.floor);
    println();

    print_line();

    let recovery: i64 = game.player.max_health / 5;

    let restored: i64 = heal_player(
        &mut game.player,
        recovery
    );

    io_print("Repos : +");
    io_print_i64(restored);
    io_print(" HP.\n");
}

/* ============================================================
 * Victory
 * ============================================================ */

proc check_victory(game: &mut Game) {
    if game.player.floor > LAST_FLOOR {
        set game.state = GameState::Victory;
    }
}

/* ============================================================
 * Game creation
 * ============================================================ */

proc create_game() -> Game {
    return Game {
        player: create_player(),
        enemy: enemy_rat(1),
        state: GameState::Playing,
        turn: 1,
        rooms: 0
    };
}

/* ============================================================
 * Introduction
 * ============================================================ */

proc introduction() {
    print_line();

    io_print("                 VITTE DUNGEON\n");

    print_line();

    io_print("Vous entrez dans un ancien donjon.\n");
    io_print("Quinze etages vous separent de la sortie.\n");
    io_print("Combattez, gagnez de l'experience et survivez.\n");

    print_line();
}

/* ============================================================
 * Main game loop
 * ============================================================ */

proc run_game(game: &mut Game) {
    while game.state == GameState::Playing {
        enter_room(game);

        if game.state != GameState::Playing {
            break;
        }

        if floor_complete(game) {
            next_floor(game);
            check_victory(game);
        }
    }
}

/* ============================================================
 * Final screen
 * ============================================================ */

proc final_screen(game: &Game) {
    println();
    print_line();

    if game.state == GameState::Victory {
        io_print("                 VICTOIRE\n");
        print_line();
        io_print("Vous avez traverse le donjon !\n");
    } elif game.state == GameState::Defeat {
        io_print("                  DEFAITE\n");
        print_line();
        io_print("Votre aventure s'arrete ici.\n");
    } else {
        io_print("              PARTIE TERMINEE\n");
        print_line();
    }

    io_print("Niveau final : ");
    io_print_i64(game.player.level);
    println();

    io_print("Etage atteint : ");
    io_print_i64(game.player.floor);
    println();

    io_print("Ennemis vaincus : ");
    io_print_i64(game.player.kills);
    println();

    io_print("Or : ");
    io_print_i64(game.player.gold);
    println();

    io_print("Tours : ");
    io_print_i64(game.turn);
    println();

    print_line();
}

/* ============================================================
 * Program
 * ============================================================ */

pub proc main() -> i64 {
    introduction();

    let mut game: Game = create_game();

    run_game(&mut game);

    final_screen(&game);

    return 0;
}

/* ============================================================
 * Tests
 * ============================================================ */

test "player creation" {
    let player: Player = create_player();

    assert player.health == PLAYER_MAX_HEALTH;
    assert player.max_health == PLAYER_MAX_HEALTH;
    assert player.level == 1;
    assert player.potions == 3;
}

test "damage player" {
    let mut player: Player = create_player();

    damage_player(&mut player, 20);

    assert player.health == PLAYER_MAX_HEALTH - 20;
}

test "damage cannot go below zero" {
    let mut player: Player = create_player();

    damage_player(&mut player, 100000);

    assert player.health == 0;
    assert not player_alive(&player);
}

test "healing" {
    let mut player: Player = create_player();

    set player.health = 50;

    let restored: i64 = heal_player(&mut player, 20);

    assert restored == 20;
    assert player.health == 70;
}

test "healing maximum" {
    let mut player: Player = create_player();

    set player.health = player.max_health - 5;

    let restored: i64 = heal_player(&mut player, 100);

    assert restored == 5;
    assert player.health == player.max_health;
}

test "experience formula" {
    assert experience_required(1) == 60;
    assert experience_required(2) == 120;
    assert experience_required(3) == 220;
}

test "level up" {
    let mut player: Player = create_player();

    let old_health: i64 = player.max_health;
    let old_attack: i64 = player.attack;
    let old_defense: i64 = player.defense;

    level_up(&mut player);

    assert player.level == 2;
    assert player.max_health == old_health + 15;
    assert player.attack == old_attack + 3;
    assert player.defense == old_defense + 2;
}

test "enemy creation" {
    let enemy: Enemy = enemy_goblin(1);

    assert enemy.kind == EnemyKind::Goblin;
    assert enemy.health > 0;
    assert enemy.attack > 0;
    assert enemy.experience > 0;
}

test "clamp" {
    assert clamp_i64(5, 0, 10) == 5;
    assert clamp_i64(-5, 0, 10) == 0;
    assert clamp_i64(50, 0, 10) == 10;
}

test "min max" {
    assert min_i64(10, 20) == 10;
    assert max_i64(10, 20) == 20;
}

test "absolute value" {
    assert abs_i64(10) == 10;
    assert abs_i64(-10) == 10;
    assert abs_i64(0) == 0;
}

test "game initialization" {
    let game: Game = create_game();

    assert game.state == GameState::Playing;
    assert game.player.floor == 1;
    assert game.turn == 1;
    assert game.rooms == 0;
}

test "floor progression" {
    let mut game: Game = create_game();

    set game.rooms = 100;

    assert floor_complete(&game);

    let previous: i64 = game.player.floor;

    next_floor(&mut game);

    assert game.player.floor == previous + 1;
    assert game.rooms == 0;
}

test "victory condition" {
    let mut game: Game = create_game();

    set game.player.floor = 16;

    check_victory(&mut game);

    assert game.state == GameState::Victory;
}