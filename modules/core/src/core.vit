/// Racine du paquet `core` de la bibliothèque standard Vitte.
///
/// Ce module ne dépend d'aucune bibliothèque externe ni d'API C.
/// Les modules spécialisés restent importés explicitement tant que le
/// compilateur ne prend pas en charge la réexportation des imports.
space core;

/// Version du paquet `core`.
export const CORE_VERSION_MAJOR: u32 = 0;
export const CORE_VERSION_MINOR: u32 = 1;
export const CORE_VERSION_PATCH: u32 = 0;
