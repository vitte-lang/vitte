/// Prédicats génériques spécialisés sur les types entiers primitifs.
space core::primitive::integer;

export proc i64_is_zero(value: i64) -> bool { return value == 0; }
export proc u64_is_zero(value: u64) -> bool { return value == 0; }
export proc i64_is_even(value: i64) -> bool { return value % 2 == 0; }
export proc u64_is_even(value: u64) -> bool { return value % 2 == 0; }
export proc i64_is_odd(value: i64) -> bool { return value % 2 != 0; }
export proc u64_is_odd(value: u64) -> bool { return value % 2 != 0; }

export proc u64_is_power_of_two(value: u64) -> bool {
    return value != 0 && (value & (value - 1)) == 0;
}

export proc usize_is_power_of_two(value: usize) -> bool {
    return value != 0 && (value & (value - 1)) == 0;
}
