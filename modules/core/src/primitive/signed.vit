/// Prédicats et magnitude sûre pour les entiers signés.
space core::primitive::signed;

export proc i64_is_negative(value: i64) -> bool { return value < 0; }
export proc i64_is_positive(value: i64) -> bool { return value > 0; }
export proc i64_signum(value: i64) -> i8 {
    if value < 0 { return -1; }
    if value > 0 { return 1; }
    return 0;
}

export proc i64_unsigned_abs(value: i64) -> u64 {
    if value >= 0 { return value as u64; }
    return (-(value + 1)) as u64 + 1;
}

export proc i32_signum(value: i32) -> i8 {
    if value < 0 { return -1; }
    if value > 0 { return 1; }
    return 0;
}
