/// Prédicats usuels pour les entiers non signés.
space core::primitive::unsigned;

export proc u64_is_zero(value: u64) -> bool { return value == 0; }
export proc u64_is_even(value: u64) -> bool { return value % 2 == 0; }
export proc u64_is_odd(value: u64) -> bool { return value % 2 != 0; }
export proc u64_is_power_of_two(value: u64) -> bool {
    return value != 0 && (value & (value - 1)) == 0;
}

export proc u32_is_power_of_two(value: u32) -> bool {
    return value != 0 && (value & (value - 1)) == 0;
}

export proc u16_is_power_of_two(value: u16) -> bool {
    return value != 0 && (value & (value - 1)) == 0;
}

export proc u8_is_power_of_two(value: u8) -> bool {
    return value != 0 && (value & (value - 1)) == 0;
}
