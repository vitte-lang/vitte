/// Classification et opérations simples sur les nombres flottants.
space core::primitive::float;

export proc f32_is_nan(value: f32) -> bool {
    return value != value;
}

export proc f64_is_nan(value: f64) -> bool {
    return value != value;
}

export proc f32_is_infinite(value: f32) -> bool {
    if f32_is_nan(value) { return false; }
    return (value > 0.0 || value < 0.0) && value + value == value;
}

export proc f64_is_infinite(value: f64) -> bool {
    if f64_is_nan(value) { return false; }
    return (value > 0.0 || value < 0.0) && value + value == value;
}

export proc f32_is_finite(value: f32) -> bool {
    return not f32_is_nan(value) && not f32_is_infinite(value);
}

export proc f64_is_finite(value: f64) -> bool {
    return not f64_is_nan(value) && not f64_is_infinite(value);
}

export proc f32_is_zero(value: f32) -> bool {
    return f32_is_finite(value) && value == 0.0;
}

export proc f64_is_zero(value: f64) -> bool {
    return f64_is_finite(value) && value == 0.0;
}

export proc f32_abs(value: f32) -> f32 {
    if value < 0.0 { return -value; }
    return value;
}

export proc f64_abs(value: f64) -> f64 {
    if value < 0.0 { return -value; }
    return value;
}
