/// Conversion des chiffres dans les bases de 2 à 36.
space core::num::radix;

export proc radix_digit_to_char(value: u8, uppercase: bool) -> ?char {
    if value >= 36 { return null; }
    if value < 10 { return (value + 48) as char; }
    if uppercase { return (value - 10 + 65) as char; }
    return (value - 10 + 97) as char;
}

export proc radix_char_to_digit(value: char) -> ?u8 {
    let code: u32 = value as u32;
    if code >= 48 && code <= 57 { return (code - 48) as u8; }
    if code >= 65 && code <= 90 { return (code - 65 + 10) as u8; }
    if code >= 97 && code <= 122 { return (code - 97 + 10) as u8; }
    return null;
}
