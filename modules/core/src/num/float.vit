/// Prédicats de classification flottante.
space core::num::float;

export proc float_is_nan_f32(value: f32) -> bool { return value != value; }
export proc float_is_nan_f64(value: f64) -> bool { return value != value; }

export proc float_is_infinite_f32(value: f32) -> bool {
    if float_is_nan_f32(value) { return false; }
    return (value > 0.0 || value < 0.0) && value + value == value;
}

export proc float_is_infinite_f64(value: f64) -> bool {
    if float_is_nan_f64(value) { return false; }
    return (value > 0.0 || value < 0.0) && value + value == value;
}

export proc float_is_finite_f32(value: f32) -> bool {
    return not float_is_nan_f32(value) && not float_is_infinite_f32(value);
}

export proc float_is_finite_f64(value: f64) -> bool {
    return not float_is_nan_f64(value) && not float_is_infinite_f64(value);
}
