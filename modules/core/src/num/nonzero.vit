/// Valeurs entières garanties non nulles par leurs constructeurs.
space core::num::nonzero;

export form NonZeroU64 { value: u64 }
export form NonZeroU32 { value: u32 }
export form NonZeroI64 { value: i64 }

export proc nonzero_u64(value: u64) -> ?NonZeroU64 {
    if value == 0 { return null; }
    return NonZeroU64 { value: value };
}

export proc nonzero_u32(value: u32) -> ?NonZeroU32 {
    if value == 0 { return null; }
    return NonZeroU32 { value: value };
}

export proc nonzero_i64(value: i64) -> ?NonZeroI64 {
    if value == 0 { return null; }
    return NonZeroI64 { value: value };
}

export proc nonzero_u64_get(value: &NonZeroU64) -> u64 { return value.value; }
export proc nonzero_u32_get(value: &NonZeroU32) -> u32 { return value.value; }
export proc nonzero_i64_get(value: &NonZeroI64) -> i64 { return value.value; }
