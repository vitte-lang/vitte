/// Catégories des opérations reconnues par le compilateur.
space core::internal::builtin;

export pick BuiltinCategory {
    Arithmetic,
    Bitwise,
    Memory,
    Atomic,
    TypeInfo,
    ControlFlow,
}

export pick BuiltinId {
    AtomicLoad,
    AtomicStore,
    AtomicExchange,
    AtomicCompareExchange,
    AtomicFetchAdd,
    AtomicFetchSub,
    AtomicFence,
    Unreachable,
}

export proc builtin_category(id: BuiltinId) -> BuiltinCategory {
    match id {
        case BuiltinId.AtomicLoad => return BuiltinCategory.Atomic,
        case BuiltinId.AtomicStore => return BuiltinCategory.Atomic,
        case BuiltinId.AtomicExchange => return BuiltinCategory.Atomic,
        case BuiltinId.AtomicCompareExchange => return BuiltinCategory.Atomic,
        case BuiltinId.AtomicFetchAdd => return BuiltinCategory.Atomic,
        case BuiltinId.AtomicFetchSub => return BuiltinCategory.Atomic,
        case BuiltinId.AtomicFence => return BuiltinCategory.Atomic,
        case BuiltinId.Unreachable => return BuiltinCategory.ControlFlow,
    }
}
