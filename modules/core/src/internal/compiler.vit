/// Capacités minimales attendues du compilateur pour exécuter `core`.
space core::internal::compiler;

export form CompilerCapabilities {
    generic_forms: bool,
    nullable_types: bool,
    intrinsics: bool,
    atomic_operations: bool,
    type_layout_queries: bool,
}

export proc required_capabilities() -> CompilerCapabilities {
    return CompilerCapabilities {
        generic_forms: true,
        nullable_types: true,
        intrinsics: true,
        atomic_operations: true,
        type_layout_queries: true,
    };
}

export proc capabilities_are_supported(value: &CompilerCapabilities) -> bool {
    return value.generic_forms && value.nullable_types && value.intrinsics &&
           value.atomic_operations && value.type_layout_queries;
}
