/// Façade locale vers les parseurs numériques sans allocation de `convert`.
space core::str::parse;

use core::convert::parse::{ParseI64Result, ParseU64Result, ParseBoolResult, parse_i64, parse_u64, parse_bool};

export proc str_parse_i64(value: str) -> ParseI64Result { return parse_i64(value, 10); }
export proc str_parse_i64_radix(value: str, radix: u32) -> ParseI64Result { return parse_i64(value, radix); }
export proc str_parse_u64(value: str) -> ParseU64Result { return parse_u64(value, 10); }
export proc str_parse_u64_radix(value: str, radix: u32) -> ParseU64Result { return parse_u64(value, radix); }
export proc str_parse_bool(value: str) -> ParseBoolResult { return parse_bool(value); }
