/// Comparaison lexicographique de chaînes.
space core::str::compare;

export proc str_compare(left: str, right: str) -> i8 {
    let mut index: usize = 0;
    let mut limit: usize = left.length;
    if right.length < limit { set limit = right.length; }
    while index < limit {
        if left[index] < right[index] { return -1; }
        if left[index] > right[index] { return 1; }
        set index = index + 1;
    }
    if left.length < right.length { return -1; }
    if left.length > right.length { return 1; }
    return 0;
}

export proc str_equal(left: str, right: str) -> bool { return str_compare(left, right) == 0; }
export proc str_starts_with(value: str, prefix: str) -> bool {
    if prefix.length > value.length { return false; }
    return value.slice(0, prefix.length) == prefix;
}

export proc str_ends_with(value: str, suffix: str) -> bool {
    if suffix.length > value.length { return false; }
    return value.slice(value.length - suffix.length, value.length) == suffix;
}
