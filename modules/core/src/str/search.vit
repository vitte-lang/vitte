/// Recherche de caractères et de sous-chaînes.
space core::str::search;

export proc str_find_char(value: str, target: char) -> ?usize {
    for index in 0..value.length {
        if value[index] == target { return index; }
    }
    return null;
}

export proc str_find(value: str, needle: str) -> ?usize {
    if needle.length == 0 { return 0; }
    if needle.length > value.length { return null; }
    let mut start: usize = 0;
    while start <= value.length - needle.length {
        if value.slice(start, start + needle.length) == needle { return start; }
        set start = start + 1;
    }
    return null;
}

export proc str_contains(value: str, needle: str) -> bool { return str_find(value, needle) != null; }
