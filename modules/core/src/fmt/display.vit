/// Formatage courant des primitives prises en charge.
space core::fmt::display;

use core::convert::format::{
    FormatResult, format_bool, format_i8, format_i16, format_i32, format_i64,
    format_u8, format_u16, format_u32, format_u64, format_char
};

export proc display_bool(value: bool, buffer: *u8, capacity: usize) -> FormatResult {
    return format_bool(value, buffer, capacity);
}

export proc display_i64(value: i64, buffer: *u8, capacity: usize) -> FormatResult {
    return format_i64(value, buffer, capacity);
}

export proc display_u64(value: u64, buffer: *u8, capacity: usize) -> FormatResult {
    return format_u64(value, buffer, capacity);
}

export proc display_i8(value: i8, buffer: *u8, capacity: usize) -> FormatResult { return format_i8(value, buffer, capacity); }
export proc display_i16(value: i16, buffer: *u8, capacity: usize) -> FormatResult { return format_i16(value, buffer, capacity); }
export proc display_i32(value: i32, buffer: *u8, capacity: usize) -> FormatResult { return format_i32(value, buffer, capacity); }
export proc display_u8(value: u8, buffer: *u8, capacity: usize) -> FormatResult { return format_u8(value, buffer, capacity); }
export proc display_u16(value: u16, buffer: *u8, capacity: usize) -> FormatResult { return format_u16(value, buffer, capacity); }
export proc display_u32(value: u32, buffer: *u8, capacity: usize) -> FormatResult { return format_u32(value, buffer, capacity); }
export proc display_char(value: char, buffer: *u8, capacity: usize) -> FormatResult { return format_char(value, buffer, capacity); }
