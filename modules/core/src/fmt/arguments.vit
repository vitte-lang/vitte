/// Argument de formatage typé sans allocation ni union non sûre.
space core::fmt::arguments;

export pick FormatArgKind { Signed, Unsigned, Boolean, Character, String }

export form FormatArg {
    kind: FormatArgKind,
    signed_value: i64,
    unsigned_value: u64,
    bool_value: bool,
    char_value: char,
    string_value: str,
}

export proc format_arg_i64(value: i64) -> FormatArg {
    return FormatArg { kind: FormatArgKind.Signed, signed_value: value, unsigned_value: 0, bool_value: false, char_value: '\0', string_value: "" };
}

export proc format_arg_u64(value: u64) -> FormatArg {
    return FormatArg { kind: FormatArgKind.Unsigned, signed_value: 0, unsigned_value: value, bool_value: false, char_value: '\0', string_value: "" };
}

export proc format_arg_bool(value: bool) -> FormatArg {
    return FormatArg { kind: FormatArgKind.Boolean, signed_value: 0, unsigned_value: 0, bool_value: value, char_value: '\0', string_value: "" };
}

export proc format_arg_char(value: char) -> FormatArg {
    return FormatArg { kind: FormatArgKind.Character, signed_value: 0, unsigned_value: 0, bool_value: false, char_value: value, string_value: "" };
}

export proc format_arg_str(value: str) -> FormatArg {
    return FormatArg { kind: FormatArgKind.String, signed_value: 0, unsigned_value: 0, bool_value: false, char_value: '\0', string_value: value };
}
