/// Contrats de conversion entre types.
space core::traits::convert;

use core::types::result::{Result};

export trait From<T> {
    proc from(value: T) -> Self;
}

export trait Into<T> {
    proc into(self) -> T;
}

export trait TryFrom<T> {
    type Error;
    proc try_from(value: T) -> Result[Self, Self::Error];
}

export trait TryInto<T> {
    type Error;
    proc try_into(self) -> Result[T, Self::Error];
}
