/// Écrit l'affichage d'une valeur dans un tampon borné fourni par l'appelant.
/// L'implémentation n'alloue pas et retourne faux si l'écriture échoue.
space core::traits::display;

use core::fmt::formatter::{Formatter};

export trait Display {
    proc fmt(&self, formatter: &mut Formatter) -> bool;
}
