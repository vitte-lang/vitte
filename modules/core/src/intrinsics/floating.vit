/// Classification flottante conforme aux prédicats IEEE élémentaires.
space core::intrinsics::floating;

export proc intrinsic_is_nan_f32(value: f32) -> bool { return value != value; }
export proc intrinsic_is_nan_f64(value: f64) -> bool { return value != value; }

export proc intrinsic_is_infinite_f32(value: f32) -> bool {
    return not intrinsic_is_nan_f32(value) && (value > 0.0 || value < 0.0) && value + value == value;
}

export proc intrinsic_is_infinite_f64(value: f64) -> bool {
    return not intrinsic_is_nan_f64(value) && (value > 0.0 || value < 0.0) && value + value == value;
}

export proc intrinsic_is_finite_f32(value: f32) -> bool {
    return not intrinsic_is_nan_f32(value) && not intrinsic_is_infinite_f32(value);
}

export proc intrinsic_is_finite_f64(value: f64) -> bool {
    return not intrinsic_is_nan_f64(value) && not intrinsic_is_infinite_f64(value);
}
