/// Opérations binaires indépendantes des traits d'opérateur.
space core::intrinsics::bitwise;

export proc rotate_left_u8(value: u8, count: u32) -> u8 {
    let shift: u32 = count & 7;
    if shift == 0 { return value; }
    return (value << shift) | (value >> (8 - shift));
}

export proc rotate_right_u8(value: u8, count: u32) -> u8 {
    let shift: u32 = count & 7;
    if shift == 0 { return value; }
    return (value >> shift) | (value << (8 - shift));
}

export proc rotate_left_u16(value: u16, count: u32) -> u16 {
    let shift: u32 = count & 15;
    if shift == 0 { return value; }
    return (value << shift) | (value >> (16 - shift));
}

export proc rotate_right_u16(value: u16, count: u32) -> u16 {
    let shift: u32 = count & 15;
    if shift == 0 { return value; }
    return (value >> shift) | (value << (16 - shift));
}

export proc rotate_left_u32(value: u32, count: u32) -> u32 {
    let shift: u32 = count & 31;
    if shift == 0 { return value; }
    return (value << shift) | (value >> (32 - shift));
}

export proc rotate_right_u32(value: u32, count: u32) -> u32 {
    let shift: u32 = count & 31;
    if shift == 0 { return value; }
    return (value >> shift) | (value << (32 - shift));
}

export proc rotate_left_u64(value: u64, count: u32) -> u64 {
    let shift: u32 = count & 63;
    if shift == 0 { return value; }
    return (value << shift) | (value >> (64 - shift));
}

export proc rotate_right_u64(value: u64, count: u32) -> u64 {
    let shift: u32 = count & 63;
    if shift == 0 { return value; }
    return (value >> shift) | (value << (64 - shift));
}

export proc count_ones_u32(value: u32) -> u32 {
    let mut remaining: u32 = value;
    let mut count: u32 = 0;
    while remaining != 0 {
        set remaining = remaining & (remaining - 1);
        set count += 1;
    }
    return count;
}

export proc count_ones_u64(value: u64) -> u32 {
    let mut remaining: u64 = value;
    let mut count: u32 = 0;
    while remaining != 0 {
        set remaining = remaining & (remaining - 1);
        set count += 1;
    }
    return count;
}

export proc count_ones_u8(value: u8) -> u32 { return count_ones_u32(value as u32); }
export proc count_ones_u16(value: u16) -> u32 { return count_ones_u32(value as u32); }

export proc leading_zeros_u8(value: u8) -> u32 {
    if value == 0 { return 8; }
    return leading_zeros_u32(value as u32) - 24;
}

export proc leading_zeros_u16(value: u16) -> u32 {
    if value == 0 { return 16; }
    return leading_zeros_u32(value as u32) - 16;
}

export proc trailing_zeros_u8(value: u8) -> u32 { return trailing_zeros_u32(value as u32); }
export proc trailing_zeros_u16(value: u16) -> u32 { return trailing_zeros_u32(value as u32); }

export proc leading_zeros_u32(value: u32) -> u32 {
    if value == 0 { return 32; }
    let mut remaining: u32 = value;
    let mut count: u32 = 0;
    while (remaining & 0x80000000) == 0 {
        set remaining = remaining << 1;
        set count += 1;
    }
    return count;
}

export proc leading_zeros_u64(value: u64) -> u32 {
    if value == 0 { return 64; }
    let mut remaining: u64 = value;
    let mut count: u32 = 0;
    while (remaining & 0x8000000000000000) == 0 {
        set remaining = remaining << 1;
        set count += 1;
    }
    return count;
}

export proc trailing_zeros_u32(value: u32) -> u32 {
    if value == 0 { return 32; }
    let mut remaining: u32 = value;
    let mut count: u32 = 0;
    while (remaining & 1) == 0 {
        set remaining = remaining >> 1;
        set count += 1;
    }
    return count;
}

export proc trailing_zeros_u64(value: u64) -> u32 {
    if value == 0 { return 64; }
    let mut remaining: u64 = value;
    let mut count: u32 = 0;
    while (remaining & 1) == 0 {
        set remaining = remaining >> 1;
        set count += 1;
    }
    return count;
}

export proc reverse_bytes_u16(value: u16) -> u16 {
    return ((value & 0x00ff) << 8) | ((value >> 8) & 0x00ff);
}

export proc reverse_bytes_u32(value: u32) -> u32 {
    let mut remaining: u32 = value;
    let mut result: u32 = 0;
    let mut index: u32 = 0;
    while index < 4 {
        set result = (result << 8) | (remaining & 0xff);
        set remaining = remaining >> 8;
        set index += 1;
    }
    return result;
}

export proc reverse_bytes_u64(value: u64) -> u64 {
    let mut remaining: u64 = value;
    let mut result: u64 = 0;
    let mut index: u32 = 0;
    while index < 8 {
        set result = (result << 8) | (remaining & 0xff);
        set remaining = remaining >> 8;
        set index += 1;
    }
    return result;
}
