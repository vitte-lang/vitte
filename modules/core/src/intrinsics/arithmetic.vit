/// Helpers arithmétiques à débordement explicite.
space core::intrinsics::arithmetic;

export proc add_overflow_u64(left: u64, right: u64) -> bool {
    return left > u64.MAX - right;
}

export proc sub_overflow_u64(left: u64, right: u64) -> bool { return left < right; }

export proc mul_overflow_u64(left: u64, right: u64) -> bool {
    return right != 0 && left > u64.MAX / right;
}

export proc add_overflow_i64(left: i64, right: i64) -> bool {
    if right > 0 { return left > i64.MAX - right; }
    if right < 0 { return left < i64.MIN - right; }
    return false;
}

export proc sub_overflow_i64(left: i64, right: i64) -> bool {
    if right > 0 { return left < i64.MIN + right; }
    if right < 0 { return left > i64.MAX + right; }
    return false;
}

export proc mul_overflow_i64(left: i64, right: i64) -> bool {
    if left == 0 || right == 0 { return false; }
    if left == i64.MIN && right == -1 { return true; }
    if right == i64.MIN && left == -1 { return true; }
    if left > 0 {
        if right > 0 { return left > i64.MAX / right; }
        return right < i64.MIN / left;
    }
    if right > 0 { return left < i64.MIN / right; }
    return left < i64.MAX / right;
}

export proc add_overflow_usize(left: usize, right: usize) -> bool {
    return left > usize.MAX - right;
}

export proc sub_overflow_usize(left: usize, right: usize) -> bool {
    return left < right;
}

export proc mul_overflow_usize(left: usize, right: usize) -> bool {
    return right != 0 && left > usize.MAX / right;
}
