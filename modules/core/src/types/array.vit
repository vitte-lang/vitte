/// Noms explicites pour les tableaux à taille fixe intégrés au langage.
space core::types::array;

/// Tableau de `N` éléments stocké inline.
export type FixedArray<T, const N: usize> = [T; N];

/// Retourne la longueur statique du tableau.
export proc fixed_array_length<T, const N: usize>() -> usize {
    return N;
}
