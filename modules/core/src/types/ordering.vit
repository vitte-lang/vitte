/// Ordres totaux et partiels communs aux algorithmes de comparaison.
space core::types::ordering;

export pick Ordering {
    Less,
    Equal,
    Greater,
}

export pick PartialOrdering {
    Less,
    Equal,
    Greater,
    Unordered,
}

export proc ordering_is_less(value: Ordering) -> bool { return value == Ordering.Less; }
export proc ordering_is_equal(value: Ordering) -> bool { return value == Ordering.Equal; }
export proc ordering_is_greater(value: Ordering) -> bool { return value == Ordering.Greater; }

export proc ordering_is_less_or_equal(value: Ordering) -> bool {
    return value != Ordering.Greater;
}

export proc ordering_is_greater_or_equal(value: Ordering) -> bool {
    return value != Ordering.Less;
}

export proc ordering_reverse(value: Ordering) -> Ordering {
    if value == Ordering.Less { return Ordering.Greater; }
    if value == Ordering.Greater { return Ordering.Less; }
    return Ordering.Equal;
}

export proc partial_ordering_is_less(value: PartialOrdering) -> bool {
    return value == PartialOrdering.Less;
}

export proc partial_ordering_is_equal(value: PartialOrdering) -> bool {
    return value == PartialOrdering.Equal;
}

export proc partial_ordering_is_greater(value: PartialOrdering) -> bool {
    return value == PartialOrdering.Greater;
}

export proc partial_ordering_is_unordered(value: PartialOrdering) -> bool {
    return value == PartialOrdering.Unordered;
}

export proc partial_ordering_is_ordered(value: PartialOrdering) -> bool {
    return value != PartialOrdering.Unordered;
}

export proc partial_ordering_is_less_or_equal(value: PartialOrdering) -> bool {
    return value == PartialOrdering.Less || value == PartialOrdering.Equal;
}

export proc partial_ordering_is_greater_or_equal(value: PartialOrdering) -> bool {
    return value == PartialOrdering.Greater || value == PartialOrdering.Equal;
}

export proc partial_ordering_reverse(value: PartialOrdering) -> PartialOrdering {
    if value == PartialOrdering.Less { return PartialOrdering.Greater; }
    if value == PartialOrdering.Greater { return PartialOrdering.Less; }
    return value;
}
