/// Noms et requêtes de base pour les tranches empruntées.
space core::types::slice;

/// Séquence contiguë empruntée de longueur dynamique.
export type Slice<T> = [T];

/// Retourne le nombre d'éléments de la tranche.
export proc slice_length<T>(value: &[T]) -> usize {
    return value.len();
}

/// Indique si la tranche ne contient aucun élément.
export proc slice_is_empty<T>(value: &[T]) -> bool {
    return value.len() == 0;
}
