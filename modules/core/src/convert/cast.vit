// ============================================================================
// Vitte Standard Library
// Module: core::convert::cast
// File: modules/core/src/convert/cast.vit
//
// Explicit numeric conversions.
//
// Categories:
//   1. Widening conversions
//   2. Checked conversions
//   3. Saturating conversions
//   4. Boolean conversions
//
// Dependencies: none
// Dynamic allocation: none
// ============================================================================

space core::convert::cast;

use core::primitive::float::{f64_is_nan, f64_is_infinite};

// ============================================================================
// 1. CONVERSION RESULT
// ============================================================================

/// Raisons normalisées d'échec d'une conversion contrôlée.
export pick CastError {
    None,
    Negative,
    Overflow,
    Underflow,
    InvalidValue
}

/// Toutes les formes `Cast*Result` exposent les mêmes champs et invariants :
/// succès avec `error == None`, échec avec valeur zéro et erreur non nulle.
export form CastU8Result {
    success: bool,
    value: u8,
    error: CastError
}

export form CastU16Result {
    success: bool,
    value: u16,
    error: CastError
}

export form CastU32Result {
    success: bool,
    value: u32,
    error: CastError
}

export form CastU64Result {
    success: bool,
    value: u64,
    error: CastError
}

export form CastI8Result {
    success: bool,
    value: i8,
    error: CastError
}

export form CastI16Result {
    success: bool,
    value: i16,
    error: CastError
}

export form CastI32Result {
    success: bool,
    value: i32,
    error: CastError
}

export form CastI64Result {
    success: bool,
    value: i64,
    error: CastError
}

// ============================================================================
// 2. LOSSLESS UNSIGNED INTEGER CONVERSIONS
// ============================================================================

export proc cast_u8_to_u16(value: u8) -> u16 {
    return value as u16;
}

export proc cast_u8_to_u32(value: u8) -> u32 {
    return value as u32;
}

export proc cast_u8_to_u64(value: u8) -> u64 {
    return value as u64;
}

export proc cast_u16_to_u32(value: u16) -> u32 {
    return value as u32;
}

export proc cast_u16_to_u64(value: u16) -> u64 {
    return value as u64;
}

export proc cast_u32_to_u64(value: u32) -> u64 {
    return value as u64;
}

