export proc checked_i32_to_u8(value: i32) -> CastU8Result {
    if value < 0 {
        return CastU8Result {
            value: 0,
            error: CastError.Negative,
            success: false
        };
    }

    if value > 255 {
        return CastU8Result {
            value: 0,
            error: CastError.Overflow,
            success: false
        };
    }

    return CastU8Result {
        value: value as u8,
        error: CastError.None,
        success: true
    };
}

export proc checked_i32_to_u16(value: i32) -> CastU16Result {
    if value < 0 {
        return CastU16Result {
            value: 0,
            error: CastError.Negative,
            success: false
        };
    }

    if value > 65535 {
        return CastU16Result {
            value: 0,
            error: CastError.Overflow,
            success: false
        };
    }

    return CastU16Result {
        value: value as u16,
        error: CastError.None,
        success: true
    };
}

export proc checked_i64_to_u32(value: i64) -> CastU32Result {
    if value < 0 {
        return CastU32Result {
            value: 0,
            error: CastError.Negative,
            success: false
        };
    }

    if value > 4294967295 {
        return CastU32Result {
            value: 0,
            error: CastError.Overflow,
            success: false
        };
    }

    return CastU32Result {
        value: value as u32,
        error: CastError.None,
        success: true
