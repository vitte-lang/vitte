/// Conversion tronquée vers zéro, refusant NaN, les infinis et les valeurs hors plage.
export proc checked_f64_to_i64(value: f64) -> CastI64Result {
    if f64_is_nan(value) || f64_is_infinite(value) {
        return CastI64Result { value: 0, error: CastError.InvalidValue, success: false };
    }
    if value < -9223372036854775808.0 {
        return CastI64Result { value: 0, error: CastError.Underflow, success: false };
    }
    if value >= 9223372036854775808.0 {
        return CastI64Result { value: 0, error: CastError.Overflow, success: false };
    }
    return CastI64Result { value: value as i64, error: CastError.None, success: true };
}

export proc checked_f64_to_u64(value: f64) -> CastU64Result {
    if f64_is_nan(value) || f64_is_infinite(value) {
        return CastU64Result { value: 0, error: CastError.InvalidValue, success: false };
    }
    if value < 0.0 {
        return CastU64Result { value: 0, error: CastError.Negative, success: false };
    }
    if value >= 18446744073709551616.0 {
        return CastU64Result { value: 0, error: CastError.Overflow, success: false };
    }
    return CastU64Result { value: value as u64, error: CastError.None, success: true };
}

export proc checked_f32_to_i64(value: f32) -> CastI64Result {
    return checked_f64_to_i64(value as f64);
}

export proc checked_f32_to_u64(value: f32) -> CastU64Result {
    return checked_f64_to_u64(value as f64);
}

// ============================================================================
// 6. CHECKED SIGNED NARROWING
// ============================================================================

export proc checked_i16_to_i8(value: i16) -> CastI8Result {
    if value < -128 {
        return CastI8Result {
            value: 0,
            error: CastError.Underflow,
            success: false
        };
    }

    if value > 127 {
        return CastI8Result {
            value: 0,
            error: CastError.Overflow,
            success: false
        };
    }

    return CastI8Result {
        value: value as i8,
        error: CastError.None,
        success: true
    };
}

export proc checked_i32_to_i16(value: i32) -> CastI16Result {
    if value < -32768 {
        return CastI16Result {
            value: 0,
            error: CastError.Underflow,
            success: false
        };
    }

    if value > 32767 {
        return CastI16Result {
            value: 0,
            error: CastError.Overflow,
            success: false
        };
    }

    return CastI16Result {
        value: value as i16,
        error: CastError.None,
        success: true
    };
}

export proc checked_i64_to_i32(value: i64) -> CastI32Result {
    if value < -2147483648 {
        return CastI32Result {
            value: 0,
            error: CastError.Underflow,
            success: false
        };
    }

    if value > 2147483647 {
        return CastI32Result {
            value: 0,
            error: CastError.Overflow,
            success: false
        };
    }

    return CastI32Result {
        value: value as i32,
        error: CastError.None,
        success: true
    };
}

