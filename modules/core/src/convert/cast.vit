export proc checked_u32_to_i8(value: u32) -> CastI8Result {
    if value > 127 {
        return CastI8Result { value: 0, error: CastError.Overflow, success: false };
    }
    return CastI8Result { value: value as i8, error: CastError.None, success: true };
}

