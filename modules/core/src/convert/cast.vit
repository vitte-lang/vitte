    if value > 255 { return CastU8Result { value: 0, error: CastError.Overflow, success: false }; }
    return CastU8Result { value: value as u8, error: CastError.None, success: true };
}

export proc checked_i16_to_u16(value: i16) -> CastU16Result {
    if value < 0 { return CastU16Result { value: 0, error: CastError.Negative, success: false }; }
    return CastU16Result { value: value as u16, error: CastError.None, success: true };
}

