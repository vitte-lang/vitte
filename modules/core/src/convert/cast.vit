}

export proc cast_u16_to_i64(value: u16) -> i64 {
    return value as i64;
}

export proc cast_u32_to_i64(value: u32) -> i64 {
    return value as i64;
}

// ============================================================================
// 5. CHECKED UNSIGNED NARROWING
// ============================================================================

export proc checked_u16_to_u8(value: u16) -> CastU8Result {
    if value > 255 {
        return CastU8Result {
            value: 0,
            error: CastError.Overflow,
            success: false
        };
    }

    return CastU8Result {
        value: value as u8,
        error: CastError.None,
        success: true
    };
}

export proc checked_u32_to_u8(value: u32) -> CastU8Result {
    if value > 255 {
        return CastU8Result {
            value: 0,
