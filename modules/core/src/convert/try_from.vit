/// Conversions réductrices vérifiées avant la conversion de type.
space core::convert::try_from;

use core::convert::cast::{
    CastU8Result, CastU16Result, CastU32Result, CastU64Result,
    CastI8Result, CastI16Result, CastI32Result, CastI64Result,
    checked_u16_to_u8, checked_u32_to_u8, checked_u64_to_u8,
    checked_u32_to_u16, checked_u64_to_u16, checked_u64_to_u32,
    checked_i16_to_i8, checked_i32_to_i16, checked_i64_to_i32,
    checked_i32_to_u8, checked_i32_to_u16, checked_i64_to_u32,
    checked_u32_to_i8, checked_i32_to_i8, checked_i64_to_i8, checked_i64_to_i16,
    checked_i64_to_u8, checked_i64_to_u16, checked_u64_to_i64, checked_i64_to_u64,
    checked_u16_to_i8, checked_u16_to_i16, checked_u32_to_i16, checked_u32_to_i32,
    checked_u64_to_i8, checked_u64_to_i16, checked_u64_to_i32,
    checked_i8_to_u8, checked_i8_to_u16, checked_i8_to_u32, checked_i8_to_u64,
    checked_i16_to_u8, checked_i16_to_u16, checked_i16_to_u32, checked_i16_to_u64,
    checked_i32_to_u32, checked_i32_to_u64, checked_u8_to_i8,
    checked_f32_to_i64, checked_f32_to_u64, checked_f64_to_i64, checked_f64_to_u64
};

export proc try_from_u16_to_u8(value: u16) -> CastU8Result { return checked_u16_to_u8(value); }
export proc try_from_u32_to_u8(value: u32) -> CastU8Result { return checked_u32_to_u8(value); }
export proc try_from_u64_to_u8(value: u64) -> CastU8Result { return checked_u64_to_u8(value); }
export proc try_from_u32_to_u16(value: u32) -> CastU16Result { return checked_u32_to_u16(value); }
export proc try_from_u64_to_u16(value: u64) -> CastU16Result { return checked_u64_to_u16(value); }
export proc try_from_u64_to_u32(value: u64) -> CastU32Result { return checked_u64_to_u32(value); }
export proc try_from_i16_to_i8(value: i16) -> CastI8Result { return checked_i16_to_i8(value); }
export proc try_from_i32_to_i16(value: i32) -> CastI16Result { return checked_i32_to_i16(value); }
export proc try_from_i64_to_i32(value: i64) -> CastI32Result { return checked_i64_to_i32(value); }
export proc try_from_i32_to_u8(value: i32) -> CastU8Result { return checked_i32_to_u8(value); }
export proc try_from_i32_to_u16(value: i32) -> CastU16Result { return checked_i32_to_u16(value); }
export proc try_from_i64_to_u32(value: i64) -> CastU32Result { return checked_i64_to_u32(value); }
export proc try_from_u32_to_i8(value: u32) -> CastI8Result { return checked_u32_to_i8(value); }
export proc try_from_i32_to_i8(value: i32) -> CastI8Result { return checked_i32_to_i8(value); }
export proc try_from_i64_to_i8(value: i64) -> CastI8Result { return checked_i64_to_i8(value); }
export proc try_from_i64_to_i16(value: i64) -> CastI16Result { return checked_i64_to_i16(value); }
export proc try_from_i64_to_u8(value: i64) -> CastU8Result { return checked_i64_to_u8(value); }
export proc try_from_i64_to_u16(value: i64) -> CastU16Result { return checked_i64_to_u16(value); }
export proc try_from_u64_to_i64(value: u64) -> CastI64Result { return checked_u64_to_i64(value); }
export proc try_from_i64_to_u64(value: i64) -> CastU64Result { return checked_i64_to_u64(value); }
export proc try_from_u16_to_i8(value: u16) -> CastI8Result { return checked_u16_to_i8(value); }
export proc try_from_u8_to_i8(value: u8) -> CastI8Result { return checked_u8_to_i8(value); }
export proc try_from_u16_to_i16(value: u16) -> CastI16Result { return checked_u16_to_i16(value); }
export proc try_from_u32_to_i16(value: u32) -> CastI16Result { return checked_u32_to_i16(value); }
export proc try_from_u32_to_i32(value: u32) -> CastI32Result { return checked_u32_to_i32(value); }
export proc try_from_u64_to_i8(value: u64) -> CastI8Result { return checked_u64_to_i8(value); }
export proc try_from_u64_to_i16(value: u64) -> CastI16Result { return checked_u64_to_i16(value); }
export proc try_from_u64_to_i32(value: u64) -> CastI32Result { return checked_u64_to_i32(value); }
export proc try_from_i8_to_u8(value: i8) -> CastU8Result { return checked_i8_to_u8(value); }
export proc try_from_i8_to_u16(value: i8) -> CastU16Result { return checked_i8_to_u16(value); }
export proc try_from_i8_to_u32(value: i8) -> CastU32Result { return checked_i8_to_u32(value); }
export proc try_from_i8_to_u64(value: i8) -> CastU64Result { return checked_i8_to_u64(value); }
export proc try_from_i16_to_u8(value: i16) -> CastU8Result { return checked_i16_to_u8(value); }
export proc try_from_i16_to_u16(value: i16) -> CastU16Result { return checked_i16_to_u16(value); }
export proc try_from_i16_to_u32(value: i16) -> CastU32Result { return checked_i16_to_u32(value); }
export proc try_from_i16_to_u64(value: i16) -> CastU64Result { return checked_i16_to_u64(value); }
export proc try_from_i32_to_u32(value: i32) -> CastU32Result { return checked_i32_to_u32(value); }
export proc try_from_i32_to_u64(value: i32) -> CastU64Result { return checked_i32_to_u64(value); }
export proc try_from_f32_to_i64(value: f32) -> CastI64Result { return checked_f32_to_i64(value); }
export proc try_from_f32_to_u64(value: f32) -> CastU64Result { return checked_f32_to_u64(value); }
export proc try_from_f64_to_i64(value: f64) -> CastI64Result { return checked_f64_to_i64(value); }
