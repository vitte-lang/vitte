// ============================================================================
// Vitte Standard Library
// Module: core::convert::into
// File: modules/core/src/convert/into.vit
//
// Infallible, value-preserving conversions.
//
// Dependencies:
//   core::convert::from
//
// Properties:
//   - Native Vitte implementation
//   - No dynamic allocation
//   - No libc dependency
//   - No runtime range checking
//   - No narrowing conversions
//
// Naming:
//   into_<destination>_from_<source>
//
// Example:
//   into_u64_from_u8(42)
// ============================================================================

space core::convert::into;

use core::convert::from::{
    from_u8_to_u16,
    from_u8_to_u32,
    from_u8_to_u64,
    from_u16_to_u32,
    from_u16_to_u64,
    from_u32_to_u64,

    from_i8_to_i16,
    from_i8_to_i32,
    from_i8_to_i64,
    from_i16_to_i32,
    from_i16_to_i64,
    from_i32_to_i64,

    from_u8_to_i16,
    from_u8_to_i32,
    from_u8_to_i64,
    from_u16_to_i32,
    from_u16_to_i64,
    from_u32_to_i64,

    from_bool_to_u8,
    from_bool_to_u16,
    from_bool_to_u32,
    from_bool_to_u64,

    from_bool_to_i8,
    from_bool_to_i16,
    from_bool_to_i32,
    from_bool_to_i64,

    from_bool_to_f32,
    from_bool_to_f64,

    from_i8_to_f32,
    from_u8_to_f32,
    from_i16_to_f32,
    from_u16_to_f32,

    from_i8_to_f64,
    from_u8_to_f64,
    from_i16_to_f64,
    from_u16_to_f64,
    from_i32_to_f64,
    from_u32_to_f64,

    from_f32_to_f64,

    from_i8_to_i8,
    from_i16_to_i16,
    from_i32_to_i32,
    from_i64_to_i64,

    from_u8_to_u8,
    from_u16_to_u16,
    from_u32_to_u32,
    from_u64_to_u64,

    from_f32_to_f32,
    from_f64_to_f64,
    from_bool_to_bool
};

// ============================================================================
// 1. UNSIGNED INTEGER WIDENING
// ============================================================================

export proc into_u16_from_u8(value: u8) -> u16 {
    return from_u8_to_u16(value);
}

export proc into_u32_from_u8(value: u8) -> u32 {
    return from_u8_to_u32(value);
}

export proc into_u64_from_u8(value: u8) -> u64 {
    return from_u8_to_u64(value);
}

export proc into_u32_from_u16(value: u16) -> u32 {
    return from_u16_to_u32(value);
}

export proc into_u64_from_u16(value: u16) -> u64 {
    return from_u16_to_u64(value);
}

export proc into_u64_from_u32(value: u32) -> u64 {
    return from_u32_to_u64(value);
}

// ============================================================================
// 2. SIGNED INTEGER WIDENING
// ============================================================================

export proc into_i16_from_i8(value: i8) -> i16 {
    return from_i8_to_i16(value);
}

export proc into_i32_from_i8(value: i8) -> i32 {
    return from_i8_to_i32(value);
}

export proc into_i64_from_i8(value: i8) -> i64 {
    return from_i8_to_i64(value);
}

export proc into_i32_from_i16(value: i16) -> i32 {
    return from_i16_to_i32(value);
}

export proc into_i64_from_i16(value: i16) -> i64 {
    return from_i16_to_i64(value);
}

export proc into_i64_from_i32(value: i32) -> i64 {
    return from_i32_to_i64(value);
}

// ============================================================================
// 3. UNSIGNED TO SIGNED WIDENING
// ============================================================================

export proc into_i16_from_u8(value: u8) -> i16 {
    return from_u8_to_i16(value);
}

export proc into_i32_from_u8(value: u8) -> i32 {
    return from_u8_to_i32(value);
}

export proc into_i64_from_u8(value: u8) -> i64 {
    return from_u8_to_i64(value);
}

export proc into_i32_from_u16(value: u16) -> i32 {
    return from_u16_to_i32(value);
}

export proc into_i64_from_u16(value: u16) -> i64 {
    return from_u16_to_i64(value);
}

export proc into_i64_from_u32(value: u32) -> i64 {
    return from_u32_to_i64(value);
}

// ============================================================================
// 4. BOOLEAN TO UNSIGNED INTEGER
// ============================================================================

export proc into_u8_from_bool(value: bool) -> u8 {
    return from_bool_to_u8(value);
}

export proc into_u16_from_bool(value: bool) -> u16 {
    return from_bool_to_u16(value);
}

export proc into_u32_from_bool(value: bool) -> u32 {
    return from_bool_to_u32(value);
}

export proc into_u64_from_bool(value: bool) -> u64 {
    return from_bool_to_u64(value);
}

// ============================================================================
// 5. BOOLEAN TO SIGNED INTEGER
// ============================================================================

export proc into_i8_from_bool(value: bool) -> i8 {
    return from_bool_to_i8(value);
}

export proc into_i16_from_bool(value: bool) -> i16 {
    return from_bool_to_i16(value);
}

export proc into_i32_from_bool(value: bool) -> i32 {
    return from_bool_to_i32(value);
}

export proc into_i64_from_bool(value: bool) -> i64 {
    return from_bool_to_i64(value);
}

// ============================================================================
// 6. BOOLEAN TO FLOATING POINT
// ============================================================================

export proc into_f32_from_bool(value: bool) -> f32 {
    return from_bool_to_f32(value);
}

export proc into_f64_from_bool(value: bool) -> f64 {
    return from_bool_to_f64(value);
}

// ============================================================================
// 7. EXACT INTEGER TO f32
// ============================================================================

export proc into_f32_from_i8(value: i8) -> f32 {
    return from_i8_to_f32(value);
}

export proc into_f32_from_u8(value: u8) -> f32 {
    return from_u8_to_f32(value);
}

export proc into_f32_from_i16(value: i16) -> f32 {
    return from_i16_to_f32(value);
}

export proc into_f32_from_u16(value: u16) -> f32 {
    return from_u16_to_f32(value);
}

// ============================================================================
// 8. EXACT INTEGER TO f64
// ============================================================================

export proc into_f64_from_i8(value: i8) -> f64 {
    return from_i8_to_f64(value);
}

export proc into_f64_from_u8(value: u8) -> f64 {
