/// Analyseur natif de nombres entiers et de booléens.
space core::convert::parse;

const PARSE_U64_MAX: u64 = 18446744073709551615;
const PARSE_I64_MAX: i64 = 9223372036854775807;
const PARSE_I64_MIN: i64 = -9223372036854775807 - 1;
const PARSE_I64_MIN_MAGNITUDE: u64 = 9223372036854775808;

/// Raisons normalisées d'échec d'un parse.
export pick ParseError {
    None,
    Empty,
    InvalidBase,
    InvalidDigit,
    Overflow,
}

/// `success` implique `error == None` et `error_index == 0`. En cas d'échec,
/// `value` vaut zéro et `error_index` désigne la position du problème; pour un
/// dépassement détecté après conversion vers un type plus étroit, il vaut la
/// longueur du texte.
export form ParseU64Result {
    success: bool,
    value: u64,
    error: ParseError,
    error_index: usize,
}

export form ParseI64Result {
    success: bool,
    value: i64,
    error: ParseError,
    error_index: usize,
}

export form ParseBoolResult {
    success: bool,
    value: bool,
    error: ParseError,
    error_index: usize,
}

export form ParseU8Result { success: bool, value: u8, error: ParseError, error_index: usize }
export form ParseU16Result { success: bool, value: u16, error: ParseError, error_index: usize }
export form ParseU32Result { success: bool, value: u32, error: ParseError, error_index: usize }
export form ParseI8Result { success: bool, value: i8, error: ParseError, error_index: usize }
export form ParseI16Result { success: bool, value: i16, error: ParseError, error_index: usize }
export form ParseI32Result { success: bool, value: i32, error: ParseError, error_index: usize }

proc parse_error_u64(error: ParseError, index: usize) -> ParseU64Result {
    return ParseU64Result { success: false, value: 0, error: error, error_index: index };
}

proc parse_error_i64(error: ParseError, index: usize) -> ParseI64Result {
    return ParseI64Result { success: false, value: 0, error: error, error_index: index };
}

proc parse_digit(character: char) -> i32 {
    let code: u32 = character as u32;
    if code >= 48 && code <= 57 { return (code - 48) as i32; }
    if code >= 65 && code <= 90 { return (code - 65 + 10) as i32; }
    if code >= 97 && code <= 122 { return (code - 97 + 10) as i32; }
    return -1;
}

proc parse_bool_prefix_length(text: str, token: str) -> usize {
    let mut index: usize = 0;
    while index < text.length && index < token.length {
        let string_index: i64 = index as i64;
        if text[string_index] != token[string_index] { break; }
        set index = index + 1;
    }
    return index;
}

proc parse_bool_error_index(text: str) -> usize {
    let mut best: usize = parse_bool_prefix_length(text, "true");
    let false_prefix: usize = parse_bool_prefix_length(text, "false");
    let one_prefix: usize = parse_bool_prefix_length(text, "1");
    let zero_prefix: usize = parse_bool_prefix_length(text, "0");
    if false_prefix > best { set best = false_prefix; }
    if one_prefix > best { set best = one_prefix; }
    if zero_prefix > best { set best = zero_prefix; }
    return best;
}

export proc parse_u64(text: str, base: u32) -> ParseU64Result {
    if text.length == 0 { return parse_error_u64(ParseError.Empty, 0); }
    if base < 2 || base > 36 { return parse_error_u64(ParseError.InvalidBase, 0); }

    let mut value: u64 = 0;
    let mut index: usize = 0;
    while index < text.length {
        let string_index: i64 = index as i64;
        let digit: i32 = parse_digit(text[string_index]);
        if digit < 0 || digit >= base as i32 {
            return parse_error_u64(ParseError.InvalidDigit, index);
        }
        let unsigned_digit: u64 = digit as u64;
        if value > (PARSE_U64_MAX - unsigned_digit) / base as u64 {
            return parse_error_u64(ParseError.Overflow, index);
        }
        set value = value * base as u64 + unsigned_digit;
        set index = index + 1;
    }

    return ParseU64Result { success: true, value: value, error: ParseError.None, error_index: 0 };
}

export proc parse_i64(text: str, base: u32) -> ParseI64Result {
    if text.length == 0 { return parse_error_i64(ParseError.Empty, 0); }
    if base < 2 || base > 36 { return parse_error_i64(ParseError.InvalidBase, 0); }

    let mut index: usize = 0;
    let mut negative: bool = false;
    if text[0] == '-' {
        set negative = true;
        set index = 1;
    } else if text[0] == '+' {
        set index = 1;
    }
    if index >= text.length { return parse_error_i64(ParseError.Empty, index); }

    let mut limit: u64 = PARSE_I64_MAX as u64;
    if negative { set limit = PARSE_I64_MIN_MAGNITUDE; }
    let mut magnitude: u64 = 0;
    while index < text.length {
        let string_index: i64 = index as i64;
        let digit: i32 = parse_digit(text[string_index]);
        if digit < 0 || digit >= base as i32 {
            return parse_error_i64(ParseError.InvalidDigit, index);
        }
        let unsigned_digit: u64 = digit as u64;
        if magnitude > (limit - unsigned_digit) / base as u64 {
            return parse_error_i64(ParseError.Overflow, index);
        }
        set magnitude = magnitude * base as u64 + unsigned_digit;
        set index = index + 1;
    }

    let mut value: i64 = magnitude as i64;
    if negative {
        if magnitude == PARSE_I64_MIN_MAGNITUDE {
            set value = PARSE_I64_MIN;
        } else {
            set value = -value;
        }
    }
    return ParseI64Result { success: true, value: value, error: ParseError.None, error_index: 0 };
}

export proc parse_bool(text: str) -> ParseBoolResult {
    if text == "true" || text == "1" {
        return ParseBoolResult { success: true, value: true, error: ParseError.None, error_index: 0 };
    }
    if text == "false" || text == "0" {
        return ParseBoolResult { success: true, value: false, error: ParseError.None, error_index: 0 };
    }
    if text.length == 0 {
        return ParseBoolResult { success: false, value: false, error: ParseError.Empty, error_index: 0 };
    }
    return ParseBoolResult {
        success: false,
        value: false,
        error: ParseError.InvalidDigit,
        error_index: parse_bool_error_index(text),
    };
}

export proc parse_u8(text: str, base: u32) -> ParseU8Result {
    let parsed: ParseU64Result = parse_u64(text, base);
    if not parsed.success { return ParseU8Result { success: false, value: 0, error: parsed.error, error_index: parsed.error_index }; }
    if parsed.value > 255 { return ParseU8Result { success: false, value: 0, error: ParseError.Overflow, error_index: text.length }; }
    return ParseU8Result { success: true, value: parsed.value as u8, error: ParseError.None, error_index: 0 };
}

export proc parse_u16(text: str, base: u32) -> ParseU16Result {
    let parsed: ParseU64Result = parse_u64(text, base);
    if not parsed.success { return ParseU16Result { success: false, value: 0, error: parsed.error, error_index: parsed.error_index }; }
    if parsed.value > 65535 { return ParseU16Result { success: false, value: 0, error: ParseError.Overflow, error_index: text.length }; }
    return ParseU16Result { success: true, value: parsed.value as u16, error: ParseError.None, error_index: 0 };
}

export proc parse_u32(text: str, base: u32) -> ParseU32Result {
    let parsed: ParseU64Result = parse_u64(text, base);
    if not parsed.success { return ParseU32Result { success: false, value: 0, error: parsed.error, error_index: parsed.error_index }; }
    if parsed.value > 4294967295 { return ParseU32Result { success: false, value: 0, error: ParseError.Overflow, error_index: text.length }; }
    return ParseU32Result { success: true, value: parsed.value as u32, error: ParseError.None, error_index: 0 };
}

export proc parse_i8(text: str, base: u32) -> ParseI8Result {
    let parsed: ParseI64Result = parse_i64(text, base);
    if not parsed.success { return ParseI8Result { success: false, value: 0, error: parsed.error, error_index: parsed.error_index }; }
    if parsed.value < -128 { return ParseI8Result { success: false, value: 0, error: ParseError.Overflow, error_index: text.length }; }
    if parsed.value > 127 { return ParseI8Result { success: false, value: 0, error: ParseError.Overflow, error_index: text.length }; }
    return ParseI8Result { success: true, value: parsed.value as i8, error: ParseError.None, error_index: 0 };
}

export proc parse_i16(text: str, base: u32) -> ParseI16Result {
    let parsed: ParseI64Result = parse_i64(text, base);
    if not parsed.success { return ParseI16Result { success: false, value: 0, error: parsed.error, error_index: parsed.error_index }; }
    if parsed.value < -32768 { return ParseI16Result { success: false, value: 0, error: ParseError.Overflow, error_index: text.length }; }
    if parsed.value > 32767 { return ParseI16Result { success: false, value: 0, error: ParseError.Overflow, error_index: text.length }; }
    return ParseI16Result { success: true, value: parsed.value as i16, error: ParseError.None, error_index: 0 };
}

export proc parse_i32(text: str, base: u32) -> ParseI32Result {
    let parsed: ParseI64Result = parse_i64(text, base);
    if not parsed.success { return ParseI32Result { success: false, value: 0, error: parsed.error, error_index: parsed.error_index }; }
    if parsed.value < -2147483648 { return ParseI32Result { success: false, value: 0, error: ParseError.Overflow, error_index: text.length }; }
    if parsed.value > 2147483647 { return ParseI32Result { success: false, value: 0, error: ParseError.Overflow, error_index: text.length }; }
    return ParseI32Result { success: true, value: parsed.value as i32, error: ParseError.None, error_index: 0 };
}
