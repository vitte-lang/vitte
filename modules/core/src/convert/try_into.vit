export proc try_into_i16_from_u16(value: u16) -> CastI16Result { return try_from_u16_to_i16(value); }
export proc try_into_i16_from_u32(value: u32) -> CastI16Result { return try_from_u32_to_i16(value); }
export proc try_into_i32_from_u32(value: u32) -> CastI32Result { return try_from_u32_to_i32(value); }
