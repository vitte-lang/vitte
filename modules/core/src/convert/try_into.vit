export proc try_into_i16_from_u64(value: u64) -> CastI16Result { return try_from_u64_to_i16(value); }
export proc try_into_i32_from_u64(value: u64) -> CastI32Result { return try_from_u64_to_i32(value); }
export proc try_into_u8_from_i8(value: i8) -> CastU8Result { return try_from_i8_to_u8(value); }
export proc try_into_u16_from_i8(value: i8) -> CastU16Result { return try_from_i8_to_u16(value); }
export proc try_into_u32_from_i8(value: i8) -> CastU32Result { return try_from_i8_to_u32(value); }
export proc try_into_u64_from_i8(value: i8) -> CastU64Result { return try_from_i8_to_u64(value); }
export proc try_into_u8_from_i16(value: i16) -> CastU8Result { return try_from_i16_to_u8(value); }
export proc try_into_u16_from_i16(value: i16) -> CastU16Result { return try_from_i16_to_u16(value); }
export proc try_into_u32_from_i16(value: i16) -> CastU32Result { return try_from_i16_to_u32(value); }
export proc try_into_u64_from_i16(value: i16) -> CastU64Result { return try_from_i16_to_u64(value); }
