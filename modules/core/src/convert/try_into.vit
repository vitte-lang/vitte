/// API de conversion contrôlée nommé depuis le type source.
space core::convert::try_into;

use core::convert::try_from::{
    try_from_u16_to_u8, try_from_u32_to_u8, try_from_u64_to_u8,
    try_from_u32_to_u16, try_from_u64_to_u16, try_from_u64_to_u32,
    try_from_i16_to_i8, try_from_i32_to_i16, try_from_i64_to_i32,
    try_from_i32_to_u8, try_from_i32_to_u16, try_from_i64_to_u32,
    try_from_u32_to_i8, try_from_i32_to_i8, try_from_i64_to_i8, try_from_i64_to_i16,
    try_from_i64_to_u8, try_from_i64_to_u16, try_from_u64_to_i64, try_from_i64_to_u64,
    try_from_u16_to_i8, try_from_u16_to_i16, try_from_u32_to_i16, try_from_u32_to_i32,
    try_from_u64_to_i8, try_from_u64_to_i16, try_from_u64_to_i32,
    try_from_i8_to_u8, try_from_i8_to_u16, try_from_i8_to_u32, try_from_i8_to_u64,
    try_from_i16_to_u8, try_from_i16_to_u16, try_from_i16_to_u32, try_from_i16_to_u64,
    try_from_i32_to_u32, try_from_i32_to_u64, try_from_u8_to_i8,
    try_from_f32_to_i64, try_from_f32_to_u64, try_from_f64_to_i64, try_from_f64_to_u64
};
use core::convert::cast::{
    CastU8Result, CastU16Result, CastU32Result, CastU64Result,
    CastI8Result, CastI16Result, CastI32Result, CastI64Result
};

export proc try_into_u8_from_u16(value: u16) -> CastU8Result { return try_from_u16_to_u8(value); }
export proc try_into_u8_from_u32(value: u32) -> CastU8Result { return try_from_u32_to_u8(value); }
export proc try_into_u8_from_u64(value: u64) -> CastU8Result { return try_from_u64_to_u8(value); }
export proc try_into_u16_from_u32(value: u32) -> CastU16Result { return try_from_u32_to_u16(value); }
export proc try_into_u16_from_u64(value: u64) -> CastU16Result { return try_from_u64_to_u16(value); }
export proc try_into_u32_from_u64(value: u64) -> CastU32Result { return try_from_u64_to_u32(value); }
export proc try_into_i8_from_i16(value: i16) -> CastI8Result { return try_from_i16_to_i8(value); }
export proc try_into_i16_from_i32(value: i32) -> CastI16Result { return try_from_i32_to_i16(value); }
export proc try_into_i32_from_i64(value: i64) -> CastI32Result { return try_from_i64_to_i32(value); }
export proc try_into_u8_from_i32(value: i32) -> CastU8Result { return try_from_i32_to_u8(value); }
export proc try_into_u16_from_i32(value: i32) -> CastU16Result { return try_from_i32_to_u16(value); }
export proc try_into_u32_from_i64(value: i64) -> CastU32Result { return try_from_i64_to_u32(value); }
export proc try_into_i8_from_u32(value: u32) -> CastI8Result { return try_from_u32_to_i8(value); }
