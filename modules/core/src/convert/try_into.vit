export proc try_into_u8_from_i64(value: i64) -> CastU8Result { return try_from_i64_to_u8(value); }
export proc try_into_u16_from_i64(value: i64) -> CastU16Result { return try_from_i64_to_u16(value); }
export proc try_into_i64_from_u64(value: u64) -> CastI64Result { return try_from_u64_to_i64(value); }
