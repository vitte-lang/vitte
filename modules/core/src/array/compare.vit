space core::array::compare

/// Vérifie si deux tableaux sont identiques.
proc array_equal[T](
    left: &[T],
    right: &[T]
) -> bool {
    if left.len() != right.len() {
        return false;
    }

    for i in 0..left.len() {
        if left[i] != right[i] {
            return false;
        }
    }

    return true;
}

/// Compare deux tableaux lexicographiquement.
/// Retourne -1, 0 ou 1.
proc array_compare[T](
    left: &[T],
    right: &[T]
) -> i32 {
    let mut limit = left.len();

    if right.len() < limit {
        set limit = right.len();
    }

    for i in 0..limit {
        if left[i] < right[i] {
            return -1;
        }

        if left[i] > right[i] {
            return 1;
        }
    }

    if left.len() < right.len() {
        return -1;
    }

    if left.len() > right.len() {
        return 1;
    }

    return 0;
}

/// Vérifie si deux tableaux sont différents.
proc array_not_equal[T](
    left: &[T],
    right: &[T]
) -> bool {
    return not array_equal(left, right);
}

/// Vérifie si un tableau commence par un préfixe.
proc array_starts_with[T](
    array: &[T],
    prefix: &[T]
) -> bool {
    if prefix.len() > array.len() {
        return false;
    }

    for i in 0..prefix.len() {
        if array[i] != prefix[i] {
            return false;
        }
    }

    return true;
}

/// Vérifie si un tableau se termine par un suffixe.
proc array_ends_with[T](
    array: &[T],
    suffix: &[T]
) -> bool {
    if suffix.len() > array.len() {
        return false;
    }

    let offset = array.len() - suffix.len();

    for i in 0..suffix.len() {
        if array[offset + i] != suffix[i] {
            return false;
        }
    }

    return true;
}