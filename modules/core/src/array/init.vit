space core::array::init

/// Initialise tous les éléments avec une valeur donnée.
proc array_init_fill[T](
    array: &mut [T],
    value: T
) {
    for i in 0..array.len() {
        set array[i] = value;
    }
}

/// Initialise les éléments avec leur valeur par défaut.
proc array_init_default[T](
    array: &mut [T]
) {
    for i in 0..array.len() {
        set array[i] = T::default();
    }
}

/// Initialise tous les éléments à zéro.
proc array_init_zero[T](
    array: &mut [T]
) {
    for i in 0..array.len() {
        set array[i] = T::zero();
    }
}

/// Initialise les éléments à partir d'une fonction génératrice.
proc array_init_with[T](
    array: &mut [T],
    generator: proc(usize) -> T
) {
    for i in 0..array.len() {
        set array[i] = generator(i);
    }
}

/// Initialise les éléments à partir de leur indice.
proc array_init_indexed(
    array: &mut [usize]
) {
    for i in 0..array.len() {
        set array[i] = i;
    }
}

/// Initialise un tableau avec une séquence croissante.
proc array_init_sequence(
    array: &mut [i64],
    start: i64,
    step: i64
) {
    let mut current: i64 = start;

    for i in 0..array.len() {
        set array[i] = current;
        set current = current + step;
    }
}

/// Initialise un tableau avec une séquence décroissante.
proc array_init_reverse_sequence(
    array: &mut [i64],
    start: i64,
    step: i64
) {
    let mut current: i64 = start;

    for i in 0..array.len() {
        set array[i] = current;
        set current = current - step;
    }
}

/// Copie les éléments d'un tableau source.
/// Retourne le nombre d'éléments copiés.
proc array_init_copy[T](
    destination: &mut [T],
    source: &[T]
) -> usize {
    let mut count = destination.len();

    if source.len() < count {
        set count = source.len();
    }

    for i in 0..count {
        set destination[i] = source[i];
    }

    return count;
}

/// Initialise uniquement les éléments satisfaisant une condition.
proc array_init_if[T](
    array: &mut [T],
    predicate: proc(usize) -> bool,
    value: T
) {
    for i in 0..array.len() {
        if predicate(i) {
            set array[i] = value;
        }
    }
}

/// Initialise les éléments d'une plage [start, end).
proc array_init_range[T](
    array: &mut [T],
    start: usize,
    end: usize,
    value: T
) {
    let mut begin = start;
    let mut limit = end;

    if begin > array.len() {
        set begin = array.len();
    }

    if limit > array.len() {
        set limit = array.len();
    }

    for i in begin..limit {
        set array[i] = value;
    }
}

/// Initialise les éléments d'un tableau avec une alternance de valeurs.
proc array_init_alternating[T](
    array: &mut [T],
    first: T,
    second: T
) {
    for i in 0..array.len() {
        if i % 2 == 0 {
            set array[i] = first;
        } else {
            set array[i] = second;
        }
    }
}

/// Initialise les éléments selon une progression géométrique.
proc array_init_geometric(
    array: &mut [i64],
    start: i64,
    ratio: i64
) {
    let mut current: i64 = start;

    for i in 0..array.len() {
        set array[i] = current;
        set current = current * ratio;
    }
}

/// Initialise tous les éléments avec la même valeur booléenne.
proc array_init_bool(
    array: &mut [bool],
    value: bool
) {
    for i in 0..array.len() {
        set array[i] = value;
    }
}

/// Initialise un tableau de booléens à false.
proc array_init_false(
    array: &mut [bool]
) {
    for i in 0..array.len() {
        set array[i] = false;
    }
}

/// Initialise un tableau de booléens à true.
proc array_init_true(
    array: &mut [bool]
) {
    for i in 0..array.len() {
        set array[i] = true;
    }
}