space core::array::map

/// Transforme les éléments d'un tableau source.
/// Retourne le nombre d'éléments transformés.
proc array_map<T, U>(
    source: &[T],
    destination: &mut [U],
    transform: proc(&T) -> U
) -> usize {
    let mut limit: usize = source.len();

    if destination.len() < limit {
        set limit = destination.len();
    }

    for i in 0..limit {
        set destination[i] = transform(&source[i]);
    }

    return limit;
}

/// Transforme les éléments en transmettant leur indice.
proc array_map_indexed<T, U>(
    source: &[T],
    destination: &mut [U],
    transform: proc(usize, &T) -> U
) -> usize {
    let mut limit: usize = source.len();

    if destination.len() < limit {
        set limit = destination.len();
    }

    for i in 0..limit {
        set destination[i] = transform(i, &source[i]);
    }

    return limit;
}

/// Transforme directement les éléments du tableau.
proc array_map_in_place<T>(
    array: &mut [T],
    transform: proc(&T) -> T
) {
    for i in 0..array.len() {
        let value: T = transform(&array[i]);
        set array[i] = value;
    }
}

/// Transforme uniquement une plage d'éléments.
proc array_map_range<T, U>(
    source: &[T],
    destination: &mut [U],
    start: usize,
    end: usize,
    transform: proc(&T) -> U
) -> usize {
    let mut limit: usize = source.len();

    if destination.len() < limit {
        set limit = destination.len();
    }

    let mut begin: usize = start;
    let mut finish: usize = end;

    if begin > limit {
        set begin = limit;
    }

    if finish > limit {
        set finish = limit;
    }

    if begin >= finish {
        return 0;
    }

    for i in begin..finish {
        set destination[i] = transform(&source[i]);
    }

    return finish - begin;
}

/// Transforme les éléments dans l'ordre inverse.
/// Le résultat est également inversé.
proc array_map_reverse<T, U>(
    source: &[T],
    destination: &mut [U],
    transform: proc(&T) -> U
) -> usize {
    let mut limit: usize = source.len();

    if destination.len() < limit {
        set limit = destination.len();
    }

    for i in 0..limit {
        let source_index: usize = source.len() - 1 - i;
        set destination[i] = transform(&source[source_index]);
    }

    return limit;
}

/// Transforme les éléments satisfaisant un prédicat.
/// Les autres positions de destination restent inchangées.
proc array_map_if<T, U>(
    source: &[T],
    destination: &mut [U],
    predicate: proc(&T) -> bool,
    transform: proc(&T) -> U
) -> usize {
    let mut limit: usize = source.len();
    let mut count: usize = 0;

    if destination.len() < limit {
        set limit = destination.len();
    }

    for i in 0..limit {
        if predicate(&source[i]) {
            set destination[i] = transform(&source[i]);
            set count = count + 1;
        }
    }

    return count;
}

/// Transforme deux tableaux simultanément.
proc array_map_zip<T, U, V>(
    left: &[T],
    right: &[U],
    destination: &mut [V],
    transform: proc(&T, &U) -> V
) -> usize {
    let mut limit: usize = left.len();

    if right.len() < limit {
        set limit = right.len();
    }

    if destination.len() < limit {
        set limit = destination.len();
    }

    for i in 0..limit {
        set destination[i] = transform(&left[i], &right[i]);
    }

    return limit;
}

/// Transforme un tableau en utilisant un accumulateur.
proc array_map_accumulate<T, U, A>(
    source: &[T],
    destination: &mut [U],
    initial: A,
    transform: proc(A, &T) -> A,
    project: proc(&A) -> U
) -> A {
    let mut accumulator: A = initial;
    let mut limit: usize = source.len();

    if destination.len() < limit {
        set limit = destination.len();
    }

    for i in 0..limit {
        set accumulator = transform(accumulator, &source[i]);
        set destination[i] = project(&accumulator);
    }

    return accumulator;
}

/// Transforme un tableau avec un pas fixe.
proc array_map_step<T, U>(
    source: &[T],
    destination: &mut [U],
    step: usize,
    transform: proc(&T) -> U
) -> usize {
    if step == 0 {
        return 0;
    }

    let mut read: usize = 0;
    let mut written: usize = 0;

    while read < source.len() {
        if written >= destination.len() {
            return written;
        }

        set destination[written] = transform(&source[read]);
        set written = written + 1;

        if step >= source.len() - read {
            return written;
        }

        set read = read + step;
    }

    return written;
}

/// Transforme les éléments et supprime les résultats
/// refusés par un prédicat.
proc array_filter_map<T, U>(
    source: &[T],
    destination: &mut [U],
    predicate: proc(&T) -> bool,
    transform: proc(&T) -> U
) -> usize {
    let mut written: usize = 0;

    for i in 0..source.len() {
        if predicate(&source[i]) {
            if written >= destination.len() {
                return written;
            }

            set destination[written] = transform(&source[i]);
            set written = written + 1;
        }
    }

    return written;
}

/// Transforme chaque élément avec son voisin précédent.
/// Le premier élément est traité séparément.
proc array_map_adjacent<T, U>(
    source: &[T],
    destination: &mut [U],
    first_transform: proc(&T) -> U,
    transform: proc(&T, &T) -> U
) -> usize {
    let mut limit: usize = source.len();

    if destination.len() < limit {
        set limit = destination.len();
    }

    if limit == 0 {
        return 0;
    }

    set destination[0] = first_transform(&source[0]);

    for i in 1..limit {
        set destination[i] = transform(
            &source[i - 1],
            &source[i]
        );
    }

    return limit;
}

/// Transforme un tableau en conservant son ordre,
/// mais en utilisant une fonction différente selon l'indice.
proc array_map_alternating<T, U>(
    source: &[T],
    destination: &mut [U],
    even_transform: proc(&T) -> U,
    odd_transform: proc(&T) -> U
) -> usize {
    let mut limit: usize = source.len();

    if destination.len() < limit {
        set limit = destination.len();
    }

    for i in 0..limit {
        if i % 2 == 0 {
            set destination[i] = even_transform(&source[i]);
        } else {
            set destination[i] = odd_transform(&source[i]);
        }
    }

    return limit;
}

/// Transforme les éléments en fonction de trois catégories.
proc array_map_classified<T, U>(
    source: &[T],
    destination: &mut [U],
    classifier: proc(&T) -> i32,
    negative_transform: proc(&T) -> U,
    zero_transform: proc(&T) -> U,
    positive_transform: proc(&T) -> U
) -> usize {
    let mut limit: usize = source.len();

    if destination.len() < limit {
        set limit = destination.len();
    }

    for i in 0..limit {
        let category: i32 = classifier(&source[i]);

        if category < 0 {
            set destination[i] = negative_transform(&source[i]);
        } elif category == 0 {
            set destination[i] = zero_transform(&source[i]);
        } else {
            set destination[i] = positive_transform(&source[i]);
        }
    }

    return limit;
}

/// Applique plusieurs fois une transformation à chaque élément.
proc array_map_repeat<T>(
    array: &mut [T],
    repetitions: usize,
    transform: proc(&T) -> T
) {
    for i in 0..array.len() {
        for j in 0..repetitions {
            let value: T = transform(&array[i]);
            set array[i] = value;
        }
    }
}

/// Transforme les éléments d'un tableau de droite à gauche,
/// en conservant leur position dans la destination.
proc array_map_backward<T, U>(
    source: &[T],
    destination: &mut [U],
    transform: proc(&T) -> U
) -> usize {
    let mut limit: usize = source.len();

    if destination.len() < limit {
        set limit = destination.len();
    }

    let mut i: usize = limit;

    while i > 0 {
        set i = i - 1;
        set destination[i] = transform(&source[i]);
    }

    return limit;
}