/// Inversion en place d'une tranche mutable.
space core::slice::reverse;

export proc slice_reverse<T>(value: &mut [T]) {
    let mut left: usize = 0;
    let mut right: usize = value.len();
    while left < right {
        set right = right - 1;
        if left >= right { break; }
        let temporary: T = value[left];
        set value[left] = value[right];
        set value[right] = temporary;
        set left = left + 1;
    }
}
