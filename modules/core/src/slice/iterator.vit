/// Interface de curseur emprunté pour les algorithmes de tranche.
space core::slice::iterator;

use core::iter::iterator::{SliceIterator, slice_iterator, iterator_next, iterator_next_back, iterator_remaining};

export proc slice_cursor<T>(value: &[T]) -> SliceIterator[T] {
    return slice_iterator(value);
}

export proc slice_cursor_next<T>(value: &mut SliceIterator[T]) -> ?T {
    return iterator_next(value);
}

export proc slice_cursor_next_back<T>(value: &mut SliceIterator[T]) -> ?T {
    return iterator_next_back(value);
}

export proc slice_cursor_remaining<T>(value: &SliceIterator[T]) -> usize {
    return iterator_remaining(value);
}
