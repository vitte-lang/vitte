/// Fenêtres de longueur fixe décrites par leur indice de départ.
space core::slice::windows;

export proc slice_window_count(length: usize, window_size: usize) -> usize {
    if window_size == 0 || window_size > length { return 0; }
    return length - window_size + 1;
}

export proc slice_window_start(length: usize, window_size: usize, index: usize) -> ?usize {
    if index >= slice_window_count(length, window_size) { return null; }
    return index;
}
