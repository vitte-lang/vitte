/// Cadre de retour fourni par l'appelant, sans collecte implicite.
space core::error::backtrace;

export form BacktraceFrame {
    function: u64,
    location: usize,
}

export form Backtrace {
    frames: &[BacktraceFrame],
}

export proc backtrace_depth(value: &Backtrace) -> usize { return value.frames.len(); }

export proc backtrace_frame(value: &Backtrace, index: usize) -> ?&BacktraceFrame {
    if index >= value.frames.len() { return null; }
    return &value.frames[index];
}
