/// Vérifications explicites qui retournent un état au lieu d'appeler un runtime.
space core::error::assert;

export form AssertionResult {
    success: bool,
    code: u32,
    location: usize,
}

export proc assertion_check(condition: bool, code: u32, location: usize) -> AssertionResult {
    return AssertionResult { success: condition, code: code, location: location };
}

export proc assertion_equal<T>(left: T, right: T, code: u32, location: usize) -> AssertionResult {
    return assertion_check(left == right, code, location);
}
