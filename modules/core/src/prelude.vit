/// Types et fonctions disponibles via le prélude minimal de `core`.
///
/// Le compilateur Vitte ne réexporte pas encore les noms importés. Ce module
/// contient donc uniquement des déclarations locales et stables.
space core::prelude;

/// Type nullable utilisé pour représenter une valeur éventuellement absente.
///
/// `null` représente l'absence et une valeur de type `T` représente sa présence.
export type Option<T> = ?T;

/// Retourne la valeur reçue sans la modifier.
export proc identity<T>(value: T) -> T {
    return value;
}
