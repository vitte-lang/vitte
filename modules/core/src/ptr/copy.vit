/// Copie d'octets avec sémantique de zones potentiellement recouvrantes.
/// Les deux zones doivent être accessibles sur `length` octets.
space core::ptr::copy;

export proc ptr_copy(destination: *mut u8, source: *const u8, length: usize) -> bool {
    if length == 0 { return true; }
    if destination == null || source == null { return false; }
    let destination_address: usize = destination as usize;
    let source_address: usize = source as usize;
    if destination_address > source_address &&
       destination_address - source_address < length {
        let mut index: usize = length;
        while index > 0 {
            set index = index - 1;
            set destination[index] = source[index];
        }
    } else {
        for index in 0..length { set destination[index] = source[index]; }
    }
    return true;
}
