/// Accès volatils abaissés par le compilateur, sans perte de qualification.
space core::ptr::volatile;

use core::intrinsics::memory::{volatile_load, volatile_store};

export unsafe proc ptr_read_volatile<T>(source: *const T) -> T {
    return volatile_load(source);
}

export unsafe proc ptr_write_volatile<T>(destination: *mut T, value: T) {
    volatile_store(destination, value);
}
