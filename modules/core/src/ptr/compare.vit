/// Comparaison d'adresse sans déréférencement.
space core::ptr::compare;

export proc ptr_equal<T>(left: *const T, right: *const T) -> bool { return left == right; }
export proc ptr_not_equal<T>(left: *const T, right: *const T) -> bool { return left != right; }

export proc ptr_address<T>(value: *const T) -> usize { return value as usize; }

/// Compare les adresses numériques; ne définit pas un ordre entre allocations.
export proc ptr_before<T>(left: *const T, right: *const T) -> bool {
    return (left as usize) < (right as usize);
}
