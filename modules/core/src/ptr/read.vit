/// Lecture alignée après vérification du pointeur nul.
/// Le pointeur doit encore viser un objet vivant et lisible de type `T`.
space core::ptr::read;

use core::ptr::arithmetic::{ptr_is_aligned};

export proc ptr_read<T>(source: *const T) -> ?T {
    if source == null || not ptr_is_aligned(source) { return null; }
    return *source;
}

/// Lecture brute sans vérification; l'appelant garantit validité et alignement.
export proc ptr_read_unchecked<T>(source: *const T) -> T {
    return *source;
}
