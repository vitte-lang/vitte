/// Associe chaque élément de la tranche à son indice.
space core::iter::enumerate;

export proc enumerate_copy<T>(source: &[T], destination: &mut [(usize, T)]) -> usize {
    let mut count: usize = source.len();
    if destination.len() < count { set count = destination.len(); }
    for index in 0..count {
        set destination[index] = (index, source[index]);
    }
    return count;
}
