/// Calcule l'indice de départ après avoir ignoré jusqu'à `count` éléments.
space core::iter::skip;

export proc skip_start(length: usize, count: usize) -> usize {
    if count >= length { return length; }
    return count;
}

export proc skip_remaining(length: usize, count: usize) -> usize {
    if count >= length { return 0; }
    return length - count;
}
