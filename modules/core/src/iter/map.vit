/// Transformation d'une tranche vers un tampon fourni par l'appelant.
space core::iter::map;

export proc map<T, U>(
    source: &[T],
    destination: &mut [U],
    transform: proc(&T) -> U
) -> usize {
    let mut count: usize = source.len();
    if destination.len() < count { set count = destination.len(); }
    for index in 0..count {
        set destination[index] = transform(&source[index]);
    }
    return count;
}
