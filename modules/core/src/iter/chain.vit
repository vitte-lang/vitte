/// Parcours successif de deux tranches dans un tampon emprunté.
space core::iter::chain;

export proc chain_copy<T>(left: &[T], right: &[T], destination: &mut [T]) -> usize {
    let mut written: usize = 0;
    let mut index: usize = 0;
    while index < left.len() && written < destination.len() {
        set destination[written] = left[index];
        set written = written + 1;
        set index = index + 1;
    }
    set index = 0;
    while index < right.len() && written < destination.len() {
        set destination[written] = right[index];
        set written = written + 1;
        set index = index + 1;
    }
    return written;
}
