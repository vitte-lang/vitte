/// Réduction gauche non vide; l'absence est représentée par `null`.
space core::iter::reduce;

export proc reduce<T>(source: &[T], combine: proc(T, T) -> T) -> ?T {
    if source.len() == 0 { return null; }
    let mut accumulator: T = source[0];
    for index in 1..source.len() {
        set accumulator = combine(accumulator, source[index]);
    }
    return accumulator;
}
