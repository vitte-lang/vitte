/// Combine deux tranches en paires dans un tampon fourni par l'appelant.
space core::iter::zip;

export proc zip_copy<T, U>(
    left: &[T],
    right: &[U],
    destination: &mut [(T, U)]
) -> usize {
    let mut count: usize = left.len();
    if right.len() < count { set count = right.len(); }
    if destination.len() < count { set count = destination.len(); }
    for index in 0..count {
        set destination[index] = (left[index], right[index]);
    }
    return count;
}
