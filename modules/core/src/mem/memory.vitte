/// Opérations explicites sur des zones mémoire déjà possédées par l'appelant.
space core::mem::memory;

export proc mem_fill(destination: *mut u8, value: u8, length: usize) -> bool {
    if length == 0 { return true; }
    if destination == null { return false; }
    for index in 0..length { set destination[index] = value; }
    return true;
}

export proc mem_copy(destination: *mut u8, source: *const u8, length: usize) -> bool {
    if length == 0 { return true; }
    if destination == null || source == null { return false; }
    let destination_address: usize = destination as usize;
    let source_address: usize = source as usize;
    if destination_address > source_address &&
       destination_address - source_address < length {
        let mut index: usize = length;
        while index > 0 {
            set index = index - 1;
            set destination[index] = source[index];
        }
    } else {
        for index in 0..length { set destination[index] = source[index]; }
    }
    return true;
}

export proc mem_compare(left: *const u8, right: *const u8, length: usize) -> ?i8 {
    if length == 0 { return 0; }
    if left == null || right == null { return null; }
    for index in 0..length {
        if left[index] < right[index] { return -1; }
        if left[index] > right[index] { return 1; }
    }
    return 0;
}

export proc mem_equal(left: *const u8, right: *const u8, length: usize) -> bool {
    if length == 0 { return true; }
    if left == null || right == null { return false; }
    for index in 0..length {
        if left[index] != right[index] { return false; }
    }
    return true;
}

export proc mem_zero(destination: *mut u8, length: usize) -> bool {
    return mem_fill(destination, 0, length);
}
