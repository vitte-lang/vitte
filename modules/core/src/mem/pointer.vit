/// Représentation d'adresse entière et décalages vérifiés.
space core::mem::pointer;

export type Address = usize;

export proc mem_address<T>(pointer: *const T) -> Address { return pointer as Address; }

export proc mem_address_add(address: Address, offset: usize) -> ?Address {
    if offset > Address.MAX - address { return null; }
    return address + offset;
}

export proc mem_pointer_from_address<T>(address: Address) -> *mut T {
    return address as *mut T;
}
