/// Mise à zéro d'une zone brute déjà allouée par l'appelant.
space core::mem::zeroed;

export proc mem_zeroed_bytes(destination: *mut u8, length: usize) -> bool {
    if length == 0 { return true; }
    if destination == null { return false; }
    for index in 0..length { set destination[index] = 0; }
    return true;
}
