/// Taille et alignement déterminés à la compilation.
space core::mem::size;

export proc mem_size_of<T>() -> usize { return sizeof(T); }
export proc mem_align_of<T>() -> usize { return alignof(T); }

export proc mem_array_size<T>(count: usize) -> ?usize {
    let element_size: usize = sizeof(T);
    if element_size != 0 && count > usize.MAX / element_size { return null; }
    return element_size * count;
}
