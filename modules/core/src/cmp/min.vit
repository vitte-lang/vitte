// ============================================================================
// Vitte Standard Library
// Module: core::cmp::min
// File: modules/core/src/cmp/min.vit
//
// Minimum comparison primitives.
//
// Dependencies: none
// Dynamic allocation: none
//
// Notes:
//   - Integer comparisons use ordinary numeric ordering.
//   - A NaN operand is propagated (the left operand wins when both are NaN).
//   - Equal values, including signed zero, preserve the left operand.
// ============================================================================

space core::cmp::min;

// ============================================================================
// 1. SIGNED INTEGER MINIMUM
// ============================================================================

export proc min_i8(a: i8, b: i8) -> i8 {
    if a <= b {
        return a;
    }

    return b;
}

export proc min_i16(a: i16, b: i16) -> i16 {
    if a <= b {
        return a;
    }

    return b;
}

export proc min_i32(a: i32, b: i32) -> i32 {
    if a <= b {
        return a;
    }

    return b;
}

export proc min_i64(a: i64, b: i64) -> i64 {
    if a <= b {
        return a;
    }

    return b;
}

// ============================================================================
// 2. UNSIGNED INTEGER MINIMUM
// ============================================================================

export proc min_u8(a: u8, b: u8) -> u8 {
    if a <= b {
        return a;
    }

    return b;
}

export proc min_u16(a: u16, b: u16) -> u16 {
    if a <= b {
        return a;
    }

    return b;
}

export proc min_u32(a: u32, b: u32) -> u32 {
    if a <= b {
        return a;
    }

    return b;
}

export proc min_u64(a: u64, b: u64) -> u64 {
    if a <= b {
        return a;
    }

    return b;
}

// ============================================================================
// 3. FLOATING-POINT MINIMUM
// ============================================================================

export proc min_f32(a: f32, b: f32) -> f32 {
    if a != a { return a; }
    if b != b { return b; }
    if a <= b {
        return a;
    }

    return b;
}

export proc min_f64(a: f64, b: f64) -> f64 {
    if a != a { return a; }
    if b != b { return b; }
    if a <= b {
        return a;
    }

    return b;
}

// ============================================================================
// 4. THREE-VALUE MINIMUM
// ============================================================================

export proc min3_i32(a: i32, b: i32, c: i32) -> i32 {
    return min_i32(min_i32(a, b), c);
}

export proc min3_i64(a: i64, b: i64, c: i64) -> i64 {
    return min_i64(min_i64(a, b), c);
}

export proc min3_u32(a: u32, b: u32, c: u32) -> u32 {
    return min_u32(min_u32(a, b), c);
}

export proc min3_u64(a: u64, b: u64, c: u64) -> u64 {
    return min_u64(min_u64(a, b), c);
}

export proc min3_f32(a: f32, b: f32, c: f32) -> f32 {
    return min_f32(min_f32(a, b), c);
}

export proc min3_f64(a: f64, b: f64, c: f64) -> f64 {
    return min_f64(min_f64(a, b), c);
}

// ============================================================================
// 5. FOUR-VALUE MINIMUM
// ============================================================================

export proc min4_i32(a: i32, b: i32, c: i32, d: i32) -> i32 {
    return min_i32(min_i32(a, b), min_i32(c, d));
}

export proc min4_i64(a: i64, b: i64, c: i64, d: i64) -> i64 {
    return min_i64(min_i64(a, b), min_i64(c, d));
}

export proc min4_u32(a: u32, b: u32, c: u32, d: u32) -> u32 {
    return min_u32(min_u32(a, b), min_u32(c, d));
}

export proc min4_u64(a: u64, b: u64, c: u64, d: u64) -> u64 {
    return min_u64(min_u64(a, b), min_u64(c, d));
}

export proc min4_f32(a: f32, b: f32, c: f32, d: f32) -> f32 {
    return min_f32(min_f32(a, b), min_f32(c, d));
}

export proc min4_f64(a: f64, b: f64, c: f64, d: f64) -> f64 {
    return min_f64(min_f64(a, b), min_f64(c, d));
}

// ============================================================================
// 6. MINIMUM WITH ZERO
//
// Returns zero when the supplied value is positive.
// ============================================================================

export proc min_zero_i32(value: i32) -> i32 {
    return min_i32(value, 0);
}

export proc min_zero_i64(value: i64) -> i64 {
    return min_i64(value, 0);
}

export proc min_zero_f32(value: f32) -> f32 {
    return min_f32(value, 0.0);
}

export proc min_zero_f64(value: f64) -> f64 {
    return min_f64(value, 0.0);
}

// ============================================================================
// 7. MINIMUM PREDICATES
//
// Returns true when a <= b.
// ============================================================================

export proc is_min_i32(a: i32, b: i32) -> bool {
    return a <= b;
}

export proc is_min_i64(a: i64, b: i64) -> bool {
    return a <= b;
}

export proc is_min_u32(a: u32, b: u32) -> bool {
    return a <= b;
}

export proc is_min_u64(a: u64, b: u64) -> bool {
    return a <= b;
}

export proc is_min_f32(a: f32, b: f32) -> bool {
    return a <= b;
}

export proc is_min_f64(a: f64, b: f64) -> bool {
    return a <= b;
}

// ============================================================================
// 8. FIVE-VALUE MINIMUM
// ============================================================================

export proc min5_i32(
    a: i32,
    b: i32,
    c: i32,
    d: i32,
    e: i32
) -> i32 {
    return min_i32(min4_i32(a, b, c, d), e);
}

export proc min5_i64(
    a: i64,
    b: i64,
    c: i64,
    d: i64,
    e: i64
) -> i64 {
    return min_i64(min4_i64(a, b, c, d), e);
}

export proc min5_f32(
    a: f32,
    b: f32,
    c: f32,
    d: f32,
    e: f32
) -> f32 {
    return min_f32(min4_f32(a, b, c, d), e);
}

export proc min5_f64(
    a: f64,
    b: f64,
    c: f64,
    d: f64,
    e: f64
) -> f64 {
    return min_f64(min4_f64(a, b, c, d), e);
}

// ============================================================================
// 9. SIX-VALUE MINIMUM
// ============================================================================

export proc min6_i32(
    a: i32,
    b: i32,
    c: i32,
    d: i32,
    e: i32,
    f: i32
) -> i32 {
    return min_i32(min5_i32(a, b, c, d, e), f);
}

export proc min6_i64(
    a: i64,
    b: i64,
    c: i64,
    d: i64,
    e: i64,
    f: i64
) -> i64 {
    return min_i64(min5_i64(a, b, c, d, e), f);
}

export proc min6_f32(
    a: f32,
    b: f32,
    c: f32,
    d: f32,
    e: f32,
    f: f32
) -> f32 {
    return min_f32(min5_f32(a, b, c, d, e), f);
}

export proc min6_f64(
    a: f64,
    b: f64,
    c: f64,
    d: f64,
    e: f64,
    f: f64
) -> f64 {
    return min_f64(min5_f64(a, b, c, d, e), f);
}

// ============================================================================
// 10. NEGATIVE MINIMUM
//
// Returns the minimum if negative, otherwise zero.
// ============================================================================

export proc negative_min_i32(a: i32, b: i32) -> i32 {
    return min_zero_i32(min_i32(a, b));
}

export proc negative_min_i64(a: i64, b: i64) -> i64 {
    return min_zero_i64(min_i64(a, b));
}

export proc negative_min_f32(a: f32, b: f32) -> f32 {
    return min_zero_f32(min_f32(a, b));
}

export proc negative_min_f64(a: f64, b: f64) -> f64 {
    return min_zero_f64(min_f64(a, b));
}

// ============================================================================
// END OF MODULE
// ============================================================================
