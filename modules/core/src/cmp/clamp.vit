// ============================================================================
// Vitte Standard Library
// Module: core::cmp::clamp
// File: modules/core/src/cmp/clamp.vit
//
// Comparison and clamping primitives.
//
// Dependencies: none
// Allocation: none
//
// Notes:
//   - clamp_* requires minimum <= maximum.
//   - clamp_ordered_* accepts bounds in either order.
//   - Floating-point clamp propagates the first NaN among value, minimum,
//     maximum. `clamp_checked_*` rejects reversed bounds and NaN bounds.
// ============================================================================

space core::cmp::clamp;

// ============================================================================
// 1. SIGNED INTEGER CLAMP
// ============================================================================

export proc clamp_i8(value: i8, minimum: i8, maximum: i8) -> i8 {
    if value < minimum {
        return minimum;
    }

    if value > maximum {
        return maximum;
    }

    return value;
}

export proc clamp_i16(value: i16, minimum: i16, maximum: i16) -> i16 {
    if value < minimum {
        return minimum;
    }

    if value > maximum {
        return maximum;
    }

    return value;
}

export proc clamp_i32(value: i32, minimum: i32, maximum: i32) -> i32 {
    if value < minimum {
        return minimum;
    }

    if value > maximum {
        return maximum;
    }

    return value;
}

export proc clamp_i64(value: i64, minimum: i64, maximum: i64) -> i64 {
    if value < minimum {
        return minimum;
    }

    if value > maximum {
        return maximum;
    }

    return value;
}

// ============================================================================
// 2. UNSIGNED INTEGER CLAMP
// ============================================================================

export proc clamp_u8(value: u8, minimum: u8, maximum: u8) -> u8 {
    if value < minimum {
        return minimum;
    }

    if value > maximum {
        return maximum;
    }

    return value;
}

export proc clamp_u16(value: u16, minimum: u16, maximum: u16) -> u16 {
    if value < minimum {
        return minimum;
    }

    if value > maximum {
        return maximum;
    }

    return value;
}

export proc clamp_u32(value: u32, minimum: u32, maximum: u32) -> u32 {
    if value < minimum {
        return minimum;
    }

    if value > maximum {
        return maximum;
    }

    return value;
}

export proc clamp_u64(value: u64, minimum: u64, maximum: u64) -> u64 {
    if value < minimum {
        return minimum;
    }

    if value > maximum {
        return maximum;
    }

    return value;
}

// ============================================================================
// 3. FLOATING-POINT CLAMP
// ============================================================================

export proc clamp_f32(value: f32, minimum: f32, maximum: f32) -> f32 {
    if value != value { return value; }
    if minimum != minimum { return minimum; }
    if maximum != maximum { return maximum; }
    if value < minimum {
        return minimum;
    }

    if value > maximum {
        return maximum;
    }

    return value;
}

export proc clamp_f64(value: f64, minimum: f64, maximum: f64) -> f64 {
    if value != value { return value; }
    if minimum != minimum { return minimum; }
    if maximum != maximum { return maximum; }
    if value < minimum {
        return minimum;
    }

    if value > maximum {
        return maximum;
    }

    return value;
}

