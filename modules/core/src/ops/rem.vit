/// Reste signé selon la sémantique entière du langage.
/// Les variantes brutes exigent un diviseur non nul.
space core::ops::rem;

use core::num::limits::{I8_MIN, I16_MIN, I32_MIN, I64_MIN};

export proc rem_i8(left: i8, right: i8) -> i8 {
    if left == I8_MIN && right == -1 { return 0; }
    return left % right;
}

export proc rem_i16(left: i16, right: i16) -> i16 {
    if left == I16_MIN && right == -1 { return 0; }
    return left % right;
}

export proc rem_i32(left: i32, right: i32) -> i32 {
    if left == I32_MIN && right == -1 { return 0; }
    return left % right;
}

export proc rem_i64(left: i64, right: i64) -> i64 {
    if left == I64_MIN && right == -1 { return 0; }
    return left % right;
}
export proc rem_u8(left: u8, right: u8) -> u8 { return left % right; }
export proc rem_u16(left: u16, right: u16) -> u16 { return left % right; }
export proc rem_u32(left: u32, right: u32) -> u32 { return left % right; }
export proc rem_u64(left: u64, right: u64) -> u64 { return left % right; }

export proc checked_rem_i8(left: i8, right: i8) -> ?i8 {
    if right == 0 { return null; }
    if left == I8_MIN && right == -1 { return 0; }
    return left % right;
}

export proc checked_rem_i16(left: i16, right: i16) -> ?i16 {
    if right == 0 { return null; }
    if left == I16_MIN && right == -1 { return 0; }
    return left % right;
}

export proc checked_rem_i32(left: i32, right: i32) -> ?i32 {
    if right == 0 { return null; }
    if left == I32_MIN && right == -1 { return 0; }
    return left % right;
}

export proc checked_rem_i64(left: i64, right: i64) -> ?i64 {
    if right == 0 { return null; }
    if left == I64_MIN && right == -1 { return 0; }
    return left % right;
}

export proc checked_rem_u8(left: u8, right: u8) -> ?u8 {
    if right == 0 { return null; }
    return left % right;
}

export proc checked_rem_u16(left: u16, right: u16) -> ?u16 {
    if right == 0 { return null; }
    return left % right;
}

export proc checked_rem_u32(left: u32, right: u32) -> ?u32 {
    if right == 0 { return null; }
    return left % right;
}

export proc checked_rem_u64(left: u64, right: u64) -> ?u64 {
    if right == 0 { return null; }
    return left % right;
}
