/// Division primitive des nombres.
///
/// Les divisions entières `div_*` exigent un diviseur non nul et, pour les
/// types signés, un couple différent de MIN / -1. Les variantes
/// `checked_div_*` signalent ces entrées par `null`.
space core::ops::div;

use core::num::limits::{I8_MIN, I16_MIN, I32_MIN, I64_MIN};

export proc div_i8(left: i8, right: i8) -> i8 { return left / right; }
export proc div_i16(left: i16, right: i16) -> i16 { return left / right; }
export proc div_i32(left: i32, right: i32) -> i32 { return left / right; }
export proc div_i64(left: i64, right: i64) -> i64 { return left / right; }
export proc div_u8(left: u8, right: u8) -> u8 { return left / right; }
export proc div_u16(left: u16, right: u16) -> u16 { return left / right; }
export proc div_u32(left: u32, right: u32) -> u32 { return left / right; }
export proc div_u64(left: u64, right: u64) -> u64 { return left / right; }
export proc div_f32(left: f32, right: f32) -> f32 { return left / right; }
export proc div_f64(left: f64, right: f64) -> f64 { return left / right; }

export proc checked_div_i8(left: i8, right: i8) -> ?i8 {
    if right == 0 || (left == I8_MIN && right == -1) { return null; }
    return left / right;
}

export proc checked_div_i16(left: i16, right: i16) -> ?i16 {
    if right == 0 || (left == I16_MIN && right == -1) { return null; }
    return left / right;
}

export proc checked_div_i32(left: i32, right: i32) -> ?i32 {
    if right == 0 || (left == I32_MIN && right == -1) { return null; }
    return left / right;
}

export proc checked_div_i64(left: i64, right: i64) -> ?i64 {
    if right == 0 || (left == I64_MIN && right == -1) { return null; }
    return left / right;
}

export proc checked_div_u8(left: u8, right: u8) -> ?u8 {
    if right == 0 { return null; }
    return left / right;
}

export proc checked_div_u16(left: u16, right: u16) -> ?u16 {
    if right == 0 { return null; }
    return left / right;
}

export proc checked_div_u32(left: u32, right: u32) -> ?u32 {
    if right == 0 { return null; }
    return left / right;
}

export proc checked_div_u64(left: u64, right: u64) -> ?u64 {
    if right == 0 { return null; }
    return left / right;
}
