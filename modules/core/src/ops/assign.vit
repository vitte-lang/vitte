/// Affectations natives pour les opérateurs arithmétiques et binaires.
/// Opérations d'affectation sur valeurs mutables empruntées.
///
/// Les affectations de décalage exigent une quantité inférieure à la largeur
/// du type ciblé.
space core::ops::assign;

export proc add_assign_i8(left: &mut i8, right: i8) {
    set *left = *left + right;
}

export proc sub_assign_i8(left: &mut i8, right: i8) {
    set *left = *left - right;
}

export proc mul_assign_i8(left: &mut i8, right: i8) {
    set *left = *left * right;
}

export proc div_assign_i8(left: &mut i8, right: i8) {
    set *left = *left / right;
}

export proc rem_assign_i8(left: &mut i8, right: i8) {
    set *left = *left % right;
}

