/// Accès contrôlé aux éléments empruntés.
space core::ops::index;

export proc index<T>(slice: &[T], position: usize) -> ?&T {
    if position >= slice.len() {
        return null;
    }
    return &slice[position];
}

export proc index_mut<T>(slice: &mut [T], position: usize) -> ?&mut T {
    if position >= slice.len() {
        return null;
    }
    return &mut slice[position];
}

