/// Modulo euclidien : résultat non négatif et inférieur au module du diviseur.
space core::ops::mod;

use core::num::limits::{I8_MIN, I16_MIN, I32_MIN, I64_MIN};

export proc mod_i8(left: i8, right: i8) -> ?i8 {
    if right == 0 {
        return null;
    }
    if left == I8_MIN && right == -1 { return 0; }

    let mut result: i8 = left % right;
    if result < 0 {
        if right > 0 {
            set result = result + right;
        } else {
            set result = result - right;
        }
    }

    return result;
}

export proc mod_i16(left: i16, right: i16) -> ?i16 {
    if right == 0 {
        return null;
    }
    if left == I16_MIN && right == -1 { return 0; }

    let mut result: i16 = left % right;
    if result < 0 {
        if right > 0 {
            set result = result + right;
        } else {
            set result = result - right;
        }
    }

    return result;
}

