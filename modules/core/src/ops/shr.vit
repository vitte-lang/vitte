/// Décalages binaires vers la droite.
///
/// Les formes `shr_*` exigent `amount < largeur`; utiliser `checked_shr_*`
/// lorsque cette condition n'est pas déjà garantie. Les types signés suivent
/// la sémantique de décalage arithmétique définie par le compilateur.
space core::ops::shr;

export proc shr_i8(left: i8, amount: usize) -> i8 { return left >> amount; }
export proc shr_i16(left: i16, amount: usize) -> i16 { return left >> amount; }
export proc shr_i32(left: i32, amount: usize) -> i32 { return left >> amount; }
export proc shr_i64(left: i64, amount: usize) -> i64 { return left >> amount; }
export proc shr_u8(left: u8, amount: usize) -> u8 { return left >> amount; }
export proc shr_u16(left: u16, amount: usize) -> u16 { return left >> amount; }
export proc shr_u32(left: u32, amount: usize) -> u32 { return left >> amount; }
export proc shr_u64(left: u64, amount: usize) -> u64 { return left >> amount; }

export proc checked_shr_i8(left: i8, amount: usize) -> ?i8 {
    if amount >= 8 { return null; }
    return left >> amount;
}

export proc checked_shr_i16(left: i16, amount: usize) -> ?i16 {
    if amount >= 16 { return null; }
    return left >> amount;
}

export proc checked_shr_i32(left: i32, amount: usize) -> ?i32 {
    if amount >= 32 { return null; }
    return left >> amount;
}

export proc checked_shr_i64(left: i64, amount: usize) -> ?i64 {
    if amount >= 64 { return null; }
    return left >> amount;
}

export proc checked_shr_u8(left: u8, amount: usize) -> ?u8 {
    if amount >= 8 { return null; }
    return left >> amount;
}

export proc checked_shr_u16(left: u16, amount: usize) -> ?u16 {
    if amount >= 16 { return null; }
    return left >> amount;
}

export proc checked_shr_u32(left: u32, amount: usize) -> ?u32 {
    if amount >= 32 { return null; }
    return left >> amount;
}

export proc checked_shr_u64(left: u64, amount: usize) -> ?u64 {
    if amount >= 64 { return null; }
    return left >> amount;
}
