use core::convert::format::{FormatError, FormatResult, format_i64, format_u64, format_u64_base, format_u64_base_length, format_u64_decimal_length, format_i64_decimal_length, format_digit_lower, format_digit_upper, format_buffer_valid};
use core::fmt::integer::{fmt_i64};
use core::fmt::float::{fmt_f64_fixed};

test "integer formatting lengths cover zero and extrema" {
    assert format_u64_decimal_length(0) == 1;
    assert format_u64_decimal_length(18446744073709551615) == 20;
    assert format_i64_decimal_length(-9223372036854775807 - 1) == 20;
    assert format_i64_decimal_length(9223372036854775807) == 19;
    assert format_u64_base_length(0, 2) == 1;
    assert format_u64_base_length(255, 16) == 2;
    assert format_u64_base_length(1, 1) == 0;
    assert format_u64_base_length(1, 37) == 0;
}

test "radix digits and null buffer validation" {
    assert format_digit_lower(0) == 48;
    assert format_digit_lower(10) == 97;
    assert format_digit_lower(35) == 122;
    assert format_digit_upper(10) == 65;
    assert format_digit_upper(35) == 90;
    assert format_digit_lower(36) == 63;

    assert format_buffer_valid(null, 0);
    assert not format_buffer_valid(null, 1);
}

test "format signed minimum and reject undersized output" {
    let mut buffer: [u8; 24] = [
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    ];
    let output: *u8 = (&mut buffer) as *u8;
    let minimum: FormatResult = format_i64(-9223372036854775807 - 1, output, 24);
    assert minimum.success;
    assert minimum.length == 20;
    assert buffer[0] == 45;
    assert buffer[1] == 57;
    assert buffer[19] == 56;

    let too_small: FormatResult = format_u64(18446744073709551615, output, 19);
    assert not too_small.success;
    assert too_small.error == FormatError.BufferTooSmall;

    let maximum: FormatResult = format_u64(18446744073709551615, output, 20);
    assert maximum.success;
    assert maximum.length == 20;
    assert buffer[0] == 49;
    assert buffer[19] == 53;

    let invalid_base: FormatResult = format_u64_base(1, 1, false, output, 24);
    assert not invalid_base.success;
    assert invalid_base.error == FormatError.InvalidBase;

    let hexadecimal: FormatResult = format_u64_base(255, 16, false, output, 24);
    assert hexadecimal.success;
    assert hexadecimal.length == 2;
    assert buffer[0] == 102;
    assert buffer[1] == 102;

    let wrapper: FormatResult = fmt_i64(0, output, 24);
    assert wrapper.success;
    assert wrapper.length == 1;
    assert buffer[0] == 48;

    let null_output: FormatResult = format_u64(1, null, 0);
    assert not null_output.success;
    assert null_output.error == FormatError.NullBuffer;
}

test "fixed float formatting rounds and rejects excess precision" {
    let mut buffer: [u8; 16] = [
        0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8,
    ];
    let output: *u8 = (&mut buffer) as *u8;
    let rounded: FormatResult = fmt_f64_fixed(1.25, 1, output, 16);
    assert rounded.success;
    assert rounded.length == 3;
    assert buffer[0] == 49;
    assert buffer[1] == 46;
    assert buffer[2] == 51;

    let invalid: FormatResult = fmt_f64_fixed(1.0, 7, output, 16);
    assert not invalid.success;
    assert invalid.error == FormatError.InvalidArgument;
}

