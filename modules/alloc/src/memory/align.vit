/// Alignement vérifié d'une adresse, délégué aux helpers de `core::mem`.
space alloc::memory::align;

use core::mem::align::{mem_alignment_is_valid, mem_align_up, mem_align_down};

export proc align_address_up(address: usize, alignment: usize) -> ?usize {
    return mem_align_up(address, alignment);
}

export proc align_address_down(address: usize, alignment: usize) -> ?usize {
    return mem_align_down(address, alignment);
}

export proc address_alignment_is_valid(alignment: usize) -> bool {
    return mem_alignment_is_valid(alignment);
}
