/// Allocation avec un layout explicite, via les intrinsics mémoire de `core`.
space alloc::memory::allocate;

use core::mem::layout::{Layout};
use alloc::allocator::result::{AllocationResult};
use alloc::allocator::system::{system_allocate};

export proc allocate_layout(value: Layout) -> AllocationResult {
    return system_allocate(value);
}
