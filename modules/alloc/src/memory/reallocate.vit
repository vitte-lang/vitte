/// Réallocation avec copie préservant le préfixe commun.
space alloc::memory::reallocate;

use core::mem::layout::{Layout};
use alloc::allocator::result::{AllocationResult};
use alloc::allocator::system::{system_reallocate};

export proc reallocate_layout(pointer: *mut u8, old_layout: Layout, new_layout: Layout) -> AllocationResult {
    return system_reallocate(pointer, old_layout, new_layout);
}
