/// Façade `alloc` du contrat de layout défini par `core::mem::layout`.
space alloc::layout::layout;

use core::mem::layout::{Layout as CoreLayout, layout as core_layout};

export type AllocLayout = CoreLayout;

export proc alloc_layout(size: usize, alignment: usize) -> AllocLayout {
    return core_layout(size, alignment);
}

export proc alloc_layout_of<T>() -> AllocLayout {
    return core_layout(sizeof(T), alignof(T));
}
