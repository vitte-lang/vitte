/// Calculs d'alignement de la façade `alloc`.
space alloc::layout::align;

use core::mem::align::{mem_alignment_is_valid, mem_align_down, mem_align_up};

export proc alignment_is_valid(alignment: usize) -> bool {
    return mem_alignment_is_valid(alignment);
}

export proc align_down(value: usize, alignment: usize) -> ?usize {
    return mem_align_down(value, alignment);
}

export proc align_up(value: usize, alignment: usize) -> ?usize {
    return mem_align_up(value, alignment);
}
