/// Extension de layout avec l'offset vérifié du second champ.
space alloc::layout::extend;

use core::mem::layout::{Layout, LayoutExtension as CoreLayoutExtension, layout_extend_with_offset};

export type LayoutExtension = CoreLayoutExtension;

export proc extend_layout(left: Layout, right: Layout) -> LayoutExtension {
    return layout_extend_with_offset(left, right);
}
