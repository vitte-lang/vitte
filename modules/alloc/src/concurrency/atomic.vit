/// Adaptateurs atomiques employés par les structures de `alloc`.
space alloc::concurrency::atomic;

use core::sync::ordering::{AtomicOrdering};
use core::sync::atomic::{
    AtomicBool as CoreAtomicBool,
    AtomicU64 as CoreAtomicU64,
    AtomicUsize as CoreAtomicUsize,
    atomic_bool as core_atomic_bool,
    atomic_u64 as core_atomic_u64,
    atomic_usize as core_atomic_usize,
    atomic_bool_load,
    atomic_bool_store,
    atomic_bool_exchange,
    atomic_bool_compare_exchange,
    atomic_u64_load,
    atomic_u64_store,
    atomic_u64_exchange,
    atomic_u64_compare_exchange,
    atomic_u64_fetch_add,
    atomic_u64_fetch_sub,
    atomic_usize_load,
    atomic_usize_store,
    atomic_usize_exchange,
    atomic_usize_compare_exchange,
    atomic_usize_fetch_add,
    atomic_usize_fetch_sub,
};

export type AllocAtomicBool = CoreAtomicBool;
export type AllocAtomicU64 = CoreAtomicU64;
export type AllocAtomicUsize = CoreAtomicUsize;

export proc alloc_atomic_bool(value: bool) -> AllocAtomicBool { return core_atomic_bool(value); }
export proc alloc_atomic_u64(value: u64) -> AllocAtomicU64 { return core_atomic_u64(value); }
export proc alloc_atomic_usize(value: usize) -> AllocAtomicUsize { return core_atomic_usize(value); }

export proc alloc_atomic_bool_load(value: &AllocAtomicBool, order: AtomicOrdering) -> bool {
    return atomic_bool_load(value, order);
}

export proc alloc_atomic_bool_store(value: &mut AllocAtomicBool, replacement: bool, order: AtomicOrdering) {
    atomic_bool_store(value, replacement, order);
}

export proc alloc_atomic_bool_exchange(value: &mut AllocAtomicBool, replacement: bool, order: AtomicOrdering) -> bool {
    return atomic_bool_exchange(value, replacement, order);
}

export proc alloc_atomic_bool_compare_exchange(value: &mut AllocAtomicBool, expected: bool, replacement: bool, success: AtomicOrdering, failure: AtomicOrdering) -> bool {
    return atomic_bool_compare_exchange(value, expected, replacement, success, failure);
}

export proc alloc_atomic_u64_load(value: &AllocAtomicU64, order: AtomicOrdering) -> u64 {
    return atomic_u64_load(value, order);
}

export proc alloc_atomic_u64_store(value: &mut AllocAtomicU64, replacement: u64, order: AtomicOrdering) {
    atomic_u64_store(value, replacement, order);
}

export proc alloc_atomic_u64_exchange(value: &mut AllocAtomicU64, replacement: u64, order: AtomicOrdering) -> u64 {
    return atomic_u64_exchange(value, replacement, order);
}

export proc alloc_atomic_u64_compare_exchange(value: &mut AllocAtomicU64, expected: u64, replacement: u64, success: AtomicOrdering, failure: AtomicOrdering) -> bool {
    return atomic_u64_compare_exchange(value, expected, replacement, success, failure);
}

export proc alloc_atomic_u64_fetch_add(value: &mut AllocAtomicU64, amount: u64, order: AtomicOrdering) -> u64 {
    return atomic_u64_fetch_add(value, amount, order);
}

export proc alloc_atomic_u64_fetch_sub(value: &mut AllocAtomicU64, amount: u64, order: AtomicOrdering) -> u64 {
    return atomic_u64_fetch_sub(value, amount, order);
}

export proc alloc_atomic_usize_load(value: &AllocAtomicUsize, order: AtomicOrdering) -> usize {
    return atomic_usize_load(value, order);
}

export proc alloc_atomic_usize_store(value: &mut AllocAtomicUsize, replacement: usize, order: AtomicOrdering) {
    atomic_usize_store(value, replacement, order);
}

export proc alloc_atomic_usize_exchange(value: &mut AllocAtomicUsize, replacement: usize, order: AtomicOrdering) -> usize {
    return atomic_usize_exchange(value, replacement, order);
}

export proc alloc_atomic_usize_compare_exchange(value: &mut AllocAtomicUsize, expected: usize, replacement: usize, success: AtomicOrdering, failure: AtomicOrdering) -> bool {
    return atomic_usize_compare_exchange(value, expected, replacement, success, failure);
}

export proc alloc_atomic_usize_fetch_add(value: &mut AllocAtomicUsize, amount: usize, order: AtomicOrdering) -> usize {
    return atomic_usize_fetch_add(value, amount, order);
}

export proc alloc_atomic_usize_fetch_sub(value: &mut AllocAtomicUsize, amount: usize, order: AtomicOrdering) -> usize {
    return atomic_usize_fetch_sub(value, amount, order);
}
