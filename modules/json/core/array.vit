/// JSON array core.
///
/// Complete JSON array representation and manipulation layer.
///
/// Goals:
/// - represent ordered JSON values;
/// - preserve insertion order;
/// - provide safe indexed access;
/// - support append, insert, replace and removal;
/// - support slicing and concatenation;
/// - support searching and counting;
/// - support structural equality;
/// - support nested arrays;
/// - expose validation helpers;
/// - use only Vitte language syntax.
///
/// This module intentionally keeps the JSON value representation local.
/// A higher-level json.core.value module can later unify Array, Object,
/// Number, String, Boolean and Null into the canonical JSON value tree.

space json::core::array;

const DEFAULT_CAPACITY: usize = 8;
const MINIMUM_CAPACITY: usize = 1;

pick JsonArrayValueKind {
    Null,
    Bool,
    Integer,
    Float,
    String,
    Array,
}

pick JsonArrayError {
    None,
    IndexOutOfBounds,
    Empty,
    InvalidRange,
    CapacityOverflow,
}

form JsonArrayValue {
    kind: JsonArrayValueKind,

    bool_value: bool,

    integer_value: i64,

    float_value: f64,

    string_value: string,

    array_value: [JsonArrayValue],
}

form JsonArray {
    values: [JsonArrayValue],

    length: usize,

    capacity: usize,
}

form JsonArrayValueResult {
    ok: bool,

    value: JsonArrayValue,

    error: JsonArrayError,

    index: usize,
}

form JsonArrayResult {
    ok: bool,

    value: JsonArray,

    error: JsonArrayError,

    index: usize,
}

form JsonArrayIndexResult {
    found: bool,

    index: usize,
}

form JsonArrayRange {
    start: usize,

    end: usize,
}

proc null_value() -> JsonArrayValue {
    return JsonArrayValue {
        kind: JsonArrayValueKind.Null,

        bool_value: false,

        integer_value: 0,

        float_value: 0.0,

        string_value: "",

        array_value: [],
    };
}

proc bool_value(
    value: bool
) -> JsonArrayValue {
    return JsonArrayValue {
        kind: JsonArrayValueKind.Bool,

        bool_value: value,

        integer_value: 0,

        float_value: 0.0,

        string_value: "",

        array_value: [],
    };
}

proc integer_value(
    value: i64
) -> JsonArrayValue {
    return JsonArrayValue {
        kind: JsonArrayValueKind.Integer,

        bool_value: false,

        integer_value: value,

        float_value: 0.0,

        string_value: "",

        array_value: [],
    };
}

proc float_value(
    value: f64
) -> JsonArrayValue {
    return JsonArrayValue {
        kind: JsonArrayValueKind.Float,

        bool_value: false,

        integer_value: 0,

        float_value: value,

        string_value: "",

        array_value: [],
    };
}

proc string_value(
    value: string
) -> JsonArrayValue {
    return JsonArrayValue {
        kind: JsonArrayValueKind.String,

        bool_value: false,

        integer_value: 0,

        float_value: 0.0,

        string_value: value,

        array_value: [],
    };
}

proc array_value(
    value: &JsonArray
) -> JsonArrayValue {
    return JsonArrayValue {
        kind: JsonArrayValueKind.Array,

        bool_value: false,

        integer_value: 0,

        float_value: 0.0,

        string_value: "",

        array_value: value.values,
    };
}

proc empty() -> JsonArray {
    return JsonArray {
        values: [],

        length: 0,

        capacity: DEFAULT_CAPACITY,
    };
}

proc with_capacity(
    requested: usize
) -> JsonArray {
    let mut actual: usize =
        requested;

    if actual < MINIMUM_CAPACITY {
        set actual =
            MINIMUM_CAPACITY;
    }

    return JsonArray {
        values: [],

        length: 0,

        capacity: actual,
    };
}

proc singleton(
    value: JsonArrayValue
) -> JsonArray {
    let mut result: JsonArray =
        with_capacity(1);

    set result.values.push(value);

    set result.length = 1;

    return result;
}

proc len(
    array: &JsonArray
) -> usize {
    return array.length;
}

proc capacity(
    array: &JsonArray
) -> usize {
    return array.capacity;
}

proc is_empty(
    array: &JsonArray
) -> bool {
    return array.length == 0;
}

proc is_not_empty(
    array: &JsonArray
) -> bool {
    return array.length != 0;
}

proc is_valid_index(
    array: &JsonArray,
    index: usize
) -> bool {
    return index < array.length;
}

proc is_valid_insert_index(
    array: &JsonArray,
    index: usize
) -> bool {
    return index <= array.length;
}

proc next_capacity(
    current: usize
) -> usize {
    if current < MINIMUM_CAPACITY {
        return DEFAULT_CAPACITY;
    }

    return current * 2;
}

proc capacity_for(
    current: usize,
    required: usize
) -> usize {
    let mut result: usize =
        current;

    if result < MINIMUM_CAPACITY {
        set result =
            DEFAULT_CAPACITY;
    }

    while result < required {
        set result =
            next_capacity(result);
    }

    return result;
}

proc reserve(
    array: &JsonArray,
    required: usize
) -> JsonArray {
    let mut result: JsonArray =
        clone(array);

    if required <= result.capacity {
        return result;
    }

    set result.capacity =
        capacity_for(
            result.capacity,
            required);

    return result;
}

proc reserve_additional(
    array: &JsonArray,
    additional: usize
) -> JsonArray {
    return reserve(
        array,
        array.length + additional);
}

proc value_is_null(
    value: &JsonArrayValue
) -> bool {
    return value.kind ==
         JsonArrayValueKind.Null;
}

proc value_is_bool(
    value: &JsonArrayValue
) -> bool {
    return value.kind ==
         JsonArrayValueKind.Bool;
}

proc value_is_integer(
    value: &JsonArrayValue
) -> bool {
    return value.kind ==
         JsonArrayValueKind.Integer;
}

proc value_is_float(
    value: &JsonArrayValue
) -> bool {
    return value.kind ==
         JsonArrayValueKind.Float;
}

proc value_is_number(
    value: &JsonArrayValue
) -> bool {
    return value_is_integer(value) ||
         value_is_float(value);
}

proc value_is_string(
    value: &JsonArrayValue
) -> bool {
    return value.kind ==
         JsonArrayValueKind.String;
}

proc value_is_array(
    value: &JsonArrayValue
) -> bool {
    return value.kind ==
         JsonArrayValueKind.Array;
}

proc value_as_bool(
    value: &JsonArrayValue
) -> bool {
    return value.bool_value;
}

proc value_as_integer(
    value: &JsonArrayValue
) -> i64 {
    if value_is_integer(value) {
        return value.integer_value;
    }

    if value_is_float(value) {
        return value.float_value as i64;
    }

    return 0;
}

proc value_as_float(
    value: &JsonArrayValue
) -> f64 {
    if value_is_float(value) {
        return value.float_value;
    }

    if value_is_integer(value) {
        return value.integer_value as f64;
    }

    return 0.0;
}

proc value_as_string(
    value: &JsonArrayValue
) -> string {
    return value.string_value;
}

proc value_copy(
    value: &JsonArrayValue
) -> JsonArrayValue {
    return JsonArrayValue {
        kind: value.kind,

        bool_value:
            value.bool_value,

        integer_value:
            value.integer_value,

        float_value:
            value.float_value,

        string_value:
            value.string_value,

        array_value:
            value.array_value,
    };
}

proc value_equals(
    left: &JsonArrayValue,
    right: &JsonArrayValue
) -> bool {
    if left.kind != right.kind {
        if value_is_number(left) &&
           value_is_number(right) {
            return value_as_float(left) ==
                 value_as_float(right);
        }

        return false;
    }

    if value_is_null(left) {
        return true;
    }

    if value_is_bool(left) {
        return left.bool_value ==
             right.bool_value;
    }

    if value_is_integer(left) {
        return left.integer_value ==
             right.integer_value;
    }

    if value_is_float(left) {
        return left.float_value ==
             right.float_value;
    }

    if value_is_string(left) {
        return left.string_value ==
             right.string_value;
    }

    if value_is_array(left) {
        if left.array_value.length !=
           right.array_value.length {
            return false;
        }

        let mut index: usize = 0;

        while index <
              left.array_value.length {
            let left_item: JsonArrayValue =
                left.array_value[index];

            let right_item: JsonArrayValue =
                right.array_value[index];

            if not value_equals(
                &left_item,
                &right_item) {
                return false;
            }

            set index += 1;
        }

        return true;
    }

    return false;
}

proc value_not_equals(
    left: &JsonArrayValue,
    right: &JsonArrayValue
) -> bool {
    return not value_equals(
        left,
        right);
}

proc push(
    array: &JsonArray,
    value: JsonArrayValue
) -> JsonArray {
    let mut result: JsonArray =
        reserve(
            array,
            array.length + 1);

    set result.values.push(value);

    set result.length += 1;

    return result;
}

proc push_null(
    array: &JsonArray
) -> JsonArray {
    return push(
        array,
        null_value());
}

proc push_bool(
    array: &JsonArray,
    value: bool
) -> JsonArray {
    return push(
        array,
        bool_value(value));
}

proc push_integer(
    array: &JsonArray,
    value: i64
) -> JsonArray {
    return push(
        array,
        integer_value(value));
}

proc push_float(
    array: &JsonArray,
    value: f64
) -> JsonArray {
    return push(
        array,
        float_value(value));
}

proc push_string(
    array: &JsonArray,
    value: string
) -> JsonArray {
    return push(
        array,
        string_value(value));
}

proc push_array(
    array: &JsonArray,
    value: &JsonArray
) -> JsonArray {
    return push(
        array,
        array_value(value));
}

proc prepend(
    array: &JsonArray,
    value: JsonArrayValue
) -> JsonArray {
    let mut result: JsonArray =
        with_capacity(
            capacity_for(
                array.capacity,
                array.length + 1));

    set result =
        push(
            &result,
            value);

    let mut index: usize = 0;

    while index < array.length {
        set result =
            push(
                &result,
                array.values[index]);

        set index += 1;
    }

    return result;
}

proc prepend_null(
    array: &JsonArray
) -> JsonArray {
    return prepend(
        array,
        null_value());
}

proc prepend_bool(
    array: &JsonArray,
    value: bool
) -> JsonArray {
    return prepend(
        array,
        bool_value(value));
}

proc prepend_integer(
    array: &JsonArray,
    value: i64
) -> JsonArray {
    return prepend(
        array,
        integer_value(value));
}

proc prepend_float(
    array: &JsonArray,
    value: f64
) -> JsonArray {
    return prepend(
        array,
        float_value(value));
}

proc prepend_string(
    array: &JsonArray,
    value: string
) -> JsonArray {
    return prepend(
        array,
        string_value(value));
}

proc get(
    array: &JsonArray,
    index: usize
) -> JsonArrayValue {
    if not is_valid_index(
        array,
        index) {
        return null_value();
    }

    return array.values[index];
}

proc get_result(
    array: &JsonArray,
    index: usize
) -> JsonArrayValueResult {
    if not is_valid_index(
        array,
        index) {
        return JsonArrayValueResult {
            ok: false,

            value:
                null_value(),

            error:
                JsonArrayError.IndexOutOfBounds,

            index: index,
        };
    }

    return JsonArrayValueResult {
        ok: true,

        value:
            array.values[index],

        error:
            JsonArrayError.None,

        index: index,
    };
}

proc first(
    array: &JsonArray
) -> JsonArrayValue {
    if is_empty(array) {
        return null_value();
    }

    return array.values[0];
}

proc first_result(
    array: &JsonArray
) -> JsonArrayValueResult {
    if is_empty(array) {
        return JsonArrayValueResult {
            ok: false,

            value:
                null_value(),

            error:
                JsonArrayError.Empty,

            index: 0,
        };
    }

    return JsonArrayValueResult {
        ok: true,

        value:
            array.values[0],

        error:
            JsonArrayError.None,

        index: 0,
    };
}

proc last(
    array: &JsonArray
) -> JsonArrayValue {
    if is_empty(array) {
        return null_value();
    }

    return array.values[
        array.length - 1
    ];
}

proc last_result(
    array: &JsonArray
) -> JsonArrayValueResult {
    if is_empty(array) {
        return JsonArrayValueResult {
            ok: false,

            value:
                null_value(),

            error:
                JsonArrayError.Empty,

            index: 0,
        };
    }

    let index: usize =
        array.length - 1;

    return JsonArrayValueResult {
        ok: true,

        value:
            array.values[index],

        error:
            JsonArrayError.None,

        index: index,
    };
}

proc set_value(
    array: &JsonArray,
    index: usize,
    value: JsonArrayValue
) -> JsonArray {
    let mut result: JsonArray =
        clone(array);

    if not is_valid_index(
        &result,
        index) {
        return result;
    }

    set result.values[index] =
        value;

    return result;
}

proc replace(
    array: &JsonArray,
    index: usize,
    value: JsonArrayValue
) -> JsonArrayResult {
    if not is_valid_index(
        array,
        index) {
        return JsonArrayResult {
            ok: false,

            value: clone(array),

            error:
                JsonArrayError.IndexOutOfBounds,

            index: index,
        };
    }

    let result: JsonArray =
        set_value(
            array,
            index,
            value);

    return JsonArrayResult {
        ok: true,

        value: result,

        error:
            JsonArrayError.None,

        index: index,
    };
}

proc insert(
    array: &JsonArray,
    index: usize,
    value: JsonArrayValue
) -> JsonArrayResult {
    if not is_valid_insert_index(
        array,
        index) {
        return JsonArrayResult {
            ok: false,

            value: clone(array),

            error:
                JsonArrayError.IndexOutOfBounds,

            index: index,
        };
    }

    let mut result: JsonArray =
        with_capacity(
            capacity_for(
                array.capacity,
                array.length + 1));

    let mut current: usize = 0;

    while current < index {
        set result =
            push(
                &result,
                array.values[current]);

        set current += 1;
    }

    set result =
        push(
            &result,
            value);

    while current < array.length {
        set result =
            push(
                &result,
                array.values[current]);

        set current += 1;
    }

    return JsonArrayResult {
        ok: true,

        value: result,

        error:
            JsonArrayError.None,

        index: index,
    };
}

proc insert_null(
    array: &JsonArray,
    index: usize
) -> JsonArrayResult {
    return insert(
        array,
        index,
        null_value());
}

proc insert_bool(
    array: &JsonArray,
    index: usize,
    value: bool
) -> JsonArrayResult {
    return insert(
        array,
        index,
        bool_value(value));
}

proc insert_integer(
    array: &JsonArray,
    index: usize,
    value: i64
) -> JsonArrayResult {
    return insert(
        array,
        index,
        integer_value(value));
}

proc insert_float(
    array: &JsonArray,
    index: usize,
    value: f64
) -> JsonArrayResult {
    return insert(
        array,
        index,
        float_value(value));
}

proc insert_string(
    array: &JsonArray,
    index: usize,
    value: string
) -> JsonArrayResult {
    return insert(
        array,
        index,
        string_value(value));
}

proc remove_at(
    array: &JsonArray,
    index: usize
) -> JsonArrayResult {
    if not is_valid_index(
        array,
        index) {
        return JsonArrayResult {
            ok: false,

            value: clone(array),

            error:
                JsonArrayError.IndexOutOfBounds,

            index: index,
        };
    }

    let mut result: JsonArray =
        with_capacity(
            array.capacity);

    let mut current: usize = 0;

    while current < array.length {
        if current != index {
            set result =
                push(
                    &result,
                    array.values[current]);
        }

        set current += 1;
    }

    return JsonArrayResult {
        ok: true,

        value: result,

        error:
            JsonArrayError.None,

        index: index,
    };
}

proc pop(
    array: &JsonArray
) -> JsonArrayResult {
    if is_empty(array) {
        return JsonArrayResult {
            ok: false,

            value: clone(array),

            error:
                JsonArrayError.Empty,

            index: 0,
        };
    }

    return remove_at(
        array,
        array.length - 1);
}

proc remove_first(
    array: &JsonArray
) -> JsonArrayResult {
    if is_empty(array) {
        return JsonArrayResult {
            ok: false,

            value: clone(array),

            error:
                JsonArrayError.Empty,

            index: 0,
        };
    }

    return remove_at(
        array,
        0);
}

proc clear(
    array: &JsonArray
) -> JsonArray {
    return JsonArray {
        values: [],

        length: 0,

        capacity: array.capacity,
    };
}

proc reset() -> JsonArray {
    return empty();
}

proc clone(
    array: &JsonArray
) -> JsonArray {
    let mut result: JsonArray =
        with_capacity(
            array.capacity);

    let mut index: usize = 0;

    while index < array.length {
        set result =
            push(
                &result,
                value_copy(
                    &array.values[index]));

        set index += 1;
    }

    return result;
}

proc append(
    destination: &JsonArray,
    source: &JsonArray
) -> JsonArray {
    let mut result: JsonArray =
        reserve(
            destination,
            destination.length +
            source.length);

    let mut index: usize = 0;

    while index < source.length {
        set result =
            push(
                &result,
                source.values[index]);

        set index += 1;
    }

    return result;
}

proc concat(
    left: &JsonArray,
    right: &JsonArray
) -> JsonArray {
    return append(
        left,
        right);
}

proc repeat(
    value: JsonArrayValue,
    count: usize
) -> JsonArray {
    let mut result: JsonArray =
        with_capacity(count);

    let mut index: usize = 0;

    while index < count {
        set result =
            push(
                &result,
                value_copy(&value));

        set index += 1;
    }

    return result;
}

proc reverse(
    array: &JsonArray
) -> JsonArray {
    let mut result: JsonArray =
        with_capacity(
            array.capacity);

    let mut index: usize =
        array.length;

    while index > 0 {
        set index -= 1;

        set result =
            push(
                &result,
                array.values[index]);
    }

    return result;
}

proc range_valid(
    array: &JsonArray,
    start: usize,
    end: usize
) -> bool {
    return start <= end &&
         end <= array.length;
}

proc slice(
    array: &JsonArray,
    start: usize,
    end: usize
) -> JsonArrayResult {
    if not range_valid(
        array,
        start,
        end) {
        return JsonArrayResult {
            ok: false,

            value:
                empty(),

            error:
                JsonArrayError.InvalidRange,

            index: start,
        };
    }

    let count: usize =
        end - start;

    let mut result: JsonArray =
        with_capacity(
            count);

    let mut index: usize =
        start;

    while index < end {
        set result =
            push(
                &result,
                array.values[index]);

        set index += 1;
    }

    return JsonArrayResult {
        ok: true,

        value: result,

        error:
            JsonArrayError.None,

        index: start,
    };
}

proc take(
    array: &JsonArray,
    count: usize
) -> JsonArray {
    let mut actual: usize =
        count;

    if actual > array.length {
        set actual =
            array.length;
    }

    let result: JsonArrayResult =
        slice(
            array,
            0,
            actual);

    return result.value;
}

proc drop(
    array: &JsonArray,
    count: usize
) -> JsonArray {
    if count >= array.length {
        return with_capacity(
            array.capacity);
    }

    let result: JsonArrayResult =
        slice(
            array,
            count,
            array.length);

    return result.value;
}

proc take_last(
    array: &JsonArray,
    count: usize
) -> JsonArray {
    if count >= array.length {
        return clone(array);
    }

    let start: usize =
        array.length - count;

    let result: JsonArrayResult =
        slice(
            array,
            start,
            array.length);

    return result.value;
}

proc drop_last(
    array: &JsonArray,
    count: usize
) -> JsonArray {
    if count >= array.length {
        return with_capacity(
            array.capacity);
    }

    let end: usize =
        array.length - count;

    let result: JsonArrayResult =
        slice(
            array,
            0,
            end);

    return result.value;
}

proc contains(
    array: &JsonArray,
    value: &JsonArrayValue
) -> bool {
    let mut index: usize = 0;

    while index < array.length {
        if value_equals(
            &array.values[index],
            value) {
            return true;
        }

        set index += 1;
    }

    return false;
}

proc index_of(
    array: &JsonArray,
    value: &JsonArrayValue
) -> JsonArrayIndexResult {
    let mut index: usize = 0;

    while index < array.length {
        if value_equals(
            &array.values[index],
            value) {
            return JsonArrayIndexResult {
                found: true,
                index: index,
            };
        }

        set index += 1;
    }

    return JsonArrayIndexResult {
        found: false,
        index: 0,
    };
}

proc last_index_of(
    array: &JsonArray,
    value: &JsonArrayValue
) -> JsonArrayIndexResult {
    let mut index: usize =
        array.length;

    while index > 0 {
        set index -= 1;

        if value_equals(
            &array.values[index],
            value) {
            return JsonArrayIndexResult {
                found: true,
                index: index,
            };
        }
    }

    return JsonArrayIndexResult {
        found: false,
        index: 0,
    };
}

proc count(
    array: &JsonArray,
    value: &JsonArrayValue
) -> usize {
    let mut result: usize = 0;
    let mut index: usize = 0;

    while index < array.length {
        if value_equals(
            &array.values[index],
            value) {
            set result += 1;
        }

        set index += 1;
    }

    return result;
}

proc count_kind(
    array: &JsonArray,
    kind: JsonArrayValueKind
) -> usize {
    let mut result: usize = 0;
    let mut index: usize = 0;

    while index < array.length {
        if array.values[index].kind ==
           kind {
            set result += 1;
        }

        set index += 1;
    }

    return result;
}

proc contains_null(
    array: &JsonArray
) -> bool {
    let value: JsonArrayValue =
        null_value();

    return contains(
        array,
        &value);
}

proc contains_bool(
    array: &JsonArray,
    value: bool
) -> bool {
    let expected: JsonArrayValue =
        bool_value(value);

    return contains(
        array,
        &expected);
}

proc contains_integer(
    array: &JsonArray,
    value: i64
) -> bool {
    let expected: JsonArrayValue =
        integer_value(value);

    return contains(
        array,
        &expected);
}

