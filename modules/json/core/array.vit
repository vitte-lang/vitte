proc compact_nulls(
    array: &JsonArray
) -> JsonArray {
    let mut result: JsonArray =
        with_capacity(
            array.capacity);

    let mut index: usize = 0;

    while index < array.length {
        if not value_is_null(
            &array.values[index]) {
            set result =
                push(
                    &result,
                    array.values[index]);
        }

        set index += 1;
    }

    return result;
}

proc only_nulls(
    array: &JsonArray
) -> JsonArray {
