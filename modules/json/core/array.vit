proc count_null(
    array: &JsonArray
) -> usize {
    return count_kind(
        array,
        JsonArrayValueKind.Null);
}

proc count_bool(
    array: &JsonArray
) -> usize {
    return count_kind(
        array,
        JsonArrayValueKind.Bool);
}

proc count_integer(
    array: &JsonArray
) -> usize {
    return count_kind(
        array,
        JsonArrayValueKind.Integer);
}

proc count_float(
    array: &JsonArray
) -> usize {
    return count_kind(
        array,
        JsonArrayValueKind.Float);
}

proc count_number(
    array: &JsonArray
) -> usize {
    return count_integer(array) +
         count_float(array);
}

proc count_string(
    array: &JsonArray
) -> usize {
    return count_kind(
        array,
        JsonArrayValueKind.String);
}

proc count_array(
    array: &JsonArray
) -> usize {
    return count_kind(
        array,
        JsonArrayValueKind.Array);
}

proc equals(
    left: &JsonArray,
    right: &JsonArray
) -> bool {
    if left.length !=
       right.length {
        return false;
    }

    let mut index: usize = 0;

    while index < left.length {
        if not value_equals(
            &left.values[index],
            &right.values[index]) {
            return false;
        }

        set index += 1;
    }

    return true;
}

proc not_equals(
    left: &JsonArray,
    right: &JsonArray
) -> bool {
    return not equals(
        left,
        right);
}

proc starts_with(
    array: &JsonArray,
    prefix: &JsonArray
) -> bool {
    if prefix.length >
       array.length {
        return false;
    }

    let mut index: usize = 0;

    while index < prefix.length {
        if not value_equals(
            &array.values[index],
            &prefix.values[index]) {
            return false;
        }

        set index += 1;
    }

    return true;
}

proc ends_with(
    array: &JsonArray,
    suffix: &JsonArray
) -> bool {
    if suffix.length >
       array.length {
        return false;
    }

    let offset: usize =
        array.length -
        suffix.length;

    let mut index: usize = 0;

    while index < suffix.length {
        if not value_equals(
            &array.values[
                offset + index
            ],
            &suffix.values[index]) {
            return false;
        }

        set index += 1;
    }

    return true;
}

