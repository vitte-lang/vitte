proc integer_sum(
    array: &JsonArray
) -> i64 {
    let mut result: i64 = 0;
    let mut index: usize = 0;

    while index < array.length {
        if value_is_integer(
            &array.values[index]) {
            set result +=
                array.values[index].
                    integer_value;
        }

        set index += 1;
    }

    return result;
}

proc number_sum(
    array: &JsonArray
) -> f64 {
    let mut result: f64 = 0.0;
    let mut index: usize = 0;

    while index < array.length {
        if value_is_integer(
            &array.values[index]) {
            set result +=
                array.values[index].
                    integer_value as f64;
        }

        if value_is_float(
            &array.values[index]) {
            set result +=
                array.values[index].
                    float_value;
        }

        set index += 1;
    }

    return result;
}

proc integer_minimum(
    array: &JsonArray
) -> JsonArrayValueResult {
    let mut found: bool = false;
    let mut minimum: i64 = 0;
    let mut minimum_index: usize = 0;

    let mut index: usize = 0;

    while index < array.length {
        if value_is_integer(
            &array.values[index]) {
            let value: i64 =
                array.values[index].
                    integer_value;

            if not found ||
               value < minimum {
                set found = true;
                set minimum = value;
                set minimum_index = index;
            }
        }

        set index += 1;
    }

    if not found {
        return JsonArrayValueResult {
            ok: false,

            value:
                null_value(),

            error:
                JsonArrayError.Empty,

            index: 0,
        };
    }

    return JsonArrayValueResult {
        ok: true,

        value:
            integer_value(minimum),

        error:
            JsonArrayError.None,

        index:
            minimum_index,
    };
}

proc integer_maximum(
    array: &JsonArray
) -> JsonArrayValueResult {
    let mut found: bool = false;
    let mut maximum: i64 = 0;
    let mut maximum_index: usize = 0;

    let mut index: usize = 0;

    while index < array.length {
        if value_is_integer(
            &array.values[index]) {
            let value: i64 =
                array.values[index].
                    integer_value;

            if not found ||
               value > maximum {
                set found = true;
                set maximum = value;
                set maximum_index = index;
            }
        }

        set index += 1;
    }

    if not found {
        return JsonArrayValueResult {
            ok: false,

            value:
                null_value(),

            error:
                JsonArrayError.Empty,

            index: 0,
        };
    }

    return JsonArrayValueResult {
        ok: true,

        value:
            integer_value(maximum),

        error:
            JsonArrayError.None,

        index:
            maximum_index,
    };
}

proc swap(
    array: &JsonArray,
    left: usize,
    right: usize
) -> JsonArrayResult {
    if not is_valid_index(
           array,
           left) ||
       not is_valid_index(
           array,
           right) {
        return JsonArrayResult {
            ok: false,

            value: clone(array),

            error:
                JsonArrayError.IndexOutOfBounds,

            index: left,
        };
    }

    let mut result: JsonArray =
        clone(array);

    let temporary: JsonArrayValue =
        result.values[left];

    set result.values[left] =
        result.values[right];

    set result.values[right] =
        temporary;

    return JsonArrayResult {
        ok: true,

        value: result,

        error:
            JsonArrayError.None,

        index: left,
    };
}

proc rotate_left(
    array: &JsonArray
) -> JsonArray {
    if array.length <= 1 {
        return clone(array);
    }

    let mut result: JsonArray =
        with_capacity(
            array.capacity);

    let mut index: usize = 1;

    while index < array.length {
        set result =
            push(
                &result,
                array.values[index]);

        set index += 1;
    }

    set result =
        push(
            &result,
            array.values[0]);

    return result;
}

proc rotate_right(
    array: &JsonArray
) -> JsonArray {
    if array.length <= 1 {
        return clone(array);
    }

    let mut result: JsonArray =
        with_capacity(
            array.capacity);

    set result =
        push(
            &result,
            array.values[
                array.length - 1
            ]);

    let mut index: usize = 0;

    while index <
          array.length - 1 {
        set result =
            push(
                &result,
                array.values[index]);

        set index += 1;
    }

    return result;
}

proc unique(
    array: &JsonArray
) -> JsonArray {
    let mut result: JsonArray =
        with_capacity(
            array.capacity);

    let mut index: usize = 0;

    while index < array.length {
        let value: JsonArrayValue =
            array.values[index];

        if not contains(
            &result,
            &value) {
            set result =
                push(
                    &result,
                    value);
        }

        set index += 1;
    }

    return result;
}

proc remove_value(
    array: &JsonArray,
    value: &JsonArrayValue
) -> JsonArray {
    let mut result: JsonArray =
        with_capacity(
            array.capacity);

    let mut removed: bool = false;
    let mut index: usize = 0;

    while index < array.length {
        if not removed &&
           value_equals(
               &array.values[index],
               value) {
            set removed = true;
        } else {
            set result =
                push(
                    &result,
                    array.values[index]);
        }

        set index += 1;
    }

    return result;
}

proc remove_all(
    array: &JsonArray,
    value: &JsonArrayValue
) -> JsonArray {
    let mut result: JsonArray =
        with_capacity(
            array.capacity);

    let mut index: usize = 0;

    while index < array.length {
        if not value_equals(
            &array.values[index],
            value) {
            set result =
                push(
                    &result,
                    array.values[index]);
        }

        set index += 1;
    }

    return result;
}

proc replace_all(
    array: &JsonArray,
    old_value: &JsonArrayValue,
    new_value: JsonArrayValue
) -> JsonArray {
    let mut result: JsonArray =
        clone(array);

    let mut index: usize = 0;

    while index < result.length {
        if value_equals(
            &result.values[index],
            old_value) {
            set result.values[index] =
                value_copy(
                    &new_value);
        }

        set index += 1;
    }

    return result;
}

proc nested_array(
    value: &JsonArrayValue
) -> JsonArray {
    if not value_is_array(value) {
        return empty();
    }

    return JsonArray {
        values:
            value.array_value,

        length:
            value.array_value.length,

        capacity:
            capacity_for(
                MINIMUM_CAPACITY,
                value.array_value.length),
    };
}

proc flatten_one(
    array: &JsonArray
) -> JsonArray {
    let mut result: JsonArray =
        empty();

    let mut index: usize = 0;

    while index < array.length {
        let value: JsonArrayValue =
            array.values[index];

        if value_is_array(&value) {
            let nested: JsonArray =
                nested_array(&value);

            set result =
                append(
                    &result,
                    &nested);
        } else {
            set result =
                push(
                    &result,
                    value);
        }

        set index += 1;
    }

    return result;
}

proc value_depth(
    value: &JsonArrayValue
) -> usize {
    if not value_is_array(value) {
        return 0;
    }

    let mut maximum: usize = 0;
    let mut index: usize = 0;

    while index <
          value.array_value.length {
        let depth: usize =
            value_depth(
                &value.array_value[index]);

        if depth > maximum {
            set maximum = depth;
        }

        set index += 1;
    }

    return maximum + 1;
}

proc depth(
    array: &JsonArray
) -> usize {
    let mut maximum: usize = 1;
    let mut index: usize = 0;

    while index < array.length {
        let value_depth_value: usize =
            value_depth(
                &array.values[index]);

        let candidate: usize =
            value_depth_value + 1;

        if candidate > maximum {
            set maximum =
                candidate;
        }

        set index += 1;
    }

    return maximum;
}

proc scalar_count(
    array: &JsonArray
) -> usize {
    let mut result: usize = 0;
    let mut index: usize = 0;

    while index < array.length {
        let value: JsonArrayValue =
            array.values[index];

        if value_is_array(&value) {
            let nested: JsonArray =
                nested_array(&value);

            set result +=
                scalar_count(
                    &nested);
        } else {
            set result += 1;
        }

        set index += 1;
    }

    return result;
}

proc total_value_count(
    array: &JsonArray
) -> usize {
    let mut result: usize =
        array.length;

    let mut index: usize = 0;

    while index < array.length {
        let value: JsonArrayValue =
            array.values[index];

        if value_is_array(&value) {
            let nested: JsonArray =
                nested_array(&value);

            set result +=
                total_value_count(
                    &nested);
        }

        set index += 1;
    }

    return result;
}

proc validate_value(
    value: &JsonArrayValue
) -> bool {
    if value.kind ==
       JsonArrayValueKind.Null {
        return true;
    }

    if value.kind ==
       JsonArrayValueKind.Bool {
        return true;
    }

    if value.kind ==
       JsonArrayValueKind.Integer {
        return true;
    }

    if value.kind ==
       JsonArrayValueKind.Float {
        return true;
    }

    if value.kind ==
       JsonArrayValueKind.String {
        return true;
    }

    if value.kind ==
       JsonArrayValueKind.Array {
        let mut index: usize = 0;

        while index <
              value.array_value.length {
            if not validate_value(
                &value.array_value[index]) {
                return false;
            }

            set index += 1;
        }

        return true;
    }

    return false;
}

proc validate(
    array: &JsonArray
) -> bool {
    if array.capacity <
       MINIMUM_CAPACITY {
        return false;
    }

    if array.length >
       array.capacity {
        return false;
    }

    if array.values.length !=
       array.length {
        return false;
    }

    let mut index: usize = 0;

    while index < array.length {
        if not validate_value(
            &array.values[index]) {
            return false;
        }

        set index += 1;
    }

    return true;
}

proc error_name(
    error: JsonArrayError
) -> string {
    if error ==
       JsonArrayError.None {
        return "none";
    }

    if error ==
       JsonArrayError.IndexOutOfBounds {
        return "index out of bounds";
    }

    if error ==
       JsonArrayError.Empty {
        return "empty array";
    }

    if error ==
       JsonArrayError.InvalidRange {
        return "invalid range";
    }

    return "capacity overflow";
}

proc test_empty() -> bool {
    let array: JsonArray =
        empty();

    return is_empty(&array) &&
         len(&array) == 0 &&
         capacity(&array) >=
             MINIMUM_CAPACITY &&
         validate(&array);
}

proc test_push() -> bool {
    let mut array: JsonArray =
        empty();

    set array =
        push_integer(
            &array,
            20);

    set array =
        push_integer(
            &array,
            22);

    return array.length == 2 &&
         value_as_integer(
             &array.values[0]) == 20 &&
         value_as_integer(
             &array.values[1]) == 22;
}

proc test_all_types() -> bool {
    let mut array: JsonArray =
        empty();

    set array =
        push_null(&array);

    set array =
        push_bool(
            &array,
            true);

    set array =
        push_integer(
            &array,
            42);

    set array =
        push_float(
            &array,
            42.5);

    set array =
        push_string(
            &array,
            "Vitte");

    return array.length == 5 &&
         value_is_null(
             &array.values[0]) &&
         value_is_bool(
             &array.values[1]) &&
         value_is_integer(
             &array.values[2]) &&
         value_is_float(
             &array.values[3]) &&
         value_is_string(
             &array.values[4]);
}

proc test_first_last() -> bool {
    let mut array: JsonArray =
        empty();

    set array =
        push_integer(
            &array,
            20);

    set array =
        push_integer(
            &array,
            22);

    let first_value: JsonArrayValue =
        first(&array);

    let last_value: JsonArrayValue =
        last(&array);

    return value_as_integer(
               &first_value) == 20 &&
         value_as_integer(
               &last_value) == 22;
}

proc test_replace() -> bool {
    let mut array: JsonArray =
        empty();

    set array =
        push_integer(
            &array,
            20);

    set array =
        push_integer(
            &array,
            21);

    let result: JsonArrayResult =
        replace(
            &array,
            1,
            integer_value(22));

    return result.ok &&
         value_as_integer(
             &result.value.values[1]) ==
             22;
}

proc test_insert() -> bool {
    let mut array: JsonArray =
        empty();

    set array =
        push_integer(
            &array,
            20);

    set array =
        push_integer(
            &array,
            22);

    let result: JsonArrayResult =
        insert_integer(
            &array,
            1,
            21);

    return result.ok &&
         result.value.length == 3 &&
         value_as_integer(
             &result.value.values[0]) == 20 &&
         value_as_integer(
             &result.value.values[1]) == 21 &&
         value_as_integer(
             &result.value.values[2]) == 22;
}

proc test_remove() -> bool {
    let mut array: JsonArray =
        empty();

    set array =
        push_integer(
            &array,
            20);

    set array =
        push_integer(
            &array,
            21);

    set array =
        push_integer(
            &array,
            22);

    let result: JsonArrayResult =
        remove_at(
            &array,
            1);

    return result.ok &&
         result.value.length == 2 &&
         value_as_integer(
             &result.value.values[0]) == 20 &&
         value_as_integer(
             &result.value.values[1]) == 22;
}

proc test_concat() -> bool {
    let mut left: JsonArray =
        empty();

    let mut right: JsonArray =
        empty();

    set left =
        push_integer(
            &left,
            20);

    set right =
        push_integer(
            &right,
            22);

    let result: JsonArray =
        concat(
            &left,
            &right);

    return result.length == 2 &&
         integer_sum(&result) == 42;
}

proc test_reverse() -> bool {
    let mut array: JsonArray =
        empty();

    set array =
        push_integer(
            &array,
            20);

    set array =
        push_integer(
            &array,
            21);

    set array =
        push_integer(
            &array,
            22);

    let result: JsonArray =
        reverse(&array);

    return value_as_integer(
               &result.values[0]) == 22 &&
         value_as_integer(
               &result.values[1]) == 21 &&
         value_as_integer(
               &result.values[2]) == 20;
}

proc test_slice() -> bool {
    let mut array: JsonArray =
        empty();

    set array =
        push_integer(
            &array,
            10);

    set array =
        push_integer(
            &array,
            20);

    set array =
        push_integer(
            &array,
            22);

    set array =
        push_integer(
            &array,
            30);

    let result: JsonArrayResult =
        slice(
            &array,
            1,
            3);

    return result.ok &&
         result.value.length == 2 &&
         integer_sum(
             &result.value) == 42;
}

proc test_contains() -> bool {
    let mut array: JsonArray =
        empty();

    set array =
        push_integer(
            &array,
            42);

    set array =
        push_string(
            &array,
            "Vitte");

    return contains_integer(
               &array,
               42) &&
         contains_string(
               &array,
               "Vitte") &&
         not contains_integer(
               &array,
               43);
}

proc test_unique() -> bool {
    let mut array: JsonArray =
        empty();

    set array =
        push_integer(
            &array,
            20);

    set array =
        push_integer(
            &array,
            20);

    set array =
        push_integer(
            &array,
            22);

    set array =
        push_integer(
            &array,
            22);

    let result: JsonArray =
        unique(&array);

    return result.length == 2 &&
         integer_sum(&result) == 42;
}

proc test_equality() -> bool {
    let mut left: JsonArray =
        empty();

    let mut right: JsonArray =
        empty();

    set left =
        push_integer(
            &left,
            20);

    set left =
        push_integer(
            &left,
            22);

    set right =
        push_integer(
            &right,
            20);

    set right =
        push_integer(
            &right,
            22);

    return equals(
        &left,
        &right);
}

proc test_nested_array() -> bool {
    let mut inner: JsonArray =
        empty();

    set inner =
        push_integer(
            &inner,
            20);

    set inner =
        push_integer(
            &inner,
            22);

    let mut outer: JsonArray =
        empty();

    set outer =
        push_array(
            &outer,
            &inner);

    if outer.length != 1 {
        return false;
    }

    if not value_is_array(
        &outer.values[0]) {
        return false;
    }

    let restored: JsonArray =
        nested_array(
            &outer.values[0]);

    return restored.length == 2 &&
         integer_sum(
             &restored) == 42;
}

proc test_flatten_one() -> bool {
    let mut nested: JsonArray =
        empty();

    set nested =
        push_integer(
            &nested,
            20);

    set nested =
        push_integer(
            &nested,
            22);

    let mut outer: JsonArray =
        empty();

    set outer =
        push_integer(
            &outer,
            10);

    set outer =
        push_array(
            &outer,
            &nested);

    set outer =
        push_integer(
            &outer,
            30);

    let flat: JsonArray =
        flatten_one(
            &outer);

    return flat.length == 4 &&
         integer_sum(&flat) == 82;
}

proc test_numeric_filters() -> bool {
    let mut array: JsonArray =
        empty();

    set array =
        push_integer(
            &array,
            20);

    set array =
        push_string(
            &array,
            "ignored");

    set array =
        push_integer(
            &array,
            22);

    set array =
        push_bool(
            &array,
            true);

    let integers: JsonArray =
        only_integers(
            &array);

    return integers.length == 2 &&
         integer_sum(
             &integers) == 42;
}

proc test_minimum_maximum() -> bool {
    let mut array: JsonArray =
        empty();

    set array =
        push_integer(
            &array,
            42);

    set array =
        push_integer(
            &array,
            -10);

    set array =
        push_integer(
            &array,
            100);

    set array =
        push_integer(
            &array,
            20);

    let minimum: JsonArrayValueResult =
        integer_minimum(
            &array);

    let maximum: JsonArrayValueResult =
        integer_maximum(
            &array);

    return minimum.ok &&
         maximum.ok &&
         minimum.value.integer_value ==
             -10 &&
         maximum.value.integer_value ==
             100;
}

proc test_rotation() -> bool {
    let mut array: JsonArray =
        empty();

    set array =
        push_integer(
            &array,
            20);

    set array =
        push_integer(
            &array,
            21);

    set array =
        push_integer(
            &array,
            22);

    let left: JsonArray =
        rotate_left(
            &array);

    let right: JsonArray =
        rotate_right(
            &array);

    return left.values[0].integer_value == 21 &&
         left.values[1].integer_value == 22 &&
         left.values[2].integer_value == 20 &&
         right.values[0].integer_value == 22 &&
         right.values[1].integer_value == 20 &&
         right.values[2].integer_value == 21;
}

proc test_remove_all() -> bool {
    let mut array: JsonArray =
        empty();

    set array =
        push_integer(
            &array,
            20);

    set array =
        push_integer(
            &array,
            42);

    set array =
        push_integer(
            &array,
            20);

    set array =
        push_integer(
            &array,
            22);

    let target: JsonArrayValue =
        integer_value(20);

    let result: JsonArray =
        remove_all(
            &array,
            &target);

    return result.length == 2 &&
         result.values[0].integer_value ==
             42 &&
         result.values[1].integer_value ==
             22;
}

proc test_replace_all() -> bool {
    let mut array: JsonArray =
        empty();

    set array =
        push_integer(
            &array,
            20);

    set array =
        push_integer(
            &array,
            20);

    set array =
        push_integer(
            &array,
            20);

    let old_value: JsonArrayValue =
        integer_value(20);

    let new_value: JsonArrayValue =
        integer_value(42);

    let result: JsonArray =
        replace_all(
            &array,
            &old_value,
            new_value);

    return result.length == 3 &&
         result.values[0].integer_value == 42 &&
         result.values[1].integer_value == 42 &&
         result.values[2].integer_value == 42;
}

proc test_take_drop() -> bool {
    let mut array: JsonArray =
        empty();

    set array =
        push_integer(
            &array,
            10);

    set array =
        push_integer(
            &array,
            20);

    set array =
        push_integer(
            &array,
            22);

    set array =
        push_integer(
            &array,
            30);

    let first_two: JsonArray =
        take(
            &array,
            2);

    let last_two: JsonArray =
        drop(
            &array,
            2);

    return first_two.length == 2 &&
         last_two.length == 2 &&
         integer_sum(
             &first_two) == 30 &&
         integer_sum(
             &last_two) == 52;
}

proc test_starts_ends_with() -> bool {
    let mut array: JsonArray =
        empty();

    set array =
        push_integer(
            &array,
            20);

    set array =
        push_integer(
            &array,
            21);

    set array =
        push_integer(
            &array,
            22);

    let mut prefix: JsonArray =
        empty();

    set prefix =
        push_integer(
            &prefix,
            20);

    set prefix =
        push_integer(
            &prefix,
            21);

    let mut suffix: JsonArray =
        empty();

    set suffix =
        push_integer(
            &suffix,
            21);

    set suffix =
        push_integer(
            &suffix,
            22);

    return starts_with(
               &array,
               &prefix) &&
         ends_with(
               &array,
               &suffix);
}

proc test_validation() -> bool {
    let mut array: JsonArray =
        empty();

    set array =
        push_null(&array);

    set array =
        push_bool(
            &array,
            true);

    set array =
        push_integer(
            &array,
            42);

    set array =
        push_float(
            &array,
            42.5);

    set array =
        push_string(
            &array,
            "Vitte");

    return validate(&array);
}

proc self_test() -> bool {
    return test_empty() &&
         test_push() &&
         test_all_types() &&
         test_first_last() &&
         test_replace() &&
         test_insert() &&
         test_remove() &&
         test_concat() &&
         test_reverse() &&
         test_slice() &&
         test_contains() &&
         test_unique() &&
         test_equality() &&
         test_nested_array() &&
         test_flatten_one() &&
         test_numeric_filters() &&
         test_minimum_maximum() &&
         test_rotation() &&
         test_remove_all() &&
         test_replace_all() &&
         test_take_drop() &&
         test_starts_ends_with() &&
         test_validation();
}
