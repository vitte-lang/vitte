proc compact_nulls(
    object: &JsonObject
) -> JsonObject {
    let mut result: JsonObject =
        empty();

    let mut index: usize = 0;

    while index <
          object.length {
        let current:
            JsonObjectMember =
                object.members[index];

        if !value_is_null(
            &current.value) {
            set result =
                insert_member_unchecked(
                    &result,
                    member_copy(
                        &current));
        }

        set index += 1;
    }

    give result;
}

proc integer_sum(
    object: &JsonObject
) -> i64 {
    let mut result: i64 = 0;
    let mut index: usize = 0;

    while index <
          object.length {
        let value: JsonObjectValue =
            object.members[
                index
            ].value;

        if value_is_integer(
            &value) {
            set result +=
                value.integer_value;
        }

        set index += 1;
    }

    give result;
}

proc number_sum(
    object: &JsonObject
) -> f64 {
    let mut result: f64 = 0.0;
    let mut index: usize = 0;

    while index <
          object.length {
        let value: JsonObjectValue =
            object.members[
                index
            ].value;

        if value_is_integer(
            &value) {
            set result +=
                value.integer_value
                    as f64;
        }

        if value_is_float(
            &value) {
            set result +=
                value.float_value;
        }

        set index += 1;
    }

    give result;
}

proc nested_object(
    value: &JsonObjectValue
) -> JsonObject {
    if !value_is_object(value) {
        give empty();
    }

    give JsonObject {
        members:
            value.object_value,

        length:
            value.object_value.length,

        capacity:
            capacity_for(
                MINIMUM_CAPACITY,
                value.object_value.length),
    };
}

proc object_depth_from_members(
    members_value: [JsonObjectMember]
) -> usize {
    let mut maximum: usize = 1;
    let mut index: usize = 0;

    while index <
          members_value.length {
        let current:
            JsonObjectValue =
                members_value[
                    index
                ].value;

        let candidate: usize =
            value_depth(
                &current) + 1;

        if candidate >
           maximum {
            set maximum =
                candidate;
        }

        set index += 1;
    }

    give maximum;
}

proc array_depth_from_values(
    values_value: [JsonObjectValue]
) -> usize {
    let mut maximum: usize = 1;
    let mut index: usize = 0;

    while index <
          values_value.length {
        let candidate: usize =
            value_depth(
                &values_value[
                    index
                ]) + 1;

        if candidate >
           maximum {
            set maximum =
                candidate;
        }

        set index += 1;
    }

    give maximum;
}

proc value_depth(
    value: &JsonObjectValue
) -> usize {
    if value_is_array(value) {
        give array_depth_from_values(
            value.array_value);
    }

    if value_is_object(value) {
        give object_depth_from_members(
            value.object_value);
    }

    give 0;
}

proc depth(
    object: &JsonObject
) -> usize {
    give object_depth_from_members(
        object.members);
}

proc scalar_count_in_array(
    values_value: [JsonObjectValue]
) -> usize {
    let mut result: usize = 0;
    let mut index: usize = 0;

    while index <
          values_value.length {
        let current:
            JsonObjectValue =
                values_value[index];

        if value_is_array(
            &current) {
            set result +=
                scalar_count_in_array(
                    current.array_value);
        } else {
            if value_is_object(
                &current) {
                set result +=
                    scalar_count_in_members(
                        current.object_value);
            } else {
                set result += 1;
            }
        }

        set index += 1;
    }

    give result;
}

proc scalar_count_in_members(
    members_value: [JsonObjectMember]
) -> usize {
    let mut result: usize = 0;
    let mut index: usize = 0;

    while index <
          members_value.length {
        let current:
            JsonObjectValue =
                members_value[
                    index
                ].value;

        if value_is_array(
            &current) {
            set result +=
                scalar_count_in_array(
                    current.array_value);
        } else {
            if value_is_object(
                &current) {
                set result +=
                    scalar_count_in_members(
                        current.object_value);
            } else {
                set result += 1;
            }
        }

        set index += 1;
    }

    give result;
}

proc scalar_count(
    object: &JsonObject
) -> usize {
    give scalar_count_in_members(
        object.members);
}

proc total_value_count_in_array(
    values_value: [JsonObjectValue]
) -> usize {
    let mut result: usize =
        values_value.length;

    let mut index: usize = 0;

    while index <
          values_value.length {
        let current:
            JsonObjectValue =
                values_value[index];

        if value_is_array(
            &current) {
            set result +=
                total_value_count_in_array(
                    current.array_value);
        }

        if value_is_object(
            &current) {
            set result +=
                total_value_count_in_members(
                    current.object_value);
        }

        set index += 1;
    }

    give result;
}

proc total_value_count_in_members(
    members_value: [JsonObjectMember]
) -> usize {
    let mut result: usize =
        members_value.length;

    let mut index: usize = 0;

    while index <
          members_value.length {
        let current:
            JsonObjectValue =
                members_value[
                    index
                ].value;

        if value_is_array(
            &current) {
            set result +=
                total_value_count_in_array(
                    current.array_value);
        }

        if value_is_object(
            &current) {
            set result +=
                total_value_count_in_members(
                    current.object_value);
        }

        set index += 1;
    }

    give result;
}

proc total_value_count(
    object: &JsonObject
) -> usize {
    give total_value_count_in_members(
        object.members);
}

proc validate_array_values(
    values_value: [JsonObjectValue]
) -> bool {
    let mut index: usize = 0;

    while index <
          values_value.length {
        if !validate_value(
            &values_value[index]) {
            give false;
        }

        set index += 1;
    }

    give true;
}

proc validate_object_members(
    members_value: [JsonObjectMember]
) -> bool {
    let mut index: usize = 0;

    while index <
          members_value.length {
        if members_value[
               index
           ].key.length == 0 {
            give false;
        }

        if !validate_value(
            &members_value[
                index
            ].value) {
            give false;
        }

        let mut other: usize =
            index + 1;

        while other <
              members_value.length {
            if members_value[
                   index
               ].key ==
               members_value[
                   other
               ].key {
                give false;
            }

            set other += 1;
        }

        set index += 1;
    }

    give true;
}

proc validate_value(
    value: &JsonObjectValue
) -> bool {
    if value_is_null(value) {
        give true;
    }

    if value_is_bool(value) {
        give true;
    }

    if value_is_integer(value) {
        give true;
    }

    if value_is_float(value) {
        give true;
    }

    if value_is_string(value) {
        give true;
    }

    if value_is_array(value) {
        give validate_array_values(
            value.array_value);
    }

    if value_is_object(value) {
        give validate_object_members(
            value.object_value);
    }

    give false;
}

proc validate(
    object: &JsonObject
) -> bool {
    if object.capacity <
       MINIMUM_CAPACITY {
        give false;
    }

    if object.length >
       object.capacity {
        give false;
    }

    if object.members.length !=
       object.length {
        give false;
    }

    give validate_object_members(
        object.members);
}

proc error_name(
    error: JsonObjectError
) -> string {
    if error ==
       JsonObjectError.None {
        give "none";
    }

    if error ==
       JsonObjectError.KeyNotFound {
        give "key not found";
    }

    if error ==
       JsonObjectError.DuplicateKey {
        give "duplicate key";
    }

    if error ==
       JsonObjectError.EmptyKey {
        give "empty key";
    }

    if error ==
       JsonObjectError.IndexOutOfBounds {
        give "index out of bounds";
    }

    if error ==
       JsonObjectError.Empty {
        give "empty object";
    }

    if error ==
       JsonObjectError.InvalidRange {
        give "invalid range";
    }

    if error ==
       JsonObjectError.InvalidValue {
        give "invalid value";
    }

    give "capacity overflow";
}

proc test_empty() -> bool {
    let object: JsonObject =
        empty();

    give is_empty(&object) &&
         len(&object) == 0 &&
         capacity(&object) >=
             MINIMUM_CAPACITY &&
         validate(&object);
}

proc test_insert_integer() -> bool {
    let object: JsonObject =
        empty();

    let result: JsonObjectResult =
        insert_integer(
            &object,
            "answer",
            42);

    if !result.ok {
        give false;
    }

    give result.value.length == 1 &&
         has(
             &result.value,
             "answer") &&
         get_integer(
             &result.value,
             "answer") == 42;
}

proc test_insert_all_scalar_types() -> bool {
    let mut object: JsonObject =
        empty();

    let null_result: JsonObjectResult =
        insert_null(
            &object,
            "null");

    if !null_result.ok {
        give false;
    }

    set object =
        null_result.value;

    let bool_result: JsonObjectResult =
        insert_bool(
            &object,
            "bool",
            true);

    if !bool_result.ok {
        give false;
    }

    set object =
        bool_result.value;

    let integer_result: JsonObjectResult =
        insert_integer(
            &object,
            "integer",
            42);

    if !integer_result.ok {
        give false;
    }

    set object =
        integer_result.value;

    let float_result: JsonObjectResult =
        insert_float(
            &object,
            "float",
            42.5);

    if !float_result.ok {
        give false;
    }

    set object =
        float_result.value;

    let string_result: JsonObjectResult =
        insert_string(
            &object,
            "string",
            "Vitte");

    if !string_result.ok {
        give false;
    }

    set object =
        string_result.value;

    give object.length == 5 &&
         count_null(&object) == 1 &&
         count_bool(&object) == 1 &&
         count_integer(&object) == 1 &&
         count_float(&object) == 1 &&
         count_string(&object) == 1;
}

proc test_duplicate_key() -> bool {
    let object: JsonObject =
        set_integer(
            &empty(),
            "answer",
            42);

    let result: JsonObjectResult =
        insert_integer(
            &object,
            "answer",
            43);

    give !result.ok &&
         result.error ==
             JsonObjectError.DuplicateKey &&
         get_integer(
             &result.value,
             "answer") == 42;
}

proc test_set_replaces() -> bool {
    let mut object: JsonObject =
        empty();

    set object =
        set_integer(
            &object,
            "answer",
            41);

    set object =
        set_integer(
            &object,
            "answer",
            42);

    give object.length == 1 &&
         get_integer(
             &object,
             "answer") == 42;
}

proc test_remove() -> bool {
    let mut object: JsonObject =
        empty();

    set object =
        set_integer(
            &object,
            "first",
            20);

    set object =
        set_integer(
            &object,
            "second",
            22);

    let result: JsonObjectResult =
        remove(
            &object,
            "first");

    give result.ok &&
         result.value.length == 1 &&
         !has(
             &result.value,
             "first") &&
         get_integer(
             &result.value,
             "second") == 22;
}

proc test_rename() -> bool {
    let object: JsonObject =
        set_integer(
            &empty(),
            "old",
            42);

    let result: JsonObjectResult =
        rename(
            &object,
            "old",
            "answer");

    give result.ok &&
         !has(
             &result.value,
             "old") &&
         has(
             &result.value,
             "answer") &&
         get_integer(
             &result.value,
             "answer") == 42;
}

proc test_order_preserved() -> bool {
    let mut object: JsonObject =
        empty();

    set object =
        set_integer(
            &object,
            "first",
            20);

    set object =
        set_integer(
            &object,
            "second",
            21);

    set object =
        set_integer(
            &object,
            "third",
            22);

    give object.members[0].key ==
             "first" &&
         object.members[1].key ==
             "second" &&
         object.members[2].key ==
             "third";
}

proc test_merge() -> bool {
    let mut left: JsonObject =
        empty();

    set left =
        set_integer(
            &left,
            "first",
            20);

    set left =
        set_integer(
            &left,
            "shared",
            1);

    let mut right: JsonObject =
        empty();

    set right =
        set_integer(
            &right,
            "second",
            22);

    set right =
        set_integer(
            &right,
            "shared",
            42);

    let result: JsonObject =
        merge(
            &left,
            &right);

    give result.length == 3 &&
         get_integer(
             &result,
             "first") == 20 &&
         get_integer(
             &result,
             "second") == 22 &&
         get_integer(
             &result,
             "shared") == 42;
}

proc test_merge_preserve_left() -> bool {
    let mut left: JsonObject =
        empty();

    set left =
        set_integer(
            &left,
            "answer",
            42);

    let mut right: JsonObject =
        empty();

    set right =
        set_integer(
            &right,
            "answer",
            100);

    set right =
        set_integer(
            &right,
            "other",
            22);

    let result: JsonObject =
        merge_preserve_left(
            &left,
            &right);

    give result.length == 2 &&
         get_integer(
             &result,
             "answer") == 42 &&
         get_integer(
             &result,
             "other") == 22;
}

proc test_equality_order_independent() -> bool {
    let mut left: JsonObject =
        empty();

    set left =
        set_integer(
            &left,
            "a",
            20);

    set left =
        set_integer(
            &left,
            "b",
            22);

    let mut right: JsonObject =
        empty();

    set right =
        set_integer(
            &right,
            "b",
            22);

    set right =
        set_integer(
            &right,
            "a",
            20);

    give equals(
               &left,
               &right) &&
         !equals_ordered(
               &left,
               &right);
}

proc test_numeric_equality() -> bool {
    let integer_number:
        JsonObjectValue =
            integer_value(42);

    let float_number:
        JsonObjectValue =
            float_value(42.0);

    give value_equals(
        &integer_number,
        &float_number);
}

proc test_filter() -> bool {
    let mut object: JsonObject =
        empty();

    set object =
        set_integer(
            &object,
            "a",
            20);

    set object =
        set_string(
            &object,
            "name",
            "Vitte");

    set object =
        set_integer(
            &object,
            "b",
            22);

    set object =
        set_bool(
            &object,
            "enabled",
            true);

    let integers: JsonObject =
        only_integers(
            &object);

    give integers.length == 2 &&
         integer_sum(
             &integers) == 42;
}

proc test_compact_nulls() -> bool {
    let mut object: JsonObject =
        empty();

    set object =
        set_null(
            &object,
            "remove");

    set object =
        set_integer(
            &object,
            "answer",
            42);

    let result: JsonObject =
        compact_nulls(
            &object);

    give result.length == 1 &&
         !has(
             &result,
             "remove") &&
         get_integer(
             &result,
             "answer") == 42;
}

proc test_nested_object() -> bool {
    let mut child: JsonObject =
        empty();

    set child =
        set_integer(
            &child,
            "first",
            20);

    set child =
        set_integer(
            &child,
            "second",
            22);

    let mut parent: JsonObject =
        empty();

    set parent =
        set_object(
            &parent,
            "child",
            &child);

    let child_value:
        JsonObjectValue =
            get(
                &parent,
                "child");

    if !value_is_object(
        &child_value) {
        give false;
    }

    let restored: JsonObject =
        nested_object(
            &child_value);

    give restored.length == 2 &&
         integer_sum(
             &restored) == 42;
}

proc test_nested_array() -> bool {
    let mut values_value:
        [JsonObjectValue] =
            [];

    set values_value.push(
        integer_value(20));

    set values_value.push(
        integer_value(22));

    let mut object: JsonObject =
        empty();

    set object =
        set_array(
            &object,
            "values",
            values_value);

    let value: JsonObjectValue =
        get(
            &object,
            "values");

    give value_is_array(
               &value) &&
         value.array_value.length ==
             2 &&
         value.array_value[
             0
         ].integer_value == 20 &&
         value.array_value[
             1
         ].integer_value == 22;
}

proc test_intersection() -> bool {
    let mut left: JsonObject =
        empty();

    set left =
        set_integer(
            &left,
            "a",
            20);

    set left =
        set_integer(
            &left,
            "b",
            22);

    let mut right: JsonObject =
        empty();

    set right =
        set_integer(
            &right,
            "b",
            100);

    set right =
        set_integer(
            &right,
            "c",
            200);

    let result: JsonObject =
        intersection(
            &left,
            &right);

    give result.length == 1 &&
         has(
             &result,
             "b") &&
         get_integer(
             &result,
             "b") == 22;
}

proc test_difference() -> bool {
    let mut left: JsonObject =
        empty();

    set left =
        set_integer(
            &left,
            "a",
            20);

    set left =
        set_integer(
            &left,
            "b",
            22);

    let right: JsonObject =
        set_integer(
            &empty(),
            "a",
            100);

    let result: JsonObject =
        difference(
            &left,
            &right);

    give result.length == 1 &&
         has(
             &result,
             "b") &&
         get_integer(
             &result,
             "b") == 22;
}

proc test_keys_values() -> bool {
    let mut object: JsonObject =
        empty();

    set object =
        set_integer(
            &object,
            "first",
            20);

    set object =
        set_integer(
            &object,
            "second",
            22);

    let object_keys:
        [string] =
            keys(
                &object);

    let object_values:
        [JsonObjectValue] =
            values(
                &object);

    give object_keys.length == 2 &&
         object_values.length == 2 &&
         object_keys[0] ==
             "first" &&
         object_keys[1] ==
             "second" &&
         object_values[
             0
         ].integer_value == 20 &&
         object_values[
             1
         ].integer_value == 22;
}

proc test_first_last() -> bool {
    let mut object: JsonObject =
        empty();

    set object =
        set_integer(
            &object,
            "first",
            20);

    set object =
        set_integer(
            &object,
            "second",
            22);

    let first_result:
        JsonObjectMemberResult =
            first(
                &object);

    let last_result:
        JsonObjectMemberResult =
            last(
                &object);

    give first_result.ok &&
         last_result.ok &&
         first_result.member.key ==
             "first" &&
         first_result.member.value.
             integer_value == 20 &&
         last_result.member.key ==
             "second" &&
         last_result.member.value.
             integer_value == 22;
}

proc test_clone() -> bool {
    let mut object: JsonObject =
        empty();

    set object =
        set_integer(
            &object,
            "first",
            20);

    set object =
        set_integer(
            &object,
            "second",
            22);

    let copied: JsonObject =
        clone(
            &object);

    give equals(
               &object,
               &copied) &&
         equals_ordered(
               &object,
               &copied);
}

proc test_scalar_count() -> bool {
    let mut child: JsonObject =
        empty();

    set child =
        set_integer(
            &child,
            "a",
            20);

    set child =
        set_integer(
            &child,
            "b",
            22);

    let mut parent: JsonObject =
        empty();

    set parent =
        set_object(
            &parent,
            "child",
            &child);

    set parent =
        set_bool(
            &parent,
            "enabled",
            true);

    give scalar_count(
        &parent) == 3;
}

proc test_validation() -> bool {
    let mut object: JsonObject =
        empty();

    set object =
        set_null(
            &object,
            "null");

    set object =
        set_bool(
            &object,
            "bool",
            true);

    set object =
        set_integer(
            &object,
            "integer",
            42);

    set object =
        set_float(
            &object,
            "float",
            42.5);

    set object =
        set_string(
            &object,
            "string",
            "Vitte");

    give validate(
        &object);
}

proc self_test() -> bool {
    give test_empty() &&
         test_insert_integer() &&
         test_insert_all_scalar_types() &&
         test_duplicate_key() &&
         test_set_replaces() &&
         test_remove() &&
         test_rename() &&
         test_order_preserved() &&
         test_merge() &&
         test_merge_preserve_left() &&
         test_equality_order_independent() &&
         test_numeric_equality() &&
         test_filter() &&
         test_compact_nulls() &&
         test_nested_object() &&
         test_nested_array() &&
         test_intersection() &&
         test_difference() &&
         test_keys_values() &&
         test_first_last() &&
         test_clone() &&
         test_scalar_count() &&
         test_validation();
}