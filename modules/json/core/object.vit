/// JSON object core.
///
/// Complete JSON object representation and manipulation layer.
///
/// Goals:
/// - represent ordered JSON object members;
/// - preserve insertion order;
/// - provide safe key lookup;
/// - support insertion, replacement and removal;
/// - support nested objects and arrays;
/// - support structural equality;
/// - expose key/value/member operations;
/// - detect duplicate keys;
/// - provide merge operations;
/// - provide filtering and statistics;
/// - provide validation helpers;
/// - use only Vitte language syntax.
///
/// This module keeps its JSON value representation local.
/// A future json.core.value module can provide the canonical recursive
/// representation shared by arrays, objects, numbers and the parser.

space json::core::object;

const DEFAULT_CAPACITY: usize = 8;
const MINIMUM_CAPACITY: usize = 1;

pick JsonObjectValueKind {
    Null,
    Bool,
    Integer,
    Float,
    String,
    Array,
    Object,
}

pick JsonObjectError {
    None,
    KeyNotFound,
    DuplicateKey,
    EmptyKey,
    IndexOutOfBounds,
    Empty,
    InvalidRange,
    InvalidValue,
    CapacityOverflow,
}

form JsonObjectArrayValue {
    values: [JsonObjectValue],
}

form JsonObjectMember {
    key: string,
    value: JsonObjectValue,
}

form JsonObjectValue {
    kind: JsonObjectValueKind,

    bool_value: bool,

    integer_value: i64,

    float_value: f64,

    string_value: string,

    array_value: [JsonObjectValue],

    object_value: [JsonObjectMember],
}

form JsonObject {
    members: [JsonObjectMember],

    length: usize,

    capacity: usize,
}

form JsonObjectValueResult {
    ok: bool,

    value: JsonObjectValue,

    error: JsonObjectError,

    index: usize,
}

form JsonObjectMemberResult {
    ok: bool,

    member: JsonObjectMember,

    error: JsonObjectError,

    index: usize,
}

form JsonObjectResult {
    ok: bool,

    value: JsonObject,

    error: JsonObjectError,

    index: usize,
}

form JsonObjectIndexResult {
    found: bool,

    index: usize,
}

proc null_value() -> JsonObjectValue {
    give JsonObjectValue {
        kind:
            JsonObjectValueKind.Null,

        bool_value:
            false,

        integer_value:
            0,

        float_value:
            0.0,

        string_value:
            "",

        array_value:
            [],

        object_value:
            [],
    };
}

proc bool_value(
    value: bool
) -> JsonObjectValue {
    give JsonObjectValue {
        kind:
            JsonObjectValueKind.Bool,

        bool_value:
            value,

        integer_value:
            0,

        float_value:
            0.0,

        string_value:
            "",

        array_value:
            [],

        object_value:
            [],
    };
}

proc integer_value(
    value: i64
) -> JsonObjectValue {
    give JsonObjectValue {
        kind:
            JsonObjectValueKind.Integer,

        bool_value:
            false,

        integer_value:
            value,

        float_value:
            0.0,

        string_value:
            "",

        array_value:
            [],

        object_value:
            [],
    };
}

proc float_value(
    value: f64
) -> JsonObjectValue {
    give JsonObjectValue {
        kind:
            JsonObjectValueKind.Float,

        bool_value:
            false,

        integer_value:
            0,

        float_value:
            value,

        string_value:
            "",

        array_value:
            [],

        object_value:
            [],
    };
}

proc string_value(
    value: string
) -> JsonObjectValue {
    give JsonObjectValue {
        kind:
            JsonObjectValueKind.String,

        bool_value:
            false,

        integer_value:
            0,

        float_value:
            0.0,

        string_value:
            value,

        array_value:
            [],

        object_value:
            [],
    };
}

proc array_value(
    values: [JsonObjectValue]
) -> JsonObjectValue {
    give JsonObjectValue {
        kind:
            JsonObjectValueKind.Array,

        bool_value:
            false,

        integer_value:
            0,

        float_value:
            0.0,

        string_value:
            "",

        array_value:
            values,

        object_value:
            [],
    };
}

proc object_value(
    object: &JsonObject
) -> JsonObjectValue {
    give JsonObjectValue {
        kind:
            JsonObjectValueKind.Object,

        bool_value:
            false,

        integer_value:
            0,

        float_value:
            0.0,

        string_value:
            "",

        array_value:
            [],

        object_value:
            object.members,
    };
}

proc member(
    key: string,
    value: JsonObjectValue
) -> JsonObjectMember {
    give JsonObjectMember {
        key: key,
        value: value,
    };
}

proc empty_member() -> JsonObjectMember {
    give JsonObjectMember {
        key: "",
        value: null_value(),
    };
}

proc empty() -> JsonObject {
    give JsonObject {
        members: [],

        length: 0,

        capacity:
            DEFAULT_CAPACITY,
    };
}

proc with_capacity(
    requested: usize
) -> JsonObject {
    let mut actual: usize =
        requested;

    if actual <
       MINIMUM_CAPACITY {
        set actual =
            MINIMUM_CAPACITY;
    }

    give JsonObject {
        members: [],

        length: 0,

        capacity: actual,
    };
}

proc singleton(
    key: string,
    value: JsonObjectValue
) -> JsonObject {
    let mut result: JsonObject =
        with_capacity(1);

    set result.members.push(
        member(
            key,
            value));

    set result.length = 1;

    give result;
}

proc len(
    object: &JsonObject
) -> usize {
    give object.length;
}

proc capacity(
    object: &JsonObject
) -> usize {
    give object.capacity;
}

proc is_empty(
    object: &JsonObject
) -> bool {
    give object.length == 0;
}

proc is_not_empty(
    object: &JsonObject
) -> bool {
    give object.length != 0;
}

proc is_valid_index(
    object: &JsonObject,
    index: usize
) -> bool {
    give index <
         object.length;
}

proc next_capacity(
    current: usize
) -> usize {
    if current <
       MINIMUM_CAPACITY {
        give DEFAULT_CAPACITY;
    }

    give current * 2;
}

proc capacity_for(
    current: usize,
    required: usize
) -> usize {
    let mut result: usize =
        current;

    if result <
       MINIMUM_CAPACITY {
        set result =
            DEFAULT_CAPACITY;
    }

    while result < required {
        set result =
            next_capacity(
                result);
    }

    give result;
}

proc reserve(
    object: &JsonObject,
    required: usize
) -> JsonObject {
    let mut result: JsonObject =
        object;

    if required <=
       result.capacity {
        give result;
    }

    set result.capacity =
        capacity_for(
            result.capacity,
            required);

    give result;
}

proc reserve_additional(
    object: &JsonObject,
    additional: usize
) -> JsonObject {
    give reserve(
        object,
        object.length +
        additional);
}

proc value_is_null(
    value: &JsonObjectValue
) -> bool {
    give value.kind ==
         JsonObjectValueKind.Null;
}

proc value_is_bool(
    value: &JsonObjectValue
) -> bool {
    give value.kind ==
         JsonObjectValueKind.Bool;
}

proc value_is_integer(
    value: &JsonObjectValue
) -> bool {
    give value.kind ==
         JsonObjectValueKind.Integer;
}

proc value_is_float(
    value: &JsonObjectValue
) -> bool {
    give value.kind ==
         JsonObjectValueKind.Float;
}

proc value_is_number(
    value: &JsonObjectValue
) -> bool {
    give value_is_integer(value) ||
         value_is_float(value);
}

proc value_is_string(
    value: &JsonObjectValue
) -> bool {
    give value.kind ==
         JsonObjectValueKind.String;
}

proc value_is_array(
    value: &JsonObjectValue
) -> bool {
    give value.kind ==
         JsonObjectValueKind.Array;
}

proc value_is_object(
    value: &JsonObjectValue
) -> bool {
    give value.kind ==
         JsonObjectValueKind.Object;
}

proc value_as_bool(
    value: &JsonObjectValue
) -> bool {
    give value.bool_value;
}

proc value_as_integer(
    value: &JsonObjectValue
) -> i64 {
    if value_is_integer(value) {
        give value.integer_value;
    }

    if value_is_float(value) {
        give value.float_value
            as i64;
    }

    give 0;
}

proc value_as_float(
    value: &JsonObjectValue
) -> f64 {
    if value_is_float(value) {
        give value.float_value;
    }

    if value_is_integer(value) {
        give value.integer_value
            as f64;
    }

    give 0.0;
}

proc value_as_string(
    value: &JsonObjectValue
) -> string {
    give value.string_value;
}

proc value_copy(
    value: &JsonObjectValue
) -> JsonObjectValue {
    give JsonObjectValue {
        kind:
            value.kind,

        bool_value:
            value.bool_value,

        integer_value:
            value.integer_value,

        float_value:
            value.float_value,

        string_value:
            value.string_value,

        array_value:
            value.array_value,

        object_value:
            value.object_value,
    };
}

proc member_copy(
    value: &JsonObjectMember
) -> JsonObjectMember {
    give JsonObjectMember {
        key:
            value.key,

        value:
            value_copy(
                &value.value),
    };
}

proc array_values_equal(
    left: [JsonObjectValue],
    right: [JsonObjectValue]
) -> bool {
    if left.length !=
       right.length {
        give false;
    }

    let mut index: usize = 0;

    while index <
          left.length {
        let left_value: JsonObjectValue =
            left[index];

        let right_value: JsonObjectValue =
            right[index];

        if !value_equals(
            &left_value,
            &right_value) {
            give false;
        }

        set index += 1;
    }

    give true;
}

proc object_members_equal(
    left: [JsonObjectMember],
    right: [JsonObjectMember]
) -> bool {
    if left.length !=
       right.length {
        give false;
    }

    let mut index: usize = 0;

    while index <
          left.length {
        let left_member: JsonObjectMember =
            left[index];

        let right_member: JsonObjectMember =
            right[index];

        if left_member.key !=
           right_member.key {
            give false;
        }

        if !value_equals(
            &left_member.value,
            &right_member.value) {
            give false;
        }

        set index += 1;
    }

    give true;
}

proc value_equals(
    left: &JsonObjectValue,
    right: &JsonObjectValue
) -> bool {
    if left.kind !=
       right.kind {
        if value_is_number(left) &&
           value_is_number(right) {
            give value_as_float(left) ==
                 value_as_float(right);
        }

        give false;
    }

    if value_is_null(left) {
        give true;
    }

    if value_is_bool(left) {
        give left.bool_value ==
             right.bool_value;
    }

    if value_is_integer(left) {
        give left.integer_value ==
             right.integer_value;
    }

    if value_is_float(left) {
        give left.float_value ==
             right.float_value;
    }

    if value_is_string(left) {
        give left.string_value ==
             right.string_value;
    }

    if value_is_array(left) {
        give array_values_equal(
            left.array_value,
            right.array_value);
    }

    if value_is_object(left) {
        give object_members_equal(
            left.object_value,
            right.object_value);
    }

    give false;
}

proc value_not_equals(
    left: &JsonObjectValue,
    right: &JsonObjectValue
) -> bool {
    give !value_equals(
        left,
        right);
}

proc index_of(
    object: &JsonObject,
    key: string
) -> JsonObjectIndexResult {
    let mut index: usize = 0;

    while index <
          object.length {
        if object.members[index].
               key ==
           key {
            give JsonObjectIndexResult {
                found: true,
                index: index,
            };
        }

        set index += 1;
    }

    give JsonObjectIndexResult {
        found: false,
        index: 0,
    };
}

proc last_index_of(
    object: &JsonObject,
    key: string
) -> JsonObjectIndexResult {
    let mut index: usize =
        object.length;

    while index > 0 {
        set index -= 1;

        if object.members[index].
               key ==
           key {
            give JsonObjectIndexResult {
                found: true,
                index: index,
            };
        }
    }

    give JsonObjectIndexResult {
        found: false,
        index: 0,
    };
}

proc has(
    object: &JsonObject,
    key: string
) -> bool {
    let result: JsonObjectIndexResult =
        index_of(
            object,
            key);

    give result.found;
}

proc contains_key(
    object: &JsonObject,
    key: string
) -> bool {
    give has(
        object,
        key);
}

proc key_count(
    object: &JsonObject,
    key: string
) -> usize {
    let mut result: usize = 0;
    let mut index: usize = 0;

    while index <
          object.length {
        if object.members[index].
               key ==
           key {
            set result += 1;
        }

        set index += 1;
    }

    give result;
}

proc has_duplicate_keys(
    object: &JsonObject
) -> bool {
    let mut index: usize = 0;

    while index <
          object.length {
        if key_count(
               object,
               object.members[index].
                   key) > 1 {
            give true;
        }

        set index += 1;
    }

    give false;
}

proc get(
    object: &JsonObject,
    key: string
) -> JsonObjectValue {
    let result: JsonObjectIndexResult =
        index_of(
            object,
            key);

    if !result.found {
        give null_value();
    }

    give object.members[
        result.index
    ].value;
}

proc get_result(
    object: &JsonObject,
    key: string
) -> JsonObjectValueResult {
    let result: JsonObjectIndexResult =
        index_of(
            object,
            key);

    if !result.found {
        give JsonObjectValueResult {
            ok: false,

            value:
                null_value(),

            error:
                JsonObjectError.KeyNotFound,

            index: 0,
        };
    }

    give JsonObjectValueResult {
        ok: true,

        value:
            object.members[
                result.index
            ].value,

        error:
            JsonObjectError.None,

        index:
            result.index,
    };
}

proc get_at(
    object: &JsonObject,
    index: usize
) -> JsonObjectMemberResult {
    if !is_valid_index(
        object,
        index) {
        give JsonObjectMemberResult {
            ok: false,

            member:
                empty_member(),

            error:
                JsonObjectError.IndexOutOfBounds,

            index: index,
        };
    }

    give JsonObjectMemberResult {
        ok: true,

        member:
            object.members[index],

        error:
            JsonObjectError.None,

        index: index,
    };
}

proc first(
    object: &JsonObject
) -> JsonObjectMemberResult {
    if is_empty(object) {
        give JsonObjectMemberResult {
            ok: false,

            member:
                empty_member(),

            error:
                JsonObjectError.Empty,

            index: 0,
        };
    }

    give JsonObjectMemberResult {
        ok: true,

        member:
            object.members[0],

        error:
            JsonObjectError.None,

        index: 0,
    };
}

proc last(
    object: &JsonObject
) -> JsonObjectMemberResult {
    if is_empty(object) {
        give JsonObjectMemberResult {
            ok: false,

            member:
                empty_member(),

            error:
                JsonObjectError.Empty,

            index: 0,
        };
    }

    let index: usize =
        object.length - 1;

    give JsonObjectMemberResult {
        ok: true,

        member:
            object.members[index],

        error:
            JsonObjectError.None,

        index: index,
    };
}

proc get_bool(
    object: &JsonObject,
    key: string
) -> bool {
    let value: JsonObjectValue =
        get(
            object,
            key);

    give value_as_bool(
        &value);
}

proc get_integer(
    object: &JsonObject,
    key: string
) -> i64 {
    let value: JsonObjectValue =
        get(
            object,
            key);

    give value_as_integer(
        &value);
}

proc get_float(
    object: &JsonObject,
    key: string
) -> f64 {
    let value: JsonObjectValue =
        get(
            object,
            key);

    give value_as_float(
        &value);
}

proc get_string(
    object: &JsonObject,
    key: string
) -> string {
    let value: JsonObjectValue =
        get(
            object,
            key);

    give value_as_string(
        &value);
}

proc insert_member_unchecked(
    object: &JsonObject,
    value: JsonObjectMember
) -> JsonObject {
    let mut result: JsonObject =
        reserve(
            object,
            object.length + 1);

    set result.members.push(
        value);

    set result.length += 1;

    give result;
}

proc insert(
    object: &JsonObject,
    key: string,
    value: JsonObjectValue
) -> JsonObjectResult {
    if key.length == 0 {
        give JsonObjectResult {
            ok: false,

            value: object,

            error:
                JsonObjectError.EmptyKey,

            index: 0,
        };
    }

    let existing:
        JsonObjectIndexResult =
            index_of(
                object,
                key);

    if existing.found {
        give JsonObjectResult {
            ok: false,

            value: object,

            error:
                JsonObjectError.DuplicateKey,

            index:
                existing.index,
        };
    }

    let result: JsonObject =
        insert_member_unchecked(
            object,
            member(
                key,
                value));

    give JsonObjectResult {
        ok: true,

        value: result,

        error:
            JsonObjectError.None,

        index:
            result.length - 1,
    };
}

proc insert_null(
    object: &JsonObject,
    key: string
) -> JsonObjectResult {
    give insert(
        object,
        key,
        null_value());
}

proc insert_bool(
    object: &JsonObject,
    key: string,
    value: bool
) -> JsonObjectResult {
    give insert(
        object,
        key,
        bool_value(value));
}

proc insert_integer(
    object: &JsonObject,
    key: string,
    value: i64
) -> JsonObjectResult {
    give insert(
        object,
        key,
        integer_value(value));
}

proc insert_float(
    object: &JsonObject,
    key: string,
    value: f64
) -> JsonObjectResult {
    give insert(
        object,
        key,
        float_value(value));
}

proc insert_string(
    object: &JsonObject,
    key: string,
    value: string
) -> JsonObjectResult {
    give insert(
        object,
        key,
        string_value(value));
}

proc insert_array(
    object: &JsonObject,
    key: string,
    value: [JsonObjectValue]
) -> JsonObjectResult {
    give insert(
        object,
        key,
        array_value(value));
}

proc insert_object(
    object: &JsonObject,
    key: string,
    value: &JsonObject
) -> JsonObjectResult {
    give insert(
        object,
        key,
        object_value(value));
}

proc set_value(
    object: &JsonObject,
    key: string,
    value: JsonObjectValue
) -> JsonObject {
    let existing:
        JsonObjectIndexResult =
            index_of(
                object,
                key);

    if existing.found {
        let mut result: JsonObject =
            object;

        set result.members[
            existing.index
        ].value = value;

        give result;
    }

    if key.length == 0 {
        give object;
    }

    give insert_member_unchecked(
        object,
        member(
            key,
            value));
}

proc set_null(
    object: &JsonObject,
    key: string
) -> JsonObject {
    give set_value(
        object,
        key,
        null_value());
}

proc set_bool(
    object: &JsonObject,
    key: string,
    value: bool
) -> JsonObject {
    give set_value(
        object,
        key,
        bool_value(value));
}

proc set_integer(
    object: &JsonObject,
    key: string,
    value: i64
) -> JsonObject {
    give set_value(
        object,
        key,
        integer_value(value));
}

proc set_float(
    object: &JsonObject,
    key: string,
    value: f64
) -> JsonObject {
    give set_value(
        object,
        key,
        float_value(value));
}

proc set_string(
    object: &JsonObject,
    key: string,
    value: string
) -> JsonObject {
    give set_value(
        object,
        key,
        string_value(value));
}

proc set_array(
    object: &JsonObject,
    key: string,
    value: [JsonObjectValue]
) -> JsonObject {
    give set_value(
        object,
        key,
        array_value(value));
}

proc set_object(
    object: &JsonObject,
    key: string,
    value: &JsonObject
) -> JsonObject {
    give set_value(
        object,
        key,
        object_value(value));
}

proc replace(
    object: &JsonObject,
    key: string,
    value: JsonObjectValue
) -> JsonObjectResult {
    let existing:
        JsonObjectIndexResult =
            index_of(
                object,
                key);

    if !existing.found {
        give JsonObjectResult {
            ok: false,

            value: object,

            error:
                JsonObjectError.KeyNotFound,

            index: 0,
        };
    }

    let mut result: JsonObject =
        object;

    set result.members[
        existing.index
    ].value = value;

    give JsonObjectResult {
        ok: true,

        value: result,

        error:
            JsonObjectError.None,

        index:
            existing.index,
    };
}

proc rename(
    object: &JsonObject,
    old_key: string,
    new_key: string
) -> JsonObjectResult {
    if new_key.length == 0 {
        give JsonObjectResult {
            ok: false,

            value: object,

            error:
                JsonObjectError.EmptyKey,

            index: 0,
        };
    }

    let old_index:
        JsonObjectIndexResult =
            index_of(
                object,
                old_key);

    if !old_index.found {
        give JsonObjectResult {
            ok: false,

            value: object,

            error:
                JsonObjectError.KeyNotFound,

            index: 0,
        };
    }

    if old_key != new_key {
        let new_index:
            JsonObjectIndexResult =
                index_of(
                    object,
                    new_key);

        if new_index.found {
            give JsonObjectResult {
                ok: false,

                value: object,

                error:
                    JsonObjectError.DuplicateKey,

                index:
                    new_index.index,
            };
        }
    }

    let mut result: JsonObject =
        object;

    set result.members[
        old_index.index
    ].key = new_key;

    give JsonObjectResult {
        ok: true,

        value: result,

        error:
            JsonObjectError.None,

        index:
            old_index.index,
    };
}

proc remove(
    object: &JsonObject,
    key: string
) -> JsonObjectResult {
    let existing:
        JsonObjectIndexResult =
            index_of(
                object,
                key);

    if !existing.found {
        give JsonObjectResult {
            ok: false,

            value: object,

            error:
                JsonObjectError.KeyNotFound,

            index: 0,
        };
    }

    let mut result: JsonObject =
        with_capacity(
            object.capacity);

    let mut index: usize = 0;

    while index <
          object.length {
        if index !=
           existing.index {
            set result =
                insert_member_unchecked(
                    &result,
                    member_copy(
                        &object.members[
                            index
                        ]));
        }

        set index += 1;
    }

    give JsonObjectResult {
        ok: true,

        value: result,

        error:
            JsonObjectError.None,

        index:
            existing.index,
    };
}

proc remove_at(
    object: &JsonObject,
    target: usize
) -> JsonObjectResult {
    if !is_valid_index(
        object,
        target) {
        give JsonObjectResult {
            ok: false,

            value: object,

            error:
                JsonObjectError.IndexOutOfBounds,

            index: target,
        };
    }

    let mut result: JsonObject =
        with_capacity(
            object.capacity);

    let mut index: usize = 0;

    while index <
          object.length {
        if index != target {
            set result =
                insert_member_unchecked(
                    &result,
                    member_copy(
                        &object.members[
                            index
                        ]));
        }

        set index += 1;
    }

    give JsonObjectResult {
        ok: true,

        value: result,

        error:
            JsonObjectError.None,

        index: target,
    };
}

proc remove_first(
    object: &JsonObject
) -> JsonObjectResult {
    if is_empty(object) {
        give JsonObjectResult {
            ok: false,

            value: object,

            error:
                JsonObjectError.Empty,

            index: 0,
        };
    }

    give remove_at(
        object,
        0);
}

proc remove_last(
    object: &JsonObject
) -> JsonObjectResult {
    if is_empty(object) {
        give JsonObjectResult {
            ok: false,

            value: object,

            error:
                JsonObjectError.Empty,

            index: 0,
        };
    }

    give remove_at(
        object,
        object.length - 1);
}

proc clear(
    object: &JsonObject
) -> JsonObject {
    give JsonObject {
        members: [],

        length: 0,

        capacity:
            object.capacity,
    };
}

proc reset() -> JsonObject {
    give empty();
}

proc clone(
    object: &JsonObject
) -> JsonObject {
    let mut result: JsonObject =
        with_capacity(
            object.capacity);

    let mut index: usize = 0;

    while index <
          object.length {
        set result =
            insert_member_unchecked(
                &result,
                member_copy(
                    &object.members[
                        index
                    ]));

        set index += 1;
    }

    give result;
}

proc keys(
    object: &JsonObject
) -> [string] {
    let mut result: [string] =
        [];

    let mut index: usize = 0;

    while index <
          object.length {
        set result.push(
            object.members[
                index
            ].key);

        set index += 1;
    }

    give result;
}

proc values(
    object: &JsonObject
) -> [JsonObjectValue] {
    let mut result:
        [JsonObjectValue] =
            [];

    let mut index: usize = 0;

    while index <
          object.length {
        set result.push(
            value_copy(
                &object.members[
                    index
                ].value));

        set index += 1;
    }

    give result;
}

proc members(
    object: &JsonObject
) -> [JsonObjectMember] {
    let mut result:
        [JsonObjectMember] =
            [];

    let mut index: usize = 0;

    while index <
          object.length {
        set result.push(
            member_copy(
                &object.members[
                    index
                ]));

        set index += 1;
    }

    give result;
}

proc count_kind(
    object: &JsonObject,
    kind: JsonObjectValueKind
) -> usize {
    let mut result: usize = 0;
    let mut index: usize = 0;

    while index <
          object.length {
        if object.members[
               index
           ].value.kind ==
           kind {
            set result += 1;
        }

        set index += 1;
    }

    give result;
}

proc count_null(
    object: &JsonObject
) -> usize {
    give count_kind(
        object,
        JsonObjectValueKind.Null);
}

proc count_bool(
    object: &JsonObject
) -> usize {
    give count_kind(
        object,
        JsonObjectValueKind.Bool);
}

proc count_integer(
    object: &JsonObject
) -> usize {
    give count_kind(
        object,
        JsonObjectValueKind.Integer);
}

proc count_float(
    object: &JsonObject
) -> usize {
    give count_kind(
        object,
        JsonObjectValueKind.Float);
}

proc count_number(
    object: &JsonObject
) -> usize {
    give count_integer(object) +
         count_float(object);
}

proc count_string(
    object: &JsonObject
) -> usize {
    give count_kind(
        object,
        JsonObjectValueKind.String);
}

proc count_array(
    object: &JsonObject
) -> usize {
    give count_kind(
        object,
        JsonObjectValueKind.Array);
}

proc count_object(
    object: &JsonObject
) -> usize {
    give count_kind(
        object,
        JsonObjectValueKind.Object);
}

proc contains_null(
    object: &JsonObject
) -> bool {
    give count_null(object) > 0;
}

proc contains_bool(
    object: &JsonObject
) -> bool {
    give count_bool(object) > 0;
}

proc contains_integer(
    object: &JsonObject
) -> bool {
    give count_integer(object) > 0;
}

proc contains_number(
    object: &JsonObject
) -> bool {
    give count_number(object) > 0;
}

proc contains_string(
    object: &JsonObject
) -> bool {
    give count_string(object) > 0;
}

proc contains_array(
    object: &JsonObject
) -> bool {
    give count_array(object) > 0;
}

proc contains_object(
    object: &JsonObject
) -> bool {
    give count_object(object) > 0;
}

proc contains_value(
    object: &JsonObject,
    value: &JsonObjectValue
) -> bool {
    let mut index: usize = 0;

    while index <
          object.length {
        if value_equals(
            &object.members[
                index
            ].value,
            value) {
            give true;
        }

        set index += 1;
    }

    give false;
}

proc value_count(
    object: &JsonObject,
    value: &JsonObjectValue
) -> usize {
    let mut result: usize = 0;
    let mut index: usize = 0;

    while index <
          object.length {
        if value_equals(
            &object.members[
                index
            ].value,
            value) {
            set result += 1;
        }

        set index += 1;
    }

    give result;
}

proc equals_ordered(
    left: &JsonObject,
    right: &JsonObject
) -> bool {
    if left.length !=
       right.length {
        give false;
    }

    let mut index: usize = 0;

    while index <
          left.length {
        let left_member:
            JsonObjectMember =
                left.members[index];

        let right_member:
            JsonObjectMember =
                right.members[index];

        if left_member.key !=
           right_member.key {
            give false;
        }

        if !value_equals(
            &left_member.value,
            &right_member.value) {
            give false;
        }

        set index += 1;
    }

    give true;
}

proc equals(
    left: &JsonObject,
    right: &JsonObject
) -> bool {
    if left.length !=
       right.length {
        give false;
    }

    let mut index: usize = 0;

    while index <
          left.length {
        let current:
            JsonObjectMember =
                left.members[index];

        let found:
            JsonObjectIndexResult =
                index_of(
                    right,
                    current.key);

        if !found.found {
            give false;
        }

        if !value_equals(
            &current.value,
            &right.members[
                found.index
            ].value) {
            give false;
        }

        set index += 1;
    }

    give true;
}

proc not_equals(
    left: &JsonObject,
    right: &JsonObject
) -> bool {
    give !equals(
        left,
        right);
}

proc merge(
    left: &JsonObject,
    right: &JsonObject
) -> JsonObject {
    let mut result: JsonObject =
        clone(left);

    let mut index: usize = 0;

    while index <
          right.length {
        let current:
            JsonObjectMember =
                right.members[index];

        set result =
            set_value(
                &result,
                current.key,
                value_copy(
                    &current.value));

        set index += 1;
    }

    give result;
}

proc merge_preserve_left(
    left: &JsonObject,
    right: &JsonObject
) -> JsonObject {
    let mut result: JsonObject =
        clone(left);

    let mut index: usize = 0;

    while index <
          right.length {
        let current:
            JsonObjectMember =
                right.members[index];

        if !has(
            &result,
            current.key) {
            set result =
                insert_member_unchecked(
                    &result,
                    member_copy(
                        &current));
        }

        set index += 1;
    }

    give result;
}

proc intersection(
    left: &JsonObject,
    right: &JsonObject
) -> JsonObject {
    let mut result: JsonObject =
        empty();

    let mut index: usize = 0;

    while index <
          left.length {
        let current:
            JsonObjectMember =
                left.members[index];

        if has(
            right,
            current.key) {
            set result =
                insert_member_unchecked(
                    &result,
                    member_copy(
                        &current));
        }

        set index += 1;
    }

    give result;
}

proc difference(
    left: &JsonObject,
    right: &JsonObject
) -> JsonObject {
    let mut result: JsonObject =
        empty();

    let mut index: usize = 0;

    while index <
          left.length {
        let current:
            JsonObjectMember =
                left.members[index];

        if !has(
            right,
            current.key) {
            set result =
                insert_member_unchecked(
                    &result,
                    member_copy(
                        &current));
        }

        set index += 1;
    }

    give result;
}

proc only_nulls(
    object: &JsonObject
) -> JsonObject {
    let mut result: JsonObject =
        empty();

    let mut index: usize = 0;

    while index <
          object.length {
        let current:
            JsonObjectMember =
                object.members[index];

        if value_is_null(
            &current.value) {
            set result =
                insert_member_unchecked(
                    &result,
                    member_copy(
                        &current));
        }

        set index += 1;
    }

    give result;
}

