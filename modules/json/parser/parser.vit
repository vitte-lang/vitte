            test_punctuation(
                JsonTokenKind.Comma,
                ",",
                2,
                3),

            test_punctuation(
                JsonTokenKind.RightBracket,
                "]",
                3,
                4),

            end(
                position(
                    4,
                    0,
                    4)),
        ];

    let result:
        JsonParseResult =
            parse_tokens(tokens);

    assert !result.ok;

    assert result.diagnostic.detail ==
        "trailing comma in JSON array";
}

