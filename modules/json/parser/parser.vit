                3),

            test_punctuation(
                JsonTokenKind.Colon,
                ":",
                3,
                4),

            test_number(
                "1",
                4,
                5),

            test_punctuation(
                JsonTokenKind.RightBrace,
                "}",
                5,
                6),

            end(
                position(
                    6,
                    0,
                    6)),
        ];

    let result:
        JsonParseResult =
            parse_tokens(tokens);

    assert result.ok;

    assert result.value.object_value.length ==
        1;

    assert result.value.object_value[0].key ==
        "";
}

/// -------------------------------------------------------------------------
/// Tests — limits
/// -------------------------------------------------------------------------

test "json parser depth limit" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBracket,
                "[",
                0,
                1),

            test_punctuation(
                JsonTokenKind.LeftBracket,
                "[",
                1,
                2),

            test_punctuation(
                JsonTokenKind.LeftBracket,
                "[",
                2,
                3),

            test_number(
                "1",
                3,
                4),

            test_punctuation(
                JsonTokenKind.RightBracket,
                "]",
                4,
                5),

            test_punctuation(
                JsonTokenKind.RightBracket,
                "]",
                5,
                6),

            test_punctuation(
                JsonTokenKind.RightBracket,
                "]",
                6,
                7),

            end(
                position(
                    7,
                    0,
                    7)),
        ];

    let parser_limits:
        JsonParserLimits =
            limits(
                2,
                100,
                100,
                100,
                1024,
                JsonParserDuplicateKeyPolicy.Allow);

    let result:
        JsonParseResult =
            parse_tokens_with_limits(
                tokens,
                parser_limits);

    assert not result.ok;
}

test "json parser array element limit" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBracket,
                "[",
                0,
                1),

            test_number(
                "1",
                1,
                2),

            test_punctuation(
                JsonTokenKind.Comma,
                ",",
                2,
                3),

            test_number(
                "2",
                3,
                4),

            test_punctuation(
                JsonTokenKind.RightBracket,
                "]",
                4,
                5),

            end(
                position(
                    5,
                    0,
                    5)),
        ];

    let parser_limits:
        JsonParserLimits =
            limits(
                512,
                100,
                1,
                100,
                1024,
                JsonParserDuplicateKeyPolicy.Allow);

    let result:
        JsonParseResult =
            parse_tokens_with_limits(
                tokens,
                parser_limits);

    assert not result.ok;
}

test "json parser object member limit" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBrace,
                "{",
                0,
                1),

            test_string(
                "\"a\"",
