                4),

            test_punctuation(
                JsonTokenKind.RightBracket,
                "]",
                4,
                5),

            end(
                position(
                    5,
                    0,
                    5)),
        ];

    let parser_limits:
        JsonParserLimits =
            limits(
                512,
                100,
                1,
                100,
                1024,
                JsonParserDuplicateKeyPolicy.Allow);

    let result:
        JsonParseResult =
            parse_tokens_with_limits(
                tokens,
                parser_limits);

    assert !result.ok;
}

test "json parser object member limit" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBrace,
                "{",
                0,
                1),

            test_string(
                "\"a\"",
