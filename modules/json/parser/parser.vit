/// -------------------------------------------------------------------------
/// Tests — duplicate keys
/// -------------------------------------------------------------------------

test "json parser allows duplicate object keys by default" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBrace,
                "{",
                0,
                1),

            test_string(
                "\"a\"",
                "a",
                1,
                4),

            test_punctuation(
                JsonTokenKind.Colon,
                ":",
                4,
                5),

            test_number(
                "1",
                5,
                6),

            test_punctuation(
                JsonTokenKind.Comma,
                ",",
                6,
                7),

            test_string(
                "\"a\"",
                "a",
                7,
                10),

            test_punctuation(
                JsonTokenKind.Colon,
                ":",
                10,
                11),

            test_number(
                "2",
                11,
                12),

            test_punctuation(
                JsonTokenKind.RightBrace,
                "}",
                12,
                13),

            end(
                position(
                    13,
                    0,
                    13)),
        ];

    let result:
        JsonParseResult =
            parse_tokens(tokens);

    assert result.ok;

    assert result.value.object_value.length ==
        2;
}

test "json parser strict rejects duplicate object keys" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBrace,
                "{",
                0,
                1),

            test_string(
                "\"a\"",
                "a",
                1,
                4),

            test_punctuation(
                JsonTokenKind.Colon,
                ":",
                4,
                5),

            test_number(
                "1",
                5,
                6),

            test_punctuation(
                JsonTokenKind.Comma,
                ",",
                6,
                7),

            test_string(
                "\"a\"",
                "a",
                7,
                10),

            test_punctuation(
                JsonTokenKind.Colon,
                ":",
                10,
                11),

            test_number(
                "2",
                11,
                12),

            test_punctuation(
                JsonTokenKind.RightBrace,
                "}",
                12,
                13),

            end(
                position(
                    13,
                    0,
                    13)),
        ];

    let result:
        JsonParseResult =
            parse_tokens_strict(
                tokens);

    assert not result.ok;

    assert result.report.detail ==
        "duplicate JSON object member name";
}

