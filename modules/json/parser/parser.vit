    assert !result.ok;
}

/// -------------------------------------------------------------------------
/// Tests — metadata
/// -------------------------------------------------------------------------

test "json parser error names" {
    assert error_name(
        JsonParserError.None) ==
            "none";

    assert error_name(
        JsonParserError.EmptyDocument) ==
            "empty-document";

    assert error_name(
        JsonParserError.TrailingToken) ==
            "trailing-token";

    assert error_name(
        JsonParserError.DepthExceeded) ==
            "depth-exceeded";

    assert error_name(
        JsonParserError.InvalidTokenStream) ==
            "invalid-token-stream";
}

test "json parser error codes" {
    assert error_code(
        JsonParserError.None) ==
            "";

    assert error_code(
        JsonParserError.EmptyDocument) ==
            "JSON-PARSE-001";

    assert error_code(
        JsonParserError.TrailingToken) ==
            "JSON-PARSE-004";

    assert error_code(
        JsonParserError.DepthExceeded) ==
            "JSON-PARSE-054";

    assert error_code(
        JsonParserError.Internal) ==
            "JSON-PARSE-999";
}

test "json parser phase names" {
    assert phase_name(
        JsonParserPhase.None) ==
            "none";

    assert phase_name(
        JsonParserPhase.Document) ==
            "document";

    assert phase_name(
        JsonParserPhase.Value) ==
            "value";

    assert phase_name(
        JsonParserPhase.Array) ==
            "array";

    assert phase_name(
        JsonParserPhase.Object) ==
            "object";
}

/// -------------------------------------------------------------------------
/// Tests — statistics
/// -------------------------------------------------------------------------

test "json parser statistics are coherent" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBracket,
                "[",
                0,
                1),

            test_literal(
                JsonTokenKind.Null,
                "null",
                1,
                5),

            test_punctuation(
                JsonTokenKind.Comma,
                ",",
                5,
                6),

            test_literal(
                JsonTokenKind.True,
                "true",
                6,
                10),

            test_punctuation(
                JsonTokenKind.Comma,
                ",",
                10,
                11),

            test_string(
                "\"Vitte\"",
                "Vitte",
                11,
                18),

            test_punctuation(
                JsonTokenKind.RightBracket,
                "]",
                18,
                19),

            end(
                position(
                    19,
                    0,
                    19)),
        ];

    let result:
        JsonParseResult =
            parse_tokens(tokens);

    assert result.ok;

    assert statistics_valid(
        &result.statistics);

    assert result.statistics.value_count ==
        4;

    assert result.statistics.scalar_count ==
        3;

    assert result.statistics.array_count ==
        1;

    assert result.statistics.null_count ==
        1;

    assert result.statistics.boolean_count ==
        1;

    assert result.statistics.string_count ==
        1;
}

/// -------------------------------------------------------------------------
/// Tests — result validation
/// -------------------------------------------------------------------------

test "json parser successful result validates" {
    let tokens: [JsonToken] =
        [
            test_number(
                "42",
                0,
                2),

            end(
                position(
                    2,
                    0,
                    2)),
        ];

    let result:
        JsonParseResult =
            parse_tokens(tokens);

    assert result.ok;

    assert validate_result(
        &result);

    assert !has_diagnostic(
        &result);
}

test "json parser failed result validates" {
    let tokens: [JsonToken] =
        [
            end(
                position(
                    0,
                    0,
                    0)),
        ];

    let result:
        JsonParseResult =
            parse_tokens(tokens);

    assert !result.ok;

    assert validate_result(
        &result);

    assert has_diagnostic(
        &result);
}
