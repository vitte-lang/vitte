/// -------------------------------------------------------------------------
/// Tests — duplicate keys
/// -------------------------------------------------------------------------

test "json parser allows duplicate object keys by default" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBrace,
                "{",
                0,
                1),

            test_string(
                "\"a\"",
                "a",
                1,
                4),

            test_punctuation(
                JsonTokenKind.Colon,
                ":",
                4,
                5),

            test_number(
                "1",
                5,
                6),

            test_punctuation(
                JsonTokenKind.Comma,
                ",",
                6,
                7),

            test_string(
                "\"a\"",
                "a",
                7,
                10),

            test_punctuation(
                JsonTokenKind.Colon,
                ":",
                10,
                11),

            test_number(
                "2",
                11,
                12),

            test_punctuation(
                JsonTokenKind.RightBrace,
                "}",
                12,
                13),

            end(
                position(
                    13,
                    0,
                    13)),
        ];

    let result:
        JsonParseResult =
            parse_tokens(tokens);

    assert result.ok;

    assert result.value.object_value.length ==
        2;
}

test "json parser strict rejects duplicate object keys" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBrace,
                "{",
                0,
                1),

            test_string(
                "\"a\"",
                "a",
                1,
                4),

            test_punctuation(
                JsonTokenKind.Colon,
                ":",
                4,
                5),

            test_number(
                "1",
                5,
                6),

            test_punctuation(
                JsonTokenKind.Comma,
                ",",
                6,
                7),

            test_string(
                "\"a\"",
                "a",
                7,
                10),

            test_punctuation(
                JsonTokenKind.Colon,
                ":",
                10,
                11),

            test_number(
                "2",
                11,
                12),

            test_punctuation(
                JsonTokenKind.RightBrace,
                "}",
                12,
                13),

            end(
                position(
                    13,
                    0,
                    13)),
        ];

    let result:
        JsonParseResult =
            parse_tokens_strict(
                tokens);

    assert !result.ok;

    assert result.diagnostic.detail ==
        "duplicate JSON object member name";
}

/// -------------------------------------------------------------------------
/// Tests — empty key
/// -------------------------------------------------------------------------

test "json parser accepts empty object key" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBrace,
                "{",
                0,
                1),

            test_string(
                "\"\"",
                "",
                1,
                3),

            test_punctuation(
                JsonTokenKind.Colon,
                ":",
                3,
                4),

            test_number(
                "1",
                4,
                5),

            test_punctuation(
                JsonTokenKind.RightBrace,
                "}",
                5,
                6),

            end(
                position(
                    6,
                    0,
                    6)),
        ];

    let result:
        JsonParseResult =
            parse_tokens(tokens);

    assert result.ok;

    assert result.value.object_value.length ==
        1;

    assert result.value.object_value[0].key ==
        "";
}

/// -------------------------------------------------------------------------
/// Tests — limits
/// -------------------------------------------------------------------------

test "json parser depth limit" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBracket,
                "[",
                0,
                1),

            test_punctuation(
                JsonTokenKind.LeftBracket,
                "[",
                1,
                2),

            test_punctuation(
                JsonTokenKind.LeftBracket,
                "[",
                2,
                3),

            test_number(
                "1",
                3,
                4),

            test_punctuation(
                JsonTokenKind.RightBracket,
                "]",
                4,
                5),

            test_punctuation(
                JsonTokenKind.RightBracket,
                "]",
                5,
                6),

            test_punctuation(
                JsonTokenKind.RightBracket,
                "]",
                6,
                7),

            end(
                position(
                    7,
                    0,
                    7)),
        ];

    let parser_limits:
        JsonParserLimits =
            limits(
                2,
                100,
                100,
                100,
                1024,
                JsonParserDuplicateKeyPolicy.Allow);

    let result:
        JsonParseResult =
            parse_tokens_with_limits(
                tokens,
                parser_limits);

    assert !result.ok;
}

test "json parser array element limit" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBracket,
                "[",
                0,
                1),

            test_number(
