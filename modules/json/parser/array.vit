/// -------------------------------------------------------------------------
/// Tests — commas
/// -------------------------------------------------------------------------

test "json parser array rejects leading comma" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBracket,
                "[",
                0,
                1),

            test_punctuation(
                JsonTokenKind.Comma,
                ",",
                1,
                2),

            test_number(
                "1",
                2,
                3),

            test_punctuation(
                JsonTokenKind.RightBracket,
                "]",
                3,
                4),

            end(
                position(
                    4,
                    0,
                    4)),
        ];

    let result:
        JsonArrayParseResult =
            parse_root(
                tokens,
                0);

    assert !result.ok;

    assert result.diagnostic.error ==
        JsonArrayParseError.ExpectedValue;
}

test "json parser array rejects trailing comma" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBracket,
                "[",
