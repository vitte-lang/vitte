                2),

            test_punctuation(
                JsonTokenKind.Comma,
                ",",
                2,
                3),

            test_punctuation(
                JsonTokenKind.RightBracket,
                "]",
                3,
                4),

            end(
                position(
                    4,
                    0,
                    4)),
        ];

    let result:
        JsonArrayParseResult =
            parse_root(
                tokens,
                0);

    assert !result.ok;

    assert result.diagnostic.error ==
        JsonArrayParseError.TrailingComma;
}

