}

test "json parser array requires comma" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBracket,
                "[",
                0,
                1),

            test_number(
                "1",
                1,
                2),

            test_number(
                "2",
                3,
                4),

            test_punctuation(
                JsonTokenKind.RightBracket,
                "]",
                4,
                5),

            end(
                position(
                    5,
                    0,
                    5)),
        ];

    let result:
        JsonArrayParseResult =
            parse_root(
                tokens,
                0);

    assert !result.ok;

    assert result.diagnostic.error ==
        JsonArrayParseError.ExpectedCommaOrRightBracket;
}

/// -------------------------------------------------------------------------
/// Tests — limits
/// -------------------------------------------------------------------------

test "json parser array element limit" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBracket,
                "[",
                0,
                1),

            test_number(
                "1",
                1,
                2),

            test_punctuation(
                JsonTokenKind.Comma,
                ",",
                2,
                3),

            test_number(
                "2",
                3,
                4),

            test_punctuation(
                JsonTokenKind.RightBracket,
                "]",
                4,
                5),

            end(
                position(
                    5,
                    0,
                    5)),
        ];

    let parser_limits:
        JsonArrayParseLimits =
            limits(
                1,
                512);

    let result:
        JsonArrayParseResult =
            parse_with_limits(
                tokens,
                0,
                0,
                parser_limits);

    assert !result.ok;

    assert result.diagnostic.error ==
        JsonArrayParseError.TooManyElements;
}

test "json parser array depth limit" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBracket,
                "[",
                0,
                1),

            test_punctuation(
                JsonTokenKind.RightBracket,
                "]",
                1,
                2),

            end(
                position(
                    2,
                    0,
                    2)),
        ];

    let parser_limits:
        JsonArrayParseLimits =
            limits(
                100,
                2);

    let result:
        JsonArrayParseResult =
            parse_with_limits(
                tokens,
                0,
                3,
                parser_limits);

    assert !result.ok;

    assert result.diagnostic.error ==
        JsonArrayParseError.DepthExceeded;
}

/// -------------------------------------------------------------------------
/// Tests — structural queries
/// -------------------------------------------------------------------------

test "json parser array empty structural queries" {
    let value: JsonParsedArray =
        empty_parsed_array();

    assert !contains_null(
        &value);

    assert !contains_boolean(
        &value);

    assert !contains_number(
        &value);

    assert !contains_string(
        &value);

    assert !contains_array(
        &value);

    assert !contains_object(
        &value);

    assert !all_null(
        &value);

    assert !all_boolean(
        &value);

    assert !all_number(
        &value);

    assert !all_string(
        &value);

    assert homogeneous(
        &value);
}

/// -------------------------------------------------------------------------
/// Tests — diagnostics
/// -------------------------------------------------------------------------

test "json parser array error names" {
    assert error_name(
        JsonArrayParseError.None) ==
            "none";

    assert error_name(
        JsonArrayParseError.ExpectedLeftBracket) ==
            "expected-left-bracket";

    assert error_name(
        JsonArrayParseError.ExpectedValue) ==
            "expected-value";

    assert error_name(
        JsonArrayParseError.TrailingComma) ==
            "trailing-comma";

    assert error_name(
        JsonArrayParseError.UnterminatedArray) ==
            "unterminated-array";

    assert error_name(
        JsonArrayParseError.TooManyElements) ==
            "too-many-elements";

    assert error_name(
        JsonArrayParseError.DepthExceeded) ==
            "depth-exceeded";
}

/// -------------------------------------------------------------------------
/// Tests — span
/// -------------------------------------------------------------------------

test "json parser array preserves complete span" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBracket,
                "[",
                10,
                11),

            test_punctuation(
                JsonTokenKind.RightBracket,
                "]",
                11,
                12),

            end(
                position(
                    12,
                    0,
                    12)),
        ];

    let result:
        JsonArrayParseResult =
            parse_root(
                tokens,
                0);

    assert result.ok;

    assert result.value.span.start.offset ==
        10;

    assert result.value.span.end.offset ==
        12;

    assert span_length(
        &result.value.span) ==
            2;
}