    let result:
        JsonParsedValue =
            parse(tokens, 0);

    assert !result.ok;

    assert result.diagnostic.error ==
        JsonValueParserError.UnexpectedEnd;
}

test "json value rejects invalid token" {
    let tokens: [JsonToken] =
        [
            invalid(),
        ];

    let result:
        JsonParsedValue =
            parse(tokens, 0);

    assert !result.ok;

    assert result.diagnostic.error ==
        JsonValueParserError.InvalidToken;
}

