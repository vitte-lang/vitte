/// -------------------------------------------------------------------------
/// Tests — duplicate keys
/// -------------------------------------------------------------------------

test "json value allows duplicate keys by default" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBrace,
                "{",
                0,
                1),

            test_string(
                "\"a\"",
                "a",
                1,
                4),

            test_punctuation(
                JsonTokenKind.Colon,
                ":",
                4,
                5),

            test_number(
                "1",
                5,
                6),

            test_punctuation(
                JsonTokenKind.Comma,
                ",",
                6,
                7),

            test_string(
                "\"a\"",
                "a",
                7,
                10),

            test_punctuation(
                JsonTokenKind.Colon,
                ":",
                10,
                11),

            test_number(
                "2",
                11,
                12),

            test_punctuation(
                JsonTokenKind.RightBrace,
                "}",
                12,
                13),

            end(
                test_position(13)),
        ];

    let result:
        JsonParsedValue =
            parse(tokens, 0);

    assert result.ok;

    assert result.value.object_value.length ==
        2;
}

test "json value strict rejects duplicate keys" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBrace,
                "{",
                0,
                1),

            test_string(
                "\"a\"",
                "a",
                1,
                4),

            test_punctuation(
                JsonTokenKind.Colon,
                ":",
                4,
                5),

            test_number(
                "1",
                5,
                6),

            test_punctuation(
                JsonTokenKind.Comma,
                ",",
                6,
                7),

            test_string(
                "\"a\"",
                "a",
                7,
                10),

            test_punctuation(
                JsonTokenKind.Colon,
                ":",
                10,
                11),

            test_number(
                "2",
                11,
                12),

            test_punctuation(
                JsonTokenKind.RightBrace,
                "}",
                12,
                13),

            end(
                test_position(13)),
        ];

    let result:
        JsonParsedValue =
            parse_strict(
                tokens,
                0);

    assert !result.ok;

    assert result.diagnostic.error ==
        JsonValueParserError.DuplicateObjectKey;
}

/// -------------------------------------------------------------------------
/// Tests — limits
/// -------------------------------------------------------------------------

test "json value enforces depth limit" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBracket,
                "[",
                0,
                1),

            test_punctuation(
                JsonTokenKind.LeftBracket,
                "[",
                1,
                2),

            test_number(
                "1",
                2,
                3),

            test_punctuation(
                JsonTokenKind.RightBracket,
                "]",
                3,
                4),

            test_punctuation(
                JsonTokenKind.RightBracket,
                "]",
                4,
                5),

            end(
                test_position(5)),
        ];

    let parser_limits:
        JsonValueParserLimits =
            limits(
                1,
                100,
                100,
                100,
                1024,
                JsonValueDuplicateKeyPolicy.Allow);

    let result:
        JsonParsedValue =
            parse_with_limits(
                tokens,
                0,
                parser_limits);

    assert !result.ok;

    assert result.diagnostic.error ==
        JsonValueParserError.DepthExceeded;
}

test "json value enforces array element limit" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBracket,
                "[",
                0,
                1),

            test_number(
                "1",
                1,
                2),

            test_punctuation(
                JsonTokenKind.Comma,
                ",",
                2,
                3),

            test_number(
                "2",
                3,
                4),

            test_punctuation(
                JsonTokenKind.RightBracket,
                "]",
                4,
                5),

            end(
                test_position(5)),
        ];

    let parser_limits:
        JsonValueParserLimits =
            limits(
                512,
                100,
                1,
                100,
                1024,
                JsonValueDuplicateKeyPolicy.Allow);

    let result:
        JsonParsedValue =
            parse_with_limits(
                tokens,
                0,
                parser_limits);

    assert !result.ok;

    assert result.diagnostic.error ==
        JsonValueParserError.ArrayElementLimitExceeded;
}

test "json value enforces object member limit" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBrace,
                "{",
                0,
                1),

            test_string(
                "\"a\"",
                "a",
                1,
                4),

            test_punctuation(
                JsonTokenKind.Colon,
                ":",
                4,
                5),

            test_number(
                "1",
                5,
                6),

            test_punctuation(
                JsonTokenKind.Comma,
                ",",
                6,
                7),

            test_string(
                "\"b\"",
                "b",
                7,
                10),

            test_punctuation(
                JsonTokenKind.Colon,
                ":",
                10,
                11),

            test_number(
                "2",
                11,
                12),

            test_punctuation(
                JsonTokenKind.RightBrace,
                "}",
                12,
                13),

            end(
                test_position(13)),
        ];

    let parser_limits:
        JsonValueParserLimits =
            limits(
                512,
                100,
                100,
                1,
                1024,
                JsonValueDuplicateKeyPolicy.Allow);

    let result:
        JsonParsedValue =
            parse_with_limits(
                tokens,
                0,
                parser_limits);

    assert !result.ok;

    assert result.diagnostic.error ==
        JsonValueParserError.ObjectMemberLimitExceeded;
}

/// -------------------------------------------------------------------------
/// Tests — metadata
/// -------------------------------------------------------------------------

test "json value parser error names" {
    assert error_name(
        JsonValueParserError.None) ==
            "none";

    assert error_name(
        JsonValueParserError.ExpectedValue) ==
            "expected-value";

    assert error_name(
        JsonValueParserError.ArrayTrailingComma) ==
            "array-trailing-comma";

    assert error_name(
        JsonValueParserError.DuplicateObjectKey) ==
            "duplicate-object-key";

    assert error_name(
        JsonValueParserError.DepthExceeded) ==
            "depth-exceeded";
}

test "json value parser error codes" {
    assert error_code(
        JsonValueParserError.None) ==
            "";

    assert error_code(
        JsonValueParserError.UnexpectedEnd) ==
            "JSON-VALUE-001";

    assert error_code(
        JsonValueParserError.ArrayTrailingComma) ==
            "JSON-VALUE-022";

    assert error_code(
        JsonValueParserError.DuplicateObjectKey) ==
            "JSON-VALUE-036";

    assert error_code(
        JsonValueParserError.Internal) ==
            "JSON-VALUE-999";
}

test "json value parser statistics validate" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBracket,
                "[",
                0,
                1),

            test_literal(
                JsonTokenKind.Null,
                "null",
                1,
                5),

            test_punctuation(
                JsonTokenKind.Comma,
                ",",
                5,
                6),

            test_number(
                "42",
                6,
                8),

            test_punctuation(
                JsonTokenKind.RightBracket,
                "]",
                8,
                9),

            end(
                test_position(9)),
        ];

    let result:
        JsonParsedValue =
            parse(tokens, 0);

    assert result.ok;

    assert statistics_valid(
        &result.statistics);

    assert result.statistics.values ==
        3;

    assert result.statistics.scalar_values ==
        2;

    assert result.statistics.array_values ==
        1;
}

test "json value successful result validates" {
    let tokens: [JsonToken] =
        [
            test_number(
                "42",
                0,
                2),

            end(
                test_position(2)),
        ];

    let result:
        JsonParsedValue =
            parse(tokens, 0);

    assert result.ok;
    assert result_valid(&result);
    assert !has_diagnostic(&result);
}

test "json value failed result validates" {
    let tokens: [JsonToken] =
        [
            end(
                test_position(0)),
        ];

    let result:
        JsonParsedValue =
            parse(tokens, 0);

    assert !result.ok;
    assert result_valid(&result);
    assert has_diagnostic(&result);
}