/// -------------------------------------------------------------------------
/// Tests — duplicate keys
/// -------------------------------------------------------------------------

test "json parser object allows duplicate keys by default" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBrace,
                "{",
                0,
                1),

            test_string(
                "\"a\"",
                "a",
                1,
                4),

            test_punctuation(
                JsonTokenKind.Colon,
                ":",
                4,
                5),

            test_number(
                "1",
                5,
                6),

            test_punctuation(
                JsonTokenKind.Comma,
                ",",
                6,
                7),

            test_string(
                "\"a\"",
                "a",
                7,
                10),

            test_punctuation(
                JsonTokenKind.Colon,
                ":",
                10,
                11),

            test_number(
                "2",
                11,
                12),

            test_punctuation(
                JsonTokenKind.RightBrace,
                "}",
                12,
                13),

            end(
                position(
                    13,
                    0,
                    13)),
        ];

    let result:
        JsonObjectParseResult =
            parse_root(
                tokens,
                0);

    assert result.ok;

    assert result.value.member_count ==
        2;

    assert has_duplicate_keys(
        &result.value);

    assert duplicate_key_count(
        &result.value) == 1;

    assert count_key(
        &result.value,
        "a") == 2;
}

test "json parser object strict rejects duplicate keys" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBrace,
                "{",
                0,
                1),

            test_string(
                "\"a\"",
                "a",
                1,
                4),

            test_punctuation(
                JsonTokenKind.Colon,
                ":",
                4,
                5),

            test_number(
                "1",
                5,
                6),

            test_punctuation(
                JsonTokenKind.Comma,
                ",",
                6,
                7),

            test_string(
                "\"a\"",
                "a",
                7,
                10),

            test_punctuation(
                JsonTokenKind.Colon,
                ":",
                10,
                11),

            test_number(
                "2",
                11,
                12),

            test_punctuation(
                JsonTokenKind.RightBrace,
                "}",
                12,
                13),

            end(
                position(
                    13,
                    0,
                    13)),
        ];

    let result:
        JsonObjectParseResult =
            parse_strict(
                tokens,
                0,
                0);

    assert !result.ok;

    assert result.diagnostic.error ==
        JsonObjectParseError.DuplicateKey;

    assert result.diagnostic.key ==
        "a";

    assert result.diagnostic.has_related_span;
}

/// -------------------------------------------------------------------------
/// Tests — limits
/// -------------------------------------------------------------------------

test "json parser object member limit" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBrace,
                "{",
                0,
                1),

            test_string(
                "\"a\"",
                "a",
                1,
                4),

            test_punctuation(
                JsonTokenKind.Colon,
                ":",
                4,
                5),

            test_number(
                "1",
                5,
                6),

            test_punctuation(
                JsonTokenKind.Comma,
                ",",
                6,
                7),

            test_string(
                "\"b\"",
                "b",
                7,
                10),

            test_punctuation(
                JsonTokenKind.Colon,
                ":",
                10,
                11),

            test_number(
                "2",
                11,
                12),

            test_punctuation(
                JsonTokenKind.RightBrace,
                "}",
                12,
                13),

            end(
                position(
                    13,
                    0,
                    13)),
        ];

    let parser_limits:
        JsonObjectParseLimits =
            limits(
                1,
                512,
                1024,
                JsonDuplicateKeyPolicy.Allow);

    let result:
        JsonObjectParseResult =
            parse_with_limits(
                tokens,
                0,
                0,
                parser_limits);

    assert !result.ok;

    assert result.diagnostic.error ==
        JsonObjectParseError.TooManyMembers;
}

test "json parser object key length limit" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBrace,
                "{",
                0,
                1),

            test_string(
                "\"Vitte\"",
                "Vitte",
                1,
                8),

            test_punctuation(
                JsonTokenKind.Colon,
                ":",
                8,
                9),

            test_number(
                "1",
                9,
                10),

            test_punctuation(
                JsonTokenKind.RightBrace,
                "}",
                10,
                11),

            end(
                position(
                    11,
                    0,
                    11)),
        ];

    let parser_limits:
        JsonObjectParseLimits =
            limits(
                100,
                512,
                4,
                JsonDuplicateKeyPolicy.Allow);

    let result:
        JsonObjectParseResult =
            parse_with_limits(
                tokens,
                0,
                0,
                parser_limits);

    assert !result.ok;

    assert result.diagnostic.error ==
        JsonObjectParseError.KeyTooLong;
}

test "json parser object depth limit" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBrace,
                "{",
                0,
                1),

            test_punctuation(
                JsonTokenKind.RightBrace,
                "}",
                1,
                2),

            end(
                position(
                    2,
                    0,
                    2)),
        ];

    let parser_limits:
        JsonObjectParseLimits =
            limits(
                100,
                2,
                1024,
                JsonDuplicateKeyPolicy.Allow);

    let result:
        JsonObjectParseResult =
            parse_with_limits(
                tokens,
                0,
                3,
                parser_limits);

    assert !result.ok;

    assert result.diagnostic.error ==
        JsonObjectParseError.DepthExceeded;
}

/// -------------------------------------------------------------------------
/// Tests — key queries
/// -------------------------------------------------------------------------

test "json parser object empty key queries" {
    let value:
        JsonParsedObject =
            empty_parsed_object();

    assert !has_key(
        &value,
        "missing");

    assert first_key(
        &value) == "";

    assert last_key(
        &value) == "";

    assert !contains_empty_key(
        &value);

    assert maximum_key_length(
        &value) == 0;

    assert homogeneous_values(
        &value);
}

/// -------------------------------------------------------------------------
/// Tests — error names
/// -------------------------------------------------------------------------

test "json parser object error names" {
    assert error_name(
        JsonObjectParseError.None) ==
            "none";

    assert error_name(
        JsonObjectParseError.ExpectedLeftBrace) ==
            "expected-left-brace";

    assert error_name(
        JsonObjectParseError.ExpectedMemberName) ==
            "expected-member-name";

    assert error_name(
        JsonObjectParseError.ExpectedColon) ==
            "expected-colon";

    assert error_name(
        JsonObjectParseError.ExpectedValue) ==
            "expected-value";

    assert error_name(
        JsonObjectParseError.TrailingComma) ==
            "trailing-comma";

    assert error_name(
        JsonObjectParseError.DuplicateKey) ==
            "duplicate-key";

    assert error_name(
        JsonObjectParseError.UnterminatedObject) ==
            "unterminated-object";

    assert error_name(
        JsonObjectParseError.TooManyMembers) ==
            "too-many-members";

    assert error_name(
        JsonObjectParseError.DepthExceeded) ==
            "depth-exceeded";
}

/// -------------------------------------------------------------------------
/// Tests — complete span
/// -------------------------------------------------------------------------

test "json parser object preserves complete span" {
    let tokens: [JsonToken] =
        [
            test_punctuation(
                JsonTokenKind.LeftBrace,
                "{",
                10,
                11),

            test_punctuation(
                JsonTokenKind.RightBrace,
                "}",
                11,
                12),

            end(
                position(
                    12,
                    0,
                    12)),
        ];

    let result:
        JsonObjectParseResult =
            parse_root(
                tokens,
                0);

    assert result.ok;

    assert result.value.span.start.offset ==
        10;

    assert result.value.span.end.offset ==
        12;

    assert span_length(
        &result.value.span) ==
            2;
}