}

/// -------------------------------------------------------------------------
/// Determinism
/// -------------------------------------------------------------------------

test "numeric scan deterministic valid" {
    let first: JsonNumericScan =
        scan("-123.456e-78");

    let second: JsonNumericScan =
        scan("-123.456e-78");

    assert first.ok == second.ok;
    assert first.kind == second.kind;
    assert first.error == second.error;
    assert first.error_index == second.error_index;
    assert first.negative == second.negative;

    assert first.integer_begin ==
        second.integer_begin;

    assert first.integer_end ==
        second.integer_end;

    assert first.fraction_begin ==
        second.fraction_begin;

    assert first.fraction_end ==
        second.fraction_end;

    assert first.exponent_begin ==
        second.exponent_begin;

    assert first.exponent_end ==
        second.exponent_end;

    assert first.integer_digits ==
        second.integer_digits;

    assert first.fraction_digits ==
        second.fraction_digits;

    assert first.exponent_digits ==
        second.exponent_digits;
}

test "numeric scan deterministic invalid" {
    let first: JsonNumericScan =
        scan("01");

    let second: JsonNumericScan =
        scan("01");

    assert !first.ok;
    assert !second.ok;

    assert first.error ==
        second.error;

    assert first.error_index ==
        second.error_index;
}

test "numeric integer parse deterministic" {
    let first: JsonI64Result =
        parse_i64("-123456789");

    let second: JsonI64Result =
        parse_i64("-123456789");

    assert first.ok == second.ok;
    assert first.value == second.value;
    assert first.error == second.error;
}

test "numeric unsigned parse deterministic" {
    let first: JsonU64Result =
        parse_u64("123456789");

    let second: JsonU64Result =
        parse_u64("123456789");

    assert first.ok == second.ok;
    assert first.value == second.value;
    assert first.error == second.error;
}

test "numeric float parse deterministic" {
    let first: JsonF64Result =
        parse_f64("123.5");

    let second: JsonF64Result =
        parse_f64("123.5");

    assert first.ok == second.ok;
    assert first.value == second.value;
    assert first.error == second.error;
}

/// -------------------------------------------------------------------------
/// Round-trip tests
/// -------------------------------------------------------------------------

test "numeric i64 format parse roundtrip zero" {
    let text: string =
        format_i64(0);

    let result: JsonI64Result =
        parse_i64(text);

    assert result.ok;
    assert result.value == 0;
}

test "numeric i64 format parse roundtrip positive" {
    let text: string =
        format_i64(123456789);

    let result: JsonI64Result =
        parse_i64(text);

    assert result.ok;
    assert result.value == 123456789;
}

test "numeric i64 format parse roundtrip negative" {
    let text: string =
        format_i64(-123456789);

    let result: JsonI64Result =
        parse_i64(text);

    assert result.ok;
    assert result.value == -123456789;
}

test "numeric i64 format parse roundtrip maximum" {
    let text: string =
        format_i64(
            JSON_NUMERIC_I64_MAX);

    let result: JsonI64Result =
        parse_i64(text);

    assert result.ok;

    assert result.value ==
        JSON_NUMERIC_I64_MAX;
}

test "numeric i64 format parse roundtrip minimum" {
    let text: string =
        format_i64(
            JSON_NUMERIC_I64_MIN);

    let result: JsonI64Result =
        parse_i64(text);

    assert result.ok;

    assert result.value ==
        JSON_NUMERIC_I64_MIN;
}

test "numeric u64 format parse roundtrip maximum" {
    let text: string =
        format_u64(
            JSON_NUMERIC_U64_MAX);

    let result: JsonU64Result =
        parse_u64(text);

    assert result.ok;

    assert result.value ==
        JSON_NUMERIC_U64_MAX;
}

/// -------------------------------------------------------------------------
/// JSON-specific regression cases
/// -------------------------------------------------------------------------

test "numeric json regression leading zero" {
    assert valid("0");
    assert valid("0.0");
    assert valid("0e1");

    assert !valid("00");
    assert !valid("01");
    assert !valid("-01");
}

test "numeric json regression decimal requires digit" {
    assert valid("1.0");

    assert !valid("1.");
    assert !valid(".1");
}

test "numeric json regression exponent requires digit" {
    assert valid("1e0");
    assert valid("1e+0");
    assert valid("1e-0");

    assert !valid("1e");
    assert !valid("1e+");
    assert !valid("1e-");
}

test "numeric json regression no leading plus" {
    assert valid("1");
    assert valid("-1");

    assert !valid("+1");
}

test "numeric json regression no non decimal syntax" {
    assert !valid("0xFF");
    assert !valid("0b1010");
    assert !valid("0o77");
    assert !valid("1_000");
}

test "numeric json regression whitespace belongs to lexer not number" {
    assert !valid(" 1");
    assert !valid("1 ");
    assert !valid("\t1");
    assert !valid("1\t");
    assert !valid("\n1");
    assert !valid("1\n");
}

/// -------------------------------------------------------------------------
/// Stress-style lexical cases
/// -------------------------------------------------------------------------

test "numeric long valid integer lexical scan" {
    let source: string =
        "12345678901234567890123456789012345678901234567890";

    let result: JsonNumericScan =
        scan(source);

    assert result.ok;
    assert result.kind == JsonNumericKind.Integer;
    assert result.integer_digits == 50;
}

test "numeric long valid fraction lexical scan" {
    let source: string =
        "0.12345678901234567890123456789012345678901234567890";

    let result: JsonNumericScan =
        scan(source);

    assert result.ok;
    assert result.kind == JsonNumericKind.Float;
    assert result.fraction_digits == 50;
}

test "numeric long exponent lexical scan" {
    let source: string =
        "1e12345678901234567890";

    let result: JsonNumericScan =
        scan(source);

    assert result.ok;
    assert result.has_exponent;
    assert result.exponent_digits == 20;
}

test "numeric long integer conversion reports overflow" {
    let result: JsonI64Result =
        parse_i64(
            "99999999999999999999999999999999999999999999999999");

    assert !result.ok;

    assert result.error ==
        JsonNumericError.IntegerOverflow;
}

test "numeric long unsigned conversion reports overflow" {
    let result: JsonU64Result =
        parse_u64(
            "99999999999999999999999999999999999999999999999999");

    assert !result.ok;

    assert result.error ==
        JsonNumericError.UnsignedOverflow;
}

/// -------------------------------------------------------------------------
/// Boundary adjacency
/// -------------------------------------------------------------------------

test "numeric i64 near positive boundary" {
    let before: JsonI64Result =
        parse_i64(
            "9223372036854775806");

    let exact: JsonI64Result =
        parse_i64(
            "9223372036854775807");

    let after: JsonI64Result =
        parse_i64(
            "9223372036854775808");

    assert before.ok;
    assert exact.ok;
    assert !after.ok;

    assert before.value ==
        9223372036854775806;

    assert exact.value ==
        JSON_NUMERIC_I64_MAX;
}

test "numeric i64 near negative boundary" {
    let before: JsonI64Result =
        parse_i64(
            "-9223372036854775807");

    let exact: JsonI64Result =
        parse_i64(
            "-9223372036854775808");

    let after: JsonI64Result =
        parse_i64(
            "-9223372036854775809");

    assert before.ok;
    assert exact.ok;
    assert !after.ok;

    assert before.value ==
        -9223372036854775807;

    assert exact.value ==
        JSON_NUMERIC_I64_MIN;
}

test "numeric u64 near upper boundary" {
    let before: JsonU64Result =
        parse_u64(
            "18446744073709551614");

    let exact: JsonU64Result =
        parse_u64(
            "18446744073709551615");

    let after: JsonU64Result =
        parse_u64(
            "18446744073709551616");

    assert before.ok;
    assert exact.ok;
    assert !after.ok;

    assert before.value ==
        18446744073709551614;

    assert exact.value ==
        JSON_NUMERIC_U64_MAX;
}

/// -------------------------------------------------------------------------
/// Complete smoke test
/// -------------------------------------------------------------------------

test "numeric runtime complete smoke test" {
    assert valid("-123.456e+7");

    assert classify("-123.456e+7") ==
        JsonNumericKind.Float;

    assert integer_digit_count(
        "-123.456e+7") ==
        3;

    assert fraction_digit_count(
        "-123.456e+7") ==
        3;

    assert exponent_digit_count(
        "-123.456e+7") ==
        1;

    let signed_value: JsonI64Result =
        parse_i64("-42");

    assert signed_value.ok;
    assert signed_value.value == -42;

    let unsigned_value: JsonU64Result =
        parse_u64("42");

    assert unsigned_value.ok;
    assert unsigned_value.value == 42;

    let float_value: JsonF64Result =
        parse_f64("4.2e1");

    assert float_value.ok;
    assert float_value.value == 42.0;

    let arithmetic: JsonI64Result =
        checked_mul_i64(6, 7);

    assert arithmetic.ok;
    assert arithmetic.value == 42;

    assert format_i64(-42) == "-42";
    assert format_u64(42) == "42";

    assert literal_is_zero("-0.000e100");
    assert literal_is_negative_zero("-0.000e100");

    assert fits_i64(
        "9223372036854775807");

    assert fits_u64(
        "18446744073709551615");

    assert error_name(
        JsonNumericError.IntegerOverflow) ==
        "integer-overflow";
}