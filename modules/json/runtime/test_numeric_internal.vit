}

test "numeric kind names" {
    assert kind_name(
        JsonNumericKind.Invalid) ==
        "invalid";

    assert kind_name(
        JsonNumericKind.Integer) ==
        "integer";

    assert kind_name(
        JsonNumericKind.Float) ==
        "float";
}

test "numeric class names" {
    assert class_name(
        JsonNumericClass.Invalid) ==
        "invalid";

    assert class_name(
        JsonNumericClass.Zero) ==
        "zero";

    assert class_name(
        JsonNumericClass.Positive) ==
        "positive";

    assert class_name(
        JsonNumericClass.Negative) ==
