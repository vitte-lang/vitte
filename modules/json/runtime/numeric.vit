/// JSON numeric runtime.
///
/// Low-level numeric support shared by the JSON lexer, parser,
/// value layer, decoder and encoder.
///
/// This module deliberately separates:
///
/// - lexical JSON number validation
/// - integer conversion
/// - floating-point conversion
/// - checked integer arithmetic
/// - decimal exponent handling
/// - numeric classification
/// - finite/range checks
/// - canonical JSON number formatting helpers
///
/// JSON numeric grammar:
///
///     number = [ "-" ] int [ frac ] [ exp ]
///     int    = "0" | digit1-9 *digit
///     frac   = "." 1*digit
///     exp    = ("e" | "E") ["-" | "+"] 1*digit
///
/// Leading `+` is forbidden.
/// Leading zeroes are forbidden except for zero itself.
/// NaN and infinities are not valid JSON numbers.

space json::runtime::numeric;

const JSON_NUMERIC_DECIMAL_BASE: u64 = 10;

const JSON_NUMERIC_MAX_EXPONENT_ABS: i64 = 100000;

const JSON_NUMERIC_MAX_FORMAT_FRACTION_DIGITS: usize = 17;

const JSON_NUMERIC_DEFAULT_FORMAT_FRACTION_DIGITS: usize = 17;

export const JSON_NUMERIC_I64_MAX: i64 = 9223372036854775807;

export const JSON_NUMERIC_I64_MIN: i64 =
    -9223372036854775807 - 1;

const JSON_NUMERIC_U64_MAX: u64 =
    (9223372036854775807 as u64) *
    2 +
    1;

export pick JsonNumericKind {
    Invalid,
    Integer,
    Float,
}

export pick JsonNumericError {
    None,

    Empty,

    InvalidCharacter,
    InvalidSign,
    InvalidInteger,
    InvalidFraction,
    InvalidExponent,

    LeadingPlus,
    LeadingZero,

    MissingIntegerDigits,
    MissingFractionDigits,
    MissingExponentDigits,

    IntegerOverflow,
    IntegerUnderflow,
    UnsignedOverflow,
    NegativeUnsigned,

    FloatOverflow,
    FloatUnderflow,
    NonFinite,

    DivisionByZero,
    RemainderByZero,

    ExponentTooLarge,

    InvalidPrecision,

    Internal,
}

pick JsonNumericClass {
    Invalid,

    Zero,
    Positive,
    Negative,
}

export form JsonNumericScan {
    ok: bool,

    kind: JsonNumericKind,

    error: JsonNumericError,

    error_index: usize,

    negative: bool,

    integer_begin: usize,
    integer_end: usize,

    fraction_begin: usize,
    fraction_end: usize,

    exponent_begin: usize,
    exponent_end: usize,

    exponent_negative: bool,

    integer_digits: usize,
    fraction_digits: usize,
    exponent_digits: usize,

    has_fraction: bool,
    has_exponent: bool,
}

form JsonI64Result {
    ok: bool,

    value: i64,

    error: JsonNumericError,

    error_index: usize,
}

form JsonU64Result {
    ok: bool,

    value: u64,

    error: JsonNumericError,

    error_index: usize,
}

form JsonF64Result {
    ok: bool,

    value: f64,

    error: JsonNumericError,

    error_index: usize,
}

form JsonNumericComparison {
    comparable: bool,

    less: bool,
    equal: bool,
    greater: bool,
}

form JsonNumericFormatOptions {
    fraction_digits: usize,

    trim_fraction_zeroes: bool,

    preserve_negative_zero: bool,

    force_decimal_point: bool,

    uppercase_exponent: bool,
}

form JsonNumericFormatResult {
    ok: bool,

    text: string,

    error: JsonNumericError,
}

/// -------------------------------------------------------------------------
/// Error metadata
/// -------------------------------------------------------------------------

proc error_name(
    error: JsonNumericError
) -> string {
    if error == JsonNumericError.None {
        give "none";
    }

    if error == JsonNumericError.Empty {
        give "empty";
    }

    if error == JsonNumericError.InvalidCharacter {
        give "invalid-character";
    }

    if error == JsonNumericError.InvalidSign {
        give "invalid-sign";
    }

    if error == JsonNumericError.InvalidInteger {
        give "invalid-integer";
    }

    if error == JsonNumericError.InvalidFraction {
        give "invalid-fraction";
    }

    if error == JsonNumericError.InvalidExponent {
        give "invalid-exponent";
    }

    if error == JsonNumericError.LeadingPlus {
        give "leading-plus";
    }

    if error == JsonNumericError.LeadingZero {
        give "leading-zero";
    }

    if error == JsonNumericError.MissingIntegerDigits {
        give "missing-integer-digits";
    }

    if error == JsonNumericError.MissingFractionDigits {
        give "missing-fraction-digits";
    }

    if error == JsonNumericError.MissingExponentDigits {
        give "missing-exponent-digits";
    }

    if error == JsonNumericError.IntegerOverflow {
        give "integer-overflow";
    }

    if error == JsonNumericError.IntegerUnderflow {
        give "integer-underflow";
    }

    if error == JsonNumericError.UnsignedOverflow {
        give "unsigned-overflow";
    }

    if error == JsonNumericError.NegativeUnsigned {
        give "negative-unsigned";
    }

    if error == JsonNumericError.FloatOverflow {
        give "float-overflow";
    }

    if error == JsonNumericError.FloatUnderflow {
        give "float-underflow";
    }

    if error == JsonNumericError.NonFinite {
        give "non-finite";
    }

    if error == JsonNumericError.DivisionByZero {
        give "division-by-zero";
    }

    if error == JsonNumericError.RemainderByZero {
        give "remainder-by-zero";
    }

    if error == JsonNumericError.ExponentTooLarge {
        give "exponent-too-large";
    }

    if error == JsonNumericError.InvalidPrecision {
        give "invalid-precision";
    }

    give "internal";
}

proc kind_name(
    kind: JsonNumericKind
) -> string {
    if kind == JsonNumericKind.Invalid {
        give "invalid";
    }

    if kind == JsonNumericKind.Integer {
        give "integer";
    }

    give "float";
}

proc class_name(
    class_value: JsonNumericClass
) -> string {
    if class_value == JsonNumericClass.Invalid {
        give "invalid";
    }

    if class_value == JsonNumericClass.Zero {
        give "zero";
    }

    if class_value == JsonNumericClass.Positive {
        give "positive";
    }

    give "negative";
}

/// -------------------------------------------------------------------------
/// ASCII decimal helpers
/// -------------------------------------------------------------------------

proc is_digit(
    value: char
) -> bool {
    give value >= '0' &&
         value <= '9';
}

proc is_nonzero_digit(
    value: char
) -> bool {
    give value >= '1' &&
         value <= '9';
}

proc is_sign(
    value: char
) -> bool {
    give value == '-' ||
         value == '+';
}

proc is_exponent_marker(
    value: char
) -> bool {
    give value == 'e' ||
         value == 'E';
}

proc digit_value(
    value: char
) -> u64 {
    if value == '0' {
        give 0;
    }

    if value == '1' {
        give 1;
    }

    if value == '2' {
        give 2;
    }

    if value == '3' {
        give 3;
    }

    if value == '4' {
        give 4;
    }

    if value == '5' {
        give 5;
    }

    if value == '6' {
        give 6;
    }

    if value == '7' {
        give 7;
    }

    if value == '8' {
        give 8;
    }

    if value == '9' {
        give 9;
    }

    give 0;
}

proc digit_char(
    value: u64
) -> char {
    if value == 0 {
        give '0';
    }

    if value == 1 {
        give '1';
    }

    if value == 2 {
        give '2';
    }

    if value == 3 {
        give '3';
    }

    if value == 4 {
        give '4';
    }

    if value == 5 {
        give '5';
    }

    if value == 6 {
        give '6';
    }

    if value == 7 {
        give '7';
    }

    if value == 8 {
        give '8';
    }

    give '9';
}

/// -------------------------------------------------------------------------
/// Scan result constructors
/// -------------------------------------------------------------------------

proc empty_scan() -> JsonNumericScan {
    give JsonNumericScan {
        ok: false,

        kind:
            JsonNumericKind.Invalid,

        error:
            JsonNumericError.Empty,

        error_index: 0,

        negative: false,

        integer_begin: 0,
        integer_end: 0,

        fraction_begin: 0,
        fraction_end: 0,

        exponent_begin: 0,
        exponent_end: 0,

        exponent_negative: false,

        integer_digits: 0,
        fraction_digits: 0,
        exponent_digits: 0,

        has_fraction: false,
        has_exponent: false,
    };
}

proc scan_failure(
    scan_value: JsonNumericScan,
    error: JsonNumericError,
    index: usize
) -> JsonNumericScan {
    let mut result:
        JsonNumericScan =
            scan_value;

    set result.ok = false;

    set result.kind =
        JsonNumericKind.Invalid;

    set result.error =
        error;

    set result.error_index =
        index;

    give result;
}

proc scan_success(
    scan_value: JsonNumericScan
) -> JsonNumericScan {
    let mut result:
        JsonNumericScan =
            scan_value;

    set result.ok = true;

    set result.error =
        JsonNumericError.None;

    set result.error_index = 0;

    if result.has_fraction ||
       result.has_exponent {
        set result.kind =
            JsonNumericKind.Float;
    } else {
        set result.kind =
            JsonNumericKind.Integer;
    }

    give result;
}

/// -------------------------------------------------------------------------
/// JSON number scanner
/// -------------------------------------------------------------------------

export proc scan(
    source: string
) -> JsonNumericScan {
    let mut result:
        JsonNumericScan =
            empty_scan();

    if source.length == 0 {
        give result;
    }

    let mut index: usize = 0;

    if source[index] == '+' {
        give scan_failure(
            result,
            JsonNumericError.LeadingPlus,
            index);
    }

    if source[index] == '-' {
        set result.negative = true;
        set index += 1;

        if index >= source.length {
            give scan_failure(
                result,
                JsonNumericError.MissingIntegerDigits,
                index);
        }
    }

    set result.integer_begin =
        index;

    if source[index] == '0' {
        set index += 1;

        set result.integer_digits =
            1;

        if index < source.length &&
           is_digit(source[index]) {
            give scan_failure(
                result,
                JsonNumericError.LeadingZero,
                index);
        }
    } else {
        if !is_nonzero_digit(
            source[index]) {
            give scan_failure(
                result,
                JsonNumericError.MissingIntegerDigits,
                index);
        }

        while index < source.length &&
              is_digit(source[index]) {
            set result.integer_digits += 1;
            set index += 1;
        }
    }

    set result.integer_end =
        index;

    if index < source.length &&
       source[index] == '.' {
        set result.has_fraction =
            true;

        set index += 1;

        set result.fraction_begin =
            index;

        if index >= source.length ||
           !is_digit(source[index]) {
            give scan_failure(
                result,
                JsonNumericError.MissingFractionDigits,
                index);
        }

        while index < source.length &&
              is_digit(source[index]) {
            set result.fraction_digits += 1;
            set index += 1;
        }

        set result.fraction_end =
            index;
    }

    if index < source.length &&
       is_exponent_marker(
           source[index]) {
        set result.has_exponent =
            true;

        set index += 1;

        if index >= source.length {
            give scan_failure(
                result,
                JsonNumericError.MissingExponentDigits,
                index);
        }

        if source[index] == '+' {
            set index += 1;
        } else if source[index] == '-' {
            set result.exponent_negative =
                true;

            set index += 1;
        }

        set result.exponent_begin =
            index;

        if index >= source.length ||
           !is_digit(source[index]) {
            give scan_failure(
                result,
                JsonNumericError.MissingExponentDigits,
                index);
        }

        while index < source.length &&
              is_digit(source[index]) {
            set result.exponent_digits += 1;
            set index += 1;
        }

        set result.exponent_end =
            index;
    }

    if index != source.length {
        give scan_failure(
            result,
            JsonNumericError.InvalidCharacter,
            index);
    }

    give scan_success(
        result);
}

export proc valid(
    source: string
) -> bool {
    give scan(source).ok;
}

export proc classify(
    source: string
) -> JsonNumericKind {
    give scan(source).kind;
}

proc is_integer_literal(
    source: string
) -> bool {
    let result:
        JsonNumericScan =
            scan(source);

    give result.ok &&
         result.kind ==
             JsonNumericKind.Integer;
}

proc is_float_literal(
    source: string
) -> bool {
    let result:
        JsonNumericScan =
            scan(source);

    give result.ok &&
         result.kind ==
             JsonNumericKind.Float;
}

proc is_negative_literal(
    source: string
) -> bool {
    let result:
        JsonNumericScan =
            scan(source);

    give result.ok &&
         result.negative;
}

proc has_fraction(
    source: string
) -> bool {
    let result:
        JsonNumericScan =
            scan(source);

    give result.ok &&
         result.has_fraction;
}

proc has_exponent(
    source: string
) -> bool {
    let result:
        JsonNumericScan =
            scan(source);

    give result.ok &&
         result.has_exponent;
}

/// -------------------------------------------------------------------------
/// Checked decimal accumulation
/// -------------------------------------------------------------------------

proc u64_append_digit_checked(
    current: u64,
    digit: u64
) -> JsonU64Result {
    if digit > 9 {
        give JsonU64Result {
            ok: false,
            value: 0,
            error:
                JsonNumericError.InvalidCharacter,
            error_index: 0,
        };
    }

    if current >
       JSON_NUMERIC_U64_MAX / 10 {
        give JsonU64Result {
            ok: false,
            value: 0,
            error:
                JsonNumericError.UnsignedOverflow,
            error_index: 0,
        };
    }

    let multiplied:
        u64 =
            current * 10;

    if multiplied >
       JSON_NUMERIC_U64_MAX - digit {
        give JsonU64Result {
            ok: false,
            value: 0,
            error:
                JsonNumericError.UnsignedOverflow,
            error_index: 0,
        };
    }

    give JsonU64Result {
        ok: true,
        value:
            multiplied + digit,
        error:
            JsonNumericError.None,
        error_index: 0,
    };
}

/// -------------------------------------------------------------------------
/// Unsigned conversion
/// -------------------------------------------------------------------------

export proc parse_u64(
    source: string
) -> JsonU64Result {
    let scanned:
        JsonNumericScan =
            scan(source);

    if !scanned.ok {
        give JsonU64Result {
            ok: false,
            value: 0,
            error:
                scanned.error,
            error_index:
                scanned.error_index,
        };
    }

    if scanned.kind !=
       JsonNumericKind.Integer {
        give JsonU64Result {
            ok: false,
            value: 0,
            error:
                JsonNumericError.InvalidInteger,
            error_index: 0,
        };
    }

    if scanned.negative {
        give JsonU64Result {
            ok: false,
            value: 0,
            error:
                JsonNumericError.NegativeUnsigned,
            error_index: 0,
        };
    }

    let mut result: u64 = 0;

    let mut index: usize =
        scanned.integer_begin;

    while index <
          scanned.integer_end {
        let digit:
            u64 =
                digit_value(
                    source[index]);

        let next:
            JsonU64Result =
                u64_append_digit_checked(
                    result,
                    digit);

        if !next.ok {
            let mut failure:
                JsonU64Result =
                    next;

            set failure.error_index =
                index;

            give failure;
        }

        set result =
            next.value;

        set index += 1;
    }

    give JsonU64Result {
        ok: true,
        value: result,
        error:
            JsonNumericError.None,
        error_index: 0,
    };
}

/// -------------------------------------------------------------------------
/// Signed conversion
/// -------------------------------------------------------------------------

export proc parse_i64(
    source: string
) -> JsonI64Result {
    let scanned:
        JsonNumericScan =
            scan(source);

    if !scanned.ok {
        give JsonI64Result {
            ok: false,
            value: 0,
            error:
                scanned.error,
            error_index:
                scanned.error_index,
        };
    }

    if scanned.kind !=
       JsonNumericKind.Integer {
        give JsonI64Result {
            ok: false,
            value: 0,
            error:
                JsonNumericError.InvalidInteger,
            error_index: 0,
        };
    }

    let positive_limit:
        u64 =
            JSON_NUMERIC_I64_MAX as u64;

    let negative_limit:
        u64 =
            (JSON_NUMERIC_I64_MAX as u64) +
            1;

    let limit:
        u64 =
            if scanned.negative {
                negative_limit
            } else {
                positive_limit
            };

    let mut magnitude: u64 = 0;

    let mut index: usize =
        scanned.integer_begin;

    while index <
          scanned.integer_end {
        let digit:
            u64 =
                digit_value(
                    source[index]);

        if magnitude >
           limit / 10 {
            give JsonI64Result {
                ok: false,
                value: 0,
                error:
                    if scanned.negative {
                        JsonNumericError.IntegerUnderflow
                    } else {
                        JsonNumericError.IntegerOverflow
                    },
                error_index:
                    index,
            };
        }

        let multiplied:
            u64 =
                magnitude * 10;

        if multiplied >
           limit - digit {
            give JsonI64Result {
                ok: false,
                value: 0,
                error:
                    if scanned.negative {
                        JsonNumericError.IntegerUnderflow
                    } else {
                        JsonNumericError.IntegerOverflow
                    },
                error_index:
                    index,
            };
        }

        set magnitude =
            multiplied + digit;

        set index += 1;
    }

    if scanned.negative {
        if magnitude ==
           negative_limit {
            give JsonI64Result {
                ok: true,
                value:
                    JSON_NUMERIC_I64_MIN,
                error:
                    JsonNumericError.None,
                error_index: 0,
            };
        }

        give JsonI64Result {
            ok: true,
            value:
                -(magnitude as i64),
            error:
                JsonNumericError.None,
            error_index: 0,
        };
    }

    give JsonI64Result {
        ok: true,
        value:
            magnitude as i64,
        error:
            JsonNumericError.None,
        error_index: 0,
    };
}

/// -------------------------------------------------------------------------
/// Decimal exponent parsing
/// -------------------------------------------------------------------------

proc parse_exponent(
    source: string,
    scanned: &JsonNumericScan
) -> JsonI64Result {
    if !scanned.has_exponent {
        give JsonI64Result {
            ok: true,
            value: 0,
            error:
                JsonNumericError.None,
            error_index: 0,
        };
    }

    let mut value: i64 = 0;

    let mut index: usize =
        scanned.exponent_begin;

    while index <
          scanned.exponent_end {
        let digit:
            i64 =
                digit_value(
                    source[index]) as i64;

        if value >
           JSON_NUMERIC_MAX_EXPONENT_ABS / 10 {
            give JsonI64Result {
                ok: false,
                value: 0,
                error:
                    JsonNumericError.ExponentTooLarge,
                error_index:
                    index,
            };
        }

        set value =
            value * 10 + digit;

        if value >
           JSON_NUMERIC_MAX_EXPONENT_ABS {
            give JsonI64Result {
                ok: false,
                value: 0,
                error:
                    JsonNumericError.ExponentTooLarge,
                error_index:
                    index,
            };
        }

        set index += 1;
    }

    if scanned.exponent_negative {
        set value = -value;
    }

    give JsonI64Result {
        ok: true,
        value: value,
        error:
            JsonNumericError.None,
        error_index: 0,
    };
}

/// -------------------------------------------------------------------------
/// Decimal powers
/// -------------------------------------------------------------------------

proc pow10_positive(
    exponent: usize
) -> f64 {
    let mut result: f64 = 1.0;

    let mut index: usize = 0;

    while index < exponent {
        set result *= 10.0;
        set index += 1;
    }

    give result;
}

proc pow10_negative(
    exponent: usize
) -> f64 {
    let mut result: f64 = 1.0;

    let mut index: usize = 0;

    while index < exponent {
        set result /= 10.0;
        set index += 1;
    }

    give result;
}

proc pow10(
    exponent: i64
) -> f64 {
    if exponent == 0 {
        give 1.0;
    }

    if exponent > 0 {
        give pow10_positive(
            exponent as usize);
    }

    give pow10_negative(
        (-exponent) as usize);
}

/// -------------------------------------------------------------------------
/// Floating conversion
/// -------------------------------------------------------------------------

export proc parse_f64(
    source: string
) -> JsonF64Result {
    let scanned:
        JsonNumericScan =
            scan(source);

    if !scanned.ok {
        give JsonF64Result {
            ok: false,
            value: 0.0,
            error:
                scanned.error,
            error_index:
                scanned.error_index,
        };
    }

    let exponent_result:
        JsonI64Result =
            parse_exponent(
                source,
                &scanned);

    if !exponent_result.ok {
        give JsonF64Result {
            ok: false,
            value: 0.0,
            error:
                exponent_result.error,
            error_index:
                exponent_result.error_index,
        };
    }

    let mut value: f64 = 0.0;

    let mut fraction_digits: i64 = 0;

    let mut index: usize =
        scanned.integer_begin;

    while index <
          scanned.integer_end {
        let digit:
            u64 =
                digit_value(
                    source[index]);

        set value =
            value * 10.0 +
            (digit as f64);

        set index += 1;
    }

    if scanned.has_fraction {
        set index =
            scanned.fraction_begin;

        while index <
              scanned.fraction_end {
            let digit:
                u64 =
                digit_value(
                    source[index]);

            set value =
                value * 10.0 +
                (digit as f64);

            set fraction_digits += 1;

            set index += 1;
        }
    }

    let effective_exponent: i64 =
        exponent_result.value -
        fraction_digits;

    if effective_exponent != 0 {
        set value *=
            pow10(
                effective_exponent);
    }

    if scanned.negative {
        set value = -value;
    }

    give JsonF64Result {
        ok: true,
        value: value,
        error:
            JsonNumericError.None,
        error_index: 0,
    };
}

/// -------------------------------------------------------------------------
/// Generic literal conversion
/// -------------------------------------------------------------------------

proc as_i64(
    source: string,
    fallback: i64
) -> i64 {
    let result:
        JsonI64Result =
            parse_i64(source);

    if !result.ok {
        give fallback;
    }

    give result.value;
}

proc as_u64(
    source: string,
    fallback: u64
) -> u64 {
    let result:
        JsonU64Result =
            parse_u64(source);

    if !result.ok {
        give fallback;
    }

    give result.value;
}

proc as_f64(
    source: string,
    fallback: f64
) -> f64 {
    let result:
        JsonF64Result =
            parse_f64(source);

    if !result.ok {
        give fallback;
    }

    give result.value;
}

/// -------------------------------------------------------------------------
/// Numeric classification
/// -------------------------------------------------------------------------

proc classify_i64(
    value: i64
) -> JsonNumericClass {
    if value == 0 {
        give JsonNumericClass.Zero;
    }

    if value > 0 {
        give JsonNumericClass.Positive;
    }

    give JsonNumericClass.Negative;
}

proc classify_u64(
    value: u64
) -> JsonNumericClass {
    if value == 0 {
        give JsonNumericClass.Zero;
    }

    give JsonNumericClass.Positive;
}

proc classify_f64(
    value: f64
) -> JsonNumericClass {
    if value != value {
        give JsonNumericClass.Invalid;
    }

    if value == 0.0 {
        give JsonNumericClass.Zero;
    }

    if value > 0.0 {
        give JsonNumericClass.Positive;
    }

    give JsonNumericClass.Negative;
}

/// -------------------------------------------------------------------------
/// Floating-point helpers
/// -------------------------------------------------------------------------

proc is_nan(
    value: f64
) -> bool {
    give value != value;
}

proc is_positive_infinity(
    value: f64
) -> bool {
    if is_nan(value) {
        give false;
    }

    give value > 0.0 &&
         value + value == value;
}

proc is_negative_infinity(
    value: f64
) -> bool {
    if is_nan(value) {
        give false;
    }

    give value < 0.0 &&
         value + value == value;
}

proc is_infinite(
    value: f64
) -> bool {
    give is_positive_infinity(value) ||
         is_negative_infinity(value);
}

proc is_finite(
    value: f64
) -> bool {
    give !is_nan(value) &&
         !is_infinite(value);
}

proc is_zero_f64(
    value: f64
) -> bool {
    give is_finite(value) &&
         value == 0.0;
}

proc is_integer_f64(
    value: f64
) -> bool {
    if !is_finite(value) {
        give false;
    }

    if value >
           (JSON_NUMERIC_I64_MAX as f64) ||
       value <
           (JSON_NUMERIC_I64_MIN as f64) {
        give false;
    }

    let integer_value:
        i64 =
            value as i64;

    give (integer_value as f64) ==
         value;
}

/// -------------------------------------------------------------------------
/// Absolute values
/// -------------------------------------------------------------------------

proc abs_i64_magnitude(
    value: i64
) -> u64 {
    if value >= 0 {
        give value as u64;
    }

    if value ==
       JSON_NUMERIC_I64_MIN {
        give (JSON_NUMERIC_I64_MAX as u64) +
             1;
    }

    give (-value) as u64;
}

proc abs_f64(
    value: f64
) -> f64 {
    if value < 0.0 {
        give -value;
    }

    give value;
}

/// -------------------------------------------------------------------------
/// Checked i64 arithmetic
/// -------------------------------------------------------------------------

proc checked_add_i64(
    left: i64,
    right: i64
) -> JsonI64Result {
    if right > 0 &&
       left >
           JSON_NUMERIC_I64_MAX - right {
        give JsonI64Result {
            ok: false,
            value: 0,
            error:
                JsonNumericError.IntegerOverflow,
            error_index: 0,
        };
    }

    if right < 0 &&
       left <
           JSON_NUMERIC_I64_MIN - right {
        give JsonI64Result {
            ok: false,
            value: 0,
            error:
                JsonNumericError.IntegerUnderflow,
            error_index: 0,
        };
    }

    give JsonI64Result {
        ok: true,
        value:
            left + right,
        error:
            JsonNumericError.None,
        error_index: 0,
    };
}

proc checked_sub_i64(
    left: i64,
    right: i64
) -> JsonI64Result {
    if right > 0 &&
       left <
           JSON_NUMERIC_I64_MIN + right {
        give JsonI64Result {
            ok: false,
            value: 0,
            error:
                JsonNumericError.IntegerUnderflow,
            error_index: 0,
        };
    }

    if right < 0 &&
       left >
           JSON_NUMERIC_I64_MAX + right {
        give JsonI64Result {
            ok: false,
            value: 0,
            error:
                JsonNumericError.IntegerOverflow,
            error_index: 0,
        };
    }

    give JsonI64Result {
        ok: true,
        value:
            left - right,
        error:
            JsonNumericError.None,
        error_index: 0,
    };
}

proc checked_mul_i64(
    left: i64,
    right: i64
) -> JsonI64Result {
    if left == 0 ||
       right == 0 {
        give JsonI64Result {
            ok: true,
            value: 0,
            error:
                JsonNumericError.None,
            error_index: 0,
        };
    }

    if left ==
           JSON_NUMERIC_I64_MIN &&
       right == -1 {
        give JsonI64Result {
            ok: false,
            value: 0,
            error:
                JsonNumericError.IntegerOverflow,
            error_index: 0,
        };
    }

    if right ==
           JSON_NUMERIC_I64_MIN &&
       left == -1 {
        give JsonI64Result {
            ok: false,
            value: 0,
            error:
                JsonNumericError.IntegerOverflow,
            error_index: 0,
        };
    }

    if left > 0 {
        if right > 0 {
            if left >
               JSON_NUMERIC_I64_MAX / right {
                give JsonI64Result {
                    ok: false,
                    value: 0,
                    error:
                        JsonNumericError.IntegerOverflow,
                    error_index: 0,
                };
            }
        } else {
            if right <
               JSON_NUMERIC_I64_MIN / left {
                give JsonI64Result {
                    ok: false,
                    value: 0,
                    error:
                        JsonNumericError.IntegerUnderflow,
                    error_index: 0,
                };
            }
        }
    } else {
        if right > 0 {
            if left <
               JSON_NUMERIC_I64_MIN / right {
                give JsonI64Result {
                    ok: false,
                    value: 0,
                    error:
                        JsonNumericError.IntegerUnderflow,
                    error_index: 0,
                };
            }
        } else {
            if left <
               JSON_NUMERIC_I64_MAX / right {
                give JsonI64Result {
                    ok: false,
                    value: 0,
                    error:
                        JsonNumericError.IntegerOverflow,
                    error_index: 0,
                };
            }
        }
    }

    give JsonI64Result {
        ok: true,
        value:
            left * right,
        error:
            JsonNumericError.None,
        error_index: 0,
    };
}

proc checked_div_i64(
    left: i64,
    right: i64
) -> JsonI64Result {
    if right == 0 {
        give JsonI64Result {
            ok: false,
            value: 0,
            error:
                JsonNumericError.DivisionByZero,
            error_index: 0,
        };
    }

    if left ==
           JSON_NUMERIC_I64_MIN &&
       right == -1 {
        give JsonI64Result {
            ok: false,
            value: 0,
            error:
                JsonNumericError.IntegerOverflow,
            error_index: 0,
        };
    }

    give JsonI64Result {
        ok: true,
        value:
            left / right,
        error:
            JsonNumericError.None,
        error_index: 0,
    };
}

proc checked_rem_i64(
    left: i64,
    right: i64
) -> JsonI64Result {
    if right == 0 {
        give JsonI64Result {
            ok: false,
            value: 0,
            error:
                JsonNumericError.RemainderByZero,
            error_index: 0,
        };
    }

    if left ==
           JSON_NUMERIC_I64_MIN &&
       right == -1 {
        give JsonI64Result {
            ok: true,
            value: 0,
            error:
                JsonNumericError.None,
            error_index: 0,
        };
    }

    give JsonI64Result {
        ok: true,
        value:
            left % right,
        error:
            JsonNumericError.None,
        error_index: 0,
    };
}

proc checked_neg_i64(
    value: i64
) -> JsonI64Result {
    if value ==
       JSON_NUMERIC_I64_MIN {
        give JsonI64Result {
            ok: false,
            value: 0,
            error:
                JsonNumericError.IntegerOverflow,
            error_index: 0,
        };
    }

    give JsonI64Result {
        ok: true,
        value: -value,
        error:
            JsonNumericError.None,
        error_index: 0,
    };
}

/// -------------------------------------------------------------------------
/// Checked u64 arithmetic
/// -------------------------------------------------------------------------

proc checked_add_u64(
    left: u64,
    right: u64
) -> JsonU64Result {
    if left >
       JSON_NUMERIC_U64_MAX - right {
        give JsonU64Result {
            ok: false,
            value: 0,
            error:
                JsonNumericError.UnsignedOverflow,
            error_index: 0,
        };
    }

    give JsonU64Result {
        ok: true,
        value:
            left + right,
        error:
            JsonNumericError.None,
        error_index: 0,
    };
}

proc checked_mul_u64(
    left: u64,
    right: u64
) -> JsonU64Result {
    if left == 0 ||
       right == 0 {
        give JsonU64Result {
            ok: true,
            value: 0,
            error:
                JsonNumericError.None,
            error_index: 0,
        };
    }

    if left >
       JSON_NUMERIC_U64_MAX / right {
        give JsonU64Result {
            ok: false,
            value: 0,
            error:
                JsonNumericError.UnsignedOverflow,
            error_index: 0,
        };
    }

    give JsonU64Result {
        ok: true,
        value:
            left * right,
        error:
            JsonNumericError.None,
        error_index: 0,
    };
}

/// -------------------------------------------------------------------------
/// Comparison
/// -------------------------------------------------------------------------

proc compare_i64(
    left: i64,
    right: i64
) -> JsonNumericComparison {
    give JsonNumericComparison {
        comparable: true,

        less:
            left < right,

        equal:
            left == right,

        greater:
            left > right,
    };
}

proc compare_u64(
    left: u64,
    right: u64
) -> JsonNumericComparison {
    give JsonNumericComparison {
        comparable: true,

        less:
            left < right,

        equal:
            left == right,

        greater:
            left > right,
    };
}

proc compare_f64(
    left: f64,
    right: f64
) -> JsonNumericComparison {
    if is_nan(left) ||
       is_nan(right) {
        give JsonNumericComparison {
            comparable: false,
            less: false,
            equal: false,
            greater: false,
        };
    }

    give JsonNumericComparison {
        comparable: true,

        less:
            left < right,

        equal:
            left == right,

        greater:
            left > right,
    };
}

/// -------------------------------------------------------------------------
/// Range / clamp helpers
/// -------------------------------------------------------------------------

proc min_i64(
    left: i64,
    right: i64
) -> i64 {
    if left < right {
        give left;
    }

    give right;
}

proc max_i64(
    left: i64,
    right: i64
) -> i64 {
    if left > right {
        give left;
    }

    give right;
}

proc clamp_i64(
    value: i64,
    minimum: i64,
    maximum: i64
) -> i64 {
    if value < minimum {
        give minimum;
    }

    if value > maximum {
        give maximum;
    }

    give value;
}

proc min_f64(
    left: f64,
    right: f64
) -> f64 {
    if left < right {
        give left;
    }

    give right;
}

proc max_f64(
    left: f64,
    right: f64
) -> f64 {
    if left > right {
        give left;
    }

    give right;
}

proc clamp_f64(
    value: f64,
    minimum: f64,
    maximum: f64
) -> f64 {
    if value < minimum {
        give minimum;
    }

    if value > maximum {
        give maximum;
    }

    give value;
}

/// -------------------------------------------------------------------------
/// Integer formatting
/// -------------------------------------------------------------------------

proc reverse_ascii(
    source: string
) -> string {
    let mut result: string = "";

    let mut index: usize =
        source.length;

    while index > 0 {
        set index -= 1;

        set result =
            result +
            source[index];
    }

    give result;
}

export proc format_u64(
    value: u64
) -> string {
    if value == 0 {
        give "0";
    }

    let mut current:
        u64 =
            value;

    let mut reversed:
        string =
            "";

    while current > 0 {
        let digit:
            u64 =
                current % 10;

        set reversed =
            reversed +
            digit_char(digit);

        set current /=
            10;
    }

    give reverse_ascii(
        reversed);
}

export proc format_i64(
    value: i64
) -> string {
    if value == 0 {
        give "0";
    }

    if value < 0 {
        give "-" +
             format_u64(
                 abs_i64_magnitude(
                     value));
    }

    give format_u64(
        value as u64);
}

/// -------------------------------------------------------------------------
/// Formatting options
/// -------------------------------------------------------------------------

proc default_format_options()
    -> JsonNumericFormatOptions {
    give JsonNumericFormatOptions {
        fraction_digits:
            JSON_NUMERIC_DEFAULT_FORMAT_FRACTION_DIGITS,

        trim_fraction_zeroes:
            true,

        preserve_negative_zero:
            false,

        force_decimal_point:
            false,

        uppercase_exponent:
            false,
    };
}

proc fixed_format_options(
    fraction_digits: usize
) -> JsonNumericFormatOptions {
    give JsonNumericFormatOptions {
        fraction_digits:
            fraction_digits,

        trim_fraction_zeroes:
            false,

        preserve_negative_zero:
            false,

        force_decimal_point:
            true,

        uppercase_exponent:
            false,
    };
}

proc format_failure(
    error: JsonNumericError
) -> JsonNumericFormatResult {
    give JsonNumericFormatResult {
        ok: false,
        text: "",
        error: error,
    };
}

proc format_success(
    text: string
) -> JsonNumericFormatResult {
    give JsonNumericFormatResult {
        ok: true,
        text: text,
        error:
            JsonNumericError.None,
    };
}

/// -------------------------------------------------------------------------
/// Decimal string cleanup
/// -------------------------------------------------------------------------

proc contains_decimal_point(
    source: string
) -> bool {
    let mut index: usize = 0;

    while index < source.length {
        if source[index] == '.' {
            give true;
        }

        set index += 1;
    }

    give false;
}

proc contains_exponent_marker(
    source: string
) -> bool {
    let mut index: usize = 0;

    while index < source.length {
        if source[index] == 'e' ||
           source[index] == 'E' {
            give true;
        }

        set index += 1;
    }

    give false;
}

proc trim_fraction_zeroes(
    source: string
) -> string {
    if source.length == 0 {
        give source;
    }

    if contains_exponent_marker(
        source) {
        give source;
    }

    if !contains_decimal_point(
        source) {
        give source;
    }

    let mut end_index:
        usize =
            source.length;

    while end_index > 0 &&
          source[end_index - 1] == '0' {
        set end_index -= 1;
    }

    if end_index > 0 &&
       source[end_index - 1] == '.' {
        set end_index -= 1;
    }

    let mut result: string = "";

    let mut index: usize = 0;

    while index < end_index {
        set result =
            result +
            source[index];

        set index += 1;
    }

    if result == "-0" {
        give "0";
    }

    if result.length == 0 {
        give "0";
    }

    give result;
}

/// -------------------------------------------------------------------------
/// Simple finite f64 formatting
///
/// This is deterministic runtime formatting intended for JSON support.
/// A dedicated shortest-roundtrip dtoa implementation may replace this
/// layer without changing the higher-level JSON API.
/// -------------------------------------------------------------------------

proc format_f64_with_options(
    value: f64,
    options: JsonNumericFormatOptions
) -> JsonNumericFormatResult {
    if options.fraction_digits >
       JSON_NUMERIC_MAX_FORMAT_FRACTION_DIGITS {
        give format_failure(
            JsonNumericError.InvalidPrecision);
    }

    if is_nan(value) ||
       is_infinite(value) {
        give format_failure(
            JsonNumericError.NonFinite);
    }

    if value == 0.0 {
        if options.force_decimal_point {
            if options.fraction_digits == 0 {
                give format_success(
                    "0.0");
            }

            let mut zero_result:
                string =
                    "0.";

            let mut zero_index:
                usize = 0;

            while zero_index <
                  options.fraction_digits {
                set zero_result =
                    zero_result + '0';

                set zero_index += 1;
            }

            give format_success(
                zero_result);
        }

        give format_success(
            "0");
    }

    let negative:
        bool =
            value < 0.0;

    let absolute:
        f64 =
            abs_f64(value);

    if absolute >
       (JSON_NUMERIC_I64_MAX as f64) {
        give format_failure(
            JsonNumericError.FloatOverflow);
    }

    let whole:
        u64 =
            absolute as u64;

    let mut result:
        string =
            format_u64(whole);

    let mut fraction:
        f64 =
            absolute -
            (whole as f64);

    if options.fraction_digits > 0 {
        set result =
            result + ".";

        let mut index:
            usize = 0;

        while index <
              options.fraction_digits {
            set fraction *= 10.0;

            let digit:
                u64 =
                    fraction as u64;

            set result =
                result +
                digit_char(
                    digit % 10);

            set fraction -=
                digit as f64;

            set index += 1;
        }
    } else if options.force_decimal_point {
        set result =
            result + ".0";
    }

    if options.trim_fraction_zeroes {
        set result =
            trim_fraction_zeroes(
                result);

        if options.force_decimal_point &&
           !contains_decimal_point(
               result) {
            set result =
                result + ".0";
        }
    }

    if negative {
        set result =
            "-" + result;
    }

    give format_success(
        result);
}

export proc format_f64(
    value: f64
) -> JsonNumericFormatResult {
    give format_f64_with_options(
        value,
        default_format_options());
}

/// -------------------------------------------------------------------------
/// JSON number normalization
/// -------------------------------------------------------------------------

proc normalize_integer_literal(
    source: string
) -> JsonNumericFormatResult {
    let parsed:
        JsonI64Result =
            parse_i64(source);

    if !parsed.ok {
        give format_failure(
            parsed.error);
    }

    give format_success(
        format_i64(
            parsed.value));
}

proc normalize_float_literal(
    source: string
) -> JsonNumericFormatResult {
    let parsed:
        JsonF64Result =
            parse_f64(source);

    if !parsed.ok {
        give format_failure(
            parsed.error);
    }

    give format_f64(
        parsed.value);
}

export proc normalize(
    source: string
) -> JsonNumericFormatResult {
    let scanned:
        JsonNumericScan =
            scan(source);

    if !scanned.ok {
        give format_failure(
            scanned.error);
    }

    if scanned.kind ==
       JsonNumericKind.Integer {
        give normalize_integer_literal(
            source);
    }

    give normalize_float_literal(
        source);
}

/// -------------------------------------------------------------------------
/// Exact lexical properties
/// -------------------------------------------------------------------------

proc integer_digit_count(
    source: string
) -> usize {
    let result:
        JsonNumericScan =
            scan(source);

    if !result.ok {
        give 0;
    }

    give result.integer_digits;
}

proc fraction_digit_count(
    source: string
) -> usize {
    let result:
        JsonNumericScan =
            scan(source);

    if !result.ok {
        give 0;
    }

    give result.fraction_digits;
}

proc exponent_digit_count(
    source: string
) -> usize {
    let result:
        JsonNumericScan =
            scan(source);

    if !result.ok {
        give 0;
    }

    give result.exponent_digits;
}

proc significant_digit_count(
    source: string
) -> usize {
    let result:
        JsonNumericScan =
            scan(source);

    if !result.ok {
        give 0;
    }

    give result.integer_digits +
         result.fraction_digits;
}

/// -------------------------------------------------------------------------
/// Literal zero detection
/// -------------------------------------------------------------------------

proc literal_is_zero(
    source: string
) -> bool {
    let scanned:
        JsonNumericScan =
            scan(source);

    if !scanned.ok {
        give false;
    }

    let mut index:
        usize =
            scanned.integer_begin;

    while index <
          scanned.integer_end {
        if source[index] != '0' {
            give false;
        }

        set index += 1;
    }

    if scanned.has_fraction {
        set index =
            scanned.fraction_begin;

        while index <
              scanned.fraction_end {
            if source[index] != '0' {
                give false;
            }

            set index += 1;
        }
    }

    give true;
}

proc literal_is_negative_zero(
    source: string
) -> bool {
    let scanned:
        JsonNumericScan =
            scan(source);

    give scanned.ok &&
         scanned.negative &&
         literal_is_zero(source);
}

/// -------------------------------------------------------------------------
/// Integer representability
/// -------------------------------------------------------------------------

proc fits_i64(
    source: string
) -> bool {
    give parse_i64(source).ok;
}

proc fits_u64(
    source: string
) -> bool {
    give parse_u64(source).ok;
}

proc fits_f64(
    source: string
) -> bool {
    give parse_f64(source).ok;
}

/// -------------------------------------------------------------------------
/// Conversion helpers
/// -------------------------------------------------------------------------

proc i64_to_f64(
    value: i64
) -> f64 {
    give value as f64;
}

proc u64_to_f64(
    value: u64
) -> f64 {
    give value as f64;
}

proc f64_to_i64_checked(
    value: f64
) -> JsonI64Result {
    if !is_finite(value) {
        give JsonI64Result {
            ok: false,
            value: 0,
            error:
                JsonNumericError.NonFinite,
            error_index: 0,
        };
    }

    if value >
       (JSON_NUMERIC_I64_MAX as f64) {
        give JsonI64Result {
            ok: false,
            value: 0,
            error:
                JsonNumericError.IntegerOverflow,
            error_index: 0,
        };
    }

    if value <
       (JSON_NUMERIC_I64_MIN as f64) {
        give JsonI64Result {
            ok: false,
            value: 0,
            error:
                JsonNumericError.IntegerUnderflow,
            error_index: 0,
        };
    }

    if !is_integer_f64(value) {
        give JsonI64Result {
            ok: false,
            value: 0,
            error:
                JsonNumericError.InvalidInteger,
            error_index: 0,
        };
    }

    give JsonI64Result {
        ok: true,
        value:
            value as i64,
        error:
            JsonNumericError.None,
        error_index: 0,
    };
}

/// -------------------------------------------------------------------------
/// Tests — lexical grammar
/// -------------------------------------------------------------------------

test "json numeric accepts zero" {
    let result:
        JsonNumericScan =
            scan("0");

    assert result.ok;

    assert result.kind ==
        JsonNumericKind.Integer;

    assert result.integer_digits == 1;
}

test "json numeric accepts negative zero" {
    let result:
        JsonNumericScan =
            scan("-0");

    assert result.ok;
    assert result.negative;
    assert literal_is_zero("-0");
    assert literal_is_negative_zero("-0");
}

test "json numeric accepts positive integer" {
    let result:
        JsonNumericScan =
            scan("123456789");

    assert result.ok;

    assert result.kind ==
        JsonNumericKind.Integer;

    assert result.integer_digits == 9;
}

test "json numeric accepts negative integer" {
    let result:
        JsonNumericScan =
            scan("-42");

    assert result.ok;
    assert result.negative;
}

test "json numeric accepts decimal fraction" {
    let result:
        JsonNumericScan =
            scan("12.345");

    assert result.ok;

    assert result.kind ==
        JsonNumericKind.Float;

    assert result.has_fraction;

    assert result.fraction_digits ==
        3;
}

test "json numeric accepts exponent" {
    let result:
        JsonNumericScan =
            scan("1e10");

    assert result.ok;
    assert result.has_exponent;

    assert result.exponent_digits ==
        2;
}

test "json numeric accepts positive exponent sign" {
    let result:
        JsonNumericScan =
            scan("1e+10");

    assert result.ok;
    assert result.has_exponent;
    assert !result.exponent_negative;
}

test "json numeric accepts negative exponent" {
    let result:
        JsonNumericScan =
            scan("1E-10");

    assert result.ok;
    assert result.has_exponent;
    assert result.exponent_negative;
}

test "json numeric accepts complete decimal exponent number" {
    let result:
        JsonNumericScan =
            scan("-123.456e-78");

    assert result.ok;
    assert result.negative;
    assert result.has_fraction;
    assert result.has_exponent;
    assert result.fraction_digits == 3;
    assert result.exponent_digits == 2;
}

test "json numeric rejects empty" {
    let result:
        JsonNumericScan =
            scan("");

    assert !result.ok;

    assert result.error ==
        JsonNumericError.Empty;
}

test "json numeric rejects leading plus" {
    let result:
        JsonNumericScan =
            scan("+1");

    assert !result.ok;

    assert result.error ==
        JsonNumericError.LeadingPlus;
}

test "json numeric rejects sign only" {
    let result:
        JsonNumericScan =
            scan("-");

    assert !result.ok;

    assert result.error ==
        JsonNumericError.MissingIntegerDigits;
}

test "json numeric rejects leading zero" {
    let result:
        JsonNumericScan =
            scan("01");

    assert !result.ok;

    assert result.error ==
        JsonNumericError.LeadingZero;
}

test "json numeric rejects negative leading zero" {
    let result:
        JsonNumericScan =
            scan("-01");

    assert !result.ok;

    assert result.error ==
        JsonNumericError.LeadingZero;
}

test "json numeric rejects missing integer before fraction" {
    let result:
        JsonNumericScan =
            scan(".5");

    assert !result.ok;

    assert result.error ==
        JsonNumericError.MissingIntegerDigits;
}

test "json numeric rejects empty fraction" {
    let result:
        JsonNumericScan =
            scan("1.");

    assert !result.ok;

    assert result.error ==
        JsonNumericError.MissingFractionDigits;
}

test "json numeric rejects exponent without digits" {
    let result:
        JsonNumericScan =
            scan("1e");

    assert !result.ok;

    assert result.error ==
        JsonNumericError.MissingExponentDigits;
}

test "json numeric rejects signed exponent without digits" {
    let result:
        JsonNumericScan =
            scan("1e+");

    assert !result.ok;

    assert result.error ==
        JsonNumericError.MissingExponentDigits;
}

test "json numeric rejects alpha suffix" {
    let result:
        JsonNumericScan =
            scan("123x");

    assert !result.ok;

    assert result.error ==
        JsonNumericError.InvalidCharacter;
}

/// -------------------------------------------------------------------------
/// Tests — i64
/// -------------------------------------------------------------------------

test "json numeric parses i64 zero" {
    let result:
        JsonI64Result =
            parse_i64("0");

    assert result.ok;
    assert result.value == 0;
}

test "json numeric parses positive i64" {
    let result:
        JsonI64Result =
            parse_i64("123456");

    assert result.ok;
    assert result.value == 123456;
}

test "json numeric parses negative i64" {
    let result:
        JsonI64Result =
            parse_i64("-123456");

    assert result.ok;
    assert result.value == -123456;
}

test "json numeric parses i64 maximum" {
    let result:
        JsonI64Result =
            parse_i64(
                "9223372036854775807");

    assert result.ok;

    assert result.value ==
        JSON_NUMERIC_I64_MAX;
}

test "json numeric parses i64 minimum" {
    let result:
        JsonI64Result =
            parse_i64(
                "-9223372036854775808");

    assert result.ok;

    assert result.value ==
        JSON_NUMERIC_I64_MIN;
}

test "json numeric detects positive i64 overflow" {
    let result:
        JsonI64Result =
            parse_i64(
                "9223372036854775808");

    assert !result.ok;

    assert result.error ==
        JsonNumericError.IntegerOverflow;
}

test "json numeric detects negative i64 underflow" {
    let result:
        JsonI64Result =
            parse_i64(
                "-9223372036854775809");

    assert !result.ok;

    assert result.error ==
        JsonNumericError.IntegerUnderflow;
}

test "json numeric i64 rejects fraction" {
    let result:
        JsonI64Result =
            parse_i64("1.0");

    assert !result.ok;

    assert result.error ==
        JsonNumericError.InvalidInteger;
}

/// -------------------------------------------------------------------------
/// Tests — u64
/// -------------------------------------------------------------------------

test "json numeric parses u64 maximum" {
    let result:
        JsonU64Result =
            parse_u64(
                "18446744073709551615");

    assert result.ok;

    assert result.value ==
        JSON_NUMERIC_U64_MAX;
}

test "json numeric detects u64 overflow" {
    let result:
        JsonU64Result =
            parse_u64(
                "18446744073709551616");

    assert !result.ok;

    assert result.error ==
        JsonNumericError.UnsignedOverflow;
}

test "json numeric rejects negative u64" {
    let result:
        JsonU64Result =
            parse_u64("-1");

    assert !result.ok;

    assert result.error ==
        JsonNumericError.NegativeUnsigned;
}

/// -------------------------------------------------------------------------
/// Tests — f64
/// -------------------------------------------------------------------------

test "json numeric parses f64 integer syntax" {
    let result:
        JsonF64Result =
            parse_f64("42");

    assert result.ok;
    assert result.value == 42.0;
}

test "json numeric parses f64 fraction" {
    let result:
        JsonF64Result =
            parse_f64("12.5");

    assert result.ok;
    assert result.value == 12.5;
}

test "json numeric parses f64 positive exponent" {
    let result:
        JsonF64Result =
            parse_f64("1.25e2");

    assert result.ok;
    assert result.value == 125.0;
}

test "json numeric parses f64 negative exponent" {
    let result:
        JsonF64Result =
            parse_f64("125e-2");

    assert result.ok;
    assert result.value == 1.25;
}

test "json numeric parses negative f64" {
    let result:
        JsonF64Result =
            parse_f64("-12.5");

    assert result.ok;
    assert result.value == -12.5;
}

/// -------------------------------------------------------------------------
/// Tests — checked arithmetic
/// -------------------------------------------------------------------------

test "json numeric checked add" {
    let result:
        JsonI64Result =
            checked_add_i64(
                20,
                22);

    assert result.ok;
    assert result.value == 42;
}

test "json numeric checked add overflow" {
    let result:
        JsonI64Result =
            checked_add_i64(
                JSON_NUMERIC_I64_MAX,
                1);

    assert !result.ok;

    assert result.error ==
        JsonNumericError.IntegerOverflow;
}

test "json numeric checked sub" {
    let result:
        JsonI64Result =
            checked_sub_i64(
                50,
                8);

    assert result.ok;
    assert result.value == 42;
}

test "json numeric checked sub underflow" {
    let result:
        JsonI64Result =
            checked_sub_i64(
                JSON_NUMERIC_I64_MIN,
                1);

    assert !result.ok;

    assert result.error ==
        JsonNumericError.IntegerUnderflow;
}

test "json numeric checked multiply" {
    let result:
        JsonI64Result =
            checked_mul_i64(
                6,
                7);

    assert result.ok;
    assert result.value == 42;
}

test "json numeric checked multiply overflow" {
    let result:
        JsonI64Result =
            checked_mul_i64(
                JSON_NUMERIC_I64_MAX,
                2);

    assert !result.ok;
}

test "json numeric checked division" {
    let result:
        JsonI64Result =
            checked_div_i64(
                84,
                2);

    assert result.ok;
    assert result.value == 42;
}

test "json numeric checked division by zero" {
    let result:
        JsonI64Result =
            checked_div_i64(
                42,
                0);

    assert !result.ok;

    assert result.error ==
        JsonNumericError.DivisionByZero;
}

test "json numeric checked remainder" {
    let result:
        JsonI64Result =
            checked_rem_i64(
                44,
                42);

    assert result.ok;
    assert result.value == 2;
}

test "json numeric checked remainder by zero" {
    let result:
        JsonI64Result =
            checked_rem_i64(
                42,
                0);

    assert !result.ok;

    assert result.error ==
        JsonNumericError.RemainderByZero;
}

test "json numeric checked negation" {
    let result:
        JsonI64Result =
            checked_neg_i64(42);

    assert result.ok;
    assert result.value == -42;
}

test "json numeric checked minimum negation overflow" {
    let result:
        JsonI64Result =
            checked_neg_i64(
                JSON_NUMERIC_I64_MIN);

    assert !result.ok;

    assert result.error ==
        JsonNumericError.IntegerOverflow;
}

/// -------------------------------------------------------------------------
/// Tests — formatting
/// -------------------------------------------------------------------------

test "json numeric formats u64" {
    assert format_u64(0) ==
        "0";

    assert format_u64(42) ==
        "42";

    assert format_u64(
        JSON_NUMERIC_U64_MAX) ==
        "18446744073709551615";
}

test "json numeric formats i64" {
    assert format_i64(0) ==
        "0";

    assert format_i64(42) ==
        "42";

    assert format_i64(-42) ==
        "-42";

    assert format_i64(
        JSON_NUMERIC_I64_MIN) ==
        "-9223372036854775808";
}

test "json numeric trims fraction zeroes" {
    assert trim_fraction_zeroes(
        "12.34000") ==
        "12.34";

    assert trim_fraction_zeroes(
        "12.000") ==
        "12";

    assert trim_fraction_zeroes(
        "0.000") ==
        "0";
}

/// -------------------------------------------------------------------------
/// Tests — properties
/// -------------------------------------------------------------------------

test "json numeric digit helpers" {
    assert is_digit('0');
    assert is_digit('5');
    assert is_digit('9');

    assert !is_digit('a');
    assert !is_digit('-');

    assert is_nonzero_digit('1');
    assert is_nonzero_digit('9');
    assert !is_nonzero_digit('0');

    assert digit_value('0') == 0;
    assert digit_value('9') == 9;

    assert digit_char(0) == '0';
    assert digit_char(9) == '9';
}

test "json numeric literal properties" {
    assert is_integer_literal("42");
    assert !is_integer_literal("42.0");

    assert is_float_literal("42.0");
    assert is_float_literal("42e0");

    assert is_negative_literal("-42");
    assert !is_negative_literal("42");

    assert has_fraction("42.0");
    assert !has_fraction("42");

    assert has_exponent("42e2");
    assert !has_exponent("42");
}

test "json numeric digit counts" {
    assert integer_digit_count(
        "-123.456e78") ==
        3;

    assert fraction_digit_count(
        "-123.456e78") ==
        3;

    assert exponent_digit_count(
        "-123.456e78") ==
        2;

    assert significant_digit_count(
        "-123.456e78") ==
        6;
}

test "json numeric zero detection" {
    assert literal_is_zero("0");
    assert literal_is_zero("-0");
    assert literal_is_zero("0.0");
    assert literal_is_zero("-0.000e10");

    assert !literal_is_zero("0.1");
    assert !literal_is_zero("1e-10");
}

test "json numeric comparisons" {
    let less:
        JsonNumericComparison =
            compare_i64(
                1,
                2);

    assert less.comparable;
    assert less.less;
    assert !less.equal;
    assert !less.greater;

    let equal:
        JsonNumericComparison =
            compare_i64(
                42,
                42);

    assert equal.equal;
}

test "json numeric clamp" {
    assert clamp_i64(
        5,
        0,
        10) ==
        5;

    assert clamp_i64(
        -5,
        0,
        10) ==
        0;

    assert clamp_i64(
        20,
        0,
        10) ==
        10;
}

test "json numeric classifications" {
    assert classify_i64(0) ==
        JsonNumericClass.Zero;

    assert classify_i64(1) ==
        JsonNumericClass.Positive;

    assert classify_i64(-1) ==
        JsonNumericClass.Negative;

    assert classify_u64(0) ==
        JsonNumericClass.Zero;

    assert classify_u64(1) ==
        JsonNumericClass.Positive;

    assert classify_f64(0.0) ==
        JsonNumericClass.Zero;

    assert classify_f64(1.0) ==
        JsonNumericClass.Positive;

    assert classify_f64(-1.0) ==
        JsonNumericClass.Negative;
}

test "json numeric representability" {
    assert fits_i64(
        "9223372036854775807");

    assert !fits_i64(
        "9223372036854775808");

    assert fits_u64(
        "18446744073709551615");

    assert !fits_u64(
        "18446744073709551616");

    assert fits_f64(
        "42.5");
}

test "json numeric metadata" {
    assert error_name(
        JsonNumericError.None) ==
        "none";

    assert error_name(
        JsonNumericError.LeadingZero) ==
        "leading-zero";

    assert error_name(
        JsonNumericError.IntegerOverflow) ==
        "integer-overflow";

    assert kind_name(
        JsonNumericKind.Integer) ==
        "integer";

    assert kind_name(
        JsonNumericKind.Float) ==
        "float";

    assert class_name(
        JsonNumericClass.Positive) ==
        "positive";
}
