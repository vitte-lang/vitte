}

test "roundtrip preserves object type" {
    let first: JsonParseResult =
        parse("{\"a\":1}");

    assert first.ok;

    let encoded: JsonEncodeResult =
        encode(&first.value);

    assert encoded.ok;

    let second: JsonParseResult =
        parse(encoded.text);

    assert second.ok;
    assert json_core::is_object(&second.value);
}

