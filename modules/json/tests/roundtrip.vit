/// -------------------------------------------------------------------------
/// Primitive arrays
/// -------------------------------------------------------------------------

test "roundtrip null array" {
    assert roundtrip_source(
        "[null]");
}

test "roundtrip boolean array" {
    assert roundtrip_source(
        "[true,false,true]");
}

test "roundtrip integer array" {
    assert roundtrip_source(
        "[0,1,-1,42,-42]");
}

test "roundtrip float array" {
    assert roundtrip_source(
        "[0.5,-0.5,1.25,10.75]");
}

test "roundtrip string array" {
    assert roundtrip_source(
        "[\"a\",\"b\",\"c\"]");
}

test "roundtrip heterogeneous array" {
    assert roundtrip_source(
        "[null,true,false,0,42,1.5,\"Vitte\",[],{}]");
}

test "roundtrip array with whitespace" {
    assert roundtrip_source(
        "[ 1 , 2 , 3 ]");
}

test "roundtrip multiline array" {
    assert roundtrip_source(
        "[\n  1,\n  2,\n  3\n]");
}

/// -------------------------------------------------------------------------
/// Nested arrays
/// -------------------------------------------------------------------------

test "roundtrip nested empty arrays" {
    assert roundtrip_source(
        "[[],[],[]]");
}

test "roundtrip nested integer arrays" {
    assert roundtrip_source(
        "[[1,2],[3,4],[5,6]]");
}

test "roundtrip nested heterogeneous arrays" {
    assert roundtrip_source(
        "[[null,true],[42,\"text\"],[[],{}]]");
}

test "roundtrip deeply nested arrays" {
    assert roundtrip_source(
        "[[[[[[[[42]]]]]]]]");
}

