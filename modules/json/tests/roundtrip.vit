}

/// -------------------------------------------------------------------------
/// Stability matrix
/// -------------------------------------------------------------------------

test "stable encoding primitive matrix" {
    assert stable_source("null");
    assert stable_source("true");
    assert stable_source("false");
    assert stable_source("0");
    assert stable_source("1");
    assert stable_source("-1");
    assert stable_source("\"\"");
    assert stable_source("\"Vitte\"");
}

test "stable encoding array matrix" {
    assert stable_source("[]");
    assert stable_source("[1]");
    assert stable_source("[1,2,3]");
    assert stable_source("[null,true,false]");
    assert stable_source("[[],{}]");
}

test "stable encoding object matrix" {
    assert stable_source("{}");
    assert stable_source("{\"a\":1}");
    assert stable_source("{\"a\":1,\"b\":2}");
    assert stable_source("{\"a\":[],\"b\":{}}");
}

/// -------------------------------------------------------------------------
/// Full round-trip matrix
/// -------------------------------------------------------------------------

test "full primitive roundtrip matrix" {
    assert roundtrip_source("null");

    assert roundtrip_source("true");
    assert roundtrip_source("false");

    assert roundtrip_source("0");
    assert roundtrip_source("1");
    assert roundtrip_source("-1");
    assert roundtrip_source("42");
    assert roundtrip_source("-42");

    assert roundtrip_source("0.5");
    assert roundtrip_source("-0.5");
    assert roundtrip_source("1.25");
    assert roundtrip_source("1e3");
    assert roundtrip_source("1e-3");

    assert roundtrip_source("\"\"");
    assert roundtrip_source("\"Vitte\"");
    assert roundtrip_source("\"a\\nb\"");
    assert roundtrip_source("\"\\u0041\"");
}

test "full container roundtrip matrix" {
    assert roundtrip_source("[]");
    assert roundtrip_source("{}");

    assert roundtrip_source(
        "[null,true,false]");

    assert roundtrip_source(
        "[0,1,-1,42,-42]");

    assert roundtrip_source(
        "[\"a\",\"b\",\"c\"]");

    assert roundtrip_source(
        "{\"a\":1}");

    assert roundtrip_source(
        "{\"a\":1,\"b\":2}");

    assert roundtrip_source(
        "{\"a\":[],\"b\":{}}");

    assert roundtrip_source(
        "[{\"a\":1},{\"b\":2}]");
}

/// -------------------------------------------------------------------------
/// Final comprehensive integration
/// -------------------------------------------------------------------------

test "json complete roundtrip integration" {
    let source: string =
        "{" +
        "\"project\":\"Vitte\"," +
        "\"version\":\"1.0.0\"," +
        "\"active\":true," +
        "\"optional\":null," +
        "\"numbers\":{" +
            "\"zero\":0," +
            "\"positive\":42," +
            "\"negative\":-42," +
            "\"fraction\":1.5," +
            "\"exponent\":1e3" +
        "}," +
        "\"strings\":{" +
            "\"empty\":\"\"," +
            "\"plain\":\"hello world\"," +
            "\"quote\":\"a\\\"b\"," +
            "\"backslash\":\"a\\\\b\"," +
            "\"newline\":\"a\\nb\"," +
            "\"tab\":\"a\\tb\"," +
            "\"unicode\":\"caf\\u00E9\"" +
        "}," +
        "\"arrays\":[" +
            "[]," +
            "[1,2,3]," +
            "[null,true,false]," +
            "[{\"id\":1},{\"id\":2}]" +
        "]," +
        "\"object\":{" +
            "\"empty\":{}," +
            "\"nested\":{" +
                "\"value\":42," +
                "\"items\":[" +
                    "{\"name\":\"one\"}," +
                    "{\"name\":\"two\"}" +
                "]" +
            "}" +
        "}" +
        "}";

    let first: JsonParseResult =
        parse(source);

    assert first.ok;
    assert json_core::validate(&first.value);

    let compact: JsonEncodeResult =
        encode_compact(
            &first.value);

    assert compact.ok;

    let compact_parsed: JsonParseResult =
        parse(compact.text);

    assert compact_parsed.ok;
    assert json_core::validate(&compact_parsed.value);

    assert json_core::equals(
        &first.value,
        &compact_parsed.value);

    let pretty: JsonEncodeResult =
        encode_pretty(
            &first.value);

    assert pretty.ok;

    let pretty_parsed: JsonParseResult =
        parse(pretty.text);

    assert pretty_parsed.ok;
    assert json_core::validate(&pretty_parsed.value);

    assert json_core::equals(
        &first.value,
        &pretty_parsed.value);

    assert json_core::equals(
        &compact_parsed.value,
        &pretty_parsed.value);

    let encoded_again: JsonEncodeResult =
        encode_compact(
            &compact_parsed.value);

    assert encoded_again.ok;

    assert compact.text ==
        encoded_again.text;

    assert roundtrip_source(source);
    assert roundtrip_source_twice(source);
    assert pretty_roundtrip_source(source);
    assert stable_source(source);
}