/// -------------------------------------------------------------------------
/// Escaped strings
/// -------------------------------------------------------------------------

test "roundtrip quote escape" {
    assert roundtrip_source(
        "\"a\\\"b\"");
}

test "roundtrip backslash escape" {
    assert roundtrip_source(
        "\"a\\\\b\"");
}

test "roundtrip slash escape" {
    assert roundtrip_source(
        "\"a\\/b\"");
}

test "roundtrip backspace escape" {
    assert roundtrip_source(
        "\"a\\bb\"");
}

test "roundtrip form feed escape" {
    assert roundtrip_source(
        "\"a\\fb\"");
}

test "roundtrip newline escape" {
    assert roundtrip_source(
        "\"a\\nb\"");
}

test "roundtrip carriage return escape" {
    assert roundtrip_source(
        "\"a\\rb\"");
}

test "roundtrip tab escape" {
    assert roundtrip_source(
        "\"a\\tb\"");
}

test "roundtrip all standard escapes" {
    assert roundtrip_source(
        "\"\\\"\\\\\\/\\b\\f\\n\\r\\t\"");
}

test "roundtrip complex escaped string" {
    assert roundtrip_source(
        "\"quote=\\\" slash=\\/ backslash=\\\\ newline=\\n tab=\\t\"");
}

/// -------------------------------------------------------------------------
/// Strings constructed from decoded characters
/// -------------------------------------------------------------------------

test "roundtrip decoded quote value" {
    let value: json_core::JsonValue =
        json_core::string(
            "a\"b");

    assert roundtrip_value(&value);
}

test "roundtrip decoded backslash value" {
    let value: json_core::JsonValue =
        json_core::string(
            "a\\b");

    assert roundtrip_value(&value);
}

test "roundtrip decoded newline value" {
    let value: json_core::JsonValue =
        json_core::string(
            "line1\nline2");

    assert roundtrip_value(&value);
}

test "roundtrip decoded tab value" {
    let value: json_core::JsonValue =
        json_core::string(
            "a\tb");

    assert roundtrip_value(&value);
}

test "roundtrip decoded carriage return value" {
    let value: json_core::JsonValue =
        json_core::string(
            "a\rb");

    assert roundtrip_value(&value);
}

/// -------------------------------------------------------------------------
/// Unicode
/// -------------------------------------------------------------------------

test "roundtrip unicode ascii escape" {
    assert roundtrip_source(
        "\"\\u0041\"");
}

test "roundtrip unicode latin escape" {
    assert roundtrip_source(
        "\"caf\\u00E9\"");
}

test "roundtrip unicode repeated escapes" {
    assert roundtrip_source(
        "\"\\u0041\\u0042\\u0043\"");
}

test "roundtrip unicode literal latin" {
    assert roundtrip_source(
        "\"café\"");
}

test "roundtrip unicode literal greek" {
    assert roundtrip_source(
        "\"αβγ\"");
}

test "roundtrip unicode literal cyrillic" {
    assert roundtrip_source(
        "\"Привет\"");
}

test "roundtrip unicode literal japanese" {
    assert roundtrip_source(
        "\"こんにちは\"");
}

test "roundtrip unicode literal value" {
    let value: json_core::JsonValue =
        json_core::string(
            "café αβγ Привет こんにちは");

    assert roundtrip_value(&value);
}

/// -------------------------------------------------------------------------
/// Supplementary Unicode
/// -------------------------------------------------------------------------

test "roundtrip minimum supplementary scalar" {
    assert roundtrip_source(
        "\"\\uD800\\uDC00\"");
}

test "roundtrip maximum unicode scalar" {
    assert roundtrip_source(
        "\"\\uDBFF\\uDFFF\"");
}

test "roundtrip emoji surrogate pair" {
    assert roundtrip_source(
        "\"\\uD83D\\uDE00\"");
}

