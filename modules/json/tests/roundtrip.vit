        "{}");
}

test "roundtrip empty object stable encoding" {
    assert stable_source(
        "{}");
}

/// -------------------------------------------------------------------------
/// Object primitives
/// -------------------------------------------------------------------------

test "roundtrip object null" {
    assert roundtrip_source(
        "{\"value\":null}");
}

test "roundtrip object boolean" {
    assert roundtrip_source(
        "{\"value\":true}");
}

test "roundtrip object integer" {
    assert roundtrip_source(
        "{\"value\":42}");
}

test "roundtrip object float" {
    assert roundtrip_source(
        "{\"value\":1.5}");
}

test "roundtrip object string" {
    assert roundtrip_source(
        "{\"value\":\"Vitte\"}");
}

test "roundtrip object mixed primitive members" {
    assert roundtrip_source(
        "{" +
        "\"null\":null," +
        "\"true\":true," +
        "\"false\":false," +
        "\"integer\":42," +
        "\"float\":1.5," +
        "\"string\":\"Vitte\"" +
        "}");
}

/// -------------------------------------------------------------------------
/// Empty object keys
/// -------------------------------------------------------------------------

test "roundtrip empty object key" {
    assert roundtrip_source(
        "{\"\":42}");
}

test "roundtrip empty and nonempty keys" {
    assert roundtrip_source(
        "{\"\":1,\"a\":2}");
}

/// -------------------------------------------------------------------------
/// Escaped object keys
/// -------------------------------------------------------------------------

test "roundtrip quoted object key" {
    assert roundtrip_source(
        "{\"a\\\"b\":1}");
}

test "roundtrip backslash object key" {
    assert roundtrip_source(
        "{\"a\\\\b\":1}");
}

test "roundtrip unicode object key" {
    assert roundtrip_source(
        "{\"caf\\u00E9\":1}");
}

test "roundtrip newline escaped object key" {
    assert roundtrip_source(
        "{\"line\\nkey\":1}");
}

/// -------------------------------------------------------------------------
/// Multiple object members
/// -------------------------------------------------------------------------

test "roundtrip object multiple members" {
    assert roundtrip_source(
        "{\"a\":1,\"b\":2,\"c\":3}");
}

test "roundtrip object heterogeneous members" {
    assert roundtrip_source(
        "{" +
        "\"a\":null," +
        "\"b\":true," +
        "\"c\":42," +
        "\"d\":1.5," +
        "\"e\":\"text\"," +
        "\"f\":[]," +
        "\"g\":{}" +
        "}");
}

test "roundtrip object whitespace" {
    assert roundtrip_source(
        "{ \"a\" : 1 , \"b\" : 2 }");
}

test "roundtrip multiline object" {
    assert roundtrip_source(
        "{\n" +
        "  \"a\": 1,\n" +
        "  \"b\": 2\n" +
        "}");
}

/// -------------------------------------------------------------------------
/// Nested objects
/// -------------------------------------------------------------------------

test "roundtrip nested object" {
    assert roundtrip_source(
        "{\"outer\":{\"inner\":42}}");
}

test "roundtrip deeply nested object" {
    assert roundtrip_source(
        "{\"a\":{\"b\":{\"c\":{\"d\":{\"e\":42}}}}}");
}

/// -------------------------------------------------------------------------
/// Arrays and objects
/// -------------------------------------------------------------------------

test "roundtrip object containing array" {
    assert roundtrip_source(
        "{\"values\":[1,2,3]}");
}

test "roundtrip array containing objects" {
    assert roundtrip_source(
        "[{\"id\":1},{\"id\":2},{\"id\":3}]");
}

test "roundtrip object containing object array" {
    assert roundtrip_source(
        "{" +
        "\"users\":[" +
            "{\"id\":1,\"name\":\"one\"}," +
            "{\"id\":2,\"name\":\"two\"}" +
        "]" +
        "}");
}

test "roundtrip mixed recursive tree" {
    assert roundtrip_source(
        "{" +
        "\"a\":[" +
            "{\"b\":[1,2,3]}," +
            "{\"c\":true}" +
        "]," +
        "\"d\":null" +
        "}");
}

/// -------------------------------------------------------------------------
/// Compact encoder
/// -------------------------------------------------------------------------

test "compact roundtrip primitive" {
    let first: JsonParseResult =
        parse("42");

    assert first.ok;

    let encoded: JsonEncodeResult =
        encode_compact(
            &first.value);

    assert encoded.ok;

    let second: JsonParseResult =
        parse(encoded.text);

    assert second.ok;

    assert json_core::equals(
        &first.value,
        &second.value);
}

test "compact roundtrip array" {
    let first: JsonParseResult =
        parse(
            "[1,2,3]");

    assert first.ok;

    let encoded: JsonEncodeResult =
        encode_compact(
            &first.value);

    assert encoded.ok;

    let second: JsonParseResult =
        parse(encoded.text);

    assert second.ok;

    assert json_core::equals(
        &first.value,
        &second.value);
}

test "compact roundtrip object" {
    let first: JsonParseResult =
        parse(
            "{\"a\":1,\"b\":2}");

    assert first.ok;

    let encoded: JsonEncodeResult =
        encode_compact(
            &first.value);

    assert encoded.ok;

    let second: JsonParseResult =
        parse(encoded.text);

    assert second.ok;

    assert json_core::equals(
        &first.value,
        &second.value);
}

/// -------------------------------------------------------------------------
/// Pretty encoder
/// -------------------------------------------------------------------------

test "pretty roundtrip null" {
    assert pretty_roundtrip_source(
        "null");
}

test "pretty roundtrip primitive array" {
    assert pretty_roundtrip_source(
        "[null,true,false,42,\"Vitte\"]");
}

test "pretty roundtrip object" {
    assert pretty_roundtrip_source(
        "{\"name\":\"Vitte\",\"version\":1}");
}

test "pretty roundtrip nested object" {
    assert pretty_roundtrip_source(
        "{" +
        "\"project\":\"Vitte\"," +
        "\"compiler\":{" +
            "\"backend\":\"c17\"," +
            "\"optimization\":2" +
        "}," +
        "\"targets\":[" +
            "\"macos-arm64\"," +
            "\"linux-x86_64\"" +
        "]" +
        "}");
}

/// -------------------------------------------------------------------------
/// Pretty output remains valid JSON
/// -------------------------------------------------------------------------

test "pretty encoded array parses" {
    let parsed_value: JsonParseResult =
        parse(
            "[1,2,3]");

    assert parsed_value.ok;

    let encoded: JsonEncodeResult =
        encode_pretty(
            &parsed_value.value);

    assert encoded.ok;
    assert parses(encoded.text);
}

test "pretty encoded object parses" {
    let parsed_value: JsonParseResult =
        parse(
            "{\"a\":1,\"b\":[2,3]}");

    assert parsed_value.ok;

    let encoded: JsonEncodeResult =
        encode_pretty(
            &parsed_value.value);

    assert encoded.ok;
    assert parses(encoded.text);
}

/// -------------------------------------------------------------------------
/// Canonicalization through encode
/// -------------------------------------------------------------------------

test "roundtrip removes insignificant leading whitespace" {
    let parsed_value: JsonParseResult =
        parse(
            "   [1,2,3]");

    assert parsed_value.ok;

    let encoded: JsonEncodeResult =
        encode(
            &parsed_value.value);

    assert encoded.ok;

    let reparsed: JsonParseResult =
        parse(encoded.text);

    assert reparsed.ok;

    assert json_core::equals(
        &parsed_value.value,
        &reparsed.value);
}

test "roundtrip removes insignificant trailing whitespace" {
    let parsed_value: JsonParseResult =
        parse(
            "[1,2,3]   ");

    assert parsed_value.ok;

    let encoded: JsonEncodeResult =
        encode(
            &parsed_value.value);

    assert encoded.ok;

    let reparsed: JsonParseResult =
        parse(encoded.text);

    assert reparsed.ok;

    assert json_core::equals(
        &parsed_value.value,
        &reparsed.value);
}

test "roundtrip removes structural whitespace" {
    let parsed_value: JsonParseResult =
        parse(
            "{ \"a\" : [ 1 , 2 , 3 ] }");

    assert parsed_value.ok;

    let encoded: JsonEncodeResult =
        encode_compact(
            &parsed_value.value);

    assert encoded.ok;

    let reparsed: JsonParseResult =
        parse(encoded.text);

    assert reparsed.ok;

    assert json_core::equals(
        &parsed_value.value,
        &reparsed.value);
}

/// -------------------------------------------------------------------------
/// Escape canonicalization
/// -------------------------------------------------------------------------

test "escaped slash roundtrip remains equivalent" {
    let first: JsonParseResult =
        parse(
            "\"a\\/b\"");

    assert first.ok;

    let encoded: JsonEncodeResult =
        encode(
            &first.value);

    assert encoded.ok;

    let second: JsonParseResult =
        parse(encoded.text);

    assert second.ok;

    assert json_core::equals(
        &first.value,
        &second.value);
}

test "unicode escape roundtrip remains equivalent" {
    let first: JsonParseResult =
        parse(
            "\"caf\\u00E9\"");

    assert first.ok;

    let encoded: JsonEncodeResult =
        encode(
            &first.value);

    assert encoded.ok;

    let second: JsonParseResult =
        parse(encoded.text);

    assert second.ok;

    assert json_core::equals(
        &first.value,
        &second.value);
}

test "short escape roundtrip remains equivalent" {
    let first: JsonParseResult =
        parse(
            "\"a\\nb\\tc\"");

    assert first.ok;

    let encoded: JsonEncodeResult =
        encode(
            &first.value);

    assert encoded.ok;

    let second: JsonParseResult =
        parse(encoded.text);

    assert second.ok;

    assert json_core::equals(
        &first.value,
        &second.value);
}

/// -------------------------------------------------------------------------
/// Repeated round trips
/// -------------------------------------------------------------------------

test "repeat primitive roundtrip" {
    assert roundtrip_source_twice(
        "42");
}

test "repeat string roundtrip" {
    assert roundtrip_source_twice(
        "\"Vitte\"");
}

test "repeat escaped string roundtrip" {
    assert roundtrip_source_twice(
        "\"a\\nb\\tc\"");
}

test "repeat array roundtrip" {
    assert roundtrip_source_twice(
        "[null,true,42,\"Vitte\"]");
}

test "repeat object roundtrip" {
    assert roundtrip_source_twice(
        "{\"name\":\"Vitte\",\"version\":1}");
}

test "repeat nested roundtrip" {
    assert roundtrip_source_twice(
        "{" +
        "\"a\":[" +
            "{\"b\":1}," +
            "{\"b\":2}" +
        "]" +
        "}");
}

/// -------------------------------------------------------------------------
/// Deterministic encoding
/// -------------------------------------------------------------------------

test "encoding same primitive twice is deterministic" {
    let parsed_value: JsonParseResult =
        parse("42");

    assert parsed_value.ok;

    let first: JsonEncodeResult =
        encode(
            &parsed_value.value);

    let second: JsonEncodeResult =
        encode(
            &parsed_value.value);

    assert first.ok;
    assert second.ok;
    assert first.text == second.text;
}

test "encoding same string twice is deterministic" {
    let parsed_value: JsonParseResult =
        parse(
            "\"a\\nb\"");

    assert parsed_value.ok;

    let first: JsonEncodeResult =
        encode(
            &parsed_value.value);

    let second: JsonEncodeResult =
        encode(
            &parsed_value.value);

    assert first.ok;
    assert second.ok;
    assert first.text == second.text;
}

test "encoding same array twice is deterministic" {
    let parsed_value: JsonParseResult =
        parse(
            "[1,2,3]");

    assert parsed_value.ok;

    let first: JsonEncodeResult =
        encode(
            &parsed_value.value);

    let second: JsonEncodeResult =
        encode(
            &parsed_value.value);

    assert first.ok;
    assert second.ok;
    assert first.text == second.text;
}

test "encoding same object twice is deterministic" {
    let parsed_value: JsonParseResult =
        parse(
            "{\"z\":1,\"a\":2,\"m\":3}");

    assert parsed_value.ok;

    let first: JsonEncodeResult =
        encode(
            &parsed_value.value);

    let second: JsonEncodeResult =
        encode(
            &parsed_value.value);

    assert first.ok;
    assert second.ok;
    assert first.text == second.text;
}

/// -------------------------------------------------------------------------
/// Member order preservation
/// -------------------------------------------------------------------------

test "roundtrip preserves object member ordering" {
    let first: JsonParseResult =
        parse(
            "{\"z\":1,\"a\":2,\"m\":3}");

    assert first.ok;

    let encoded: JsonEncodeResult =
        encode(
            &first.value);

    assert encoded.ok;

    let second: JsonParseResult =
        parse(encoded.text);

    assert second.ok;
    assert json_core::object_len(&second.value) == 3;

    let member0: &json_core::JsonMember =
        json_core::object_member_ref(
            &second.value,
            0);

    let member1: &json_core::JsonMember =
        json_core::object_member_ref(
            &second.value,
            1);

    let member2: &json_core::JsonMember =
        json_core::object_member_ref(
            &second.value,
            2);

    assert member0.key == "z";
    assert member1.key == "a";
    assert member2.key == "m";
}

