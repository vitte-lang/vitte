    assert second.ok;
    assert json_core::is_string(&second.value);
}

test "roundtrip preserves array type" {
    let first: JsonParseResult =
        parse("[1,2,3]");

    assert first.ok;

    let encoded: JsonEncodeResult =
        encode(&first.value);

    assert encoded.ok;

    let second: JsonParseResult =
