/// -------------------------------------------------------------------------
/// Encoder output can always be reparsed
/// -------------------------------------------------------------------------

test "encoded null reparses" {
    let value: json_core::JsonValue =
        json_core::null_value();

    let encoded: JsonEncodeResult =
        encode(&value);

    assert encoded.ok;
    assert parses(encoded.text);
}

test "encoded boolean reparses" {
    let value: json_core::JsonValue =
        json_core::boolean(true);

    let encoded: JsonEncodeResult =
        encode(&value);

    assert encoded.ok;
    assert parses(encoded.text);
}

test "encoded integer reparses" {
    let value: json_core::JsonValue =
        json_core::integer(42);

    let encoded: JsonEncodeResult =
        encode(&value);

    assert encoded.ok;
    assert parses(encoded.text);
}

test "encoded string reparses" {
    let value: json_core::JsonValue =
        json_core::string(
            "Vitte\nJSON\t\"test\"");

    let encoded: JsonEncodeResult =
        encode(&value);

    assert encoded.ok;
    assert parses(encoded.text);
}

/// -------------------------------------------------------------------------
/// Whitespace normalization
/// -------------------------------------------------------------------------

test "whitespace variants produce equivalent values" {
    let compact: JsonParseResult =
        parse(
            "{\"a\":[1,2,3],\"b\":true}");

    let spaced: JsonParseResult =
        parse(
            " { \"a\" : [ 1 , 2 , 3 ] , \"b\" : true } ");

    let multiline: JsonParseResult =
        parse(
            "{\n" +
            "  \"a\": [\n" +
            "    1,\n" +
            "    2,\n" +
            "    3\n" +
            "  ],\n" +
            "  \"b\": true\n" +
            "}");

    assert compact.ok;
    assert spaced.ok;
    assert multiline.ok;

    assert json_core::equals(
        &compact.value,
        &spaced.value);

    assert json_core::equals(
        &spaced.value,
        &multiline.value);
}

/// -------------------------------------------------------------------------
/// Escape representations normalize to equivalent values
/// -------------------------------------------------------------------------

test "literal and unicode escaped ascii are equivalent" {
    let literal: JsonParseResult =
        parse("\"A\"");

    let escaped: JsonParseResult =
        parse("\"\\u0041\"");

    assert literal.ok;
    assert escaped.ok;

    assert json_core::equals(
        &literal.value,
        &escaped.value);
}

test "literal and unicode escaped latin are equivalent" {
    let literal: JsonParseResult =
        parse("\"café\"");

    let escaped: JsonParseResult =
        parse("\"caf\\u00E9\"");

    assert literal.ok;
    assert escaped.ok;

    assert json_core::equals(
        &literal.value,
        &escaped.value);
}

test "escaped slash and literal slash are equivalent" {
    let literal: JsonParseResult =
        parse("\"a/b\"");

    let escaped: JsonParseResult =
        parse("\"a\\/b\"");

    assert literal.ok;
    assert escaped.ok;

    assert json_core::equals(
        &literal.value,
        &escaped.value);
}

/// -------------------------------------------------------------------------
/// Type preservation
/// -------------------------------------------------------------------------

test "roundtrip preserves null type" {
    let first: JsonParseResult =
        parse("null");

    assert first.ok;

    let encoded: JsonEncodeResult =
        encode(&first.value);

    assert encoded.ok;

    let second: JsonParseResult =
        parse(encoded.text);

    assert second.ok;
    assert json_core::is_null(&second.value);
}

test "roundtrip preserves boolean type" {
    let first: JsonParseResult =
        parse("true");

    assert first.ok;

    let encoded: JsonEncodeResult =
        encode(&first.value);

    assert encoded.ok;

    let second: JsonParseResult =
        parse(encoded.text);

    assert second.ok;
    assert json_core::is_bool(&second.value);
}

