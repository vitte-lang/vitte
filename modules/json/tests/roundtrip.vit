}

test "roundtrip preserves string type" {
    let first: JsonParseResult =
        parse("\"42\"");

    assert first.ok;

    let encoded: JsonEncodeResult =
        encode(&first.value);

    assert encoded.ok;

    let second: JsonParseResult =
