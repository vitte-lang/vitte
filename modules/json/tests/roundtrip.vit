/// Comprehensive JSON encode/decode round-trip tests.
///
/// This suite verifies the central JSON invariant:
///
///     parse(encode(value)) == value
///
/// and, where appropriate:
///
///     encode(parse(source))
///
/// produces valid JSON that parses back to an equivalent value.
///
/// Coverage:
///
/// - null
/// - booleans
/// - integers
/// - floating-point values
/// - strings
/// - escape sequences
/// - Unicode
/// - arrays
/// - objects
/// - nested structures
/// - compact encoding
/// - pretty encoding
/// - parser/encoder interoperability
/// - repeated round trips
/// - structural equality
/// - deterministic encoding
/// - realistic documents
/// - regression cases

space json::tests::roundtrip;

use json::core::value as json_core;
use json::encode::encoder::{
    JsonEncodeResult,
    encode,
    encode_compact,
    encode_pretty
};
use json::parser::parser::{
    JsonParseResult,
    parse
};

/// -------------------------------------------------------------------------
/// Helpers
/// -------------------------------------------------------------------------

proc roundtrip_value(value: &json_core::JsonValue) -> bool {
    let encoded: JsonEncodeResult =
        encode(value);

    if !encoded.ok {
        give false;
    }

    let decoded: JsonParseResult =
        parse(encoded.text);

    if !decoded.ok {
        give false;
    }

    give json_core::equals(
        value,
        &decoded.value);
}

proc roundtrip_source(source: string) -> bool {
    let first: JsonParseResult =
        parse(source);

    if !first.ok {
        give false;
    }

    let encoded: JsonEncodeResult =
        encode(&first.value);

    if !encoded.ok {
        give false;
    }

    let second: JsonParseResult =
        parse(encoded.text);

    if !second.ok {
        give false;
    }

    give json_core::equals(
        &first.value,
        &second.value);
}

proc roundtrip_source_twice(source: string) -> bool {
    let first: JsonParseResult =
        parse(source);

    if !first.ok {
        give false;
    }

    let encoded_first: JsonEncodeResult =
        encode(&first.value);

    if !encoded_first.ok {
        give false;
    }

    let second: JsonParseResult =
        parse(encoded_first.text);

    if !second.ok {
        give false;
    }

    let encoded_second: JsonEncodeResult =
        encode(&second.value);

    if !encoded_second.ok {
        give false;
    }

    let third: JsonParseResult =
        parse(encoded_second.text);

    if !third.ok {
        give false;
    }

    give
        json_core::equals(
            &first.value,
            &second.value)
        &&
        json_core::equals(
            &second.value,
            &third.value);
}

proc stable_source(source: string) -> bool {
    let parsed_value: JsonParseResult =
        parse(source);

    if !parsed_value.ok {
        give false;
    }

    let first: JsonEncodeResult =
        encode(&parsed_value.value);

    if !first.ok {
        give false;
    }

    let reparsed: JsonParseResult =
        parse(first.text);

    if !reparsed.ok {
        give false;
    }

    let second: JsonEncodeResult =
        encode(&reparsed.value);

    if !second.ok {
        give false;
    }

    give first.text == second.text;
}

proc pretty_roundtrip_source(source: string) -> bool {
    let first: JsonParseResult =
        parse(source);

    if !first.ok {
        give false;
    }

    let encoded: JsonEncodeResult =
        encode_pretty(&first.value);

    if !encoded.ok {
        give false;
    }

    let second: JsonParseResult =
        parse(encoded.text);

    if !second.ok {
        give false;
    }

    give json_core::equals(
        &first.value,
        &second.value);
}

/// -------------------------------------------------------------------------
/// Null
/// -------------------------------------------------------------------------

test "roundtrip null value" {
    let value: json_core::JsonValue =
        json_core::null_value();

    assert roundtrip_value(&value);
}

test "roundtrip null source" {
    assert roundtrip_source("null");
}

test "roundtrip null whitespace source" {
    assert roundtrip_source(
        " \t\r\n null \t\r\n ");
}

test "roundtrip null repeated" {
    assert roundtrip_source_twice(
        "null");
}

test "roundtrip null stable encoding" {
    assert stable_source(
        "null");
}

/// -------------------------------------------------------------------------
/// Booleans
/// -------------------------------------------------------------------------

test "roundtrip true value" {
    let value: json_core::JsonValue =
        json_core::boolean(true);

    assert roundtrip_value(&value);
}

test "roundtrip false value" {
    let value: json_core::JsonValue =
        json_core::boolean(false);

    assert roundtrip_value(&value);
}

test "roundtrip true source" {
    assert roundtrip_source(
        "true");
}

test "roundtrip false source" {
    assert roundtrip_source(
        "false");
}

test "roundtrip true repeated" {
    assert roundtrip_source_twice(
        "true");
}

test "roundtrip false repeated" {
    assert roundtrip_source_twice(
        "false");
}

test "roundtrip boolean stable encoding" {
    assert stable_source("true");
    assert stable_source("false");
}

/// -------------------------------------------------------------------------
/// Integers
/// -------------------------------------------------------------------------

test "roundtrip integer zero value" {
    let value: json_core::JsonValue =
        json_core::integer(0);

    assert roundtrip_value(&value);
}

test "roundtrip integer one value" {
    let value: json_core::JsonValue =
        json_core::integer(1);

    assert roundtrip_value(&value);
}

test "roundtrip integer negative one value" {
    let value: json_core::JsonValue =
        json_core::integer(-1);

    assert roundtrip_value(&value);
}

test "roundtrip integer forty two value" {
    let value: json_core::JsonValue =
        json_core::integer(42);

    assert roundtrip_value(&value);
}

test "roundtrip integer negative forty two value" {
    let value: json_core::JsonValue =
        json_core::integer(-42);

    assert roundtrip_value(&value);
}

test "roundtrip integer zero source" {
    assert roundtrip_source("0");
}

test "roundtrip integer positive source" {
    assert roundtrip_source("42");
}

test "roundtrip integer negative source" {
    assert roundtrip_source("-42");
}

test "roundtrip large positive integer source" {
    assert roundtrip_source(
        "123456789");
}

test "roundtrip large negative integer source" {
    assert roundtrip_source(
        "-123456789");
}

test "roundtrip i64 maximum source" {
    assert roundtrip_source(
        "9223372036854775807");
}

test "roundtrip i64 minimum source" {
    assert roundtrip_source(
        "-9223372036854775808");
}

test "roundtrip integer stable encoding" {
    assert stable_source("0");
    assert stable_source("1");
    assert stable_source("-1");
    assert stable_source("42");
    assert stable_source("-42");
}

