test "roundtrip negative fractional source" {
    assert roundtrip_source(
        "-0.125");
}

test "roundtrip long fractional source" {
    assert roundtrip_source(
        "12345.6789");
}

test "roundtrip small fractional source" {
    assert roundtrip_source(
        "0.000001");
}

test "roundtrip exponent source" {
    assert roundtrip_source(
        "1e3");
}

test "roundtrip uppercase exponent source" {
    assert roundtrip_source(
        "1E3");
}

test "roundtrip positive exponent source" {
    assert roundtrip_source(
        "1e+3");
}

test "roundtrip negative exponent source" {
