        json_core::string("Vitte");

    assert roundtrip_value(&value);
}

test "roundtrip string with spaces value" {
    let value: json_core::JsonValue =
        json_core::string(
            "Vitte programming language");

    assert roundtrip_value(&value);
}

test "roundtrip simple string source" {
    assert roundtrip_source(
        "\"Vitte\"");
}

test "roundtrip string with spaces source" {
    assert roundtrip_source(
        "\"hello world\"");
}

test "roundtrip numeric looking string" {
    assert roundtrip_source(
        "\"42\"");
}

test "roundtrip boolean looking string" {
    assert roundtrip_source(
        "\"true\"");
}

test "roundtrip null looking string" {
    assert roundtrip_source(
        "\"null\"");
}

test "roundtrip punctuation string" {
    assert roundtrip_source(
        "\"{}[],:\"");
}

test "roundtrip string stable encoding" {
