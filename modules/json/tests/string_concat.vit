proc concatenate(
    left: string,
    right: string,
    suffix: char
) -> string {
    let mut result: string = left;
    set result = result + right;
    set result = result + suffix;
    give result;
}

export proc main() -> int {
    let result: string = concatenate("a", "b", 'c');
    if result.length == 3 and
        result[0] == 'a' and
        result[1] == 'b' and
        result[2] == 'c' {
        give 0;
    }
    give 1;
}
