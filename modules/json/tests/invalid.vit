        "[{\"a\":1,}]");
}

test "invalid object array missing comma" {
    assert rejects(
        "{\"a\":[1 2]}");
}

test "invalid array object missing colon" {
    assert rejects(
        "[{\"a\" 1}]");
}

test "invalid deeply nested missing close" {
    assert rejects(
        "{\"a\":[{\"b\":[1,2,3]}]");
}

test "invalid deeply nested extra close" {
    assert rejects(
        "{\"a\":[{\"b\":[1,2,3]}]]}");
}

/// -------------------------------------------------------------------------
/// Invalid structural whitespace placement does not repair syntax
/// -------------------------------------------------------------------------

test "whitespace cannot repair missing array comma" {
    assert rejects(
        "[1     2]");
}

test "newline cannot repair missing array comma" {
    assert rejects(
        "[1\n2]");
}

test "whitespace cannot repair missing object colon" {
    assert rejects(
        "{\"a\"     1}");
}

test "newline cannot repair missing object colon" {
    assert rejects(
        "{\"a\"\n1}");
}

test "whitespace cannot repair missing object comma" {
    assert rejects(
        "{\"a\":1     \"b\":2}");
}

test "newline cannot repair missing object comma" {
    assert rejects(
        "{\"a\":1\n\"b\":2}");
}

/// -------------------------------------------------------------------------
/// Lexer rejection
/// -------------------------------------------------------------------------

test "lexer rejects unknown identifier" {
    assert lex_rejects("hello");
}

test "lexer rejects malformed null literal" {
    assert lex_rejects("nul");
}

test "lexer rejects malformed true literal" {
    assert lex_rejects("tru");
}

test "lexer rejects malformed false literal" {
    assert lex_rejects("fals");
}

test "lexer rejects leading plus number" {
    assert lex_rejects("+1");
}

test "lexer rejects leading zero number" {
    assert lex_rejects("01");
}

test "lexer rejects trailing decimal point" {
    assert lex_rejects("1.");
}

test "lexer rejects malformed exponent" {
    assert lex_rejects("1e");
}

test "lexer rejects invalid string escape" {
    assert lex_rejects("\"\\x\"");
}

test "lexer rejects incomplete unicode escape" {
    assert lex_rejects("\"\\u000\"");
}

test "lexer rejects lone high surrogate" {
    assert lex_rejects("\"\\uD800\"");
}

test "lexer rejects lone low surrogate" {
    assert lex_rejects("\"\\uDC00\"");
}

test "lexer rejects unterminated string" {
    assert lex_rejects("\"hello");
}

/// -------------------------------------------------------------------------
/// Parser-only structural rejection
/// -------------------------------------------------------------------------

test "parser rejects empty token stream source" {
    let result: JsonParseResult =
        parse("");

    assert !result.ok;
}

test "parser rejects empty array missing end delimiter" {
    let result: JsonParseResult =
        parse("[");

    assert !result.ok;
}

test "parser rejects empty object missing end delimiter" {
    let result: JsonParseResult =
        parse("{");

    assert !result.ok;
}

test "parser rejects unexpected comma at root" {
    let result: JsonParseResult =
        parse(",");

    assert !result.ok;
}

test "parser rejects unexpected colon at root" {
    let result: JsonParseResult =
        parse(":");

    assert !result.ok;
}

/// -------------------------------------------------------------------------
/// Failure location sanity
/// -------------------------------------------------------------------------

test "invalid result has deterministic first failure" {
    let first: JsonParseResult =
        parse("[1,,2]");

    let second: JsonParseResult =
        parse("[1,,2]");

    assert !first.ok;
    assert !second.ok;

    assert first.diagnostic.error ==
        second.diagnostic.error;
}

test "invalid lexer result has deterministic first failure" {
    let first: JsonLexerResult =
        lex("\"\\x\"");

    let second: JsonLexerResult =
        lex("\"\\x\"");

    assert !first.ok;
    assert !second.ok;

    assert first.error.error ==
        second.error.error;
}

/// -------------------------------------------------------------------------
/// Repeated malformed parsing
/// -------------------------------------------------------------------------

test "invalid parse is repeatable" {
    let source: string =
        "{\"a\":[1,2,]}";

    let first: JsonParseResult =
        parse(source);

    let second: JsonParseResult =
        parse(source);

    let third: JsonParseResult =
        parse(source);

    assert !first.ok;
    assert !second.ok;
    assert !third.ok;

    assert first.diagnostic.error ==
        second.diagnostic.error;

    assert second.diagnostic.error ==
        third.diagnostic.error;
}

test "invalid parse does not contaminate later valid parse" {
    let invalid_result: JsonParseResult =
        parse("[1,,2]");

    assert !invalid_result.ok;

    let valid_result: JsonParseResult =
        parse("[1,2]");

    assert valid_result.ok;
}

test "valid parse does not hide later invalid parse" {
    let valid_result: JsonParseResult =
        parse("{\"a\":1}");

    assert valid_result.ok;

    let invalid_result: JsonParseResult =
        parse("{\"a\":}");

    assert !invalid_result.ok;
}

/// -------------------------------------------------------------------------
/// Multiple malformed constructs
/// -------------------------------------------------------------------------

test "invalid document with several errors still fails" {
    assert rejects(
        "{\"a\":[1,,2],\"b\":01,}");
}

test "invalid nested document with several errors still fails" {
    assert rejects(
        "{\"a\":{\"b\":[true false],\"c\":1.}}");
}

test "invalid malformed strings and numbers still fail" {
    assert rejects(
        "[\"\\x\",01,1e]");
}

/// -------------------------------------------------------------------------
/// JSON5 extensions are rejected
/// -------------------------------------------------------------------------

test "invalid json5 unquoted key" {
    assert rejects(
        "{key:1}");
}

test "invalid json5 single quote" {
    assert rejects(
        "{'key':'value'}");
}

test "invalid json5 trailing array comma" {
    assert rejects(
        "[1,2,3,]");
}

test "invalid json5 trailing object comma" {
    assert rejects(
        "{\"a\":1,}");
}

test "invalid json5 hexadecimal" {
    assert rejects(
        "{\"value\":0x10}");
}

test "invalid json5 leading plus" {
    assert rejects(
        "{\"value\":+1}");
}

test "invalid json5 infinity" {
    assert rejects(
        "{\"value\":Infinity}");
}

test "invalid json5 nan" {
    assert rejects(
        "{\"value\":NaN}");
}

test "invalid json5 line comment" {
    assert rejects(
        "{\"a\":1 // comment\n}");
}

test "invalid json5 block comment" {
    assert rejects(
        "{\"a\":/* comment */1}");
}

/// -------------------------------------------------------------------------
/// JavaScript expressions are rejected
/// -------------------------------------------------------------------------

test "invalid javascript undefined" {
    assert rejects("undefined");
}

test "invalid javascript new expression" {
    assert rejects("new Object()");
}

test "invalid javascript function" {
    assert rejects("function(){}");
}

test "invalid javascript arrow function" {
    assert rejects("()=>1");
}

test "invalid javascript expression" {
    assert rejects("1+2");
}

test "invalid javascript multiplication" {
    assert rejects("2*3");
}

test "invalid javascript parenthesized value" {
    assert rejects("(1)");
}

test "invalid javascript array hole" {
    assert rejects("[1,,3]");
}

/// -------------------------------------------------------------------------
/// Vitte syntax is not JSON
/// -------------------------------------------------------------------------

test "invalid vitte boolean operator" {
    assert rejects("true && false");
}

test "invalid vitte integer suffix" {
    assert rejects("42i64");
}

test "invalid vitte hexadecimal literal" {
    assert rejects("0xff");
}

test "invalid vitte list statement syntax" {
    assert rejects("let value = 1;");
}

test "invalid vitte block" {
    assert rejects("{ let x = 1; }");
}

/// -------------------------------------------------------------------------
/// Root separators are rejected
/// -------------------------------------------------------------------------

test "invalid root leading comma before null" {
    assert rejects(",null");
}

test "invalid root trailing comma after null" {
    assert rejects("null,");
}

test "invalid root leading colon" {
    assert rejects(":null");
}

test "invalid root trailing colon" {
    assert rejects("null:");
}

test "invalid root semicolon" {
    assert rejects("null;");
}

/// -------------------------------------------------------------------------
/// Array colon misuse
/// -------------------------------------------------------------------------

test "invalid array colon between values" {
    assert rejects("[1:2]");
}

test "invalid array colon before value" {
    assert rejects("[:1]");
}

test "invalid array colon after value" {
    assert rejects("[1:]");
}

test "invalid array repeated colon" {
    assert rejects("[1::2]");
}

/// -------------------------------------------------------------------------
/// Object colon misuse
/// -------------------------------------------------------------------------

test "invalid object colon before key" {
    assert rejects("{:\"a\"}");
}

test "invalid object repeated colon after key" {
    assert rejects("{\"a\"::1}");
}

test "invalid object colon after value" {
    assert rejects("{\"a\":1:2}");
}

/// -------------------------------------------------------------------------
/// Extra closing delimiters
/// -------------------------------------------------------------------------

test "invalid extra right bracket after array" {
    assert rejects("[]]");
}

test "invalid extra right brace after object" {
    assert rejects("{}}");
}

test "invalid extra right bracket after null" {
    assert rejects("null]");
}

test "invalid extra right brace after true" {
    assert rejects("true}");
}

test "invalid multiple extra delimiters" {
    assert rejects("[]}}]]");
}

/// -------------------------------------------------------------------------
/// Extra opening delimiters
/// -------------------------------------------------------------------------

test "invalid unmatched opening array before value" {
    assert rejects("[null");
}

test "invalid unmatched opening object before value" {
    assert rejects("{\"a\":null");
}

test "invalid multiple unmatched arrays" {
    assert rejects("[[[null]]");
}

test "invalid multiple unmatched objects" {
    assert rejects("{\"a\":{\"b\":{}}");
}

/// -------------------------------------------------------------------------
/// Invalid escaped object keys
/// -------------------------------------------------------------------------

test "invalid object key escape" {
    assert rejects(
        "{\"a\\x\":1}");
}

test "invalid object key incomplete unicode" {
    assert rejects(
        "{\"a\\u00\":1}");
}

test "invalid object key lone high surrogate" {
    assert rejects(
        "{\"\\uD800\":1}");
}

test "invalid object key lone low surrogate" {
    assert rejects(
        "{\"\\uDC00\":1}");
}

/// -------------------------------------------------------------------------
/// Invalid escaped array strings
/// -------------------------------------------------------------------------

test "invalid array string escape" {
    assert rejects(
        "[\"a\\x\"]");
}

test "invalid array string incomplete unicode" {
    assert rejects(
        "[\"a\\u00\"]");
}

test "invalid array string lone high surrogate" {
    assert rejects(
        "[\"\\uD800\"]");
}

test "invalid array string lone low surrogate" {
    assert rejects(
        "[\"\\uDC00\"]");
}

/// -------------------------------------------------------------------------
/// Number errors inside containers
/// -------------------------------------------------------------------------

test "invalid leading zero inside array" {
    assert rejects("[01]");
}

test "invalid leading zero inside object" {
    assert rejects("{\"n\":01}");
}

test "invalid decimal inside array" {
    assert rejects("[1.]");
}

test "invalid decimal inside object" {
    assert rejects("{\"n\":1.}");
}

test "invalid exponent inside array" {
    assert rejects("[1e]");
}

test "invalid exponent inside object" {
    assert rejects("{\"n\":1e}");

}

test "invalid plus number inside array" {
    assert rejects("[+1]");
}

test "invalid plus number inside object" {
    assert rejects("{\"n\":+1}");
}

/// -------------------------------------------------------------------------
/// Literal errors inside containers
/// -------------------------------------------------------------------------

test "invalid null literal inside array" {
    assert rejects("[nul]");
}

test "invalid true literal inside array" {
    assert rejects("[tru]");
}

test "invalid false literal inside array" {
    assert rejects("[fals]");
}

test "invalid null literal inside object" {
    assert rejects("{\"x\":nul}");
}

test "invalid true literal inside object" {
    assert rejects("{\"x\":tru}");
}

test "invalid false literal inside object" {
    assert rejects("{\"x\":fals}");
}

/// -------------------------------------------------------------------------
/// Case sensitivity
/// -------------------------------------------------------------------------

test "invalid uppercase literals in array" {
    assert rejects(
        "[NULL,TRUE,FALSE]");
}

test "invalid uppercase literals in object" {
    assert rejects(
        "{\"a\":NULL,\"b\":TRUE,\"c\":FALSE}");
}

test "invalid mixed case literals" {
    assert rejects(
        "[Null,True,False]");
}

/// -------------------------------------------------------------------------
/// Valid whitespace cannot hide trailing garbage
/// -------------------------------------------------------------------------

test "invalid trailing garbage after spaces" {
    assert rejects(
        "null   x");
}

test "invalid trailing garbage after newline" {
    assert rejects(
        "null\nx");
}

test "invalid trailing garbage after crlf" {
    assert rejects(
        "null\r\nx");
}

test "invalid trailing comma after whitespace" {
    assert rejects(
        "null   ,");
}

/// -------------------------------------------------------------------------
/// Parser must consume complete input
/// -------------------------------------------------------------------------

test "parser rejects valid prefix followed by malformed number" {
    assert rejects(
        "null 01");
}

test "parser rejects valid prefix followed by malformed string" {
    assert rejects(
        "null \"unterminated");
}

test "parser rejects valid prefix followed by malformed literal" {
    assert rejects(
        "null tru");
}

test "parser rejects valid prefix followed by structural token" {
    assert rejects(
        "null [");
}

/// -------------------------------------------------------------------------
/// Invalid arrays with valid prefixes
/// -------------------------------------------------------------------------

test "invalid array after first valid element" {
    assert rejects(
        "[null tru]");
}

test "invalid array after several valid elements" {
    assert rejects(
        "[null,true,false,01]");
}

test "invalid array after nested valid element" {
    assert rejects(
        "[{\"a\":1},[1,2],]");
}

/// -------------------------------------------------------------------------
/// Invalid objects with valid prefixes
/// -------------------------------------------------------------------------

test "invalid object after first valid member" {
    assert rejects(
        "{\"a\":1,\"b\":}");
}

test "invalid object after several valid members" {
    assert rejects(
        "{\"a\":1,\"b\":true,\"c\":01}");
}

test "invalid object after nested valid member" {
    assert rejects(
        "{\"a\":{\"b\":1},\"c\":[1,2],}");
}

/// -------------------------------------------------------------------------
/// Deep malformed structures
/// -------------------------------------------------------------------------

test "invalid deep array missing final bracket" {
    assert rejects(
        "[[[[[[[[0]]]]]]]");
}

test "invalid deep object missing final brace" {
    assert rejects(
        "{\"a\":{\"b\":{\"c\":{\"d\":{\"e\":0}}}}");
}

test "invalid deep mixed missing final delimiter" {
    assert rejects(
        "{\"a\":[{\"b\":[{\"c\":[1,2,3]}]}]");
}

test "invalid deep mixed trailing comma" {
    assert rejects(
        "{\"a\":[{\"b\":[{\"c\":[1,2,3,]}]}]}");
}

/// -------------------------------------------------------------------------
/// Error state consistency
/// -------------------------------------------------------------------------

test "invalid parse result remains failed" {
    let result: JsonParseResult =
        parse("[1,,2]");

    assert !result.ok;
}

test "invalid lex result remains failed" {
    let result: JsonLexerResult =
        lex("\"\\x\"");

    assert !result.ok;
}

test "different malformed documents all reject" {
    assert rejects("[1,]");
    assert rejects("{\"a\":}");
    assert rejects("\"\\x\"");
    assert rejects("01");
    assert rejects("tru");
    assert rejects("null null");
}

/// -------------------------------------------------------------------------
/// Invalid number matrix
/// -------------------------------------------------------------------------

test "invalid number matrix" {
    assert rejects("+0");
    assert rejects("+1");
    assert rejects("-");
    assert rejects("--1");
    assert rejects("-+1");

    assert rejects("00");
    assert rejects("01");
    assert rejects("-00");
    assert rejects("-01");

    assert rejects(".");
    assert rejects(".0");
    assert rejects("0.");
    assert rejects("1.");

    assert rejects("1..0");
    assert rejects("1.0.0");

    assert rejects("1e");
    assert rejects("1E");
    assert rejects("1e+");
    assert rejects("1e-");

    assert rejects("1e1e1");
    assert rejects("1E1E1");

    assert rejects("0x10");
    assert rejects("0b10");
    assert rejects("0o10");

    assert rejects("1_000");

    assert rejects("NaN");
    assert rejects("Infinity");
    assert rejects("-Infinity");
}

/// -------------------------------------------------------------------------
/// Invalid string matrix
/// -------------------------------------------------------------------------

test "invalid string matrix" {
    assert rejects("\"");

    assert rejects("\"\\a\"");
    assert rejects("\"\\v\"");
    assert rejects("\"\\0\"");
    assert rejects("\"\\x\"");
    assert rejects("\"\\1\"");

    assert rejects("\"\\u\"");
    assert rejects("\"\\u0\"");
    assert rejects("\"\\u00\"");
    assert rejects("\"\\u000\"");

    assert rejects("\"\\u000G\"");
    assert rejects("\"\\u00ZZ\"");

    assert rejects("\"\\uD800\"");
    assert rejects("\"\\uDC00\"");
    assert rejects("\"\\uD800\\u0041\"");
}

/// -------------------------------------------------------------------------
/// Invalid array matrix
/// -------------------------------------------------------------------------

test "invalid array matrix" {
    assert rejects("[");
    assert rejects("[,]");
    assert rejects("[,1]");
    assert rejects("[1,]");
    assert rejects("[1,,2]");
    assert rejects("[1 2]");
    assert rejects("[1:2]");
    assert rejects("[01]");
    assert rejects("[tru]");
    assert rejects("[\"\\x\"]");
}

/// -------------------------------------------------------------------------
/// Invalid object matrix
/// -------------------------------------------------------------------------

test "invalid object matrix" {
    assert rejects("{");
    assert rejects("{,}");
    assert rejects("{,\"a\":1}");

    assert rejects("{a:1}");
    assert rejects("{1:1}");

    assert rejects("{\"a\"}");
    assert rejects("{\"a\" 1}");
    assert rejects("{\"a\":}");

    assert rejects("{\"a\":1,}");
    assert rejects("{\"a\":1 \"b\":2}");
    assert rejects("{\"a\"::1}");

    assert rejects("{\"a\":01}");
    assert rejects("{\"a\":tru}");
    assert rejects("{\"a\":\"\\x\"}");
}

/// -------------------------------------------------------------------------
/// Final comprehensive rejection smoke test
/// -------------------------------------------------------------------------

test "invalid json comprehensive smoke" {
    assert rejects("");
    assert rejects(" ");
    assert rejects("x");

    assert rejects("nul");
    assert rejects("tru");
    assert rejects("fals");

    assert rejects("+1");
    assert rejects("01");
    assert rejects("1.");
    assert rejects("1e");
    assert rejects("0x10");

    assert rejects("\"unterminated");
    assert rejects("\"\\x\"");
    assert rejects("\"\\u000\"");
    assert rejects("\"\\uD800\"");
    assert rejects("\"\\uDC00\"");

    assert rejects("[");
    assert rejects("[1,]");
    assert rejects("[1,,2]");
    assert rejects("[1 2]");

    assert rejects("{");
    assert rejects("{key:1}");
    assert rejects("{\"key\"}");
    assert rejects("{\"key\":}");
    assert rejects("{\"key\":1,}");
    assert rejects(
        "{\"a\":1 \"b\":2}");

    assert rejects("null null");
    assert rejects("[] {}");
    assert rejects("{} []");

    assert rejects(
        "{\"a\":[1,2,]}");

    assert rejects(
        "[{\"a\":1,}]");

    assert rejects(
        "{\"a\":{\"b\":}}");

    assert rejects(
        "{\"a\":[{\"b\":[1,2,3]}]");

    let valid_after_failures: JsonParseResult =
        parse(
            "{\"valid\":[null,true,false,0,\"Vitte\",[],{}]}");

    assert valid_after_failures.ok;
}