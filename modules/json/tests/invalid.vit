/// -------------------------------------------------------------------------
/// Numeric scanner agrees on malformed forms
/// -------------------------------------------------------------------------

test "numeric runtime rejects malformed number forms" {
    assert !valid("");
    assert !valid("+1");
    assert !valid("-");
    assert !valid("01");
    assert !valid("-01");
    assert !valid(".1");
    assert !valid("1.");
    assert !valid("1e");
    assert !valid("1e+");
    assert !valid("1e-");
    assert !valid("1e1e1");
    assert !valid("0x10");
    assert !valid("1_000");
    assert !valid("NaN");
    assert !valid("Infinity");
}

