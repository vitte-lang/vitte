    assert rejects("null // comment");
}

test "invalid block comment before value" {
    assert rejects("/* x */ true");
}

test "invalid block comment inside array" {
    assert rejects("[1, /* x */ 2]");
}

test "invalid block comment inside object" {
    assert rejects("{\"a\": /* x */ 1}");
}

