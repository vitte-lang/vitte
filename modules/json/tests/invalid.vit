/// Comprehensive rejection tests for the Vitte JSON implementation.
///
/// This suite verifies that malformed JSON is rejected deterministically.
///
/// Covered categories:
///
/// - empty input
/// - whitespace-only input
/// - invalid top-level tokens
/// - malformed literals
/// - malformed numbers
/// - invalid strings
/// - invalid escapes
/// - malformed Unicode escapes
/// - invalid surrogate sequences
/// - malformed arrays
/// - malformed objects
/// - missing separators
/// - trailing separators
/// - invalid keys
/// - extra top-level values
/// - trailing garbage
/// - invalid nesting
/// - depth limits
/// - lexer/parser boundary cases
/// - deterministic failures
///
/// Every input in this file is intentionally invalid JSON.

space json::tests::invalid;

use json::lexer::lexer::{
    JsonLexerResult,
    lex
};

use json::parser::parser::{
    JsonParseResult,
    parse
};

use json::runtime::numeric::{
    valid
};

/// -------------------------------------------------------------------------
/// Generic helpers
/// -------------------------------------------------------------------------

proc rejects(source: string) -> bool {
    let result: JsonParseResult =
        parse(source);

    give !result.ok;
}

proc lex_rejects(source: string) -> bool {
    let result: JsonLexerResult =
        lex(source);

    give !result.ok;
}

/// -------------------------------------------------------------------------
/// Empty input
/// -------------------------------------------------------------------------

test "invalid empty input" {
    assert rejects("");
}

test "invalid single space input" {
    assert rejects(" ");
}

test "invalid multiple spaces input" {
    assert rejects("     ");
}

test "invalid tab input" {
    assert rejects("\t");
}

test "invalid newline input" {
    assert rejects("\n");
}

test "invalid carriage return input" {
    assert rejects("\r");
}

test "invalid crlf input" {
    assert rejects("\r\n");
}

test "invalid mixed whitespace input" {
    assert rejects(" \t\r\n ");
}

