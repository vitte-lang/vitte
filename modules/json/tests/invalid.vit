    assert rejects(
        "{\"a\"::1}");
}

test "invalid object comma after colon" {
    assert rejects(
        "{\"a\":,1}");
}

/// -------------------------------------------------------------------------
/// Empty object keys are valid JSON
/// -------------------------------------------------------------------------

test "empty object key is not an invalid case" {
    let result: JsonParseResult =
        parse("{\"\":1}");

    assert result.ok;
}

/// -------------------------------------------------------------------------
/// Duplicate keys are syntactically valid JSON
/// -------------------------------------------------------------------------

test "duplicate keys remain parser policy not syntax error" {
    let source: string =
        "{\"a\":1,\"a\":2}";

    let result: JsonParseResult =
        parse(source);

    /// JSON syntax itself permits repeated member names.
    /// Implementations may apply an additional duplicate-key policy.
    ///
    /// This test intentionally does not require either semantic policy.
    /// It only verifies deterministic behavior.

    let second: JsonParseResult =
        parse(source);

    assert result.ok ==
        second.ok;

    assert result.diagnostic.error ==
        second.diagnostic.error;
}

