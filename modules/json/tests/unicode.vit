/// Comprehensive JSON Unicode tests.
///
/// This suite validates Unicode handling across:
///
/// - lexer
/// - escape decoder
/// - parser
/// - encoder
/// - round trips
/// - object keys
/// - UTF-8 input
/// - JSON \uXXXX escapes
/// - UTF-16 surrogate pairs
/// - Unicode boundary values
/// - control characters
/// - malformed escapes
/// - malformed surrogate sequences
/// - mixed literal and escaped Unicode
/// - deterministic encoding
///
/// JSON strings are Unicode strings. JSON \u escapes encode UTF-16 code
/// units and supplementary Unicode scalar values require surrogate pairs.

space json::tests::unicode;

use json::core::value as json_core;
use json::lexer::lexer::{
    JsonLexerResult,
    lex
};
use json::parser::parser::{
    JsonParseResult,
    parse
};
use json::encode::encoder::{
    JsonEncodeResult,
    encode,
    encode_compact,
    encode_pretty
};

/// -------------------------------------------------------------------------
/// Helpers
/// -------------------------------------------------------------------------

proc unicode_parses(source: string) -> bool {
    let result: JsonParseResult =
        parse(source);

    give result.ok;
}

proc unicode_rejects(source: string) -> bool {
    let result: JsonParseResult =
        parse(source);

    give !result.ok;
}

proc unicode_lexes(source: string) -> bool {
    let result: JsonLexerResult =
        lex(source);

    give result.ok;
}

proc unicode_lex_rejects(source: string) -> bool {
    let result: JsonLexerResult =
        lex(source);

    give !result.ok;
}

proc unicode_roundtrip(source: string) -> bool {
    let first: JsonParseResult =
        parse(source);

    if !first.ok {
        give false;
    }

    let encoded: JsonEncodeResult =
        encode(&first.value);

    if !encoded.ok {
        give false;
    }

    let second: JsonParseResult =
        parse(encoded.text);

    if !second.ok {
        give false;
    }

    give json_core::equals(
        &first.value,
        &second.value);
}

proc unicode_stable(source: string) -> bool {
    let first: JsonParseResult =
        parse(source);

    if !first.ok {
        give false;
    }

    let encoded_first: JsonEncodeResult =
        encode(&first.value);

    if !encoded_first.ok {
        give false;
    }

    let second: JsonParseResult =
        parse(encoded_first.text);

    if !second.ok {
        give false;
    }

    let encoded_second: JsonEncodeResult =
        encode(&second.value);

    if !encoded_second.ok {
        give false;
    }

    give encoded_first.text ==
        encoded_second.text;
}

/// -------------------------------------------------------------------------
/// ASCII Unicode escapes
/// -------------------------------------------------------------------------

test "unicode escape uppercase A" {
    let result: JsonParseResult =
        parse("\"\\u0041\"");

    assert result.ok;

    assert json_core::string_or(
        &result.value,
        "") == "A";
}

test "unicode escape lowercase a" {
    let result: JsonParseResult =
        parse("\"\\u0061\"");

    assert result.ok;

    assert json_core::string_or(
        &result.value,
        "") == "a";
}

test "unicode escape digit zero" {
    let result: JsonParseResult =
        parse("\"\\u0030\"");

    assert result.ok;

    assert json_core::string_or(
        &result.value,
        "") == "0";
}

test "unicode escape space" {
    let result: JsonParseResult =
        parse("\"\\u0020\"");

    assert result.ok;

    assert json_core::string_or(
        &result.value,
        "") == " ";
}

test "unicode escape slash" {
    let result: JsonParseResult =
        parse("\"\\u002F\"");

    assert result.ok;

    assert json_core::string_or(
        &result.value,
        "") == "/";
}

test "unicode escape quote" {
    let result: JsonParseResult =
        parse("\"\\u0022\"");

    assert result.ok;

    assert json_core::string_or(
        &result.value,
        "") == "\"";
}

test "unicode escape backslash" {
    let result: JsonParseResult =
        parse("\"\\u005C\"");

    assert result.ok;

    assert json_core::string_or(
        &result.value,
        "") == "\\";
}

/// -------------------------------------------------------------------------
/// Hex digit case
/// -------------------------------------------------------------------------

test "unicode escape lowercase hexadecimal digits" {
    let result: JsonParseResult =
        parse("\"\\u00e9\"");

    assert result.ok;

    assert json_core::string_or(
        &result.value,
        "") == "é";
}

test "unicode escape uppercase hexadecimal digits" {
    let result: JsonParseResult =
        parse("\"\\u00E9\"");

    assert result.ok;

    assert json_core::string_or(
        &result.value,
        "") == "é";
}

test "unicode escape mixed hexadecimal digits" {
    let lower: JsonParseResult =
        parse("\"\\u00e9\"");

    let upper: JsonParseResult =
        parse("\"\\u00E9\"");

    assert lower.ok;
    assert upper.ok;

    assert json_core::equals(
        &lower.value,
        &upper.value);
}

