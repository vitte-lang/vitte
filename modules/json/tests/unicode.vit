/// -------------------------------------------------------------------------
/// Mixed short and Unicode escapes
/// -------------------------------------------------------------------------

test "mixed short and unicode escape parsing" {
    let result: JsonParseResult =
        parse(
            "\"" +
            "\\t" +
            "\\u0041" +
            "\\n" +
            "\\u00E9" +
            "\\r" +
            "\\uD83D\\uDE00" +
            "\"");

    assert result.ok;

    assert json_core::string_or(
        &result.value,
        "") == "\tA\né\r😀";
}

test "mixed short and unicode escape roundtrip" {
    assert unicode_roundtrip(
        "\"" +
        "\\t" +
        "\\u0041" +
        "\\n" +
        "\\u00E9" +
        "\\r" +
        "\\uD83D\\uDE00" +
        "\"");
}

/// -------------------------------------------------------------------------
/// Unicode equality
/// -------------------------------------------------------------------------

test "unicode equal literal strings" {
    let first: JsonParseResult =
        parse("\"café\"");

    let second: JsonParseResult =
        parse("\"café\"");

    assert first.ok;
    assert second.ok;

    assert json_core::equals(
        &first.value,
        &second.value);
}

test "unicode equivalent escape strings" {
    let literal: JsonParseResult =
        parse("\"café\"");

    let escaped: JsonParseResult =
        parse("\"caf\\u00E9\"");

    assert literal.ok;
    assert escaped.ok;

    assert json_core::equals(
        &literal.value,
        &escaped.value);
}

test "unicode different strings are not equal" {
    let first: JsonParseResult =
        parse("\"café\"");

    let second: JsonParseResult =
        parse("\"cafe\"");

    assert first.ok;
    assert second.ok;

    assert !json_core::equals(
        &first.value,
        &second.value);
}

/// -------------------------------------------------------------------------
/// Unicode keys remain distinguishable
/// -------------------------------------------------------------------------

test "unicode distinct object keys" {
    let result: JsonParseResult =
        parse(
            "{" +
            "\"e\":1," +
            "\"é\":2," +
            "\"è\":3," +
            "\"ê\":4" +
            "}");

    assert result.ok;
    assert json_core::object_len(&result.value) == 4;

    assert json_core::integer_or(
        json_core::object_get_ref(
            &result.value,
            "e"),
        0) == 1;

    assert json_core::integer_or(
        json_core::object_get_ref(
            &result.value,
            "é"),
        0) == 2;

    assert json_core::integer_or(
        json_core::object_get_ref(
            &result.value,
            "è"),
        0) == 3;

    assert json_core::integer_or(
        json_core::object_get_ref(
            &result.value,
            "ê"),
        0) == 4;
}

/// -------------------------------------------------------------------------
/// Unicode normalization policy
/// -------------------------------------------------------------------------

test "unicode parser preserves scalar sequence without normalization" {
    let precomposed: JsonParseResult =
        parse("\"é\"");

    let escaped_precomposed: JsonParseResult =
        parse("\"\\u00E9\"");

    assert precomposed.ok;
    assert escaped_precomposed.ok;

    assert json_core::equals(
        &precomposed.value,
        &escaped_precomposed.value);
}

/// -------------------------------------------------------------------------
/// Pretty encoder Unicode roundtrip
/// -------------------------------------------------------------------------

test "pretty unicode object roundtrip" {
    let first: JsonParseResult =
        parse(
            "{" +
            "\"français\":\"café\"," +
            "\"日本語\":\"こんにちは\"," +
            "\"emoji\":\"😀\"" +
            "}");

    assert first.ok;

    let encoded: JsonEncodeResult =
        encode_pretty(
            &first.value);

    assert encoded.ok;

    let second: JsonParseResult =
        parse(encoded.text);

    assert second.ok;

    assert json_core::equals(
        &first.value,
        &second.value);
}

test "pretty unicode array roundtrip" {
    let first: JsonParseResult =
        parse(
            "[" +
            "\"café\"," +
            "\"Ελληνικά\"," +
            "\"日本語\"," +
            "\"😀\"" +
            "]");

    assert first.ok;

    let encoded: JsonEncodeResult =
        encode_pretty(
            &first.value);

    assert encoded.ok;

    let second: JsonParseResult =
        parse(encoded.text);

    assert second.ok;

    assert json_core::equals(
        &first.value,
        &second.value);
}

/// -------------------------------------------------------------------------
/// Unicode parser recovery isolation
/// -------------------------------------------------------------------------

test "invalid unicode parse does not poison later valid parse" {
    let invalid_result: JsonParseResult =
        parse(
            "\"\\uD800\"");

    assert !invalid_result.ok;

    let valid_result: JsonParseResult =
        parse(
            "\"café 😀\"");

    assert valid_result.ok;

    assert json_core::string_or(
        &valid_result.value,
        "") == "café 😀";
}

test "valid unicode parse does not hide later invalid parse" {
    let valid_result: JsonParseResult =
        parse(
            "\"café 😀\"");

    assert valid_result.ok;

    let invalid_result: JsonParseResult =
        parse(
            "\"\\uD800\"");

    assert !invalid_result.ok;
}

/// -------------------------------------------------------------------------
/// Unicode matrix
/// -------------------------------------------------------------------------

test "unicode valid matrix" {
    assert unicode_parses("\"\\u0000\"");
    assert unicode_parses("\"\\u0020\"");
    assert unicode_parses("\"\\u0041\"");
    assert unicode_parses("\"\\u007F\"");
    assert unicode_parses("\"\\u0080\"");
    assert unicode_parses("\"\\u00E9\"");
    assert unicode_parses("\"\\u03B1\"");
    assert unicode_parses("\"\\u20AC\"");
    assert unicode_parses("\"\\u4E2D\"");
    assert unicode_parses("\"\\uD7FF\"");
    assert unicode_parses("\"\\uE000\"");
    assert unicode_parses("\"\\uFFFF\"");

    assert unicode_parses(
        "\"\\uD800\\uDC00\"");

    assert unicode_parses(
        "\"\\uD83D\\uDE00\"");

    assert unicode_parses(
        "\"\\uDBFF\\uDFFF\"");
}

test "unicode invalid matrix" {
    assert unicode_rejects("\"\\u\"");
    assert unicode_rejects("\"\\u0\"");
    assert unicode_rejects("\"\\u00\"");
    assert unicode_rejects("\"\\u000\"");
    assert unicode_rejects("\"\\u000G\"");

    assert unicode_rejects(
        "\"\\uD800\"");

    assert unicode_rejects(
        "\"\\uDBFF\"");

    assert unicode_rejects(
        "\"\\uDC00\"");

    assert unicode_rejects(
        "\"\\uDFFF\"");

    assert unicode_rejects(
        "\"\\uD800\\u0041\"");

    assert unicode_rejects(
        "\"\\uD800\\uD800\"");

    assert unicode_rejects(
        "\"\\uDC00\\uD800\"");
}

/// -------------------------------------------------------------------------
/// Round-trip matrix
/// -------------------------------------------------------------------------

test "unicode roundtrip matrix" {
    assert unicode_roundtrip(
        "\"A\"");

    assert unicode_roundtrip(
        "\"\\u0041\"");

    assert unicode_roundtrip(
        "\"é\"");

    assert unicode_roundtrip(
        "\"\\u00E9\"");

    assert unicode_roundtrip(
        "\"€\"");

    assert unicode_roundtrip(
        "\"\\u20AC\"");

    assert unicode_roundtrip(
        "\"中\"");

    assert unicode_roundtrip(
        "\"\\u4E2D\"");

    assert unicode_roundtrip(
        "\"😀\"");

    assert unicode_roundtrip(
        "\"\\uD83D\\uDE00\"");
}

/// -------------------------------------------------------------------------
/// Full Unicode integration
/// -------------------------------------------------------------------------

test "json unicode full integration" {
    let source: string =
        "{" +
        "\"ascii\":\"Vitte\"," +
        "\"latin\":\"café déjà été Noël\"," +
        "\"greek\":\"Ελληνικά αβγ Ω\"," +
        "\"cyrillic\":\"Привет мир\"," +
        "\"arabic\":\"مرحبا بالعالم\"," +
        "\"hebrew\":\"שלום עולם\"," +
        "\"japanese\":\"こんにちは世界\"," +
        "\"chinese\":\"你好世界\"," +
        "\"korean\":\"안녕하세요 세계\"," +
        "\"emoji\":\"😀🙂🚀💻🧠\"," +
        "\"escaped\":{" +
            "\"ascii\":\"\\u0041\\u0042\\u0043\"," +
            "\"latin\":\"caf\\u00E9\"," +
            "\"euro\":\"\\u20AC\"," +
            "\"cjk\":\"\\u4E2D\"," +
            "\"emoji\":\"\\uD83D\\uDE00\"," +
            "\"rocket\":\"\\uD83D\\uDE80\"" +
        "}," +
        "\"controls\":{" +
            "\"tab\":\"\\u0009\"," +
            "\"newline\":\"\\u000A\"," +
            "\"carriage\":\"\\u000D\"" +
        "}," +
        "\"keys\":{" +
            "\"clé\":1," +
            "\"日本語\":2," +
            "\"مرحبا\":3," +
            "\"😀\":4" +
        "}" +
        "}";

    let parsed_value: JsonParseResult =
        parse(source);

    assert parsed_value.ok;
    assert json_core::validate(&parsed_value.value);

    assert json_core::string_or(
        json_core::object_get_ref(
            &parsed_value.value,
            "latin"),
        "") == "café déjà été Noël";

    assert json_core::string_or(
        json_core::object_get_ref(
            &parsed_value.value,
            "japanese"),
        "") == "こんにちは世界";

    assert json_core::string_or(
        json_core::object_get_ref(
            &parsed_value.value,
            "emoji"),
        "") == "😀🙂🚀💻🧠";

    let escaped: &json_core::JsonValue =
        json_core::object_get_ref(
            &parsed_value.value,
            "escaped");

    assert json_core::string_or(
        json_core::object_get_ref(
            escaped,
            "ascii"),
        "") == "ABC";

    assert json_core::string_or(
        json_core::object_get_ref(
            escaped,
            "latin"),
        "") == "café";

    assert json_core::string_or(
        json_core::object_get_ref(
            escaped,
            "emoji"),
        "") == "😀";

    assert json_core::string_or(
        json_core::object_get_ref(
            escaped,
            "rocket"),
        "") == "🚀";

    let keys: &json_core::JsonValue =
        json_core::object_get_ref(
            &parsed_value.value,
            "keys");

    assert json_core::integer_or(
        json_core::object_get_ref(
            keys,
            "clé"),
        0) == 1;

    assert json_core::integer_or(
        json_core::object_get_ref(
            keys,
            "日本語"),
        0) == 2;

    assert json_core::integer_or(
        json_core::object_get_ref(
            keys,
            "مرحبا"),
        0) == 3;

    assert json_core::integer_or(
        json_core::object_get_ref(
            keys,
            "😀"),
        0) == 4;

    let compact: JsonEncodeResult =
        encode_compact(
            &parsed_value.value);

    assert compact.ok;

    let compact_parsed: JsonParseResult =
        parse(compact.text);

    assert compact_parsed.ok;

    assert json_core::equals(
        &parsed_value.value,
        &compact_parsed.value);

    let pretty: JsonEncodeResult =
        encode_pretty(
            &parsed_value.value);

    assert pretty.ok;

    let pretty_parsed: JsonParseResult =
        parse(pretty.text);

    assert pretty_parsed.ok;

    assert json_core::equals(
        &parsed_value.value,
        &pretty_parsed.value);

    assert unicode_roundtrip(source);
    assert unicode_stable(source);
}