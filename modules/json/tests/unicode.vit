/// -------------------------------------------------------------------------
/// Literal supplementary characters
/// -------------------------------------------------------------------------

test "literal emoji grinning face" {
    let result: JsonParseResult =
        parse("\"😀\"");

    assert result.ok;

    assert json_core::string_or(
        &result.value,
        "") == "😀";
}

test "literal emoji rocket" {
    let result: JsonParseResult =
        parse("\"🚀\"");

    assert result.ok;

    assert json_core::string_or(
        &result.value,
        "") == "🚀";
}

test "literal multiple emoji" {
    let result: JsonParseResult =
        parse("\"😀🙂🚀💻🧠\"");

    assert result.ok;

    assert json_core::string_or(
        &result.value,
        "") == "😀🙂🚀💻🧠";
}

/// -------------------------------------------------------------------------
/// Literal and escaped supplementary equivalence
/// -------------------------------------------------------------------------

test "literal and escaped grinning face equivalent" {
    let literal: JsonParseResult =
        parse("\"😀\"");

    let escaped: JsonParseResult =
        parse("\"\\uD83D\\uDE00\"");

    assert literal.ok;
    assert escaped.ok;

    assert json_core::equals(
        &literal.value,
        &escaped.value);
}

test "literal and escaped rocket equivalent" {
    let literal: JsonParseResult =
        parse("\"🚀\"");

    let escaped: JsonParseResult =
        parse("\"\\uD83D\\uDE80\"");

    assert literal.ok;
    assert escaped.ok;

    assert json_core::equals(
        &literal.value,
        &escaped.value);
}

/// -------------------------------------------------------------------------
/// Multiple surrogate pairs
/// -------------------------------------------------------------------------

test "multiple surrogate pairs" {
    let result: JsonParseResult =
        parse(
            "\"\\uD83D\\uDE00\\uD83D\\uDE80\"");

    assert result.ok;

    assert json_core::string_or(
        &result.value,
        "") == "😀🚀";
}

test "surrogate pairs mixed with bmp" {
    let result: JsonParseResult =
        parse(
            "\"A\\uD83D\\uDE00\\u00E9\\uD83D\\uDE80Z\"");

    assert result.ok;

    assert json_core::string_or(
        &result.value,
        "") == "A😀é🚀Z";
}

/// -------------------------------------------------------------------------
/// Lone high surrogate rejection
/// -------------------------------------------------------------------------

test "reject minimum lone high surrogate" {
    assert unicode_rejects(
        "\"\\uD800\"");
}

test "reject high surrogate D801" {
    assert unicode_rejects(
        "\"\\uD801\"");
}

test "reject high surrogate DA00" {
    assert unicode_rejects(
        "\"\\uDA00\"");
}

test "reject maximum lone high surrogate" {
    assert unicode_rejects(
        "\"\\uDBFF\"");
}

/// -------------------------------------------------------------------------
/// Lone low surrogate rejection
/// -------------------------------------------------------------------------

test "reject minimum lone low surrogate" {
    assert unicode_rejects(
        "\"\\uDC00\"");
}

test "reject low surrogate DC01" {
    assert unicode_rejects(
        "\"\\uDC01\"");
}

test "reject low surrogate DE00" {
    assert unicode_rejects(
        "\"\\uDE00\"");
}

test "reject maximum lone low surrogate" {
    assert unicode_rejects(
        "\"\\uDFFF\"");
}

/// -------------------------------------------------------------------------
/// Invalid surrogate ordering
/// -------------------------------------------------------------------------

test "reject low surrogate followed by high surrogate" {
    assert unicode_rejects(
        "\"\\uDC00\\uD800\"");
}

test "reject low surrogate followed by low surrogate" {
    assert unicode_rejects(
        "\"\\uDC00\\uDC00\"");
}

test "reject high surrogate followed by high surrogate" {
    assert unicode_rejects(
        "\"\\uD800\\uD800\"");
}

test "reject maximum high surrogate followed by high surrogate" {
    assert unicode_rejects(
        "\"\\uDBFF\\uDBFF\"");
}

/// -------------------------------------------------------------------------
/// High surrogate must be followed immediately by low surrogate
/// -------------------------------------------------------------------------

test "reject high surrogate followed by ascii unicode escape" {
    assert unicode_rejects(
        "\"\\uD800\\u0041\"");
}

test "reject high surrogate followed by bmp unicode escape" {
    assert unicode_rejects(
        "\"\\uD800\\u00E9\"");
}

test "reject high surrogate followed by literal ascii" {
    assert unicode_rejects(
        "\"\\uD800A\"");
}

test "reject high surrogate followed by literal unicode" {
    assert unicode_rejects(
        "\"\\uD800é\"");
}

test "reject high surrogate followed by short escape" {
    assert unicode_rejects(
        "\"\\uD800\\n\"");
}

/// -------------------------------------------------------------------------
/// Incomplete Unicode escapes
/// -------------------------------------------------------------------------

test "reject unicode escape zero digits" {
    assert unicode_rejects(
        "\"\\u\"");
}

test "reject unicode escape one digit" {
    assert unicode_rejects(
        "\"\\u0\"");
}

test "reject unicode escape two digits" {
    assert unicode_rejects(
        "\"\\u00\"");
}

test "reject unicode escape three digits" {
    assert unicode_rejects(
        "\"\\u000\"");
}

/// -------------------------------------------------------------------------
/// Invalid hexadecimal digits
/// -------------------------------------------------------------------------

test "reject unicode escape G" {
    assert unicode_rejects(
        "\"\\u000G\"");
}

test "reject unicode escape g" {
    assert unicode_rejects(
        "\"\\u000g\"");
}

test "reject unicode escape Z" {
    assert unicode_rejects(
        "\"\\u00ZZ\"");
}

test "reject unicode escape minus" {
    assert unicode_rejects(
        "\"\\u00-1\"");
}

test "reject unicode escape plus" {
    assert unicode_rejects(
        "\"\\u+001\"");
}

test "reject unicode escape whitespace" {
    assert unicode_rejects(
        "\"\\u00 1\"");
}

/// -------------------------------------------------------------------------
/// Incomplete surrogate pairs
/// -------------------------------------------------------------------------

test "reject high surrogate then incomplete escape" {
    assert unicode_rejects(
        "\"\\uD800\\u\"");
}

test "reject high surrogate then one low digit" {
    assert unicode_rejects(
        "\"\\uD800\\uD\"");
}

test "reject high surrogate then two low digits" {
    assert unicode_rejects(
        "\"\\uD800\\uDC\"");
}

test "reject high surrogate then three low digits" {
    assert unicode_rejects(
        "\"\\uD800\\uDC0\"");
}

test "reject high surrogate then malformed low surrogate" {
    assert unicode_rejects(
        "\"\\uD800\\uDC0G\"");
}

/// -------------------------------------------------------------------------
/// Lexer Unicode validation
/// -------------------------------------------------------------------------

test "lexer accepts bmp unicode escape" {
    assert unicode_lexes(
        "\"\\u00E9\"");
}

test "lexer accepts valid surrogate pair" {
    assert unicode_lexes(
        "\"\\uD83D\\uDE00\"");
}

test "lexer accepts literal utf8" {
    assert unicode_lexes(
        "\"Vitte café 日本語 😀\"");
}

test "lexer rejects incomplete unicode escape" {
    assert unicode_lex_rejects(
        "\"\\u000\"");
}

test "lexer rejects invalid unicode hex" {
    assert unicode_lex_rejects(
        "\"\\u000G\"");
}

test "lexer rejects lone high surrogate" {
    assert unicode_lex_rejects(
        "\"\\uD800\"");
}

test "lexer rejects lone low surrogate" {
    assert unicode_lex_rejects(
        "\"\\uDC00\"");
}

test "lexer rejects malformed surrogate pair" {
    assert unicode_lex_rejects(
        "\"\\uD800\\u0041\"");
}

/// -------------------------------------------------------------------------
/// Unicode object keys
/// -------------------------------------------------------------------------

test "unicode latin object key" {
    let result: JsonParseResult =
        parse(
            "{\"café\":1}");

    assert result.ok;

    assert json_core::integer_or(
        json_core::object_get_ref(
            &result.value,
            "café"),
        0) == 1;
}

test "unicode escaped latin object key" {
    let result: JsonParseResult =
        parse(
            "{\"caf\\u00E9\":1}");

    assert result.ok;

    assert json_core::integer_or(
        json_core::object_get_ref(
            &result.value,
            "café"),
        0) == 1;
}

test "unicode japanese object key" {
    let result: JsonParseResult =
        parse(
            "{\"日本語\":1}");

    assert result.ok;

    assert json_core::integer_or(
        json_core::object_get_ref(
            &result.value,
            "日本語"),
        0) == 1;
}

test "unicode arabic object key" {
    let result: JsonParseResult =
        parse(
            "{\"مرحبا\":1}");

    assert result.ok;

    assert json_core::integer_or(
        json_core::object_get_ref(
            &result.value,
            "مرحبا"),
        0) == 1;
}

test "unicode emoji object key" {
    let result: JsonParseResult =
        parse(
            "{\"🚀\":1}");

    assert result.ok;

    assert json_core::integer_or(
        json_core::object_get_ref(
            &result.value,
            "🚀"),
        0) == 1;
}

test "unicode escaped emoji object key" {
    let result: JsonParseResult =
        parse(
            "{\"\\uD83D\\uDE80\":1}");

    assert result.ok;

    assert json_core::integer_or(
        json_core::object_get_ref(
            &result.value,
            "🚀"),
        0) == 1;
}

/// -------------------------------------------------------------------------
/// Unicode values inside arrays
/// -------------------------------------------------------------------------

test "unicode array values" {
    let result: JsonParseResult =
        parse(
            "[" +
            "\"café\"," +
            "\"Ελληνικά\"," +
            "\"Привет\"," +
            "\"مرحبا\"," +
            "\"日本語\"," +
            "\"你好\"," +
            "\"안녕하세요\"," +
            "\"😀\"" +
            "]");

    assert result.ok;
    assert json_core::is_array(&result.value);
    assert json_core::array_len(&result.value) == 8;

    assert json_core::string_or(
        json_core::array_get_ref(
            &result.value,
            0),
        "") == "café";

    assert json_core::string_or(
        json_core::array_get_ref(
            &result.value,
            4),
        "") == "日本語";

    assert json_core::string_or(
        json_core::array_get_ref(
            &result.value,
            7),
        "") == "😀";
}

/// -------------------------------------------------------------------------
/// Unicode values inside objects
/// -------------------------------------------------------------------------

test "unicode object values" {
    let result: JsonParseResult =
        parse(
            "{" +
            "\"latin\":\"café\"," +
            "\"greek\":\"Ελληνικά\"," +
            "\"cyrillic\":\"Привет\"," +
            "\"arabic\":\"مرحبا\"," +
            "\"japanese\":\"日本語\"," +
            "\"chinese\":\"你好\"," +
            "\"korean\":\"안녕하세요\"," +
            "\"emoji\":\"😀\"" +
            "}");

    assert result.ok;

    assert json_core::string_or(
        json_core::object_get_ref(
            &result.value,
            "latin"),
        "") == "café";

    assert json_core::string_or(
        json_core::object_get_ref(
            &result.value,
            "japanese"),
        "") == "日本語";

    assert json_core::string_or(
        json_core::object_get_ref(
            &result.value,
            "emoji"),
        "") == "😀";
}

/// -------------------------------------------------------------------------
/// Literal and escaped BMP equivalence
/// -------------------------------------------------------------------------

test "literal and escaped e acute equivalent" {
    let literal: JsonParseResult =
        parse("\"é\"");

    let escaped: JsonParseResult =
        parse("\"\\u00E9\"");

    assert literal.ok;
    assert escaped.ok;

    assert json_core::equals(
        &literal.value,
        &escaped.value);
}

test "literal and escaped euro equivalent" {
    let literal: JsonParseResult =
        parse("\"€\"");

    let escaped: JsonParseResult =
        parse("\"\\u20AC\"");

    assert literal.ok;
    assert escaped.ok;

    assert json_core::equals(
        &literal.value,
        &escaped.value);
}

test "literal and escaped greek alpha equivalent" {
    let literal: JsonParseResult =
        parse("\"α\"");

    let escaped: JsonParseResult =
        parse("\"\\u03B1\"");

    assert literal.ok;
    assert escaped.ok;

    assert json_core::equals(
        &literal.value,
        &escaped.value);
}

test "literal and escaped cjk equivalent" {
    let literal: JsonParseResult =
        parse("\"中\"");

    let escaped: JsonParseResult =
        parse("\"\\u4E2D\"");

    assert literal.ok;
    assert escaped.ok;

    assert json_core::equals(
        &literal.value,
        &escaped.value);
}

/// -------------------------------------------------------------------------
/// Short escape and Unicode escape equivalence
/// -------------------------------------------------------------------------

test "short newline and unicode newline equivalent" {
    let short_escape: JsonParseResult =
        parse("\"\\n\"");

    let unicode_escape: JsonParseResult =
        parse("\"\\u000A\"");

    assert short_escape.ok;
    assert unicode_escape.ok;

    assert json_core::equals(
        &short_escape.value,
        &unicode_escape.value);
}

test "short tab and unicode tab equivalent" {
    let short_escape: JsonParseResult =
        parse("\"\\t\"");

    let unicode_escape: JsonParseResult =
        parse("\"\\u0009\"");

    assert short_escape.ok;
    assert unicode_escape.ok;

    assert json_core::equals(
        &short_escape.value,
        &unicode_escape.value);
}

test "short carriage return and unicode equivalent" {
    let short_escape: JsonParseResult =
        parse("\"\\r\"");

    let unicode_escape: JsonParseResult =
        parse("\"\\u000D\"");

    assert short_escape.ok;
    assert unicode_escape.ok;

    assert json_core::equals(
        &short_escape.value,
        &unicode_escape.value);
}

test "short backspace and unicode equivalent" {
    let short_escape: JsonParseResult =
        parse("\"\\b\"");

    let unicode_escape: JsonParseResult =
        parse("\"\\u0008\"");

    assert short_escape.ok;
    assert unicode_escape.ok;

    assert json_core::equals(
        &short_escape.value,
        &unicode_escape.value);
}

test "short form feed and unicode equivalent" {
    let short_escape: JsonParseResult =
        parse("\"\\f\"");

    let unicode_escape: JsonParseResult =
        parse("\"\\u000C\"");

    assert short_escape.ok;
    assert unicode_escape.ok;

    assert json_core::equals(
        &short_escape.value,
        &unicode_escape.value);
}

