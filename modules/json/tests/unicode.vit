/// -------------------------------------------------------------------------
/// Encoder escaping of constructed strings
/// -------------------------------------------------------------------------

test "encoder roundtrip constructed unicode string" {
    let value: json_core::JsonValue =
        json_core::string(
            "Vitte café 日本語 😀");

    let encoded: JsonEncodeResult =
        encode(&value);

    assert encoded.ok;

    let decoded: JsonParseResult =
        parse(encoded.text);

    assert decoded.ok;

    assert json_core::equals(
        &value,
        &decoded.value);
}

test "encoder roundtrip constructed control string" {
    let value: json_core::JsonValue =
        json_core::string(
            "a\nb\tc\rd");

    let encoded: JsonEncodeResult =
        encode(&value);

    assert encoded.ok;

    let decoded: JsonParseResult =
        parse(encoded.text);

    assert decoded.ok;

    assert json_core::equals(
        &value,
        &decoded.value);
}

test "encoder roundtrip constructed quote backslash string" {
    let value: json_core::JsonValue =
        json_core::string(
            "quote=\" backslash=\\");

    let encoded: JsonEncodeResult =
        encode(&value);

    assert encoded.ok;

    let decoded: JsonParseResult =
        parse(encoded.text);

    assert decoded.ok;

    assert json_core::equals(
        &value,
        &decoded.value);
}

/// -------------------------------------------------------------------------
/// Stable Unicode encoding
/// -------------------------------------------------------------------------

test "unicode stable latin encoding" {
    assert unicode_stable(
        "\"café\"");
}

test "unicode stable greek encoding" {
    assert unicode_stable(
        "\"Ελληνικά\"");
}

test "unicode stable japanese encoding" {
    assert unicode_stable(
        "\"日本語\"");
}

test "unicode stable emoji encoding" {
    assert unicode_stable(
        "\"😀\"");
}

test "unicode stable escaped encoding" {
    assert unicode_stable(
        "\"caf\\u00E9\"");
}

test "unicode stable surrogate encoding" {
    assert unicode_stable(
        "\"\\uD83D\\uDE00\"");
}

/// -------------------------------------------------------------------------
/// Repeated parsing
/// -------------------------------------------------------------------------

test "unicode repeated parse deterministic" {
    let source: string =
        "\"Vitte café 日本語 😀\"";

    let first: JsonParseResult =
        parse(source);

    let second: JsonParseResult =
        parse(source);

    let third: JsonParseResult =
        parse(source);

    assert first.ok;
    assert second.ok;
    assert third.ok;

    assert json_core::equals(
        &first.value,
        &second.value);

    assert json_core::equals(
        &second.value,
        &third.value);
}

/// -------------------------------------------------------------------------
/// Repeated Unicode encoding
/// -------------------------------------------------------------------------

test "unicode repeated encoding deterministic" {
    let parsed_value: JsonParseResult =
        parse(
            "\"Vitte café 日本語 😀\"");

    assert parsed_value.ok;

    let first: JsonEncodeResult =
        encode(
            &parsed_value.value);

    let second: JsonEncodeResult =
        encode(
            &parsed_value.value);

    let third: JsonEncodeResult =
        encode(
            &parsed_value.value);

    assert first.ok;
    assert second.ok;
    assert third.ok;

    assert first.text ==
        second.text;

    assert second.text ==
        third.text;
}

/// -------------------------------------------------------------------------
/// Whitespace around Unicode strings
/// -------------------------------------------------------------------------

test "unicode value surrounded by json whitespace" {
    let result: JsonParseResult =
        parse(
            " \t\r\n \"café 日本語 😀\" \t\r\n ");

    assert result.ok;

    assert json_core::string_or(
        &result.value,
        "") == "café 日本語 😀";
}

test "unicode object with json whitespace" {
    let result: JsonParseResult =
        parse(
            "{ \n" +
            "  \"clé\" : \"valeur\" ,\n" +
            "  \"日本語\" : \"こんにちは\" \n" +
            "}");

    assert result.ok;

    assert json_core::string_or(
        json_core::object_get_ref(
            &result.value,
            "clé"),
        "") == "valeur";

    assert json_core::string_or(
        json_core::object_get_ref(
            &result.value,
            "日本語"),
        "") == "こんにちは";
}

/// -------------------------------------------------------------------------
/// Long Unicode strings
/// -------------------------------------------------------------------------

test "long unicode string parses" {
    let result: JsonParseResult =
        parse(
            "\"" +
            "Vitte français café déjà été Noël " +
            "Ελληνικά αβγ Ω " +
            "Привет мир " +
            "مرحبا بالعالم " +
            "שלום עולם " +
            "こんにちは世界 " +
            "你好世界 " +
            "안녕하세요 세계 " +
            "😀🙂🚀💻🧠" +
            "\"");

    assert result.ok;
    assert json_core::is_string(&result.value);
}

test "long unicode string roundtrip" {
    assert unicode_roundtrip(
        "\"" +
        "Vitte français café déjà été Noël " +
        "Ελληνικά αβγ Ω " +
        "Привет мир " +
        "مرحبا بالعالم " +
        "שלום עולם " +
        "こんにちは世界 " +
        "你好世界 " +
        "안녕하세요 세계 " +
        "😀🙂🚀💻🧠" +
        "\"");
}

/// -------------------------------------------------------------------------
/// Unicode nested structures
/// -------------------------------------------------------------------------

test "unicode nested document" {
    let source: string =
        "{" +
        "\"français\":{" +
            "\"bonjour\":\"Bonjour le monde\"," +
            "\"café\":\"café\"" +
        "}," +
        "\"日本語\":{" +
            "\"挨拶\":\"こんにちは世界\"" +
        "}," +
        "\"العربية\":{" +
            "\"تحية\":\"مرحبا بالعالم\"" +
        "}," +
        "\"emoji\":[" +
            "\"😀\"," +
            "\"🙂\"," +
            "\"🚀\"," +
            "\"💻\"," +
            "\"🧠\"" +
        "]" +
        "}";

    let result: JsonParseResult =
        parse(source);

    assert result.ok;
    assert json_core::validate(&result.value);

    assert unicode_roundtrip(source);
}

/// -------------------------------------------------------------------------
/// Escaped Unicode nested structures
/// -------------------------------------------------------------------------

test "escaped unicode nested document" {
    let source: string =
        "{" +
        "\"latin\":\"caf\\u00E9\"," +
        "\"euro\":\"\\u20AC\"," +
        "\"cjk\":\"\\u4E2D\"," +
        "\"emoji\":\"\\uD83D\\uDE00\"," +
        "\"array\":[" +
            "\"\\u0041\"," +
            "\"\\u00E9\"," +
            "\"\\uD83D\\uDE80\"" +
        "]" +
        "}";

    let result: JsonParseResult =
        parse(source);

    assert result.ok;
    assert json_core::validate(&result.value);

    assert unicode_roundtrip(source);
}

/// -------------------------------------------------------------------------
/// Invalid Unicode inside arrays
/// -------------------------------------------------------------------------

test "reject lone high surrogate in array" {
    assert unicode_rejects(
        "[\"\\uD800\"]");
}

test "reject lone low surrogate in array" {
    assert unicode_rejects(
        "[\"\\uDC00\"]");
}

test "reject invalid unicode hex in array" {
    assert unicode_rejects(
        "[\"\\u000G\"]");
}

test "reject incomplete unicode escape in array" {
    assert unicode_rejects(
        "[\"\\u000\"]");
}

test "reject malformed surrogate pair in array" {
    assert unicode_rejects(
        "[\"\\uD800\\u0041\"]");
}

/// -------------------------------------------------------------------------
/// Invalid Unicode inside object values
/// -------------------------------------------------------------------------

test "reject lone high surrogate in object value" {
    assert unicode_rejects(
        "{\"x\":\"\\uD800\"}");
}

test "reject lone low surrogate in object value" {
    assert unicode_rejects(
        "{\"x\":\"\\uDC00\"}");
}

test "reject invalid unicode hex in object value" {
    assert unicode_rejects(
        "{\"x\":\"\\u000G\"}");
}

test "reject malformed surrogate pair in object value" {
    assert unicode_rejects(
        "{\"x\":\"\\uD800\\u0041\"}");
}

/// -------------------------------------------------------------------------
/// Invalid Unicode inside object keys
/// -------------------------------------------------------------------------

test "reject lone high surrogate in object key" {
    assert unicode_rejects(
        "{\"\\uD800\":1}");
}

test "reject lone low surrogate in object key" {
    assert unicode_rejects(
        "{\"\\uDC00\":1}");
}

test "reject invalid unicode hex in object key" {
    assert unicode_rejects(
        "{\"\\u000G\":1}");
}

test "reject malformed surrogate pair in object key" {
    assert unicode_rejects(
        "{\"\\uD800\\u0041\":1}");
}

