        parse(
            "\"\\u0041\\u0042\\u0043\"");

    assert result.ok;

    assert json_core::string_or(
        &result.value,
        "") == "ABC";
}

test "multiple unicode latin escapes" {
    let result: JsonParseResult =
        parse(
            "\"caf\\u00E9\"");

    assert result.ok;

    assert json_core::string_or(
        &result.value,
        "") == "café";
}

test "multiple unicode cjk escapes" {
    let result: JsonParseResult =
        parse(
            "\"\\u4F60\\u597D\"");

    assert result.ok;

    assert json_core::string_or(
        &result.value,
        "") == "你好";
}

test "mixed literal and unicode escapes" {
    let result: JsonParseResult =
        parse(
            "\"Vitte caf\\u00E9 日本語\"");

    assert result.ok;

    assert json_core::string_or(
        &result.value,
        "") == "Vitte café 日本語";
}

/// -------------------------------------------------------------------------
/// Control scalars encoded with Unicode escapes
/// -------------------------------------------------------------------------

test "unicode null control scalar" {
    let result: JsonParseResult =
        parse("\"\\u0000\"");

    assert result.ok;
    assert json_core::is_string(&result.value);
}

test "unicode backspace control scalar" {
    let result: JsonParseResult =
        parse("\"\\u0008\"");

    assert result.ok;

    assert json_core::string_or(
        &result.value,
        "") == "\b";
}

test "unicode tab control scalar" {
    let result: JsonParseResult =
        parse("\"\\u0009\"");

    assert result.ok;

    assert json_core::string_or(
        &result.value,
        "") == "\t";
}

test "unicode newline control scalar" {
