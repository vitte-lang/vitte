    assert json_core::is_string(&result.value);
}

/// -------------------------------------------------------------------------
/// BMP boundaries
/// -------------------------------------------------------------------------

test "unicode bmp scalar before surrogate range" {
    let result: JsonParseResult =
        parse("\"\\uD7FF\"");

    assert result.ok;
    assert json_core::is_string(&result.value);
}

test "unicode bmp scalar after surrogate range" {
    let result: JsonParseResult =
        parse("\"\\uE000\"");

    assert result.ok;
    assert json_core::is_string(&result.value);
}

test "unicode bmp maximum scalar" {
    let result: JsonParseResult =
        parse("\"\\uFFFF\"");

    assert result.ok;
    assert json_core::is_string(&result.value);
}

/// -------------------------------------------------------------------------
/// UTF-16 high surrogate boundaries
/// -------------------------------------------------------------------------

test "unicode minimum high surrogate with minimum low surrogate" {
    let result: JsonParseResult =
        parse("\"\\uD800\\uDC00\"");

    assert result.ok;
    assert json_core::is_string(&result.value);
}

test "unicode minimum high surrogate with maximum low surrogate" {
    let result: JsonParseResult =
        parse("\"\\uD800\\uDFFF\"");

    assert result.ok;
    assert json_core::is_string(&result.value);
}

test "unicode maximum high surrogate with minimum low surrogate" {
    let result: JsonParseResult =
        parse("\"\\uDBFF\\uDC00\"");

    assert result.ok;
    assert json_core::is_string(&result.value);
}

test "unicode maximum high surrogate with maximum low surrogate" {
    let result: JsonParseResult =
        parse("\"\\uDBFF\\uDFFF\"");

    assert result.ok;
    assert json_core::is_string(&result.value);
}

