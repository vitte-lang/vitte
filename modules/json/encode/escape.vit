/// JSON string escaping.
///
/// Implements JSON string escaping independently from the encoder.
///
/// Responsibilities:
/// - escape quotation marks;
/// - escape reverse solidus;
/// - optionally escape solidus;
/// - escape JSON control characters;
/// - encode remaining control characters as `\uXXXX`;
/// - preserve ordinary Unicode characters;
/// - produce complete quoted JSON strings;
/// - expose validation and inspection helpers.
///
/// This module performs escaping only. It does not parse JSON strings and
/// does not encode arbitrary JSON values.

space json::encode::escape;

const JSON_ESCAPE_CONTROL_LIMIT: u64 = 32;
const JSON_ESCAPE_HEX_BASE: u64 = 16;
const JSON_ESCAPE_HEX_MASK: u64 = 15;

pick JsonEscapeError {
    None,
    InvalidCharacter,
    InvalidUnicodeScalar,
}

form JsonEscapeOptions {
    escape_slash: bool,
    escape_non_ascii: bool,
}

form JsonEscapeResult {
    ok: bool,
    text: string,
    error: JsonEscapeError,
}

form JsonEscapeStatistics {
    input_characters: usize,
    output_characters: usize,
    escaped_characters: usize,
    quote_escapes: usize,
    backslash_escapes: usize,
    slash_escapes: usize,
    control_escapes: usize,
    unicode_escapes: usize,
}

/// -------------------------------------------------------------------------
/// Options
/// -------------------------------------------------------------------------

proc default_options() -> JsonEscapeOptions {
    return JsonEscapeOptions {
        escape_slash: false,
        escape_non_ascii: false,
    };
}

proc ascii_options() -> JsonEscapeOptions {
    return JsonEscapeOptions {
        escape_slash: false,
        escape_non_ascii: true,
    };
}

proc slash_options() -> JsonEscapeOptions {
    return JsonEscapeOptions {
        escape_slash: true,
        escape_non_ascii: false,
    };
}

proc strict_ascii_options() -> JsonEscapeOptions {
    return JsonEscapeOptions {
        escape_slash: true,
        escape_non_ascii: true,
    };
}

/// -------------------------------------------------------------------------
/// Results
/// -------------------------------------------------------------------------

proc success(
    text: string
) -> JsonEscapeResult {
    return JsonEscapeResult {
        ok: true,
        text: text,
        error: JsonEscapeError.None,
    };
}

proc failure(
    error: JsonEscapeError
) -> JsonEscapeResult {
    return JsonEscapeResult {
        ok: false,
        text: "",
        error: error,
    };
}

proc error_name(
    error: JsonEscapeError
) -> string {
    if error ==
       JsonEscapeError.None {
        return "none";
    }

    if error ==
       JsonEscapeError.InvalidCharacter {
        return "invalid character";
    }

    return "invalid Unicode scalar";
}

/// -------------------------------------------------------------------------
/// Unicode scalar inspection
/// -------------------------------------------------------------------------

proc is_high_surrogate(
    value: u64
) -> bool {
    return value >= 0xD800 &&
         value <= 0xDBFF;
}

proc is_low_surrogate(
    value: u64
) -> bool {
    return value >= 0xDC00 &&
         value <= 0xDFFF;
}

proc is_surrogate(
    value: u64
) -> bool {
    return value >= 0xD800 &&
         value <= 0xDFFF;
}

proc is_valid_unicode_scalar(
    value: u64
) -> bool {
    if value > 0x10FFFF {
        return false;
    }

    if is_surrogate(value) {
        return false;
    }

    return true;
}

proc is_ascii(
    value: u64
) -> bool {
    return value <= 0x7F;
}

proc is_control(
    value: u64
) -> bool {
    return value <
         JSON_ESCAPE_CONTROL_LIMIT;
}

proc requires_json_escape(
    value: char
) -> bool {
    if value == '"' {
        return true;
    }

    if value == '\\' {
        return true;
    }

    let code: u64 =
        value as u64;

    return is_control(code);
}

proc requires_escape_with_options(
    value: char,
    options: JsonEscapeOptions
) -> bool {
    if requires_json_escape(value) {
        return true;
    }

    if value == '/' &&
       options.escape_slash {
        return true;
    }

    let code: u64 =
        value as u64;

    if options.escape_non_ascii &&
       not is_ascii(code) {
        return true;
    }

    return false;
}

/// -------------------------------------------------------------------------
/// Hexadecimal conversion
/// -------------------------------------------------------------------------

proc hex_digit(
    value: u64
) -> string {
    if value == 0 {
        return "0";
    }

    if value == 1 {
        return "1";
    }

    if value == 2 {
        return "2";
    }

    if value == 3 {
        return "3";
    }

    if value == 4 {
        return "4";
    }

    if value == 5 {
        return "5";
    }

    if value == 6 {
        return "6";
    }

    if value == 7 {
        return "7";
    }

    if value == 8 {
        return "8";
    }

    if value == 9 {
        return "9";
    }

    if value == 10 {
        return "A";
    }

    if value == 11 {
        return "B";
    }

    if value == 12 {
        return "C";
    }

    if value == 13 {
        return "D";
    }

    if value == 14 {
        return "E";
    }

    return "F";
}

proc hex4(
    value: u64
) -> string {
    let a: u64 =
        (value >> 12) &
        JSON_ESCAPE_HEX_MASK;

    let b: u64 =
        (value >> 8) &
        JSON_ESCAPE_HEX_MASK;

    let c: u64 =
        (value >> 4) &
        JSON_ESCAPE_HEX_MASK;

    let d: u64 =
        value &
        JSON_ESCAPE_HEX_MASK;

    return hex_digit(a) +
         hex_digit(b) +
         hex_digit(c) +
         hex_digit(d);
}

proc unicode_escape_bmp(
    value: u64
) -> string {
    return "\\u" +
         hex4(value);
}

/// -------------------------------------------------------------------------
/// Supplementary Unicode encoding
///
/// JSON uses UTF-16 surrogate pairs when a non-BMP scalar is explicitly
/// represented with `\uXXXX` escapes.
/// -------------------------------------------------------------------------

proc high_surrogate_for(
    value: u64
) -> u64 {
    let adjusted: u64 =
        value - 0x10000;

    return 0xD800 +
         (adjusted >> 10);
}

proc low_surrogate_for(
    value: u64
) -> u64 {
    let adjusted: u64 =
        value - 0x10000;

    return 0xDC00 +
         (adjusted & 0x3FF);
}

proc unicode_escape_scalar(
    value: u64
) -> JsonEscapeResult {
    if not is_valid_unicode_scalar(
        value) {
        return failure(
            JsonEscapeError.InvalidUnicodeScalar);
    }

    if value <= 0xFFFF {
        return success(
            unicode_escape_bmp(
                value));
    }

    let high: u64 =
        high_surrogate_for(
            value);

    let low: u64 =
        low_surrogate_for(
            value);

    return success(
        unicode_escape_bmp(high) +
        unicode_escape_bmp(low));
}

/// -------------------------------------------------------------------------
/// Short JSON escapes
/// -------------------------------------------------------------------------

proc has_short_escape(
    value: char
) -> bool {
    if value == '"' {
        return true;
    }

    if value == '\\' {
        return true;
    }

    if value == '\b' {
        return true;
    }

    if value == '\f' {
        return true;
    }

    if value == '\n' {
        return true;
    }

    if value == '\r' {
        return true;
    }

    if value == '\t' {
        return true;
    }

    return false;
}

proc short_escape(
    value: char
) -> string {
    if value == '"' {
        return "\\\"";
    }

    if value == '\\' {
        return "\\\\";
    }

    if value == '\b' {
        return "\\b";
    }

    if value == '\f' {
        return "\\f";
    }

    if value == '\n' {
        return "\\n";
    }

    if value == '\r' {
        return "\\r";
    }

    if value == '\t' {
        return "\\t";
    }

    return "";
}

/// -------------------------------------------------------------------------
/// Character escaping
/// -------------------------------------------------------------------------

proc escape_character_with_options(
    value: char,
    options: JsonEscapeOptions
) -> JsonEscapeResult {
    let code: u64 =
        value as u64;

    if not is_valid_unicode_scalar(
        code) {
        return failure(
            JsonEscapeError.InvalidUnicodeScalar);
    }

    if has_short_escape(
        value) {
        return success(
            short_escape(
                value));
    }

    if value == '/' &&
       options.escape_slash {
        return success(
            "\\/");
    }

    if is_control(code) {
        return success(
            unicode_escape_bmp(
                code));
    }

    if options.escape_non_ascii &&
       not is_ascii(code) {
        return unicode_escape_scalar(
            code);
    }

    return success(
        "" + value);
}

proc escape_character(
    value: char
) -> JsonEscapeResult {
    return escape_character_with_options(
        value,
        default_options());
}

/// -------------------------------------------------------------------------
/// Raw string validation
/// -------------------------------------------------------------------------

proc validate_string(
    value: string
) -> bool {
    let mut index: usize = 0;

    while index <
          value.length {
        let code: u64 =
            value[index] as u64;

        if not is_valid_unicode_scalar(
            code) {
            return false;
        }

        set index += 1;
    }

    return true;
}

/// -------------------------------------------------------------------------
/// String escaping
///
/// `escape` returns the escaped contents without surrounding quotation
/// marks.
///
/// `quote` returns a complete JSON string literal.
/// -------------------------------------------------------------------------

proc escape_with_options(
    value: string,
    options: JsonEscapeOptions
) -> JsonEscapeResult {
    if not validate_string(
        value) {
        return failure(
            JsonEscapeError.InvalidUnicodeScalar);
    }

    let mut output: string = "";

    let mut index: usize = 0;

    while index <
          value.length {
        let escaped:
            JsonEscapeResult =
                escape_character_with_options(
                    value[index],
                    options);

        if not escaped.ok {
            return escaped;
        }

        set output =
            output +
            escaped.text;

        set index += 1;
    }

    return success(
        output);
}

proc escape(
    value: string
) -> JsonEscapeResult {
    return escape_with_options(
        value,
        default_options());
}

proc escape_ascii(
    value: string
) -> JsonEscapeResult {
    return escape_with_options(
        value,
        ascii_options());
}

proc escape_slashes(
    value: string
) -> JsonEscapeResult {
    return escape_with_options(
        value,
        slash_options());
}

proc escape_strict_ascii(
    value: string
) -> JsonEscapeResult {
    return escape_with_options(
        value,
        strict_ascii_options());
}

/// -------------------------------------------------------------------------
/// Quoted JSON strings
/// -------------------------------------------------------------------------

proc quote_with_options(
    value: string,
    options: JsonEscapeOptions
) -> JsonEscapeResult {
    let escaped:
        JsonEscapeResult =
            escape_with_options(
                value,
                options);

    if not escaped.ok {
        return escaped;
    }

    return success(
        "\"" +
        escaped.text +
        "\"");
}

proc quote(
    value: string
) -> JsonEscapeResult {
    return quote_with_options(
        value,
        default_options());
}

proc quote_ascii(
    value: string
) -> JsonEscapeResult {
    return quote_with_options(
        value,
        ascii_options());
}

proc quote_slashes(
    value: string
) -> JsonEscapeResult {
    return quote_with_options(
        value,
        slash_options());
}

proc quote_strict_ascii(
    value: string
) -> JsonEscapeResult {
    return quote_with_options(
        value,
        strict_ascii_options());
}

/// -------------------------------------------------------------------------
/// Escape inspection
/// -------------------------------------------------------------------------

proc escape_count_with_options(
    value: string,
    options: JsonEscapeOptions
) -> usize {
    let mut result: usize = 0;
    let mut index: usize = 0;

    while index <
          value.length {
        if requires_escape_with_options(
            value[index],
            options) {
            set result += 1;
        }

        set index += 1;
    }

    return result;
}

proc escape_count(
    value: string
) -> usize {
    return escape_count_with_options(
        value,
        default_options());
}

proc requires_escaping(
    value: string
) -> bool {
    return escape_count(
        value) != 0;
}

proc requires_escaping_with_options(
    value: string,
    options: JsonEscapeOptions
) -> bool {
    return escape_count_with_options(
        value,
        options) != 0;
}

/// -------------------------------------------------------------------------
/// Escape statistics
/// -------------------------------------------------------------------------

proc statistics_with_options(
    value: string,
    options: JsonEscapeOptions
) -> JsonEscapeStatistics {
    let mut escaped_characters: usize = 0;
    let mut quote_escapes: usize = 0;
    let mut backslash_escapes: usize = 0;
    let mut slash_escapes: usize = 0;
    let mut control_escapes: usize = 0;
    let mut unicode_escapes: usize = 0;

    let mut index: usize = 0;

    while index <
          value.length {
        let current: char =
            value[index];

        let code: u64 =
            current as u64;

        if current == '"' {
            set escaped_characters += 1;
            set quote_escapes += 1;
        } else if current == '\\' {
            set escaped_characters += 1;
            set backslash_escapes += 1;
        } else if current == '/' &&
                       options.escape_slash {
            set escaped_characters += 1;
            set slash_escapes += 1;
        } else if is_control(code) {
            set escaped_characters += 1;
            set control_escapes += 1;

            if not has_short_escape(
                current) {
                set unicode_escapes += 1;
            }
        } else if options.escape_non_ascii &&
                       not is_ascii(code) {
            set escaped_characters += 1;
            set unicode_escapes += 1;
        }

        set index += 1;
    }

    let encoded:
        JsonEscapeResult =
            escape_with_options(
                value,
                options);

    let mut output_characters: usize = 0;

    if encoded.ok {
        set output_characters =
            encoded.text.length;
    }

    return JsonEscapeStatistics {
        input_characters:
            value.length,

        output_characters:
            output_characters,

        escaped_characters:
            escaped_characters,

        quote_escapes:
            quote_escapes,

        backslash_escapes:
            backslash_escapes,

        slash_escapes:
            slash_escapes,

        control_escapes:
            control_escapes,

        unicode_escapes:
            unicode_escapes,
    };
}

proc statistics(
    value: string
) -> JsonEscapeStatistics {
    return statistics_with_options(
        value,
        default_options());
}

/// -------------------------------------------------------------------------
/// Escape size estimation
/// -------------------------------------------------------------------------

proc escaped_length_with_options(
    value: string,
    options: JsonEscapeOptions
) -> usize {
    let result:
        JsonEscapeResult =
            escape_with_options(
                value,
                options);

    if not result.ok {
        return 0;
    }

    return result.text.length;
}

proc escaped_length(
    value: string
) -> usize {
    return escaped_length_with_options(
        value,
        default_options());
}

proc quoted_length_with_options(
    value: string,
    options: JsonEscapeOptions
) -> usize {
    let length: usize =
        escaped_length_with_options(
            value,
            options);

    return length + 2;
}

proc quoted_length(
    value: string
) -> usize {
    return quoted_length_with_options(
        value,
        default_options());
}

/// -------------------------------------------------------------------------
/// Tests — hexadecimal conversion
/// -------------------------------------------------------------------------

test "json escape hexadecimal digits" {
    assert hex_digit(0) == "0";
    assert hex_digit(1) == "1";
    assert hex_digit(9) == "9";
    assert hex_digit(10) == "A";
    assert hex_digit(11) == "B";
    assert hex_digit(12) == "C";
    assert hex_digit(13) == "D";
    assert hex_digit(14) == "E";
    assert hex_digit(15) == "F";
}

test "json escape four hexadecimal digits" {
    assert hex4(0) ==
        "0000";

    assert hex4(10) ==
        "000A";

    assert hex4(31) ==
        "001F";

    assert hex4(255) ==
        "00FF";

    assert hex4(0x1234) ==
        "1234";
}

/// -------------------------------------------------------------------------
/// Tests — Unicode
/// -------------------------------------------------------------------------

test "json escape unicode scalar validation" {
    assert is_valid_unicode_scalar(
        0);

    assert is_valid_unicode_scalar(
        0x7F);

    assert is_valid_unicode_scalar(
        0xFFFF);

    assert is_valid_unicode_scalar(
        0x10000);

    assert is_valid_unicode_scalar(
        0x10FFFF);

    assert not is_valid_unicode_scalar(
        0xD800);

    assert not is_valid_unicode_scalar(
        0xDFFF);

    assert not is_valid_unicode_scalar(
        0x110000);
}

test "json escape bmp unicode" {
    let result:
        JsonEscapeResult =
            unicode_escape_scalar(
                0x00E9);

    assert result.ok;

    assert result.text ==
        "\\u00E9";
}

test "json escape supplementary unicode" {
    let result:
        JsonEscapeResult =
            unicode_escape_scalar(
                0x1F600);

    assert result.ok;

    assert result.text ==
        "\\uD83D\\uDE00";
}

test "json escape surrogate generation" {
    assert high_surrogate_for(
        0x1F600) ==
            0xD83D;

    assert low_surrogate_for(
        0x1F600) ==
            0xDE00;
}

/// -------------------------------------------------------------------------
/// Tests — characters
/// -------------------------------------------------------------------------

test "json escape quotation mark" {
    let result:
        JsonEscapeResult =
            escape_character('"');

    assert result.ok;

    assert result.text ==
        "\\\"";
}

test "json escape backslash" {
    let result:
        JsonEscapeResult =
            escape_character('\\');

    assert result.ok;

    assert result.text ==
        "\\\\";
}

test "json escape newline" {
    let result:
        JsonEscapeResult =
            escape_character('\n');

    assert result.ok;

    assert result.text ==
        "\\n";
}

test "json escape carriage return" {
    let result:
        JsonEscapeResult =
            escape_character('\r');

    assert result.ok;

    assert result.text ==
        "\\r";
}

test "json escape tab" {
    let result:
        JsonEscapeResult =
            escape_character('\t');

    assert result.ok;

    assert result.text ==
        "\\t";
}

test "json escape backspace" {
    let result:
        JsonEscapeResult =
            escape_character('\b');

    assert result.ok;

    assert result.text ==
        "\\b";
}

test "json escape form feed" {
    let result:
        JsonEscapeResult =
            escape_character('\f');

    assert result.ok;

    assert result.text ==
        "\\f";
}

test "json escape ordinary character" {
    let result:
        JsonEscapeResult =
            escape_character('V');

    assert result.ok;

    assert result.text ==
        "V";
}

/// -------------------------------------------------------------------------
/// Tests — strings
/// -------------------------------------------------------------------------

test "json escape empty string" {
    let result:
        JsonEscapeResult =
            escape("");

    assert result.ok;

    assert result.text ==
        "";
}

test "json escape ordinary string" {
    let result:
        JsonEscapeResult =
            escape("Vitte");

    assert result.ok;

    assert result.text ==
        "Vitte";
}

test "json escape quotation in string" {
    let result:
        JsonEscapeResult =
            escape(
                "Vitte \"JSON\"");

    assert result.ok;

    assert result.text ==
        "Vitte \\\"JSON\\\"";
}

test "json escape backslash in string" {
    let result:
        JsonEscapeResult =
            escape(
                "a\\b");

    assert result.ok;

    assert result.text ==
        "a\\\\b";
}

test "json escape newline in string" {
    let result:
        JsonEscapeResult =
            escape(
                "first\nsecond");

    assert result.ok;

    assert result.text ==
        "first\\nsecond";
}

test "json escape multiple special characters" {
    let result:
        JsonEscapeResult =
            escape(
                "\"\\\n\r\t");

    assert result.ok;

    assert result.text ==
        "\\\"\\\\\\n\\r\\t";
}

/// -------------------------------------------------------------------------
/// Tests — quoting
/// -------------------------------------------------------------------------

test "json quote empty string" {
    let result:
        JsonEscapeResult =
            quote("");

    assert result.ok;

    assert result.text ==
        "\"\"";
}

test "json quote ordinary string" {
    let result:
        JsonEscapeResult =
            quote("Vitte");

    assert result.ok;

    assert result.text ==
        "\"Vitte\"";
}

test "json quote escaped string" {
    let result:
        JsonEscapeResult =
            quote(
                "Vitte \"JSON\"");

    assert result.ok;

    assert result.text ==
        "\"Vitte \\\"JSON\\\"\"";
}

/// -------------------------------------------------------------------------
/// Tests — slash escaping
/// -------------------------------------------------------------------------

test "json slash is not escaped by default" {
    let result:
        JsonEscapeResult =
            escape(
                "https://vitte.dev/");

    assert result.ok;

    assert result.text ==
        "https://vitte.dev/";
}

test "json optional slash escaping" {
    let result:
        JsonEscapeResult =
            escape_slashes(
                "</script>");

    assert result.ok;

    assert result.text ==
        "<\\/script>";
}

/// -------------------------------------------------------------------------
/// Tests — ASCII mode
/// -------------------------------------------------------------------------

test "json ascii mode preserves ascii" {
    let result:
        JsonEscapeResult =
            escape_ascii(
                "Vitte JSON");

    assert result.ok;

    assert result.text ==
        "Vitte JSON";
}

test "json ascii mode escapes bmp unicode" {
    let result:
        JsonEscapeResult =
            escape_ascii(
                "café");

    assert result.ok;

    assert result.text ==
        "caf\\u00E9";
}

test "json ascii mode escapes supplementary unicode" {
    let result:
        JsonEscapeResult =
            escape_ascii(
                "😀");

    assert result.ok;

    assert result.text ==
        "\\uD83D\\uDE00";
}

/// -------------------------------------------------------------------------
/// Tests — inspection
/// -------------------------------------------------------------------------

test "json escape requirement" {
    assert not requires_escaping(
        "Vitte");

    assert requires_escaping(
        "Vitte\nJSON");

    assert requires_escaping(
        "\"Vitte\"");
}

test "json escape count" {
    assert escape_count(
        "Vitte") == 0;

    assert escape_count(
        "\"Vitte\"\n") == 3;
}

test "json escaped length" {
    assert escaped_length(
        "Vitte") == 5;

    assert quoted_length(
        "Vitte") == 7;
}

/// -------------------------------------------------------------------------
/// Tests — statistics
/// -------------------------------------------------------------------------

test "json escape statistics ordinary string" {
    let stats:
        JsonEscapeStatistics =
            statistics(
                "Vitte");

    assert stats.input_characters == 5;

    assert stats.output_characters == 5;

    assert stats.escaped_characters == 0;

    assert stats.quote_escapes == 0;

    assert stats.backslash_escapes == 0;

    assert stats.control_escapes == 0;
}

test "json escape statistics escaped string" {
    let stats:
        JsonEscapeStatistics =
            statistics(
                "\"Vitte\"\n");

    assert stats.input_characters == 8;

    assert stats.escaped_characters == 3;

    assert stats.quote_escapes == 2;

    assert stats.control_escapes == 1;
}

/// -------------------------------------------------------------------------
/// Tests — complete JSON key/value strings
/// -------------------------------------------------------------------------

test "json escape object key" {
    let result:
        JsonEscapeResult =
            quote(
                "project\"name");

    assert result.ok;

    assert result.text ==
        "\"project\\\"name\"";
}

test "json escape complex string" {
    let result:
        JsonEscapeResult =
            quote(
                "Vitte\nJSON\t\"encoder\"\\test");

    assert result.ok;

    assert result.text ==
        "\"Vitte\\nJSON\\t\\\"encoder\\\"\\\\test\"";
}

test "json escape strict ascii" {
    let result:
        JsonEscapeResult =
            quote_strict_ascii(
                "Vitte / café 😀");

    assert result.ok;

    assert result.text ==
        "\"Vitte \\/ caf\\u00E9 \\uD83D\\uDE00\"";
}