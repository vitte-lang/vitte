// ============================================================================
// Vitte Standard Library
// Module: math.classification.isinf
// File: modules/math/src/classification/isinf.vit
//
// Detect positive and negative IEEE 754 infinity by comparing against the
// largest finite values of each format. NaN comparisons remain false.
// ============================================================================

space math.classification.isinf

const F32_MAX_FINITE: f32 = 3.40282346638528859811704183484516925440e38;
const F64_MAX_FINITE: f64 = 1.797693134862315708145274237317043567981e308;

export proc isinf_f32(value: f32) -> bool {
    return value > F32_MAX_FINITE || value < -F32_MAX_FINITE
}

export proc isinf_f64(value: f64) -> bool {
    return value > F64_MAX_FINITE || value < -F64_MAX_FINITE
}
