// ============================================================================
// Vitte Standard Library
// Module: math.classification.isfinite
// File: modules/math/src/classification/isfinite.vit
//
// Return true exactly when a value is neither NaN nor positive/negative
// infinity. The finite bounds use the largest representable value of each
// IEEE 754 format.
// ============================================================================

space math.classification.isfinite

const F32_MAX_FINITE: f32 = 3.40282346638528859811704183484516925440e38;
const F64_MAX_FINITE: f64 = 1.797693134862315708145274237317043567981e308;

export proc isfinite_f32(value: f32) -> bool {
    return value == value &&
        value <= F32_MAX_FINITE &&
        value >= -F32_MAX_FINITE
}

export proc isfinite_f64(value: f64) -> bool {
    return value == value &&
        value <= F64_MAX_FINITE &&
        value >= -F64_MAX_FINITE
}
