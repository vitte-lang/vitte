// ============================================================================
// Vitte Standard Library
// Module: math.classification.isnormal
// File: modules/math/src/classification/isnormal.vit
//
// IEEE 754 normal-number detection using each format's minimum normal and
// maximum finite values.
// ============================================================================

space math.classification.isnormal

const F32_MAX_FINITE: f32 = 3.40282346638528859811704183484516925440e38;
const F32_MIN_NORMAL: f32 = 1.17549435082228750796873653722224568e-38;
const F64_MAX_FINITE: f64 = 1.797693134862315708145274237317043567981e308;
const F64_MIN_NORMAL: f64 = 2.22507385850720138309023271733240406e-308;

export proc isnormal_f32(value: f32) -> bool {
    if value >= F32_MIN_NORMAL && value <= F32_MAX_FINITE {
        return true
    }

    return value <= -F32_MIN_NORMAL && value >= -F32_MAX_FINITE
}

export proc isnormal_f64(value: f64) -> bool {
    if value >= F64_MIN_NORMAL && value <= F64_MAX_FINITE {
        return true
    }

    return value <= -F64_MIN_NORMAL && value >= -F64_MAX_FINITE
}
