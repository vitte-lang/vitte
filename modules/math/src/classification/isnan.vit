// ============================================================================
// Vitte Standard Library
// Module: math.classification.isnan
// File: modules/math/src/classification/isnan.vit
//
// IEEE 754 NaN detection: NaN is the only floating-point value unequal to
// itself.
// ============================================================================

space math.classification.isnan

export proc isnan_f32(value: f32) -> bool {
    return value != value
}

export proc isnan_f64(value: f64) -> bool {
    return value != value
}
