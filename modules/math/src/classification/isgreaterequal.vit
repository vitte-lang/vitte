// ============================================================================
// Vitte Standard Library
// Module: math.classification.isgreaterequal
// File: modules/math/src/classification/isgreaterequal.vit
//
// IEEE 754 greater-than-or-equal predicates. Ordered comparisons involving
// NaN evaluate to false.
// ============================================================================

space math.classification.isgreaterequal

export proc isgreaterequal_f32(left: f32, right: f32) -> bool {
    return left >= right
}

export proc isgreaterequal_f64(left: f64, right: f64) -> bool {
    return left >= right
}
