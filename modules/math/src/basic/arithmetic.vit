// ============================================================================
// Vitte Standard Library
// Module: math.basic.arithmetic
// File: modules/math/src/basic/arithmetic.vit
//
// Fundamental arithmetic operations.
// Native Vitte implementation.
//
// No external C library required.
// ============================================================================

space math.basic.arithmetic

// ============================================================================
// 1. SIGNED INTEGER ADDITION
// ============================================================================

export proc add_i8(a: i8, b: i8) -> i8 {
    return a + b
}

export proc add_i16(a: i16, b: i16) -> i16 {
    return a + b
}

export proc add_i32(a: i32, b: i32) -> i32 {
    return a + b
}

export proc add_i64(a: i64, b: i64) -> i64 {
    return a + b
}

// ============================================================================
// 2. UNSIGNED INTEGER ADDITION
// ============================================================================

export proc add_u8(a: u8, b: u8) -> u8 {
    return a + b
}

export proc add_u16(a: u16, b: u16) -> u16 {
    return a + b
}

export proc add_u32(a: u32, b: u32) -> u32 {
    return a + b
}

export proc add_u64(a: u64, b: u64) -> u64 {
    return a + b
}

// ============================================================================
// 3. FLOATING-POINT ADDITION
// ============================================================================

export proc add_f32(a: f32, b: f32) -> f32 {
    return a + b
}

export proc add_f64(a: f64, b: f64) -> f64 {
    return a + b
}

// ============================================================================
// 4. SUBTRACTION
// ============================================================================

export proc sub_i8(a: i8, b: i8) -> i8 {
    return a - b
}

export proc sub_i16(a: i16, b: i16) -> i16 {
    return a - b
}

export proc sub_i32(a: i32, b: i32) -> i32 {
    return a - b
}

export proc sub_i64(a: i64, b: i64) -> i64 {
    return a - b
}

export proc sub_u8(a: u8, b: u8) -> u8 {
    return a - b
}

export proc sub_u16(a: u16, b: u16) -> u16 {
    return a - b
}

export proc sub_u32(a: u32, b: u32) -> u32 {
    return a - b
}

export proc sub_u64(a: u64, b: u64) -> u64 {
    return a - b
}

export proc sub_f32(a: f32, b: f32) -> f32 {
    return a - b
}

export proc sub_f64(a: f64, b: f64) -> f64 {
    return a - b
}

// ============================================================================
// 5. MULTIPLICATION
// ============================================================================

export proc mul_i8(a: i8, b: i8) -> i8 {
    return a * b
}

export proc mul_i16(a: i16, b: i16) -> i16 {
    return a * b
}

export proc mul_i32(a: i32, b: i32) -> i32 {
    return a * b
}

export proc mul_i64(a: i64, b: i64) -> i64 {
    return a * b
}

export proc mul_u8(a: u8, b: u8) -> u8 {
    return a * b
}

export proc mul_u16(a: u16, b: u16) -> u16 {
    return a * b
}

export proc mul_u32(a: u32, b: u32) -> u32 {
    return a * b
}

export proc mul_u64(a: u64, b: u64) -> u64 {
    return a * b
}

export proc mul_f32(a: f32, b: f32) -> f32 {
    return a * b
}

export proc mul_f64(a: f64, b: f64) -> f64 {
    return a * b
}

// ============================================================================
// 6. DIVISION
//
// The caller must ensure that the divisor is not zero.
// Signed integer division must also handle MIN / -1.
// ============================================================================

export proc div_i8(a: i8, b: i8) -> i8 {
    return a / b
}

export proc div_i16(a: i16, b: i16) -> i16 {
    return a / b
}

export proc div_i32(a: i32, b: i32) -> i32 {
    return a / b
}

export proc div_i64(a: i64, b: i64) -> i64 {
    return a / b
}

export proc div_u8(a: u8, b: u8) -> u8 {
    return a / b
}

export proc div_u16(a: u16, b: u16) -> u16 {
    return a / b
}

export proc div_u32(a: u32, b: u32) -> u32 {
    return a / b
}

export proc div_u64(a: u64, b: u64) -> u64 {
    return a / b
}

export proc div_f32(a: f32, b: f32) -> f32 {
    return a / b
}

export proc div_f64(a: f64, b: f64) -> f64 {
    return a / b
}

// ============================================================================
// 7. REMAINDER
// ============================================================================

export proc rem_i8(a: i8, b: i8) -> i8 {
    return a % b
}

export proc rem_i16(a: i16, b: i16) -> i16 {
    return a % b
}

export proc rem_i32(a: i32, b: i32) -> i32 {
    return a % b
}

export proc rem_i64(a: i64, b: i64) -> i64 {
    return a % b
}

export proc rem_u8(a: u8, b: u8) -> u8 {
    return a % b
}

export proc rem_u16(a: u16, b: u16) -> u16 {
    return a % b
}

export proc rem_u32(a: u32, b: u32) -> u32 {
    return a % b
}

export proc rem_u64(a: u64, b: u64) -> u64 {
    return a % b
}

// ============================================================================
// 8. NEGATION
// ============================================================================

export proc neg_i8(x: i8) -> i8 {
    return -x
}

export proc neg_i16(x: i16) -> i16 {
    return -x
}

export proc neg_i32(x: i32) -> i32 {
    return -x
}

export proc neg_i64(x: i64) -> i64 {
    return -x
}

export proc neg_f32(x: f32) -> f32 {
    return -x
}

export proc neg_f64(x: f64) -> f64 {
    return -x
}

// ============================================================================
// 9. SQUARE
// ============================================================================

export proc square_i32(x: i32) -> i32 {
    return x * x
}

export proc square_i64(x: i64) -> i64 {
    return x * x
}

export proc square_u32(x: u32) -> u32 {
    return x * x
}

export proc square_u64(x: u64) -> u64 {
    return x * x
}

export proc square_f32(x: f32) -> f32 {
    return x * x
}

export proc square_f64(x: f64) -> f64 {
    return x * x
}

// ============================================================================
// 10. CUBE
// ============================================================================

export proc cube_i32(x: i32) -> i32 {
    return x * x * x
}

export proc cube_i64(x: i64) -> i64 {
    return x * x * x
}

export proc cube_u32(x: u32) -> u32 {
    return x * x * x
}

export proc cube_u64(x: u64) -> u64 {
    return x * x * x
}

export proc cube_f32(x: f32) -> f32 {
    return x * x * x
}

export proc cube_f64(x: f64) -> f64 {
    return x * x * x
}

// ============================================================================
// 11. AVERAGE
// ============================================================================

export proc average_f32(a: f32, b: f32) -> f32 {
    return (a + b) / 2.0
}

export proc average_f64(a: f64, b: f64) -> f64 {
    return (a + b) / 2.0
}

// ============================================================================
// 12. LINEAR INTERPOLATION
// ============================================================================

export proc lerp_f32(a: f32, b: f32, t: f32) -> f32 {
    return a + (b - a) * t
}

export proc lerp_f64(a: f64, b: f64, t: f64) -> f64 {
    return a + (b - a) * t
}

// ============================================================================
// 13. MULTIPLY-ADD
//
// Not equivalent to a hardware fused multiply-add.
// ============================================================================

export proc multiply_add_f32(a: f32, b: f32, c: f32) -> f32 {
    return a * b + c
}

export proc multiply_add_f64(a: f64, b: f64, c: f64) -> f64 {
    return a * b + c
}

// ============================================================================
// 14. RECIPROCAL
// ============================================================================

export proc reciprocal_f32(x: f32) -> f32 {
    return 1.0 / x
}

export proc reciprocal_f64(x: f64) -> f64 {
    return 1.0 / x
}

// ============================================================================
// 15. PERCENTAGE
// ============================================================================

export proc percentage_f32(value: f32, total: f32) -> f32 {
    return (value / total) * 100.0
}

export proc percentage_f64(value: f64, total: f64) -> f64 {
    return (value / total) * 100.0
}

// ============================================================================
// 16. PERCENTAGE OF A VALUE
// ============================================================================

export proc percent_of_f32(value: f32, percent: f32) -> f32 {
    return value * percent / 100.0
}

export proc percent_of_f64(value: f64, percent: f64) -> f64 {
    return value * percent / 100.0
}

// ============================================================================
// 17. RATIO
// ============================================================================

export proc ratio_f32(a: f32, b: f32) -> f32 {
    return a / b
}

export proc ratio_f64(a: f64, b: f64) -> f64 {
    return a / b
}

// ============================================================================
// 18. MIDPOINT
//
// Reduces overflow risk compared with (a + b) / 2.
// ============================================================================

export proc midpoint_f32(a: f32, b: f32) -> f32 {
    return a / 2.0 + b / 2.0
}

export proc midpoint_f64(a: f64, b: f64) -> f64 {
    return a / 2.0 + b / 2.0
}

// ============================================================================
// 19. CLAMP TO ZERO
// ============================================================================

export proc nonnegative_i32(x: i32) -> i32 {
    if x < 0 {
        return 0
    }

    return x
}

export proc nonnegative_i64(x: i64) -> i64 {
    if x < 0 {
        return 0
    }

    return x
}

export proc nonnegative_f32(x: f32) -> f32 {
    if x < 0.0 {
        return 0.0
    }

    return x
}

export proc nonnegative_f64(x: f64) -> f64 {
    if x < 0.0 {
        return 0.0
    }

    return x
}

// ============================================================================
// 20. RANGE MAPPING
//
// Requires input_max != input_min.
// ============================================================================

export proc map_range_f32(
    value: f32,
    input_min: f32,
    input_max: f32,
    output_min: f32,
    output_max: f32
) -> f32 {
    return output_min
        + (value - input_min)
        * (output_max - output_min)
        / (input_max - input_min)
}

export proc map_range_f64(
    value: f64,
    input_min: f64,
    input_max: f64,
    output_min: f64,
    output_max: f64
) -> f64 {
    return output_min
        + (value - input_min)
        * (output_max - output_min)
        / (input_max - input_min)
}