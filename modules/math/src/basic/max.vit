// ============================================================================
// Vitte Standard Library
// Module: math.basic.max
// File: modules/math/src/basic/max.vit
//
// Maximum operations for signed integers, unsigned integers and floats.
//
// Dependencies: none
// Allocation: none
//
// Floating-point policy:
//   - max_f32/max_f64 use ordinary comparisons.
//   - NaN handling follows the behavior of those comparisons.
//   - IEEE 754 fmax semantics are not guaranteed.
// ============================================================================

space math.basic.max

// ============================================================================
// 1. SIGNED INTEGER MAXIMUM
// ============================================================================

export proc max_i8(a: i8, b: i8) -> i8 {
    if a >= b {
        return a
    }
    return b
}

export proc max_i16(a: i16, b: i16) -> i16 {
    if a >= b {
        return a
    }
    return b
}

export proc max_i32(a: i32, b: i32) -> i32 {
    if a >= b {
        return a
    }
    return b
}

export proc max_i64(a: i64, b: i64) -> i64 {
    if a >= b {
        return a
    }
    return b
}

// ============================================================================
// 2. UNSIGNED INTEGER MAXIMUM
// ============================================================================

export proc max_u8(a: u8, b: u8) -> u8 {
    if a >= b {
        return a
    }
    return b
}

export proc max_u16(a: u16, b: u16) -> u16 {
    if a >= b {
        return a
    }
    return b
}

export proc max_u32(a: u32, b: u32) -> u32 {
    if a >= b {
        return a
    }
    return b
}

export proc max_u64(a: u64, b: u64) -> u64 {
    if a >= b {
        return a
    }
    return b
}

// ============================================================================
// 3. FLOATING-POINT MAXIMUM
// ============================================================================

export proc max_f32(a: f32, b: f32) -> f32 {
    if a >= b {
        return a
    }
    return b
}

export proc max_f64(a: f64, b: f64) -> f64 {
    if a >= b {
        return a
    }
    return b
}

// ============================================================================
// 4. MAXIMUM OF THREE VALUES
// ============================================================================

export proc max3_i32(a: i32, b: i32, c: i32) -> i32 {
    return max_i32(max_i32(a, b), c)
}

export proc max3_i64(a: i64, b: i64, c: i64) -> i64 {
    return max_i64(max_i64(a, b), c)
}

export proc max3_u32(a: u32, b: u32, c: u32) -> u32 {
    return max_u32(max_u32(a, b), c)
}

export proc max3_u64(a: u64, b: u64, c: u64) -> u64 {
    return max_u64(max_u64(a, b), c)
}

export proc max3_f32(a: f32, b: f32, c: f32) -> f32 {
    return max_f32(max_f32(a, b), c)
}

export proc max3_f64(a: f64, b: f64, c: f64) -> f64 {
    return max_f64(max_f64(a, b), c)
}

// ============================================================================
// 5. MAXIMUM OF FOUR VALUES
// ============================================================================

export proc max4_i32(a: i32, b: i32, c: i32, d: i32) -> i32 {
    return max_i32(max_i32(a, b), max_i32(c, d))
}

export proc max4_i64(a: i64, b: i64, c: i64, d: i64) -> i64 {
    return max_i64(max_i64(a, b), max_i64(c, d))
}

export proc max4_u32(a: u32, b: u32, c: u32, d: u32) -> u32 {
    return max_u32(max_u32(a, b), max_u32(c, d))
}

export proc max4_u64(a: u64, b: u64, c: u64, d: u64) -> u64 {
    return max_u64(max_u64(a, b), max_u64(c, d))
}

export proc max4_f32(a: f32, b: f32, c: f32, d: f32) -> f32 {
    return max_f32(max_f32(a, b), max_f32(c, d))
}

export proc max4_f64(a: f64, b: f64, c: f64, d: f64) -> f64 {
    return max_f64(max_f64(a, b), max_f64(c, d))
}

// ============================================================================
// 6. MAXIMUM WITH LOWER BOUND
// ============================================================================

export proc max_zero_i32(x: i32) -> i32 {
    return max_i32(x, 0)
}

export proc max_zero_i64(x: i64) -> i64 {
    return max_i64(x, 0)
}

export proc max_zero_f32(x: f32) -> f32 {
    return max_f32(x, 0.0)
}

export proc max_zero_f64(x: f64) -> f64 {
    return max_f64(x, 0.0)
}

// ============================================================================
// 7. COMPARISON HELPERS
// ============================================================================

export proc is_max_i32(a: i32, b: i32) -> bool {
    return a >= b
}

export proc is_max_i64(a: i64, b: i64) -> bool {
    return a >= b
}

export proc is_max_u32(a: u32, b: u32) -> bool {
    return a >= b
}

export proc is_max_u64(a: u64, b: u64) -> bool {
    return a >= b
}

export proc is_max_f32(a: f32, b: f32) -> bool {
    return a >= b
}

export proc is_max_f64(a: f64, b: f64) -> bool {
    return a >= b
}

// ============================================================================
// 8. MAXIMUM OF FIVE VALUES
// ============================================================================

export proc max5_i32(a: i32, b: i32, c: i32, d: i32, e: i32) -> i32 {
    return max_i32(max4_i32(a, b, c, d), e)
}

export proc max5_i64(a: i64, b: i64, c: i64, d: i64, e: i64) -> i64 {
    return max_i64(max4_i64(a, b, c, d), e)
}

export proc max5_f32(a: f32, b: f32, c: f32, d: f32, e: f32) -> f32 {
    return max_f32(max4_f32(a, b, c, d), e)
}

export proc max5_f64(a: f64, b: f64, c: f64, d: f64, e: f64) -> f64 {
    return max_f64(max4_f64(a, b, c, d), e)
}

// ============================================================================
// 9. MAXIMUM OF SIX VALUES
// ============================================================================

export proc max6_i32(
    a: i32, b: i32, c: i32,
    d: i32, e: i32, f: i32
) -> i32 {
    return max_i32(max3_i32(a, b, c), max3_i32(d, e, f))
}

export proc max6_i64(
    a: i64, b: i64, c: i64,
    d: i64, e: i64, f: i64
) -> i64 {
    return max_i64(max3_i64(a, b, c), max3_i64(d, e, f))
}

export proc max6_f32(
    a: f32, b: f32, c: f32,
    d: f32, e: f32, f: f32
) -> f32 {
    return max_f32(max3_f32(a, b, c), max3_f32(d, e, f))
}

export proc max6_f64(
    a: f64, b: f64, c: f64,
    d: f64, e: f64, f: f64
) -> f64 {
    return max_f64(max3_f64(a, b, c), max3_f64(d, e, f))
}

// ============================================================================
// 10. MAXIMUM BETWEEN POSITIVE VALUES
// ============================================================================

export proc positive_max_i32(a: i32, b: i32) -> i32 {
    return max_i32(max_i32(a, b), 0)
}

export proc positive_max_i64(a: i64, b: i64) -> i64 {
    return max_i64(max_i64(a, b), 0)
}

export proc positive_max_f32(a: f32, b: f32) -> f32 {
    return max_f32(max_f32(a, b), 0.0)
}

export proc positive_max_f64(a: f64, b: f64) -> f64 {
    return max_f64(max_f64(a, b), 0.0)
}