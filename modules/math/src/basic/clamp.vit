// ============================================================================
// Vitte Standard Library
// Module: math.basic.clamp
// File: modules/math/src/basic/clamp.vit
//
// Range limiting and clamping operations.
// Native Vitte implementation.
//
// Preconditions:
//   - min <= max for clamp functions.
//   - Floating-point NaN handling is not guaranteed.
// ============================================================================

space math.basic.clamp

// ============================================================================
// 1. CLAMP — SIGNED INTEGERS
// ============================================================================

export proc clamp_i8(x: i8, min_value: i8, max_value: i8) -> i8 {
    if x < min_value {
        return min_value
    }
    if x > max_value {
        return max_value
    }
    return x
}

export proc clamp_i16(x: i16, min_value: i16, max_value: i16) -> i16 {
    if x < min_value {
        return min_value
    }
    if x > max_value {
        return max_value
    }
    return x
}

export proc clamp_i32(x: i32, min_value: i32, max_value: i32) -> i32 {
    if x < min_value {
        return min_value
    }
    if x > max_value {
        return max_value
    }
    return x
}

export proc clamp_i64(x: i64, min_value: i64, max_value: i64) -> i64 {
    if x < min_value {
        return min_value
    }
    if x > max_value {
        return max_value
    }
    return x
}

// ============================================================================
// 2. CLAMP — UNSIGNED INTEGERS
// ============================================================================

export proc clamp_u8(x: u8, min_value: u8, max_value: u8) -> u8 {
    if x < min_value {
        return min_value
    }
    if x > max_value {
        return max_value
    }
    return x
}

export proc clamp_u16(x: u16, min_value: u16, max_value: u16) -> u16 {
    if x < min_value {
        return min_value
    }
    if x > max_value {
        return max_value
    }
    return x
}

export proc clamp_u32(x: u32, min_value: u32, max_value: u32) -> u32 {
    if x < min_value {
        return min_value
    }
    if x > max_value {
        return max_value
    }
    return x
}

export proc clamp_u64(x: u64, min_value: u64, max_value: u64) -> u64 {
    if x < min_value {
        return min_value
    }
    if x > max_value {
        return max_value
    }
    return x
}

// ============================================================================
// 3. CLAMP — FLOATING POINT
// ============================================================================

export proc clamp_f32(x: f32, min_value: f32, max_value: f32) -> f32 {
    if x < min_value {
        return min_value
    }
    if x > max_value {
        return max_value
    }
    return x
}

export proc clamp_f64(x: f64, min_value: f64, max_value: f64) -> f64 {
    if x < min_value {
        return min_value
    }
    if x > max_value {
        return max_value
    }
    return x
}

// ============================================================================
// 4. CLAMP MINIMUM
// ============================================================================

export proc clamp_min_i32(x: i32, minimum: i32) -> i32 {
    if x < minimum {
        return minimum
    }
    return x
}

export proc clamp_min_i64(x: i64, minimum: i64) -> i64 {
    if x < minimum {
        return minimum
    }
    return x
}

export proc clamp_min_f32(x: f32, minimum: f32) -> f32 {
    if x < minimum {
        return minimum
    }
    return x
}

export proc clamp_min_f64(x: f64, minimum: f64) -> f64 {
    if x < minimum {
        return minimum
    }
    return x
}

// ============================================================================
// 5. CLAMP MAXIMUM
// ============================================================================

export proc clamp_max_i32(x: i32, maximum: i32) -> i32 {
    if x > maximum {
        return maximum
    }
    return x
}

export proc clamp_max_i64(x: i64, maximum: i64) -> i64 {
    if x > maximum {
        return maximum
    }
    return x
}

export proc clamp_max_f32(x: f32, maximum: f32) -> f32 {
    if x > maximum {
        return maximum
    }
    return x
}

export proc clamp_max_f64(x: f64, maximum: f64) -> f64 {
    if x > maximum {
        return maximum
    }
    return x
}

// ============================================================================
// 6. CLAMP TO [0, 1]
// ============================================================================

export proc clamp01_f32(x: f32) -> f32 {
    return clamp_f32(x, 0.0, 1.0)
}

export proc clamp01_f64(x: f64) -> f64 {
    return clamp_f64(x, 0.0, 1.0)
}

// ============================================================================
// 7. CLAMP TO [-1, 1]
// ============================================================================

export proc clamp11_f32(x: f32) -> f32 {
    return clamp_f32(x, -1.0, 1.0)
}

export proc clamp11_f64(x: f64) -> f64 {
    return clamp_f64(x, -1.0, 1.0)
}

// ============================================================================
// 8. RANGE CHECKS
// ============================================================================

export proc in_range_i32(x: i32, minimum: i32, maximum: i32) -> bool {
    return x >= minimum && x <= maximum
}

export proc in_range_i64(x: i64, minimum: i64, maximum: i64) -> bool {
    return x >= minimum && x <= maximum
}

export proc in_range_f32(x: f32, minimum: f32, maximum: f32) -> bool {
    return x >= minimum && x <= maximum
}

export proc in_range_f64(x: f64, minimum: f64, maximum: f64) -> bool {
    return x >= minimum && x <= maximum
}

// ============================================================================
// 9. OUT-OF-RANGE CHECKS
// ============================================================================

export proc out_of_range_i32(x: i32, minimum: i32, maximum: i32) -> bool {
    return x < minimum || x > maximum
}

export proc out_of_range_i64(x: i64, minimum: i64, maximum: i64) -> bool {
    return x < minimum || x > maximum
}

export proc out_of_range_f32(x: f32, minimum: f32, maximum: f32) -> bool {
    return x < minimum || x > maximum
}

export proc out_of_range_f64(x: f64, minimum: f64, maximum: f64) -> bool {
    return x < minimum || x > maximum
}

// ============================================================================
// 10. NORMALIZATION
//
// Maps [minimum, maximum] to [0, 1].
// Requires maximum != minimum.
// ============================================================================

export proc normalize_f32(x: f32, minimum: f32, maximum: f32) -> f32 {
    return (x - minimum) / (maximum - minimum)
}

export proc normalize_f64(x: f64, minimum: f64, maximum: f64) -> f64 {
    return (x - minimum) / (maximum - minimum)
}

// ============================================================================
// 11. CLAMPED NORMALIZATION
// ============================================================================

export proc normalize_clamped_f32(x: f32, minimum: f32, maximum: f32) -> f32 {
    return clamp01_f32(normalize_f32(x, minimum, maximum))
}

export proc normalize_clamped_f64(x: f64, minimum: f64, maximum: f64) -> f64 {
    return clamp01_f64(normalize_f64(x, minimum, maximum))
}

// ============================================================================
// 12. DENORMALIZATION
//
// Maps [0, 1] to [minimum, maximum].
// ============================================================================

export proc denormalize_f32(t: f32, minimum: f32, maximum: f32) -> f32 {
    return minimum + t * (maximum - minimum)
}

export proc denormalize_f64(t: f64, minimum: f64, maximum: f64) -> f64 {
    return minimum + t * (maximum - minimum)
}

// ============================================================================
// 13. CLAMPED DENORMALIZATION
// ============================================================================

export proc denormalize_clamped_f32(t: f32, minimum: f32, maximum: f32) -> f32 {
    return denormalize_f32(clamp01_f32(t), minimum, maximum)
}

export proc denormalize_clamped_f64(t: f64, minimum: f64, maximum: f64) -> f64 {
    return denormalize_f64(clamp01_f64(t), minimum, maximum)
}

// ============================================================================
// 14. LIMIT MAGNITUDE
//
// Restricts x to [-maximum, maximum].
// Requires maximum >= 0.
// ============================================================================

export proc limit_magnitude_f32(x: f32, maximum: f32) -> f32 {
    return clamp_f32(x, -maximum, maximum)
}

export proc limit_magnitude_f64(x: f64, maximum: f64) -> f64 {
    return clamp_f64(x, -maximum, maximum)
}

// ============================================================================
// 15. SATURATE
// ============================================================================

export proc saturate_f32(x: f32) -> f32 {
    return clamp01_f32(x)
}

export proc saturate_f64(x: f64) -> f64 {
    return clamp01_f64(x)
}

// ============================================================================
// 16. CLAMP WITH AUTOMATIC BOUND ORDERING
// ============================================================================

export proc clamp_ordered_i32(x: i32, a: i32, b: i32) -> i32 {
    if a <= b {
        return clamp_i32(x, a, b)
    }

    return clamp_i32(x, b, a)
}

export proc clamp_ordered_i64(x: i64, a: i64, b: i64) -> i64 {
    if a <= b {
        return clamp_i64(x, a, b)
    }

    return clamp_i64(x, b, a)
}

export proc clamp_ordered_f32(x: f32, a: f32, b: f32) -> f32 {
    if a <= b {
        return clamp_f32(x, a, b)
    }

    return clamp_f32(x, b, a)
}

export proc clamp_ordered_f64(x: f64, a: f64, b: f64) -> f64 {
    if a <= b {
        return clamp_f64(x, a, b)
    }

    return clamp_f64(x, b, a)
}