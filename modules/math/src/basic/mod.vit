// ============================================================================
// Vitte Standard Library
// Module: math.basic.mod
// File: modules/math/src/basic/mod.vit
//
// Modulo and remainder operations.
//
// Dependencies: none
// Dynamic allocation: none
//
// Preconditions:
//   - Divisors must not be zero.
//   - Signed MIN % -1 requires compiler-defined handling.
// ============================================================================

space math.basic.mod

// ============================================================================
// 1. SIGNED INTEGER REMAINDER
// ============================================================================

export proc rem_i8(a: i8, b: i8) -> i8 {
    return a % b
}

export proc rem_i16(a: i16, b: i16) -> i16 {
    return a % b
}

export proc rem_i32(a: i32, b: i32) -> i32 {
    return a % b
}

export proc rem_i64(a: i64, b: i64) -> i64 {
    return a % b
}

// ============================================================================
// 2. UNSIGNED INTEGER REMAINDER
// ============================================================================

export proc rem_u8(a: u8, b: u8) -> u8 {
    return a % b
}

export proc rem_u16(a: u16, b: u16) -> u16 {
    return a % b
}

export proc rem_u32(a: u32, b: u32) -> u32 {
    return a % b
}

export proc rem_u64(a: u64, b: u64) -> u64 {
    return a % b
}

// ============================================================================
// 3. EUCLIDEAN MODULO — SIGNED INTEGERS
//
// For b != 0, returns a value in [0, |b|).
// ============================================================================

export proc mod_euclid_i8(a: i8, b: i8) -> i8 {
    let r: i8 = a % b;

    if r < 0 {
        if b < 0 {
            return r - b
        }
        return r + b
    }

    return r
}

export proc mod_euclid_i16(a: i16, b: i16) -> i16 {
    let r: i16 = a % b;

    if r < 0 {
        if b < 0 {
            return r - b
        }
        return r + b
    }

    return r
}

export proc mod_euclid_i32(a: i32, b: i32) -> i32 {
    let r: i32 = a % b;

    if r < 0 {
        if b < 0 {
            return r - b
        }
        return r + b
    }

    return r
}

export proc mod_euclid_i64(a: i64, b: i64) -> i64 {
    let r: i64 = a % b;

    if r < 0 {
        if b < 0 {
            return r - b
        }
        return r + b
    }

    return r
}

// ============================================================================
// 4. EUCLIDEAN MODULO — UNSIGNED INTEGERS
// ============================================================================

export proc mod_euclid_u8(a: u8, b: u8) -> u8 {
    return a % b
}

export proc mod_euclid_u16(a: u16, b: u16) -> u16 {
    return a % b
}

export proc mod_euclid_u32(a: u32, b: u32) -> u32 {
    return a % b
}

export proc mod_euclid_u64(a: u64, b: u64) -> u64 {
    return a % b
}

// ============================================================================
// 5. POSITIVE MODULO
//
// Requires modulus > 0.
// ============================================================================

export proc mod_positive_i32(a: i32, modulus: i32) -> i32 {
    let r: i32 = a % modulus;

    if r < 0 {
        return r + modulus
    }

    return r
}

export proc mod_positive_i64(a: i64, modulus: i64) -> i64 {
    let r: i64 = a % modulus;

    if r < 0 {
        return r + modulus
    }

    return r
}

// ============================================================================
// 6. MODULO WITH NEGATIVE DIVISORS
//
// Returns a remainder with the sign of the divisor.
// ============================================================================

export proc mod_floor_i32(a: i32, b: i32) -> i32 {
    let r: i32 = a % b;

    if r == 0 {
        return 0
    }

    if r < 0 && b > 0 {
        return r + b
    }

    if r > 0 && b < 0 {
        return r + b
    }

    return r
}

export proc mod_floor_i64(a: i64, b: i64) -> i64 {
    let r: i64 = a % b;

    if r == 0 {
        return 0
    }

    if r < 0 && b > 0 {
        return r + b
    }

    if r > 0 && b < 0 {
        return r + b
    }

    return r
}

// ============================================================================
// 7. DIVISIBILITY TESTS
// ============================================================================

export proc is_divisible_i32(a: i32, b: i32) -> bool {
    if b == 0 {
        return false
    }

    return a % b == 0
}

export proc is_divisible_i64(a: i64, b: i64) -> bool {
    if b == 0 {
        return false
    }

    return a % b == 0
}

export proc is_divisible_u32(a: u32, b: u32) -> bool {
    if b == 0 {
        return false
    }

    return a % b == 0
}

export proc is_divisible_u64(a: u64, b: u64) -> bool {
    if b == 0 {
        return false
    }

    return a % b == 0
}

// ============================================================================
// 8. EVEN NUMBER TESTS
// ============================================================================

export proc is_even_i32(x: i32) -> bool {
    return x % 2 == 0
}

export proc is_even_i64(x: i64) -> bool {
    return x % 2 == 0
}

export proc is_even_u32(x: u32) -> bool {
    return x % 2 == 0
}

export proc is_even_u64(x: u64) -> bool {
    return x % 2 == 0
}

// ============================================================================
// 9. ODD NUMBER TESTS
// ============================================================================

export proc is_odd_i32(x: i32) -> bool {
    return x % 2 != 0
}

export proc is_odd_i64(x: i64) -> bool {
    return x % 2 != 0
}

export proc is_odd_u32(x: u32) -> bool {
    return x % 2 != 0
}

export proc is_odd_u64(x: u64) -> bool {
    return x % 2 != 0
}

// ============================================================================
// 10. CIRCULAR INDEXING
//
// Requires length > 0.
// ============================================================================

export proc wrap_index_i32(index: i32, length: i32) -> i32 {
    return mod_positive_i32(index, length)
}

export proc wrap_index_i64(index: i64, length: i64) -> i64 {
    return mod_positive_i64(index, length)
}

export proc wrap_index_u32(index: u32, length: u32) -> u32 {
    return index % length
}

export proc wrap_index_u64(index: u64, length: u64) -> u64 {
    return index % length
}

// ============================================================================
// 11. CYCLIC INCREMENT
//
// Requires modulus > 0.
// Avoids overflow in value + 1.
// ============================================================================

export proc cyclic_increment_u32(value: u32, modulus: u32) -> u32 {
    let current: u32 = value % modulus;

    if current == modulus - 1 {
        return 0
    }

    return current + 1
}

export proc cyclic_increment_u64(value: u64, modulus: u64) -> u64 {
    let current: u64 = value % modulus;

    if current == modulus - 1 {
        return 0
    }

    return current + 1
}

// ============================================================================
// 12. CYCLIC DECREMENT
//
// Requires modulus > 0.
// ============================================================================

export proc cyclic_decrement_u32(value: u32, modulus: u32) -> u32 {
    let current: u32 = value % modulus;

    if current == 0 {
        return modulus - 1
    }

    return current - 1
}

export proc cyclic_decrement_u64(value: u64, modulus: u64) -> u64 {
    let current: u64 = value % modulus;

    if current == 0 {
        return modulus - 1
    }

    return current - 1
}

// ============================================================================
// 13. MODULAR ADDITION — UNSIGNED
//
// Requires modulus > 0.
// Avoids overflow in a + b.
// ============================================================================

export proc mod_add_u32(a: u32, b: u32, modulus: u32) -> u32 {
    let x: u32 = a % modulus;
    let y: u32 = b % modulus;

    if x >= modulus - y {
        return x - (modulus - y)
    }

    return x + y
}

export proc mod_add_u64(a: u64, b: u64, modulus: u64) -> u64 {
    let x: u64 = a % modulus;
    let y: u64 = b % modulus;

    if x >= modulus - y {
        return x - (modulus - y)
    }

    return x + y
}

// ============================================================================
// 14. MODULAR SUBTRACTION — UNSIGNED
//
// Requires modulus > 0.
// ============================================================================

export proc mod_sub_u32(a: u32, b: u32, modulus: u32) -> u32 {
    let x: u32 = a % modulus;
    let y: u32 = b % modulus;

    if x >= y {
        return x - y
    }

    return modulus - (y - x)
}

export proc mod_sub_u64(a: u64, b: u64, modulus: u64) -> u64 {
    let x: u64 = a % modulus;
    let y: u64 = b % modulus;

    if x >= y {
        return x - y
    }

    return modulus - (y - x)
}

// ============================================================================
// 15. MODULAR MULTIPLICATION
//
// Double-and-add algorithm.
// Requires modulus > 0.
// ============================================================================

export proc mod_mul_u32(a: u32, b: u32, modulus: u32) -> u32 {
    let mut result: u32 = 0;
    let mut x: u32 = a % modulus;
    let mut y: u32 = b;

    while y > 0 {
        if y % 2 == 1 {
            set result = mod_add_u32(result, x, modulus)
        }

        set x = mod_add_u32(x, x, modulus)
        set y = y / 2
    }

    return result
}

export proc mod_mul_u64(a: u64, b: u64, modulus: u64) -> u64 {
    let mut result: u64 = 0;
    let mut x: u64 = a % modulus;
    let mut y: u64 = b;

    while y > 0 {
        if y % 2 == 1 {
            set result = mod_add_u64(result, x, modulus)
        }

        set x = mod_add_u64(x, x, modulus)
        set y = y / 2
    }

    return result
}

// ============================================================================
// 16. MODULAR EXPONENTIATION
//
// Binary exponentiation.
// Requires modulus > 0.
// ============================================================================

export proc mod_pow_u32(base: u32, exponent: u32, modulus: u32) -> u32 {
    let mut result: u32 = 1 % modulus;
    let mut x: u32 = base % modulus;
    let mut n: u32 = exponent;

    while n > 0 {
        if n % 2 == 1 {
            set result = mod_mul_u32(result, x, modulus)
        }

        set x = mod_mul_u32(x, x, modulus)
        set n = n / 2
    }

    return result
}

export proc mod_pow_u64(base: u64, exponent: u64, modulus: u64) -> u64 {
    let mut result: u64 = 1 % modulus;
    let mut x: u64 = base % modulus;
    let mut n: u64 = exponent;

    while n > 0 {
        if n % 2 == 1 {
            set result = mod_mul_u64(result, x, modulus)
        }

        set x = mod_mul_u64(x, x, modulus)
        set n = n / 2
    }

    return result
}

// ============================================================================
// 17. POWER-OF-TWO MODULO
//
// Requires modulus to be a nonzero power of two.
// ============================================================================

export proc mod_power_of_two_u32(value: u32, modulus: u32) -> u32 {
    return value & (modulus - 1)
}

export proc mod_power_of_two_u64(value: u64, modulus: u64) -> u64 {
    return value & (modulus - 1)
}
