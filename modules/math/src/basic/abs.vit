// ============================================================================
// Vitte Standard Library
// Module: math.basic.abs
// File: modules/math/src/basic/abs.vit
//
// Absolute value functions.
// Pure Vitte implementation.
// ============================================================================

space math.basic.abs

// ============================================================================
// SIGNED INTEGER ABSOLUTE VALUES
// ============================================================================

export proc abs_i8(x: i8) -> i8 {
    if x < 0 {
        return -x
    }

    return x
}

export proc abs_i16(x: i16) -> i16 {
    if x < 0 {
        return -x
    }

    return x
}

export proc abs_i32(x: i32) -> i32 {
    if x < 0 {
        return -x
    }

    return x
}

export proc abs_i64(x: i64) -> i64 {
    if x < 0 {
        return -x
    }

    return x
}

// ============================================================================
// UNSIGNED INTEGER ABSOLUTE VALUES
// ============================================================================

export proc abs_u8(x: u8) -> u8 {
    return x
}

export proc abs_u16(x: u16) -> u16 {
    return x
}

export proc abs_u32(x: u32) -> u32 {
    return x
}

export proc abs_u64(x: u64) -> u64 {
    return x
}

// ============================================================================
// FLOATING-POINT ABSOLUTE VALUES
// ============================================================================

export proc abs_f32(x: f32) -> f32 {
    if x < 0.0 {
        return -x
    }

    return x
}

export proc abs_f64(x: f64) -> f64 {
    if x < 0.0 {
        return -x
    }

    return x
}

// ============================================================================
// SATURATING ABSOLUTE VALUES
// ============================================================================

export proc saturating_abs_i8(x: i8) -> i8 {
    if x == -128 {
        return 127
    }

    return abs_i8(x)
}

export proc saturating_abs_i16(x: i16) -> i16 {
    if x == -32768 {
        return 32767
    }

    return abs_i16(x)
}

export proc saturating_abs_i32(x: i32) -> i32 {
    if x == -2147483647 - 1 {
        return 2147483647
    }

    return abs_i32(x)
}

export proc saturating_abs_i64(x: i64) -> i64 {
    if x == -9223372036854775807 - 1 {
        return 9223372036854775807
    }

    return abs_i64(x)
}

// ============================================================================
// WRAPPING ABSOLUTE VALUES
// ============================================================================

export proc wrapping_abs_i8(x: i8) -> i8 {
    if x == -128 {
        return x
    }

    return abs_i8(x)
}

export proc wrapping_abs_i16(x: i16) -> i16 {
    if x == -32768 {
        return x
    }

    return abs_i16(x)
}

export proc wrapping_abs_i32(x: i32) -> i32 {
    if x == -2147483647 - 1 {
        return x
    }

    return abs_i32(x)
}

export proc wrapping_abs_i64(x: i64) -> i64 {
    if x == -9223372036854775807 - 1 {
        return x
    }

    return abs_i64(x)
}

// ============================================================================
// ABSOLUTE DIFFERENCE — UNSIGNED INTEGERS
// ============================================================================

export proc abs_diff_u8(a: u8, b: u8) -> u8 {
    if a >= b {
        return a - b
    }

    return b - a
}

export proc abs_diff_u16(a: u16, b: u16) -> u16 {
    if a >= b {
        return a - b
    }

    return b - a
}

export proc abs_diff_u32(a: u32, b: u32) -> u32 {
    if a >= b {
        return a - b
    }

    return b - a
}

export proc abs_diff_u64(a: u64, b: u64) -> u64 {
    if a >= b {
        return a - b
    }

    return b - a
}

// ============================================================================
// ABSOLUTE DIFFERENCE — FLOATING POINT
// ============================================================================

export proc abs_diff_f32(a: f32, b: f32) -> f32 {
    return abs_f32(a - b)
}

export proc abs_diff_f64(a: f64, b: f64) -> f64 {
    return abs_f64(a - b)
}

// ============================================================================
// SIGN FUNCTIONS
// ============================================================================

export proc sign_i32(x: i32) -> i32 {
    if x < 0 {
        return -1
    }

    if x > 0 {
        return 1
    }

    return 0
}

export proc sign_i64(x: i64) -> i64 {
    if x < 0 {
        return -1
    }

    if x > 0 {
        return 1
    }

    return 0
}

export proc sign_f32(x: f32) -> f32 {
    if x < 0.0 {
        return -1.0
    }

    if x > 0.0 {
        return 1.0
    }

    return 0.0
}

export proc sign_f64(x: f64) -> f64 {
    if x < 0.0 {
        return -1.0
    }

    if x > 0.0 {
        return 1.0
    }

    return 0.0
}

// ============================================================================
// ZERO CHECKS
// ============================================================================

export proc is_zero_i32(x: i32) -> bool {
    return x == 0
}

export proc is_zero_i64(x: i64) -> bool {
    return x == 0
}

export proc is_zero_f32(x: f32) -> bool {
    return x == 0.0
}

export proc is_zero_f64(x: f64) -> bool {
    return x == 0.0
}

// ============================================================================
// NEGATIVE CHECKS
// ============================================================================

export proc is_negative_i32(x: i32) -> bool {
    return x < 0
}

export proc is_negative_i64(x: i64) -> bool {
    return x < 0
}

export proc is_negative_f32(x: f32) -> bool {
    return x < 0.0
}

export proc is_negative_f64(x: f64) -> bool {
    return x < 0.0
}