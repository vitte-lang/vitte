// ============================================================================
// Vitte Standard Library
// Module: math.basic.sign
// File: modules/math/src/basic/sign.vit
//
// Sign detection, sign comparison and sign manipulation.
//
// Dependencies: none
// Dynamic allocation: none
//
// Floating-point limitations:
//   - NaN requires an explicit classification policy.
//   - Ordinary comparisons do not distinguish +0.0 and -0.0.
//   - IEEE 754 copysign semantics are not implemented here.
// ============================================================================

space math.basic.sign

// ============================================================================
// 1. SIGNUM — SIGNED INTEGERS
//
// Returns:
//   -1 if x < 0
//    0 if x == 0
//    1 if x > 0
// ============================================================================

export proc sign_i8(x: i8) -> i8 {
    if x < 0 {
        return -1
    }

    if x > 0 {
        return 1
    }

    return 0
}

export proc sign_i16(x: i16) -> i16 {
    if x < 0 {
        return -1
    }

    if x > 0 {
        return 1
    }

    return 0
}

export proc sign_i32(x: i32) -> i32 {
    if x < 0 {
        return -1
    }

    if x > 0 {
        return 1
    }

    return 0
}

export proc sign_i64(x: i64) -> i64 {
    if x < 0 {
        return -1
    }

    if x > 0 {
        return 1
    }

    return 0
}

// ============================================================================
// 2. SIGNUM — UNSIGNED INTEGERS
//
// Returns:
//    0 if x == 0
//    1 otherwise
// ============================================================================

export proc sign_u8(x: u8) -> u8 {
    if x == 0 {
        return 0
    }

    return 1
}

export proc sign_u16(x: u16) -> u16 {
    if x == 0 {
        return 0
    }

    return 1
}

export proc sign_u32(x: u32) -> u32 {
    if x == 0 {
        return 0
    }

    return 1
}

export proc sign_u64(x: u64) -> u64 {
    if x == 0 {
        return 0
    }

    return 1
}

// ============================================================================
// 3. SIGNUM — FLOATING POINT
// ============================================================================

export proc sign_f32(x: f32) -> f32 {
    if x < 0.0 {
        return -1.0
    }

    if x > 0.0 {
        return 1.0
    }

    return 0.0
}

export proc sign_f64(x: f64) -> f64 {
    if x < 0.0 {
        return -1.0
    }

    if x > 0.0 {
        return 1.0
    }

    return 0.0
}

// ============================================================================
// 4. NEGATIVE DETECTION
// ============================================================================

export proc is_negative_i8(x: i8) -> bool {
    return x < 0
}

export proc is_negative_i16(x: i16) -> bool {
    return x < 0
}

export proc is_negative_i32(x: i32) -> bool {
    return x < 0
}

export proc is_negative_i64(x: i64) -> bool {
    return x < 0
}

export proc is_negative_f32(x: f32) -> bool {
    return x < 0.0
}

export proc is_negative_f64(x: f64) -> bool {
    return x < 0.0
}

// ============================================================================
// 5. POSITIVE DETECTION
// ============================================================================

export proc is_positive_i8(x: i8) -> bool {
    return x > 0
}

export proc is_positive_i16(x: i16) -> bool {
    return x > 0
}

export proc is_positive_i32(x: i32) -> bool {
    return x > 0
}

export proc is_positive_i64(x: i64) -> bool {
    return x > 0
}

export proc is_positive_u8(x: u8) -> bool {
    return x > 0
}

export proc is_positive_u16(x: u16) -> bool {
    return x > 0
}

export proc is_positive_u32(x: u32) -> bool {
    return x > 0
}

export proc is_positive_u64(x: u64) -> bool {
    return x > 0
}

export proc is_positive_f32(x: f32) -> bool {
    return x > 0.0
}

export proc is_positive_f64(x: f64) -> bool {
    return x > 0.0
}

// ============================================================================
// 6. ZERO DETECTION
// ============================================================================

export proc is_zero_i8(x: i8) -> bool {
    return x == 0
}

export proc is_zero_i16(x: i16) -> bool {
    return x == 0
}

export proc is_zero_i32(x: i32) -> bool {
    return x == 0
}

export proc is_zero_i64(x: i64) -> bool {
    return x == 0
}

export proc is_zero_u8(x: u8) -> bool {
    return x == 0
}

export proc is_zero_u16(x: u16) -> bool {
    return x == 0
}

export proc is_zero_u32(x: u32) -> bool {
    return x == 0
}

export proc is_zero_u64(x: u64) -> bool {
    return x == 0
}

export proc is_zero_f32(x: f32) -> bool {
    return x == 0.0
}

export proc is_zero_f64(x: f64) -> bool {
    return x == 0.0
}

// ============================================================================
// 7. NONNEGATIVE DETECTION
// ============================================================================

export proc is_nonnegative_i32(x: i32) -> bool {
    return x >= 0
}

export proc is_nonnegative_i64(x: i64) -> bool {
    return x >= 0
}

export proc is_nonnegative_f32(x: f32) -> bool {
    return x >= 0.0
}

export proc is_nonnegative_f64(x: f64) -> bool {
    return x >= 0.0
}

// ============================================================================
// 8. NONPOSITIVE DETECTION
// ============================================================================

export proc is_nonpositive_i32(x: i32) -> bool {
    return x <= 0
}

export proc is_nonpositive_i64(x: i64) -> bool {
    return x <= 0
}

export proc is_nonpositive_f32(x: f32) -> bool {
    return x <= 0.0
}

export proc is_nonpositive_f64(x: f64) -> bool {
    return x <= 0.0
}

// ============================================================================
// 9. SAME SIGN
//
// Zero is considered compatible with zero only.
// ============================================================================

export proc same_sign_i32(a: i32, b: i32) -> bool {
    if a == 0 {
        return b == 0
    }

    if b == 0 {
        return false
    }

    return (a < 0) == (b < 0)
}

export proc same_sign_i64(a: i64, b: i64) -> bool {
    if a == 0 {
        return b == 0
    }

    if b == 0 {
        return false
    }

    return (a < 0) == (b < 0)
}

export proc same_sign_f32(a: f32, b: f32) -> bool {
    if a == 0.0 {
        return b == 0.0
    }

    if b == 0.0 {
        return false
    }

    return (a < 0.0) == (b < 0.0)
}

export proc same_sign_f64(a: f64, b: f64) -> bool {
    if a == 0.0 {
        return b == 0.0
    }

    if b == 0.0 {
        return false
    }

    return (a < 0.0) == (b < 0.0)
}

// ============================================================================
// 10. OPPOSITE SIGNS
// ============================================================================

export proc opposite_sign_i32(a: i32, b: i32) -> bool {
    return (a < 0 && b > 0) || (a > 0 && b < 0)
}

export proc opposite_sign_i64(a: i64, b: i64) -> bool {
    return (a < 0 && b > 0) || (a > 0 && b < 0)
}

export proc opposite_sign_f32(a: f32, b: f32) -> bool {
    return (a < 0.0 && b > 0.0) || (a > 0.0 && b < 0.0)
}

export proc opposite_sign_f64(a: f64, b: f64) -> bool {
    return (a < 0.0 && b > 0.0) || (a > 0.0 && b < 0.0)
}

// ============================================================================
// 11. SIGN COMPARISON
//
// Returns:
//   -1 if a has a lower sign category than b
//    0 if both have the same sign category
//    1 otherwise
// ============================================================================

export proc compare_sign_i32(a: i32, b: i32) -> i32 {
    let sa: i32 = sign_i32(a);
    let sb: i32 = sign_i32(b);

    if sa < sb {
        return -1
    }

    if sa > sb {
        return 1
    }

    return 0
}

export proc compare_sign_i64(a: i64, b: i64) -> i64 {
    let sa: i64 = sign_i64(a);
    let sb: i64 = sign_i64(b);

    if sa < sb {
        return -1
    }

    if sa > sb {
        return 1
    }

    return 0
}

// ============================================================================
// 12. SIGN TRANSFER — FLOATING POINT
//
// Transfers the numerical sign of sign_source to magnitude.
//
// Does not implement IEEE 754 copysign for signed zero or NaN.
// ============================================================================

export proc copy_sign_f32(magnitude: f32, sign_source: f32) -> f32 {
    let absolute: f32 = if magnitude < 0.0 {
        -magnitude
    } else {
        magnitude
    };

    if sign_source < 0.0 {
        return -absolute
    }

    return absolute
}

export proc copy_sign_f64(magnitude: f64, sign_source: f64) -> f64 {
    let absolute: f64 = if magnitude < 0.0 {
        -magnitude
    } else {
        magnitude
    };

    if sign_source < 0.0 {
        return -absolute
    }

    return absolute
}

// ============================================================================
// 13. SIGN TRANSFER — SIGNED INTEGERS
//
// Preconditions:
//   - magnitude must not be the minimum signed integer.
// ============================================================================

export proc copy_sign_i32(magnitude: i32, sign_source: i32) -> i32 {
    let absolute: i32 = if magnitude < 0 {
        -magnitude
    } else {
        magnitude
    };

    if sign_source < 0 {
        return -absolute
    }

    return absolute
}

export proc copy_sign_i64(magnitude: i64, sign_source: i64) -> i64 {
    let absolute: i64 = if magnitude < 0 {
        -magnitude
    } else {
        magnitude
    };

    if sign_source < 0 {
        return -absolute
    }

    return absolute
}

// ============================================================================
// 14. SIGN MULTIPLICATION
//
// Returns the sign of a * b without performing multiplication.
// ============================================================================

export proc multiply_sign_i32(a: i32, b: i32) -> i32 {
    if a == 0 || b == 0 {
        return 0
    }

    if (a < 0) == (b < 0) {
        return 1
    }

    return -1
}

export proc multiply_sign_i64(a: i64, b: i64) -> i64 {
    if a == 0 || b == 0 {
        return 0
    }

    if (a < 0) == (b < 0) {
        return 1
    }

    return -1
}

// ============================================================================
// 15. SIGN NORMALIZATION
// ============================================================================

export proc normalize_sign_i32(x: i32) -> i32 {
    return sign_i32(x)
}

export proc normalize_sign_i64(x: i64) -> i64 {
    return sign_i64(x)
}

export proc normalize_sign_f32(x: f32) -> f32 {
    return sign_f32(x)
}

export proc normalize_sign_f64(x: f64) -> f64 {
    return sign_f64(x)
}

// ============================================================================
// END OF MODULE
// ============================================================================
