// ============================================================================
// Vitte Standard Library
// Benchmark: math.arithmetic
// File: modules/math/benchmarks/arithmetic_bench.vit
//
// Arithmetic microbenchmarks.
//
// IMPORTANT:
//   - This is a benchmark workload, not a timing harness.
//   - Timing must be supplied by an external runner.
//   - Results must be consumed to prevent dead-code elimination.
//   - No dynamic allocation is required.
// ============================================================================

space math.benchmarks.arithmetic

// ============================================================================
// CONFIGURATION
// ============================================================================

value DEFAULT_ITERATIONS: u64 = 1000000

// ============================================================================
// INTEGER ADDITION
// ============================================================================

export proc bench_add_i32(iterations: u64) -> i32 {
    value result: i32 = 0
    value i: u64 = 0

    while i < iterations {
        set result = result + 1

        if result >= 1000000 {
            set result = 0
        }

        set i = i + 1
    }

    return result
}

export proc bench_add_i64(iterations: u64) -> i64 {
    value result: i64 = 0
    value i: u64 = 0

    while i < iterations {
        set result = result + 1

        if result >= 1000000 {
            set result = 0
        }

        set i = i + 1
    }

    return result
}

export proc bench_add_u32(iterations: u64) -> u32 {
    value result: u32 = 0
    value i: u64 = 0

    while i < iterations {
        set result = result + 1

        if result >= 1000000 {
            set result = 0
        }

        set i = i + 1
    }

    return result
}

export proc bench_add_u64(iterations: u64) -> u64 {
    value result: u64 = 0
    value i: u64 = 0

    while i < iterations {
        set result = result + 1

        if result >= 1000000 {
            set result = 0
        }

        set i = i + 1
    }

    return result
}

// ============================================================================
// INTEGER SUBTRACTION
// ============================================================================

export proc bench_sub_i32(iterations: u64) -> i32 {
    value result: i32 = 1000000
    value i: u64 = 0

    while i < iterations {
        set result = result - 1

        if result <= 0 {
            set result = 1000000
        }

        set i = i + 1
    }

    return result
}

export proc bench_sub_i64(iterations: u64) -> i64 {
    value result: i64 = 1000000
    value i: u64 = 0

    while i < iterations {
        set result = result - 1

        if result <= 0 {
            set result = 1000000
        }

        set i = i + 1
    }

    return result
}

// ============================================================================
// INTEGER MULTIPLICATION
// ============================================================================

export proc bench_mul_i32(iterations: u64) -> i32 {
    value result: i32 = 1
    value i: u64 = 0

    while i < iterations {
        set result = result * 3

        if result > 1000000 {
            set result = 1
        }

        set i = i + 1
    }

    return result
}

export proc bench_mul_i64(iterations: u64) -> i64 {
    value result: i64 = 1
    value i: u64 = 0

    while i < iterations {
        set result = result * 3

        if result > 1000000 {
            set result = 1
        }

        set i = i + 1
    }

    return result
}

// ============================================================================
// INTEGER DIVISION
// ============================================================================

export proc bench_div_i32(iterations: u64) -> i32 {
    value result: i32 = 1000000
    value i: u64 = 0

    while i < iterations {
        set result = result / 3

        if result <= 1 {
            set result = 1000000
        }

        set i = i + 1
    }

    return result
}

export proc bench_div_i64(iterations: u64) -> i64 {
    value result: i64 = 1000000
    value i: u64 = 0

    while i < iterations {
        set result = result / 3

        if result <= 1 {
            set result = 1000000
        }

        set i = i + 1
    }

    return result
}

// ============================================================================
// INTEGER MODULO
// ============================================================================

export proc bench_mod_i32(iterations: u64) -> i32 {
    value result: i32 = 1
    value i: u64 = 0

    while i < iterations {
        set result = (result * 7 + 3) % 1000003
        set i = i + 1
    }

    return result
}

export proc bench_mod_i64(iterations: u64) -> i64 {
    value result: i64 = 1
    value i: u64 = 0

    while i < iterations {
        set result = (result * 7 + 3) % 1000003
        set i = i + 1
    }

    return result
}

// ============================================================================
// FLOATING-POINT ADDITION
// ============================================================================

export proc bench_add_f32(iterations: u64) -> f32 {
    value result: f32 = 0.0
    value i: u64 = 0

    while i < iterations {
        set result = result + 0.125

        if result >= 1000.0 {
            set result = 0.0
        }

        set i = i + 1
    }

    return result
}

export proc bench_add_f64(iterations: u64) -> f64 {
    value result: f64 = 0.0
    value i: u64 = 0

    while i < iterations {
        set result = result + 0.125

        if result >= 1000.0 {
            set result = 0.0
        }

        set i = i + 1
    }

    return result
}

// ============================================================================
// FLOATING-POINT MULTIPLICATION
// ============================================================================

export proc bench_mul_f32(iterations: u64) -> f32 {
    value result: f32 = 1.0
    value i: u64 = 0

    while i < iterations {
        set result = result * 1.0001

        if result > 1000.0 {
            set result = 1.0
        }

        set i = i + 1
    }

    return result
}

export proc bench_mul_f64(iterations: u64) -> f64 {
    value result: f64 = 1.0
    value i: u64 = 0

    while i < iterations {
        set result = result * 1.0001

        if result > 1000.0 {
            set result = 1.0
        }

        set i = i + 1
    }

    return result
}

// ============================================================================
// FLOATING-POINT DIVISION
// ============================================================================

export proc bench_div_f32(iterations: u64) -> f32 {
    value result: f32 = 1000.0
    value i: u64 = 0

    while i < iterations {
        set result = result / 1.0001

        if result < 1.0 {
            set result = 1000.0
        }

        set i = i + 1
    }

    return result
}

export proc bench_div_f64(iterations: u64) -> f64 {
    value result: f64 = 1000.0
    value i: u64 = 0

    while i < iterations {
        set result = result / 1.0001

        if result < 1.0 {
            set result = 1000.0
        }

        set i = i + 1
    }

    return result
}

// ============================================================================
// MIXED ARITHMETIC
// ============================================================================

export proc bench_mixed_i32(iterations: u64) -> i32 {
    value result: i32 = 1
    value i: u64 = 0

    while i < iterations {
        set result = result + 17
        set result = result * 3
        set result = result - 5
        set result = result % 1000003

        set i = i + 1
    }

    return result
}

export proc bench_mixed_i64(iterations: u64) -> i64 {
    value result: i64 = 1
    value i: u64 = 0

    while i < iterations {
        set result = result + 17
        set result = result * 3
        set result = result - 5
        set result = result % 1000003

        set i = i + 1
    }

    return result
}

export proc bench_mixed_f32(iterations: u64) -> f32 {
    value result: f32 = 1.0
    value i: u64 = 0

    while i < iterations {
        set result = result + 0.25
        set result = result * 1.0001
        set result = result - 0.125

        if result > 1000.0 {
            set result = 1.0
        }

        set i = i + 1
    }

    return result
}

export proc bench_mixed_f64(iterations: u64) -> f64 {
    value result: f64 = 1.0
    value i: u64 = 0

    while i < iterations {
        set result = result + 0.25
        set result = result * 1.0001
        set result = result - 0.125

        if result > 1000.0 {
            set result = 1.0
        }

        set i = i + 1
    }

    return result
}

// ============================================================================
// DEFAULT BENCHMARK ENTRY POINTS
// ============================================================================

export proc benchmark_integer_default() -> i64 {
    return bench_mixed_i64(DEFAULT_ITERATIONS)
}

export proc benchmark_float_default() -> f64 {
    return bench_mixed_f64(DEFAULT_ITERATIONS)
}