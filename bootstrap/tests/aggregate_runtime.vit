form AggregateProbe {
    label: string,
    count: int
}

proc main() -> int {
    let values: list[string] = ["alpha", "beta"];
    let probe: AggregateProbe = AggregateProbe {
        label: values[0],
        count: 2
    };

    set values[1] = "gamma";
    set probe.count = 3;

    if probe.label == "alpha" and values[1] == "gamma" and probe.count == 3 {
        give 0;
    }
    give 1;
}
