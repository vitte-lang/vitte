!muf 4

;; Compatibility entry points for the Make build.
;; Keep compiler sources, flags, dependencies and outputs in Makefile.

[workspace]
  .set name "vitte"
  .set root "."
  .set target_dir "build"
  .set default "all"
..

[profile debug]
  .set opt "0"
..

[profile release]
  .set opt "2"
..

[tool sh]
  .exec "sh"
..

[bake all]
  .make sources cglob "Makefile"
  .phony true
  [run sh]
    .set "-c" "make all"
  ..
  .output stamp "build/.steel-all"
..

[bake bootstrap]
  .make sources cglob "Makefile"
  .phony true
  [run sh]
    .set "-c" "make bootstrap"
  ..
  .output stamp "build/.steel-bootstrap"
..

[bake release]
  .make sources cglob "Makefile"
  .phony true
  [run sh]
    .set "-c" "make MODE=release all"
  ..
  .output stamp "build/.steel-release"
..

[bake check]
  .make sources cglob "Makefile"
  .phony true
  [run sh]
    .set "-c" "make check"
  ..
  .output stamp "build/.steel-check"
..

[bake test]
  .make sources cglob "Makefile"
  .phony true
  [run sh]
    .set "-c" "make test"
  ..
  .output stamp "build/.steel-test"
..

[bake bootstrap_check]
  .make sources cglob "Makefile"
  .phony true
  [run sh]
    .set "-c" "make bootstrap-check"
  ..
  .output stamp "build/.steel-bootstrap-check"
..

[bake bootstrap_selfhost]
  .make sources cglob "Makefile"
  .phony true
  [run sh]
    .set "-c" "make MODE=release bootstrap-selfhost"
  ..
  .output stamp "build/.steel-bootstrap-selfhost"
..
