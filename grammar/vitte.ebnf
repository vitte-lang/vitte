(*
  Vitte syntax accepted by the parser.
  ::= production, | choice, [...] optional, {...} repetition.
*)

program ::= { declaration } EOF ;

(* Declarations *)

declaration ::= { "pub" | "export" | "async" | "unsafe" | "comptime" }
                declaration_body ;

declaration_body ::= space_declaration
                   | use_declaration
                   | export_declaration
                   | value_declaration
                   | type_declaration
                   | opaque_declaration
                   | form_declaration
                   | pick_declaration
                   | trait_declaration
                   | implementation_declaration
                   | procedure_declaration
                   | external_procedure_declaration
                   | intrinsic_declaration
                   | macro_declaration
                   | test_declaration
                   ;

space_declaration ::= "space" path [ ";" | block ] ;

use_declaration ::= "use" path
                    [ "as" identifier
                    | ( "::" | "." ) ( "*" | "{" path_alias
                                       { "," path_alias } [ "," ] "}" )
                    ] ";" ;

path_alias ::= path [ "as" identifier ] ;

export_declaration ::= "export"
                       ( "*"
                       | path_alias
                       | "{" path_alias { "," path_alias } [ "," ] "}"
                       ) ";" ;

value_declaration ::= ( "const" | "static" ) identifier
                      [ ":" type ]
                      "=" expression ";" ;

type_declaration ::= "type" identifier generic_parameters
                     [ where_clause ]
                     "=" type ";" ;

opaque_declaration ::= "opaque" identifier generic_parameters
                       [ where_clause ] ";" ;

form_declaration ::= "form" identifier generic_parameters
                     [ where_clause ]
                     "{"
                       [ identifier ":" type
                         { ( "," | ";" ) identifier ":" type }
                         [ "," | ";" ]
                       ]
                     "}" ;

pick_declaration ::= "pick" identifier generic_parameters
                     "{" [ identifier [ "(" type { "," type } ")" ]
                           { "," identifier
                             [ "(" type { "," type } ")" ] } [ "," ] ] "}" ;

trait_declaration ::= "trait" identifier generic_parameters
                      [ where_clause ]
                      declaration_block ;

implementation_declaration ::= "impl" generic_parameters type
                               [ "for" type ]
                               [ where_clause ]
                               declaration_block ;

procedure_declaration ::= "proc" identifier generic_parameters
                          parameter_list [ "->" type ]
                          [ where_clause ]
                          { contract_clause } block ;

contract_clause ::= ( "requires" | "ensures" ) expression ";" ;

external_procedure_declaration ::= "extern" [ string_literal ]
                                   "proc" identifier generic_parameters
                                   parameter_list [ "->" type ]
                                   [ where_clause ] ";" ;

intrinsic_declaration ::= "intrinsic" identifier generic_parameters
                          parameter_list [ "->" type ] ";" ;

macro_declaration ::= "macro" identifier [ parameter_list ] block ;

test_declaration ::= "test" [ identifier | string_literal ] block ;

declaration_block ::= "{" { declaration } "}" ;

generic_parameters ::= [ "<" [ generic_parameter
                               { "," generic_parameter } ] ">" ] ;

generic_parameter ::= identifier [ ":" type ] ;

where_clause ::= "where" type ":" type { "," type ":" type } ;

parameter_list ::= "(" [ parameter { "," parameter } [ "," ] ] ")" ;

parameter ::= identifier ":" type ;

(* Types *)

type ::= reference_type
       | pointer_type
       | array_type
       | path_type
       ;

reference_type ::= ( "&" | "ref" ) [ "mut" ] type ;

pointer_type ::= "*" type ;

array_type ::= "[" expression "]" type ;

path_type ::= path
              [ ( "<" [ type { "," type } ] ">"
                | "[" [ type { "," type } ] "]"
                )
              ] ;

path ::= identifier { ( "::" | "/" ) identifier } ;

(* Blocks and statements *)

block ::= "{" { statement } "}" ;

statement ::= declaration
            | let_statement
            | set_statement
            | return_statement
            | ( "break" | "continue" ) ";"
            | defer_statement
            | assert_statement
            | if_statement
            | while_statement
            | loop_statement
            | for_statement
            | match_statement
            | unsafe_statement
            | assembly_statement
            | expression_statement
            ;

let_statement ::= "let" [ "mut" ] identifier
                  [ ":" type ]
                  [ "=" expression ] ";" ;

set_statement ::= "set" expression ";" ;

return_statement ::= ( "return" | "give" ) [ expression ] ";" ;

defer_statement ::= "defer" ( block | expression ";" ) ;

assert_statement ::= "assert"
                     ( "(" expression ")" | expression ) ";" ;

if_statement ::= "if" expression block
                 { "elif" expression block }
                 [ "else" ( if_statement | block ) ] ;

while_statement ::= "while" expression block ;

loop_statement ::= "loop" block ;

for_statement ::= "for" identifier "in" expression block ;

match_statement ::= "match" expression
                    "{"
                      [ match_arm { "," match_arm } [ "," ] ]
                    "}" ;

match_arm ::= expression "=>" ( block | expression ) ;

unsafe_statement ::= "unsafe" block ;

assembly_statement ::= "asm"
                       ( "(" [ expression { "," expression } ] ")"
                       | string_literal )
                       ";" ;

expression_statement ::= expression [ ";" ] ;

(* Expressions *)

expression ::= coalesce_expression
               [ ( "=" | "+=" | "-=" | "*=" | "/=" | "%="
                 | "&=" | "|=" | "^=" | "<<=" | ">>="
                 )
                 expression
               ] ;

coalesce_expression ::= logical_or_expression
                        [ "??" coalesce_expression ] ;

logical_or_expression ::= logical_and_expression
                          { ( "or" | "||" ) logical_and_expression } ;

logical_and_expression ::= bitwise_or_expression
                           { ( "and" | "&&" ) bitwise_or_expression } ;

bitwise_or_expression ::= bitwise_xor_expression
                          { "|" bitwise_xor_expression } ;

bitwise_xor_expression ::= bitwise_and_expression
                           { "^" bitwise_and_expression } ;

bitwise_and_expression ::= equality_expression
                           { "&" equality_expression } ;

equality_expression ::= comparison_expression
                        { ( "==" | "!=" ) comparison_expression } ;

comparison_expression ::= shift_expression
                          { ( "<" | "<=" | ">" | ">=" ) shift_expression } ;

shift_expression ::= additive_expression
                     { ( "<<" | ">>" ) additive_expression } ;

additive_expression ::= multiplicative_expression
                        { ( "+" | "-" ) multiplicative_expression } ;

multiplicative_expression ::= range_expression
                              { ( "*" | "/" | "%" ) range_expression } ;

range_expression ::= unary_expression
                     { ( ".." | "..=" ) unary_expression } ;

unary_expression ::= ( "+" | "-" | "!" | "~" | "*" | "&"
                     | "not" | "move" | "ref" | "await"
                     ) unary_expression
                   | postfix_expression ;

postfix_expression ::= primary_expression
                       { "(" [ expression { "," expression } [ "," ] ] ")"
                       | "[" expression "]"
                       | "." identifier
                       | "?"
                       } ;

primary_expression ::= literal
                      | path
                      | "self"
                      | "[" [ expression { "," expression } [ "," ] ] "]"
                      | "(" expression ")"
                      | block
                      ;

literal ::= integer_literal
          | float_literal
          | string_literal
          | character_literal
          | "true"
          | "false"
          | "null"
          ;

(* Lexical forms kept here are the ones needed to read the grammar. *)

identifier ::= ( letter | "_" | unicode_identifier_character )
               { letter | digit | "_" | unicode_identifier_character } ;

(* Integer and floating-point literals *)

integer_literal ::= digit_sequence
                  | ( "0b" | "0B" ) binary_digit_sequence
                  | ( "0o" | "0O" ) octal_digit_sequence
                  | ( "0x" | "0X" ) hexadecimal_digit_sequence
                  ;

float_literal ::= decimal_float | hexadecimal_float ;

decimal_float ::= digit_sequence "." [ digit_sequence ] [ decimal_exponent ]
                | digit_sequence decimal_exponent
                ;

decimal_exponent ::= ( "e" | "E" ) [ "+" | "-" ] digit_sequence ;

hexadecimal_float ::= ( "0x" | "0X" ) hexadecimal_digit_sequence
                      [ "." [ hexadecimal_digit_sequence ] ]
                      ( "p" | "P" ) [ "+" | "-" ] digit_sequence ;

digit_sequence ::= digit { [ "_" ] digit } ;

binary_digit_sequence ::= binary_digit { [ "_" ] binary_digit } ;

octal_digit_sequence ::= octal_digit { [ "_" ] octal_digit } ;

hexadecimal_digit_sequence ::= hexadecimal_digit
                               { [ "_" ] hexadecimal_digit } ;

(* Strings, characters and escapes *)

string_literal ::= '"' { string_character | escape_sequence } '"' ;

character_literal ::= "'" ( character | escape_sequence ) "'" ;

escape_sequence ::= BACKSLASH
                    ( BACKSLASH | "'" | '"' | "0" | "a" | "b"
                    | "f" | "n" | "r" | "t" | "v"
                    | "x" hexadecimal_digit hexadecimal_digit
                    | "u" hexadecimal_digit hexadecimal_digit
                           hexadecimal_digit hexadecimal_digit
                    | "U" hexadecimal_digit hexadecimal_digit
                           hexadecimal_digit hexadecimal_digit
                           hexadecimal_digit hexadecimal_digit
                           hexadecimal_digit hexadecimal_digit
                    ) ;

string_character ::= any valid source character except '"', BACKSLASH, CR or LF ;

character ::= any valid source character except "'", BACKSLASH, CR or LF ;

BACKSLASH ::= U+005C ;

letter ::= "A"..."Z" | "a"..."z" ;

digit ::= "0"..."9" ;

binary_digit ::= "0" | "1" ;

octal_digit ::= "0"..."7" ;

hexadecimal_digit ::= digit | "a"..."f" | "A"..."F" ;

unicode_identifier_character ::= valid non-ASCII Unicode scalar except
                                 whitespace and control characters ;

(* Trivia consists of whitespace, line comments, and nested block comments. *)
