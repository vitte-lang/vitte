space toolchain/stage0/stage0

const STAGE0_STAGE0_SCHEMA: string = "vitte.toolchain.stage0.stage0.v1"
const STAGE0_STAGE0_STAGE: string = "stage0"
const STAGE0_STAGE0_ROLE: string = "signed trust root and bootstrap input"
const STAGE0_STAGE0_PREDECESSOR: string = "none"
const STAGE0_STAGE0_POLICY: string = "signature-required, offline, single-platform-artifact"
const STAGE0_STAGE0_CAPABILITY: string = "stage0"
const STAGE0_STAGE0_VERSION: int = 1

proc stage0_stage0_contract_ready() -> bool {
    give STAGE0_STAGE0_SCHEMA == "vitte.toolchain.stage0.stage0.v1" and STAGE0_STAGE0_STAGE == "stage0" and STAGE0_STAGE0_VERSION == 1;
}

export *
