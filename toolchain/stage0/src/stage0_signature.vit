proc stage0_stage0_signature_contract_ready() -> bool {
    give STAGE0_STAGE0_SIGNATURE_SCHEMA == "vitte.toolchain.stage0.stage0_signature.v1" and STAGE0_STAGE0_SIGNATURE_STAGE == "stage0" and STAGE0_STAGE0_SIGNATURE_VERSION == 1;
