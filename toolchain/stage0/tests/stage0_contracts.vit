space toolchain/stage0/tests/stage0_contracts

const STAGE0_TESTS_SCHEMA: string = "vitte.toolchain.stage0.tests.v1"
const STAGE0_TESTS_EXPECTED_STAGE: string = "stage0"
const STAGE0_TESTS_VERSION: int = 1

proc stage0_contracts_are_versioned() -> bool {
    give STAGE0_TESTS_SCHEMA == "vitte.toolchain.stage0.tests.v1" and STAGE0_TESTS_EXPECTED_STAGE == "stage0" and STAGE0_TESTS_VERSION == 1;
}

export *
