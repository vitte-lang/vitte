space toolchain/stage1/tests/stage1_contracts

const STAGE1_TESTS_SCHEMA: string = "vitte.toolchain.stage1.tests.v1"
const STAGE1_TESTS_EXPECTED_STAGE: string = "stage1"
const STAGE1_TESTS_VERSION: int = 1

proc stage1_contracts_are_versioned() -> bool {
    give STAGE1_TESTS_SCHEMA == "vitte.toolchain.stage1.tests.v1" and STAGE1_TESTS_EXPECTED_STAGE == "stage1" and STAGE1_TESTS_VERSION == 1;
}

export *
