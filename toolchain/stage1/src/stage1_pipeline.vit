space toolchain/stage1/stage1_pipeline

const STAGE1_STAGE1_PIPELINE_SCHEMA: string = "vitte.toolchain.stage1.stage1_pipeline.v1"
const STAGE1_STAGE1_PIPELINE_STAGE: string = "stage1"
const STAGE1_STAGE1_PIPELINE_ROLE: string = "compiler rebuilt from the trusted bootstrap compiler"
const STAGE1_STAGE1_PIPELINE_PREDECESSOR: string = "stage0"
const STAGE1_STAGE1_PIPELINE_POLICY: string = "verified-predecessor, canonical-output, deterministic-build"
const STAGE1_STAGE1_PIPELINE_CAPABILITY: string = "stage1_pipeline"
const STAGE1_STAGE1_PIPELINE_VERSION: int = 1

proc stage1_stage1_pipeline_contract_ready() -> bool {
    give STAGE1_STAGE1_PIPELINE_SCHEMA == "vitte.toolchain.stage1.stage1_pipeline.v1" and STAGE1_STAGE1_PIPELINE_STAGE == "stage1" and STAGE1_STAGE1_PIPELINE_VERSION == 1;
}

export *
