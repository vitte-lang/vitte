space toolchain/stage1/stage1_validation

const STAGE1_STAGE1_VALIDATION_SCHEMA: string = "vitte.toolchain.stage1.stage1_validation.v1"
const STAGE1_STAGE1_VALIDATION_STAGE: string = "stage1"
const STAGE1_STAGE1_VALIDATION_ROLE: string = "compiler rebuilt from the trusted bootstrap compiler"
const STAGE1_STAGE1_VALIDATION_PREDECESSOR: string = "stage0"
const STAGE1_STAGE1_VALIDATION_POLICY: string = "verified-predecessor, canonical-output, deterministic-build"
const STAGE1_STAGE1_VALIDATION_CAPABILITY: string = "stage1_validation"
const STAGE1_STAGE1_VALIDATION_VERSION: int = 1

proc stage1_stage1_validation_contract_ready() -> bool {
    give STAGE1_STAGE1_VALIDATION_SCHEMA == "vitte.toolchain.stage1.stage1_validation.v1" and STAGE1_STAGE1_VALIDATION_STAGE == "stage1" and STAGE1_STAGE1_VALIDATION_VERSION == 1;
}

export *
