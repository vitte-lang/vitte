space toolchain/stage1/stage1

const STAGE1_STAGE1_SCHEMA: string = "vitte.toolchain.stage1.stage1.v1"
const STAGE1_STAGE1_STAGE: string = "stage1"
const STAGE1_STAGE1_ROLE: string = "compiler rebuilt from the trusted bootstrap compiler"
const STAGE1_STAGE1_PREDECESSOR: string = "stage0"
const STAGE1_STAGE1_POLICY: string = "verified-predecessor, canonical-output, deterministic-build"
const STAGE1_STAGE1_CAPABILITY: string = "stage1"
const STAGE1_STAGE1_VERSION: int = 1

proc stage1_stage1_contract_ready() -> bool {
    give STAGE1_STAGE1_SCHEMA == "vitte.toolchain.stage1.stage1.v1" and STAGE1_STAGE1_STAGE == "stage1" and STAGE1_STAGE1_VERSION == 1;
}

export *
