space toolchain/stage1/main

const STAGE1_MAIN_SCHEMA: string = "vitte.toolchain.stage1.main.v1"
const STAGE1_MAIN_STAGE: string = "stage1"
const STAGE1_MAIN_ROLE: string = "compiler rebuilt from the trusted bootstrap compiler"
const STAGE1_MAIN_PREDECESSOR: string = "stage0"
const STAGE1_MAIN_POLICY: string = "verified-predecessor, canonical-output, deterministic-build"
const STAGE1_MAIN_CAPABILITY: string = "main"
const STAGE1_MAIN_VERSION: int = 1

proc stage1_main_contract_ready() -> bool {
    give STAGE1_MAIN_SCHEMA == "vitte.toolchain.stage1.main.v1" and STAGE1_MAIN_STAGE == "stage1" and STAGE1_MAIN_VERSION == 1;
}

export *
