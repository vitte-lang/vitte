space toolchain/stage2/tests/stage2_contracts

const STAGE2_TESTS_SCHEMA: string = "vitte.toolchain.stage2.tests.v1"
const STAGE2_TESTS_EXPECTED_STAGE: string = "stage2"
const STAGE2_TESTS_VERSION: int = 1

proc stage2_contracts_are_versioned() -> bool {
    give STAGE2_TESTS_SCHEMA == "vitte.toolchain.stage2.tests.v1" and STAGE2_TESTS_EXPECTED_STAGE == "stage2" and STAGE2_TESTS_VERSION == 1;
}

export *
