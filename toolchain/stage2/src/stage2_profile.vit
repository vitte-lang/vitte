space toolchain/stage2/stage2_profile

const STAGE2_STAGE2_PROFILE_SCHEMA: string = "vitte.toolchain.stage2.stage2_profile.v1"
const STAGE2_STAGE2_PROFILE_STAGE: string = "stage2"
const STAGE2_STAGE2_PROFILE_ROLE: string = "compiler rebuilt from stage1 and release candidate"
const STAGE2_STAGE2_PROFILE_PREDECESSOR: string = "stage1"
const STAGE2_STAGE2_PROFILE_POLICY: string = "verified-predecessor, release-parity, deterministic-build"
const STAGE2_STAGE2_PROFILE_CAPABILITY: string = "stage2_profile"
const STAGE2_STAGE2_PROFILE_VERSION: int = 1

proc stage2_stage2_profile_contract_ready() -> bool {
    give STAGE2_STAGE2_PROFILE_SCHEMA == "vitte.toolchain.stage2.stage2_profile.v1" and STAGE2_STAGE2_PROFILE_STAGE == "stage2" and STAGE2_STAGE2_PROFILE_VERSION == 1;
}

export *
