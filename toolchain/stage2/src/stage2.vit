space toolchain/stage2/stage2

const STAGE2_STAGE2_SCHEMA: string = "vitte.toolchain.stage2.stage2.v1"
const STAGE2_STAGE2_STAGE: string = "stage2"
const STAGE2_STAGE2_ROLE: string = "compiler rebuilt from stage1 and release candidate"
const STAGE2_STAGE2_PREDECESSOR: string = "stage1"
const STAGE2_STAGE2_POLICY: string = "verified-predecessor, release-parity, deterministic-build"
const STAGE2_STAGE2_CAPABILITY: string = "stage2"
const STAGE2_STAGE2_VERSION: int = 1

proc stage2_stage2_contract_ready() -> bool {
    give STAGE2_STAGE2_SCHEMA == "vitte.toolchain.stage2.stage2.v1" and STAGE2_STAGE2_STAGE == "stage2" and STAGE2_STAGE2_VERSION == 1;
}

export *
