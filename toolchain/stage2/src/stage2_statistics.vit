space toolchain/stage2/stage2_statistics

const STAGE2_STAGE2_STATISTICS_SCHEMA: string = "vitte.toolchain.stage2.stage2_statistics.v1"
const STAGE2_STAGE2_STATISTICS_STAGE: string = "stage2"
const STAGE2_STAGE2_STATISTICS_ROLE: string = "compiler rebuilt from stage1 and release candidate"
const STAGE2_STAGE2_STATISTICS_PREDECESSOR: string = "stage1"
const STAGE2_STAGE2_STATISTICS_POLICY: string = "verified-predecessor, release-parity, deterministic-build"
const STAGE2_STAGE2_STATISTICS_CAPABILITY: string = "stage2_statistics"
const STAGE2_STAGE2_STATISTICS_VERSION: int = 1

proc stage2_stage2_statistics_contract_ready() -> bool {
    give STAGE2_STAGE2_STATISTICS_SCHEMA == "vitte.toolchain.stage2.stage2_statistics.v1" and STAGE2_STAGE2_STATISTICS_STAGE == "stage2" and STAGE2_STAGE2_STATISTICS_VERSION == 1;
}

export *
