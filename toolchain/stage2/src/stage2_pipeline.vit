space toolchain/stage2/stage2_pipeline

const STAGE2_STAGE2_PIPELINE_SCHEMA: string = "vitte.toolchain.stage2.stage2_pipeline.v1"
const STAGE2_STAGE2_PIPELINE_STAGE: string = "stage2"
const STAGE2_STAGE2_PIPELINE_ROLE: string = "compiler rebuilt from stage1 and release candidate"
const STAGE2_STAGE2_PIPELINE_PREDECESSOR: string = "stage1"
const STAGE2_STAGE2_PIPELINE_POLICY: string = "verified-predecessor, release-parity, deterministic-build"
const STAGE2_STAGE2_PIPELINE_CAPABILITY: string = "stage2_pipeline"
const STAGE2_STAGE2_PIPELINE_VERSION: int = 1

proc stage2_stage2_pipeline_contract_ready() -> bool {
    give STAGE2_STAGE2_PIPELINE_SCHEMA == "vitte.toolchain.stage2.stage2_pipeline.v1" and STAGE2_STAGE2_PIPELINE_STAGE == "stage2" and STAGE2_STAGE2_PIPELINE_VERSION == 1;
}

export *
