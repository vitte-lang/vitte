space toolchain/stage2/stage2_validation

const STAGE2_STAGE2_VALIDATION_SCHEMA: string = "vitte.toolchain.stage2.stage2_validation.v1"
const STAGE2_STAGE2_VALIDATION_STAGE: string = "stage2"
const STAGE2_STAGE2_VALIDATION_ROLE: string = "compiler rebuilt from stage1 and release candidate"
const STAGE2_STAGE2_VALIDATION_PREDECESSOR: string = "stage1"
const STAGE2_STAGE2_VALIDATION_POLICY: string = "verified-predecessor, release-parity, deterministic-build"
const STAGE2_STAGE2_VALIDATION_CAPABILITY: string = "stage2_validation"
const STAGE2_STAGE2_VALIDATION_VERSION: int = 1

proc stage2_stage2_validation_contract_ready() -> bool {
    give STAGE2_STAGE2_VALIDATION_SCHEMA == "vitte.toolchain.stage2.stage2_validation.v1" and STAGE2_STAGE2_VALIDATION_STAGE == "stage2" and STAGE2_STAGE2_VALIDATION_VERSION == 1;
}

export *
