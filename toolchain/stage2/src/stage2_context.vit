space toolchain/stage2/stage2_context

const STAGE2_STAGE2_CONTEXT_SCHEMA: string = "vitte.toolchain.stage2.stage2_context.v1"
const STAGE2_STAGE2_CONTEXT_STAGE: string = "stage2"
const STAGE2_STAGE2_CONTEXT_ROLE: string = "compiler rebuilt from stage1 and release candidate"
const STAGE2_STAGE2_CONTEXT_PREDECESSOR: string = "stage1"
const STAGE2_STAGE2_CONTEXT_POLICY: string = "verified-predecessor, release-parity, deterministic-build"
const STAGE2_STAGE2_CONTEXT_CAPABILITY: string = "stage2_context"
const STAGE2_STAGE2_CONTEXT_VERSION: int = 1

proc stage2_stage2_context_contract_ready() -> bool {
    give STAGE2_STAGE2_CONTEXT_SCHEMA == "vitte.toolchain.stage2.stage2_context.v1" and STAGE2_STAGE2_CONTEXT_STAGE == "stage2" and STAGE2_STAGE2_CONTEXT_VERSION == 1;
}

export *
