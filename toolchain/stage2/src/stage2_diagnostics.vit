space toolchain/stage2/stage2_diagnostics

const STAGE2_STAGE2_DIAGNOSTICS_SCHEMA: string = "vitte.toolchain.stage2.stage2_diagnostics.v1"
const STAGE2_STAGE2_DIAGNOSTICS_STAGE: string = "stage2"
const STAGE2_STAGE2_DIAGNOSTICS_ROLE: string = "compiler rebuilt from stage1 and release candidate"
const STAGE2_STAGE2_DIAGNOSTICS_PREDECESSOR: string = "stage1"
const STAGE2_STAGE2_DIAGNOSTICS_POLICY: string = "verified-predecessor, release-parity, deterministic-build"
const STAGE2_STAGE2_DIAGNOSTICS_CAPABILITY: string = "stage2_diagnostics"
const STAGE2_STAGE2_DIAGNOSTICS_VERSION: int = 1

proc stage2_stage2_diagnostics_contract_ready() -> bool {
    give STAGE2_STAGE2_DIAGNOSTICS_SCHEMA == "vitte.toolchain.stage2.stage2_diagnostics.v1" and STAGE2_STAGE2_DIAGNOSTICS_STAGE == "stage2" and STAGE2_STAGE2_DIAGNOSTICS_VERSION == 1;
}

export *
