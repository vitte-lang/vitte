space toolchain/stage2/stage2_driver

const STAGE2_STAGE2_DRIVER_SCHEMA: string = "vitte.toolchain.stage2.stage2_driver.v1"
const STAGE2_STAGE2_DRIVER_STAGE: string = "stage2"
const STAGE2_STAGE2_DRIVER_ROLE: string = "compiler rebuilt from stage1 and release candidate"
const STAGE2_STAGE2_DRIVER_PREDECESSOR: string = "stage1"
const STAGE2_STAGE2_DRIVER_POLICY: string = "verified-predecessor, release-parity, deterministic-build"
const STAGE2_STAGE2_DRIVER_CAPABILITY: string = "stage2_driver"
const STAGE2_STAGE2_DRIVER_VERSION: int = 1

proc stage2_stage2_driver_contract_ready() -> bool {
    give STAGE2_STAGE2_DRIVER_SCHEMA == "vitte.toolchain.stage2.stage2_driver.v1" and STAGE2_STAGE2_DRIVER_STAGE == "stage2" and STAGE2_STAGE2_DRIVER_VERSION == 1;
}

export *
