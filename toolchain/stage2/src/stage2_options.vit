proc stage2_stage2_options_contract_ready() -> bool {
    give STAGE2_STAGE2_OPTIONS_SCHEMA == "vitte.toolchain.stage2.stage2_options.v1" and STAGE2_STAGE2_OPTIONS_STAGE == "stage2" and STAGE2_STAGE2_OPTIONS_VERSION == 1;
