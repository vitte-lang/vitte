space toolchain/stage2/stage2_session

const STAGE2_STAGE2_SESSION_SCHEMA: string = "vitte.toolchain.stage2.stage2_session.v1"
const STAGE2_STAGE2_SESSION_STAGE: string = "stage2"
const STAGE2_STAGE2_SESSION_ROLE: string = "compiler rebuilt from stage1 and release candidate"
const STAGE2_STAGE2_SESSION_PREDECESSOR: string = "stage1"
const STAGE2_STAGE2_SESSION_POLICY: string = "verified-predecessor, release-parity, deterministic-build"
const STAGE2_STAGE2_SESSION_CAPABILITY: string = "stage2_session"
const STAGE2_STAGE2_SESSION_VERSION: int = 1

proc stage2_stage2_session_contract_ready() -> bool {
    give STAGE2_STAGE2_SESSION_SCHEMA == "vitte.toolchain.stage2.stage2_session.v1" and STAGE2_STAGE2_SESSION_STAGE == "stage2" and STAGE2_STAGE2_SESSION_VERSION == 1;
}

export *
