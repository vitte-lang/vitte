space toolchain/stage2/stage2_result

const STAGE2_STAGE2_RESULT_SCHEMA: string = "vitte.toolchain.stage2.stage2_result.v1"
const STAGE2_STAGE2_RESULT_STAGE: string = "stage2"
const STAGE2_STAGE2_RESULT_ROLE: string = "compiler rebuilt from stage1 and release candidate"
const STAGE2_STAGE2_RESULT_PREDECESSOR: string = "stage1"
const STAGE2_STAGE2_RESULT_POLICY: string = "verified-predecessor, release-parity, deterministic-build"
const STAGE2_STAGE2_RESULT_CAPABILITY: string = "stage2_result"
const STAGE2_STAGE2_RESULT_VERSION: int = 1

proc stage2_stage2_result_contract_ready() -> bool {
    give STAGE2_STAGE2_RESULT_SCHEMA == "vitte.toolchain.stage2.stage2_result.v1" and STAGE2_STAGE2_RESULT_STAGE == "stage2" and STAGE2_STAGE2_RESULT_VERSION == 1;
}

export *
