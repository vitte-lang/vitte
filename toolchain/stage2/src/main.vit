space toolchain/stage2/main

const STAGE2_MAIN_SCHEMA: string = "vitte.toolchain.stage2.main.v1"
const STAGE2_MAIN_STAGE: string = "stage2"
const STAGE2_MAIN_ROLE: string = "compiler rebuilt from stage1 and release candidate"
const STAGE2_MAIN_PREDECESSOR: string = "stage1"
const STAGE2_MAIN_POLICY: string = "verified-predecessor, release-parity, deterministic-build"
const STAGE2_MAIN_CAPABILITY: string = "main"
const STAGE2_MAIN_VERSION: int = 1

proc stage2_main_contract_ready() -> bool {
    give STAGE2_MAIN_SCHEMA == "vitte.toolchain.stage2.main.v1" and STAGE2_MAIN_STAGE == "stage2" and STAGE2_MAIN_VERSION == 1;
}

export *
