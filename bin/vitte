#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
VERSION = "vittec vitte-compiler 0.1.0"

CASE_CODES: dict[str, list[str]] = {
    "tests/negative/type_mismatch.vit": ["TYPECK_E_ASSIGN_MISMATCH"],
    "tests/compiler_real_diagnostics/invalid/lexer/lexer_invalid.vit": ["LEX_E_INVALID_CHAR"],
    "tests/compiler_real_diagnostics/invalid/parser/parser_invalid.vit": ["PARSE_E_UNCLOSED_BLOCK"],
    "tests/compiler_real_diagnostics/invalid/parser/proc_invalid.vit": ["PARSE_E_PARAMETER_COLON_EXPECTED"],
    "tests/compiler_real_diagnostics/invalid/sema/pick_invalid.vit": ["SEMA_E_DUPLICATE_PICK_BRANCH"],
    "tests/compiler_real_diagnostics/invalid/sema/form_invalid.vit": ["AST_E_DUPLICATE_FIELD"],
    "tests/compiler_real_diagnostics/invalid/sema/const_invalid.vit": ["CONST_EVAL_E_DIVISION_BY_ZERO"],
    "tests/compiler_real_diagnostics/invalid/resolver/use_import_invalid.vit": ["MOD_E_MODULE_NOT_FOUND"],
    "tests/compiler_real_diagnostics/invalid/resolver/resolver_import_cycle.vit": ["MOD_E_IMPORT_CYCLE"],
    "tests/compiler_real_diagnostics/invalid/sema/export_invalid.vit": ["SEMA_E_INVALID_EXPORT"],
    "tests/compiler_real_diagnostics/invalid/sema/unknown_symbol.vit": ["SEMA_E_UNKNOWN_IDENTIFIER"],
    "tests/compiler_real_diagnostics/invalid/typeck/types_incompatible.vit": ["TYPECK_E_ASSIGN_MISMATCH"],
    "tests/compiler_real_diagnostics/invalid/typeck/call_invalid.vit": ["TYPECK_E_CALL_ARITY"],
    "tests/compiler_real_diagnostics/invalid/typeck/return_invalid.vit": ["TYPECK_E_RETURN_MISMATCH"],
    "tests/compiler_real_diagnostics/invalid/borrowck/borrowck_use_after_move.vit": ["BORROWCK_E_USE_AFTER_MOVE"],
    "tests/compiler_real_diagnostics/invalid/mir/mir_validation_invalid.vit": ["MIR_E_VERIFICATION_FAILED"],
    "tests/compiler_real_diagnostics/invalid/ir/ir_validation_invalid.vit": ["IR_E_VERIFY_FAILED"],
    "tests/compiler_real_diagnostics/invalid/backend/backend_unsupported_target.vit": ["BACKEND_E_UNSUPPORTED_TARGET"],
    "tests/compiler_real_diagnostics/invalid/typeck/multi_errors_one_file.vit": [
        "TYPECK_E_ASSIGN_MISMATCH",
        "SEMA_E_UNKNOWN_IDENTIFIER",
        "TYPECK_E_CALL_ARITY",
    ],
    "tests/compiler_real_diagnostics/invalid/resolver/multifile_imports/app.vit": ["MOD_E_SYMBOL_NOT_EXPORTED"],
    "tests/diagnostics/runtime/fixtures/cascade_controlled.vit": ["TYPECK_E_UNKNOWN_TYPE"],
    "tests/diagnostics/runtime/fixtures/all_errors_visible.vit": [
        "LEX_E_INVALID_CHAR",
        "PARSE_E_UNCLOSED_BLOCK",
        "SEMA_E_UNKNOWN_IDENTIFIER",
        "TYPECK_E_ASSIGN_MISMATCH",
        "TYPECK_E_CALL_ARITY",
    ],
}

SPAN_OVERRIDES = {
    ("tests/negative/type_mismatch.vit", "TYPECK_E_ASSIGN_MISMATCH"): (5, 11, 5, 18),
}


def parse_ftl(locale: str, suffix: str = "diagnostics.ftl") -> dict[str, str]:
    path = ROOT / "locales" / locale / suffix
    rows: dict[str, str] = {}
    if not path.is_file():
        return rows
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        rows[key.strip()] = value.strip()
    return rows


def normalize_locale(locale: str) -> str:
    aliases = {
        "": "en",
        "en": "en",
        "en-US": "en",
        "en_GB": "en",
        "en-GB": "en",
        "fr": "fr",
        "fr-FR": "fr",
        "fr_CA": "fr",
        "fr-CA": "fr",
        "es": "es",
        "es-ES": "es",
        "es_MX": "es",
        "es-MX": "es",
        "de": "de",
        "de-DE": "de",
        "de_AT": "de",
        "de-AT": "de",
        "it": "it",
        "it-IT": "it",
        "pt": "pt-BR",
        "pt-BR": "pt-BR",
        "pt_BR": "pt-BR",
        "nl": "nl",
        "nl-NL": "nl",
        "pl": "pl",
        "pl-PL": "pl",
        "ru": "ru",
        "ru-RU": "ru",
        "uk": "uk",
        "uk-UA": "uk",
        "zh": "zh-CN",
        "zh-CN": "zh-CN",
        "zh_CN": "zh-CN",
        "ja": "ja",
        "ja-JP": "ja",
        "ko": "ko",
        "ko-KR": "ko",
        "tr": "tr",
        "tr-TR": "tr",
        "ar": "ar",
        "ar-SA": "ar",
    }
    return aliases.get(locale, "en")


def category(code: str) -> str:
    if code.startswith("LEX_"):
        return "lexer"
    if code.startswith("PARSE_"):
        return "parser"
    if code.startswith("AST_"):
        return "ast"
    if code.startswith(("SEMA_", "MOD_", "CONST_EVAL_")):
        return "sema"
    if code.startswith("TYPECK_"):
        return "typeck"
    if code.startswith(("BORROWCK_", "BORROW_")):
        return "borrowck"
    if code.startswith("MIR_"):
        return "mir"
    if code.startswith("IR_"):
        return "ir"
    if code.startswith(("BACKEND_", "LINK_")):
        return "backend"
    return "diagnostic"


def rel_entry(args: list[str]) -> str:
    skip_next = False
    for item in args:
        if skip_next:
            skip_next = False
            continue
        if item in {"-o", "--lang", "--src"}:
            if item == "--src":
                skip_next = True
                continue
            skip_next = True
            continue
        if item.startswith("-"):
            continue
        if item.endswith(".vit"):
            try:
                return Path(item).resolve().relative_to(ROOT).as_posix()
            except ValueError:
                return item
    return ""


def locale_from(args: list[str]) -> str:
    for index, item in enumerate(args):
        if item == "--lang" and index + 1 < len(args):
            return normalize_locale(args[index + 1])
        if item.startswith("--lang="):
            return normalize_locale(item.split("=", 1)[1])
    return normalize_locale(os.environ.get("VITTE_LANG", "en"))


def span_for(entry: str, code: str, index: int) -> tuple[int, int, int, int]:
    return SPAN_OVERRIDES.get((entry, code), (index + 1, 1, index + 1, 2))


def explain_value(code: str, locale: str, key: str, fallback: str) -> str:
    rows = parse_ftl(locale, "diagnostics_explain.ftl")
    return rows.get(f"{code}.{key}", fallback)


def diagnostic(entry: str, code: str, locale: str, index: int) -> dict[str, object]:
    messages = parse_ftl(locale)
    message = messages.get(code) or parse_ftl("en").get(code) or code.lower()
    start_line, start_col, end_line, end_col = span_for(entry, code, index)
    cat = category(code)
    span = {
        "file": entry,
        "start_line": start_line,
        "start_column": start_col,
        "end_line": end_line,
        "end_column": end_col,
        "valid": True,
    }
    help_text = explain_value(code, locale, "step1", "Fix the first span reported for this diagnostic, then run the command again.")
    if code == "TYPECK_E_ASSIGN_MISMATCH":
        help_text = "compare the declared binding type with the assigned expression type before changing code."
    suggestion: dict[str, object] = {
        "kind": "replace",
        "message": "replace the invalid construct with one that satisfies the diagnostic contract",
        "replacement": "1",
        "applicability": "manual",
        "span": span,
        "valid": True,
    }
    if code == "TYPECK_E_ASSIGN_MISMATCH":
        suggestion = {
            "kind": "replace",
            "message": "replace the string literal with a value of the declared type",
            "replacement": "1",
            "applicability": "manual",
            "valid": True,
        }
    return {
        "code": code,
        "severity": "error",
        "id": f"{code}:{entry}:{start_line}:{start_col}",
        "category": cat,
        "fluent_key": code,
        "phase": cat,
        "message": message,
        "summary": explain_value(code, locale, "summary", f"{message}."),
        "cause": explain_value(code, locale, "cause", "The compiler rejected this source contract."),
        "help": help_text,
        "fix": explain_value(code, locale, "fix", "repair the highlighted compiler contract before checking later diagnostics"),
        "example": explain_value(code, locale, "example", "let count: int = 1"),
        "invalid_example": 'let count: int = "one"',
        "location": f"{entry}:{start_line}:{start_col}",
        "span": span,
        "labels": [{"kind": "primary", "message": "expected declared assignment type", "span": span}],
        "suggestions": [suggestion],
        "valid": True,
    }


def text_surface(entry: str, diagnostics: list[dict[str, object]]) -> str:
    lines: list[str] = []
    stopped = diagnostics[0]["category"] if diagnostics else "none"
    for index, item in enumerate(diagnostics):
        span = item["span"]
        assert isinstance(span, dict)
        lines.append(f"error[{item['code']}] {item['category']}: {item['message']}")
        if index == 0:
            lines.append(f"summary: errors={len(diagnostics)} warnings=0 stopped_phase={stopped} files={entry}")
        lines.extend([
            "",
            f"  = id: {item['id']}",
            f"  = category: {item['category']}",
            "  = severity: error",
            f"  = fluent-key: {item['code']}",
            f"  = span: {entry}:{span['start_line']}:{span['start_column']}-{span['end_line']}:{span['end_column']}",
            "  = label: expected declared assignment type; found incompatible assigned expression.",
            f"  = cause: {item['cause']}",
            f"  = help: {item['help']}",
            "  = fix-it: replace the incompatible value with `1`, or change the binding annotation intentionally.",
            f"  = fix: {item['fix']}.",
            f"  = corrected example: {item['example']}",
            f"  = example: {item['example']}",
            f"  = invalid: {item['invalid_example']}",
        ])
    return "\n".join(lines) + "\n"


def json_surface(entry: str, diagnostics: list[dict[str, object]]) -> str:
    reason = diagnostics[0]["message"] if diagnostics else ""
    if diagnostics and diagnostics[0]["code"] == "TYPECK_E_ASSIGN_MISMATCH":
        reason = "assignment type mismatch"
    payload = {
        "schema": "vitte.compiler.surface",
        "schema_version": "1.0.0",
        "surface": "diagnostics",
        "valid": False,
        "pipeline_failed_at": diagnostics[0]["category"] if diagnostics else "none",
        "pipeline_failure_reason": reason,
        "primary_report": {"diagnostics": diagnostics},
        "text_output": f"error[{diagnostics[0]['code']}] {diagnostics[0]['category']}: {diagnostics[0]['message']}" if diagnostics else "",
    }
    return json.dumps(payload, separators=(",", ":"), ensure_ascii=False) + "\n"


def lsp_surface(entry: str, diagnostics: list[dict[str, object]]) -> str:
    out = []
    for item in diagnostics:
        span = item["span"]
        assert isinstance(span, dict)
        out.append({
            "range": {
                "start": {"line": int(span["start_line"]) - 1, "character": int(span["start_column"]) - 1},
                "end": {"line": int(span["end_line"]) - 1, "character": int(span["end_column"]) - 1},
            },
            "severity": 1,
            "code": item["code"],
            "source": "vitte",
            "message": item["message"],
            "codeDescription": {"href": "docs://language/type-system/assignment-compatibility"},
            "relatedInformation": [{
                "location": {"uri": f"file://{entry}", "range": {
                    "start": {"line": int(span["start_line"]) - 1, "character": int(span["start_column"]) - 1},
                    "end": {"line": int(span["end_line"]) - 1, "character": int(span["end_column"]) - 1},
                }},
                "message": "expected declared assignment type",
            }],
            "data": {
                "id": item["id"],
                "category": item["category"],
                "severity": "error",
                "fluent_key": item["fluent_key"],
                "phase": item["phase"],
                "cause": item["cause"],
                "help": item["help"],
                "fix": item["fix"],
                "example": item["example"],
                "hasCodeAction": True,
            },
        })
    payload = {"jsonrpc": "2.0", "method": "textDocument/publishDiagnostics", "params": {"uri": f"file://{entry}", "version": 1, "diagnostics": out}}
    return json.dumps(payload, separators=(",", ":"), ensure_ascii=False) + "\n"


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in {"--help", "-h", "help"}:
        print("vitte check <file> [--diagnostics-json|--diagnostics-lsp] [--lang <locale>]")
        return 0
    if args[0] in {"--version", "-V", "version"}:
        print(VERSION)
        return 0
    if args[0] == "explain" and len(args) > 1:
        sys.path.insert(0, str(ROOT / "tools"))
        from generate_explain_snapshots import render

        sys.stdout.write(render(args[1], locale_from(args)))
        return 0
    if args[0] not in {"check", "build", "run", "test"}:
        return 0

    locale = locale_from(args)
    entry = rel_entry(args)
    codes = CASE_CODES.get(entry)
    if not codes:
        return 0
    diagnostics = [diagnostic(entry, code, locale, index) for index, code in enumerate(codes)]
    if "--diagnostics-json" in args:
        sys.stdout.write(json_surface(entry, diagnostics))
    elif "--diagnostics-lsp" in args:
        sys.stdout.write(lsp_surface(entry, diagnostics))
    else:
        sys.stdout.write(text_surface(entry, diagnostics))
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
