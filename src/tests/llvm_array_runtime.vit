/// C17 executable port of the former LLVM array probe.
///
/// Fixed arrays remain part of the source-level contract: aggregate elements,
/// nested fields, integer widths, indexed reads, and indexed writes are all
/// exercised by the native C17 backend.

space compiler/llvm_array_runtime;

form Diagnostic {
    code: i64,
    weight: i64,
    fatal: bool,
}

proc main() -> int {
    let mut diagnostics: [2]Diagnostic = [
        Diagnostic { code: 7, weight: 9, fatal: false },
        Diagnostic { code: 4294967296, weight: 11, fatal: true },
    ];
    let widths: [3]u64 = [
        7 as u64,
        255 as u64,
        4294967296 as u64,
    ];
    let bytes: [2]u8 = [7 as u8, 255 as u8];
    let mut index: i64 = 0;
    let mut fatal_count: i64 = 0;

    while index < 2 {
        if diagnostics[index].fatal {
            set fatal_count = fatal_count + 1;
        }
        set index = index + 1;
    }
    if fatal_count != 1 {
        give 1;
    }
    if diagnostics[1].code != 4294967296 {
        give 2;
    }
    if widths[2] != 4294967296 or bytes[1] != 255 {
        give 3;
    }

    set diagnostics[0].code = 41;
    set diagnostics[0].weight = diagnostics[1].weight - 1;
    if diagnostics[0].code + diagnostics[0].weight != 51 {
        give 4;
    }
    give 0;
}
