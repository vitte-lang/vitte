/// Import-collision fixture B.
///
/// This module deliberately exports many declarations with the same public
/// names as `collision_a.vit`, while giving them different values and
/// behavior.
///
/// Purpose:
/// - verify that qualified imports keep module namespaces independent;
/// - verify that importing both modules does not merge declarations;
/// - verify deterministic collision diagnostics for unqualified/glob imports;
/// - exercise collisions across value, type, variant and procedure names;
/// - make accidental resolution to module A or B observable at runtime;
/// - verify that collisions do not corrupt symbol identity.
///
/// This module is valid by itself.
///
/// Important distinguishing properties:
/// - SOURCE_ID is 2;
/// - VALUE is 22;
/// - ANSWER_PART is 22;
/// - points produced here normally sum to 22;
/// - records created here carry source identifier 2.
///
/// Combined with `collision_a`, the two `ANSWER_PART` values produce 42.

space tests::import_collision::collision_b;

export const SOURCE_ID: i64 = 2;
export const VALUE: i64 = 22;
export const ANSWER_PART: i64 = 22;
export const COMMON_LIMIT: i64 = 100;

export const ZERO: i64 = 0;
export const ONE: i64 = 1;
export const TWO: i64 = 2;
export const TEN: i64 = 10;
export const ELEVEN: i64 = 11;
export const TWENTY_TWO: i64 = 22;
export const ANSWER: i64 = 42;

export const ENABLED: bool = true;
export const DISABLED: bool = false;

/// Same exported type name as collision A.
///
/// The field layout is intentionally compatible enough for comparable tests,
/// but this remains a distinct nominal type belonging to this module.

export form Point {
    x: i64,
    y: i64,
}

/// Same exported type name as collision A.

export form Record {
    value: i64,
    source: i64,
}

/// Same exported type name as collision A.

export form Wrapper {
    point: Point,
    record: Record,
}

/// Additional exported aggregate used for deeper qualified-resolution tests.

export form Range {
    minimum: i64,
    maximum: i64,
}

/// Additional aggregate containing types whose names also collide with module A.

export form Pair {
    first: i64,
    second: i64,
}

/// Nested aggregate.
///
/// This helps detect accidental cross-module type resolution when several
/// identically named types are in scope.

export form Nested {
    point: Point,
    range: Range,
    record: Record,
}

/// Same exported pick name as collision A.

export pick State {
    Ready,
    Running,
    Finished,
}

/// Same exported pick name as collision A.

export pick ResultKind {
    Success,
    Failure,
}

/// Additional pick used to make variant ownership observable.

export pick Direction {
    Left,
    Right,
}

/// Same exported procedure name as collision A.

export proc identity(
    value: i64
) -> i64 {
    return value;
}

/// Same exported procedure name as collision A.
///
/// Its result differs from module A because VALUE differs.

export proc common_value() -> i64 {
    return VALUE;
}

/// Same exported procedure name as collision A.

export proc answer_part() -> i64 {
    return ANSWER_PART;
}

/// Same exported procedure name as collision A.

export proc source_id() -> i64 {
    return SOURCE_ID;
}

/// Same exported procedure name as collision A.

export proc add(
    left: i64,
    right: i64
) -> i64 {
    return left + right;
}

/// Additional arithmetic helpers.

export proc subtract(
    left: i64,
    right: i64
) -> i64 {
    return left - right;
}

export proc multiply(
    left: i64,
    right: i64
) -> i64 {
    return left * right;
}

export proc increment(
    value: i64
) -> i64 {
    return value + ONE;
}

export proc decrement(
    value: i64
) -> i64 {
    return value - ONE;
}

export proc is_zero(
    value: i64
) -> bool {
    return value == ZERO;
}

export proc is_positive(
    value: i64
) -> bool {
    return value > ZERO;
}

export proc is_source_b(
    value: i64
) -> bool {
    return value == SOURCE_ID;
}

export proc is_value_b(
    value: i64
) -> bool {
    return value == VALUE;
}

/// Same exported constructor name as collision A.

export proc make_point(
    x: i64,
    y: i64
) -> Point {
    return Point {
        x: x,
        y: y,
    };
}

/// Same exported factory name as collision A.
///
/// Unlike module A's default point, this one sums to 22.

export proc make_default_point() -> Point {
    return make_point(
        ELEVEN,
        ELEVEN);
}

/// Same exported consumer name as collision A.

export proc point_sum(
    point: &Point
) -> i64 {
    return point.x +
         point.y;
}

export proc point_x(
    point: &Point
) -> i64 {
    return point.x;
}

export proc point_y(
    point: &Point
) -> i64 {
    return point.y;
}

export proc point_equal(
    left: &Point,
    right: &Point
) -> bool {
    return left.x == right.x and
         left.y == right.y;
}

export proc point_translate(
    point: &Point,
    dx: i64,
    dy: i64
) -> Point {
    return Point {
        x: point.x + dx,
        y: point.y + dy,
    };
}

export proc point_scale(
    point: &Point,
    factor: i64
) -> Point {
    return Point {
        x: point.x * factor,
        y: point.y * factor,
    };
}

/// Same exported record factory name as collision A.
///
/// Records from this module always carry SOURCE_ID == 2.

export proc make_record(
    value: i64
) -> Record {
    return Record {
        value: value,
        source: SOURCE_ID,
    };
}

/// Same exported record consumer names as collision A.

export proc record_value(
    record: &Record
) -> i64 {
    return record.value;
}

export proc record_source(
    record: &Record
) -> i64 {
    return record.source;
}

export proc record_belongs_here(
    record: &Record
) -> bool {
    return record.source ==
         SOURCE_ID;
}

/// Same exported wrapper factory name as collision A.

export proc make_wrapper(
    point: Point,
    record: Record
) -> Wrapper {
    return Wrapper {
        point: point,
        record: record,
    };
}

/// Same exported wrapper consumer name as collision A.

export proc wrapper_value(
    wrapper: &Wrapper
) -> i64 {
    return point_sum(
               &wrapper.point) +
         record_value(
               &wrapper.record);
}

export proc wrapper_source(
    wrapper: &Wrapper
) -> i64 {
    return record_source(
        &wrapper.record);
}

/// Range helpers.

export proc make_range(
    minimum_value: i64,
    maximum_value: i64
) -> Range {
    return Range {
        minimum: minimum_value,
        maximum: maximum_value,
    };
}

export proc make_default_range() -> Range {
    return make_range(
        ZERO,
        VALUE);
}

export proc range_minimum(
    range: &Range
) -> i64 {
    return range.minimum;
}

export proc range_maximum(
    range: &Range
) -> i64 {
    return range.maximum;
}

export proc range_width(
    range: &Range
) -> i64 {
    return range.maximum -
         range.minimum;
}

export proc range_valid(
    range: &Range
) -> bool {
    return range.minimum <=
         range.maximum;
}

export proc range_contains(
    range: &Range,
    value: i64
) -> bool {
    return value >= range.minimum and
         value <= range.maximum;
}

/// Pair helpers.

export proc make_pair(
    first: i64,
    second: i64
) -> Pair {
    return Pair {
        first: first,
        second: second,
    };
}

export proc make_default_pair() -> Pair {
    return make_pair(
        TEN,
        12);
}

export proc pair_sum(
    pair: &Pair
) -> i64 {
    return pair.first +
         pair.second;
}

/// Nested aggregate helpers.

export proc make_nested(
    point: Point,
    range: Range,
    record: Record
) -> Nested {
    return Nested {
        point: point,
        range: range,
        record: record,
    };
}

export proc make_default_nested() -> Nested {
    let point: Point =
        make_default_point();

    let range: Range =
        make_default_range();

    let record: Record =
        make_record(
            VALUE);

    return make_nested(
        point,
        range,
        record);
}

export proc nested_point_value(
    nested: &Nested
) -> i64 {
    return point_sum(
        &nested.point);
}

export proc nested_range_value(
    nested: &Nested
) -> i64 {
    return range_width(
        &nested.range);
}

export proc nested_record_value(
    nested: &Nested
) -> i64 {
    return record_value(
        &nested.record);
}

export proc nested_source(
    nested: &Nested
) -> i64 {
    return record_source(
        &nested.record);
}

/// The same exported pick-producing procedure names as collision A.

export proc default_state() -> State {
    return State.Ready;
}

export proc running_state() -> State {
    return State.Running;
}

export proc finished_state() -> State {
    return State.Finished;
}

export proc success_kind() -> ResultKind {
    return ResultKind.Success;
}

export proc failure_kind() -> ResultKind {
    return ResultKind.Failure;
}

export proc left_direction() -> Direction {
    return Direction.Left;
}

export proc right_direction() -> Direction {
    return Direction.Right;
}

/// Procedures combining several colliding declaration categories.

export proc point_value() -> i64 {
    let point: Point =
        make_default_point();

    return point_sum(&point);
}

export proc record_default_value() -> i64 {
    let record: Record =
        make_record(
            VALUE);

    return record_value(&record);
}

export proc record_default_source() -> i64 {
    let record: Record =
        make_record(
            VALUE);

    return record_source(&record);
}

export proc wrapper_default_value() -> i64 {
    let point: Point =
        make_default_point();

    let record: Record =
        make_record(
            VALUE);

    let wrapper: Wrapper =
        make_wrapper(
            point,
            record);

    return wrapper_value(&wrapper);
}

export proc composed_value() -> i64 {
    return add(
        identity(TEN),
        identity(12));
}

export proc nested_call_value() -> i64 {
    return identity(
        add(
            identity(TEN),
            identity(12)));
}

export proc arithmetic_pipeline(
    value: i64
) -> i64 {
    let first: i64 =
        add(
            value,
            TEN);

    let second: i64 =
        multiply(
            first,
            TWO);

    return subtract(
        second,
        TWENTY_TWO);
}

/// Mutable-state coverage.

export proc accumulate_value() -> i64 {
    let mut index: i64 =
        ZERO;

    let mut result: i64 =
        ZERO;

    while index < TWO {
        set result =
            add(
                result,
                ELEVEN);

        set index =
            increment(index);
    }

    return result;
}

/// Conditional coverage.

export proc conditional_value(
    enabled: bool
) -> i64 {
    if enabled {
        return VALUE;
    }

    return ZERO;
}

export proc normalize_to_value(
    value: i64
) -> i64 {
    if value == VALUE {
        return value;
    }

    if value < VALUE {
        return add(
            value,
            subtract(
                VALUE,
                value));
    }

    return subtract(
        value,
        subtract(
            value,
            VALUE));
}

/// Type/reference coverage.

export proc forward_point(
    point: &Point
) -> i64 {
    return point_sum(point);
}

export proc forward_record(
    record: &Record
) -> i64 {
    return record_value(record);
}

export proc forward_wrapper(
    wrapper: &Wrapper
) -> i64 {
    return wrapper_value(wrapper);
}

export proc forward_range(
    range: &Range
) -> i64 {
    return range_width(range);
}

export proc forward_pair(
    pair: &Pair
) -> i64 {
    return pair_sum(pair);
}

/// Identity checks that make accidental cross-module symbol binding visible.

export proc validate_point(
    point: &Point
) -> bool {
    return point_sum(point) ==
         VALUE;
}

export proc validate_record(
    record: &Record
) -> bool {
    return record_value(record) ==
             VALUE and
         record_source(record) ==
             SOURCE_ID;
}

export proc validate_wrapper(
    wrapper: &Wrapper
) -> bool {
    return wrapper_source(wrapper) ==
         SOURCE_ID;
}

export proc validate_range(
    range: &Range
) -> bool {
    return range_valid(range) and
         range_width(range) ==
             VALUE;
}

export proc validate_pair(
    pair: &Pair
) -> bool {
    return pair_sum(pair) ==
         VALUE;
}

export proc validate_nested(
    nested: &Nested
) -> bool {
    return nested_point_value(nested) ==
             VALUE and
         nested_range_value(nested) ==
             VALUE and
         nested_record_value(nested) ==
             VALUE and
         nested_source(nested) ==
             SOURCE_ID;
}

/// Cross-category test.
///
/// This deliberately performs lookups for constants, forms and procedures
/// with names that may also exist in collision A.

export proc cross_category_test() -> bool {
    let point: Point =
        make_point(
            TEN,
            12);

    let record: Record =
        make_record(
            VALUE);

    let wrapper: Wrapper =
        make_wrapper(
            point,
            record);

    let range: Range =
        make_range(
            ZERO,
            VALUE);

    let pair: Pair =
        make_pair(
            TEN,
            12);

    return SOURCE_ID == 2 and
         VALUE == 22 and
         point_sum(&point) == 22 and
         record_value(&record) == 22 and
         record_source(&record) == 2 and
         wrapper_value(&wrapper) == 44 and
         wrapper_source(&wrapper) == 2 and
         range_width(&range) == 22 and
         pair_sum(&pair) == 22;
}

/// Repeated lookup test.
///
/// Repeated references must resolve to the same declaration every time.

export proc repeated_lookup_test() -> bool {
    return VALUE == 22 and
         VALUE == 22 and
         VALUE == 22 and
         SOURCE_ID == 2 and
         SOURCE_ID == 2 and
         identity(VALUE) == 22 and
         identity(VALUE) == 22 and
         common_value() == 22 and
         common_value() == 22;
}

/// Complete self-test.
///
/// This is intentionally extensive so a qualified-import test can call one
/// procedure and still exercise a large portion of this module's symbol
/// surface.

export proc library_self_test() -> bool {
    let point: Point =
        make_default_point();

    let translated: Point =
        point_translate(
            &point,
            ONE,
            -ONE);

    let scaled_source: Point =
        make_point(
            5,
            6);

    let scaled: Point =
        point_scale(
            &scaled_source,
            TWO);

    let record: Record =
        make_record(
            ANSWER_PART);

    let wrapper: Wrapper =
        make_wrapper(
            point,
            record);

    let range: Range =
        make_default_range();

    let pair: Pair =
        make_default_pair();

    let nested: Nested =
        make_default_nested();

    let state: State =
        default_state();

    let running: State =
        running_state();

    let finished: State =
        finished_state();

    let success: ResultKind =
        success_kind();

    let failure: ResultKind =
        failure_kind();

    let left: Direction =
        left_direction();

    let right: Direction =
        right_direction();

    return SOURCE_ID == 2 and
         VALUE == 22 and
         ANSWER_PART == 22 and
         COMMON_LIMIT == 100 and
         ZERO == 0 and
         ONE == 1 and
         TWO == 2 and
         TEN == 10 and
         ELEVEN == 11 and
         TWENTY_TWO == 22 and
         ANSWER == 42 and
         ENABLED and
         not DISABLED and

         identity(VALUE) == 22 and
         common_value() == 22 and
         answer_part() == 22 and
         source_id() == 2 and

         add(10, 12) == 22 and
         subtract(42, 20) == 22 and
         multiply(11, 2) == 22 and
         increment(21) == 22 and
         decrement(23) == 22 and

         is_zero(0) and
         is_positive(VALUE) and
         is_source_b(SOURCE_ID) and
         is_value_b(VALUE) and

         point_sum(&point) == 22 and
         point_x(&point) == 11 and
         point_y(&point) == 11 and
         point_equal(&point, &point) and
         point_sum(&translated) == 22 and
         point_sum(&scaled) == 22 and

         record_value(&record) == 22 and
         record_source(&record) == 2 and
         record_belongs_here(&record) and

         wrapper_value(&wrapper) == 44 and
         wrapper_source(&wrapper) == 2 and

         range_minimum(&range) == 0 and
         range_maximum(&range) == 22 and
         range_width(&range) == 22 and
         range_valid(&range) and
         range_contains(&range, 0) and
         range_contains(&range, 11) and
         range_contains(&range, 22) and
         not range_contains(&range, 23) and

         pair_sum(&pair) == 22 and

         nested_point_value(&nested) == 22 and
         nested_range_value(&nested) == 22 and
         nested_record_value(&nested) == 22 and
         nested_source(&nested) == 2 and

         state == State.Ready and
         running == State.Running and
         finished == State.Finished and
         success == ResultKind.Success and
         failure == ResultKind.Failure and
         left == Direction.Left and
         right == Direction.Right and

         point_value() == 22 and
         record_default_value() == 22 and
         record_default_source() == 2 and
         wrapper_default_value() == 44 and
         composed_value() == 22 and
         nested_call_value() == 22 and
         arithmetic_pipeline(11) == 20 and
         accumulate_value() == 22 and
         conditional_value(true) == 22 and
         conditional_value(false) == 0 and
         normalize_to_value(0) == 22 and
         normalize_to_value(22) == 22 and
         normalize_to_value(100) == 22 and

         forward_point(&point) == 22 and
         forward_record(&record) == 22 and
         forward_wrapper(&wrapper) == 44 and
         forward_range(&range) == 22 and
         forward_pair(&pair) == 22 and

         validate_point(&point) and
         validate_record(&record) and
         validate_wrapper(&wrapper) and
         validate_range(&range) and
         validate_pair(&pair) and
         validate_nested(&nested) and

         cross_category_test() and
         repeated_lookup_test();
}