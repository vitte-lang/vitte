/// Local-vs-import collision test.
///
/// `local_lib` exports declarations whose names are deliberately redeclared
/// locally in this module.
///
/// This fixture verifies the collision policy between:
/// - local declarations;
/// - glob-imported declarations;
/// - constants;
/// - forms;
/// - picks;
/// - procedures.
///
/// Expected behavior:
/// - `local_lib` resolves successfully;
/// - the glob import succeeds as an import operation;
/// - local declarations retain their local identity;
/// - imported declarations with the same names do not silently replace locals;
/// - lookup is deterministic;
/// - no declaration is accidentally merged with its imported counterpart;
/// - qualified access through `local_lib` remains available;
/// - local and qualified imported declarations can coexist.
///
/// Local declarations intentionally use observably different values:
/// - local SOURCE_ID == 99;
/// - imported local_lib::SOURCE_ID == 7;
/// - local VALUE == 1000;
/// - imported local_lib::VALUE == 42.

space tests::import_collision::local_main;

use tests::import_collision::local_lib;use tests::import_collision::local_lib::*;
const SOURCE_ID: i64 = 99;
const VALUE: i64 = 1000;
const MODULE_VALUE: i64 = 2000;
const LOCAL_ZERO: i64 = 0;
const LOCAL_ONE: i64 = 1;

form Point {
    x: i64,
    y: i64,
}

form Record {
    value: i64,
    source: i64,
}

form Wrapper {
    point: Point,
    record: Record,
}

pick State {
    Local,
    Imported,
}

pick ResultKind {
    LocalSuccess,
    LocalFailure,
}

proc identity(
    value: i64
) -> i64 {
    return value + LOCAL_ONE;
}

proc source_id() -> i64 {
    return SOURCE_ID;
}

proc common_value() -> i64 {
    return VALUE;
}

proc module_value() -> i64 {
    return MODULE_VALUE;
}

proc add(
    left: i64,
    right: i64
) -> i64 {
    return left + right + LOCAL_ONE;
}

proc make_point(
    x: i64,
    y: i64
) -> Point {
    return Point {
        x: x,
        y: y,
    };
}

proc make_default_point() -> Point {
    return make_point(
        40,
        60);
}

proc point_sum(
    point: &Point
) -> i64 {
    return point.x +
         point.y;
}

proc make_record(
    value: i64
) -> Record {
    return Record {
        value: value,
        source: SOURCE_ID,
    };
}

proc record_value(
    record: &Record
) -> i64 {
    return record.value;
}

proc record_source(
    record: &Record
) -> i64 {
    return record.source;
}

proc make_wrapper(
    point: Point,
    record: Record
) -> Wrapper {
    return Wrapper {
        point: point,
        record: record,
    };
}

proc wrapper_value(
    wrapper: &Wrapper
) -> i64 {
    return point_sum(
               &wrapper.point) +
         record_value(
               &wrapper.record);
}

proc default_state() -> State {
    return State.Local;
}

proc success_kind() -> ResultKind {
    return ResultKind.LocalSuccess;
}

/// Verify that an unqualified constant resolves to the local declaration.

proc test_local_constant_value() -> bool {
    return VALUE == 1000;
}

/// Verify that the imported declaration remains reachable through the module.

proc test_imported_constant_value() -> bool {
    return local_lib::VALUE == 42;
}

proc test_local_source_id() -> bool {
    return SOURCE_ID == 99 and
         source_id() == 99;
}

proc test_imported_source_id() -> bool {
    return local_lib::SOURCE_ID == 7 and
         local_lib::source_id() == 7;
}

proc test_local_module_value() -> bool {
    return MODULE_VALUE == 2000 and
         module_value() == 2000;
}

proc test_imported_module_value() -> bool {
    return local_lib::MODULE_VALUE == 42 and
         local_lib::module_value() == 42;
}

/// Local `identity` differs intentionally from the imported implementation.

proc test_local_identity() -> bool {
    return identity(41) == 42;
}

proc test_imported_identity() -> bool {
    return local_lib::identity(42) == 42;
}

/// Local `add` deliberately adds one extra unit.

proc test_local_add() -> bool {
    return add(20, 21) == 42;
}

proc test_imported_add() -> bool {
    return local_lib::add(20, 22) == 42;
}

/// Type collision.
///
/// `Point` and `local_lib::Point` must remain distinct nominal declarations.

proc test_local_point() -> bool {
    let point: Point =
        make_default_point();

    return point.x == 40 and
         point.y == 60 and
         point_sum(&point) == 100;
}

proc test_imported_point() -> bool {
    let point: local_lib::Point =
        local_lib::make_default_point();

    return local_lib::point_x(&point) == 20 and
         local_lib::point_y(&point) == 22 and
         local_lib::point_sum(&point) == 42;
}

/// Both type names appear in the same procedure.
///
/// This exercises symbol identity directly and helps catch accidental type
/// merging after glob import.

proc test_parallel_point_types() -> bool {
    let local_point: Point =
        make_point(
            40,
            60);

    let imported_point: local_lib::Point =
        local_lib::make_point(
            20,
            22);

    return point_sum(&local_point) == 100 and
         local_lib::point_sum(
             &imported_point) == 42;
}

proc consume_local_point(
    point: &Point
) -> i64 {
    return point_sum(point);
}

proc consume_imported_point(
    point: &local_lib::Point
) -> i64 {
    return local_lib::point_sum(point);
}

proc produce_local_point() -> Point {
    return make_default_point();
}

proc produce_imported_point() -> local_lib::Point {
    return local_lib::make_default_point();
}

proc test_point_parameter_identity() -> bool {
    let local_point: Point =
        produce_local_point();

    let imported_point: local_lib::Point =
        produce_imported_point();

    return consume_local_point(
               &local_point) == 100 and
         consume_imported_point(
               &imported_point) == 42;
}

/// Record collision.

proc test_local_record() -> bool {
    let record: Record =
        make_record(
            1000);

    return record_value(&record) == 1000 and
         record_source(&record) == 99;
}

proc test_imported_record() -> bool {
    let record: local_lib::Record =
        local_lib::make_record(
            42);

    return local_lib::record_value(
               &record) == 42 and
         local_lib::record_source(
               &record) == 7 and
         local_lib::record_enabled(
               &record);
}

proc test_parallel_record_types() -> bool {
    let local_record: Record =
        make_record(
            1000);

    let imported_record: local_lib::Record =
        local_lib::make_record(
            42);

    return record_value(
               &local_record) == 1000 and
         record_source(
               &local_record) == 99 and
         local_lib::record_value(
               &imported_record) == 42 and
         local_lib::record_source(
               &imported_record) == 7;
}

/// Wrapper collision.

proc test_local_wrapper() -> bool {
    let point: Point =
        make_default_point();

    let record: Record =
        make_record(
            1000);

    let wrapper: Wrapper =
        make_wrapper(
            point,
            record);

    return wrapper_value(&wrapper) == 1100;
}

proc test_imported_wrapper() -> bool {
    let wrapper: local_lib::Wrapper =
        local_lib::make_default_wrapper();

    return local_lib::wrapper_point_sum(
               &wrapper) == 42 and
         local_lib::wrapper_record_value(
               &wrapper) == 42 and
         local_lib::wrapper_source(
               &wrapper) == 7 and
         local_lib::wrapper_value(
               &wrapper) == 84;
}

/// Pick collision.
///
/// The local and imported `State` declarations must remain distinct.

proc test_local_state() -> bool {
    let state: State =
        default_state();

    return state == State.Local;
}

proc test_imported_state() -> bool {
    let state: local_lib::State =
        local_lib::default_state();

    return state ==
         local_lib::State.Idle;
}

proc test_imported_state_variants() -> bool {
    let idle: local_lib::State =
        local_lib::default_state();

    let ready: local_lib::State =
        local_lib::ready_state();

    let running: local_lib::State =
        local_lib::running_state();

    let finished: local_lib::State =
        local_lib::finished_state();

    return idle ==
             local_lib::State.Idle and
         ready ==
             local_lib::State.Ready and
         running ==
             local_lib::State.Running and
         finished ==
             local_lib::State.Finished;
}

proc test_local_result_kind() -> bool {
    let result: ResultKind =
        success_kind();

    return result ==
         ResultKind.LocalSuccess;
}

proc test_imported_result_kind() -> bool {
    let success: local_lib::ResultKind =
        local_lib::success_kind();

    let failure: local_lib::ResultKind =
        local_lib::failure_kind();

    return success ==
             local_lib::ResultKind.Success and
         failure ==
             local_lib::ResultKind.Failure;
}

/// Non-colliding imported declarations remain directly usable.
///
/// `Range` is intentionally not declared locally.

proc test_non_conflicting_range() -> bool {
    let range: Range =
        make_default_range();

    return range_width(&range) == 42 and
         range_valid(&range) and
         range_contains(&range, 21);
}

/// The same non-conflicting declaration through explicit qualification.

proc test_qualified_range() -> bool {
    let range: local_lib::Range =
        local_lib::make_default_range();

    return local_lib::range_width(
               &range) == 42 and
         local_lib::range_valid(
               &range);
}

/// `Pair` is also non-conflicting locally.

proc test_non_conflicting_pair() -> bool {
    let pair: Pair =
        make_default_pair();

    return pair_sum(&pair) == 42;
}

proc test_qualified_pair() -> bool {
    let pair: local_lib::Pair =
        local_lib::make_default_pair();

    return local_lib::pair_sum(
        &pair) == 42;
}

/// `Nested` exists only in the imported module.

proc test_non_conflicting_nested() -> bool {
    let nested: Nested =
        make_default_nested();

    return nested_point_sum(&nested) == 42 and
         nested_range_width(&nested) == 42 and
         nested_record_value(&nested) == 42 and
         nested_pair_sum(&nested) == 42 and
         nested_source(&nested) == 7;
}

proc test_qualified_nested() -> bool {
    let nested: local_lib::Nested =
        local_lib::make_default_nested();

    return local_lib::validate_nested(
        &nested);
}

/// `Direction` exists only in the imported module.

proc test_non_conflicting_direction() -> bool {
    let left: Direction =
        left_direction();

    let right: Direction =
        right_direction();

    return left == Direction.Left and
         right == Direction.Right;
}

proc test_qualified_direction() -> bool {
    let left: local_lib::Direction =
        local_lib::left_direction();

    let right: local_lib::Direction =
        local_lib::right_direction();

    return left ==
             local_lib::Direction.Left and
         right ==
             local_lib::Direction.Right;
}

/// Local shadowing inside a procedure.
///
/// The local variable must shadow the module-level local constant `VALUE`,
/// which itself shadows/collides with the glob-imported `local_lib::VALUE`.

proc test_nested_value_shadowing() -> bool {
    let VALUE: i64 = 123;

    return VALUE == 123 and
         local_lib::VALUE == 42;
}

/// Nested lexical scope shadowing.

proc test_deep_shadowing() -> bool {
    let mut result: i64 = VALUE;

    {
        let VALUE: i64 = 100;

        set result = VALUE;

        {
            let VALUE: i64 = 42;

            set result = VALUE;
        }
    }

    return result == 42 and
         local_lib::VALUE == 42;
}

/// Local declarations must continue resolving consistently after many
/// qualified imported lookups.

proc test_repeated_local_resolution() -> bool {
    return VALUE == 1000 and
         VALUE == 1000 and
         SOURCE_ID == 99 and
         SOURCE_ID == 99 and
         identity(41) == 42 and
         identity(41) == 42 and
         common_value() == 1000 and
         common_value() == 1000;
}

proc test_repeated_imported_resolution() -> bool {
    return local_lib::VALUE == 42 and
         local_lib::VALUE == 42 and
         local_lib::SOURCE_ID == 7 and
         local_lib::SOURCE_ID == 7 and
         local_lib::identity(42) == 42 and
         local_lib::identity(42) == 42 and
         local_lib::common_value() == 42 and
         local_lib::common_value() == 42;
}

/// Alternating local/imported lookup catches caches keyed only by the final
/// identifier rather than by declaration owner/module.

proc test_alternating_resolution() -> bool {
    return VALUE == 1000 and
         local_lib::VALUE == 42 and
         VALUE == 1000 and
         local_lib::VALUE == 42 and
         source_id() == 99 and
         local_lib::source_id() == 7 and
         source_id() == 99 and
         local_lib::source_id() == 7;
}

/// Mixed expression using both declarations with the same source-level name.

proc test_mixed_values() -> bool {
    let local_value: i64 =
        VALUE;

    let imported_value: i64 =
        local_lib::VALUE;

    return local_value == 1000 and
         imported_value == 42 and
         local_value - imported_value == 958;
}

/// Local and imported procedures with identical names are invoked in one
/// expression tree.

proc test_mixed_calls() -> bool {
    let local_result: i64 =
        identity(41);

    let imported_result: i64 =
        local_lib::identity(42);

    return local_result == 42 and
         imported_result == 42;
}

/// Verify local mutation remains unrelated to imported immutable declarations.

proc test_mutation() -> bool {
    let mut value: i64 = 0;

    set value =
        local_lib::VALUE;

    set value =
        identity(value - 1);

    return value == 42 and
         VALUE == 1000 and
         local_lib::VALUE == 42;
}

/// Control flow mixing local and imported symbols.

proc test_control_flow(
    use_imported: bool
) -> i64 {
    if use_imported {
        return local_lib::VALUE;
    }

    return identity(41);
}

/// Imported functionality that internally resolves its own declarations must
/// not accidentally bind to declarations in this consumer.

proc test_imported_internal_resolution() -> bool {
    return local_lib::composed_value() == 42 and
         local_lib::nested_call_value() == 42 and
         local_lib::arithmetic_pipeline(21) == 42 and
         local_lib::normalize_to_module_value(0) == 42 and
         local_lib::normalize_to_module_value(42) == 42 and
         local_lib::normalize_to_module_value(100) == 42 and
         local_lib::conditional_value(true) == 42 and
         local_lib::conditional_value(false) == 0 and
         local_lib::accumulate_value() == 42;
}

/// Imported aggregate validation must retain imported nominal type identity.

proc test_imported_validation() -> bool {
    let point: local_lib::Point =
        local_lib::make_default_point();

    let range: local_lib::Range =
        local_lib::make_default_range();

    let record: local_lib::Record =
        local_lib::make_record(
            local_lib::VALUE);

    let pair: local_lib::Pair =
        local_lib::make_default_pair();

    let wrapper: local_lib::Wrapper =
        local_lib::make_default_wrapper();

    let nested: local_lib::Nested =
        local_lib::make_default_nested();

    return local_lib::validate_point(&point) and
         local_lib::validate_range(&range) and
         local_lib::validate_record(&record) and
         local_lib::validate_pair(&pair) and
         local_lib::validate_wrapper(&wrapper) and
         local_lib::validate_nested(&nested);
}

/// Comprehensive mixed local/imported test.

proc test_integrated_collision_resolution() -> bool {
    let local_point: Point =
        make_default_point();

    let imported_point: local_lib::Point =
        local_lib::make_default_point();

    let local_record: Record =
        make_record(
            VALUE);

    let imported_record: local_lib::Record =
        local_lib::make_record(
            local_lib::VALUE);

    let local_wrapper: Wrapper =
        make_wrapper(
            local_point,
            local_record);

    let imported_wrapper: local_lib::Wrapper =
        local_lib::make_wrapper(
            imported_point,
            imported_record);

    let local_state: State =
        default_state();

    let imported_state: local_lib::State =
        local_lib::default_state();

    let local_result: ResultKind =
        success_kind();

    let imported_result: local_lib::ResultKind =
        local_lib::success_kind();

    return VALUE == 1000 and
         local_lib::VALUE == 42 and

         SOURCE_ID == 99 and
         local_lib::SOURCE_ID == 7 and

         identity(41) == 42 and
         local_lib::identity(42) == 42 and

         point_sum(&local_point) == 100 and
         local_lib::point_sum(
             &imported_point) == 42 and

         record_value(&local_record) == 1000 and
         record_source(&local_record) == 99 and

         local_lib::record_value(
             &imported_record) == 42 and
         local_lib::record_source(
             &imported_record) == 7 and

         wrapper_value(
             &local_wrapper) == 1100 and

         local_lib::wrapper_value(
             &imported_wrapper) == 84 and

         local_state ==
             State.Local and

         imported_state ==
             local_lib::State.Idle and

         local_result ==
             ResultKind.LocalSuccess and

         imported_result ==
             local_lib::ResultKind.Success;
}

proc main() -> int {
    if not test_local_constant_value() { return 1; }
    if not test_imported_constant_value() { return 2; }

    if not test_local_source_id() { return 3; }
    if not test_imported_source_id() { return 4; }

    if not test_local_module_value() { return 5; }
    if not test_imported_module_value() { return 6; }

    if not test_local_identity() { return 7; }
    if not test_imported_identity() { return 8; }

    if not test_local_add() { return 9; }
    if not test_imported_add() { return 10; }

    if not test_local_point() { return 11; }
    if not test_imported_point() { return 12; }
    if not test_parallel_point_types() { return 13; }
    if not test_point_parameter_identity() { return 14; }

    if not test_local_record() { return 15; }
    if not test_imported_record() { return 16; }
    if not test_parallel_record_types() { return 17; }

    if not test_local_wrapper() { return 18; }
    if not test_imported_wrapper() { return 19; }

    if not test_local_state() { return 20; }
    if not test_imported_state() { return 21; }
    if not test_imported_state_variants() { return 22; }

    if not test_local_result_kind() { return 23; }
    if not test_imported_result_kind() { return 24; }

    if not test_non_conflicting_range() { return 25; }
    if not test_qualified_range() { return 26; }

    if not test_non_conflicting_pair() { return 27; }
    if not test_qualified_pair() { return 28; }

    if not test_non_conflicting_nested() { return 29; }
    if not test_qualified_nested() { return 30; }

    if not test_non_conflicting_direction() { return 31; }
    if not test_qualified_direction() { return 32; }

    if not test_nested_value_shadowing() { return 33; }
    if not test_deep_shadowing() { return 34; }

    if not test_repeated_local_resolution() { return 35; }
    if not test_repeated_imported_resolution() { return 36; }
    if not test_alternating_resolution() { return 37; }

    if not test_mixed_values() { return 38; }
    if not test_mixed_calls() { return 39; }
    if not test_mutation() { return 40; }

    if test_control_flow(true) != 42 { return 41; }
    if test_control_flow(false) != 42 { return 42; }

    if not test_imported_internal_resolution() { return 43; }
    if not test_imported_validation() { return 44; }

    if not local_lib::repeated_lookup_test() { return 45; }
    if not local_lib::cross_category_test() { return 46; }
    if not local_lib::library_self_test() { return 47; }

    if not test_integrated_collision_resolution() { return 48; }

    return 0;
}