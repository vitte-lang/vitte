/// Local-declaration collision fixture.
///
/// This module provides a broad exported surface for tests where an importing
/// module also declares local symbols with the same names.
///
/// The module itself is valid. Collisions are expected only in consumers that
/// import these declarations into a scope already containing matching local
/// declarations.
///
/// Observable module identity:
/// - SOURCE_ID == 7
/// - VALUE == 42
/// - MODULE_VALUE == 42
/// - records carry source == 7

space tests::import_collision::local_lib;

export const SOURCE_ID: i64 = 7;
export const VALUE: i64 = 42;
export const MODULE_VALUE: i64 = 42;
export const ZERO: i64 = 0;
export const ONE: i64 = 1;
export const TWO: i64 = 2;
export const TEN: i64 = 10;
export const TWENTY: i64 = 20;
export const TWENTY_TWO: i64 = 22;
export const LIMIT: i64 = 100;
export const ENABLED: bool = true;
export const DISABLED: bool = false;

export form Point {
    x: i64,
    y: i64,
}

export form Range {
    minimum: i64,
    maximum: i64,
}

export form Record {
    value: i64,
    source: i64,
    enabled: bool,
}

export form Pair {
    first: i64,
    second: i64,
}

export form Wrapper {
    point: Point,
    record: Record,
}

export form Nested {
    point: Point,
    range: Range,
    record: Record,
    pair: Pair,
}

export pick State {
    Idle,
    Ready,
    Running,
    Finished,
}

export pick ResultKind {
    Success,
    Failure,
}

export pick Direction {
    Left,
    Right,
}

export proc identity(
    value: i64
) -> i64 {
    return value;
}

export proc source_id() -> i64 {
    return SOURCE_ID;
}

export proc common_value() -> i64 {
    return VALUE;
}

export proc module_value() -> i64 {
    return MODULE_VALUE;
}

export proc add(
    left: i64,
    right: i64
) -> i64 {
    return left + right;
}

export proc subtract(
    left: i64,
    right: i64
) -> i64 {
    return left - right;
}

export proc multiply(
    left: i64,
    right: i64
) -> i64 {
    return left * right;
}

export proc increment(
    value: i64
) -> i64 {
    return value + ONE;
}

export proc decrement(
    value: i64
) -> i64 {
    return value - ONE;
}

export proc is_zero(
    value: i64
) -> bool {
    return value == ZERO;
}

export proc is_positive(
    value: i64
) -> bool {
    return value > ZERO;
}

export proc is_module_value(
    value: i64
) -> bool {
    return value == MODULE_VALUE;
}

export proc within_limit(
    value: i64
) -> bool {
    return value >= ZERO and
         value <= LIMIT;
}

export proc make_point(
    x: i64,
    y: i64
) -> Point {
    return Point {
        x: x,
        y: y,
    };
}

export proc make_default_point() -> Point {
    return make_point(
        TWENTY,
        TWENTY_TWO);
}

export proc point_x(
    point: &Point
) -> i64 {
    return point.x;
}

export proc point_y(
    point: &Point
) -> i64 {
    return point.y;
}

export proc point_sum(
    point: &Point
) -> i64 {
    return point.x +
         point.y;
}

export proc point_equal(
    left: &Point,
    right: &Point
) -> bool {
    return left.x == right.x and
         left.y == right.y;
}

export proc make_range(
    minimum_value: i64,
    maximum_value: i64
) -> Range {
    return Range {
        minimum: minimum_value,
        maximum: maximum_value,
    };
}

export proc make_default_range() -> Range {
    return make_range(
        ZERO,
        VALUE);
}

export proc range_width(
    range: &Range
) -> i64 {
    return range.maximum -
         range.minimum;
}

export proc range_valid(
    range: &Range
) -> bool {
    return range.minimum <=
         range.maximum;
}

export proc range_contains(
    range: &Range,
    value: i64
) -> bool {
    return value >= range.minimum and
         value <= range.maximum;
}

export proc make_record(
    value: i64
) -> Record {
    return Record {
        value: value,
        source: SOURCE_ID,
        enabled: ENABLED,
    };
}

export proc record_value(
    record: &Record
) -> i64 {
    return record.value;
}

export proc record_source(
    record: &Record
) -> i64 {
    return record.source;
}

export proc record_enabled(
    record: &Record
) -> bool {
    return record.enabled;
}

export proc record_belongs_here(
    record: &Record
) -> bool {
    return record.source == SOURCE_ID;
}

export proc make_pair(
    first: i64,
    second: i64
) -> Pair {
    return Pair {
        first: first,
        second: second,
    };
}

export proc make_default_pair() -> Pair {
    return make_pair(
        TWENTY,
        TWENTY_TWO);
}

export proc pair_sum(
    pair: &Pair
) -> i64 {
    return pair.first +
         pair.second;
}

export proc make_wrapper(
    point: Point,
    record: Record
) -> Wrapper {
    return Wrapper {
        point: point,
        record: record,
    };
}

export proc make_default_wrapper() -> Wrapper {
    let point: Point =
        make_default_point();

    let record: Record =
        make_record(
            VALUE);

    return make_wrapper(
        point,
        record);
}

export proc wrapper_point_sum(
    wrapper: &Wrapper
) -> i64 {
    return point_sum(
        &wrapper.point);
}

export proc wrapper_record_value(
    wrapper: &Wrapper
) -> i64 {
    return record_value(
        &wrapper.record);
}

export proc wrapper_source(
    wrapper: &Wrapper
) -> i64 {
    return record_source(
        &wrapper.record);
}

export proc wrapper_value(
    wrapper: &Wrapper
) -> i64 {
    return wrapper_point_sum(wrapper) +
         wrapper_record_value(wrapper);
}

export proc make_nested(
    point: Point,
    range: Range,
    record: Record,
    pair: Pair
) -> Nested {
    return Nested {
        point: point,
        range: range,
        record: record,
        pair: pair,
    };
}

export proc make_default_nested() -> Nested {
    let point: Point =
        make_default_point();

    let range: Range =
        make_default_range();

    let record: Record =
        make_record(
            VALUE);

    let pair: Pair =
        make_default_pair();

    return make_nested(
        point,
        range,
        record,
        pair);
}

export proc nested_point_sum(
    nested: &Nested
) -> i64 {
    return point_sum(
        &nested.point);
}

export proc nested_range_width(
    nested: &Nested
) -> i64 {
    return range_width(
        &nested.range);
}

export proc nested_record_value(
    nested: &Nested
) -> i64 {
    return record_value(
        &nested.record);
}

export proc nested_pair_sum(
    nested: &Nested
) -> i64 {
    return pair_sum(
        &nested.pair);
}

export proc nested_source(
    nested: &Nested
) -> i64 {
    return record_source(
        &nested.record);
}

export proc default_state() -> State {
    return State.Idle;
}

export proc ready_state() -> State {
    return State.Ready;
}

export proc running_state() -> State {
    return State.Running;
}

export proc finished_state() -> State {
    return State.Finished;
}

export proc success_kind() -> ResultKind {
    return ResultKind.Success;
}

export proc failure_kind() -> ResultKind {
    return ResultKind.Failure;
}

export proc left_direction() -> Direction {
    return Direction.Left;
}

export proc right_direction() -> Direction {
    return Direction.Right;
}

export proc composed_value() -> i64 {
    return add(
        TWENTY,
        TWENTY_TWO);
}

export proc nested_call_value() -> i64 {
    return identity(
        add(
            identity(TWENTY),
            identity(TWENTY_TWO)));
}

export proc arithmetic_pipeline(
    value: i64
) -> i64 {
    let first: i64 =
        add(
            value,
            TEN);

    let second: i64 =
        multiply(
            first,
            TWO);

    return subtract(
        second,
        TWENTY);
}

export proc normalize_to_module_value(
    value: i64
) -> i64 {
    if value == MODULE_VALUE {
        return value;
    }

    if value < MODULE_VALUE {
        return add(
            value,
            subtract(
                MODULE_VALUE,
                value));
    }

    return subtract(
        value,
        subtract(
            value,
            MODULE_VALUE));
}

export proc conditional_value(
    enabled: bool
) -> i64 {
    if enabled {
        return MODULE_VALUE;
    }

    return ZERO;
}

export proc accumulate_value() -> i64 {
    let mut index: i64 =
        ZERO;

    let mut result: i64 =
        ZERO;

    while index < 6 {
        set result =
            add(
                result,
                7);

        set index =
            increment(index);
    }

    return result;
}

export proc forward_point(
    point: &Point
) -> i64 {
    return point_sum(point);
}

export proc forward_range(
    range: &Range
) -> i64 {
    return range_width(range);
}

export proc forward_record(
    record: &Record
) -> i64 {
    return record_value(record);
}

export proc forward_pair(
    pair: &Pair
) -> i64 {
    return pair_sum(pair);
}

export proc forward_wrapper(
    wrapper: &Wrapper
) -> i64 {
    return wrapper_value(wrapper);
}

export proc forward_nested(
    nested: &Nested
) -> i64 {
    return nested_point_sum(nested);
}

export proc validate_point(
    point: &Point
) -> bool {
    return point_sum(point) ==
         MODULE_VALUE;
}

export proc validate_range(
    range: &Range
) -> bool {
    return range_valid(range) and
         range_width(range) ==
             MODULE_VALUE;
}

export proc validate_record(
    record: &Record
) -> bool {
    return record_value(record) ==
             MODULE_VALUE and
         record_source(record) ==
             SOURCE_ID and
         record_enabled(record);
}

export proc validate_pair(
    pair: &Pair
) -> bool {
    return pair_sum(pair) ==
         MODULE_VALUE;
}

export proc validate_wrapper(
    wrapper: &Wrapper
) -> bool {
    return wrapper_point_sum(wrapper) ==
             MODULE_VALUE and
         wrapper_record_value(wrapper) ==
             MODULE_VALUE and
         wrapper_source(wrapper) ==
             SOURCE_ID;
}

export proc validate_nested(
    nested: &Nested
) -> bool {
    return nested_point_sum(nested) ==
             MODULE_VALUE and
         nested_range_width(nested) ==
             MODULE_VALUE and
         nested_record_value(nested) ==
             MODULE_VALUE and
         nested_pair_sum(nested) ==
             MODULE_VALUE and
         nested_source(nested) ==
             SOURCE_ID;
}

export proc repeated_lookup_test() -> bool {
    return VALUE == 42 and
         VALUE == 42 and
         VALUE == 42 and
         MODULE_VALUE == 42 and
         MODULE_VALUE == 42 and
         SOURCE_ID == 7 and
         SOURCE_ID == 7 and
         identity(VALUE) == 42 and
         identity(VALUE) == 42 and
         common_value() == 42 and
         common_value() == 42;
}

export proc cross_category_test() -> bool {
    let point: Point =
        make_default_point();

    let range: Range =
        make_default_range();

    let record: Record =
        make_record(
            VALUE);

    let pair: Pair =
        make_default_pair();

    let wrapper: Wrapper =
        make_wrapper(
            point,
            record);

    return point_sum(&point) == 42 and
         range_width(&range) == 42 and
         record_value(&record) == 42 and
         record_source(&record) == 7 and
         pair_sum(&pair) == 42 and
         wrapper_point_sum(&wrapper) == 42 and
         wrapper_record_value(&wrapper) == 42 and
         wrapper_source(&wrapper) == 7;
}

export proc library_self_test() -> bool {
    let point: Point =
        make_default_point();

    let range: Range =
        make_default_range();

    let record: Record =
        make_record(
            VALUE);

    let pair: Pair =
        make_default_pair();

    let wrapper: Wrapper =
        make_wrapper(
            point,
            record);

    let nested: Nested =
        make_default_nested();

    let state: State =
        default_state();

    let ready: State =
        ready_state();

    let running: State =
        running_state();

    let finished: State =
        finished_state();

    let success: ResultKind =
        success_kind();

    let failure: ResultKind =
        failure_kind();

    let left: Direction =
        left_direction();

    let right: Direction =
        right_direction();

    return SOURCE_ID == 7 and
         VALUE == 42 and
         MODULE_VALUE == 42 and
         ZERO == 0 and
         ONE == 1 and
         TWO == 2 and
         TEN == 10 and
         TWENTY == 20 and
         TWENTY_TWO == 22 and
         LIMIT == 100 and
         ENABLED and
         not DISABLED and

         identity(VALUE) == 42 and
         source_id() == 7 and
         common_value() == 42 and
         module_value() == 42 and

         add(20, 22) == 42 and
         subtract(100, 58) == 42 and
         multiply(6, 7) == 42 and
         increment(41) == 42 and
         decrement(43) == 42 and

         is_zero(0) and
         is_positive(42) and
         is_module_value(42) and
         within_limit(42) and

         point_x(&point) == 20 and
         point_y(&point) == 22 and
         point_sum(&point) == 42 and
         point_equal(&point, &point) and

         range_width(&range) == 42 and
         range_valid(&range) and
         range_contains(&range, 0) and
         range_contains(&range, 21) and
         range_contains(&range, 42) and
         not range_contains(&range, 43) and

         record_value(&record) == 42 and
         record_source(&record) == 7 and
         record_enabled(&record) and
         record_belongs_here(&record) and

         pair_sum(&pair) == 42 and

         wrapper_point_sum(&wrapper) == 42 and
         wrapper_record_value(&wrapper) == 42 and
         wrapper_source(&wrapper) == 7 and
         wrapper_value(&wrapper) == 84 and

         nested_point_sum(&nested) == 42 and
         nested_range_width(&nested) == 42 and
         nested_record_value(&nested) == 42 and
         nested_pair_sum(&nested) == 42 and
         nested_source(&nested) == 7 and

         state == State.Idle and
         ready == State.Ready and
         running == State.Running and
         finished == State.Finished and
         success == ResultKind.Success and
         failure == ResultKind.Failure and
         left == Direction.Left and
         right == Direction.Right and

         composed_value() == 42 and
         nested_call_value() == 42 and
         arithmetic_pipeline(21) == 42 and
         normalize_to_module_value(0) == 42 and
         normalize_to_module_value(42) == 42 and
         normalize_to_module_value(100) == 42 and
         conditional_value(true) == 42 and
         conditional_value(false) == 0 and
         accumulate_value() == 42 and

         forward_point(&point) == 42 and
         forward_range(&range) == 42 and
         forward_record(&record) == 42 and
         forward_pair(&pair) == 42 and
         forward_wrapper(&wrapper) == 84 and
         forward_nested(&nested) == 42 and

         validate_point(&point) and
         validate_range(&range) and
         validate_record(&record) and
         validate_pair(&pair) and
         validate_wrapper(&wrapper) and
         validate_nested(&nested) and

         repeated_lookup_test() and
         cross_category_test();
}