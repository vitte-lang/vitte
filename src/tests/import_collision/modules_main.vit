/// Qualified-module import collision test.
///
/// `collision_a` and `collision_b` intentionally export many declarations with
/// identical names. This positive fixture imports both modules without glob
/// expansion and verifies that qualified lookup keeps both namespaces fully
/// independent.
///
/// Observable identities:
/// - collision_a::SOURCE_ID == 1
/// - collision_a::VALUE == 20
/// - collision_a::ANSWER_PART == 20
/// - collision_b::SOURCE_ID == 2
/// - collision_b::VALUE == 22
/// - collision_b::ANSWER_PART == 22
/// - both ANSWER_PART values together produce 42.
///
/// Expected result:
/// - both modules resolve;
/// - no import collision is diagnosed;
/// - same-named constants remain distinct;
/// - same-named forms remain distinct nominal types;
/// - same-named picks remain distinct;
/// - same-named procedures resolve through their owning module;
/// - repeated and alternating qualified lookup is deterministic;
/// - compilation succeeds;
/// - execution returns 0.

space tests::import_collision::modules_main;

use tests::import_collision::collision_a;use tests::import_collision::collision_b;
proc test_module_identity() -> bool {
    return collision_a::SOURCE_ID == 1 and
         collision_b::SOURCE_ID == 2 and
         collision_a::source_id() == 1 and
         collision_b::source_id() == 2;
}

proc test_values() -> bool {
    return collision_a::VALUE == 20 and
         collision_b::VALUE == 22 and
         collision_a::ANSWER_PART == 20 and
         collision_b::ANSWER_PART == 22 and
         collision_a::COMMON_LIMIT == 100 and
         collision_b::COMMON_LIMIT == 100;
}

proc test_combined_answer() -> bool {
    return collision_a::ANSWER_PART +
             collision_b::ANSWER_PART ==
         42;
}

proc test_common_value() -> bool {
    return collision_a::common_value() == 20 and
         collision_b::common_value() == 22 and
         collision_a::common_value() +
             collision_b::common_value() ==
             42;
}

proc test_answer_part() -> bool {
    return collision_a::answer_part() == 20 and
         collision_b::answer_part() == 22 and
         collision_a::answer_part() +
             collision_b::answer_part() ==
             42;
}

proc test_identity() -> bool {
    return collision_a::identity(20) == 20 and
         collision_b::identity(22) == 22 and
         collision_a::identity(
             collision_a::VALUE) == 20 and
         collision_b::identity(
             collision_b::VALUE) == 22;
}

proc test_add() -> bool {
    return collision_a::add(
               10,
               10) == 20 and
         collision_b::add(
               10,
               12) == 22 and
         collision_a::add(
               collision_a::VALUE,
               collision_b::VALUE) == 42 and
         collision_b::add(
               collision_a::VALUE,
               collision_b::VALUE) == 42;
}

proc test_cross_module_expression() -> i64 {
    let left: i64 =
        collision_a::common_value();

    let right: i64 =
        collision_b::common_value();

    return collision_a::add(
        left,
        right);
}

proc test_nested_cross_module_calls() -> i64 {
    return collision_b::identity(
        collision_a::add(
            collision_a::identity(
                collision_a::VALUE),
            collision_b::identity(
                collision_b::VALUE)));
}

proc test_point_a() -> bool {
    let point: collision_a::Point =
        collision_a::make_default_point();

    return point.x == 10 and
         point.y == 10 and
         collision_a::point_sum(
             &point) == 20;
}

proc test_point_b() -> bool {
    let point: collision_b::Point =
        collision_b::make_default_point();

    return point.x == 11 and
         point.y == 11 and
         collision_b::point_sum(
             &point) == 22;
}

proc test_parallel_point_types() -> bool {
    let point_a: collision_a::Point =
        collision_a::make_point(
            10,
            10);

    let point_b: collision_b::Point =
        collision_b::make_point(
            11,
            11);

    return collision_a::point_sum(
               &point_a) == 20 and
         collision_b::point_sum(
               &point_b) == 22 and
         collision_a::point_sum(
               &point_a) +
             collision_b::point_sum(
                 &point_b) ==
             42;
}

proc consume_point_a(
    point: &collision_a::Point
) -> i64 {
    return collision_a::point_sum(point);
}

proc consume_point_b(
    point: &collision_b::Point
) -> i64 {
    return collision_b::point_sum(point);
}

proc produce_point_a() -> collision_a::Point {
    return collision_a::make_default_point();
}

proc produce_point_b() -> collision_b::Point {
    return collision_b::make_default_point();
}

proc test_point_type_identity() -> bool {
    let point_a: collision_a::Point =
        produce_point_a();

    let point_b: collision_b::Point =
        produce_point_b();

    return consume_point_a(
               &point_a) == 20 and
         consume_point_b(
               &point_b) == 22;
}

proc test_record_a() -> bool {
    let record: collision_a::Record =
        collision_a::make_record(
            collision_a::VALUE);

    return collision_a::record_value(
               &record) == 20 and
         collision_a::record_source(
               &record) == 1;
}

proc test_record_b() -> bool {
    let record: collision_b::Record =
        collision_b::make_record(
            collision_b::VALUE);

    return collision_b::record_value(
               &record) == 22 and
         collision_b::record_source(
               &record) == 2 and
         collision_b::record_belongs_here(
             &record);
}

proc test_parallel_record_types() -> bool {
    let record_a: collision_a::Record =
        collision_a::make_record(
            collision_a::VALUE);

    let record_b: collision_b::Record =
        collision_b::make_record(
            collision_b::VALUE);

    return collision_a::record_value(
               &record_a) == 20 and
         collision_a::record_source(
               &record_a) == 1 and
         collision_b::record_value(
               &record_b) == 22 and
         collision_b::record_source(
               &record_b) == 2;
}

proc test_wrapper_a() -> bool {
    let point: collision_a::Point =
        collision_a::make_default_point();

    let record: collision_a::Record =
        collision_a::make_record(
            collision_a::VALUE);

    let wrapper: collision_a::Wrapper =
        collision_a::make_wrapper(
            point,
            record);

    return collision_a::wrapper_value(
        &wrapper) == 40;
}

proc test_wrapper_b() -> bool {
    let point: collision_b::Point =
        collision_b::make_default_point();

    let record: collision_b::Record =
        collision_b::make_record(
            collision_b::VALUE);

    let wrapper: collision_b::Wrapper =
        collision_b::make_wrapper(
            point,
            record);

    return collision_b::wrapper_value(
               &wrapper) == 44 and
         collision_b::wrapper_source(
               &wrapper) == 2;
}

proc test_states() -> bool {
    let state_a: collision_a::State =
        collision_a::default_state();

    let state_b: collision_b::State =
        collision_b::default_state();

    return state_a ==
             collision_a::State.Ready and
         state_b ==
             collision_b::State.Ready;
}

proc test_state_b_variants() -> bool {
    let running: collision_b::State =
        collision_b::running_state();

    let finished: collision_b::State =
        collision_b::finished_state();

    return running ==
             collision_b::State.Running and
         finished ==
             collision_b::State.Finished;
}

proc test_result_kinds() -> bool {
    let success_a: collision_a::ResultKind =
        collision_a::success_kind();

    let success_b: collision_b::ResultKind =
        collision_b::success_kind();

    let failure_b: collision_b::ResultKind =
        collision_b::failure_kind();

    return success_a ==
             collision_a::ResultKind.Success and
         success_b ==
             collision_b::ResultKind.Success and
         failure_b ==
             collision_b::ResultKind.Failure;
}

proc test_b_only_range() -> bool {
    let range: collision_b::Range =
        collision_b::make_default_range();

    return collision_b::range_minimum(
               &range) == 0 and
         collision_b::range_maximum(
               &range) == 22 and
         collision_b::range_width(
               &range) == 22 and
         collision_b::range_valid(
               &range) and
         collision_b::range_contains(
             &range,
             11);
}

proc test_b_only_pair() -> bool {
    let pair: collision_b::Pair =
        collision_b::make_default_pair();

    return collision_b::pair_sum(
        &pair) == 22;
}

proc test_b_only_nested() -> bool {
    let nested: collision_b::Nested =
        collision_b::make_default_nested();

    return collision_b::nested_point_value(
               &nested) == 22 and
         collision_b::nested_range_value(
               &nested) == 22 and
         collision_b::nested_record_value(
               &nested) == 22 and
         collision_b::nested_source(
               &nested) == 2 and
         collision_b::validate_nested(
             &nested);
}

proc test_b_only_direction() -> bool {
    let left: collision_b::Direction =
        collision_b::left_direction();

    let right: collision_b::Direction =
        collision_b::right_direction();

    return left ==
             collision_b::Direction.Left and
         right ==
             collision_b::Direction.Right;
}

proc test_repeated_constant_lookup() -> bool {
    return collision_a::VALUE == 20 and
         collision_a::VALUE == 20 and
         collision_a::VALUE == 20 and
         collision_b::VALUE == 22 and
         collision_b::VALUE == 22 and
         collision_b::VALUE == 22;
}

proc test_alternating_constant_lookup() -> bool {
    return collision_a::VALUE == 20 and
         collision_b::VALUE == 22 and
         collision_a::VALUE == 20 and
         collision_b::VALUE == 22 and
         collision_a::SOURCE_ID == 1 and
         collision_b::SOURCE_ID == 2 and
         collision_a::SOURCE_ID == 1 and
         collision_b::SOURCE_ID == 2;
}

proc test_repeated_proc_lookup() -> bool {
    return collision_a::identity(20) == 20 and
         collision_b::identity(22) == 22 and
         collision_a::identity(20) == 20 and
         collision_b::identity(22) == 22 and
         collision_a::common_value() == 20 and
         collision_b::common_value() == 22;
}

proc test_alternating_type_lookup() -> bool {
    let first_a: collision_a::Point =
        collision_a::make_default_point();

    let first_b: collision_b::Point =
        collision_b::make_default_point();

    let second_a: collision_a::Point =
        collision_a::make_point(
            5,
            15);

    let second_b: collision_b::Point =
        collision_b::make_point(
            10,
            12);

    return collision_a::point_sum(
               &first_a) == 20 and
         collision_b::point_sum(
               &first_b) == 22 and
         collision_a::point_sum(
               &second_a) == 20 and
         collision_b::point_sum(
               &second_b) == 22;
}

proc test_nested_scope() -> bool {
    let mut result: i64 = 0;

    {
        let value_a: i64 =
            collision_a::VALUE;

        let value_b: i64 =
            collision_b::VALUE;

        {
            set result =
                collision_a::add(
                    value_a,
                    value_b);
        }
    }

    return result == 42;
}

proc test_control_flow(
    choose_a: bool
) -> i64 {
    if choose_a {
        return collision_a::VALUE;
    }

    return collision_b::VALUE;
}

proc test_mutation() -> bool {
    let mut value: i64 =
        collision_a::VALUE;

    set value =
        collision_a::add(
            value,
            collision_b::VALUE);

    return value == 42 and
         collision_a::VALUE == 20 and
         collision_b::VALUE == 22;
}

proc test_b_arithmetic_helpers() -> bool {
    return collision_b::subtract(
               42,
               20) == 22 and
         collision_b::multiply(
               11,
               2) == 22 and
         collision_b::increment(
               21) == 22 and
         collision_b::decrement(
               23) == 22 and
         collision_b::is_zero(0) and
         collision_b::is_positive(22) and
         collision_b::is_source_b(2) and
         collision_b::is_value_b(22);
}

proc test_b_point_operations() -> bool {
    let point: collision_b::Point =
        collision_b::make_default_point();

    let translated: collision_b::Point =
        collision_b::point_translate(
            &point,
            1,
            -1);

    let source: collision_b::Point =
        collision_b::make_point(
            5,
            6);

    let scaled: collision_b::Point =
        collision_b::point_scale(
            &source,
            2);

    return collision_b::point_equal(
               &point,
               &point) and
         collision_b::point_sum(
               &translated) == 22 and
         collision_b::point_sum(
               &scaled) == 22;
}

proc test_b_composition() -> bool {
    return collision_b::point_value() == 22 and
         collision_b::record_default_value() == 22 and
         collision_b::record_default_source() == 2 and
         collision_b::wrapper_default_value() == 44 and
         collision_b::composed_value() == 22 and
         collision_b::nested_call_value() == 22 and
         collision_b::accumulate_value() == 22 and
         collision_b::conditional_value(true) == 22 and
         collision_b::conditional_value(false) == 0 and
         collision_b::normalize_to_value(0) == 22 and
         collision_b::normalize_to_value(22) == 22 and
         collision_b::normalize_to_value(100) == 22;
}

proc test_forwarding() -> bool {
    let point_a: collision_a::Point =
        collision_a::make_default_point();

    let point_b: collision_b::Point =
        collision_b::make_default_point();

    let record_a: collision_a::Record =
        collision_a::make_record(
            collision_a::VALUE);

    let record_b: collision_b::Record =
        collision_b::make_record(
            collision_b::VALUE);

    let range_b: collision_b::Range =
        collision_b::make_default_range();

    let pair_b: collision_b::Pair =
        collision_b::make_default_pair();

    return collision_a::point_sum(
               &point_a) == 20 and
         collision_a::record_value(
               &record_a) == 20 and
         collision_b::forward_point(
               &point_b) == 22 and
         collision_b::forward_record(
               &record_b) == 22 and
         collision_b::forward_range(
               &range_b) == 22 and
         collision_b::forward_pair(
               &pair_b) == 22;
}

proc test_validation() -> bool {
    let point_b: collision_b::Point =
        collision_b::make_default_point();

    let record_b: collision_b::Record =
        collision_b::make_record(
            collision_b::VALUE);

    let range_b: collision_b::Range =
        collision_b::make_default_range();

    let pair_b: collision_b::Pair =
        collision_b::make_default_pair();

    let wrapper_b: collision_b::Wrapper =
        collision_b::make_wrapper(
            point_b,
            record_b);

    let nested_b: collision_b::Nested =
        collision_b::make_default_nested();

    return collision_b::validate_point(
               &point_b) and
         collision_b::validate_record(
               &record_b) and
         collision_b::validate_range(
               &range_b) and
         collision_b::validate_pair(
               &pair_b) and
         collision_b::validate_wrapper(
               &wrapper_b) and
         collision_b::validate_nested(
               &nested_b);
}

proc test_library_self_tests() -> bool {
    return collision_a::library_self_test() and
         collision_b::library_self_test();
}

proc test_cross_module_aggregate_composition() -> bool {
    let point_a: collision_a::Point =
        collision_a::make_default_point();

    let point_b: collision_b::Point =
        collision_b::make_default_point();

    let value_a: i64 =
        collision_a::point_sum(
            &point_a);

    let value_b: i64 =
        collision_b::point_sum(
            &point_b);

    let record_a: collision_a::Record =
        collision_a::make_record(
            value_a);

    let record_b: collision_b::Record =
        collision_b::make_record(
            value_b);

    return collision_a::record_value(
               &record_a) == 20 and
         collision_b::record_value(
               &record_b) == 22 and
         collision_a::record_value(
               &record_a) +
             collision_b::record_value(
                 &record_b) ==
             42;
}

proc test_integrated_modules() -> bool {
    let point_a: collision_a::Point =
        collision_a::make_default_point();

    let point_b: collision_b::Point =
        collision_b::make_default_point();

    let record_a: collision_a::Record =
        collision_a::make_record(
            collision_a::VALUE);

    let record_b: collision_b::Record =
        collision_b::make_record(
            collision_b::VALUE);

    let wrapper_a: collision_a::Wrapper =
        collision_a::make_wrapper(
            point_a,
            record_a);

    let wrapper_b: collision_b::Wrapper =
        collision_b::make_wrapper(
            point_b,
            record_b);

    let state_a: collision_a::State =
        collision_a::default_state();

    let state_b: collision_b::State =
        collision_b::default_state();

    let result_a: collision_a::ResultKind =
        collision_a::success_kind();

    let result_b: collision_b::ResultKind =
        collision_b::success_kind();

    let mut answer: i64 = 0;

    set answer =
        collision_a::answer_part() +
        collision_b::answer_part();

    return answer == 42 and

         collision_a::SOURCE_ID == 1 and
         collision_b::SOURCE_ID == 2 and

         collision_a::VALUE == 20 and
         collision_b::VALUE == 22 and

         collision_a::point_sum(
             &point_a) == 20 and
         collision_b::point_sum(
             &point_b) == 22 and

         collision_a::record_value(
             &record_a) == 20 and
         collision_b::record_value(
             &record_b) == 22 and

         collision_a::record_source(
             &record_a) == 1 and
         collision_b::record_source(
             &record_b) == 2 and

         collision_a::wrapper_value(
             &wrapper_a) == 40 and
         collision_b::wrapper_value(
             &wrapper_b) == 44 and

         state_a ==
             collision_a::State.Ready and
         state_b ==
             collision_b::State.Ready and

         result_a ==
             collision_a::ResultKind.Success and
         result_b ==
             collision_b::ResultKind.Success;
}

proc main() -> int {
    if not test_module_identity() { return 1; }
    if not test_values() { return 2; }
    if not test_combined_answer() { return 3; }
    if not test_common_value() { return 4; }
    if not test_answer_part() { return 5; }
    if not test_identity() { return 6; }
    if not test_add() { return 7; }

    if test_cross_module_expression() != 42 { return 8; }
    if test_nested_cross_module_calls() != 42 { return 9; }

    if not test_point_a() { return 10; }
    if not test_point_b() { return 11; }
    if not test_parallel_point_types() { return 12; }
    if not test_point_type_identity() { return 13; }

    if not test_record_a() { return 14; }
    if not test_record_b() { return 15; }
    if not test_parallel_record_types() { return 16; }

    if not test_wrapper_a() { return 17; }
    if not test_wrapper_b() { return 18; }

    if not test_states() { return 19; }
    if not test_state_b_variants() { return 20; }
    if not test_result_kinds() { return 21; }

    if not test_b_only_range() { return 22; }
    if not test_b_only_pair() { return 23; }
    if not test_b_only_nested() { return 24; }
    if not test_b_only_direction() { return 25; }

    if not test_repeated_constant_lookup() { return 26; }
    if not test_alternating_constant_lookup() { return 27; }
    if not test_repeated_proc_lookup() { return 28; }
    if not test_alternating_type_lookup() { return 29; }

    if not test_nested_scope() { return 30; }

    if test_control_flow(true) != 20 { return 31; }
    if test_control_flow(false) != 22 { return 32; }

    if not test_mutation() { return 33; }
    if not test_b_arithmetic_helpers() { return 34; }
    if not test_b_point_operations() { return 35; }
    if not test_b_composition() { return 36; }
    if not test_forwarding() { return 37; }
    if not test_validation() { return 38; }
    if not test_library_self_tests() { return 39; }
    if not test_cross_module_aggregate_composition() { return 40; }
    if not test_integrated_modules() { return 41; }

    return 0;
}