space sema_calls_u64_literal_and_recursion;

proc halve(value: u64) -> u64 {
    let mut remaining: u64 = 1;
    remaining = value / 2;
    return remaining;
}

proc recursive_power(base: i64, exponent: i64) -> i64 {
    if exponent == 0 {
        return 1;
    }

    let half: i64 = recursive_power(base, exponent / 2);
    return half * half;
}

proc twice(exponent: u64) -> u64 {
    return halve(2);
}

export proc main() -> u64 {
    return twice(3);
}
