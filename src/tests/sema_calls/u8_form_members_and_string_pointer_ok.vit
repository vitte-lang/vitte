space sema_calls_u8_form_members_and_string_pointer_ok;

intrinsic io_print(text: *u8);

form Player {
    health: i64,
    marker: u8
}

proc damage(player: &mut Player) {
    player.health = player.health - 1;
}

proc health(player: &Player) -> i64 {
    io_print("player");
    give player.health;
}
