/// Native DAP fixture for conditional breakpoints and repeated logpoints.

space tests::debug::conditional_logpoints;

proc main() -> int {
    let mut index: i64 = 0;
    let mut total: i64 = 0;

    while index < 4 {
        set total = total + index;
        set index = index + 1;
    }

    if total == 6 {
        give 0;
    }
    give 1;
}
