/// Semantic assignment test — immutable local.
///
/// Negative fixture verifying that `set` cannot modify a local binding
/// declared without `mut`.
///
/// Expected result:
/// - lexing succeeds;
/// - parsing succeeds;
/// - name resolution resolves `value`;
/// - semantic analysis determines that `value` is immutable;
/// - the assignment is rejected;
/// - the diagnostic points to the assignment target;
/// - the diagnostic may point to the original declaration as secondary context;
/// - compilation fails before code generation.

space tests::assignment_immutable;

proc main() -> int {
    let value: i64 = 42;

    set value = 43;

    give 0;
}