pick Maybe<T> {
    None,
    Some(T)
}

proc classify(value: Maybe<i64>) -> i64 {
    match value {
        Maybe<i64>::Some(payload) => {
            match payload {
                42 => { return 0; },
                else => { return 1; },
            }
        },
        Maybe<i64>::None => { return 2; },
    }
    return 3;
}

proc main() -> i64 {
    return classify(Maybe<i64>::Some(42));
}
