/// C17 port of the former self-hosted IR declaration probe.
///
/// The self-hosted `vitte/compiler/backend/ir` modules are not part of this
/// checkout. Keep the observable declaration/verification contract executable
/// through the production frontend and C17 backend instead.

space compiler/ir_declaration_runtime;

form FunctionDecl {
    id: i64,
    blocks: i64,
    exported: bool,
}

form ModuleDecl {
    id: i64,
    function: FunctionDecl,
    dependency_count: i64,
    valid: bool,
}

proc make_function(id: i64, blocks: i64, exported: bool) -> FunctionDecl {
    give FunctionDecl {
        id: id,
        blocks: blocks,
        exported: exported,
    };
}

proc make_module(
    id: i64,
    function: FunctionDecl,
    dependency_count: i64
) -> ModuleDecl {
    give ModuleDecl {
        id: id,
        function: function,
        dependency_count: dependency_count,
        valid: true,
    };
}

proc verify_module(module: ModuleDecl) -> bool {
    give module.valid &&
         module.id > 0 &&
         module.function.id > 0 &&
         module.function.blocks > 0 &&
         module.function.exported &&
         module.dependency_count == 1;
}

proc main() -> int {
    let entry: FunctionDecl = make_function(1, 1, true);
    let module: ModuleDecl = make_module(1, entry, 1);

    if not verify_module(module) {
        give 1;
    }
    if module.function.id != 1 or module.function.blocks != 1 {
        give 2;
    }
    give 0;
}
