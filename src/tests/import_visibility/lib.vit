/// Canonical import-visibility test library.
///
/// This module is intentionally broad. It provides public and private
/// declarations across several namespaces so the import-visibility test suite
/// can verify direct imports, glob imports, aliases, re-exports, qualified
/// lookup, type lookup, constructor lookup and visibility filtering.
///
/// Contract:
///
/// - declarations marked `export` are part of the external module surface;
/// - declarations without `export` remain private to this module;
/// - private declarations may be used internally by exported declarations;
/// - importing this module must never expose private implementation details;
/// - glob imports must filter private declarations before scope insertion;
/// - qualified lookup must still enforce declaration visibility;
/// - types and values use the same visibility policy even when they occupy
///   distinct namespaces.
///
/// This library deliberately contains similarly shaped public/private symbols
/// so tests cannot accidentally pass because only one declaration category is
/// implemented.

space tests::import_visibility::lib;

/// --------------------------------------------------------------------------
/// Public constants
/// --------------------------------------------------------------------------

export const PUBLIC_ZERO: i64 = 0;
export const PUBLIC_ONE: i64 = 1;
export const PUBLIC_ANSWER: i64 = 42;
export const PUBLIC_LIMIT: u64 = 128;
export const PUBLIC_MIN_ID: u64 = 1;
export const PUBLIC_MAX_ID: u64 = 1000000;

/// --------------------------------------------------------------------------
/// Private constants
/// --------------------------------------------------------------------------

const PRIVATE_ZERO: i64 = 0;
const PRIVATE_ONE: i64 = 1;
const PRIVATE_ANSWER: i64 = 42;
const PRIVATE_LIMIT: u64 = 256;
const PRIVATE_OFFSET: i64 = 10;
const PRIVATE_MIN_ID: u64 = 1;
const PRIVATE_MAX_ID: u64 = 1000000;

/// --------------------------------------------------------------------------
/// Public forms
/// --------------------------------------------------------------------------

export form PublicPoint {
    x: i64,
    y: i64,
}

export form PublicRange {
    minimum: i64,
    maximum: i64,
}

export form PublicRecord {
    id: u64,
    value: i64,
    enabled: bool,
}

export form PublicPair {
    first: i64,
    second: i64,
}

export form PublicNested {
    point: PublicPoint,
    range: PublicRange,
    record: PublicRecord,
}

/// --------------------------------------------------------------------------
/// Private forms
/// --------------------------------------------------------------------------

form PrivatePoint {
    x: i64,
    y: i64,
}

form PrivateRange {
    minimum: i64,
    maximum: i64,
}

form PrivateRecord {
    id: u64,
    value: i64,
    enabled: bool,
}

form PrivatePair {
    first: i64,
    second: i64,
}

/// --------------------------------------------------------------------------
/// Public picks
/// --------------------------------------------------------------------------

export pick PublicState {
    Idle,
    Ready,
    Running,
    Finished,
}

export pick PublicResultKind {
    Success,
    Failure,
}

/// --------------------------------------------------------------------------
/// Private picks
/// --------------------------------------------------------------------------

pick PrivateState {
    Hidden,
    Internal,
}

pick PrivateResultKind {
    Accepted,
    Rejected,
}

/// --------------------------------------------------------------------------
/// Private helpers
/// --------------------------------------------------------------------------

proc private_identity(value: i64) -> i64 {
    give value;
}

proc private_add(
    left: i64,
    right: i64
) -> i64 {
    give left + right;
}

proc private_subtract(
    left: i64,
    right: i64
) -> i64 {
    give left - right;
}

proc private_multiply(
    left: i64,
    right: i64
) -> i64 {
    give left * right;
}

proc private_valid_identifier(id: u64) -> bool {
    give id >= PRIVATE_MIN_ID &&
         id <= PRIVATE_MAX_ID;
}

proc private_valid_range(
    range: &PrivateRange
) -> bool {
    give range.minimum <= range.maximum;
}

proc private_clamp(
    value: i64,
    minimum: i64,
    maximum: i64
) -> i64 {
    if value < minimum {
        give minimum;
    }

    if value > maximum {
        give maximum;
    }

    give value;
}

proc private_make_point(
    x: i64,
    y: i64
) -> PrivatePoint {
    give PrivatePoint {
        x: x,
        y: y,
    };
}

proc private_make_record(
    id: u64,
    value: i64
) -> PrivateRecord {
    give PrivateRecord {
        id: id,
        value: value,
        enabled: true,
    };
}

/// --------------------------------------------------------------------------
/// Public predicates
/// --------------------------------------------------------------------------

export proc public_is_zero(value: i64) -> bool {
    give value == PUBLIC_ZERO;
}

export proc public_is_positive(value: i64) -> bool {
    give value > 0;
}

export proc public_is_non_negative(value: i64) -> bool {
    give value >= 0;
}

export proc public_valid_identifier(id: u64) -> bool {
    give id >= PUBLIC_MIN_ID &&
         id <= PUBLIC_MAX_ID;
}

export proc public_valid_range(
    range: &PublicRange
) -> bool {
    give range.minimum <= range.maximum;
}

export proc public_value_in_range(
    value: i64,
    range: &PublicRange
) -> bool {
    give public_valid_range(range) &&
         value >= range.minimum &&
         value <= range.maximum;
}

/// --------------------------------------------------------------------------
/// Public arithmetic
/// --------------------------------------------------------------------------

export proc public_identity(value: i64) -> i64 {
    give private_identity(value);
}

export proc public_increment(value: i64) -> i64 {
    give private_add(value, PRIVATE_ONE);
}

export proc public_add(
    left: i64,
    right: i64
) -> i64 {
    give private_add(left, right);
}

export proc public_subtract(
    left: i64,
    right: i64
) -> i64 {
    give private_subtract(left, right);
}

export proc public_multiply(
    left: i64,
    right: i64
) -> i64 {
    give private_multiply(left, right);
}

export proc public_answer() -> i64 {
    give PRIVATE_ANSWER;
}

export proc public_add_offset(value: i64) -> i64 {
    give private_add(value, PRIVATE_OFFSET);
}

export proc public_clamp(
    value: i64,
    minimum: i64,
    maximum: i64
) -> i64 {
    give private_clamp(
        value,
        minimum,
        maximum);
}

/// --------------------------------------------------------------------------
/// Public constructors
/// --------------------------------------------------------------------------

export proc public_make_point(
    x: i64,
    y: i64
) -> PublicPoint {
    give PublicPoint {
        x: x,
        y: y,
    };
}

export proc public_make_range(
    minimum: i64,
    maximum: i64
) -> PublicRange {
    give PublicRange {
        minimum: minimum,
        maximum: maximum,
    };
}

export proc public_make_record(
    id: u64,
    value: i64,
    enabled: bool
) -> PublicRecord {
    give PublicRecord {
        id: id,
        value: value,
        enabled: enabled,
    };
}

export proc public_make_pair(
    first: i64,
    second: i64
) -> PublicPair {
    give PublicPair {
        first: first,
        second: second,
    };
}

/// --------------------------------------------------------------------------
/// Public consumers
/// --------------------------------------------------------------------------

export proc public_point_sum(
    point: &PublicPoint
) -> i64 {
    give point.x + point.y;
}

export proc public_range_width(
    range: &PublicRange
) -> i64 {
    give range.maximum -
         range.minimum;
}

export proc public_record_value(
    record: &PublicRecord
) -> i64 {
    give record.value;
}

export proc public_pair_sum(
    pair: &PublicPair
) -> i64 {
    give pair.first +
         pair.second;
}

/// --------------------------------------------------------------------------
/// Private-type isolation
/// --------------------------------------------------------------------------

/// Uses private types internally.
///
/// External callers only observe a public scalar result. The private type must
/// not leak into the exported signature.
export proc public_private_point_sum(
    x: i64,
    y: i64
) -> i64 {
    let point: PrivatePoint =
        private_make_point(
            x,
            y);

    give point.x + point.y;
}

/// Uses a private record internally without exposing its type.
export proc public_private_record_value(
    id: u64,
    value: i64
) -> i64 {
    let record: PrivateRecord =
        private_make_record(
            id,
            value);

    give record.value;
}

/// Exercises private constants and private functions behind a public API.
export proc public_private_pipeline(
    value: i64
) -> i64 {
    let first: i64 =
        private_identity(value);

    let second: i64 =
        private_add(
            first,
            PRIVATE_OFFSET);

    let third: i64 =
        private_subtract(
            second,
            PRIVATE_OFFSET);

    give third;
}

/// --------------------------------------------------------------------------
/// Public nested values
/// --------------------------------------------------------------------------

export proc public_make_nested(
    id: u64,
    value: i64
) -> PublicNested {
    let point: PublicPoint =
        PublicPoint {
            x: value,
            y: value,
        };

    let range: PublicRange =
        PublicRange {
            minimum: 0,
            maximum: value,
        };

    let record: PublicRecord =
        PublicRecord {
            id: id,
            value: value,
            enabled: true,
        };

    give PublicNested {
        point: point,
        range: range,
        record: record,
    };
}

export proc public_nested_value(
    nested: &PublicNested
) -> i64 {
    give nested.record.value;
}

/// --------------------------------------------------------------------------
/// Public pick handling
/// --------------------------------------------------------------------------

export proc public_default_state() -> PublicState {
    give PublicState.Ready;
}

export proc public_running_state() -> PublicState {
    give PublicState.Running;
}

export proc public_success_kind() -> PublicResultKind {
    give PublicResultKind.Success;
}

/// --------------------------------------------------------------------------
/// Internal private declarations intentionally inaccessible to importers
/// --------------------------------------------------------------------------

proc private_only_proc() -> i64 {
    give PRIVATE_ANSWER;
}

proc private_only_predicate() -> bool {
    give true;
}

proc private_only_record() -> PrivateRecord {
    give PrivateRecord {
        id: PRIVATE_MIN_ID,
        value: PRIVATE_ANSWER,
        enabled: true,
    };
}

proc private_only_range() -> PrivateRange {
    give PrivateRange {
        minimum: 0,
        maximum: PRIVATE_ANSWER,
    };
}

/// --------------------------------------------------------------------------
/// Public calls into private implementation
/// --------------------------------------------------------------------------

/// A public declaration is allowed to depend on a private declaration from
/// its own module.
export proc public_calls_private_proc() -> i64 {
    give private_only_proc();
}

export proc public_calls_private_predicate() -> bool {
    give private_only_predicate();
}

export proc public_uses_private_record() -> i64 {
    let record: PrivateRecord =
        private_only_record();

    give record.value;
}

export proc public_uses_private_range() -> i64 {
    let range: PrivateRange =
        private_only_range();

    if !private_valid_range(&range) {
        give 0;
    }

    give range.maximum;
}

/// --------------------------------------------------------------------------
/// Visibility regression helpers
/// --------------------------------------------------------------------------

/// Public and private declarations deliberately contain similar names.
///
/// This helps detect incorrect prefix matching or visibility-table lookup.
export proc visible_symbol() -> i64 {
    give 42;
}

proc visible_symbol_private() -> i64 {
    give 84;
}

export const VISIBLE_VALUE: i64 = 42;
const VISIBLE_VALUE_PRIVATE: i64 = 84;

export form VisibleForm {
    value: i64,
}

form VisibleFormPrivate {
    value: i64,
}

/// --------------------------------------------------------------------------
/// Library self-check
/// --------------------------------------------------------------------------

/// Internal consistency check.
///
/// This is exported so positive import tests can verify that an imported
/// public procedure can transitively use the complete private implementation
/// of its defining module.
export proc library_self_test() -> bool {
    let point: PublicPoint =
        public_make_point(
            20,
            22);

    let range: PublicRange =
        public_make_range(
            0,
            100);

    let record: PublicRecord =
        public_make_record(
            42,
            42,
            true);

    let pair: PublicPair =
        public_make_pair(
            20,
            22);

    let nested: PublicNested =
        public_make_nested(
            42,
            42);

    let private_record: PrivateRecord =
        private_make_record(
            42,
            42);

    let private_range: PrivateRange =
        PrivateRange {
            minimum: 0,
            maximum: 42,
        };

    give public_answer() == 42 &&
         public_identity(42) == 42 &&
         public_increment(41) == 42 &&
         public_add(20, 22) == 42 &&
         public_subtract(100, 58) == 42 &&
         public_multiply(6, 7) == 42 &&
         public_point_sum(&point) == 42 &&
         public_range_width(&range) == 100 &&
         public_record_value(&record) == 42 &&
         public_pair_sum(&pair) == 42 &&
         public_nested_value(&nested) == 42 &&
         public_private_point_sum(20, 22) == 42 &&
         public_private_record_value(42, 42) == 42 &&
         public_private_pipeline(42) == 42 &&
         private_record.value == 42 &&
         private_valid_identifier(private_record.id) &&
         private_valid_range(&private_range) &&
         public_calls_private_proc() == 42 &&
         public_calls_private_predicate() &&
         public_uses_private_record() == 42 &&
         public_uses_private_range() == 42 &&
         visible_symbol() == 42 &&
         VISIBLE_VALUE == 42;
}