/// Module-qualified import visibility test.
///
/// Positive test for importing `lib` as a module and accessing its visible
/// declarations through explicit module qualification.
///
/// This test intentionally avoids glob imports. Every external declaration is
/// referenced through `lib::*`, ensuring that module lookup and member
/// resolution are exercised independently from glob symbol injection.
///
/// Expected result:
/// - `lib` resolves as an imported module;
/// - visible constants resolve through `lib`;
/// - visible forms resolve in type positions;
/// - visible form constructors resolve through `lib`;
/// - visible procedures resolve through `lib`;
/// - values of imported types can cross procedure boundaries;
/// - references to imported forms remain valid;
/// - member access works after qualified construction;
/// - repeated qualified lookup is deterministic;
/// - local declarations do not interfere with module members;
/// - semantic analysis completes without visibility diagnostics;
/// - compilation succeeds.

space tests::import_visibility::module_ok;

use tests::import_visibility::lib as lib;
/// Verify qualified access to exported constants.
proc test_constants() -> bool {
    let minimum: u64 = lib::PUBLIC_MIN_ID;
    let maximum: u64 = lib::PUBLIC_MAX_ID;
    let default_value: u64 = lib::PUBLIC_LIMIT;

    return minimum <= default_value and
         default_value <= maximum;
}

/// Verify that an imported form can be referenced as a type and constructed
/// through its module-qualified name.
proc test_record_construction() -> bool {
    let record: lib::PublicRecord =
        lib::PublicRecord {
            id: 42,
            value: 100,
            enabled: true,
        };

    return record.id == 42 and
         record.value == 100 and
         record.enabled;
}

/// Verify an imported form in a procedure parameter.
proc inspect_record(
    record: &lib::PublicRecord
) -> bool {
    return record.enabled and
         record.id > 0;
}

/// Verify imported types crossing local procedure boundaries.
proc test_record_reference() -> bool {
    let record: lib::PublicRecord =
        lib::PublicRecord {
            id: 7,
            value: 42,
            enabled: true,
        };

    return inspect_record(&record);
}

/// Verify construction of another imported aggregate.
proc test_range() -> bool {
    let range: lib::PublicRange =
        lib::PublicRange {
            minimum: 10,
            maximum: 100,
        };

    return range.minimum == 10 and
         range.maximum == 100;
}

/// Verify ordinary qualified procedure calls.
proc test_predicates() -> bool {
    return lib::public_valid_identifier(0) and
         lib::public_valid_identifier(42) and
         lib::public_valid_identifier(100);
}

/// Verify a qualified procedure returning a scalar.
proc test_identity() -> bool {
    let value: i64 =
        lib::public_identity(42);

    return value == 42;
}

/// Verify several calls to the same imported procedure.
proc test_repeated_call() -> bool {
    let first: i64 =
        lib::public_identity(10);

    let second: i64 =
        lib::public_identity(20);

    let third: i64 =
        lib::public_identity(12);

    return first + second + third == 42;
}

/// Verify qualified arithmetic helpers.
proc test_arithmetic() -> bool {
    let sum: i64 =
        lib::public_add(20, 22);

    let difference: i64 =
        lib::public_subtract(100, 58);

    let product: i64 =
        lib::public_multiply(6, 7);

    return sum == 42 and
         difference == 42 and
         product == 42;
}

/// Verify a procedure returning an imported form.
proc test_factory() -> bool {
    let record: lib::PublicRecord =
        lib::public_make_record(
            42,
            100,
            true);

    return record.id == 42 and
         record.value == 100 and
         record.enabled;
}

/// Verify that an imported procedure can accept an imported form.
proc test_record_consumer() -> bool {
    let record: lib::PublicRecord =
        lib::public_make_record(
            10,
            42,
            true);

    let value: i64 =
        lib::public_record_value(&record);

    return value == 42;
}

/// Verify qualified range helpers.
proc test_range_helpers() -> bool {
    let range: lib::PublicRange =
        lib::PublicRange {
            minimum: 0,
            maximum: 100,
        };

    return lib::public_valid_range(&range) and
         lib::public_value_in_range(0, &range) and
         lib::public_value_in_range(42, &range) and
         lib::public_value_in_range(100, &range);
}

/// Verify imported type + imported function + local binding composition.
proc test_composition() -> bool {
    let range: lib::PublicRange =
        lib::PublicRange {
            minimum: 0,
            maximum: 100,
        };

    let record: lib::PublicRecord =
        lib::public_make_record(
            100,
            lib::public_add(20, 22),
            true);

    return lib::public_value_in_range(
             record.value,
             &range) and
         lib::public_record_value(&record) == 42;
}

/// Verify that local names do not shadow module-qualified members.
proc test_local_shadowing() -> bool {
    let identity: i64 = 10;
    let add: i64 = 20;
    let PublicRecord: i64 = 12;

    let imported: i64 =
        lib::public_identity(
            lib::public_add(identity, PublicRecord));

    return add == 20 and
         imported == 22;
}

/// Verify repeated lookup of the module itself.
///
/// Each expression forces another qualified lookup and should resolve to the
/// same imported module and declaration set.
proc test_repeated_module_resolution() -> bool {
    return lib::public_identity(1) == 1 and
         lib::public_identity(2) == 2 and
         lib::public_identity(3) == 3 and
         lib::public_identity(4) == 4 and
         lib::public_identity(5) == 5;
}

/// Verify an imported form returned by one imported function and consumed by
/// another imported function.
proc test_round_trip() -> bool {
    let source: lib::PublicRecord =
        lib::public_make_record(
            77,
            42,
            true);

    let value: i64 =
        lib::public_record_value(&source);

    let destination: lib::PublicRecord =
        lib::public_make_record(
            source.id,
            value,
            source.enabled);

    return destination.id == source.id and
         destination.value == source.value and
         destination.enabled == source.enabled;
}

/// Verify imported declarations inside control flow.
proc test_control_flow() -> bool {
    let value: i64 =
        lib::public_identity(42);

    if lib::public_valid_identifier(42) {
        return lib::public_add(value, 0) == 42;
    }

    return false;
}

/// Verify several qualified declarations in one expression tree.
proc test_expression_resolution() -> bool {
    return lib::public_add(
               lib::public_identity(10),
               lib::public_add(
                   lib::public_identity(20),
                   lib::public_identity(12))) == 42;
}

/// Verify the complete module-qualified path through several operations.
proc test_integrated_path() -> bool {
    let range: lib::PublicRange =
        lib::PublicRange {
            minimum: 0,
            maximum: 100,
        };

    let computed: i64 =
        lib::public_add(
            lib::public_identity(20),
            lib::public_identity(22));

    let record: lib::PublicRecord =
        lib::public_make_record(
            42,
            computed,
            true);

    if not lib::public_valid_range(&range) {
        return false;
    }

    if not lib::public_value_in_range(
        record.value,
        &range) {
        return false;
    }

    if lib::public_record_value(&record) != 42 {
        return false;
    }

    return record.id == 42 and
         record.enabled;
}

/// Positive test entry point.
///
/// Every non-zero result identifies the first module-import behavior that
/// failed at runtime.
proc main() -> int {
    if not test_constants() {
        return 1;
    }

    if not test_record_construction() {
        return 2;
    }

    if not test_record_reference() {
        return 3;
    }

    if not test_range() {
        return 4;
    }

    if not test_predicates() {
        return 5;
    }

    if not test_identity() {
        return 6;
    }

    if not test_repeated_call() {
        return 7;
    }

    if not test_arithmetic() {
        return 8;
    }

    if not test_factory() {
        return 9;
    }

    if not test_record_consumer() {
        return 10;
    }

    if not test_range_helpers() {
        return 11;
    }

    if not test_composition() {
        return 12;
    }

    if not test_local_shadowing() {
        return 13;
    }

    if not test_repeated_module_resolution() {
        return 14;
    }

    if not test_round_trip() {
        return 15;
    }

    if not test_control_flow() {
        return 16;
    }

    if not test_expression_resolution() {
        return 17;
    }

    if not test_integrated_path() {
        return 18;
    }

    return 0;
}