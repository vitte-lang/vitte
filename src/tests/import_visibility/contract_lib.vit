/// Import visibility contract library.
///
/// This module exercises contract-related declarations across module
/// boundaries. It deliberately exposes several forms of contract-bearing
/// procedures so import resolution, name resolution, semantic analysis,
/// contract checking, generic resolution and visibility can be tested.
///
/// The declarations cover:
/// - simple preconditions;
/// - multiple preconditions;
/// - postconditions;
/// - precondition/postcondition combinations;
/// - value and reference parameters;
/// - forms used by contracts;
/// - generic procedures;
/// - nested calls between contracted procedures;
/// - boolean predicates intended for imported callers;
/// - boundary values and arithmetic relations.

space tests::import_visibility::contract_lib;

export const MIN_IDENTIFIER: u64 = 1;
export const MAX_IDENTIFIER: u64 = 1000000;
export const DEFAULT_LIMIT: u64 = 128;

export form ContractRecord {
    id: u64,
    value: i64,
    enabled: bool,
}

export form ContractRange {
    minimum: i64,
    maximum: i64,
}

export form ContractResult {
    value: i64,
    valid: bool,
}

export proc valid_identifier(id: u64) -> bool {
    return id >= MIN_IDENTIFIER and id <= MAX_IDENTIFIER;
}

export proc valid_limit(limit: u64) -> bool {
    return limit > 0 and limit <= DEFAULT_LIMIT;
}

export proc valid_range(range: &ContractRange) -> bool {
    return range.minimum <= range.maximum;
}

export proc value_in_range(
    value: i64,
    range: &ContractRange
) -> bool {
    return value >= range.minimum and
         value <= range.maximum;
}

export proc positive(value: i64) -> bool {
    return value > 0;
}

export proc non_negative(value: i64) -> bool {
    return value >= 0;
}

export proc checked_identity(value: i64) -> i64
    requires non_negative(value);
    ensures result == value;
{
    return value;
}

export proc checked_increment(value: i64) -> i64
    requires value >= 0;
    ensures result > value;
{
    return value + 1;
}

export proc checked_add(
    left: i64,
    right: i64
) -> i64
    requires left >= 0;
    requires right >= 0;
    ensures result >= left;
    ensures result >= right;
{
    return left + right;
}

export proc checked_subtract(
    left: i64,
    right: i64
) -> i64
    requires left >= right;
    ensures result >= 0;
{
    return left - right;
}

export proc checked_multiply(
    left: i64,
    right: i64
) -> i64
    requires left >= 0;
    requires right >= 0;
    ensures result >= 0;
{
    return left * right;
}

export proc checked_clamp(
    value: i64,
    range: &ContractRange
) -> i64
    requires valid_range(range);
    ensures result >= range.minimum;
    ensures result <= range.maximum;
{
    if value < range.minimum {
        return range.minimum;
    }

    if value > range.maximum {
        return range.maximum;
    }

    return value;
}

export proc checked_record(
    id: u64,
    value: i64
) -> ContractRecord
    requires valid_identifier(id);
    requires non_negative(value);
    ensures result.id == id;
    ensures result.value == value;
    ensures result.enabled;
{
    return ContractRecord {
        id: id,
        value: value,
        enabled: true,
    };
}

export proc checked_record_value(
    record: &ContractRecord
) -> i64
    requires valid_identifier(record.id);
    requires record.enabled;
    ensures result == record.value;
{
    return record.value;
}

export proc checked_result(
    value: i64
) -> ContractResult
    requires non_negative(value);
    ensures result.value == value;
    ensures result.valid;
{
    return ContractResult {
        value: value,
        valid: true,
    };
}

export proc checked_chain(
    value: i64
) -> i64
    requires non_negative(value);
    ensures result >= value;
{
    let first: i64 = checked_identity(value);
    let second: i64 = checked_increment(first);

    return checked_add(second, 1);
}

export proc checked_bounded_add(
    left: i64,
    right: i64,
    range: &ContractRange
) -> i64
    requires non_negative(left);
    requires non_negative(right);
    requires valid_range(range);
    ensures result >= range.minimum;
    ensures result <= range.maximum;
{
    let value: i64 = checked_add(left, right);

    return checked_clamp(value, range);
}

export proc checked_select(
    condition: bool,
    first: i64,
    second: i64
) -> i64
    requires non_negative(first);
    requires non_negative(second);
    ensures result == first or result == second;
{
    if condition {
        return first;
    }

    return second;
}

export proc checked_limit(
    value: u64,
    limit: u64
) -> u64
    requires valid_limit(limit);
    ensures result <= limit;
{
    if value > limit {
        return limit;
    }

    return value;
}

export proc contract_library_self_test() -> bool {
    let range: ContractRange = ContractRange {
        minimum: 0,
        maximum: 100,
    };

    let record: ContractRecord =
        checked_record(42, 10);

    let value: i64 =
        checked_bounded_add(
            record.value,
            20,
            &range);

    return valid_identifier(record.id) and
         valid_range(&range) and
         value_in_range(value, &range) and
         value == 30;
}
/// Private declarations retained for negative visibility checks.
const PRIVATE_IDENTIFIER: u64 = 1;
const PRIVATE_LIMIT: u64 = 128;

form PrivateContractRange {
    minimum: i64,
    maximum: i64,
}

proc private_valid_identifier(id: u64) -> bool {
    return id >= PRIVATE_IDENTIFIER;
}

proc private_checked_add(left: i64, right: i64) -> i64 {
    return left + right;
}
