///
/// Verifies that a glob import never exposes declarations that are private to
/// the imported module.
///
/// Expected result:
/// - module resolution succeeds;
/// - the glob import itself is valid;
/// - private constants are not injected;
/// - private forms and constructors are not injected;
/// - private procedures and predicates are not injected;
/// - contract-bearing private procedures remain private;
/// - compilation fails during import/name/visibility resolution;
/// - no private declaration becomes visible because `*` was used.

space tests::import_visibility::glob_private;

use tests::import_visibility::contract_lib::*;
proc access_private_constant() -> u64 {
    return PRIVATE_IDENTIFIER;
}

proc access_another_private_constant() -> u64 {
    return PRIVATE_LIMIT;
}

proc accept_private_form(
    value: &PrivateContractRange
) -> bool {
    return value.minimum <= value.maximum;
}

proc construct_private_range() -> i64 {
    let range: PrivateContractRange =
        PrivateContractRange {
            minimum: 0,
            maximum: 100,
        };

    return range.maximum;
}

proc construct_private_record() -> u64 {
    let record: ContractRecord =
        ContractRecord {
            id: 42,
            value: 100,
            enabled: true,
        };

    return record.id;
}

proc construct_private_result() -> i64 {
    let result: ContractResult =
        ContractResult {
            value: 42,
            valid: true,
        };

    return result.value;
}

proc call_private_predicate() -> bool {
    return private_valid_identifier(42);
}

proc call_private_range_predicates() -> bool {
    let range: PrivateContractRange =
        PrivateContractRange {
            minimum: 0,
            maximum: 100,
        };

    return valid_range(&range) and
         value_in_range(42, &range);
}

proc call_private_contract_proc() -> i64 {
    return private_checked_add(20, 22);
}

proc call_private_chain() -> i64 {
    return checked_chain(40);
}

proc obtain_private_record() -> i64 {
    let record: ContractRecord =
        checked_record(42, 100);

    return record.value;
}

proc reference_private_form() -> i64 {
    let range: PrivateContractRange =
        PrivateContractRange {
            minimum: 10,
            maximum: 50,
        };

    let reference: &PrivateContractRange =
        &range;

    return reference.maximum;
}

proc repeated_private_symbol() -> u64 {
    let first: u64 = PRIVATE_LIMIT;
    let second: u64 = PRIVATE_LIMIT;
    let third: u64 = PRIVATE_LIMIT;

    return first + second + third;
}

proc mixed_private_access() -> bool {
    let range: PrivateContractRange =
        PrivateContractRange {
            minimum: 0,
            maximum: 100,
        };

    let record: ContractRecord =
        ContractRecord {
            id: PRIVATE_IDENTIFIER,
            value: 42,
            enabled: true,
        };

    return private_valid_identifier(record.id) and
         valid_range(&range) and
         value_in_range(record.value, &range);
}

proc main() -> int {
    let minimum: u64 = access_private_constant();
    let limit: u64 = access_another_private_constant();
    let maximum: i64 = construct_private_range();
    let identifier: u64 = construct_private_record();
    let result_value: i64 = construct_private_result();
    let predicate: bool = call_private_predicate();
    let predicates: bool = call_private_range_predicates();
    let arithmetic: i64 = call_private_contract_proc();
    let chained: i64 = call_private_chain();
    let record_value: i64 = obtain_private_record();
    let referenced: i64 = reference_private_form();
    let repeated: u64 = repeated_private_symbol();
    let mixed: bool = mixed_private_access();

    if predicate and
       predicates and
       mixed and
       minimum > 0 and
       limit > 0 and
       maximum == 100 and
       identifier == 42 and
       result_value == 42 and
       arithmetic == 42 and
       chained == 42 and
       record_value == 100 and
       referenced == 50 and
       repeated > 0 {
        return 0;
    }

    return 1;
}
