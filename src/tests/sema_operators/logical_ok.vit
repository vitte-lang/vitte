/// Semantic operator coverage — logical operators.
///
/// Positive exhaustive fixture for boolean logical semantics.
///
/// Coverage:
/// - unary logical negation `!`;
/// - binary logical AND `&&`;
/// - binary logical OR `||`;
/// - every boolean truth-table combination;
/// - precedence between `!`, `&&`, and `||`;
/// - explicit grouping;
/// - logical expressions in variable initializers;
/// - logical expressions in assignments;
/// - logical expressions in procedure arguments;
/// - logical expressions in return expressions;
/// - logical expressions in `if`;
/// - logical expressions in `while`;
/// - nested lexical scopes;
/// - parameters and local variables;
/// - procedure-call operands;
/// - comparison operands producing `bool`;
/// - equality operands producing `bool`;
/// - arithmetic comparisons feeding logical operators;
/// - deeply nested logical expressions;
/// - repeated operands;
/// - mutation combined with logical expressions;
/// - short-circuit-compatible expressions;
/// - boolean identity laws;
/// - De Morgan laws;
/// - distributive laws;
/// - absorption laws;
/// - associativity;
/// - commutativity;
/// - double negation;
/// - implication/equivalence constructions;
/// - large mixed expressions.
///
/// Every operand of `!`, `&&`, and `||` has type `bool`.
///
/// Expected result:
/// - lexing succeeds;
/// - parsing succeeds;
/// - name resolution succeeds;
/// - semantic analysis succeeds;
/// - `!bool` has type `bool`;
/// - `bool && bool` has type `bool`;
/// - `bool || bool` has type `bool`;
/// - operator precedence is preserved;
/// - compilation succeeds;
/// - execution returns 0.

space tests::sema_operators::logical_ok;

const TRUE_VALUE: bool = true;
const FALSE_VALUE: bool = false;

const ZERO: i64 = 0;
const ONE: i64 = 1;
const TWO: i64 = 2;
const TEN: i64 = 10;
const TWENTY: i64 = 20;
const TWENTY_TWO: i64 = 22;
const FORTY_TWO: i64 = 42;
const ONE_HUNDRED: i64 = 100;

proc identity_bool(
    value: bool
) -> bool {
    return value;
}

proc logical_not(
    value: bool
) -> bool {
    return not value;
}

proc logical_and(
    left: bool,
    right: bool
) -> bool {
    return left and right;
}

proc logical_or(
    left: bool,
    right: bool
) -> bool {
    return left or right;
}

proc logical_nand(
    left: bool,
    right: bool
) -> bool {
    return not (left and right);
}

proc logical_nor(
    left: bool,
    right: bool
) -> bool {
    return not (left or right);
}

proc logical_xor(
    left: bool,
    right: bool
) -> bool {
    return (left or right) and
         not (left and right);
}

proc logical_xnor(
    left: bool,
    right: bool
) -> bool {
    return (left and right) or
         (not left and not right);
}

proc logical_implies(
    left: bool,
    right: bool
) -> bool {
    return not left or right;
}

proc logical_equivalent(
    left: bool,
    right: bool
) -> bool {
    return (left and right) or
         (not left and not right);
}

proc always_true() -> bool {
    return true;
}

proc always_false() -> bool {
    return false;
}

proc is_zero(
    value: i64
) -> bool {
    return value == ZERO;
}

proc is_positive(
    value: i64
) -> bool {
    return value > ZERO;
}

proc is_negative(
    value: i64
) -> bool {
    return value < ZERO;
}

proc is_answer(
    value: i64
) -> bool {
    return value == FORTY_TWO;
}

proc less_than(
    left: i64,
    right: i64
) -> bool {
    return left < right;
}

proc less_equal(
    left: i64,
    right: i64
) -> bool {
    return left <= right;
}

proc greater_than(
    left: i64,
    right: i64
) -> bool {
    return left > right;
}

proc greater_equal(
    left: i64,
    right: i64
) -> bool {
    return left >= right;
}

proc equal_i64(
    left: i64,
    right: i64
) -> bool {
    return left == right;
}

proc not_equal_i64(
    left: i64,
    right: i64
) -> bool {
    return left != right;
}

proc between_inclusive(
    value: i64,
    minimum: i64,
    maximum: i64
) -> bool {
    return value >= minimum and
         value <= maximum;
}

proc between_exclusive(
    value: i64,
    minimum: i64,
    maximum: i64
) -> bool {
    return value > minimum and
         value < maximum;
}

proc outside_range(
    value: i64,
    minimum: i64,
    maximum: i64
) -> bool {
    return value < minimum or
         value > maximum;
}

proc test_boolean_constants() -> bool {
    return TRUE_VALUE and
         not FALSE_VALUE;
}

proc test_literal_not() -> bool {
    return not false and
         not not true and
         not not not false and
         not not not not true;
}

proc test_variable_not() -> bool {
    let yes: bool = true;
    let no: bool = false;

    return not no and
         not not yes and
         not not not no and
         not not not not yes;
}

proc test_not_truth_table() -> bool {
    return not false and
         not (not true);
}

proc test_and_truth_table() -> bool {
    let tt: bool =
        true and true;

    let tf: bool =
        true and false;

    let ft: bool =
        false and true;

    let ff: bool =
        false and false;

    return tt and
         not tf and
         not ft and
         not ff;
}

proc test_or_truth_table() -> bool {
    let tt: bool =
        true or true;

    let tf: bool =
        true or false;

    let ft: bool =
        false or true;

    let ff: bool =
        false or false;

    return tt and
         tf and
         ft and
         not ff;
}

proc test_nand_truth_table() -> bool {
    return not logical_nand(true, true) and
         logical_nand(true, false) and
         logical_nand(false, true) and
         logical_nand(false, false);
}

proc test_nor_truth_table() -> bool {
    return not logical_nor(true, true) and
         not logical_nor(true, false) and
         not logical_nor(false, true) and
         logical_nor(false, false);
}

proc test_xor_truth_table() -> bool {
    return not logical_xor(false, false) and
         logical_xor(false, true) and
         logical_xor(true, false) and
         not logical_xor(true, true);
}

proc test_xnor_truth_table() -> bool {
    return logical_xnor(false, false) and
         not logical_xnor(false, true) and
         not logical_xnor(true, false) and
         logical_xnor(true, true);
}

proc test_implication_truth_table() -> bool {
    return logical_implies(false, false) and
         logical_implies(false, true) and
         not logical_implies(true, false) and
         logical_implies(true, true);
}

proc test_equivalence_truth_table() -> bool {
    return logical_equivalent(false, false) and
         not logical_equivalent(false, true) and
         not logical_equivalent(true, false) and
         logical_equivalent(true, true);
}

proc test_and_variables(
    left: bool,
    right: bool
) -> bool {
    let result: bool =
        left and right;

    return result ==
         logical_and(left, right);
}

proc test_or_variables(
    left: bool,
    right: bool
) -> bool {
    let result: bool =
        left or right;

    return result ==
         logical_or(left, right);
}

proc test_parameter_negation(
    value: bool
) -> bool {
    return logical_not(value) ==
         not value;
}

proc test_precedence_not_and() -> bool {
    let first: bool =
        not false and true;

    let second: bool =
        not (false and true);

    let third: bool =
        not true and false;

    let fourth: bool =
        not (true and false);

    return first and
         second and
         not third and
         fourth;
}

proc test_precedence_not_or() -> bool {
    let first: bool =
        not false or false;

    let second: bool =
        not (false or false);

    let third: bool =
        not true or false;

    let fourth: bool =
        not (true or false);

    return first and
         second and
         not third and
         not fourth;
}

proc test_precedence_and_or() -> bool {
    let first: bool =
        true or false and false;

    let second: bool =
        (true or false) and false;

    let third: bool =
        false and false or true;

    let fourth: bool =
        false and (false or true);

    return first and
         not second and
         third and
         not fourth;
}

proc test_precedence_full() -> bool {
    let value: bool =
        not false and
        false or
        true and
        not false;

    return value;
}

proc test_grouping() -> bool {
    let a: bool =
        (true or false) and
        (true or false);

    let b: bool =
        not (true and false);

    let c: bool =
        not (false or false);

    let d: bool =
        (true and true) or
        (false and false);

    return a and
         b and
         c and
         d;
}

proc test_double_negation(
    value: bool
) -> bool {
    return not not value == value;
}

proc test_triple_negation(
    value: bool
) -> bool {
    return not not not value == not value;
}

proc test_and_identity(
    value: bool
) -> bool {
    return (value and true) == value and
         (true and value) == value;
}

proc test_or_identity(
    value: bool
) -> bool {
    return (value or false) == value and
         (false or value) == value;
}

proc test_and_annihilator(
    value: bool
) -> bool {
    return not (value and false) and
         not (false and value);
}

proc test_or_annihilator(
    value: bool
) -> bool {
    return (value or true) and
         (true or value);
}

proc test_idempotence(
    value: bool
) -> bool {
    return (value and value) == value and
         (value or value) == value;
}

proc test_complement(
    value: bool
) -> bool {
    return not (value and not value) and
         (value or not value);
}

proc test_and_commutative(
    left: bool,
    right: bool
) -> bool {
    return (left and right) ==
         (right and left);
}

proc test_or_commutative(
    left: bool,
    right: bool
) -> bool {
    return (left or right) ==
         (right or left);
}

proc test_and_associative(
    a: bool,
    b: bool,
    c: bool
) -> bool {
    return ((a and b) and c) ==
         (a and (b and c));
}

proc test_or_associative(
    a: bool,
    b: bool,
    c: bool
) -> bool {
    return ((a or b) or c) ==
         (a or (b or c));
}

proc test_and_distributes_over_or(
    a: bool,
    b: bool,
    c: bool
) -> bool {
    return (a and (b or c)) ==
         ((a and b) or (a and c));
}

proc test_or_distributes_over_and(
    a: bool,
    b: bool,
    c: bool
) -> bool {
    return (a or (b and c)) ==
         ((a or b) and (a or c));
}

proc test_and_absorption(
    a: bool,
    b: bool
) -> bool {
    return (a and (a or b)) == a;
}

proc test_or_absorption(
    a: bool,
    b: bool
) -> bool {
    return (a or (a and b)) == a;
}

proc test_de_morgan_and(
    a: bool,
    b: bool
) -> bool {
    return not (a and b) ==
         (not a or not b);
}

proc test_de_morgan_or(
    a: bool,
    b: bool
) -> bool {
    return not (a or b) ==
         (not a and not b);
}

proc test_comparison_and() -> bool {
    return FORTY_TWO > ZERO and
         FORTY_TWO < ONE_HUNDRED;
}

proc test_comparison_or() -> bool {
    return FORTY_TWO < ZERO or
         FORTY_TWO == FORTY_TWO;
}

proc test_comparison_negation() -> bool {
    return not (FORTY_TWO < ZERO) and
         not (FORTY_TWO > ONE_HUNDRED) and
         not (FORTY_TWO != FORTY_TWO);
}

proc test_mixed_comparisons() -> bool {
    return TWENTY < TWENTY_TWO and
         TWENTY_TWO <= FORTY_TWO and
         FORTY_TWO >= TWENTY_TWO and
         FORTY_TWO > TWENTY and
         TWENTY != TWENTY_TWO and
         FORTY_TWO == FORTY_TWO;
}

proc test_arithmetic_comparison_logical() -> bool {
    return (TWENTY + TWENTY_TWO == FORTY_TWO) and
         (FORTY_TWO - TWENTY == TWENTY_TWO) and
         (TWENTY * TWO == 40) and
         (FORTY_TWO + 58 == ONE_HUNDRED);
}

proc test_call_operands() -> bool {
    return always_true() and
         not always_false() and
         identity_bool(true) and
         not identity_bool(false);
}

proc test_nested_call_operands() -> bool {
    return logical_and(
               logical_or(
                   false,
                   true),
               logical_not(false)) and
         logical_or(
             logical_and(
                 true,
                 true),
             logical_and(
                 false,
                 true));
}

proc test_predicate_operands() -> bool {
    return is_answer(FORTY_TWO) and
         is_positive(FORTY_TWO) and
         not is_negative(FORTY_TWO) and
         not is_zero(FORTY_TWO) and
         is_zero(ZERO);
}

proc test_range_predicates() -> bool {
    return between_inclusive(
               FORTY_TWO,
               ZERO,
               ONE_HUNDRED) and
         between_exclusive(
             FORTY_TWO,
             ZERO,
             ONE_HUNDRED) and
         not outside_range(
             FORTY_TWO,
             ZERO,
             ONE_HUNDRED) and
         outside_range(
             -1,
             ZERO,
             ONE_HUNDRED) and
         outside_range(
             101,
             ZERO,
             ONE_HUNDRED);
}

proc test_relational_helpers() -> bool {
    return less_than(
               TWENTY,
               TWENTY_TWO) and
         less_equal(
             TWENTY,
             TWENTY) and
         greater_than(
             TWENTY_TWO,
             TWENTY) and
         greater_equal(
             TWENTY_TWO,
             TWENTY_TWO) and
         equal_i64(
             FORTY_TWO,
             FORTY_TWO) and
         not_equal_i64(
             TWENTY,
             TWENTY_TWO);
}

proc return_logical_expression(
    left: bool,
    right: bool,
    fallback: bool
) -> bool {
    return left and right or
         fallback;
}

proc test_return_expression() -> bool {
    return return_logical_expression(
               true,
               true,
               false) and
         return_logical_expression(
             false,
             true,
             true) and
         not return_logical_expression(
             false,
             true,
             false);
}

proc accept_bool(
    value: bool
) -> bool {
    return value;
}

proc test_logical_as_argument() -> bool {
    return accept_bool(
               true and true) and
         accept_bool(
             true or false) and
         accept_bool(
             not false) and
         accept_bool(
             (TWENTY < TWENTY_TWO) and
             (FORTY_TWO == FORTY_TWO));
}

proc test_logical_initializer() -> bool {
    let first: bool =
        true and true;

    let second: bool =
        false or true;

    let third: bool =
        not false;

    let fourth: bool =
        first and
        second and
        third;

    return fourth;
}

proc test_logical_assignment() -> bool {
    let mut value: bool =
        false;

    set value =
        true and true;

    if not value {
        return false;
    }

    set value =
        value and false;

    if value {
        return false;
    }

    set value =
        value or true;

    return value;
}

proc test_negated_assignment() -> bool {
    let mut value: bool =
        false;

    set value =
        not value;

    if not value {
        return false;
    }

    set value =
        not value;

    return not value;
}

proc test_if_condition() -> bool {
    let left: bool = true;
    let right: bool = true;

    if left and right {
        return true;
    }

    return false;
}

proc test_if_or_condition() -> bool {
    let left: bool = false;
    let right: bool = true;

    if left or right {
        return true;
    }

    return false;
}

proc test_if_negated_condition() -> bool {
    let value: bool = false;

    if not value {
        return true;
    }

    return false;
}

proc test_if_complex_condition() -> bool {
    let value: i64 = FORTY_TWO;

    if value > ZERO and
       value <= ONE_HUNDRED and
       value != ZERO {
        return true;
    }

    return false;
}

proc test_nested_if() -> bool {
    let a: bool = true;
    let b: bool = true;
    let c: bool = false;

    if a and b {
        if not c {
            if a or c {
                return true;
            }
        }
    }

    return false;
}

proc test_if_else_style_flow(
    value: bool
) -> bool {
    if value {
        return true;
    }

    if not value {
        return true;
    }

    return false;
}

proc test_while_condition() -> bool {
    let mut index: i64 = ZERO;
    let mut valid: bool = true;

    while index < FORTY_TWO and
          valid {
        set index =
            index + ONE;

        set valid =
            index <= FORTY_TWO;
    }

    return index == FORTY_TWO and
         valid;
}

proc test_while_negated_condition() -> bool {
    let mut done: bool = false;
    let mut value: i64 = ZERO;

    while not done {
        set value =
            value + ONE;

        if value == FORTY_TWO {
            set done = true;
        }
    }

    return done and
         value == FORTY_TWO;
}

proc test_while_or_condition() -> bool {
    let mut left: bool = true;
    let mut right: bool = false;
    let mut count: i64 = ZERO;

    while left or right {
        set count =
            count + ONE;

        if count == ONE {
            set left = false;
            set right = true;
        }

        if count == TWO {
            set right = false;
        }
    }

    return count == TWO and
         not left and
         not right;
}

proc test_nested_scope() -> bool {
    let outer: bool = true;
    let mut result: bool = false;

    {
        let middle: bool = true;

        {
            let inner: bool = false;

            set result =
                outer and
                middle and
                not inner;
        }
    }

    return result;
}

proc test_parameter_scope(
    a: bool,
    b: bool,
    c: bool
) -> bool {
    let first: bool =
        a and b;

    let second: bool =
        not c;

    return first and
         second;
}

proc test_repeated_operand_lookup() -> bool {
    let value: bool = true;

    return value and
         value and
         value and
         value and
         value;
}

proc test_alternating_operand_lookup() -> bool {
    let yes: bool = true;
    let no: bool = false;

    return yes and
         not no and
         yes and
         not no and
         yes and
         not no;
}

proc test_short_circuit_shape_and() -> bool {
    return false and
         (FORTY_TWO < ZERO) ==
             false;
}

proc test_short_circuit_shape_or() -> bool {
    return true or
         (FORTY_TWO < ZERO);
}

proc test_false_and_expression() -> bool {
    let result: bool =
        false and
        is_answer(FORTY_TWO);

    return not result;
}

proc test_true_or_expression() -> bool {
    let result: bool =
        true or
        is_zero(FORTY_TWO);

    return result;
}

proc test_chain_and() -> bool {
    return true and
         true and
         true and
         true and
         true and
         true and
         true and
         true;
}

proc test_chain_or() -> bool {
    return false or
         false or
         false or
         false or
         false or
         false or
         false or
         true;
}

proc test_chain_mixed() -> bool {
    return true and
         true or
         false and
         false or
         not false and
         true;
}

proc test_deep_negation() -> bool {
    return not not not not not not not not true;
}

proc test_deep_grouping() -> bool {
    return (((true and
             (true or false)) and
            (not false or false)) and
           ((true and true) or
            (false and false)));
}

proc test_deep_mixed_expression() -> bool {
    let a: bool = true;
    let b: bool = false;
    let c: bool = true;
    let d: bool = false;

    return
        (
            (a and not b) or
            (not a and b)
        ) and
        (
            (c or d) and
            not (d and not c)
        ) and
        (
            (a and c) or
            (b and d)
        );
}

proc test_comparison_expression_tree() -> bool {
    let a: i64 = TEN;
    let b: i64 = TWENTY;
    let c: i64 = TWENTY_TWO;
    let d: i64 = FORTY_TWO;

    return
        (a < b and b < d) and
        (c > b and c <= d) and
        (d >= c and d != ZERO) and
        not (a > d or b > d);
}

proc test_boolean_equality() -> bool {
    let a: bool = true;
    let b: bool = false;

    return (a == true) and
         (b == false) and
         (a != b) and
         ((a and not b) == true) and
         ((a or b) == true);
}

proc test_boolean_expression_equality() -> bool {
    return (true and true) ==
             (false or true) and
         (not false) ==
             (true or false) and
         (true and false) ==
             (false and true);
}

proc test_all_binary_combinations() -> bool {
    let a: bool = false;
    let b: bool = true;

    return
        not (a and a) and
        not (a and b) and
        not (b and a) and
        (b and b) and

        not (a or a) and
        (a or b) and
        (b or a) and
        (b or b);
}

proc test_all_negated_binary_combinations() -> bool {
    let a: bool = false;
    let b: bool = true;

    return
        not a and
        not (not b) and
        not (a and b) and
        not (b and a) and
        not (not a and not b) and
        (not a or b) and
        (b or not b);
}

proc test_demorgan_all_combinations() -> bool {
    return
        test_de_morgan_and(false, false) and
        test_de_morgan_and(false, true) and
        test_de_morgan_and(true, false) and
        test_de_morgan_and(true, true) and

        test_de_morgan_or(false, false) and
        test_de_morgan_or(false, true) and
        test_de_morgan_or(true, false) and
        test_de_morgan_or(true, true);
}

proc test_commutativity_all_combinations() -> bool {
    return
        test_and_commutative(false, false) and
        test_and_commutative(false, true) and
        test_and_commutative(true, false) and
        test_and_commutative(true, true) and

        test_or_commutative(false, false) and
        test_or_commutative(false, true) and
        test_or_commutative(true, false) and
        test_or_commutative(true, true);
}

proc test_identity_all_combinations() -> bool {
    return
        test_and_identity(false) and
        test_and_identity(true) and
        test_or_identity(false) and
        test_or_identity(true) and
        test_and_annihilator(false) and
        test_and_annihilator(true) and
        test_or_annihilator(false) and
        test_or_annihilator(true) and
        test_idempotence(false) and
        test_idempotence(true) and
        test_complement(false) and
        test_complement(true);
}

proc test_associativity_samples() -> bool {
    return
        test_and_associative(
            false,
            false,
            false) and
        test_and_associative(
            true,
            true,
            true) and
        test_and_associative(
            true,
            false,
            true) and
        test_and_associative(
            false,
            true,
            true) and

        test_or_associative(
            false,
            false,
            false) and
        test_or_associative(
            true,
            true,
            true) and
        test_or_associative(
            true,
            false,
            true) and
        test_or_associative(
            false,
            true,
            true);
}

proc test_distributivity_samples() -> bool {
    return
        test_and_distributes_over_or(
            false,
            false,
            false) and
        test_and_distributes_over_or(
            true,
            false,
            true) and
        test_and_distributes_over_or(
            true,
            true,
            false) and
        test_and_distributes_over_or(
            true,
            true,
            true) and

        test_or_distributes_over_and(
            false,
            false,
            false) and
        test_or_distributes_over_and(
            true,
            false,
            true) and
        test_or_distributes_over_and(
            false,
            true,
            true) and
        test_or_distributes_over_and(
            true,
            true,
            true);
}

proc test_absorption_samples() -> bool {
    return
        test_and_absorption(
            false,
            false) and
        test_and_absorption(
            false,
            true) and
        test_and_absorption(
            true,
            false) and
        test_and_absorption(
            true,
            true) and

        test_or_absorption(
            false,
            false) and
        test_or_absorption(
            false,
            true) and
        test_or_absorption(
            true,
            false) and
        test_or_absorption(
            true,
            true);
}

proc test_local_shadowing() -> bool {
    let value: bool = true;
    let mut result: bool = false;

    {
        let value: bool = false;

        set result =
            not value;
    }

    return value and
         result;
}

proc test_parameter_shadowing(
    value: bool
) -> bool {
    let mut result: bool =
        value;

    {
        let value: bool =
            false;

        set result =
            result and
            not value;
    }

    return result;
}

proc test_mutation_pipeline() -> bool {
    let mut a: bool = false;
    let mut b: bool = true;
    let mut c: bool = false;

    set a =
        not a;

    set c =
        a and b;

    set b =
        not b;

    return a and
         not b and
         c;
}

proc test_boolean_accumulator() -> bool {
    let mut index: i64 = ZERO;
    let mut valid: bool = true;

    while index < FORTY_TWO and
          valid {
        set valid =
            valid and
            index >= ZERO and
            index < FORTY_TWO;

        set index =
            index + ONE;
    }

    return valid and
         index == FORTY_TWO;
}

proc test_nested_boolean_accumulator() -> bool {
    let mut index: i64 = ZERO;
    let mut valid: bool = true;

    while index < TEN and
          valid {
        let even_or_odd_is_valid: bool =
            index >= ZERO and
            index < TEN;

        set valid =
            valid and
            even_or_odd_is_valid;

        set index =
            index + ONE;
    }

    return valid and
         index == TEN;
}

proc test_call_chain(
    a: bool,
    b: bool,
    c: bool
) -> bool {
    return logical_and(
        logical_or(
            a,
            b),
        logical_not(c));
}

proc test_call_chain_cases() -> bool {
    return
        test_call_chain(
            true,
            false,
            false) and
        test_call_chain(
            false,
            true,
            false) and
        not test_call_chain(
            false,
            false,
            false) and
        not test_call_chain(
            true,
            true,
            true);
}

proc test_implication_identity(
    a: bool,
    b: bool
) -> bool {
    return logical_implies(a, b) ==
         (not a or b);
}

proc test_implication_cases() -> bool {
    return
        test_implication_identity(
            false,
            false) and
        test_implication_identity(
            false,
            true) and
        test_implication_identity(
            true,
            false) and
        test_implication_identity(
            true,
            true);
}

proc test_equivalence_identity(
    a: bool,
    b: bool
) -> bool {
    return logical_equivalent(a, b) ==
         not logical_xor(a, b);
}

proc test_equivalence_cases() -> bool {
    return
        test_equivalence_identity(
            false,
            false) and
        test_equivalence_identity(
            false,
            true) and
        test_equivalence_identity(
            true,
            false) and
        test_equivalence_identity(
            true,
            true);
}

proc test_complex_parameter_expression(
    a: bool,
    b: bool,
    c: bool,
    d: bool
) -> bool {
    return
        ((a or b) and (not c or d)) or
        ((not a and c) and (b or not d));
}

proc test_complex_parameter_cases() -> bool {
    return
        test_complex_parameter_expression(
            true,
            false,
            false,
            false) and
        test_complex_parameter_expression(
            false,
            true,
            false,
            false) and
        not test_complex_parameter_expression(
            false,
            false,
            false,
            false);
}

proc test_comparison_call_pipeline() -> bool {
    let first: bool =
        less_than(
            TWENTY,
            TWENTY_TWO);

    let second: bool =
        equal_i64(
            TWENTY + TWENTY_TWO,
            FORTY_TWO);

    let third: bool =
        greater_equal(
            FORTY_TWO,
            TWENTY_TWO);

    return logical_and(
        first,
        logical_and(
            second,
            third));
}

proc test_logical_result_reuse() -> bool {
    let first: bool =
        true and true;

    let second: bool =
        first or false;

    let third: bool =
        not second;

    let fourth: bool =
        not third and first;

    return first and
         second and
         not third and
         fourth;
}

proc test_nested_initializer_tree() -> bool {
    let value: bool =
        (
            (
                true and
                not false
            ) or
            (
                false and
                true
            )
        ) and
        (
            not (
                false or
                false
            )
        );

    return value;
}

proc test_large_expression() -> bool {
    let a: bool = true;
    let b: bool = false;
    let c: bool = true;
    let d: bool = false;
    let e: bool = true;
    let f: bool = false;

    return
        (a and not b) and
        (c or d) and
        (not f and e) and
        ((a and c) or (b and d)) and
        (not (b or d)) and
        ((a or b) and (c or d)) and
        ((e and a) or f) and
        not ((b and c) or (d and e));
}

proc integrated_logical_test() -> bool {
    let a: bool =
        is_answer(FORTY_TWO);

    let b: bool =
        between_inclusive(
            FORTY_TWO,
            ZERO,
            ONE_HUNDRED);

    let c: bool =
        outside_range(
            FORTY_TWO,
            ZERO,
            ONE_HUNDRED);

    let d: bool =
        less_than(
            TWENTY,
            TWENTY_TWO);

    let e: bool =
        equal_i64(
            TWENTY + TWENTY_TWO,
            FORTY_TWO);

    return
        a and
        b and
        not c and
        d and
        e and
        logical_and(a, b) and
        logical_or(c, d) and
        logical_not(c) and
        logical_implies(a, b) and
        logical_equivalent(d, e);
}

