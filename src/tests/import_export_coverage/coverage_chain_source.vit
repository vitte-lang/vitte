/// Import/export coverage — source module.
///
/// Root module for the coverage chain:
///
///     coverage_chain_source
///              ↓
///       coverage_chain_mid
///              ↓
///       coverage_chain_main
///
/// This fixture owns the declarations consumed by the middle module.
///
/// Coverage:
/// - exported constants;
/// - private constants;
/// - exported forms;
/// - private forms;
/// - exported picks;
/// - private picks;
/// - exported procedures;
/// - private procedures;
/// - references to exported forms;
/// - internal use of private declarations;
/// - aggregate construction;
/// - nested aggregates;
/// - control flow;
/// - mutable locals;
/// - repeated symbol lookup;
/// - declaration visibility.
///
/// Observable identity:
/// - SOURCE_ID == 10;
/// - SOURCE_VALUE == 42;
/// - SOURCE_ANSWER == 42;
/// - SOURCE_LIMIT == 100.
///
/// This module is valid by itself.

space tests::import_export_coverage::coverage_chain_source;

export const SOURCE_ID: i64 = 10;
export const SOURCE_ZERO: i64 = 0;
export const SOURCE_ONE: i64 = 1;
export const SOURCE_TWO: i64 = 2;
export const SOURCE_TEN: i64 = 10;
export const SOURCE_TWENTY: i64 = 20;
export const SOURCE_TWENTY_TWO: i64 = 22;
export const SOURCE_VALUE: i64 = 42;
export const SOURCE_ANSWER: i64 = 42;
export const SOURCE_LIMIT: i64 = 100;
export const SOURCE_ENABLED: bool = true;
export const SOURCE_DISABLED: bool = false;

const PRIVATE_OFFSET: i64 = 2;
const PRIVATE_MULTIPLIER: i64 = 2;
const PRIVATE_SOURCE_MARKER: i64 = 1001;

export form SourcePoint {
    x: i64,
    y: i64,
}

export form SourceRange {
    minimum: i64,
    maximum: i64,
}

export form SourceRecord {
    value: i64,
    source: i64,
    enabled: bool,
}

export form SourcePair {
    first: i64,
    second: i64,
}

export form SourceWrapper {
    point: SourcePoint,
    record: SourceRecord,
}

export form SourceNested {
    point: SourcePoint,
    range: SourceRange,
    record: SourceRecord,
    pair: SourcePair,
}

form PrivateBox {
    value: i64,
}

form PrivateMetadata {
    marker: i64,
    source: i64,
}

export pick SourceState {
    Idle,
    Ready,
    Running,
    Finished,
}

export pick SourceResult {
    Success,
    Failure,
}

export pick SourceDirection {
    Left,
    Right,
}

pick PrivateState {
    Valid,
    Invalid,
}

proc private_identity(
    value: i64
) -> i64 {
    return value;
}

proc private_add(
    left: i64,
    right: i64
) -> i64 {
    return left + right;
}

proc private_subtract(
    left: i64,
    right: i64
) -> i64 {
    return left - right;
}

proc private_make_box(
    value: i64
) -> PrivateBox {
    return PrivateBox {
        value: value,
    };
}

proc private_box_value(
    box: &PrivateBox
) -> i64 {
    return box.value;
}

proc private_make_metadata() -> PrivateMetadata {
    return PrivateMetadata {
        marker: PRIVATE_SOURCE_MARKER,
        source: SOURCE_ID,
    };
}

proc private_metadata_valid(
    metadata: &PrivateMetadata
) -> bool {
    return metadata.marker ==
             PRIVATE_SOURCE_MARKER and
         metadata.source ==
             SOURCE_ID;
}

proc private_state() -> PrivateState {
    return PrivateState.Valid;
}

proc private_is_valid_state(
    state: PrivateState
) -> bool {
    return state ==
         PrivateState.Valid;
}

export proc identity(
    value: i64
) -> i64 {
    return value;
}

export proc add(
    left: i64,
    right: i64
) -> i64 {
    return left + right;
}

export proc subtract(
    left: i64,
    right: i64
) -> i64 {
    return left - right;
}

export proc multiply(
    left: i64,
    right: i64
) -> i64 {
    return left * right;
}

export proc increment(
    value: i64
) -> i64 {
    return value + SOURCE_ONE;
}

export proc decrement(
    value: i64
) -> i64 {
    return value - SOURCE_ONE;
}

export proc source_id() -> i64 {
    return SOURCE_ID;
}

export proc source_value() -> i64 {
    return SOURCE_VALUE;
}

export proc source_answer() -> i64 {
    return SOURCE_ANSWER;
}

export proc source_limit() -> i64 {
    return SOURCE_LIMIT;
}

export proc is_zero(
    value: i64
) -> bool {
    return value == SOURCE_ZERO;
}

export proc is_positive(
    value: i64
) -> bool {
    return value > SOURCE_ZERO;
}

export proc is_source_value(
    value: i64
) -> bool {
    return value == SOURCE_VALUE;
}

export proc within_limit(
    value: i64
) -> bool {
    return value >= SOURCE_ZERO and
         value <= SOURCE_LIMIT;
}

export proc make_point(
    x: i64,
    y: i64
) -> SourcePoint {
    return SourcePoint {
        x: x,
        y: y,
    };
}

export proc make_default_point() -> SourcePoint {
    return make_point(
        SOURCE_TWENTY,
        SOURCE_TWENTY_TWO);
}

export proc point_x(
    point: &SourcePoint
) -> i64 {
    return point.x;
}

export proc point_y(
    point: &SourcePoint
) -> i64 {
    return point.y;
}

export proc point_sum(
    point: &SourcePoint
) -> i64 {
    return point.x +
         point.y;
}

export proc point_equal(
    left: &SourcePoint,
    right: &SourcePoint
) -> bool {
    return left.x == right.x and
         left.y == right.y;
}

export proc point_translate(
    point: &SourcePoint,
    dx: i64,
    dy: i64
) -> SourcePoint {
    return SourcePoint {
        x: point.x + dx,
        y: point.y + dy,
    };
}

export proc point_scale(
    point: &SourcePoint,
    factor: i64
) -> SourcePoint {
    return SourcePoint {
        x: point.x * factor,
        y: point.y * factor,
    };
}

export proc make_range(
    minimum_value: i64,
    maximum_value: i64
) -> SourceRange {
    return SourceRange {
        minimum: minimum_value,
        maximum: maximum_value,
    };
}

export proc make_default_range() -> SourceRange {
    return make_range(
        SOURCE_ZERO,
        SOURCE_VALUE);
}

export proc range_minimum(
    range: &SourceRange
) -> i64 {
    return range.minimum;
}

export proc range_maximum(
    range: &SourceRange
) -> i64 {
    return range.maximum;
}

export proc range_width(
    range: &SourceRange
) -> i64 {
    return range.maximum -
         range.minimum;
}

export proc range_valid(
    range: &SourceRange
) -> bool {
    return range.minimum <=
         range.maximum;
}

export proc range_contains(
    range: &SourceRange,
    value: i64
) -> bool {
    return value >= range.minimum and
         value <= range.maximum;
}

export proc make_record(
    value: i64
) -> SourceRecord {
    return SourceRecord {
        value: value,
        source: SOURCE_ID,
        enabled: SOURCE_ENABLED,
    };
}

export proc make_default_record() -> SourceRecord {
    return make_record(
        SOURCE_VALUE);
}

export proc record_value(
    record: &SourceRecord
) -> i64 {
    return record.value;
}

export proc record_source(
    record: &SourceRecord
) -> i64 {
    return record.source;
}

export proc record_enabled(
    record: &SourceRecord
) -> bool {
    return record.enabled;
}

export proc record_valid(
    record: &SourceRecord
) -> bool {
    return record.source == SOURCE_ID and
         record.enabled;
}

export proc make_pair(
    first: i64,
    second: i64
) -> SourcePair {
    return SourcePair {
        first: first,
        second: second,
    };
}

export proc make_default_pair() -> SourcePair {
    return make_pair(
        SOURCE_TWENTY,
        SOURCE_TWENTY_TWO);
}

export proc pair_sum(
    pair: &SourcePair
) -> i64 {
    return pair.first +
         pair.second;
}

export proc make_wrapper(
    point: SourcePoint,
    record: SourceRecord
) -> SourceWrapper {
    return SourceWrapper {
        point: point,
        record: record,
    };
}

export proc make_default_wrapper() -> SourceWrapper {
    let point: SourcePoint =
        make_default_point();

    let record: SourceRecord =
        make_default_record();

    return make_wrapper(
        point,
        record);
}

export proc wrapper_point_sum(
    wrapper: &SourceWrapper
) -> i64 {
    return point_sum(
        &wrapper.point);
}

export proc wrapper_record_value(
    wrapper: &SourceWrapper
) -> i64 {
    return record_value(
        &wrapper.record);
}

export proc wrapper_source(
    wrapper: &SourceWrapper
) -> i64 {
    return record_source(
        &wrapper.record);
}

export proc wrapper_value(
    wrapper: &SourceWrapper
) -> i64 {
    return wrapper_point_sum(wrapper) +
         wrapper_record_value(wrapper);
}

export proc make_nested(
    point: SourcePoint,
    range: SourceRange,
    record: SourceRecord,
    pair: SourcePair
) -> SourceNested {
    return SourceNested {
        point: point,
        range: range,
        record: record,
        pair: pair,
    };
}

export proc make_default_nested() -> SourceNested {
    let point: SourcePoint =
        make_default_point();

    let range: SourceRange =
        make_default_range();

    let record: SourceRecord =
        make_default_record();

    let pair: SourcePair =
        make_default_pair();

    return make_nested(
        point,
        range,
        record,
        pair);
}

export proc nested_point_sum(
    nested: &SourceNested
) -> i64 {
    return point_sum(
        &nested.point);
}

export proc nested_range_width(
    nested: &SourceNested
) -> i64 {
    return range_width(
        &nested.range);
}

export proc nested_record_value(
    nested: &SourceNested
) -> i64 {
    return record_value(
        &nested.record);
}

export proc nested_pair_sum(
    nested: &SourceNested
) -> i64 {
    return pair_sum(
        &nested.pair);
}

export proc nested_source(
    nested: &SourceNested
) -> i64 {
    return record_source(
        &nested.record);
}

export proc default_state() -> SourceState {
    return SourceState.Idle;
}

export proc ready_state() -> SourceState {
    return SourceState.Ready;
}

export proc running_state() -> SourceState {
    return SourceState.Running;
}

export proc finished_state() -> SourceState {
    return SourceState.Finished;
}

export proc success_result() -> SourceResult {
    return SourceResult.Success;
}

export proc failure_result() -> SourceResult {
    return SourceResult.Failure;
}

export proc left_direction() -> SourceDirection {
    return SourceDirection.Left;
}

export proc right_direction() -> SourceDirection {
    return SourceDirection.Right;
}

export proc conditional_value(
    enabled: bool
) -> i64 {
    if enabled {
        return SOURCE_VALUE;
    }

    return SOURCE_ZERO;
}

export proc normalize_to_value(
    value: i64
) -> i64 {
    if value == SOURCE_VALUE {
        return value;
    }

    if value < SOURCE_VALUE {
        return add(
            value,
            subtract(
                SOURCE_VALUE,
                value));
    }

    return subtract(
        value,
        subtract(
            value,
            SOURCE_VALUE));
}

export proc accumulate_value() -> i64 {
    let mut index: i64 =
        SOURCE_ZERO;

    let mut result: i64 =
        SOURCE_ZERO;

    while index < SOURCE_TWO {
        set result =
            add(
                result,
                21);

        set index =
            increment(index);
    }

    return result;
}

export proc composed_value() -> i64 {
    return add(
        SOURCE_TWENTY,
        SOURCE_TWENTY_TWO);
}

export proc nested_call_value() -> i64 {
    return identity(
        add(
            identity(SOURCE_TWENTY),
            identity(SOURCE_TWENTY_TWO)));
}

export proc private_pipeline() -> i64 {
    let first: i64 =
        private_identity(
            SOURCE_TWENTY);

    let second: i64 =
        private_add(
            first,
            SOURCE_TWENTY_TWO);

    return private_identity(
        second);
}

export proc private_offset_value() -> i64 {
    return private_add(
        SOURCE_TWENTY,
        SOURCE_TWENTY +
            PRIVATE_OFFSET);
}

export proc private_multiplier_value() -> i64 {
    return private_subtract(
        SOURCE_VALUE *
            PRIVATE_MULTIPLIER,
        SOURCE_VALUE);
}

export proc private_box_pipeline() -> i64 {
    let box: PrivateBox =
        private_make_box(
            SOURCE_VALUE);

    return private_box_value(
        &box);
}

export proc private_metadata_pipeline() -> bool {
    let metadata: PrivateMetadata =
        private_make_metadata();

    return private_metadata_valid(
        &metadata);
}

export proc private_state_pipeline() -> bool {
    let state: PrivateState =
        private_state();

    return private_is_valid_state(
        state);
}

export proc forward_point(
    point: &SourcePoint
) -> i64 {
    return point_sum(point);
}

export proc forward_range(
    range: &SourceRange
) -> i64 {
    return range_width(range);
}

export proc forward_record(
    record: &SourceRecord
) -> i64 {
    return record_value(record);
}

export proc forward_pair(
    pair: &SourcePair
) -> i64 {
    return pair_sum(pair);
}

export proc forward_wrapper(
    wrapper: &SourceWrapper
) -> i64 {
    return wrapper_value(wrapper);
}

export proc forward_nested(
    nested: &SourceNested
) -> i64 {
    return nested_point_sum(nested);
}

export proc validate_point(
    point: &SourcePoint
) -> bool {
    return point_sum(point) ==
         SOURCE_VALUE;
}

export proc validate_range(
    range: &SourceRange
) -> bool {
    return range_valid(range) and
         range_width(range) ==
             SOURCE_VALUE;
}

export proc validate_record(
    record: &SourceRecord
) -> bool {
    return record_value(record) ==
             SOURCE_VALUE and
         record_source(record) ==
             SOURCE_ID and
         record_enabled(record);
}

export proc validate_pair(
    pair: &SourcePair
) -> bool {
    return pair_sum(pair) ==
         SOURCE_VALUE;
}

export proc validate_wrapper(
    wrapper: &SourceWrapper
) -> bool {
    return wrapper_point_sum(wrapper) ==
             SOURCE_VALUE and
         wrapper_record_value(wrapper) ==
             SOURCE_VALUE and
         wrapper_source(wrapper) ==
             SOURCE_ID;
}

export proc validate_nested(
    nested: &SourceNested
) -> bool {
    return nested_point_sum(nested) ==
             SOURCE_VALUE and
         nested_range_width(nested) ==
             SOURCE_VALUE and
         nested_record_value(nested) ==
             SOURCE_VALUE and
         nested_pair_sum(nested) ==
             SOURCE_VALUE and
         nested_source(nested) ==
             SOURCE_ID;
}

export proc repeated_lookup_test() -> bool {
    return SOURCE_VALUE == 42 and
         SOURCE_VALUE == 42 and
         SOURCE_VALUE == 42 and
         SOURCE_ID == 10 and
         SOURCE_ID == 10 and
         identity(SOURCE_VALUE) == 42 and
         identity(SOURCE_VALUE) == 42 and
         source_value() == 42 and
         source_value() == 42;
}

export proc aggregate_self_test() -> bool {
    let point: SourcePoint =
        make_default_point();

    let range: SourceRange =
        make_default_range();

    let record: SourceRecord =
        make_default_record();

    let pair: SourcePair =
        make_default_pair();

    let wrapper: SourceWrapper =
        make_wrapper(
            point,
            record);

    let nested: SourceNested =
        make_nested(
            point,
            range,
            record,
            pair);

    return validate_point(&point) and
         validate_range(&range) and
         validate_record(&record) and
         validate_pair(&pair) and
         validate_wrapper(&wrapper) and
         validate_nested(&nested);
}

export proc visibility_self_test() -> bool {
    return private_pipeline() == 42 and
         private_offset_value() == 42 and
         private_multiplier_value() == 42 and
         private_box_pipeline() == 42 and
         private_metadata_pipeline() and
         private_state_pipeline();
}

export proc library_self_test() -> bool {
    let point: SourcePoint =
        make_default_point();

    let translated: SourcePoint =
        point_translate(
            &point,
            SOURCE_ONE,
            -SOURCE_ONE);

    let scale_source: SourcePoint =
        make_point(
            3,
            4);

    let scaled: SourcePoint =
        point_scale(
            &scale_source,
            6);

    let range: SourceRange =
        make_default_range();

    let record: SourceRecord =
        make_default_record();

    let pair: SourcePair =
        make_default_pair();

    let wrapper: SourceWrapper =
        make_default_wrapper();

    let nested: SourceNested =
        make_default_nested();

    let idle: SourceState =
        default_state();

    let ready: SourceState =
        ready_state();

    let running: SourceState =
        running_state();

    let finished: SourceState =
        finished_state();

    let success: SourceResult =
        success_result();

    let failure: SourceResult =
        failure_result();

    let left: SourceDirection =
        left_direction();

    let right: SourceDirection =
        right_direction();

    return SOURCE_ID == 10 and
         SOURCE_ZERO == 0 and
         SOURCE_ONE == 1 and
         SOURCE_TWO == 2 and
         SOURCE_TEN == 10 and
         SOURCE_TWENTY == 20 and
         SOURCE_TWENTY_TWO == 22 and
         SOURCE_VALUE == 42 and
         SOURCE_ANSWER == 42 and
         SOURCE_LIMIT == 100 and
         SOURCE_ENABLED and
         not SOURCE_DISABLED and

         identity(42) == 42 and
         add(20, 22) == 42 and
         subtract(100, 58) == 42 and
         multiply(6, 7) == 42 and
         increment(41) == 42 and
         decrement(43) == 42 and

         source_id() == 10 and
         source_value() == 42 and
         source_answer() == 42 and
         source_limit() == 100 and

         is_zero(0) and
         is_positive(42) and
         is_source_value(42) and
         within_limit(42) and

         point_x(&point) == 20 and
         point_y(&point) == 22 and
         point_sum(&point) == 42 and
         point_equal(&point, &point) and
         point_sum(&translated) == 42 and
         point_sum(&scaled) == 42 and

         range_minimum(&range) == 0 and
         range_maximum(&range) == 42 and
         range_width(&range) == 42 and
         range_valid(&range) and
         range_contains(&range, 0) and
         range_contains(&range, 21) and
         range_contains(&range, 42) and
         not range_contains(&range, 43) and

         record_value(&record) == 42 and
         record_source(&record) == 10 and
         record_enabled(&record) and
         record_valid(&record) and

         pair_sum(&pair) == 42 and

         wrapper_point_sum(&wrapper) == 42 and
         wrapper_record_value(&wrapper) == 42 and
         wrapper_source(&wrapper) == 10 and
         wrapper_value(&wrapper) == 84 and

         nested_point_sum(&nested) == 42 and
         nested_range_width(&nested) == 42 and
         nested_record_value(&nested) == 42 and
         nested_pair_sum(&nested) == 42 and
         nested_source(&nested) == 10 and

         idle == SourceState.Idle and
         ready == SourceState.Ready and
         running == SourceState.Running and
         finished == SourceState.Finished and
         success == SourceResult.Success and
         failure == SourceResult.Failure and
         left == SourceDirection.Left and
         right == SourceDirection.Right and

         conditional_value(true) == 42 and
         conditional_value(false) == 0 and
         normalize_to_value(0) == 42 and
         normalize_to_value(42) == 42 and
         normalize_to_value(100) == 42 and
         accumulate_value() == 42 and
         composed_value() == 42 and
         nested_call_value() == 42 and

         forward_point(&point) == 42 and
         forward_range(&range) == 42 and
         forward_record(&record) == 42 and
         forward_pair(&pair) == 42 and
         forward_wrapper(&wrapper) == 84 and
         forward_nested(&nested) == 42 and

         validate_point(&point) and
         validate_range(&range) and
         validate_record(&record) and
         validate_pair(&pair) and
         validate_wrapper(&wrapper) and
         validate_nested(&nested) and

         repeated_lookup_test() and
         aggregate_self_test() and
         visibility_self_test();
}