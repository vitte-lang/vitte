proc test_aggregate_control_flow(
    choose_first: bool
) -> bool {
    let first: Point =
        make_answer_point();

    let second: Point =
        make_zero_point();

    if choose_first {
        return point_sum(
            &first) == FORTY_TWO;
    }

    return point_sum(
        &second) == ZERO;
}

proc test_nested_control_flow() -> bool {
    let nested: Nested =
        make_answer_nested();

    if nested.record.enabled and
       nested.range.minimum == ZERO {
        if nested.point.x == TWENTY and
           nested.point.y == TWENTY_TWO {
            if nested.pair.first +
               nested.pair.second == FORTY_TWO {
                return true;
            }
        }
    }

    return false;
}

proc test_aggregate_runtime_pipeline() -> bool {
    let base: Point =
        make_point(
            TEN,
            TEN);

    let translated: Point =
        point_translate(
            &base,
            TEN,
            12);

    let copied: Point =
        point_copy(
            &translated);

    let swapped: Point =
        point_swap(
            &copied);

    let range: Range =
        make_range(
            ZERO,
            point_sum(
                &swapped));

    let record: Record =
        make_record(
            SEVEN,
            range_width(
                &range),
            true);

    let pair: Pair =
        make_pair(
            swapped.y,
            swapped.x);

    let nested: Nested =
        make_nested(
            swapped,
            range,
            record,
            pair);

    return point_sum(&base) == TWENTY and
         point_sum(&translated) == FORTY_TWO and
         point_sum(&copied) == FORTY_TWO and
         point_sum(&swapped) == FORTY_TWO and
         range_width(&range) == FORTY_TWO and
         record_value(&record) == FORTY_TWO and
         pair_sum(&pair) == FORTY_TWO and
         nested_valid(&nested);
}

proc test_independent_nested_values() -> bool {
    let answer: Nested =
        make_answer_nested();

    let zero: Nested =
        make_nested(
            make_zero_point(),
            make_range(ZERO, ZERO),
            make_record(ZERO, ZERO, false),
            make_pair(ZERO, ZERO));

    return nested_point_sum(&answer) == FORTY_TWO and
         nested_point_sum(&zero) == ZERO and
         nested_record_value(&answer) == FORTY_TWO and
         nested_record_value(&zero) == ZERO and
         answer.record.enabled and
         not zero.record.enabled;
}

proc test_field_values_survive_calls() -> bool {
    let point: Point =
        make_point(
            TWENTY,
            TWENTY_TWO);

    let before_x: i64 =
        point.x;

    let before_y: i64 =
        point.y;

    let sum: i64 =
        point_sum(
            &point);

    let product: i64 =
        point_product(
            &point);

    return before_x == TWENTY and
         before_y == TWENTY_TWO and
         sum == FORTY_TWO and
         product == 440 and
         point.x == TWENTY and
         point.y == TWENTY_TWO;
}

proc test_multiple_references() -> bool {
    let point: Point =
        make_answer_point();

    let first: &Point =
        &point;

    let second: &Point =
        &point;

    return first.x == second.x and
         first.y == second.y and
         point_sum(first) == FORTY_TWO and
         point_sum(second) == FORTY_TWO;
}

proc test_aggregate_values_in_expressions() -> bool {
    let first: Point =
        make_point(
            TEN,
            TEN);

    let second: Point =
        make_point(
            TEN,
            12);

    return point_sum(&first) +
         point_sum(&second) ==
         FORTY_TWO;
}

proc test_nested_values_in_expressions() -> bool {
    let nested: Nested =
        make_answer_nested();

    return nested.point.x +
         nested.point.y ==
             FORTY_TWO and
         nested.range.maximum -
         nested.range.minimum ==
             FORTY_TWO and
         nested.record.value ==
             FORTY_TWO and
         nested.pair.first +
         nested.pair.second ==
             FORTY_TWO;
}

proc test_aggregate_boolean_expression() -> bool {
    let point: Point =
        make_answer_point();

    let range: Range =
        make_answer_range();

    let record: Record =
        make_answer_record();

    return point.x == TWENTY and
         point.y == TWENTY_TWO and
         range.minimum == ZERO and
         range.maximum == FORTY_TWO and
         record.value == FORTY_TWO and
         record.enabled;
}

proc test_constructor_from_call_results() -> bool {
    let point: Point =
        make_point(
            identity(TWENTY),
            add(TWENTY, TWO));

    let pair: Pair =
        make_pair(
            point_x(&point),
            point_y(&point));

    return point_sum(&point) == FORTY_TWO and
         pair_sum(&pair) == FORTY_TWO;
}

proc test_constructor_from_aggregate_fields() -> bool {
    let source: Point =
        make_answer_point();

    let pair: Pair =
        make_pair(
            source.x,
            source.y);

    let target: Point =
        make_point(
            pair.first,
            pair.second);

    return point_equal(
        &source,
        &target);
}

proc test_cross_aggregate_pipeline() -> bool {
    let point: Point =
        make_answer_point();

    let range: Range =
        make_range(
            ZERO,
            point_sum(&point));

    let record: Record =
        make_record(
            SEVEN,
            range_width(&range),
            true);

    let pair: Pair =
        make_pair(
            point.x,
            point.y);

    return point_sum(&point) == FORTY_TWO and
         range_width(&range) == FORTY_TWO and
         record_value(&record) == FORTY_TWO and
         pair_sum(&pair) == FORTY_TWO;
}

proc test_full_nested_pipeline() -> bool {
    let point: Point =
        make_answer_point();

    let range: Range =
        make_answer_range();

    let record: Record =
        make_answer_record();

    let pair: Pair =
        make_answer_pair();

    let nested: Nested =
        make_nested(
            point,
            range,
            record,
            pair);

    let envelope: Envelope =
        make_envelope(
            nested,
            FORTY_TWO);

    let deep: DeepEnvelope =
        make_deep_envelope(
            envelope,
            point);

    return nested_valid(&nested) and
         envelope_valid(&envelope) and
         deep_envelope_valid(&deep) and
         deep.envelope.nested.point.x == TWENTY and
         deep.envelope.nested.point.y == TWENTY_TWO and
         deep.envelope.nested.range.maximum == FORTY_TWO and
         deep.envelope.nested.record.value == FORTY_TWO and
         deep.envelope.nested.pair.first == TWENTY and
         deep.envelope.nested.pair.second == TWENTY_TWO and
         deep.envelope.marker == FORTY_TWO and
         deep.fallback.x == TWENTY and
         deep.fallback.y == TWENTY_TWO;
}

proc test_all_answer_aggregates() -> bool {
    let point: Point =
        make_answer_point();

    let range: Range =
        make_answer_range();

    let pair: Pair =
        make_answer_pair();

    let record: Record =
        make_answer_record();

    let rectangle: Rectangle =
        make_answer_rectangle();

    let segment: Segment =
        make_answer_segment();

    let nested: Nested =
        make_answer_nested();

    let envelope: Envelope =
        make_answer_envelope();

    let deep: DeepEnvelope =
        make_answer_deep_envelope();

    let state: AggregateState =
        make_answer_state();

    let bundle: AggregateBundle =
        make_answer_bundle();

    return point_sum(&point) == FORTY_TWO and
         range_width(&range) == FORTY_TWO and
         pair_sum(&pair) == FORTY_TWO and
         record_value(&record) == FORTY_TWO and
         rectangle_perimeter_half(&rectangle) == FORTY_TWO and
         segment_finish_sum(&segment) == FORTY_TWO and
         nested_valid(&nested) and
         envelope_valid(&envelope) and
         deep_envelope_valid(&deep) and
         state_valid(&state) and
         bundle_valid(&bundle);
}

