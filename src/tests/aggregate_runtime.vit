}

proc test_aggregate_loop() -> bool {
    let mut index: i64 = ZERO;
    let mut total: i64 = ZERO;

    while index < TWO {
        let point: Point =
            make_point(
                TEN,
                11);

        set total =
            total +
            point_sum(&point);

        set index =
            index + ONE;
    }

    return index == TWO and
         total == FORTY_TWO;
}

proc test_aggregate_loop_transform() -> bool {
    let mut index: i64 = ZERO;
    let mut point: Point =
        make_zero_point();

    while index < TWO {
        let next: Point =
            point_translate(
                &point,
                TEN,
                11);

        set point =
            next;

        set index =
            index + ONE;
    }

    return point.x == TWENTY and
         point.y == TWENTY_TWO and
         point_sum(&point) == FORTY_TWO;
}

proc test_counter_loop() -> bool {
    let mut index: i64 = ZERO;
    let mut counter: Counter =
        make_counter(
            FORTY);

    while index < TWO {
        let next: Counter =
            counter_increment(
                &counter);

        set counter =
            next;

        set index =
            index + ONE;
    }

    return counter_value(
        &counter) == FORTY_TWO;
}

