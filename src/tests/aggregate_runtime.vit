/// Aggregate runtime coverage.
///
/// Comprehensive positive runtime fixture for aggregate values.
///
/// This test exercises:
/// - form construction;
/// - scalar fields;
/// - boolean fields;
/// - nested forms;
/// - aggregate parameters;
/// - aggregate return values;
/// - references to aggregates;
/// - field reads through references;
/// - aggregate copies;
/// - local aggregate variables;
/// - aggregate values produced by calls;
/// - aggregate values consumed by calls;
/// - nested field access;
/// - nested aggregate construction;
/// - repeated aggregate construction;
/// - conditional aggregate selection;
/// - aggregate transformation pipelines;
/// - independent aggregate instances;
/// - aggregate values inside loops;
/// - aggregate values across nested scopes;
/// - aggregate equality implemented field-by-field;
/// - deep aggregate traversal;
/// - runtime preservation of field values;
/// - runtime preservation of nominal aggregate types.
///
/// Expected result:
/// - lexing succeeds;
/// - parsing succeeds;
/// - semantic analysis succeeds;
/// - lowering succeeds;
/// - generated code preserves aggregate values;
/// - runtime checks all succeed;
/// - `main` returns 0.

space tests::aggregate_runtime;

const ZERO: i64 = 0;
const ONE: i64 = 1;
const TWO: i64 = 2;
const THREE: i64 = 3;
const FOUR: i64 = 4;
const FIVE: i64 = 5;
const SIX: i64 = 6;
const SEVEN: i64 = 7;
const TEN: i64 = 10;
const TWENTY: i64 = 20;
const TWENTY_ONE: i64 = 21;
const TWENTY_TWO: i64 = 22;
const FORTY: i64 = 40;
const FORTY_ONE: i64 = 41;
const FORTY_TWO: i64 = 42;
const FIFTY: i64 = 50;
const ONE_HUNDRED: i64 = 100;

form Point {
    x: i64,
    y: i64,
}

form Range {
    minimum: i64,
    maximum: i64,
}

form Pair {
    first: i64,
    second: i64,
}

form Triple {
    first: i64,
    second: i64,
    third: i64,
}

form Counter {
    value: i64,
}

form FlaggedValue {
    value: i64,
    enabled: bool,
}

form Record {
    id: i64,
    value: i64,
    enabled: bool,
}

form Rectangle {
    minimum: Point,
    maximum: Point,
}

form Segment {
    start: Point,
    finish: Point,
}

form PointPair {
    first: Point,
    second: Point,
}

form RangePair {
    first: Range,
    second: Range,
}

form RecordPair {
    first: Record,
    second: Record,
}

form Nested {
    point: Point,
    range: Range,
    record: Record,
    pair: Pair,
}

form Envelope {
    nested: Nested,
    marker: i64,
}

form DeepEnvelope {
    envelope: Envelope,
    fallback: Point,
}

form AggregateState {
    counter: Counter,
    current: Point,
    bounds: Range,
    enabled: bool,
}

form AggregateBundle {
    point: Point,
    rectangle: Rectangle,
    segment: Segment,
    record: Record,
    state: AggregateState,
}

proc add(
    left: i64,
    right: i64
) -> i64 {
    return left + right;
}

proc subtract(
    left: i64,
    right: i64
) -> i64 {
    return left - right;
}

proc multiply(
    left: i64,
    right: i64
) -> i64 {
    return left * right;
}

proc identity(
    value: i64
) -> i64 {
    return value;
}

proc make_point(
    x: i64,
    y: i64
) -> Point {
    return Point {
        x: x,
        y: y,
    };
}

proc make_zero_point() -> Point {
    return Point {
        x: ZERO,
        y: ZERO,
    };
}

proc make_answer_point() -> Point {
    return Point {
        x: TWENTY,
        y: TWENTY_TWO,
    };
}

proc make_equal_point(
    value: i64
) -> Point {
    return Point {
        x: value,
        y: value,
    };
}

proc point_x(
    point: &Point
) -> i64 {
    return point.x;
}

proc point_y(
    point: &Point
) -> i64 {
    return point.y;
}

proc point_sum(
    point: &Point
) -> i64 {
    return point.x +
         point.y;
}

proc point_difference(
    point: &Point
) -> i64 {
    return point.y -
         point.x;
}

proc point_product(
    point: &Point
) -> i64 {
    return point.x *
         point.y;
}

proc point_is_zero(
    point: &Point
) -> bool {
    return point.x == ZERO and
         point.y == ZERO;
}

proc point_is_answer(
    point: &Point
) -> bool {
    return point_sum(point) ==
         FORTY_TWO;
}

proc point_equal(
    left: &Point,
    right: &Point
) -> bool {
    return left.x == right.x and
         left.y == right.y;
}

proc point_translate(
    point: &Point,
    dx: i64,
    dy: i64
) -> Point {
    return Point {
        x: point.x + dx,
        y: point.y + dy,
    };
}

proc point_scale(
    point: &Point,
    factor: i64
) -> Point {
    return Point {
        x: point.x * factor,
        y: point.y * factor,
    };
}

proc point_swap(
    point: &Point
) -> Point {
    return Point {
        x: point.y,
        y: point.x,
    };
}

proc point_copy(
    point: &Point
) -> Point {
    return Point {
        x: point.x,
        y: point.y,
    };
}

proc point_add(
    left: &Point,
    right: &Point
) -> Point {
    return Point {
        x: left.x + right.x,
        y: left.y + right.y,
    };
}

proc point_subtract(
    left: &Point,
    right: &Point
) -> Point {
    return Point {
        x: left.x - right.x,
        y: left.y - right.y,
    };
}

proc make_range(
    minimum_value: i64,
    maximum_value: i64
) -> Range {
    return Range {
        minimum: minimum_value,
        maximum: maximum_value,
    };
}

proc make_answer_range() -> Range {
    return Range {
        minimum: ZERO,
        maximum: FORTY_TWO,
    };
}

proc range_minimum(
    range: &Range
) -> i64 {
    return range.minimum;
}

proc range_maximum(
    range: &Range
) -> i64 {
    return range.maximum;
}

proc range_width(
    range: &Range
) -> i64 {
    return range.maximum -
         range.minimum;
}

proc range_valid(
    range: &Range
) -> bool {
    return range.minimum <=
         range.maximum;
}

proc range_contains(
    range: &Range,
    value: i64
) -> bool {
    return value >= range.minimum and
         value <= range.maximum;
}

proc range_equal(
    left: &Range,
    right: &Range
) -> bool {
    return left.minimum == right.minimum and
         left.maximum == right.maximum;
}

proc range_translate(
    range: &Range,
    offset: i64
) -> Range {
    return Range {
        minimum: range.minimum + offset,
        maximum: range.maximum + offset,
    };
}

proc range_copy(
    range: &Range
) -> Range {
    return Range {
        minimum: range.minimum,
        maximum: range.maximum,
    };
}

proc make_pair(
    first: i64,
    second: i64
) -> Pair {
    return Pair {
        first: first,
        second: second,
    };
}

proc make_answer_pair() -> Pair {
    return Pair {
        first: TWENTY,
        second: TWENTY_TWO,
    };
}

proc pair_first(
    pair: &Pair
) -> i64 {
    return pair.first;
}

proc pair_second(
    pair: &Pair
) -> i64 {
    return pair.second;
}

proc pair_sum(
    pair: &Pair
) -> i64 {
    return pair.first +
         pair.second;
}

proc pair_equal(
    left: &Pair,
    right: &Pair
) -> bool {
    return left.first == right.first and
         left.second == right.second;
}

proc pair_swap(
    pair: &Pair
) -> Pair {
    return Pair {
        first: pair.second,
        second: pair.first,
    };
}

proc make_triple(
    first: i64,
    second: i64,
    third: i64
) -> Triple {
    return Triple {
        first: first,
        second: second,
        third: third,
    };
}

proc triple_sum(
    triple: &Triple
) -> i64 {
    return triple.first +
         triple.second +
         triple.third;
}

proc make_counter(
    value: i64
) -> Counter {
    return Counter {
        value: value,
    };
}

proc counter_value(
    counter: &Counter
) -> i64 {
    return counter.value;
}

proc counter_increment(
    counter: &Counter
) -> Counter {
    return Counter {
        value: counter.value + ONE,
    };
}

proc counter_add(
    counter: &Counter,
    amount: i64
) -> Counter {
    return Counter {
        value: counter.value + amount,
    };
}

proc make_flagged_value(
    value: i64,
    enabled: bool
) -> FlaggedValue {
    return FlaggedValue {
        value: value,
        enabled: enabled,
    };
}

proc flagged_value(
    value: &FlaggedValue
) -> i64 {
    return value.value;
}

proc flagged_enabled(
    value: &FlaggedValue
) -> bool {
    return value.enabled;
}

proc make_record(
    id: i64,
    value: i64,
    enabled: bool
) -> Record {
    return Record {
        id: id,
        value: value,
        enabled: enabled,
    };
}

proc make_answer_record() -> Record {
    return Record {
        id: SEVEN,
        value: FORTY_TWO,
        enabled: true,
    };
}

proc record_id(
    record: &Record
) -> i64 {
    return record.id;
}

proc record_value(
    record: &Record
) -> i64 {
    return record.value;
}

proc record_enabled(
    record: &Record
) -> bool {
    return record.enabled;
}

proc record_valid(
    record: &Record
) -> bool {
    return record.id >= ZERO and
         record.enabled;
}

proc record_copy(
    record: &Record
) -> Record {
    return Record {
        id: record.id,
        value: record.value,
        enabled: record.enabled,
    };
}

proc record_with_value(
    record: &Record,
    value: i64
) -> Record {
    return Record {
        id: record.id,
        value: value,
        enabled: record.enabled,
    };
}

proc record_toggle(
    record: &Record
) -> Record {
    return Record {
        id: record.id,
        value: record.value,
        enabled: not record.enabled,
    };
}

proc make_rectangle(
    minimum: Point,
    maximum: Point
) -> Rectangle {
    return Rectangle {
        minimum: minimum,
        maximum: maximum,
    };
}

proc make_answer_rectangle() -> Rectangle {
    let minimum: Point =
        make_zero_point();

    let maximum: Point =
        make_answer_point();

    return make_rectangle(
        minimum,
        maximum);
}

proc rectangle_width(
    rectangle: &Rectangle
) -> i64 {
    return rectangle.maximum.x -
         rectangle.minimum.x;
}

proc rectangle_height(
    rectangle: &Rectangle
) -> i64 {
    return rectangle.maximum.y -
         rectangle.minimum.y;
}

proc rectangle_perimeter_half(
    rectangle: &Rectangle
) -> i64 {
    return rectangle_width(rectangle) +
         rectangle_height(rectangle);
}

proc rectangle_valid(
    rectangle: &Rectangle
) -> bool {
    return rectangle.minimum.x <=
             rectangle.maximum.x and
         rectangle.minimum.y <=
             rectangle.maximum.y;
}

proc rectangle_minimum_sum(
    rectangle: &Rectangle
) -> i64 {
    return point_sum(
        &rectangle.minimum);
}

proc rectangle_maximum_sum(
    rectangle: &Rectangle
) -> i64 {
    return point_sum(
        &rectangle.maximum);
}

proc make_segment(
    start: Point,
    finish: Point
) -> Segment {
    return Segment {
        start: start,
        finish: finish,
    };
}

proc make_answer_segment() -> Segment {
    let start: Point =
        make_zero_point();

    let finish: Point =
        make_answer_point();

    return make_segment(
        start,
        finish);
}

proc segment_start_sum(
    segment: &Segment
) -> i64 {
    return point_sum(
        &segment.start);
}

proc segment_finish_sum(
    segment: &Segment
) -> i64 {
    return point_sum(
        &segment.finish);
}

proc segment_delta_sum(
    segment: &Segment
) -> i64 {
    return
        (segment.finish.x - segment.start.x) +
        (segment.finish.y - segment.start.y);
}

proc make_point_pair(
    first: Point,
    second: Point
) -> PointPair {
    return PointPair {
        first: first,
        second: second,
    };
}

proc point_pair_sum(
    pair: &PointPair
) -> i64 {
    return point_sum(
               &pair.first) +
         point_sum(
               &pair.second);
}

proc point_pair_first_sum(
    pair: &PointPair
) -> i64 {
    return point_sum(
        &pair.first);
}

proc point_pair_second_sum(
    pair: &PointPair
) -> i64 {
    return point_sum(
        &pair.second);
}

proc make_range_pair(
    first: Range,
    second: Range
) -> RangePair {
    return RangePair {
        first: first,
        second: second,
    };
}

proc range_pair_width(
    pair: &RangePair
) -> i64 {
    return range_width(
               &pair.first) +
         range_width(
               &pair.second);
}

proc make_record_pair(
    first: Record,
    second: Record
) -> RecordPair {
    return RecordPair {
        first: first,
        second: second,
    };
}

proc record_pair_value(
    pair: &RecordPair
) -> i64 {
    return pair.first.value +
         pair.second.value;
}

proc record_pair_enabled(
    pair: &RecordPair
) -> bool {
    return pair.first.enabled and
         pair.second.enabled;
}

proc make_nested(
    point: Point,
    range: Range,
    record: Record,
    pair: Pair
) -> Nested {
    return Nested {
        point: point,
        range: range,
        record: record,
        pair: pair,
    };
}

proc make_answer_nested() -> Nested {
    let point: Point =
        make_answer_point();

    let range: Range =
        make_answer_range();

    let record: Record =
        make_answer_record();

    let pair: Pair =
        make_answer_pair();

    return make_nested(
        point,
        range,
        record,
        pair);
}

proc nested_point_sum(
    nested: &Nested
) -> i64 {
    return point_sum(
        &nested.point);
}

proc nested_range_width(
    nested: &Nested
) -> i64 {
    return range_width(
        &nested.range);
}

proc nested_record_value(
    nested: &Nested
) -> i64 {
    return record_value(
        &nested.record);
}

proc nested_pair_sum(
    nested: &Nested
) -> i64 {
    return pair_sum(
        &nested.pair);
}

proc nested_total(
    nested: &Nested
) -> i64 {
    return nested_point_sum(nested) +
         nested_range_width(nested) +
         nested_record_value(nested) +
         nested_pair_sum(nested);
}

proc nested_valid(
    nested: &Nested
) -> bool {
    return point_is_answer(
               &nested.point) and
         range_valid(
               &nested.range) and
         range_width(
               &nested.range) == FORTY_TWO and
         record_valid(
               &nested.record) and
         record_value(
               &nested.record) == FORTY_TWO and
         pair_sum(
               &nested.pair) == FORTY_TWO;
}

proc nested_copy(
    nested: &Nested
) -> Nested {
    return Nested {
        point: nested.point,
        range: nested.range,
        record: nested.record,
        pair: nested.pair,
    };
}

proc make_envelope(
    nested: Nested,
    marker: i64
) -> Envelope {
    return Envelope {
        nested: nested,
        marker: marker,
    };
}

proc make_answer_envelope() -> Envelope {
    let nested: Nested =
        make_answer_nested();

    return make_envelope(
        nested,
        FORTY_TWO);
}

proc envelope_marker(
    envelope: &Envelope
) -> i64 {
    return envelope.marker;
}

proc envelope_point_sum(
    envelope: &Envelope
) -> i64 {
    return point_sum(
        &envelope.nested.point);
}

proc envelope_range_width(
    envelope: &Envelope
) -> i64 {
    return range_width(
        &envelope.nested.range);
}

proc envelope_record_value(
    envelope: &Envelope
) -> i64 {
    return record_value(
        &envelope.nested.record);
}

proc envelope_pair_sum(
    envelope: &Envelope
) -> i64 {
    return pair_sum(
        &envelope.nested.pair);
}

proc envelope_valid(
    envelope: &Envelope
) -> bool {
    return envelope.marker == FORTY_TWO and
         nested_valid(
             &envelope.nested);
}

proc make_deep_envelope(
    envelope: Envelope,
    fallback: Point
) -> DeepEnvelope {
    return DeepEnvelope {
        envelope: envelope,
        fallback: fallback,
    };
}

proc make_answer_deep_envelope() -> DeepEnvelope {
    let envelope: Envelope =
        make_answer_envelope();

    let fallback: Point =
        make_answer_point();

    return make_deep_envelope(
        envelope,
        fallback);
}

proc deep_envelope_marker(
    value: &DeepEnvelope
) -> i64 {
    return value.envelope.marker;
}

proc deep_envelope_nested_point_sum(
    value: &DeepEnvelope
) -> i64 {
    return point_sum(
        &value.envelope.nested.point);
}

proc deep_envelope_fallback_sum(
    value: &DeepEnvelope
) -> i64 {
    return point_sum(
        &value.fallback);
}

proc deep_envelope_valid(
    value: &DeepEnvelope
) -> bool {
    return envelope_valid(
               &value.envelope) and
         point_is_answer(
               &value.fallback);
}

proc make_state(
    counter: Counter,
    current: Point,
    bounds: Range,
    enabled: bool
) -> AggregateState {
    return AggregateState {
        counter: counter,
        current: current,
        bounds: bounds,
        enabled: enabled,
    };
}

proc make_answer_state() -> AggregateState {
    let counter: Counter =
        make_counter(FORTY_TWO);

    let point: Point =
        make_answer_point();

    let range: Range =
        make_answer_range();

    return make_state(
        counter,
        point,
        range,
        true);
}

proc state_counter(
    state: &AggregateState
) -> i64 {
    return counter_value(
        &state.counter);
}

proc state_point_sum(
    state: &AggregateState
) -> i64 {
    return point_sum(
        &state.current);
}

proc state_range_width(
    state: &AggregateState
) -> i64 {
    return range_width(
        &state.bounds);
}

proc state_enabled(
    state: &AggregateState
) -> bool {
    return state.enabled;
}

proc state_valid(
    state: &AggregateState
) -> bool {
    return state_counter(state) == FORTY_TWO and
         state_point_sum(state) == FORTY_TWO and
         state_range_width(state) == FORTY_TWO and
         state_enabled(state);
}

proc make_bundle(
    point: Point,
    rectangle: Rectangle,
    segment: Segment,
    record: Record,
    state: AggregateState
) -> AggregateBundle {
    return AggregateBundle {
        point: point,
        rectangle: rectangle,
        segment: segment,
        record: record,
        state: state,
    };
}

proc make_answer_bundle() -> AggregateBundle {
    let point: Point =
        make_answer_point();

    let rectangle: Rectangle =
        make_answer_rectangle();

    let segment: Segment =
        make_answer_segment();

    let record: Record =
        make_answer_record();

    let state: AggregateState =
        make_answer_state();

    return make_bundle(
        point,
        rectangle,
        segment,
        record,
        state);
}

proc bundle_point_sum(
    bundle: &AggregateBundle
) -> i64 {
    return point_sum(
        &bundle.point);
}

proc bundle_rectangle_sum(
    bundle: &AggregateBundle
) -> i64 {
    return rectangle_perimeter_half(
        &bundle.rectangle);
}

proc bundle_segment_sum(
    bundle: &AggregateBundle
) -> i64 {
    return segment_finish_sum(
        &bundle.segment);
}

proc bundle_record_value(
    bundle: &AggregateBundle
) -> i64 {
    return record_value(
        &bundle.record);
}

proc bundle_state_value(
    bundle: &AggregateBundle
) -> i64 {
    return state_counter(
        &bundle.state);
}

proc bundle_valid(
    bundle: &AggregateBundle
) -> bool {
    return bundle_point_sum(bundle) == FORTY_TWO and
         bundle_rectangle_sum(bundle) == FORTY_TWO and
         bundle_segment_sum(bundle) == FORTY_TWO and
         bundle_record_value(bundle) == FORTY_TWO and
         bundle_state_value(bundle) == FORTY_TWO and
         state_valid(
             &bundle.state);
}

proc choose_point(
    choose_answer: bool
) -> Point {
    if choose_answer {
        return make_answer_point();
    }

    return make_zero_point();
}

proc choose_range(
    choose_answer: bool
) -> Range {
    if choose_answer {
        return make_answer_range();
    }

    return make_range(
        ZERO,
        ZERO);
}

proc choose_record(
    choose_answer: bool
) -> Record {
    if choose_answer {
        return make_answer_record();
    }

    return make_record(
        ZERO,
        ZERO,
        false);
}

proc forward_point(
    point: Point
) -> Point {
    return point;
}

proc forward_range(
    range: Range
) -> Range {
    return range;
}

proc forward_record(
    record: Record
) -> Record {
    return record;
}

proc forward_nested(
    nested: Nested
) -> Nested {
    return nested;
}

proc point_pipeline() -> Point {
    let initial: Point =
        make_point(
            TEN,
            ELEVEN_VALUE());

    let translated: Point =
        point_translate(
            &initial,
            TEN,
            ONE);

    return translated;
}

proc ELEVEN_VALUE() -> i64 {
    return 11;
}

proc test_basic_point() -> bool {
    let point: Point =
        Point {
            x: TWENTY,
            y: TWENTY_TWO,
        };

    return point.x == TWENTY and
         point.y == TWENTY_TWO and
         point_sum(&point) == FORTY_TWO;
}

proc test_point_factory() -> bool {
    let point: Point =
        make_point(
            TWENTY,
            TWENTY_TWO);

    return point_x(&point) == TWENTY and
         point_y(&point) == TWENTY_TWO and
         point_sum(&point) == FORTY_TWO;
}

proc test_point_return_value() -> bool {
    let point: Point =
        make_answer_point();

    return point_is_answer(
        &point);
}

proc test_point_copy() -> bool {
    let original: Point =
        make_answer_point();

    let copy: Point =
        original;

    return point_equal(
               &original,
               &copy) and
         point_sum(
               &copy) == FORTY_TWO;
}

proc test_point_explicit_copy() -> bool {
    let original: Point =
        make_answer_point();

    let copy: Point =
        point_copy(
            &original);

    return point_equal(
        &original,
        &copy);
}

proc test_point_independent_instances() -> bool {
    let first: Point =
        make_point(
            TWENTY,
            TWENTY_TWO);

    let second: Point =
        make_point(
            ONE,
            TWO);

    return point_sum(&first) == FORTY_TWO and
         point_sum(&second) == THREE and
         first.x == TWENTY and
         second.x == ONE;
}

proc test_point_translate() -> bool {
