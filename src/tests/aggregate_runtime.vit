proc test_aggregate_in_nested_scope() -> bool {
    let mut result: i64 = ZERO;

    {
        let point: Point =
            make_answer_point();

        {
            let range: Range =
                make_answer_range();

            {
                let pair: Pair =
                    make_answer_pair();

                if point_sum(&point) == FORTY_TWO and
                   range_width(&range) == FORTY_TWO and
                   pair_sum(&pair) == FORTY_TWO {
                    set result =
                        FORTY_TWO;
                }
            }
        }
    }

    return result == FORTY_TWO;
}

proc test_aggregate_shadowing() -> bool {
    let point: Point =
        make_answer_point();

    let mut result: i64 =
        point_sum(
            &point);

    {
        let point: Point =
            make_zero_point();

        if point_sum(&point) == ZERO {
            set result =
                result + ZERO;
        }
    }

    return point_sum(&point) == FORTY_TWO and
         result == FORTY_TWO;
}

