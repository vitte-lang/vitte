        PlanetKind::Terra
    {
        io_print("Terra");
        return;
    }

    if planet ==
        PlanetKind::Luna
    {
        io_print("Luna");
        return;
    }

    if planet ==
        PlanetKind::Mars
    {
        io_print("Mars");
        return;
    }

    if planet ==
        PlanetKind::Europa
    {
        io_print("Europa");
        return;
    }

    if planet ==
        PlanetKind::Titan
    {
        io_print("Titan");
        return;
    }

    if planet ==
        PlanetKind::Vega
    {
        io_print("Vega");
        return;
    }

    io_print("Orion");
}


proc print_commodity_name(
    commodity: CommodityKind
) {
    if commodity ==
        CommodityKind::Food
    {
        io_print("Nourriture");
        return;
    }

    if commodity ==
        CommodityKind::Ore
    {
        io_print("Minerai");
        return;
    }

    if commodity ==
        CommodityKind::Medicine
    {
        io_print("Medicament");
        return;
    }

    if commodity ==
        CommodityKind::Technology
    {
        io_print("Technologie");
        return;
    }

    io_print("Cristal");
}


/* ========================================================================= */
/* Planet distances                                                           */
/* ========================================================================= */

proc planet_index(
    planet: PlanetKind
) -> i64 {
    if planet ==
        PlanetKind::Terra
    {
        return 0;
    }

    if planet ==
        PlanetKind::Luna
    {
        return 1;
    }

    if planet ==
        PlanetKind::Mars
    {
        return 2;
    }

    if planet ==
        PlanetKind::Europa
    {
        return 3;
    }

    if planet ==
        PlanetKind::Titan
    {
        return 4;
    }

    if planet ==
        PlanetKind::Vega
    {
        return 5;
    }

    return 6;
}


proc absolute_i64(
    value: i64
) -> i64 {
    if value < 0 {
        return -value;
    }

    return value;
}


proc distance_between(
    from: PlanetKind,
    to: PlanetKind
) -> i64 {
    let left: i64 =
        planet_index(from);

    let right: i64 =
        planet_index(to);

    let base: i64 =
        absolute_i64(
            left - right
        );

    return
        8 +
        base * 7;
}


/* ========================================================================= */
/* Fuel                                                                       */
/* ========================================================================= */

proc travel_fuel_cost(
    player: &Player,
    destination: PlanetKind
) -> i64 {
    let distance: i64 =
        distance_between(
            player.planet,
            destination
        );

    let reduction: i64 =
        player.ship.engine_level - 1;

    return
        max_i64(
            1,
            distance - reduction * 2
        );
}


/* ========================================================================= */
/* Base commodity prices                                                      */
/* ========================================================================= */

proc base_price(
    commodity: CommodityKind
) -> i64 {
    if commodity ==
        CommodityKind::Food
    {
        return 18;
    }

    if commodity ==
        CommodityKind::Ore
    {
        return 35;
    }

    if commodity ==
        CommodityKind::Medicine
    {
        return 80;
    }

    if commodity ==
        CommodityKind::Technology
    {
        return 150;
    }

    return 300;
}


/* ========================================================================= */
/* Planet price modifier                                                      */
/* ========================================================================= */

proc planet_modifier(
    planet: PlanetKind,
    commodity: CommodityKind
) -> i64 {
    if planet ==
        PlanetKind::Terra
    {
        if commodity ==
            CommodityKind::Food
        {
            return 70;
        }

        if commodity ==
            CommodityKind::Technology
        {
            return 125;
        }

        return 100;
    }

    if planet ==
        PlanetKind::Luna
    {
        if commodity ==
            CommodityKind::Food
        {
            return 140;
        }

        if commodity ==
            CommodityKind::Ore
        {
            return 75;
        }

        return 105;
    }

    if planet ==
        PlanetKind::Mars
    {
        if commodity ==
            CommodityKind::Ore
        {
            return 65;
        }

        if commodity ==
            CommodityKind::Medicine
        {
            return 135;
        }

        return 100;
    }

    if planet ==
        PlanetKind::Europa
    {
        if commodity ==
            CommodityKind::Medicine
        {
            return 70;
        }

        if commodity ==
            CommodityKind::Food
        {
            return 130;
        }

        return 100;
    }

    if planet ==
        PlanetKind::Titan
    {
        if commodity ==
            CommodityKind::Technology
        {
            return 75;
        }

        if commodity ==
            CommodityKind::Crystal
        {
            return 135;
        }

        return 100;
    }

    if planet ==
        PlanetKind::Vega
    {
        if commodity ==
            CommodityKind::Crystal
        {
            return 70;
        }

        if commodity ==
            CommodityKind::Technology
        {
            return 140;
        }

        return 110;
    }

    if commodity ==
        CommodityKind::Crystal
    {
        return 150;
    }

    if commodity ==
        CommodityKind::Medicine
    {
        return 120;
    }

    return 110;
}


/* ========================================================================= */
/* Dynamic market modifier                                                    */
/* ========================================================================= */

proc market_modifier(
    game: &Game,
    commodity: CommodityKind
) -> i64 {
    if commodity ==
        CommodityKind::Food
    {
        return game.food_market;
    }

    if commodity ==
        CommodityKind::Ore
    {
        return game.ore_market;
    }

    if commodity ==
        CommodityKind::Medicine
    {
        return game.medicine_market;
    }

    if commodity ==
        CommodityKind::Technology
    {
        return game.technology_market;
    }

    return game.crystal_market;
}


/* ========================================================================= */
/* Final market price                                                         */
/* ========================================================================= */

proc commodity_price(
    game: &Game,
    commodity: CommodityKind
) -> i64 {
    let base: i64 =
        base_price(
            commodity
        );

    let planet: i64 =
        planet_modifier(
            game.player.planet,
            commodity
        );

    let market: i64 =
        market_modifier(
            game,
            commodity
        );

    let price: i64 =
        base *
        planet *
        market /
        10000;

    return max_i64(
        1,
        price
    );
}


/* ========================================================================= */
/* Market fluctuation                                                         */
/* ========================================================================= */

proc update_market(
    game: &mut Game
) {
    game.food_market =
        clamp_i64(
            game.food_market +
            random_i64(-12, 12),
            60,
            160
        );

    game.ore_market =
        clamp_i64(
            game.ore_market +
            random_i64(-12, 12),
            60,
            160
        );

    game.medicine_market =
        clamp_i64(
            game.medicine_market +
            random_i64(-10, 10),
            60,
            160
        );

    game.technology_market =
        clamp_i64(
            game.technology_market +
            random_i64(-8, 8),
            60,
            160
        );

    game.crystal_market =
        clamp_i64(
            game.crystal_market +
            random_i64(-15, 15),
            50,
            180
        );
}


/* ========================================================================= */
/* Commodity input                                                            */
/* ========================================================================= */

proc read_commodity() -> CommodityKind {
    io_print("1. Nourriture\n");
    io_print("2. Minerai\n");
    io_print("3. Medicament\n");
    io_print("4. Technologie\n");
    io_print("5. Cristal\n");
    io_print("> ");

    let value: i64 =
        io_read_i64();

    if value == 1 {
        return CommodityKind::Food;
    }

    if value == 2 {
        return CommodityKind::Ore;
    }

    if value == 3 {
        return CommodityKind::Medicine;
    }

    if value == 4 {
        return CommodityKind::Technology;
    }

    return CommodityKind::Crystal;
}


/* ========================================================================= */
/* Price display                                                              */
/* ========================================================================= */

proc print_price(
    game: &Game,
    commodity: CommodityKind
) {
    print_commodity_name(
        commodity
    );

    io_print(" : ");

    io_print_i64(
        commodity_price(
            game,
            commodity
        )
    );

    io_print(" credits");

    io_print("   stock: ");

    io_print_i64(
        cargo_quantity(
            &game.player.cargo,
            commodity
        )
    );

    println();
}


proc print_market(
    game: &Game
) {
    println();
    small_separator();

    io_print("MARCHE DE ");

    print_planet_name(
        game.player.planet
    );

    println();

    small_separator();

    print_price(
        game,
        CommodityKind::Food
    );

    print_price(
        game,
        CommodityKind::Ore
    );

    print_price(
        game,
        CommodityKind::Medicine
    );

    print_price(
        game,
        CommodityKind::Technology
    );

    print_price(
        game,
        CommodityKind::Crystal
    );

    small_separator();

    io_print("Credits : ");
    io_print_i64(
        game.player.credits
    );

    println();

    io_print("Cargaison libre : ");
    io_print_i64(
        cargo_free(
            &game.player
        )
    );

    println();
}


/* ========================================================================= */
/* Buy                                                                        */
/* ========================================================================= */

proc buy_commodity(
    game: &mut Game
) {
    io_print("\nAcheter quelle marchandise ?\n");

    let commodity: CommodityKind =
        read_commodity();

    let price: i64 =
        commodity_price(
            game,
            commodity
        );

    io_print("Prix unitaire : ");
    io_print_i64(price);
    println();

    io_print("Quantite : ");

    let requested: i64 =
        io_read_i64();

    if requested <= 0 {
        io_print("Quantite invalide.\n");
        return;
    }

    let free: i64 =
        cargo_free(
            &game.player
        );

    if free <= 0 {
        io_print("Cargaison pleine.\n");
        return;
    }

    let affordable: i64 =
        game.player.credits /
        price;

    let mut quantity: i64 =
        requested;

    quantity =
        min_i64(
            quantity,
            free
        );

    quantity =
        min_i64(
            quantity,
            affordable
        );

    if quantity <= 0 {
        io_print("Credits insuffisants.\n");
        return;
    }

    let total: i64 =
        quantity * price;

    game.player.credits =
        game.player.credits -
        total;

    cargo_add(
        &game.player.cargo,
        commodity,
        quantity
    );

    game.player.trades =
        game.player.trades + 1;

    io_print("Achat : ");
    io_print_i64(quantity);
    io_print(" x ");

    print_commodity_name(
        commodity
    );

    io_print(" pour ");

    io_print_i64(total);

    io_print(" credits.\n");
}


/* ========================================================================= */
/* Sell                                                                       */
/* ========================================================================= */

proc sell_commodity(
    game: &mut Game
) {
    io_print("\nVendre quelle marchandise ?\n");

    let commodity: CommodityKind =
        read_commodity();

    let owned: i64 =
        cargo_quantity(
            &game.player.cargo,
            commodity
        );

    if owned <= 0 {
        io_print("Vous n'en possedez pas.\n");
        return;
    }

    let price: i64 =
        commodity_price(
            game,
            commodity
        );

    io_print("Vous possedez : ");
    io_print_i64(owned);
    println();

    io_print("Prix unitaire : ");
    io_print_i64(price);
    println();

    io_print("Quantite : ");

    let requested: i64 =
        io_read_i64();

    if requested <= 0 {
        io_print("Quantite invalide.\n");
        return;
    }

    let quantity: i64 =
        min_i64(
            requested,
            owned
        );

    let total: i64 =
        quantity * price;

    cargo_remove(
        &game.player.cargo,
        commodity,
        quantity
    );

    game.player.credits =
        game.player.credits +
        total;

    game.player.total_profit =
        game.player.total_profit +
        total;

    game.player.trades =
        game.player.trades + 1;

    game.player.reputation =
        game.player.reputation + 1;

    io_print("Vente : ");
    io_print_i64(quantity);
    io_print(" x ");

    print_commodity_name(
        commodity
    );

    io_print(" pour ");

    io_print_i64(total);

    io_print(" credits.\n");
}


/* ========================================================================= */
/* Market menu                                                                */
/* ========================================================================= */

proc market_menu(
    game: &mut Game
) {
    let mut open: bool = true;

    while open {
        print_market(
            game
        );

        io_print("\n");
        io_print("1. Acheter\n");
        io_print("2. Vendre\n");
        io_print("3. Actualiser les prix\n");
        io_print("4. Retour\n");
        io_print("> ");

        let choice: i64 =
            io_read_i64();

        if choice == 1 {
            buy_commodity(
                game
            );
        } else if choice == 2 {
            sell_commodity(
                game
            );
        } else if choice == 3 {
            print_market(
                game
            );
        } else if choice == 4 {
            open = false;
        } else {
            io_print("Commande inconnue.\n");
        }
    }
}


/* ========================================================================= */
/* Planet selection                                                           */
/* ========================================================================= */

proc read_planet() -> PlanetKind {
    io_print("\nDestination\n");
    io_print("1. Terra\n");
    io_print("2. Luna\n");
    io_print("3. Mars\n");
    io_print("4. Europa\n");
    io_print("5. Titan\n");
    io_print("6. Vega\n");
    io_print("7. Orion\n");
    io_print("> ");

    let value: i64 =
        io_read_i64();

    if value == 1 {
        return PlanetKind::Terra;
    }

    if value == 2 {
        return PlanetKind::Luna;
    }

    if value == 3 {
        return PlanetKind::Mars;
    }

    if value == 4 {
        return PlanetKind::Europa;
    }

    if value == 5 {
        return PlanetKind::Titan;
    }

    if value == 6 {
        return PlanetKind::Vega;
    }

    return PlanetKind::Orion;
}


/* ========================================================================= */
/* Pirate creation                                                            */
/* ========================================================================= */

proc create_pirate(
    player: &Player
) -> Pirate {
    let mut pirate: Pirate;

    let difficulty: i64 =
        1 +
        player.journeys / 4;

    pirate.max_health =
        35 +
        difficulty * 12;

    pirate.health =
        pirate.max_health;

    pirate.attack =
        7 +
        difficulty * 3;

    pirate.defense =
        2 +
        difficulty;

    pirate.reward =
        150 +
        difficulty * 75;

    return pirate;
}


/* ========================================================================= */
/* Pirate helpers                                                             */
/* ========================================================================= */

proc pirate_alive(
    pirate: &Pirate
) -> bool {
    return pirate.health > 0;
}


proc ship_alive(
    ship: &Ship
) -> bool {
    return ship.hull > 0;
}


proc damage_pirate(
    pirate: &mut Pirate,
    damage: i64
) {
    if damage >= pirate.health {
        pirate.health = 0;
        return;
    }

    pirate.health =
        pirate.health -
        max_i64(0, damage);
}


proc damage_ship(
    ship: &mut Ship,
    damage: i64
) {
    if damage >= ship.hull {
        ship.hull = 0;
        return;
    }

    ship.hull =
        ship.hull -
        max_i64(0, damage);
}


/* ========================================================================= */
/* Combat                                                                     */
/* ========================================================================= */

proc player_combat_attack(
    game: &mut Game,
    pirate: &mut Pirate
) {
    let base: i64 =
        8 +
        game.player.ship.weapon_level * 6;

    let variance: i64 =
        random_i64(-3, 5);

    let mut damage: i64 =
        base +
        variance -
        pirate.defense;

    damage =
        max_i64(
            1,
            damage
        );

    let critical: i64 =
        random_i64(1, 100);

    if critical <=
        10 +
        game.player.ship.weapon_level * 2
    {
        damage =
            damage * 2;

        io_print("TIR CRITIQUE !\n");
    }

    damage_pirate(
        pirate,
        damage
    );

    io_print("Vous infligez ");
    io_print_i64(damage);
    io_print(" degats.\n");
}


proc pirate_attack(
    game: &mut Game,
    pirate: &Pirate,
    defending: bool
) {
    let shield: i64 =
        game.player.ship.shield_level *
        2;

    let mut damage: i64 =
        pirate.attack +
        random_i64(-2, 4) -
        shield;

    damage =
        max_i64(
            1,
            damage
        );

    if defending {
        damage =
            max_i64(
                1,
                damage / 2
            );
    }

    damage_ship(
        &game.player.ship,
        damage
    );

    io_print("Le pirate inflige ");
    io_print_i64(damage);
    io_print(" degats a votre coque.\n");
}


/* ========================================================================= */
/* Escape                                                                     */
/* ========================================================================= */

proc try_escape(
    game: &Game
) -> bool {
    let chance: i64 =
        35 +
        game.player.ship.engine_level *
        10;

    return
        random_i64(1, 100) <=
        chance;
}


/* ========================================================================= */
/* Pirate combat                                                              */
/* ========================================================================= */

proc pirate_combat(
    game: &mut Game
) {
    let mut pirate: Pirate =
        create_pirate(
            &game.player
        );

    io_print("\n");
    separator();

    io_print(
        "ALERTE : VAISSEAU PIRATE\n"
    );

    separator();

    let mut combat: bool =
        true;

    while combat
        and
        pirate_alive(
            &pirate
        )
        and
        ship_alive(
            &game.player.ship
        )
    {
        io_print("\nVotre coque : ");
        io_print_i64(
            game.player.ship.hull
        );

        io_print("/");
        io_print_i64(
            game.player.ship.max_hull
        );

        println();

        io_print("Pirate : ");
        io_print_i64(
            pirate.health
        );

        io_print("/");
        io_print_i64(
            pirate.max_health
        );

        println();

        io_print("\n");
        io_print("1. Tirer\n");
        io_print("2. Defense\n");
        io_print("3. Fuir\n");
        io_print("> ");

        let action: i64 =
            io_read_i64();

        let mut defending: bool =
            false;

        if action == 1 {
            player_combat_attack(
                game,
                &pirate
            );
        } else if action == 2 {
            defending = true;

            io_print(
                "Boucliers renforces.\n"
            );
        } else if action == 3 {
            if try_escape(game) {
                io_print(
                    "Vous echappez au pirate !\n"
                );

                combat = false;
            } else {
                io_print(
                    "Impossible de semer le pirate !\n"
                );
            }
        } else {
            io_print(
                "Commande invalide.\n"
            );
        }

        if combat
            and
            pirate_alive(
                &pirate
            )
        {
            pirate_attack(
                game,
                &pirate,
                defending
            );
        }
    }

    if not ship_alive(
        &game.player.ship
    ) {
        game.state =
            GameState::Defeat;

        return;
    }

    if not pirate_alive(
        &pirate
    ) {
        io_print("\nPirate detruit !\n");

        io_print("Prime : ");
        io_print_i64(
            pirate.reward
        );
        io_print(" credits.\n");

        game.player.credits =
            game.player.credits +
            pirate.reward;

        game.player.pirates_destroyed =
            game.player.pirates_destroyed +
            1;

        game.player.reputation =
            game.player.reputation + 3;
    }
}


/* ========================================================================= */
/* Travel events                                                              */
/* ========================================================================= */

proc event_found_credits(
    game: &mut Game
) {
    let credits: i64 =
        random_i64(100, 600);

    io_print(
        "Vous trouvez une balise abandonnee contenant "
    );

    io_print_i64(
        credits
    );

    io_print(
        " credits.\n"
    );

    game.player.credits =
        game.player.credits +
        credits;
}


proc event_fuel_leak(
    game: &mut Game
) {
    let lost: i64 =
        random_i64(3, 12);

    game.player.ship.fuel =
        max_i64(
            0,
            game.player.ship.fuel -
            lost
        );

    io_print(
        "Fuite de carburant : -"
    );

    io_print_i64(
        lost
    );

    io_print(
        " carburant.\n"
    );
}


proc event_asteroid(
    game: &mut Game
) {
    let damage: i64 =
        random_i64(5, 20);

    damage_ship(
        &game.player.ship,
        damage
    );

    io_print(
        "Impact d'asteroide : -"
    );

    io_print_i64(
        damage
    );

    io_print(
        " coque.\n"
    );

    if not ship_alive(
        &game.player.ship
    ) {
        game.state =
            GameState::Defeat;
    }
}


proc event_free_cargo(
    game: &mut Game
) {
    let free: i64 =
        cargo_free(
            &game.player
        );

    if free <= 0 {
        return;
    }

    let quantity: i64 =
        min_i64(
            free,
            random_i64(1, 4)
        );

    cargo_add(
        &game.player.cargo,
        CommodityKind::Crystal,
        quantity
    );

    io_print(
        "Vous recuperez "
    );

    io_print_i64(
        quantity
    );

    io_print(
        " cristaux dans une epave.\n"
    );
}


proc travel_event(
    game: &mut Game
) {
    let event: i64 =
        random_i64(1, 100);

    if event > EVENT_CHANCE {
        return;
    }

    io_print("\nEVENEMENT DE VOYAGE\n");

    if event <= 8 {
        event_found_credits(
            game
        );

        return;
    }

    if event <= 16 {
        event_fuel_leak(
            game
        );

        return;
    }

    if event <= 24 {
        event_asteroid(
            game
        );

        return;
    }

    event_free_cargo(
        game
    );
}


/* ========================================================================= */
/* Travel                                                                     */
/* ========================================================================= */

proc travel(
    game: &mut Game
) {
    let destination: PlanetKind =
        read_planet();

    if destination ==
        game.player.planet
    {
        io_print(
            "Vous etes deja sur cette planete.\n"
        );

        return;
    }

    let cost: i64 =
        travel_fuel_cost(
            &game.player,
            destination
        );

    io_print("Cout carburant : ");
    io_print_i64(cost);
    println();

    if game.player.ship.fuel <
        cost
    {
        io_print(
            "Carburant insuffisant.\n"
        );

        return;
    }

    game.player.ship.fuel =
        game.player.ship.fuel -
        cost;

    io_print("\nDepart de ");

    print_planet_name(
        game.player.planet
    );

    io_print("...\n");

    game.player.planet =
        destination;

    game.player.journeys =
        game.player.journeys + 1;

    game.day =
        game.day + 1;

    update_market(
        game
    );

    travel_event(
        game
    );

    if game.state !=
        GameState::Playing
    {
        return;
    }

    let pirate_roll: i64 =
        random_i64(1, 100);

    if pirate_roll <=
        PIRATE_CHANCE
    {
        pirate_combat(
            game
        );
    }

    if game.state !=
        GameState::Playing
    {
        return;
    }

    io_print("\nArrivee sur ");

    print_planet_name(
        game.player.planet
    );

    io_print(".\n");
}


/* ========================================================================= */
/* Refuel                                                                     */
/* ========================================================================= */

proc fuel_price(
    game: &Game
) -> i64 {
    let variation: i64 =
        game.food_market /
        20;

    return
        BASE_FUEL_PRICE +
        variation;
}


proc refuel(
    game: &mut Game
) {
    let missing: i64 =
        game.player.ship.max_fuel -
        game.player.ship.fuel;

    if missing <= 0 {
        io_print(
            "Reservoir deja plein.\n"
        );

        return;
    }

    let price: i64 =
        fuel_price(
            game
        );

    io_print("Prix par unite : ");
    io_print_i64(price);
    println();

    io_print("Carburant manquant : ");
    io_print_i64(missing);
    println();

    io_print("Quantite : ");

    let requested: i64 =
        io_read_i64();

    if requested <= 0 {
        return;
    }

    let affordable: i64 =
        game.player.credits /
        price;

    let quantity: i64 =
        min_i64(
            missing,
            min_i64(
                requested,
                affordable
            )
        );

    if quantity <= 0 {
        io_print(
            "Credits insuffisants.\n"
        );

        return;
    }

    game.player.ship.fuel =
        game.player.ship.fuel +
        quantity;

    game.player.credits =
        game.player.credits -
        quantity * price;

    io_print("Carburant +");
    io_print_i64(quantity);
    println();
}


/* ========================================================================= */
/* Repair                                                                     */
/* ========================================================================= */

proc repair(
    game: &mut Game
) {
    let missing: i64 =
        game.player.ship.max_hull -
        game.player.ship.hull;

    if missing <= 0 {
        io_print(
            "Coque intacte.\n"
        );

        return;
    }

    let unit_price: i64 = 5;

    io_print("Degats : ");
    io_print_i64(missing);
    println();

    io_print(
        "Prix de reparation par point : 5\n"
    );

    io_print("Points a reparer : ");

    let requested: i64 =
        io_read_i64();

    if requested <= 0 {
        return;
    }

    let affordable: i64 =
        game.player.credits /
        unit_price;

    let repaired: i64 =
        min_i64(
            missing,
            min_i64(
                requested,
                affordable
            )
        );

    if repaired <= 0 {
        io_print(
            "Credits insuffisants.\n"
        );

        return;
    }

    game.player.ship.hull =
        game.player.ship.hull +
        repaired;

    game.player.credits =
        game.player.credits -
        repaired * unit_price;

    io_print("Coque reparee : +");
    io_print_i64(repaired);
    println();
}


/* ========================================================================= */
/* Upgrade prices                                                             */
/* ========================================================================= */

proc engine_upgrade_price(
    player: &Player
) -> i64 {
    return
        player.ship.engine_level *
        2500;
}


proc weapon_upgrade_price(
    player: &Player
) -> i64 {
    return
        player.ship.weapon_level *
        3000;
}


proc shield_upgrade_price(
    player: &Player
) -> i64 {
    return
        player.ship.shield_level *
        2800;
}


proc cargo_upgrade_price(
    player: &Player
) -> i64 {
    return
        player.ship.cargo_level *
        2000;
}


/* ========================================================================= */
/* Engine upgrade                                                             */
/* ========================================================================= */

proc upgrade_engine(
    game: &mut Game
) {
    if game.player.ship.engine_level >=
        MAX_ENGINE_LEVEL
    {
        io_print(
            "Moteur deja au niveau maximum.\n"
        );

        return;
    }

    let price: i64 =
        engine_upgrade_price(
            &game.player
        );

    if game.player.credits <
        price
    {
        io_print(
            "Credits insuffisants.\n"
        );

        return;
    }

    game.player.credits =
        game.player.credits -
        price;

    game.player.ship.engine_level =
        game.player.ship.engine_level + 1;

    game.player.ship.max_fuel =
        game.player.ship.max_fuel + 15;

    io_print(
        "Moteur ameliore !\n"
    );
}


/* ========================================================================= */
/* Weapon upgrade                                                             */
/* ========================================================================= */

proc upgrade_weapon(
    game: &mut Game
) {
    if game.player.ship.weapon_level >=
        MAX_WEAPON_LEVEL
    {
        io_print(
            "Armes deja au niveau maximum.\n"
        );

        return;
    }

    let price: i64 =
        weapon_upgrade_price(
            &game.player
        );

    if game.player.credits <
        price
    {
        io_print(
            "Credits insuffisants.\n"
        );

        return;
    }

    game.player.credits =
        game.player.credits -
        price;

    game.player.ship.weapon_level =
        game.player.ship.weapon_level + 1;

    io_print(
        "Systeme d'armes ameliore !\n"
    );
}


/* ========================================================================= */
/* Shield upgrade                                                             */
/* ========================================================================= */

proc upgrade_shield(
    game: &mut Game
) {
    if game.player.ship.shield_level >=
        MAX_SHIELD_LEVEL
    {
        io_print(
            "Bouclier deja au niveau maximum.\n"
        );

        return;
    }

    let price: i64 =
        shield_upgrade_price(
            &game.player
        );

    if game.player.credits <
        price
    {
        io_print(
            "Credits insuffisants.\n"
        );

        return;
    }

    game.player.credits =
        game.player.credits -
        price;

    game.player.ship.shield_level =
        game.player.ship.shield_level + 1;

    game.player.ship.max_hull =
        game.player.ship.max_hull + 15;

    game.player.ship.hull =
        game.player.ship.hull + 15;

    io_print(
        "Bouclier ameliore !\n"
    );
}


/* ========================================================================= */
/* Cargo upgrade                                                              */
/* ========================================================================= */

proc upgrade_cargo(
    game: &mut Game
) {
    if game.player.ship.cargo_level >=
        MAX_CARGO_LEVEL
    {
        io_print(
            "Soute deja au niveau maximum.\n"
        );

        return;
    }

    let price: i64 =
        cargo_upgrade_price(
            &game.player
        );

    if game.player.credits <
        price
    {
        io_print(
            "Credits insuffisants.\n"
        );

        return;
    }

    game.player.credits =
        game.player.credits -
        price;

    game.player.ship.cargo_level =
        game.player.ship.cargo_level + 1;

    game.player.ship.cargo_capacity =
        game.player.ship.cargo_capacity + 15;

    io_print(
        "Soute agrandie !\n"
    );
}


/* ========================================================================= */
/* Shipyard                                                                   */
/* ========================================================================= */

proc shipyard(
    game: &mut Game
) {
    let mut open: bool = true;

    while open {
        println();
        small_separator();

        io_print("CHANTIER SPATIAL\n");

        small_separator();

        io_print("Credits : ");
        io_print_i64(
            game.player.credits
        );
        println();

        io_print("\n1. Moteur niveau ");
        io_print_i64(
            game.player.ship.engine_level
        );

        io_print(" - ");
        io_print_i64(
            engine_upgrade_price(
                &game.player
            )
        );

        io_print(" credits\n");

        io_print("2. Armes niveau ");
        io_print_i64(
            game.player.ship.weapon_level
        );

        io_print(" - ");
        io_print_i64(
            weapon_upgrade_price(
                &game.player
            )
        );

        io_print(" credits\n");

        io_print("3. Bouclier niveau ");
        io_print_i64(
            game.player.ship.shield_level
        );

        io_print(" - ");
        io_print_i64(
            shield_upgrade_price(
                &game.player
            )
        );

        io_print(" credits\n");

        io_print("4. Soute niveau ");
        io_print_i64(
            game.player.ship.cargo_level
        );

        io_print(" - ");
        io_print_i64(
            cargo_upgrade_price(
                &game.player
            )
        );

        io_print(" credits\n");

        io_print("5. Retour\n");
        io_print("> ");

        let choice: i64 =
            io_read_i64();

        if choice == 1 {
            upgrade_engine(
                game
            );
        } else if choice == 2 {
            upgrade_weapon(
                game
            );
        } else if choice == 3 {
            upgrade_shield(
                game
            );
        } else if choice == 4 {
            upgrade_cargo(
                game
            );
        } else if choice == 5 {
            open = false;
        } else {
            io_print(
                "Commande inconnue.\n"
            );
        }
    }
}


