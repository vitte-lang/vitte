    io_print("4. Reparer\n");
    io_print("5. Chantier spatial\n");
    io_print("6. Statut\n");
    io_print("7. Aide\n");
    io_print("8. Quitter\n");
    io_print("> ");
}


/* ========================================================================= */
/* Victory                                                                    */
/* ========================================================================= */

proc check_victory(
    game: &mut Game
) {
    if game.player.credits >=
        WIN_CREDITS
    {
        game.state =
            GameState::Victory;
    }
}


/* ========================================================================= */
/* Introduction                                                               */
/* ========================================================================= */

proc introduction() {
    separator();

    io_print(
        "                 VITTE SPACE TRADER\n"
    );

    separator();

    io_print(
        "An 2487.\n"
    );

    io_print(
        "Vous prenez le commandement d'un petit cargo spatial.\n"
    );

    io_print(
        "Vous possedez 2500 credits et un vieux vaisseau.\n"
    );

    io_print(
        "Votre objectif : construire un empire commercial.\n"
    );

    io_print(
        "Fortune necessaire pour gagner : 100000 credits.\n"
    );

    separator();
}


/* ========================================================================= */
/* Game loop                                                                  */
/* ========================================================================= */

proc run_game(
    game: &mut Game
) {
    while game.state ==
        GameState::Playing
    {
        print_menu(
            game
        );

        let action: i64 =
            io_read_i64();

        if action == 1 {
            market_menu(
                game
            );
        } else if action == 2 {
            travel(
                game
            );
        } else if action == 3 {
            refuel(
                game
            );
        } else if action == 4 {
            repair(
                game
            );
        } else if action == 5 {
            shipyard(
                game
            );
        } else if action == 6 {
            status(
                game
            );
        } else if action == 7 {
            help();
        } else if action == 8 {
            game.state =
                GameState::Quit;
        } else {
            io_print(
                "Commande inconnue.\n"
            );
        }

        if game.state ==
            GameState::Playing
        {
            check_victory(
                game
            );
        }

        if not ship_alive(
            &game.player.ship
        ) {
            game.state =
                GameState::Defeat;
        }
    }
}


/* ========================================================================= */
/* Final screen                                                               */
/* ========================================================================= */

proc final_screen(
    game: &Game
) {
    println();

    separator();

    if game.state ==
        GameState::Victory
    {
        io_print(
            "                    VICTOIRE\n"
        );

        separator();

        io_print(
            "Votre empire commercial domine maintenant les routes stellaires.\n"
        );
    } else if game.state ==
        GameState::Defeat
    {
        io_print(
            "                    DEFAITE\n"
        );

        separator();

        io_print(
            "Votre vaisseau a ete detruit.\n"
        );
    } else {
        io_print(
            "                 FIN DE PARTIE\n"
        );

        separator();
    }

    io_print("Credits : ");
    io_print_i64(
        game.player.credits
    );

    println();

    io_print("Jours : ");
    io_print_i64(
        game.day
    );

    println();

    io_print("Voyages : ");
    io_print_i64(
        game.player.journeys
    );

    println();

    io_print("Transactions : ");
    io_print_i64(
        game.player.trades
    );

    println();

    io_print("Pirates detruits : ");
    io_print_i64(
        game.player.pirates_destroyed
    );

    println();

    io_print("Reputation : ");
    io_print_i64(
        game.player.reputation
    );

    println();

    separator();
}


/* ========================================================================= */
/* Entry                                                                      */
/* ========================================================================= */

pub proc main() -> i64 {
    introduction();

    let mut game: Game =
        create_game();

    run_game(
        &game
    );

    final_screen(
        &game
    );

    return 0;
}


/* ========================================================================= */
/* Tests                                                                      */
/* ========================================================================= */

test "cargo starts empty" {
    let cargo: Cargo =
        create_cargo();

    assert(
        cargo_used(
            &cargo
        ) == 0
    );
}


test "cargo add food" {
    let mut cargo: Cargo =
        create_cargo();

    cargo_add(
        &cargo,
        CommodityKind::Food,
        10
    );

    assert(
        cargo.food == 10
    );

    assert(
        cargo_used(
            &cargo
        ) == 10
    );
}


test "cargo remove" {
    let mut cargo: Cargo =
        create_cargo();

    cargo_add(
        &cargo,
        CommodityKind::Ore,
        20
    );

    cargo_remove(
        &cargo,
        CommodityKind::Ore,
        5
    );

    assert(
        cargo.ore == 15
    );
}


test "cargo cannot become negative" {
    let mut cargo: Cargo =
        create_cargo();

    cargo.technology = 5;

    cargo_remove(
        &cargo,
        CommodityKind::Technology,
        100
    );

    assert(
        cargo.technology == 0
    );
}


test "ship creation" {
    let ship: Ship =
        create_ship();

    assert(
        ship.hull ==
        START_HULL
    );

    assert(
        ship.fuel ==
        START_FUEL
    );

    assert(
        ship.cargo_capacity ==
        START_CARGO
    );

    assert(
        ship.engine_level == 1
    );
}


test "player creation" {
    let player: Player =
        create_player();

    assert(
        player.credits ==
        START_CREDITS
    );

    assert(
        player.planet ==
        PlanetKind::Terra
    );

    assert(
        player.journeys == 0
    );
}


test "game creation" {
    let game: Game =
        create_game();

    assert(
        game.state ==
        GameState::Playing
    );

    assert(
        game.day == 1
    );
}


test "distance same planet" {
    assert(
        distance_between(
            PlanetKind::Terra,
            PlanetKind::Terra
        ) == 8
    );
}


test "distance symmetry" {
    assert(
        distance_between(
            PlanetKind::Terra,
            PlanetKind::Mars
        ) ==
        distance_between(
            PlanetKind::Mars,
            PlanetKind::Terra
        )
    );
}


test "cargo free space" {
    let mut player: Player =
        create_player();

    assert(
        cargo_free(
            &player
        ) ==
        START_CARGO
    );

    cargo_add(
        &player.cargo,
        CommodityKind::Food,
        10
    );

    assert(
        cargo_free(
            &player
        ) ==
        START_CARGO - 10
    );
}


test "commodity base prices" {
    assert(
        base_price(
            CommodityKind::Food
        ) == 18
    );

    assert(
        base_price(
            CommodityKind::Ore
        ) == 35
    );

    assert(
        base_price(
            CommodityKind::Medicine
        ) == 80
    );

    assert(
        base_price(
            CommodityKind::Technology
        ) == 150
    );

    assert(
        base_price(
            CommodityKind::Crystal
        ) == 300
    );
}


test "ship damage" {
    let mut ship: Ship =
        create_ship();

    damage_ship(
        &ship,
        20
    );

    assert(
        ship.hull ==
        START_HULL - 20
    );
}


test "ship destruction" {
    let mut ship: Ship =
        create_ship();

    damage_ship(
        &ship,
        100000
    );

    assert(
        ship.hull == 0
    );

    assert(
        not ship_alive(
            &ship
        )
    );
}


test "pirate damage" {
    let player: Player =
        create_player();

    let mut pirate: Pirate =
        create_pirate(
            &player
        );

    let previous: i64 =
        pirate.health;

    damage_pirate(
        &pirate,
        10
    );

    assert(
        pirate.health ==
        previous - 10
    );
}


test "engine upgrade price" {
    let player: Player =
        create_player();

    assert(
        engine_upgrade_price(
            &player
        ) == 2500
    );
}


test "weapon upgrade price" {
    let player: Player =
        create_player();

    assert(
        weapon_upgrade_price(
            &player
        ) == 3000
    );
}


test "shield upgrade price" {
    let player: Player =
        create_player();

    assert(
        shield_upgrade_price(
            &player
        ) == 2800
    );
}


test "cargo upgrade price" {
    let player: Player =
        create_player();

    assert(
        cargo_upgrade_price(
            &player
        ) == 2000
    );
}


test "clamp" {
    assert(
        clamp_i64(
            50,
            0,
            100
        ) == 50
    );

    assert(
        clamp_i64(
            -10,
            0,
            100
        ) == 0
    );

    assert(
        clamp_i64(
            500,
            0,
            100
        ) == 100
    );
}


test "absolute" {
    assert(
        absolute_i64(-100) ==
        100
    );

    assert(
        absolute_i64(100) ==
        100
    );

    assert(
        absolute_i64(0) ==
        0
    );
}


test "victory" {
    let mut game: Game =
        create_game();

    game.player.credits =
        WIN_CREDITS;

    check_victory(
        &game
    );

    assert(
        game.state ==
        GameState::Victory
    );
}


test "no early victory" {
    let mut game: Game =
        create_game();

    game.player.credits =
        WIN_CREDITS - 1;

    check_victory(
        &game
    );

    assert(
        game.state ==
        GameState::Playing
    );
}