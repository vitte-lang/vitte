space games::space_trader;

/*
 * ============================================================================
 * VITTE SPACE TRADER
 * ============================================================================
 *
 * Jeu terminal 100 % Vitte.
 *
 * Objectif :
 *   - voyager entre les planetes
 *   - acheter et vendre des marchandises
 *   - gerer carburant, coque et cargaison
 *   - gagner des credits
 *   - survivre aux pirates
 *   - ameliorer le vaisseau
 *   - atteindre 100000 credits
 *
 * Aucun extern C.
 *
 * Intrinsics requis :
 *   io_print
 *   io_print_i64
 *   io_read_i64
 *   random_i64
 *
 * ============================================================================
 */


/* ========================================================================= */
/* Intrinsics                                                                 */
/* ========================================================================= */

intrinsic io_print(text: *u8);
intrinsic io_print_i64(value: i64);
intrinsic io_read_i64() -> i64;
intrinsic random_i64(minimum: i64, maximum: i64) -> i64;


/* ========================================================================= */
/* Constants                                                                  */
/* ========================================================================= */

const START_CREDITS: i64 = 2500;

const START_HULL: i64 = 100;
const START_FUEL: i64 = 100;
const START_CARGO: i64 = 30;

const MAX_ENGINE_LEVEL: i64 = 5;
const MAX_WEAPON_LEVEL: i64 = 5;
const MAX_SHIELD_LEVEL: i64 = 5;
const MAX_CARGO_LEVEL: i64 = 5;

const WIN_CREDITS: i64 = 100000;

const BASE_FUEL_PRICE: i64 = 8;

const PIRATE_CHANCE: i64 = 24;
const EVENT_CHANCE: i64 = 35;


/* ========================================================================= */
/* Enumerations                                                               */
/* ========================================================================= */

pick GameState {
    Playing,
    Victory,
    Defeat,
    Quit
}

pick PlanetKind {
    Terra,
    Luna,
    Mars,
    Europa,
    Titan,
    Vega,
    Orion
}

pick CommodityKind {
    Food,
    Ore,
    Medicine,
    Technology,
    Crystal
}

pick Action {
    Invalid,
    Market,
    Travel,
    Refuel,
    Repair,
    Ship,
    Status,
    Help,
    Quit
}

pick MarketAction {
    Invalid,
    Buy,
    Sell,
    Prices,
    Back
}

pick CombatAction {
    Invalid,
    Attack,
    Defend,
    Escape
}


/* ========================================================================= */
/* Cargo                                                                      */
/* ========================================================================= */

form Cargo {
    food: i64,
    ore: i64,
    medicine: i64,
    technology: i64,
    crystal: i64
}


/* ========================================================================= */
/* Ship                                                                       */
/* ========================================================================= */

form Ship {
    hull: i64,
    max_hull: i64,

    fuel: i64,
    max_fuel: i64,

    cargo_capacity: i64,

    engine_level: i64,
    weapon_level: i64,
    shield_level: i64,
    cargo_level: i64
}


/* ========================================================================= */
/* Player                                                                     */
/* ========================================================================= */

form Player {
    credits: i64,

    planet: PlanetKind,

    ship: Ship,
    cargo: Cargo,

    reputation: i64,

    trades: i64,
    journeys: i64,
    pirates_destroyed: i64,

    total_profit: i64
}


/* ========================================================================= */
/* Pirate                                                                     */
/* ========================================================================= */

form Pirate {
    health: i64,
    max_health: i64,

    attack: i64,
    defense: i64,

    reward: i64
}


/* ========================================================================= */
/* Game                                                                       */
/* ========================================================================= */

form Game {
    player: Player,

    state: GameState,

    day: i64,

    food_market: i64,
    ore_market: i64,
    medicine_market: i64,
    technology_market: i64,
    crystal_market: i64
}


/* ========================================================================= */
/* General utilities                                                          */
/* ========================================================================= */

proc println() {
    io_print("\n");
}


proc separator() {
    io_print(
        "============================================================\n"
    );
}


proc small_separator() {
    io_print(
        "------------------------------------------------------------\n"
    );
}


proc min_i64(
    left: i64,
    right: i64
) -> i64 {
    if left < right {
        return left;
    }

    return right;
}


proc max_i64(
    left: i64,
    right: i64
) -> i64 {
    if left > right {
        return left;
    }

    return right;
}


proc clamp_i64(
    value: i64,
    minimum: i64,
    maximum: i64
) -> i64 {
    if value < minimum {
        return minimum;
    }

    if value > maximum {
        return maximum;
    }

    return value;
}


/* ========================================================================= */
/* Cargo                                                                      */
/* ========================================================================= */

proc create_cargo() -> Cargo {
    let mut cargo: Cargo;

    cargo.food = 0;
    cargo.ore = 0;
    cargo.medicine = 0;
    cargo.technology = 0;
    cargo.crystal = 0;

    return cargo;
}


proc cargo_used(
    cargo: &Cargo
) -> i64 {
    return
        cargo.food +
        cargo.ore +
        cargo.medicine +
        cargo.technology +
        cargo.crystal;
}


proc cargo_free(
    player: &Player
) -> i64 {
    return
        player.ship.cargo_capacity -
        cargo_used(
            &player.cargo
        );
}


proc cargo_quantity(
    cargo: &Cargo,
    commodity: CommodityKind
) -> i64 {
    if commodity ==
        CommodityKind::Food
    {
        return cargo.food;
    }

    if commodity ==
        CommodityKind::Ore
    {
        return cargo.ore;
    }

    if commodity ==
        CommodityKind::Medicine
    {
        return cargo.medicine;
    }

    if commodity ==
        CommodityKind::Technology
    {
        return cargo.technology;
    }

    return cargo.crystal;
}


proc cargo_add(
    cargo: &mut Cargo,
    commodity: CommodityKind,
    quantity: i64
) {
    if quantity <= 0 {
        return;
    }

    if commodity ==
        CommodityKind::Food
    {
        cargo.food =
            cargo.food + quantity;

        return;
    }

    if commodity ==
        CommodityKind::Ore
    {
        cargo.ore =
            cargo.ore + quantity;

        return;
    }

    if commodity ==
        CommodityKind::Medicine
    {
        cargo.medicine =
            cargo.medicine + quantity;

        return;
    }

    if commodity ==
        CommodityKind::Technology
    {
        cargo.technology =
            cargo.technology + quantity;

        return;
    }

    cargo.crystal =
        cargo.crystal + quantity;
}


proc cargo_remove(
    cargo: &mut Cargo,
    commodity: CommodityKind,
    quantity: i64
) {
    if quantity <= 0 {
        return;
    }

    if commodity ==
        CommodityKind::Food
    {
        cargo.food =
            max_i64(
                0,
                cargo.food - quantity
            );

        return;
    }

    if commodity ==
        CommodityKind::Ore
    {
        cargo.ore =
            max_i64(
                0,
                cargo.ore - quantity
            );

        return;
    }

    if commodity ==
        CommodityKind::Medicine
    {
        cargo.medicine =
            max_i64(
                0,
                cargo.medicine - quantity
            );

        return;
    }

    if commodity ==
        CommodityKind::Technology
    {
        cargo.technology =
            max_i64(
                0,
                cargo.technology - quantity
            );

        return;
    }

    cargo.crystal =
        max_i64(
            0,
            cargo.crystal - quantity
        );
}


/* ========================================================================= */
/* Ship                                                                       */
/* ========================================================================= */

proc create_ship() -> Ship {
    let mut ship: Ship;

    ship.hull =
        START_HULL;

    ship.max_hull =
        START_HULL;

    ship.fuel =
        START_FUEL;

    ship.max_fuel =
        START_FUEL;

    ship.cargo_capacity =
        START_CARGO;

    ship.engine_level = 1;
    ship.weapon_level = 1;
    ship.shield_level = 1;
    ship.cargo_level = 1;

    return ship;
}


/* ========================================================================= */
/* Player                                                                     */
/* ========================================================================= */

proc create_player() -> Player {
    let mut player: Player;

    player.credits =
        START_CREDITS;

    player.planet =
        PlanetKind::Terra;

    player.ship =
        create_ship();

    player.cargo =
        create_cargo();

    player.reputation = 0;

    player.trades = 0;
    player.journeys = 0;
    player.pirates_destroyed = 0;

    player.total_profit = 0;

    return player;
}


/* ========================================================================= */
/* Game                                                                       */
/* ========================================================================= */

proc create_game() -> Game {
    let mut game: Game;

    game.player =
        create_player();

    game.state =
        GameState::Playing;

    game.day = 1;

    game.food_market = 100;
    game.ore_market = 100;
    game.medicine_market = 100;
    game.technology_market = 100;
    game.crystal_market = 100;

    return game;
}


/* ========================================================================= */
/* Names                                                                      */
/* ========================================================================= */

