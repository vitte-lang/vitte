/// Fixed arrays lowered through native HIR, IR, and the C17 IR backend.

space compiler/native_fixed_array_runtime;

proc main() -> i64 {
    let mut values: [3]i64 = [10, 20, 30];
    set values[1] = 42;
    if values[0] + values[1] + values[2] != 82 {
        return 1;
    }

    let mut bytes: [2]u8 = [7 as u8, 255 as u8];
    set bytes[0] = 9 as u8;
    if bytes[0] != 9 or bytes[1] != 255 {
        return 2;
    }

    let inferred = [2, 4, 6];
    if inferred[0] + inferred[1] + inferred[2] != 12 {
        return 3;
    }

    let mut matrix: [2][2]i64 = [[1, 2], [3, 4]];
    set matrix[1][0] = 7;
    if matrix[1][0] != 7 {
        return 4;
    }
    return 0;
}
