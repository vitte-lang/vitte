/// C17 executable port of the former MIR loop-target probe.
///
/// Invalid loop targets are covered by the negative parser/sema corpus. This
/// runtime fixture covers the executable side: break exits the active loop and
/// continue targets the next iteration without losing loop state.

space compiler/mir_loop_targets_runtime;

proc break_value() -> i64 {
    let mut value: i64 = 0;

    while value < 10 {
        if value == 4 {
            break;
        }
        set value = value + 1;
    }
    give value;
}

proc continue_sum() -> i64 {
    let mut value: i64 = 0;
    let mut total: i64 = 0;

    while value < 5 {
        set value = value + 1;
        if value == 3 {
            continue;
        }
        set total = total + value;
    }
    give total;
}

proc main() -> int {
    if break_value() != 4 {
        give 1;
    }
    if continue_sum() != 12 {
        give 2;
    }
    give 0;
}
