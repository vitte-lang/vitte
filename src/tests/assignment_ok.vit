    if not test_assignment_from_logical_expression() {
        return 63;
    }

    if not test_assignment_dependency_order() {
        return 64;
    }

    if not test_rhs_uses_old_target_value() {
        return 65;
    }

    if not test_rhs_nested_old_target_value() {
        return 66;
