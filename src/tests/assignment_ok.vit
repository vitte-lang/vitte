        return 16;
    }

    if not test_mod_assignment() {
        return 17;
    }

    if not test_compound_assignment_chain() {
        return 18;
    }

    if not test_multiple_mutable_locals() {
        return 19;
    }

    if not test_independent_mutation() {
        return 20;
    }

    if not test_swap_scalars() {
        return 21;
    }

    if not test_assignment_in_if() {
        return 22;
    }

    if not test_assignment_in_false_branch_shape() {
        return 23;
    }

    if test_conditional_assignment(true) != FORTY_TWO {
        return 24;
    }

    if test_conditional_assignment(false) != ZERO {
        return 25;
    }

    if not test_nested_if_assignment() {
        return 26;
    }

    if not test_assignment_in_nested_scope() {
        return 27;
    }

    if not test_deep_nested_assignment() {
        return 28;
    }

    if not test_shadowing_preserves_outer() {
        return 29;
    }

    if not test_mutable_shadowing() {
        return 30;
    }

    if not test_loop_assignment() {
        return 31;
    }

    if not test_loop_compound_assignment() {
        return 32;
    }

    if not test_loop_two_mutations() {
        return 33;
    }

    if not test_loop_call_assignment() {
        return 34;
    }

    if not test_loop_nested_scope_assignment() {
        return 35;
    }

    if not test_boolean_assignment() {
        return 36;
    }

    if not test_boolean_not_assignment() {
        return 37;
    }

    if not test_boolean_expression_assignment() {
        return 38;
    }

    if not test_boolean_repeated_assignment() {
        return 39;
    }

    if not test_boolean_toggle() {
        return 40;
    }

    if not test_boolean_loop_assignment() {
        return 41;
    }

    if not test_unsigned_assignment() {
        return 42;
    }

    if not test_unsigned_compound_assignment() {
        return 43;
    }

    if not test_float_assignment() {
        return 44;
    }

    if not test_float_arithmetic_assignment() {
        return 45;
    }

    if not test_float_compound_assignment() {
        return 46;
    }

    if not test_point_assignment() {
        return 47;
    }

    if not test_point_assignment_variable() {
        return 48;
    }

    if not test_point_repeated_assignment() {
        return 49;
    }

    if not test_point_transform_assignment() {
        return 50;
    }

    if not test_point_swap_assignment() {
        return 51;
    }

    if not test_pair_assignment() {
        return 52;
    }

    if not test_record_assignment() {
        return 53;
    }

    if not test_nested_assignment() {
        return 54;
    }

    if not test_aggregate_assignment_chain() {
        return 55;
    }

    if not test_aggregate_assignment_in_loop() {
        return 56;
    }

    if not test_pair_assignment_in_loop() {
        return 57;
    }

    if not test_assignment_from_aggregate_fields() {
        return 58;
    }

    if not test_assignment_from_nested_fields() {
        return 59;
