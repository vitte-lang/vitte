/// Assignment semantics and runtime coverage.
///
/// Comprehensive positive fixture for mutable local assignment.
///
/// Coverage:
/// - mutable local declarations;
/// - direct assignment;
/// - assignment from literals;
/// - assignment from constants;
/// - assignment from variables;
/// - assignment from procedure calls;
/// - assignment from arithmetic expressions;
/// - assignment from comparison expressions;
/// - assignment from logical expressions;
/// - repeated assignment;
/// - assignment inside nested scopes;
/// - assignment inside conditionals;
/// - assignment inside loops;
/// - assignment to boolean locals;
/// - assignment to signed integers;
/// - assignment to unsigned integers;
/// - assignment to floating-point values;
/// - aggregate replacement;
/// - aggregate values returned by procedures;
/// - aggregate transformation pipelines;
/// - shadowing without corrupting the outer mutable binding;
/// - assignments using the previous value of the target;
/// - compound assignment operators;
/// - evaluation of right-hand expressions before replacement;
/// - long mutation chains;
/// - multiple independent mutable locals.
///
/// Expected result:
/// - lexing succeeds;
/// - parsing succeeds;
/// - name resolution succeeds;
/// - semantic assignment checks succeed;
/// - lowering preserves mutation semantics;
/// - runtime checks all succeed;
/// - `main` returns 0.

space tests::assignment_ok;

const ZERO: i64 = 0;
const ONE: i64 = 1;
const TWO: i64 = 2;
const THREE: i64 = 3;
const FOUR: i64 = 4;
const FIVE: i64 = 5;
const SIX: i64 = 6;
const SEVEN: i64 = 7;
const TEN: i64 = 10;
const TWENTY: i64 = 20;
const TWENTY_ONE: i64 = 21;
const TWENTY_TWO: i64 = 22;
const FORTY: i64 = 40;
const FORTY_ONE: i64 = 41;
const FORTY_TWO: i64 = 42;
const ONE_HUNDRED: i64 = 100;

form Point {
    x: i64,
    y: i64,
}

form Pair {
    first: i64,
    second: i64,
}

form Record {
    value: i64,
    enabled: bool,
}

form Nested {
    point: Point,
    pair: Pair,
    record: Record,
}

proc identity(
    value: i64
) -> i64 {
    return value;
}

proc add(
    left: i64,
    right: i64
) -> i64 {
    return left + right;
}

proc subtract(
    left: i64,
    right: i64
) -> i64 {
    return left - right;
}

proc multiply(
    left: i64,
    right: i64
) -> i64 {
    return left * right;
}

proc increment(
    value: i64
) -> i64 {
    return value + ONE;
}

proc decrement(
    value: i64
) -> i64 {
    return value - ONE;
}

proc is_answer(
    value: i64
) -> bool {
    return value == FORTY_TWO;
}

proc make_point(
    x: i64,
    y: i64
) -> Point {
    return Point {
        x: x,
        y: y,
    };
}

proc make_zero_point() -> Point {
    return Point {
        x: ZERO,
        y: ZERO,
    };
}

proc make_answer_point() -> Point {
    return Point {
        x: TWENTY,
        y: TWENTY_TWO,
    };
}

proc point_sum(
    point: &Point
) -> i64 {
    return point.x +
         point.y;
}

proc point_equal(
    left: &Point,
    right: &Point
) -> bool {
    return left.x == right.x and
         left.y == right.y;
}

proc point_translate(
    point: &Point,
    dx: i64,
    dy: i64
) -> Point {
    return Point {
        x: point.x + dx,
        y: point.y + dy,
    };
}

proc point_swap(
    point: &Point
) -> Point {
    return Point {
        x: point.y,
        y: point.x,
    };
}

proc make_pair(
    first: i64,
    second: i64
) -> Pair {
    return Pair {
        first: first,
        second: second,
    };
}

proc make_answer_pair() -> Pair {
    return Pair {
        first: TWENTY,
        second: TWENTY_TWO,
    };
}

proc pair_sum(
    pair: &Pair
) -> i64 {
    return pair.first +
         pair.second;
}

proc make_record(
    value: i64,
    enabled: bool
) -> Record {
    return Record {
        value: value,
        enabled: enabled,
    };
}

proc make_answer_record() -> Record {
    return Record {
        value: FORTY_TWO,
        enabled: true,
    };
}

proc record_valid(
    record: &Record
) -> bool {
    return record.value == FORTY_TWO and
         record.enabled;
}

proc make_nested(
    point: Point,
    pair: Pair,
    record: Record
) -> Nested {
    return Nested {
        point: point,
        pair: pair,
        record: record,
    };
}

proc make_answer_nested() -> Nested {
    let point: Point =
        make_answer_point();

    let pair: Pair =
        make_answer_pair();

    let record: Record =
        make_answer_record();

    return make_nested(
        point,
        pair,
        record);
}

proc nested_valid(
    nested: &Nested
) -> bool {
    return point_sum(&nested.point) == FORTY_TWO and
         pair_sum(&nested.pair) == FORTY_TWO and
         record_valid(&nested.record);
}

proc test_direct_assignment() -> bool {
    let mut value: i64 = ZERO;

    set value = FORTY_TWO;

    return value == FORTY_TWO;
}

proc test_assignment_literal() -> bool {
    let mut value: i64 = ZERO;

    set value = 42;

    return value == FORTY_TWO;
}

proc test_assignment_constant() -> bool {
    let mut value: i64 = ZERO;

    set value = FORTY_TWO;

    return value == FORTY_TWO;
}

proc test_assignment_variable() -> bool {
    let source: i64 =
        FORTY_TWO;

    let mut destination: i64 =
        ZERO;

    set destination =
        source;

    return destination == FORTY_TWO and
         source == FORTY_TWO;
}

proc test_assignment_call() -> bool {
    let mut value: i64 =
        ZERO;

    set value =
        identity(
            FORTY_TWO);

    return value == FORTY_TWO;
}

proc test_assignment_nested_call() -> bool {
    let mut value: i64 =
        ZERO;

    set value =
        identity(
            add(
                TWENTY,
                TWENTY_TWO));

    return value == FORTY_TWO;
}

proc test_assignment_arithmetic() -> bool {
    let mut value: i64 =
        ZERO;

    set value =
        TWENTY +
        TWENTY_TWO;

    return value == FORTY_TWO;
}

proc test_assignment_previous_value() -> bool {
    let mut value: i64 =
        FORTY_ONE;

    set value =
        value + ONE;

    return value == FORTY_TWO;
}

proc test_assignment_previous_value_call() -> bool {
    let mut value: i64 =
        FORTY_ONE;

    set value =
        increment(value);

    return value == FORTY_TWO;
}

proc test_repeated_assignment() -> bool {
    let mut value: i64 =
        ZERO;

    set value = TEN;
    set value = TWENTY;
    set value = TWENTY_ONE;
    set value = FORTY_ONE;
    set value = FORTY_TWO;

    return value == FORTY_TWO;
}

proc test_increment_chain() -> bool {
    let mut value: i64 =
        FORTY;

    set value =
        increment(value);

    set value =
        increment(value);

    return value == FORTY_TWO;
}

proc test_decrement_chain() -> bool {
    let mut value: i64 =
        44;

    set value =
        decrement(value);

    set value =
        decrement(value);

    return value == FORTY_TWO;
}

proc test_add_assignment() -> bool {
    let mut value: i64 =
        TWENTY;

    set value +=
        TWENTY_TWO;

    return value == FORTY_TWO;
}

proc test_sub_assignment() -> bool {
    let mut value: i64 =
        64;

    set value -=
        TWENTY_TWO;

    return value == FORTY_TWO;
}

proc test_mul_assignment() -> bool {
    let mut value: i64 =
        SEVEN;

    set value *=
        SIX;

    return value == FORTY_TWO;
}

proc test_div_assignment() -> bool {
    let mut value: i64 =
        84;

    set value /=
        TWO;

    return value == FORTY_TWO;
}

proc test_mod_assignment() -> bool {
    let mut value: i64 =
        142;

    set value %=
        ONE_HUNDRED;

    return value == FORTY_TWO;
}

proc test_compound_assignment_chain() -> bool {
    let mut value: i64 =
        TEN;

    set value += TEN;
    set value += TWENTY_TWO;
    set value *= TWO;
    set value /= TWO;
    set value -= ZERO;

    return value == FORTY_TWO;
}

proc test_multiple_mutable_locals() -> bool {
    let mut left: i64 =
        ZERO;

    let mut right: i64 =
        ZERO;

    set left =
        TWENTY;

    set right =
        TWENTY_TWO;

    return left + right ==
         FORTY_TWO;
}

proc test_independent_mutation() -> bool {
    let mut first: i64 =
        TEN;

    let mut second: i64 =
        TWENTY;

    let mut third: i64 =
        12;

    set first =
        first + TEN;

    set second =
        second + TWO;

    set third =
        ZERO;

    return first == TWENTY and
         second == TWENTY_TWO and
         third == ZERO and
         first + second ==
             FORTY_TWO;
}

proc test_swap_scalars() -> bool {
    let mut left: i64 =
        TWENTY;

    let mut right: i64 =
        TWENTY_TWO;

    let temporary: i64 =
        left;

    set left =
        right;

    set right =
        temporary;

    return left == TWENTY_TWO and
         right == TWENTY and
         left + right ==
             FORTY_TWO;
}

proc test_assignment_in_if() -> bool {
    let mut value: i64 =
        ZERO;

    if true {
        set value =
            FORTY_TWO;
    }

    return value == FORTY_TWO;
}

proc test_assignment_in_false_branch_shape() -> bool {
    let mut value: i64 =
        FORTY_TWO;

    if false {
        set value =
            ZERO;
    }

    return value == FORTY_TWO;
}

proc test_conditional_assignment(
    condition: bool
) -> i64 {
    let mut value: i64 =
        ZERO;

    if condition {
        set value =
            FORTY_TWO;
    }

    return value;
}

proc test_nested_if_assignment() -> bool {
    let mut value: i64 =
        ZERO;

    if true {
        if TWENTY < TWENTY_TWO {
            if FORTY_TWO == 42 {
                set value =
                    FORTY_TWO;
            }
        }
    }

    return value == FORTY_TWO;
}

proc test_assignment_in_nested_scope() -> bool {
    let mut value: i64 =
        ZERO;

    {
        set value =
            TWENTY;

        {
            set value =
                value +
                TWENTY_TWO;
        }
    }

    return value == FORTY_TWO;
}

proc test_deep_nested_assignment() -> bool {
    let mut value: i64 =
        ZERO;

    {
        {
            {
                {
                    set value =
                        FORTY_TWO;
                }
            }
        }
    }

    return value == FORTY_TWO;
}

proc test_shadowing_preserves_outer() -> bool {
    let mut value: i64 =
        FORTY_TWO;

    {
        let value: i64 =
            ZERO;

        if value != ZERO {
            return false;
        }
    }

    return value == FORTY_TWO;
}

proc test_mutable_shadowing() -> bool {
    let mut value: i64 =
        TWENTY;

    {
        let mut value: i64 =
            ZERO;

        set value =
            ONE;

        if value != ONE {
            return false;
        }
    }

    set value +=
        TWENTY_TWO;

    return value == FORTY_TWO;
}

proc test_loop_assignment() -> bool {
    let mut value: i64 =
        ZERO;

    while value < FORTY_TWO {
        set value =
            value + ONE;
    }

    return value == FORTY_TWO;
}

proc test_loop_compound_assignment() -> bool {
    let mut value: i64 =
        ZERO;

    while value < FORTY_TWO {
        set value +=
            ONE;
    }

    return value == FORTY_TWO;
}

proc test_loop_two_mutations() -> bool {
    let mut index: i64 =
        ZERO;

    let mut total: i64 =
        ZERO;

    while index < TWO {
        set total +=
            TWENTY_ONE;

        set index +=
            ONE;
    }

    return index == TWO and
         total == FORTY_TWO;
}

proc test_loop_call_assignment() -> bool {
    let mut index: i64 =
        FORTY;

    while index < FORTY_TWO {
        set index =
            increment(index);
    }

    return index == FORTY_TWO;
}

proc test_loop_nested_scope_assignment() -> bool {
    let mut index: i64 =
        ZERO;

    let mut total: i64 =
        ZERO;

    while index < TWO {
        {
            let amount: i64 =
                TWENTY_ONE;

            set total =
                total +
                amount;
        }

        set index =
            index + ONE;
    }

    return total == FORTY_TWO;
}

proc test_boolean_assignment() -> bool {
    let mut value: bool =
        false;

    set value =
        true;

    return value;
}

proc test_boolean_not_assignment() -> bool {
    let mut value: bool =
        false;

    set value =
        not value;

    return value;
}

proc test_boolean_expression_assignment() -> bool {
    let mut value: bool =
        false;

    set value =
        TWENTY < TWENTY_TWO and
        FORTY_TWO == 42;

    return value;
}

proc test_boolean_repeated_assignment() -> bool {
    let mut value: bool =
        false;

    set value = true;
    set value = false;
    set value = true;

    return value;
}

proc test_boolean_toggle() -> bool {
    let mut value: bool =
        false;

    set value =
        not value;

    set value =
        not value;

    set value =
        not value;

    return value;
}

proc test_boolean_loop_assignment() -> bool {
    let mut running: bool =
        true;

    let mut value: i64 =
        ZERO;

    while running {
        set value =
            value + ONE;

        if value == FORTY_TWO {
            set running =
                false;
        }
    }

    return not running and
         value == FORTY_TWO;
}

proc test_unsigned_assignment() -> bool {
    let mut value: u64 =
        0;

    set value =
        42;

    return value == 42;
}

proc test_unsigned_compound_assignment() -> bool {
    let mut value: u64 =
        20;

    set value +=
        22;

    return value == 42;
}

proc test_float_assignment() -> bool {
    let mut value: f64 =
        0.0;

    set value =
        42.0;

    return value == 42.0;
}

proc test_float_arithmetic_assignment() -> bool {
    let mut value: f64 =
        20.0;

    set value =
        value + 22.0;

    return value == 42.0;
}

proc test_float_compound_assignment() -> bool {
    let mut value: f64 =
        21.0;

    set value *=
        2.0;

    return value == 42.0;
}

proc test_point_assignment() -> bool {
    let mut point: Point =
        make_zero_point();

    set point =
        make_answer_point();

    return point_sum(
        &point) == FORTY_TWO;
}

proc test_point_assignment_variable() -> bool {
    let replacement: Point =
        make_answer_point();

    let mut point: Point =
        make_zero_point();

    set point =
        replacement;

    return point_equal(
        &point,
        &replacement);
}

proc test_point_repeated_assignment() -> bool {
    let mut point: Point =
        make_zero_point();

    set point =
        make_point(
            TEN,
            TEN);

    set point =
        make_point(
            TWENTY,
            TWENTY_TWO);

    return point_sum(
        &point) == FORTY_TWO;
}

proc test_point_transform_assignment() -> bool {
    let mut point: Point =
        make_point(
            TEN,
            TEN);

    let transformed: Point =
        point_translate(
            &point,
            TEN,
            12);

    set point =
        transformed;

    return point.x == TWENTY and
         point.y == TWENTY_TWO and
         point_sum(&point) == FORTY_TWO;
}

proc test_point_swap_assignment() -> bool {
    let mut point: Point =
        make_answer_point();

    let swapped: Point =
        point_swap(
            &point);

    set point =
        swapped;

    return point.x == TWENTY_TWO and
         point.y == TWENTY and
         point_sum(&point) == FORTY_TWO;
}

proc test_pair_assignment() -> bool {
    let mut pair: Pair =
        make_pair(
            ZERO,
            ZERO);

    set pair =
        make_answer_pair();

    return pair_sum(
        &pair) == FORTY_TWO;
}

proc test_record_assignment() -> bool {
    let mut record: Record =
        make_record(
            ZERO,
            false);

    set record =
        make_answer_record();

    return record_valid(
        &record);
}

proc test_nested_assignment() -> bool {
    let mut nested: Nested =
        make_nested(
            make_zero_point(),
            make_pair(ZERO, ZERO),
            make_record(ZERO, false));

    set nested =
        make_answer_nested();

    return nested_valid(
        &nested);
}

proc test_aggregate_assignment_chain() -> bool {
    let mut point: Point =
        make_zero_point();

    let first: Point =
        make_point(
            TEN,
            TEN);

    let second: Point =
        point_translate(
            &first,
            TEN,
            12);

    set point =
        first;

    if point_sum(&point) != TWENTY {
        return false;
    }

    set point =
        second;

    return point_sum(&point) == FORTY_TWO;
}

proc test_aggregate_assignment_in_loop() -> bool {
    let mut point: Point =
        make_zero_point();

    let mut index: i64 =
        ZERO;

    while index < TWO {
        let next: Point =
            point_translate(
                &point,
                TEN,
                11);

        set point =
            next;

        set index +=
            ONE;
    }

    return point.x == TWENTY and
         point.y == TWENTY_TWO and
         point_sum(&point) == FORTY_TWO;
}

proc test_pair_assignment_in_loop() -> bool {
    let mut pair: Pair =
        make_pair(
            ZERO,
            ZERO);

    let mut index: i64 =
        ZERO;

    while index < TWO {
        let next: Pair =
            make_pair(
                pair.first + TEN,
                pair.second + 11);

        set pair =
            next;

        set index =
            index + ONE;
    }

    return pair.first == TWENTY and
         pair.second == TWENTY_TWO and
         pair_sum(&pair) == FORTY_TWO;
}

proc test_assignment_from_aggregate_fields() -> bool {
    let point: Point =
        make_answer_point();

    let mut left: i64 =
        ZERO;

    let mut right: i64 =
        ZERO;

    set left =
        point.x;

    set right =
        point.y;

    return left == TWENTY and
         right == TWENTY_TWO and
         left + right ==
             FORTY_TWO;
}

proc test_assignment_from_nested_fields() -> bool {
    let nested: Nested =
        make_answer_nested();

    let mut value: i64 =
        ZERO;

    set value =
        nested.record.value;

    return value == FORTY_TWO;
}

proc test_assignment_from_reference_field() -> bool {
    let point: Point =
        make_answer_point();

    let reference: &Point =
        &point;

    let mut value: i64 =
        ZERO;

    set value =
        reference.x +
        reference.y;

    return value == FORTY_TWO;
}

proc test_assignment_from_comparison() -> bool {
    let mut value: bool =
        false;

    set value =
        FORTY_TWO > ZERO;

    return value;
}

proc test_assignment_from_equality() -> bool {
    let mut value: bool =
        false;

    set value =
        TWENTY + TWENTY_TWO ==
        FORTY_TWO;

    return value;
}

proc test_assignment_from_logical_expression() -> bool {
    let mut value: bool =
        false;

    set value =
        (TWENTY < TWENTY_TWO) and
        (FORTY_TWO == FORTY_TWO) and
        not (ZERO == ONE);

    return value;
}

proc test_assignment_dependency_order() -> bool {
    let mut first: i64 =
        TWENTY;

    let mut second: i64 =
        TWENTY_TWO;

    set first =
        first + second;

    set second =
        first - second;

    return first == FORTY_TWO and
         second == TWENTY;
}

proc test_rhs_uses_old_target_value() -> bool {
    let mut value: i64 =
        TWENTY;

    set value =
        value +
        TWENTY_TWO;

    return value == FORTY_TWO;
}

proc test_rhs_nested_old_target_value() -> bool {
    let mut value: i64 =
        TWENTY;

    set value =
        add(
            identity(value),
            TWENTY_TWO);

    return value == FORTY_TWO;
}

proc test_long_assignment_chain() -> bool {
    let mut value: i64 =
        ZERO;

    set value += ONE;
    set value += TWO;
    set value += THREE;
    set value += FOUR;
    set value += FIVE;
    set value += SIX;
    set value += SEVEN;
    set value += TEN;
    set value += FOUR;

    return value == FORTY_TWO;
}

proc test_reset_assignment_chain() -> bool {
    let mut value: i64 =
        ZERO;

    set value =
        ONE_HUNDRED;

    set value =
        ZERO;

    set value =
        FORTY_TWO;

    return value == FORTY_TWO;
}

proc test_nested_mutation_pipeline() -> bool {
    let mut first: i64 =
        ZERO;

    let mut second: i64 =
        ZERO;

    {
        set first =
            TWENTY;

        {
            set second =
                TWENTY_TWO;

            {
                set first =
                    identity(first);

                set second =
                    identity(second);
            }
        }
    }

    return first + second ==
         FORTY_TWO;
}

proc test_assignment_after_loop() -> bool {
    let mut index: i64 =
        ZERO;

    let mut result: i64 =
        ZERO;

    while index < TWO {
        set result +=
            TEN;

        set index +=
            ONE;
    }

    set result +=
        TWENTY_TWO;

    return result == FORTY_TWO;
}

proc test_assignment_before_loop() -> bool {
    let mut value: i64 =
        ZERO;

    set value =
        FORTY;

    while value < FORTY_TWO {
        set value +=
            ONE;
    }

    return value == FORTY_TWO;
}

proc test_assignment_across_condition_and_loop() -> bool {
    let mut value: i64 =
        ZERO;

    if true {
        set value =
            TWENTY;
    }

    while value < FORTY_TWO {
        set value +=
            ONE;
    }

    return value == FORTY_TWO;
}

proc test_boolean_and_scalar_mutation() -> bool {
    let mut value: i64 =
        ZERO;

    let mut running: bool =
        true;

    while running {
        set value +=
            ONE;

        set running =
            value < FORTY_TWO;
    }

    return value == FORTY_TWO and
         not running;
}

proc test_mutation_from_parameters(
    initial: i64,
    amount: i64
) -> bool {
    let mut value: i64 =
        initial;

    set value +=
        amount;

    return value == FORTY_TWO;
}

proc test_mutation_from_boolean_parameter(
    initial: bool
) -> bool {
    let mut value: bool =
        initial;

    set value =
        not value;

    return value != initial;
}

proc test_mutation_with_local_copy(
    initial: i64
) -> bool {
    let source: i64 =
        initial;

    let mut value: i64 =
        ZERO;

    set value =
        source;

    return value == source;
}

proc test_mutation_with_call_result(
    left: i64,
    right: i64
) -> bool {
    let mut value: i64 =
        ZERO;

    set value =
        add(
            left,
            right);

    return value == FORTY_TWO;
}

proc test_assignment_expression_complexity() -> bool {
    let mut value: i64 =
        ZERO;

    set value =
        multiply(
            add(
                TEN,
                ONE),
            FOUR) -
        TWO;

    return value == FORTY_TWO;
}

proc test_boolean_assignment_complexity() -> bool {
    let mut value: bool =
        false;

    set value =
        (
            TWENTY < TWENTY_TWO and
            FORTY_TWO > ZERO
        ) and
        (
            FORTY_TWO == 42 or
            ZERO == ONE
        ) and
        not (
            ONE_HUNDRED < FORTY_TWO
        );

    return value;
}

proc test_repeated_same_value_assignment() -> bool {
    let mut value: i64 =
        FORTY_TWO;

    set value = FORTY_TWO;
    set value = FORTY_TWO;
    set value = FORTY_TWO;
    set value = FORTY_TWO;

    return value == FORTY_TWO;
}

proc test_zero_assignment() -> bool {
    let mut value: i64 =
        FORTY_TWO;

    set value =
        ZERO;

    return value == ZERO;
}

proc test_negative_assignment() -> bool {
    let mut value: i64 =
        ZERO;

    set value =
        -FORTY_TWO;

    return value == -FORTY_TWO;
}

proc test_negative_to_positive_assignment() -> bool {
    let mut value: i64 =
        -FORTY_TWO;

    set value =
        FORTY_TWO;

    return value == FORTY_TWO;
}

proc test_assignment_boundary_values() -> bool {
    let mut value: i64 =
        -ONE_HUNDRED;

    if value != -ONE_HUNDRED {
        return false;
    }

    set value =
        ONE_HUNDRED;

    if value != ONE_HUNDRED {
        return false;
    }

    set value =
        FORTY_TWO;

    return value == FORTY_TWO;
}

proc test_integrated_assignment_pipeline() -> bool {
    let mut left: i64 =
        ZERO;

    let mut right: i64 =
        ZERO;

    let mut valid: bool =
        false;

    let mut point: Point =
        make_zero_point();

    let mut pair: Pair =
        make_pair(
            ZERO,
            ZERO);

    let mut record: Record =
        make_record(
            ZERO,
            false);

    set left =
        TWENTY;

    set right =
        TWENTY_TWO;

    set valid =
        left + right ==
        FORTY_TWO;

    if not valid {
        return false;
    }

    set point =
        make_point(
            left,
            right);

    set pair =
        make_pair(
            left,
            right);

    set record =
        make_record(
            point_sum(&point),
            true);

    return left == TWENTY and
         right == TWENTY_TWO and
         valid and
         point_sum(&point) == FORTY_TWO and
         pair_sum(&pair) == FORTY_TWO and
         record_valid(&record);
}

proc main() -> int {
    if not test_direct_assignment() {
        return 1;
    }

    if not test_assignment_literal() {
        return 2;
    }

    if not test_assignment_constant() {
        return 3;
    }

    if not test_assignment_variable() {
        return 4;
    }

    if not test_assignment_call() {
