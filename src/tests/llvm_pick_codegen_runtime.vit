/// C17 executable port of the former LLVM pick-codegen probe.
///
/// Pick construction, qualified variants, aggregate storage, comparisons, and
/// branching are checked by the native compiler instead of a missing LLVM IR
/// helper module.

space compiler/llvm_pick_codegen_runtime;

pick Style {
    Compact,
    Pretty,
    Debug,
}

form Config {
    style: Style,
    level: i64,
}

proc default_config() -> Config {
    give Config {
        style: Style::Pretty,
        level: 2,
    };
}

proc style_score(style: Style) -> i64 {
    if style == Style::Compact {
        give 1;
    }
    if style == Style::Pretty {
        give 2;
    }
    give 3;
}

proc main() -> int {
    let config: Config = default_config();

    if config.style != Style::Pretty or config.level != 2 {
        give 1;
    }
    if style_score(Style::Compact) != 1 {
        give 2;
    }
    if style_score(Style::Pretty) != 2 {
        give 3;
    }
    if style_score(Style::Debug) != 3 {
        give 4;
    }
    give 0;
}
