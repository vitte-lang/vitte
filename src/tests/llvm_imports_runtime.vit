/// C17 executable port of the former LLVM import/interface probe.
///
/// Use the checked-in multi-declaration module through the normal driver. The
/// test verifies qualified calls, imported constants, and a complete native
/// link without relying on the missing self-hosted interface generator.

space compiler/llvm_imports_runtime;

use tests::import_export_coverage::runtime_import_lib as imported;

proc main() -> int {
    if imported::runtime_add(20, 22) != 42 {
        give 1;
    }
    if not imported::runtime_ready(42) {
        give 2;
    }
    give imported::runtime_add(42, 0) - 42;
}
