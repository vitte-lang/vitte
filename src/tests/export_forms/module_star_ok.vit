/// Module star-export positive test.
///
/// Verifies that the complete exported surface of `lib_star` can be consumed
/// through its module namespace.
///
/// Coverage:
/// - exported constants;
/// - exported forms;
/// - exported picks;
/// - exported procedures;
/// - predicates;
/// - constructors;
/// - reference parameters;
/// - qualified type names;
/// - qualified value names;
/// - qualified constructors;
/// - nested forms;
/// - repeated qualified resolution;
/// - control flow;
/// - mutation;
/// - composed operations.
///
/// Expected result:
/// - import resolution succeeds;
/// - all exported declarations are visible through `lib_star`;
/// - qualified types resolve;
/// - qualified values resolve;
/// - qualified procedures resolve;
/// - semantic analysis succeeds;
/// - compilation succeeds.

space tests::export_forms::module_star_ok;

use tests::export_forms::lib_star;

proc test_constants() -> bool {
    give lib_star::ZERO == 0 &&
         lib_star::ONE == 1 &&
         lib_star::TWO == 2 &&
         lib_star::TEN == 10 &&
         lib_star::TWELVE == 12 &&
         lib_star::TWENTY == 20 &&
         lib_star::TWENTY_TWO == 22 &&
         lib_star::ANSWER == 42 &&
         lib_star::LIMIT == 100 &&
         lib_star::MINIMUM == 0 &&
         lib_star::MAXIMUM == 100 &&
         lib_star::ENABLED &&
         !lib_star::DISABLED;
}

proc test_constant_arithmetic() -> i64 {
    give lib_star::TWENTY +
         lib_star::TWENTY_TWO;
}

proc test_identity() -> i64 {
    give lib_star::identity(
        lib_star::ANSWER);
}

proc test_arithmetic() -> bool {
    give lib_star::add(20, 22) == 42 &&
         lib_star::subtract(100, 58) == 42 &&
         lib_star::multiply(6, 7) == 42 &&
         lib_star::divide(84, 2) == 42 &&
         lib_star::modulo(100, 58) == 42 &&
         lib_star::increment(41) == 42 &&
         lib_star::decrement(43) == 42;
}

proc test_predicates() -> bool {
    give lib_star::is_zero(
               lib_star::ZERO) &&
         lib_star::is_positive(
               lib_star::ANSWER) &&
         lib_star::is_negative(
               -lib_star::ONE) &&
         lib_star::is_non_negative(
               lib_star::ZERO) &&
         lib_star::is_answer(
               lib_star::ANSWER) &&
         lib_star::within_limit(
               lib_star::ANSWER) &&
         lib_star::between(
               lib_star::ANSWER,
               lib_star::ZERO,
               lib_star::MAXIMUM);
}

proc test_minimum_maximum() -> bool {
    give lib_star::minimum(20, 22) == 20 &&
         lib_star::maximum(20, 22) == 22 &&
         lib_star::minimum(42, 42) == 42 &&
         lib_star::maximum(42, 42) == 42;
}

proc test_clamp() -> bool {
    give lib_star::clamp(
               42,
               0,
               100) == 42 &&
         lib_star::clamp(
               -10,
               0,
               100) == 0 &&
         lib_star::clamp(
               200,
               0,
               100) == 100;
}

proc test_absolute() -> bool {
    give lib_star::absolute(42) == 42 &&
         lib_star::absolute(-42) == 42 &&
         lib_star::absolute(0) == 0;
}

proc test_nested_calls() -> i64 {
    give lib_star::identity(
        lib_star::add(
            lib_star::identity(20),
            lib_star::identity(22)));
}

proc test_deep_calls() -> i64 {
    give lib_star::identity(
        lib_star::identity(
            lib_star::identity(
                lib_star::add(
                    lib_star::identity(20),
                    lib_star::identity(22)))));
}

proc test_point_literal() -> i64 {
    let point: lib_star::Point =
        lib_star::Point {
            x: 20,
            y: 22,
        };

    give point.x +
         point.y;
}

proc test_point_factory() -> i64 {
    let point: lib_star::Point =
        lib_star::make_point(
            20,
            22);

    give lib_star::point_sum(&point);
}

proc test_origin() -> bool {
    let point: lib_star::Point =
        lib_star::make_origin();

    give lib_star::point_x(&point) == 0 &&
         lib_star::point_y(&point) == 0 &&
         lib_star::point_sum(&point) == 0;
}

proc test_answer_point() -> bool {
    let point: lib_star::Point =
        lib_star::make_answer_point();

    give lib_star::point_x(&point) == 20 &&
         lib_star::point_y(&point) == 22 &&
         lib_star::point_sum(&point) == 42 &&
         lib_star::validate_answer_point(&point);
}

proc test_point_equality() -> bool {
    let left: lib_star::Point =
        lib_star::make_point(
            20,
            22);

    let right: lib_star::Point =
        lib_star::make_answer_point();

    give lib_star::point_equal(
        &left,
        &right);
}

proc test_point_translate() -> bool {
    let source: lib_star::Point =
        lib_star::make_point(
            10,
            10);

    let translated: lib_star::Point =
        lib_star::point_translate(
            &source,
            10,
            12);

    give lib_star::point_sum(
        &translated) == 42;
}

proc test_point_scale() -> bool {
    let source: lib_star::Point =
        lib_star::make_point(
            10,
            11);

    let scaled: lib_star::Point =
        lib_star::point_scale(
            &source,
            2);

    give lib_star::point_sum(
        &scaled) == 42;
}

proc test_range_literal() -> i64 {
    let range: lib_star::Range =
        lib_star::Range {
            minimum: 0,
            maximum: 42,
        };

    give range.maximum -
         range.minimum;
}

proc test_range_factory() -> i64 {
    let range: lib_star::Range =
        lib_star::make_range(
            10,
            52);

    give lib_star::range_width(&range);
}

proc test_answer_range() -> bool {
    let range: lib_star::Range =
        lib_star::make_answer_range();

    give lib_star::range_minimum(&range) == 0 &&
         lib_star::range_maximum(&range) == 42 &&
         lib_star::range_width(&range) == 42 &&
         lib_star::range_valid(&range) &&
         lib_star::range_contains(
             &range,
             42) &&
         lib_star::validate_answer_range(
             &range);
}

proc test_range_contains() -> bool {
    let range: lib_star::Range =
        lib_star::make_range(
            10,
            20);

    give !lib_star::range_contains(
             &range,
             9) &&
         lib_star::range_contains(
             &range,
             10) &&
         lib_star::range_contains(
             &range,
             15) &&
         lib_star::range_contains(
             &range,
             20) &&
         !lib_star::range_contains(
             &range,
             21);
}

proc test_range_clamp() -> bool {
    let range: lib_star::Range =
        lib_star::make_range(
            10,
            20);

    give lib_star::range_clamp(
               &range,
               5) == 10 &&
         lib_star::range_clamp(
               &range,
               15) == 15 &&
         lib_star::range_clamp(
               &range,
               25) == 20;
}

proc test_record_literal() -> i64 {
    let record: lib_star::Record =
        lib_star::Record {
            id: 42,
            value: 42,
            enabled: true,
        };

    give record.value;
}

proc test_record_factory() -> bool {
    let record: lib_star::Record =
        lib_star::make_record(
            42,
            42,
            true);

    give lib_star::record_id(&record) == 42 &&
         lib_star::record_value(&record) == 42 &&
         lib_star::record_enabled(&record) &&
         lib_star::record_valid(&record);
}

proc test_answer_record() -> bool {
    let record: lib_star::Record =
        lib_star::make_answer_record();

    give lib_star::record_id(&record) == 42 &&
         lib_star::record_value(&record) == 42 &&
         lib_star::record_enabled(&record) &&
         lib_star::validate_answer_record(
             &record);
}

proc test_pair_literal() -> i64 {
    let pair: lib_star::Pair =
        lib_star::Pair {
            first: 20,
            second: 22,
        };

    give pair.first +
         pair.second;
}

proc test_pair_factory() -> i64 {
    let pair: lib_star::Pair =
        lib_star::make_pair(
            20,
            22);

    give lib_star::pair_sum(&pair);
}

proc test_answer_pair() -> bool {
    let pair: lib_star::Pair =
        lib_star::make_answer_pair();

    give lib_star::pair_first(&pair) == 20 &&
         lib_star::pair_second(&pair) == 22 &&
         lib_star::pair_sum(&pair) == 42 &&
         lib_star::validate_answer_pair(&pair);
}

proc test_pair_equality() -> bool {
    let first: lib_star::Pair =
        lib_star::make_pair(
            20,
            22);

    let second: lib_star::Pair =
        lib_star::make_answer_pair();

    give lib_star::pair_equal(
        &first,
        &second);
}

proc test_counter() -> bool {
    let counter: lib_star::Counter =
        lib_star::make_counter(
            41);

    let next: lib_star::Counter =
        lib_star::counter_incremented(
            &counter);

    give lib_star::counter_value(
               &counter) == 41 &&
         lib_star::counter_value(
               &next) == 42;
}

proc test_rectangle() -> bool {
    let minimum_point: lib_star::Point =
        lib_star::make_point(
            0,
            0);

    let maximum_point: lib_star::Point =
        lib_star::make_point(
            6,
            7);

    let rectangle: lib_star::Rectangle =
        lib_star::make_rectangle(
            minimum_point,
            maximum_point);

    give lib_star::rectangle_width(
               &rectangle) == 6 &&
         lib_star::rectangle_height(
               &rectangle) == 7 &&
         lib_star::rectangle_area(
               &rectangle) == 42;
}

proc test_nested() -> bool {
    let point: lib_star::Point =
        lib_star::make_point(
            10,
            10);

    let range: lib_star::Range =
        lib_star::make_range(
            0,
            22);

    let nested: lib_star::Nested =
        lib_star::make_nested(
            point,
            range);

    give lib_star::nested_point_sum(
               &nested) == 20 &&
         lib_star::nested_range_width(
               &nested) == 22 &&
         lib_star::nested_value(
               &nested) == 42;
}

proc test_answer_nested() -> bool {
    let nested: lib_star::Nested =
        lib_star::make_answer_nested();

    give lib_star::nested_value(
               &nested) == 42 &&
         lib_star::validate_answer_nested(
             &nested);
}

proc test_envelope() -> bool {
    let record: lib_star::Record =
        lib_star::make_record(
            42,
            20,
            true);

    let pair: lib_star::Pair =
        lib_star::make_pair(
            10,
            12);

    let envelope: lib_star::Envelope =
        lib_star::make_envelope(
            record,
            pair);

    give lib_star::envelope_record_value(
               &envelope) == 20 &&
         lib_star::envelope_pair_sum(
               &envelope) == 22 &&
         lib_star::envelope_value(
               &envelope) == 42;
}

proc test_answer_envelope() -> bool {
    let envelope: lib_star::Envelope =
        lib_star::make_answer_envelope();

    give lib_star::envelope_value(
               &envelope) == 42 &&
         lib_star::validate_answer_envelope(
             &envelope);
}

proc test_state_record() -> bool {
    let record: lib_star::StateRecord =
        lib_star::make_state_record(
            42,
            true);

    give lib_star::state_record_valid(
               &record) &&
         lib_star::state_record_value(
               &record) == 42;
}

proc consume_point(
    point: &lib_star::Point
) -> i64 {
    give lib_star::point_sum(point);
}

proc produce_point(
    x: i64,
    y: i64
) -> lib_star::Point {
    give lib_star::make_point(
        x,
        y);
}

proc test_qualified_type_parameter() -> i64 {
    let point: lib_star::Point =
        lib_star::make_answer_point();

    give consume_point(&point);
}

proc test_qualified_type_return() -> i64 {
    let point: lib_star::Point =
        produce_point(
            20,
            22);

    give lib_star::point_sum(&point);
}

proc consume_range(
    range: &lib_star::Range
) -> i64 {
    give lib_star::range_width(range);
}

proc produce_range(
    minimum_value: i64,
    maximum_value: i64
) -> lib_star::Range {
    give lib_star::make_range(
        minimum_value,
        maximum_value);
}

proc test_multiple_qualified_types() -> i64 {
    let point: lib_star::Point =
        produce_point(
            10,
            10);

    let range: lib_star::Range =
        produce_range(
            0,
            22);

    give consume_point(&point) +
         consume_range(&range);
}

proc test_reference_consumers() -> i64 {
    let point: lib_star::Point =
        lib_star::make_point(
            20,
            22);

    let range: lib_star::Range =
        lib_star::make_range(
            0,
            42);

    let record: lib_star::Record =
        lib_star::make_record(
            42,
            42,
            true);

    let pair: lib_star::Pair =
        lib_star::make_pair(
            20,
            22);

    give lib_star::point_sum(&point) +
         lib_star::range_width(&range) +
         lib_star::record_value(&record) +
         lib_star::pair_sum(&pair);
}

proc test_qualified_constructor_values() -> i64 {
    let point: lib_star::Point =
        lib_star::Point {
            x: lib_star::TWENTY,
            y: lib_star::TWENTY_TWO,
        };

    give lib_star::point_sum(&point);
}

proc test_qualified_calls_in_constructor() -> i64 {
    let point: lib_star::Point =
        lib_star::Point {
            x: lib_star::identity(20),
            y: lib_star::identity(22),
        };

    give lib_star::point_sum(&point);
}

proc test_factory_composition() -> i64 {
    let point: lib_star::Point =
        lib_star::make_point(
            lib_star::add(10, 10),
            lib_star::subtract(50, 28));

    give lib_star::point_sum(&point);
}

proc test_default_state() -> bool {
    let state: lib_star::State =
        lib_star::default_state();

    give state ==
         lib_star::State.Idle;
}

proc test_ready_state() -> bool {
    let state: lib_star::State =
        lib_star::ready_state();

    give state ==
         lib_star::State.Ready;
}

proc test_running_state() -> bool {
    let state: lib_star::State =
        lib_star::running_state();

    give state ==
         lib_star::State.Running;
}

proc test_finished_state() -> bool {
    let state: lib_star::State =
        lib_star::finished_state();

    give state ==
         lib_star::State.Finished;
}

proc test_result_kinds() -> bool {
    let success: lib_star::ResultKind =
        lib_star::success_kind();

    let failure: lib_star::ResultKind =
        lib_star::failure_kind();

    give success ==
             lib_star::ResultKind.Success &&
         failure ==
             lib_star::ResultKind.Failure;
}

proc test_directions() -> bool {
    let left: lib_star::Direction =
        lib_star::left_direction();

    let right: lib_star::Direction =
        lib_star::right_direction();

    give left ==
             lib_star::Direction.Left &&
         right ==
             lib_star::Direction.Right;
}

proc test_ordering() -> bool {
    give lib_star::compare(
               20,
               22) ==
             lib_star::Ordering.Less &&
         lib_star::compare(
               42,
               42) ==
             lib_star::Ordering.Equal &&
         lib_star::compare(
               22,
               20) ==
             lib_star::Ordering.Greater;
}

proc test_compose_answer() -> bool {
    give lib_star::compose_answer() == 42 &&
         lib_star::compose_answer_nested() == 42 &&
         lib_star::make_composed_answer() == 42;
}

proc test_sum_point_and_range() -> i64 {
    let point: lib_star::Point =
        lib_star::make_point(
            10,
            10);

    let range: lib_star::Range =
        lib_star::make_range(
            0,
            22);

    give lib_star::sum_point_and_range(
        &point,
        &range);
}

proc test_sum_record_and_pair() -> i64 {
    let record: lib_star::Record =
        lib_star::make_record(
            42,
            20,
            true);

    let pair: lib_star::Pair =
        lib_star::make_pair(
            10,
            12);

    give lib_star::sum_record_and_pair(
        &record,
        &pair);
}

proc test_repeated_answer() -> bool {
    give lib_star::repeated_answer();
}

proc test_arithmetic_pipeline() -> i64 {
    give lib_star::arithmetic_pipeline(21);
}

proc test_bounded_add() -> i64 {
    give lib_star::bounded_add(
        20,
        22);
}

proc test_accumulate() -> i64 {
    give lib_star::accumulate_to_answer();
}

proc test_conditional_answer() -> bool {
    give lib_star::conditional_answer(
               true) == 42 &&
         lib_star::conditional_answer(
               false) == 0;
}

proc test_nested_conditional_answer() -> bool {
    give lib_star::nested_conditional_answer(
               10) == 42 &&
         lib_star::nested_conditional_answer(
               42) == 42 &&
         lib_star::nested_conditional_answer(
               100) == 42;
}

proc test_nested_block() -> i64 {
    let mut result: i64 =
        lib_star::ZERO;

    {
        let point: lib_star::Point =
            lib_star::make_answer_point();

        set result =
            lib_star::point_sum(&point);
    }

    give result;
}

proc test_deep_block() -> i64 {
    let mut result: i64 =
        lib_star::ZERO;

    {
        let left: i64 =
            lib_star::identity(20);

        {
            let right: i64 =
                lib_star::identity(22);

            {
                set result =
                    lib_star::add(
                        left,
                        right);
            }
        }
    }

    give result;
}

proc test_if() -> i64 {
    if lib_star::is_answer(
        lib_star::ANSWER) {
        give lib_star::identity(
            lib_star::ANSWER);
    }

    give lib_star::ZERO;
}

proc test_if_else(
    condition: bool
) -> i64 {
    if condition {
        give lib_star::add(
            20,
            22);
    } else {
        give lib_star::subtract(
            100,
            58);
    }
}

proc test_loop() -> i64 {
    let mut index: i64 =
        lib_star::ZERO;

    let mut result: i64 =
        lib_star::ZERO;

    while index < 6 {
        set result =
            lib_star::add(
                result,
                7);

        set index =
            lib_star::increment(index);
    }

    give result;
}

proc test_nested_control_flow() -> i64 {
    let mut index: i64 =
        lib_star::ZERO;

    let mut result: i64 =
        lib_star::ZERO;

    while index < 3 {
        if index == lib_star::ZERO {
            set result =
                lib_star::add(
                    result,
                    10);
        } else {
            if index == lib_star::ONE {
                set result =
                    lib_star::add(
                        result,
                        20);
            } else {
                set result =
                    lib_star::add(
                        result,
                        12);
            }
        }

        set index =
            lib_star::increment(index);
    }

    give result;
}

proc test_mutation() -> i64 {
    let mut value: i64 =
        lib_star::ZERO;

    set value =
        lib_star::ANSWER;

    give lib_star::identity(value);
}

proc test_mutable_call_chain() -> i64 {
    let mut value: i64 =
        lib_star::identity(20);

    set value =
        lib_star::add(
            value,
            22);

    give lib_star::identity(value);
}

proc test_repeated_constant_resolution() -> bool {
    give lib_star::ANSWER == 42 &&
         lib_star::ANSWER == 42 &&
         lib_star::ANSWER == 42 &&
         lib_star::ANSWER == 42 &&
         lib_star::ANSWER == 42;
}

proc test_repeated_proc_resolution() -> bool {
    give lib_star::identity(42) == 42 &&
         lib_star::identity(42) == 42 &&
         lib_star::identity(42) == 42 &&
         lib_star::identity(42) == 42 &&
         lib_star::identity(42) == 42;
}

proc test_repeated_type_resolution() -> i64 {
    let first: lib_star::Point =
        lib_star::make_point(
            10,
            10);

    let second: lib_star::Point =
        lib_star::make_point(
            11,
            11);

    let third: lib_star::Point =
        lib_star::make_origin();

    give lib_star::point_sum(&first) +
         lib_star::point_sum(&second) +
         lib_star::point_sum(&third);
}

proc test_expression_tree() -> i64 {
    give lib_star::add(
        lib_star::identity(
            lib_star::add(
                lib_star::ZERO,
                lib_star::identity(10))),
        lib_star::identity(
            lib_star::add(
                lib_star::identity(20),
                lib_star::subtract(
                    lib_star::ANSWER,
                    30))));
}

proc test_cross_category() -> bool {
    let point: lib_star::Point =
        lib_star::make_point(
            lib_star::identity(20),
            lib_star::identity(22));

    let range: lib_star::Range =
        lib_star::make_range(
            lib_star::ZERO,
            lib_star::ANSWER);

    let record: lib_star::Record =
        lib_star::make_record(
            lib_star::LIMIT,
            lib_star::point_sum(&point),
            lib_star::ENABLED);

    let pair: lib_star::Pair =
        lib_star::make_pair(
            range.minimum,
            range.maximum);

    give lib_star::point_sum(&point) ==
             lib_star::ANSWER &&
         lib_star::range_width(&range) ==
             lib_star::ANSWER &&
         lib_star::record_value(&record) ==
             lib_star::ANSWER &&
         lib_star::pair_sum(&pair) ==
             lib_star::ANSWER;
}

proc test_library_self_test() -> bool {
    give lib_star::library_self_test();
}

proc test_integrated_module_star() -> bool {
    let point: lib_star::Point =
        lib_star::make_answer_point();

    let range: lib_star::Range =
        lib_star::make_answer_range();

    let record: lib_star::Record =
        lib_star::make_answer_record();

    let pair: lib_star::Pair =
        lib_star::make_answer_pair();

    let nested: lib_star::Nested =
        lib_star::make_answer_nested();

    let envelope: lib_star::Envelope =
        lib_star::make_answer_envelope();

    let state: lib_star::State =
        lib_star::running_state();

    let result_kind: lib_star::ResultKind =
        lib_star::success_kind();

    let direction: lib_star::Direction =
        lib_star::right_direction();

    let ordering: lib_star::Ordering =
        lib_star::compare(
            20,
            22);

    let mut result: i64 =
        lib_star::ZERO;

    if lib_star::is_answer(
        lib_star::record_value(&record)) {
        set result =
            lib_star::pair_sum(&pair);
    }

    give result == lib_star::ANSWER &&
         lib_star::point_sum(&point) ==
             lib_star::ANSWER &&
         lib_star::range_width(&range) ==
             lib_star::ANSWER &&
         lib_star::record_value(&record) ==
             lib_star::ANSWER &&
         lib_star::pair_sum(&pair) ==
             lib_star::ANSWER &&
         lib_star::nested_value(&nested) ==
             lib_star::ANSWER &&
         lib_star::envelope_value(&envelope) ==
             lib_star::ANSWER &&
         state ==
             lib_star::State.Running &&
         result_kind ==
             lib_star::ResultKind.Success &&
         direction ==
             lib_star::Direction.Right &&
         ordering ==
             lib_star::Ordering.Less;
}

proc main() -> int {
    if !test_constants() { give 1; }
    if test_constant_arithmetic() != 42 { give 2; }
