/// Direct star-export positive test.
///
/// Verifies the direct wildcard export form.
///
/// Coverage:
/// - direct `export ...*`;
/// - exported constants;
/// - exported forms;
/// - exported procedures;
/// - exported predicates;
/// - constructors;
/// - references;
/// - multiple declarations;
/// - repeated resolution;
/// - nested expressions;
/// - control flow;
/// - mutation;
/// - type positions;
/// - expression positions;
/// - local use after star export;
/// - declaration identity preservation.
///
/// Expected result:
/// - lexing succeeds;
/// - parsing succeeds;
/// - wildcard export resolves;
/// - all eligible declarations are exported;
/// - types remain usable in type positions;
/// - values remain usable in expression positions;
/// - procedures remain callable;
/// - semantic analysis succeeds;
/// - compilation succeeds.

space tests::export_forms::direct_star_ok;

const ZERO: i64 = 0;
    const ONE: i64 = 1;
    const ANSWER: i64 = 42;
    const LIMIT: u64 = 100;
    const ENABLED: bool = true;

    form Point {
        x: i64,
        y: i64,
    }

    form Range {
        minimum: i64,
        maximum: i64,
    }

    form Record {
        id: u64,
        value: i64,
        enabled: bool,
    }

    form Pair {
        first: i64,
        second: i64,
    }

    form Nested {
        point: Point,
        range: Range,
    }

    pick State {
        Idle,
        Ready,
        Running,
        Finished,
    }

    pick ResultKind {
        Success,
        Failure,
    }

    proc identity(value: i64) -> i64 {
        return value;
    }

    proc add(
        left: i64,
        right: i64
    ) -> i64 {
        return left + right;
    }

    proc subtract(
        left: i64,
        right: i64
    ) -> i64 {
        return left - right;
    }

    proc multiply(
        left: i64,
        right: i64
    ) -> i64 {
        return left * right;
    }

    proc is_zero(value: i64) -> bool {
        return value == ZERO;
    }

    proc is_positive(value: i64) -> bool {
        return value > ZERO;
    }

    proc is_answer(value: i64) -> bool {
        return value == ANSWER;
    }

    proc make_point(
        x: i64,
        y: i64
    ) -> Point {
        return Point {
            x: x,
            y: y,
        };
    }

    proc make_range(
        minimum: i64,
        maximum: i64
    ) -> Range {
        return Range {
            minimum: minimum,
            maximum: maximum,
        };
    }

    proc make_record(
        id: u64,
        value: i64,
        enabled: bool
    ) -> Record {
        return Record {
            id: id,
            value: value,
            enabled: enabled,
        };
    }

    proc make_pair(
        first: i64,
        second: i64
    ) -> Pair {
        return Pair {
            first: first,
            second: second,
        };
    }

    proc make_nested(
        point: Point,
        range: Range
    ) -> Nested {
        return Nested {
            point: point,
            range: range,
        };
    }

    proc point_sum(
        point: &Point
    ) -> i64 {
        return point.x + point.y;
    }

    proc range_width(
        range: &Range
    ) -> i64 {
        return range.maximum -
             range.minimum;
    }

    proc range_valid(
        range: &Range
    ) -> bool {
        return range.minimum <=
             range.maximum;
    }

    proc range_contains(
        range: &Range,
        value: i64
    ) -> bool {
        return value >= range.minimum and
             value <= range.maximum;
    }

    proc record_value(
        record: &Record
    ) -> i64 {
        return record.value;
    }

    proc record_enabled(
        record: &Record
    ) -> bool {
        return record.enabled;
    }

    proc pair_sum(
        pair: &Pair
    ) -> i64 {
        return pair.first +
             pair.second;
    }

    proc nested_value(
        nested: &Nested
    ) -> i64 {
        return point_sum(&nested.point) +
             range_width(&nested.range);
    }

    proc default_state() -> State {
        return State.Idle;
    }

    proc running_state() -> State {
        return State.Running;
    }

    proc success_kind() -> ResultKind {
        return ResultKind.Success;
}

/// Export every eligible declaration in this module.
export *;

proc test_constants() -> bool {
    return ZERO == 0 and
         ONE == 1 and
         ANSWER == 42 and
         LIMIT == 100 and
         ENABLED;
}

proc test_constant_arithmetic() -> i64 {
    return ANSWER +
         ZERO +
         ONE -
         ONE;
}

proc test_identity() -> i64 {
    return identity(ANSWER);
}

proc test_add() -> i64 {
    return add(20, 22);
}

proc test_subtract() -> i64 {
    return subtract(100, 58);
}

proc test_multiply() -> i64 {
    return multiply(6, 7);
}

proc test_predicates() -> bool {
    return is_zero(ZERO) and
         is_positive(ANSWER) and
         is_answer(ANSWER);
}

proc test_nested_calls() -> i64 {
    return identity(
        add(
            identity(20),
            identity(22)));
}

proc test_deep_calls() -> i64 {
    return identity(
        identity(
            identity(
                add(
                    identity(20),
                    identity(22)))));
}

proc test_mixed_calls() -> i64 {
    let first: i64 =
        add(10, 10);

    let second: i64 =
        subtract(50, 28);

    return add(
        first,
        second);
}

proc test_point_literal() -> i64 {
    let point: Point =
        Point {
            x: 20,
            y: 22,
        };

    return point.x +
         point.y;
}

proc test_point_factory() -> i64 {
    let point: Point =
        make_point(
            20,
            22);

    return point.x +
         point.y;
}

proc test_point_consumer() -> i64 {
    let point: Point =
        make_point(
            20,
            22);

    return point_sum(&point);
}

proc test_multiple_points() -> i64 {
    let first: Point =
        make_point(
            5,
            5);

    let second: Point =
        make_point(
            10,
            22);

    return point_sum(&first) +
         point_sum(&second);
}

proc test_range_literal() -> i64 {
    let range: Range =
        Range {
            minimum: 0,
            maximum: 42,
        };

    return range.maximum -
         range.minimum;
}

proc test_range_factory() -> i64 {
    let range: Range =
        make_range(
            10,
            52);

    return range_width(&range);
}

proc test_range_predicates() -> bool {
    let range: Range =
        make_range(
            0,
            100);

    return range_valid(&range) and
         range_contains(&range, 0) and
         range_contains(&range, 42) and
         range_contains(&range, 100) and
         not range_contains(&range, 101);
}

proc test_record_literal() -> i64 {
    let record: Record =
        Record {
            id: 42,
            value: 42,
            enabled: true,
        };

    return record.value;
}

proc test_record_factory() -> i64 {
    let record: Record =
        make_record(
            42,
            42,
            true);

    return record_value(&record);
}

proc test_record_predicate() -> bool {
    let record: Record =
        make_record(
            LIMIT,
            ANSWER,
            ENABLED);

    return record_value(&record) == ANSWER and
         record_enabled(&record);
}

proc test_pair_literal() -> i64 {
    let pair: Pair =
        Pair {
            first: 20,
            second: 22,
        };

    return pair.first +
         pair.second;
}

proc test_pair_factory() -> i64 {
    let pair: Pair =
        make_pair(
            20,
            22);

    return pair_sum(&pair);
}

proc test_nested_literal() -> i64 {
    let point: Point =
        make_point(
            10,
            10);

    let range: Range =
        make_range(
            0,
            22);

    let nested: Nested =
        Nested {
            point: point,
            range: range,
        };

    return nested_value(&nested);
}

proc test_nested_factory() -> i64 {
    let point: Point =
        make_point(
            10,
            10);

    let range: Range =
        make_range(
            0,
            22);

    let nested: Nested =
        make_nested(
            point,
            range);

    return nested_value(&nested);
}

proc consume_point(
    point: &Point
) -> i64 {
    return point_sum(point);
}

proc produce_point(
    x: i64,
    y: i64
) -> Point {
    return make_point(
        x,
        y);
}

proc test_type_in_parameter() -> i64 {
    let point: Point =
        make_point(
            20,
            22);

    return consume_point(&point);
}

proc test_type_in_return() -> i64 {
    let point: Point =
        produce_point(
            20,
            22);

    return point_sum(&point);
}

proc consume_range(
    range: &Range
) -> i64 {
    return range_width(range);
}

proc produce_range(
    minimum: i64,
    maximum: i64
) -> Range {
    return make_range(
        minimum,
        maximum);
}

proc test_multiple_exported_types() -> i64 {
    let point: Point =
        produce_point(
            10,
            10);

    let range: Range =
        produce_range(
            0,
            22);

    return consume_point(&point) +
         consume_range(&range);
}

proc test_reference_parameters() -> i64 {
    let point: Point =
        make_point(
            20,
            22);

    let range: Range =
        make_range(
            0,
            42);

    let record: Record =
        make_record(
            42,
            42,
            true);

    let pair: Pair =
        make_pair(
            20,
            22);

    return point_sum(&point) +
         range_width(&range) +
         record_value(&record) +
         pair_sum(&pair);
}

proc test_constant_in_constructor() -> i64 {
    let point: Point =
        Point {
            x: ANSWER,
            y: ZERO,
        };

    return point_sum(&point);
}

proc test_calls_in_constructor() -> i64 {
    let point: Point =
        Point {
            x: identity(20),
            y: identity(22),
        };

    return point_sum(&point);
}

proc test_factory_composition() -> i64 {
    let point: Point =
        make_point(
            add(10, 10),
            subtract(50, 28));

    return point_sum(&point);
}

proc test_nested_block() -> i64 {
    let mut result: i64 =
        ZERO;

    {
        let point: Point =
            make_point(
                20,
                22);

        set result =
            point_sum(&point);
    }

    return result;
}

proc test_deep_block() -> i64 {
    let mut result: i64 =
        ZERO;

    {
        let left: i64 =
            identity(20);

        {
            let right: i64 =
                identity(22);

            {
                set result =
                    add(
                        left,
                        right);
            }
        }
    }

    return result;
}

proc test_if() -> i64 {
    if is_answer(ANSWER) {
        return identity(ANSWER);
    }

    return ZERO;
}

proc test_if_else(
    condition: bool
) -> i64 {
    if condition {
        return add(
            20,
            22);
    } else {
        return subtract(
            100,
            58);
    }
}

proc test_loop() -> i64 {
    let mut index: i64 =
        ZERO;

    let mut result: i64 =
        ZERO;

    while index < 6 {
        set result =
            add(
                result,
                7);

        set index =
            add(
                index,
                ONE);
    }

    return result;
}

proc test_nested_control_flow() -> i64 {
    let mut index: i64 =
        ZERO;

    let mut result: i64 =
        ZERO;

    while index < 3 {
        if index == ZERO {
            set result =
                add(
                    result,
                    10);
        } else {
            if index == ONE {
                set result =
                    add(
                        result,
                        20);
            } else {
                set result =
                    add(
                        result,
                        12);
            }
        }

        set index =
            add(
                index,
                ONE);
    }

    return result;
}

proc test_mutable_value() -> i64 {
    let mut value: i64 =
        ZERO;

    set value =
        ANSWER;

    return identity(value);
}

proc test_mutable_call_chain() -> i64 {
    let mut value: i64 =
        identity(20);

    set value =
        add(
            value,
            22);

    return identity(value);
}

proc test_repeated_constant_lookup() -> bool {
    return ANSWER == 42 and
         ANSWER == 42 and
         ANSWER == 42 and
         ANSWER == 42 and
         ANSWER == 42;
}

proc test_repeated_proc_lookup() -> bool {
    return identity(42) == 42 and
         identity(42) == 42 and
         identity(42) == 42 and
         identity(42) == 42 and
         identity(42) == 42;
}

proc test_repeated_type_lookup() -> i64 {
    let first: Point =
        make_point(
            10,
            10);

    let second: Point =
        make_point(
            11,
            11);

    let third: Point =
        make_point(
            ZERO,
            ZERO);

    return point_sum(&first) +
         point_sum(&second) +
         point_sum(&third);
}

proc test_local_binding_from_export() -> i64 {
    let first: i64 =
        identity(10);

    let second: i64 =
        identity(20);

    let third: i64 =
        identity(12);

    return add(
        add(
            first,
            second),
        third);
}

proc test_expression_tree() -> i64 {
    return add(
        identity(
            add(
                ZERO,
                identity(10))),
        identity(
            add(
                identity(20),
                subtract(
                    ANSWER,
                    30))));
}

proc test_type_tree() -> bool {
    let first: Point =
        make_point(
            10,
            10);

    let second: Point =
        make_point(
            11,
            11);

    let range: Range =
        make_range(
            point_sum(&first),
            add(
                point_sum(&first),
                point_sum(&second)));

    let record: Record =
        make_record(
            LIMIT,
            range_width(&range),
            ENABLED);

    return point_sum(&first) == 20 and
         point_sum(&second) == 22 and
         range_width(&range) == 22 and
         record_value(&record) == 22;
}

proc test_cross_category() -> bool {
    let point: Point =
        make_point(
            identity(20),
            identity(22));

    let range: Range =
        make_range(
            ZERO,
            ANSWER);

    let record: Record =
        make_record(
            LIMIT,
            point_sum(&point),
            ENABLED);

    let pair: Pair =
        make_pair(
            range.minimum,
            range.maximum);

    return point_sum(&point) == ANSWER and
         range_width(&range) == ANSWER and
         record_value(&record) == ANSWER and
         pair_sum(&pair) == ANSWER;
}

proc test_default_state() -> bool {
    let state: State =
        default_state();

    return state == State.Idle;
}

proc test_running_state() -> bool {
    let state: State =
        running_state();

    return state == State.Running;
}

proc test_result_kind() -> bool {
    let kind: ResultKind =
        success_kind();

    return kind == ResultKind.Success;
}

proc test_pick_repeated_resolution() -> bool {
    let first: State =
        default_state();

    let second: State =
        running_state();

    let result: ResultKind =
        success_kind();

    return first == State.Idle and
         second == State.Running and
         result == ResultKind.Success;
}

proc test_integrated_star_export() -> bool {
    let left: i64 =
        identity(20);

    let right: i64 =
        identity(22);

    let point: Point =
        make_point(
            left,
            right);

    let range: Range =
        make_range(
            ZERO,
            point_sum(&point));

    let record: Record =
        make_record(
            LIMIT,
            range_width(&range),
            ENABLED);

    let pair: Pair =
        make_pair(
            point.x,
            point.y);

    let nested: Nested =
        make_nested(
            point,
            range);

    let mut result: i64 =
        ZERO;

    if is_answer(
        record_value(&record)) {
        set result =
            pair_sum(&pair);
    }

    return result == ANSWER and
         point_sum(&point) == ANSWER and
         range_width(&range) == ANSWER and
         record_value(&record) == ANSWER and
         pair_sum(&pair) == ANSWER and
         nested_value(&nested) == 84;
}

proc main() -> int {
    if not test_constants() {
        return 1;
    }

    if test_constant_arithmetic() != 42 {
        return 2;
    }

    if test_identity() != 42 {
        return 3;
    }

    if test_add() != 42 {
        return 4;
    }

    if test_subtract() != 42 {
        return 5;
    }

    if test_multiply() != 42 {
        return 6;
    }

    if not test_predicates() {
        return 7;
    }

    if test_nested_calls() != 42 {
        return 8;
    }

    if test_deep_calls() != 42 {
        return 9;
    }

    if test_mixed_calls() != 42 {
        return 10;
    }

    if test_point_literal() != 42 {
        return 11;
    }

    if test_point_factory() != 42 {
        return 12;
    }

    if test_point_consumer() != 42 {
        return 13;
    }

    if test_multiple_points() != 42 {
        return 14;
    }

    if test_range_literal() != 42 {
        return 15;
    }

    if test_range_factory() != 42 {
        return 16;
    }

    if not test_range_predicates() {
        return 17;
    }

    if test_record_literal() != 42 {
        return 18;
    }

    if test_record_factory() != 42 {
        return 19;
    }

    if not test_record_predicate() {
        return 20;
    }

    if test_pair_literal() != 42 {
        return 21;
    }

    if test_pair_factory() != 42 {
        return 22;
    }

    if test_nested_literal() != 42 {
        return 23;
    }

    if test_nested_factory() != 42 {
        return 24;
    }

    if test_type_in_parameter() != 42 {
        return 25;
    }

    if test_type_in_return() != 42 {
        return 26;
    }

    if test_multiple_exported_types() != 42 {
        return 27;
    }

    if test_reference_parameters() != 168 {
        return 28;
    }

    if test_constant_in_constructor() != 42 {
        return 29;
    }

    if test_calls_in_constructor() != 42 {
        return 30;
    }

    if test_factory_composition() != 42 {
        return 31;
    }

    if test_nested_block() != 42 {
        return 32;
    }

    if test_deep_block() != 42 {
        return 33;
    }

    if test_if() != 42 {
        return 34;
    }

    if test_if_else(true) != 42 {
        return 35;
    }

    if test_if_else(false) != 42 {
        return 36;
    }

    if test_loop() != 42 {
        return 37;
    }

    if test_nested_control_flow() != 42 {
        return 38;
    }

    if test_mutable_value() != 42 {
        return 39;
    }

    if test_mutable_call_chain() != 42 {
        return 40;
    }

    if not test_repeated_constant_lookup() {
        return 41;
    }

    if not test_repeated_proc_lookup() {
        return 42;
    }

    if test_repeated_type_lookup() != 42 {
        return 43;
    }

    if test_local_binding_from_export() != 42 {
        return 44;
    }

    if test_expression_tree() != 42 {
        return 45;
    }

    if not test_type_tree() {
        return 46;
    }

    if not test_cross_category() {
        return 47;
    }

    if not test_default_state() {
        return 48;
    }

    if not test_running_state() {
        return 49;
    }

    if not test_result_kind() {
        return 50;
    }

    if not test_pick_repeated_resolution() {
        return 51;
    }

    if not test_integrated_star_export() {
        return 52;
    }

    return 0;
}