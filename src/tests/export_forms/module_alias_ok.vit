/// Module alias-export positive test.
///
/// Verifies importing the alias fixture as a module and resolving declarations
/// through the module qualifier.
///
/// The source module exposes internal declarations under exported aliases.
/// Consumers must resolve the exported alias names and preserve their types.

space tests::export_forms::module_alias_ok;

use tests::export_forms::lib_alias;
proc test_constant_aliases() -> bool {
    return lib_alias::ZERO == 0 and
         lib_alias::ONE == 1 and
         lib_alias::TWO == 2 and
         lib_alias::TEN == 10 and
         lib_alias::TWENTY == 20 and
         lib_alias::TWENTY_TWO == 22 and
         lib_alias::ANSWER == 42 and
         lib_alias::LIMIT == 100 and
         lib_alias::MINIMUM == 0 and
         lib_alias::MAXIMUM == 100 and
         lib_alias::ENABLED and
         not lib_alias::DISABLED;
}

proc test_constant_expression() -> i64 {
    return lib_alias::ANSWER;
}

proc test_constant_arithmetic() -> i64 {
    return lib_alias::TWENTY +
         lib_alias::TWENTY_TWO;
}

proc test_identity() -> i64 {
    return lib_alias::identity(
        lib_alias::ANSWER);
}

proc test_add() -> i64 {
    return lib_alias::add(
        20,
        22);
}

proc test_subtract() -> i64 {
    return lib_alias::subtract(
        100,
        58);
}

proc test_multiply() -> i64 {
    return lib_alias::multiply(
        6,
        7);
}

proc test_increment() -> i64 {
    return lib_alias::increment(41);
}

proc test_answer() -> i64 {
    return lib_alias::answer();
}

proc test_predicates() -> bool {
    return lib_alias::is_zero(
               lib_alias::ZERO) and
         lib_alias::is_positive(
               lib_alias::ANSWER) and
         lib_alias::is_non_negative(
               lib_alias::ZERO) and
         lib_alias::is_answer(
               lib_alias::ANSWER) and
         lib_alias::within_limit(
               lib_alias::ANSWER);
}

proc test_nested_calls() -> i64 {
    return lib_alias::identity(
        lib_alias::add(
            lib_alias::identity(20),
            lib_alias::identity(22)));
}

proc test_deep_calls() -> i64 {
    return lib_alias::identity(
        lib_alias::identity(
            lib_alias::identity(
                lib_alias::add(
                    lib_alias::identity(20),
                    lib_alias::identity(22)))));
}

proc test_mixed_calls() -> i64 {
    let first: i64 =
        lib_alias::add(
            10,
            10);

    let second: i64 =
        lib_alias::subtract(
            50,
            28);

    return lib_alias::add(
        first,
        second);
}

proc test_point_literal() -> i64 {
    let point: lib_alias::Point =
        lib_alias::Point {
            x: 20,
            y: 22,
        };

    return point.x +
         point.y;
}

proc test_point_factory() -> i64 {
    let point: lib_alias::Point =
        lib_alias::make_point(
            20,
            22);

    return point.x +
         point.y;
}

proc test_point_consumers() -> bool {
    let point: lib_alias::Point =
        lib_alias::make_point(
            20,
            22);

    return lib_alias::point_x(&point) == 20 and
         lib_alias::point_y(&point) == 22 and
         lib_alias::point_sum(&point) == 42;
}

proc test_multiple_points() -> i64 {
    let first: lib_alias::Point =
        lib_alias::make_point(
            5,
            5);

    let second: lib_alias::Point =
        lib_alias::make_point(
            10,
            22);

    return lib_alias::point_sum(&first) +
         lib_alias::point_sum(&second);
}

proc test_range_literal() -> i64 {
    let range: lib_alias::Range =
        lib_alias::Range {
            minimum: 0,
            maximum: 42,
        };

    return range.maximum -
         range.minimum;
}

proc test_range_factory() -> i64 {
    let range: lib_alias::Range =
        lib_alias::make_range(
            10,
            52);

    return lib_alias::range_width(&range);
}

proc test_range_operations() -> bool {
    let range: lib_alias::Range =
        lib_alias::make_range(
            0,
            100);

    return lib_alias::range_valid(&range) and
         lib_alias::range_width(&range) == 100 and
         lib_alias::range_contains(&range, 0) and
         lib_alias::range_contains(&range, 42) and
         lib_alias::range_contains(&range, 100) and
         not lib_alias::range_contains(&range, 101);
}

proc test_record_literal() -> i64 {
    let record: lib_alias::Record =
        lib_alias::Record {
            id: 42,
            value: 42,
            enabled: true,
        };

    return record.value;
}

proc test_record_factory() -> i64 {
    let record: lib_alias::Record =
        lib_alias::make_record(
            42,
            42,
            true);

    return lib_alias::record_value(&record);
}

proc test_record_consumers() -> bool {
    let record: lib_alias::Record =
        lib_alias::make_record(
            42,
            42,
            true);

    return lib_alias::record_id(&record) == 42 and
         lib_alias::record_value(&record) == 42 and
         lib_alias::record_enabled(&record);
}

proc test_pair_literal() -> i64 {
    let pair: lib_alias::Pair =
        lib_alias::Pair {
            first: 20,
            second: 22,
        };

    return pair.first +
         pair.second;
}

proc test_pair_factory() -> i64 {
    let pair: lib_alias::Pair =
        lib_alias::make_pair(
            20,
            22);

    return lib_alias::pair_sum(&pair);
}

proc test_counter() -> i64 {
    let counter: lib_alias::Counter =
        lib_alias::make_counter(
            lib_alias::ANSWER);

    return lib_alias::counter_value(&counter);
}

proc test_nested() -> i64 {
    let point: lib_alias::Point =
        lib_alias::make_point(
            10,
            10);

    let range: lib_alias::Range =
        lib_alias::make_range(
            0,
            22);

    let nested: lib_alias::Nested =
        lib_alias::make_nested(
            point,
            range);

    return lib_alias::nested_value(&nested);
}

proc test_envelope() -> i64 {
    let record: lib_alias::Record =
        lib_alias::make_record(
            42,
            20,
            true);

    let pair: lib_alias::Pair =
        lib_alias::make_pair(
            10,
            12);

    let envelope: lib_alias::Envelope =
        lib_alias::make_envelope(
            record,
            pair);

    return lib_alias::envelope_value(
        &envelope);
}

proc consume_point(
    point: &lib_alias::Point
) -> i64 {
    return lib_alias::point_sum(point);
}

proc produce_point(
    x: i64,
    y: i64
) -> lib_alias::Point {
    return lib_alias::make_point(
        x,
        y);
}

proc test_alias_type_parameter() -> i64 {
    let point: lib_alias::Point =
        lib_alias::make_point(
            20,
            22);

    return consume_point(&point);
}

proc test_alias_type_return() -> i64 {
    let point: lib_alias::Point =
        produce_point(
            20,
            22);

    return lib_alias::point_sum(&point);
}

proc consume_range(
    range: &lib_alias::Range
) -> i64 {
    return lib_alias::range_width(range);
}

proc produce_range(
    minimum: i64,
    maximum: i64
) -> lib_alias::Range {
    return lib_alias::make_range(
        minimum,
        maximum);
}

proc test_multiple_alias_types() -> i64 {
    let point: lib_alias::Point =
        produce_point(
            10,
            10);

    let range: lib_alias::Range =
        produce_range(
            0,
            22);

    return consume_point(&point) +
         consume_range(&range);
}

proc test_reference_parameters() -> i64 {
    let point: lib_alias::Point =
        lib_alias::make_point(
            20,
            22);

    let range: lib_alias::Range =
        lib_alias::make_range(
            0,
            42);

    let record: lib_alias::Record =
        lib_alias::make_record(
            42,
            42,
            true);

    let pair: lib_alias::Pair =
        lib_alias::make_pair(
            20,
            22);

    return lib_alias::point_sum(&point) +
         lib_alias::range_width(&range) +
         lib_alias::record_value(&record) +
         lib_alias::pair_sum(&pair);
}

proc test_alias_constant_in_form() -> i64 {
    let point: lib_alias::Point =
        lib_alias::Point {
            x: lib_alias::ANSWER,
            y: lib_alias::ZERO,
        };

    return lib_alias::point_sum(&point);
}

proc test_alias_calls_in_form() -> i64 {
    let point: lib_alias::Point =
        lib_alias::Point {
            x: lib_alias::identity(20),
            y: lib_alias::identity(22),
        };

    return lib_alias::point_sum(&point);
}

proc test_factory_composition() -> i64 {
    let point: lib_alias::Point =
        lib_alias::make_point(
            lib_alias::add(10, 10),
            lib_alias::subtract(50, 28));

    return lib_alias::point_sum(&point);
}

proc test_nested_block() -> i64 {
    let mut result: i64 =
        lib_alias::ZERO;

    {
        let point: lib_alias::Point =
            lib_alias::make_point(
                20,
                22);

        set result =
            lib_alias::point_sum(&point);
    }

    return result;
}

proc test_deep_block() -> i64 {
    let mut result: i64 =
        lib_alias::ZERO;

    {
        let left: i64 =
            lib_alias::identity(20);

        {
            let right: i64 =
                lib_alias::identity(22);

            {
                set result =
                    lib_alias::add(
                        left,
                        right);
            }
        }
    }

    return result;
}

proc test_if() -> i64 {
    if lib_alias::is_answer(
        lib_alias::ANSWER) {
        return lib_alias::identity(
            lib_alias::ANSWER);
    }

    return lib_alias::ZERO;
}

proc test_if_else(
    condition: bool
) -> i64 {
    if condition {
        return lib_alias::add(
            20,
            22);
    } else {
        return lib_alias::subtract(
            100,
            58);
    }
}

proc test_loop() -> i64 {
    let mut index: i64 =
        lib_alias::ZERO;

    let mut result: i64 =
        lib_alias::ZERO;

    while index < 6 {
        set result =
            lib_alias::add(
                result,
                7);

        set index =
            lib_alias::increment(index);
    }

    return result;
}

proc test_mutable_value() -> i64 {
    let mut value: i64 =
        lib_alias::ZERO;

    set value =
        lib_alias::ANSWER;

    return lib_alias::identity(value);
}

proc test_mutable_call_chain() -> i64 {
    let mut value: i64 =
        lib_alias::identity(20);

    set value =
        lib_alias::add(
            value,
            22);

    return lib_alias::identity(value);
}

proc test_repeated_constant_resolution() -> bool {
    return lib_alias::ANSWER == 42 and
         lib_alias::ANSWER == 42 and
         lib_alias::ANSWER == 42 and
         lib_alias::ANSWER == 42 and
         lib_alias::ANSWER == 42;
}

proc test_repeated_proc_resolution() -> bool {
    return lib_alias::identity(42) == 42 and
         lib_alias::identity(42) == 42 and
         lib_alias::identity(42) == 42 and
         lib_alias::identity(42) == 42 and
         lib_alias::identity(42) == 42;
}

proc test_repeated_type_resolution() -> i64 {
    let first: lib_alias::Point =
        lib_alias::make_point(
            10,
            10);

    let second: lib_alias::Point =
        lib_alias::make_point(
            11,
            11);

    let third: lib_alias::Point =
        lib_alias::make_point(
            0,
            0);

    return lib_alias::point_sum(&first) +
         lib_alias::point_sum(&second) +
         lib_alias::point_sum(&third);
}

proc test_local_bindings() -> i64 {
    let first: i64 =
        lib_alias::identity(10);

    let second: i64 =
        lib_alias::identity(20);

    let third: i64 =
        lib_alias::identity(12);

    return lib_alias::add(
        lib_alias::add(
            first,
            second),
        third);
}

proc test_expression_tree() -> i64 {
    return lib_alias::add(
        lib_alias::identity(
            lib_alias::add(
                lib_alias::ZERO,
                lib_alias::identity(10))),
        lib_alias::identity(
            lib_alias::add(
                lib_alias::identity(20),
                lib_alias::subtract(
                    lib_alias::ANSWER,
                    30))));
}

proc test_compose_answer() -> i64 {
    return lib_alias::compose_answer();
}

proc test_answer_point() -> i64 {
    let point: lib_alias::Point =
        lib_alias::make_answer_point();

    return lib_alias::point_sum(&point);
}

proc test_answer_range() -> i64 {
    let range: lib_alias::Range =
        lib_alias::make_answer_range();

    return lib_alias::range_width(&range);
}

proc test_answer_record() -> i64 {
    let record: lib_alias::Record =
        lib_alias::make_answer_record();

    return lib_alias::record_value(&record);
}

proc test_answer_pair() -> i64 {
    let pair: lib_alias::Pair =
        lib_alias::make_answer_pair();

    return lib_alias::pair_sum(&pair);
}

proc test_answer_nested() -> i64 {
    let nested: lib_alias::Nested =
        lib_alias::make_answer_nested();

    return lib_alias::nested_value(&nested);
}

proc test_answer_envelope() -> i64 {
    let envelope: lib_alias::Envelope =
        lib_alias::make_answer_envelope();

    return lib_alias::envelope_value(&envelope);
}

proc test_default_state() -> bool {
    let state: lib_alias::State =
        lib_alias::default_state();

    return state ==
         lib_alias::State.Idle;
}

proc test_ready_state() -> bool {
    let state: lib_alias::State =
        lib_alias::ready_state();

    return state ==
         lib_alias::State.Ready;
}

proc test_running_state() -> bool {
    let state: lib_alias::State =
        lib_alias::running_state();

    return state ==
         lib_alias::State.Running;
}

proc test_finished_state() -> bool {
    let state: lib_alias::State =
        lib_alias::finished_state();

    return state ==
         lib_alias::State.Finished;
}

proc test_result_kinds() -> bool {
    let success: lib_alias::ResultKind =
        lib_alias::success_kind();

    let failure: lib_alias::ResultKind =
        lib_alias::failure_kind();

    return success ==
             lib_alias::ResultKind.Success and
         failure ==
             lib_alias::ResultKind.Failure;
}

proc test_directions() -> bool {
    let left: lib_alias::Direction =
        lib_alias::left_direction();

    let right: lib_alias::Direction =
        lib_alias::right_direction();

    return left ==
             lib_alias::Direction.Left and
         right ==
             lib_alias::Direction.Right;
}

proc test_cross_category() -> bool {
    let point: lib_alias::Point =
        lib_alias::make_point(
            lib_alias::identity(20),
            lib_alias::identity(22));

    let range: lib_alias::Range =
        lib_alias::make_range(
            lib_alias::ZERO,
            lib_alias::ANSWER);

    let record: lib_alias::Record =
        lib_alias::make_record(
            lib_alias::LIMIT,
            lib_alias::point_sum(&point),
            lib_alias::ENABLED);

    let pair: lib_alias::Pair =
        lib_alias::make_pair(
            range.minimum,
            range.maximum);

    return lib_alias::point_sum(&point) ==
             lib_alias::ANSWER and
         lib_alias::range_width(&range) ==
             lib_alias::ANSWER and
         lib_alias::record_value(&record) ==
             lib_alias::ANSWER and
         lib_alias::pair_sum(&pair) ==
             lib_alias::ANSWER;
}

proc test_integrated_module_alias() -> bool {
    let left: i64 =
        lib_alias::identity(20);

    let right: i64 =
        lib_alias::identity(22);

    let point: lib_alias::Point =
        lib_alias::make_point(
            left,
            right);

    let range: lib_alias::Range =
        lib_alias::make_range(
            lib_alias::ZERO,
            lib_alias::point_sum(&point));

    let record: lib_alias::Record =
        lib_alias::make_record(
            lib_alias::LIMIT,
            lib_alias::range_width(&range),
            lib_alias::ENABLED);

    let pair: lib_alias::Pair =
        lib_alias::make_pair(
            point.x,
            point.y);

    let nested: lib_alias::Nested =
        lib_alias::make_nested(
            point,
            range);

    let mut result: i64 =
        lib_alias::ZERO;

    if lib_alias::is_answer(
        lib_alias::record_value(&record)) {
        set result =
            lib_alias::pair_sum(&pair);
    }

    return result ==
             lib_alias::ANSWER and
         lib_alias::point_sum(&point) ==
             lib_alias::ANSWER and
         lib_alias::range_width(&range) ==
             lib_alias::ANSWER and
         lib_alias::record_value(&record) ==
             lib_alias::ANSWER and
         lib_alias::pair_sum(&pair) ==
             lib_alias::ANSWER and
         lib_alias::nested_value(&nested) ==
             84;
}

proc main() -> int {
    if not test_constant_aliases() { return 1; }
    if test_constant_expression() != 42 { return 2; }
    if test_constant_arithmetic() != 42 { return 3; }
    if test_identity() != 42 { return 4; }
    if test_add() != 42 { return 5; }
    if test_subtract() != 42 { return 6; }
    if test_multiply() != 42 { return 7; }
    if test_increment() != 42 { return 8; }
    if test_answer() != 42 { return 9; }
    if not test_predicates() { return 10; }
    if test_nested_calls() != 42 { return 11; }
    if test_deep_calls() != 42 { return 12; }
    if test_mixed_calls() != 42 { return 13; }
    if test_point_literal() != 42 { return 14; }
    if test_point_factory() != 42 { return 15; }
    if not test_point_consumers() { return 16; }
    if test_multiple_points() != 42 { return 17; }
    if test_range_literal() != 42 { return 18; }
    if test_range_factory() != 42 { return 19; }
    if not test_range_operations() { return 20; }
    if test_record_literal() != 42 { return 21; }
    if test_record_factory() != 42 { return 22; }
    if not test_record_consumers() { return 23; }
    if test_pair_literal() != 42 { return 24; }
    if test_pair_factory() != 42 { return 25; }
    if test_counter() != 42 { return 26; }
    if test_nested() != 42 { return 27; }
    if test_envelope() != 42 { return 28; }
    if test_alias_type_parameter() != 42 { return 29; }
    if test_alias_type_return() != 42 { return 30; }
    if test_multiple_alias_types() != 42 { return 31; }
    if test_reference_parameters() != 168 { return 32; }
    if test_alias_constant_in_form() != 42 { return 33; }
    if test_alias_calls_in_form() != 42 { return 34; }
    if test_factory_composition() != 42 { return 35; }
    if test_nested_block() != 42 { return 36; }
    if test_deep_block() != 42 { return 37; }
    if test_if() != 42 { return 38; }
    if test_if_else(true) != 42 { return 39; }
    if test_if_else(false) != 42 { return 40; }
    if test_loop() != 42 { return 41; }
    if test_mutable_value() != 42 { return 42; }
    if test_mutable_call_chain() != 42 { return 43; }
    if not test_repeated_constant_resolution() { return 44; }
    if not test_repeated_proc_resolution() { return 45; }
    if test_repeated_type_resolution() != 42 { return 46; }
    if test_local_bindings() != 42 { return 47; }
    if test_expression_tree() != 42 { return 48; }
    if test_compose_answer() != 42 { return 49; }
    if test_answer_point() != 42 { return 50; }
    if test_answer_range() != 42 { return 51; }
    if test_answer_record() != 42 { return 52; }
    if test_answer_pair() != 42 { return 53; }
    if test_answer_nested() != 42 { return 54; }
    if test_answer_envelope() != 42 { return 55; }
    if not test_default_state() { return 56; }
    if not test_ready_state() { return 57; }
    if not test_running_state() { return 58; }
    if not test_finished_state() { return 59; }
    if not test_result_kinds() { return 60; }
    if not test_directions() { return 61; }
    if not test_cross_category() { return 62; }
    if not test_integrated_module_alias() { return 63; }

    return 0;
}