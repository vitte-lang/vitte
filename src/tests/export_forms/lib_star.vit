/// Star-export fixture.
///
/// This module provides a broad public surface intended to be re-exported
/// through wildcard export forms.
///
/// Coverage:
/// - primitive constants;
/// - forms;
/// - nested forms;
/// - picks;
/// - scalar procedures;
/// - predicates;
/// - constructors;
/// - consumers;
/// - reference parameters;
/// - procedures returning exported forms;
/// - procedures returning exported picks;
/// - declarations depending on other exported declarations;
/// - mutable local state;
/// - control flow;
/// - composed operations.
///
/// Consumers of this module should be able to expose its exported surface
/// through a star export without changing declaration identity or type.

space tests::export_forms::lib_star;

export const ZERO: i64 = 0;
export const ONE: i64 = 1;
export const TWO: i64 = 2;
export const TEN: i64 = 10;
export const TWELVE: i64 = 12;
export const TWENTY: i64 = 20;
export const TWENTY_TWO: i64 = 22;
export const ANSWER: i64 = 42;
export const LIMIT: u64 = 100;
export const MINIMUM: i64 = 0;
export const MAXIMUM: i64 = 100;
export const ENABLED: bool = true;
export const DISABLED: bool = false;

export form Point {
    x: i64,
    y: i64,
}

export form Range {
    minimum: i64,
    maximum: i64,
}

export form Record {
    id: u64,
    value: i64,
    enabled: bool,
}

export form Pair {
    first: i64,
    second: i64,
}

export form Counter {
    value: i64,
}

export form Rectangle {
    minimum: Point,
    maximum: Point,
}

export form Nested {
    point: Point,
    range: Range,
}

export form Envelope {
    record: Record,
    pair: Pair,
}

export form StateRecord {
    value: i64,
    enabled: bool,
}

export pick State {
    Idle,
    Ready,
    Running,
    Finished,
}

export pick ResultKind {
    Success,
    Failure,
}

export pick Direction {
    Left,
    Right,
}

export pick Ordering {
    Less,
    Equal,
    Greater,
}

export proc identity(
    value: i64
) -> i64 {
    return value;
}

export proc add(
    left: i64,
    right: i64
) -> i64 {
    return left + right;
}

export proc subtract(
    left: i64,
    right: i64
) -> i64 {
    return left - right;
}

export proc multiply(
    left: i64,
    right: i64
) -> i64 {
    return left * right;
}

export proc divide(
    left: i64,
    right: i64
) -> i64 {
    return left / right;
}

export proc modulo(
    left: i64,
    right: i64
) -> i64 {
    return left % right;
}

export proc increment(
    value: i64
) -> i64 {
    return value + ONE;
}

export proc decrement(
    value: i64
) -> i64 {
    return value - ONE;
}

export proc answer() -> i64 {
    return ANSWER;
}

export proc zero() -> i64 {
    return ZERO;
}

export proc is_zero(
    value: i64
) -> bool {
    return value == ZERO;
}

export proc is_positive(
    value: i64
) -> bool {
    return value > ZERO;
}

export proc is_negative(
    value: i64
) -> bool {
    return value < ZERO;
}

export proc is_non_negative(
    value: i64
) -> bool {
    return value >= ZERO;
}

export proc is_answer(
    value: i64
) -> bool {
    return value == ANSWER;
}

export proc within_limit(
    value: i64
) -> bool {
    return value >= ZERO and
         value <= (LIMIT as i64);
}

export proc between(
    value: i64,
    minimum: i64,
    maximum: i64
) -> bool {
    return value >= minimum and
         value <= maximum;
}

export proc maximum(
    left: i64,
    right: i64
) -> i64 {
    if left >= right {
        return left;
    }

    return right;
}

export proc minimum(
    left: i64,
    right: i64
) -> i64 {
    if left <= right {
        return left;
    }

    return right;
}

export proc clamp(
    value: i64,
    minimum_value: i64,
    maximum_value: i64
) -> i64 {
    if value < minimum_value {
        return minimum_value;
    }

    if value > maximum_value {
        return maximum_value;
    }

    return value;
}

export proc absolute(
    value: i64
) -> i64 {
    if value < ZERO {
        return -value;
    }

    return value;
}

export proc make_point(
    x: i64,
    y: i64
) -> Point {
    return Point {
        x: x,
        y: y,
    };
}

export proc make_origin() -> Point {
    return Point {
        x: ZERO,
        y: ZERO,
    };
}

export proc make_answer_point() -> Point {
    return Point {
        x: TWENTY,
        y: TWENTY_TWO,
    };
}

export proc point_x(
    point: &Point
) -> i64 {
    return point.x;
}

export proc point_y(
    point: &Point
) -> i64 {
    return point.y;
}

export proc point_sum(
    point: &Point
) -> i64 {
    return point.x +
         point.y;
}

export proc point_equal(
    left: &Point,
    right: &Point
) -> bool {
    return left.x == right.x and
         left.y == right.y;
}

export proc point_translate(
    point: &Point,
    dx: i64,
    dy: i64
) -> Point {
    return Point {
        x: point.x + dx,
        y: point.y + dy,
    };
}

export proc point_scale(
    point: &Point,
    factor: i64
) -> Point {
    return Point {
        x: point.x * factor,
        y: point.y * factor,
    };
}

export proc make_range(
    minimum_value: i64,
    maximum_value: i64
) -> Range {
    return Range {
        minimum: minimum_value,
        maximum: maximum_value,
    };
}

export proc make_answer_range() -> Range {
    return Range {
        minimum: ZERO,
        maximum: ANSWER,
    };
}

export proc range_minimum(
    range: &Range
) -> i64 {
    return range.minimum;
}

export proc range_maximum(
    range: &Range
) -> i64 {
    return range.maximum;
}

export proc range_width(
    range: &Range
) -> i64 {
    return range.maximum -
         range.minimum;
}

export proc range_valid(
    range: &Range
) -> bool {
    return range.minimum <=
         range.maximum;
}

export proc range_contains(
    range: &Range,
    value: i64
) -> bool {
    return value >= range.minimum and
         value <= range.maximum;
}

export proc range_clamp(
    range: &Range,
    value: i64
) -> i64 {
    if value < range.minimum {
        return range.minimum;
    }

    if value > range.maximum {
        return range.maximum;
    }

    return value;
}

export proc make_record(
    id: u64,
    value: i64,
    enabled: bool
) -> Record {
    return Record {
        id: id,
        value: value,
        enabled: enabled,
    };
}

export proc make_answer_record() -> Record {
    return Record {
        id: ANSWER as u64,
        value: ANSWER,
        enabled: ENABLED,
    };
}

export proc record_id(
    record: &Record
) -> u64 {
    return record.id;
}

export proc record_value(
    record: &Record
) -> i64 {
    return record.value;
}

export proc record_enabled(
    record: &Record
) -> bool {
    return record.enabled;
}

export proc record_valid(
    record: &Record
) -> bool {
    return record.enabled and
         record.value >= ZERO;
}

export proc make_pair(
    first: i64,
    second: i64
) -> Pair {
    return Pair {
        first: first,
        second: second,
    };
}

export proc make_answer_pair() -> Pair {
    return Pair {
        first: TWENTY,
        second: TWENTY_TWO,
    };
}

export proc pair_first(
    pair: &Pair
) -> i64 {
    return pair.first;
}

export proc pair_second(
    pair: &Pair
) -> i64 {
    return pair.second;
}

export proc pair_sum(
    pair: &Pair
) -> i64 {
    return pair.first +
         pair.second;
}

export proc pair_equal(
    left: &Pair,
    right: &Pair
) -> bool {
    return left.first == right.first and
         left.second == right.second;
}

export proc make_counter(
    value: i64
) -> Counter {
    return Counter {
        value: value,
    };
}

export proc counter_value(
    counter: &Counter
) -> i64 {
    return counter.value;
}

export proc counter_incremented(
    counter: &Counter
) -> Counter {
    return Counter {
        value: counter.value + ONE,
    };
}

export proc make_rectangle(
    minimum_point: Point,
    maximum_point: Point
) -> Rectangle {
    return Rectangle {
        minimum: minimum_point,
        maximum: maximum_point,
    };
}

export proc rectangle_width(
    rectangle: &Rectangle
) -> i64 {
    return rectangle.maximum.x -
         rectangle.minimum.x;
}

export proc rectangle_height(
    rectangle: &Rectangle
) -> i64 {
    return rectangle.maximum.y -
         rectangle.minimum.y;
}

export proc rectangle_area(
    rectangle: &Rectangle
) -> i64 {
    return rectangle_width(rectangle) *
         rectangle_height(rectangle);
}

export proc make_nested(
    point: Point,
    range: Range
) -> Nested {
    return Nested {
        point: point,
        range: range,
    };
}

export proc make_answer_nested() -> Nested {
    let point: Point =
        make_point(
            TEN,
            TEN);

    let range: Range =
        make_range(
            ZERO,
            TWENTY_TWO);

    return make_nested(
        point,
        range);
}

export proc nested_point_sum(
    nested: &Nested
) -> i64 {
    return point_sum(
        &nested.point);
}

export proc nested_range_width(
    nested: &Nested
) -> i64 {
    return range_width(
        &nested.range);
}

export proc nested_value(
    nested: &Nested
) -> i64 {
    return nested_point_sum(nested) +
         nested_range_width(nested);
}

export proc make_envelope(
    record: Record,
    pair: Pair
) -> Envelope {
    return Envelope {
        record: record,
        pair: pair,
    };
}

export proc make_answer_envelope() -> Envelope {
    let record: Record =
        make_record(
            ANSWER as u64,
            TWENTY,
            ENABLED);

    let pair: Pair =
        make_pair(
            TEN,
            TWELVE);

    return make_envelope(
        record,
        pair);
}

export proc envelope_record_value(
    envelope: &Envelope
) -> i64 {
    return record_value(
        &envelope.record);
}

export proc envelope_pair_sum(
    envelope: &Envelope
) -> i64 {
    return pair_sum(
        &envelope.pair);
}

export proc envelope_value(
    envelope: &Envelope
) -> i64 {
    return envelope_record_value(envelope) +
         envelope_pair_sum(envelope);
}

export proc make_state_record(
    value: i64,
    enabled: bool
) -> StateRecord {
    return StateRecord {
        value: value,
        enabled: enabled,
    };
}

export proc state_record_valid(
    record: &StateRecord
) -> bool {
    return record.enabled and
         record.value >= ZERO;
}

export proc state_record_value(
    record: &StateRecord
) -> i64 {
    return record.value;
}

export proc default_state() -> State {
    return State.Idle;
}

export proc ready_state() -> State {
    return State.Ready;
}

export proc running_state() -> State {
    return State.Running;
}

export proc finished_state() -> State {
    return State.Finished;
}

export proc success_kind() -> ResultKind {
    return ResultKind.Success;
}

export proc failure_kind() -> ResultKind {
    return ResultKind.Failure;
}

export proc left_direction() -> Direction {
    return Direction.Left;
}

export proc right_direction() -> Direction {
    return Direction.Right;
}

export proc compare(
    left: i64,
    right: i64
) -> Ordering {
    if left < right {
        return Ordering.Less;
    }

    if left > right {
        return Ordering.Greater;
    }

    return Ordering.Equal;
}

export proc compose_answer() -> i64 {
    return add(
        TWENTY,
        TWENTY_TWO);
}

export proc compose_answer_nested() -> i64 {
    return identity(
        add(
            identity(TWENTY),
            identity(TWENTY_TWO)));
}

export proc sum_point_and_range(
    point: &Point,
    range: &Range
) -> i64 {
    return point_sum(point) +
         range_width(range);
}

export proc sum_record_and_pair(
    record: &Record,
    pair: &Pair
) -> i64 {
    return record_value(record) +
         pair_sum(pair);
}

export proc make_composed_answer() -> i64 {
    let point: Point =
        make_point(
            TEN,
            TEN);

    let range: Range =
        make_range(
            ZERO,
            TWENTY_TWO);

    return sum_point_and_range(
        &point,
        &range);
}

export proc repeated_answer() -> bool {
    return answer() == ANSWER and
         identity(ANSWER) == ANSWER and
         add(TWENTY, TWENTY_TWO) == ANSWER and
         subtract(100, 58) == ANSWER and
         multiply(6, 7) == ANSWER;
}

export proc arithmetic_pipeline(
    value: i64
) -> i64 {
    let first: i64 =
        add(
            value,
            TEN);

    let second: i64 =
        multiply(
            first,
            TWO);

    let third: i64 =
        subtract(
            second,
            TWENTY);

    return third;
}

export proc bounded_add(
    left: i64,
    right: i64
) -> i64 {
    let value: i64 =
        add(
            left,
            right);

    return clamp(
        value,
        MINIMUM,
        MAXIMUM);
}

export proc accumulate_to_answer() -> i64 {
    let mut value: i64 =
        ZERO;

    let mut index: i64 =
        ZERO;

    while index < 6 {
        set value =
            add(
                value,
                7);

        set index =
            increment(index);
    }

    return value;
}

export proc conditional_answer(
    enabled: bool
) -> i64 {
    if enabled {
        return ANSWER;
    }

    return ZERO;
}

export proc nested_conditional_answer(
    value: i64
) -> i64 {
    if value == ANSWER {
        return ANSWER;
    }

    if value > ANSWER {
        return subtract(
            value,
            subtract(
                value,
                ANSWER));
    }

    return add(
        value,
        subtract(
            ANSWER,
            value));
}

export proc validate_answer_point(
    point: &Point
) -> bool {
    return point_sum(point) ==
         ANSWER;
}

export proc validate_answer_range(
    range: &Range
) -> bool {
    return range_valid(range) and
         range_width(range) ==
             ANSWER;
}

export proc validate_answer_record(
    record: &Record
) -> bool {
    return record_enabled(record) and
         record_value(record) ==
             ANSWER;
}

export proc validate_answer_pair(
    pair: &Pair
) -> bool {
    return pair_sum(pair) ==
         ANSWER;
}

export proc validate_answer_nested(
    nested: &Nested
) -> bool {
    return nested_value(nested) ==
         ANSWER;
}

export proc validate_answer_envelope(
    envelope: &Envelope
) -> bool {
    return envelope_value(envelope) ==
         ANSWER;
}

export proc library_self_test() -> bool {
    let point: Point =
        make_answer_point();

    let range: Range =
        make_answer_range();

    let record: Record =
        make_answer_record();

    let pair: Pair =
        make_answer_pair();

    let nested: Nested =
        make_answer_nested();

    let envelope: Envelope =
        make_answer_envelope();

    let counter: Counter =
        make_counter(
            ANSWER);

    let state_record: StateRecord =
        make_state_record(
            ANSWER,
            ENABLED);

    return ZERO == 0 and
         ONE == 1 and
         TWO == 2 and
         TEN == 10 and
         TWELVE == 12 and
         TWENTY == 20 and
         TWENTY_TWO == 22 and
         ANSWER == 42 and
         LIMIT == 100 and
         MINIMUM == 0 and
         MAXIMUM == 100 and
         ENABLED and
         not DISABLED and
         identity(ANSWER) == 42 and
         add(TWENTY, TWENTY_TWO) == 42 and
         subtract(100, 58) == 42 and
         multiply(6, 7) == 42 and
         divide(84, 2) == 42 and
         modulo(100, 58) == 42 and
         increment(41) == 42 and
         decrement(43) == 42 and
         is_zero(ZERO) and
         is_positive(ANSWER) and
         is_negative(-ONE) and
         is_non_negative(ZERO) and
         is_answer(ANSWER) and
         within_limit(ANSWER) and
         between(ANSWER, ZERO, LIMIT as i64) and
         maximum(TWENTY, TWENTY_TWO) == 22 and
         minimum(TWENTY, TWENTY_TWO) == 20 and
         clamp(ANSWER, ZERO, LIMIT as i64) == 42 and
         absolute(-ANSWER) == 42 and
         validate_answer_point(&point) and
         validate_answer_range(&range) and
         validate_answer_record(&record) and
         validate_answer_pair(&pair) and
         validate_answer_nested(&nested) and
         validate_answer_envelope(&envelope) and
         counter_value(&counter) == 42 and
         state_record_valid(&state_record) and
         state_record_value(&state_record) == 42 and
         default_state() == State.Idle and
         ready_state() == State.Ready and
         running_state() == State.Running and
         finished_state() == State.Finished and
         success_kind() == ResultKind.Success and
         failure_kind() == ResultKind.Failure and
         left_direction() == Direction.Left and
         right_direction() == Direction.Right and
         compare(20, 22) == Ordering.Less and
         compare(42, 42) == Ordering.Equal and
         compare(22, 20) == Ordering.Greater and
         compose_answer() == 42 and
         compose_answer_nested() == 42 and
         make_composed_answer() == 42 and
         repeated_answer() and
         arithmetic_pipeline(21) == 42 and
         bounded_add(20, 22) == 42 and
         accumulate_to_answer() == 42 and
         conditional_answer(true) == 42 and
         nested_conditional_answer(10) == 42 and
         nested_conditional_answer(42) == 42 and
         nested_conditional_answer(100) == 42;
}
