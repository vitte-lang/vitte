/// C17 executable port of the former LLVM integer-width probe.
///
/// The test keeps the important runtime guarantees while using the current
/// source pipeline: unsigned 64-bit values, narrow unsigned values, signed
/// arithmetic, conversions, floating-point values, and lexical shadowing.

space compiler/llvm_integer_width_runtime;

form Layout {
    redzone: u64,
}

proc counter() -> u64 {
    let mut value: u64 = 0;
    while value < 5 {
        set value = value + 1;
    }
    give value;
}

proc narrow_counter() -> u8 {
    let mut value: u8 = 0 as u8;
    while value < 5 {
        set value = value + (1 as u8);
    }
    give value;
}

proc layout(windows: bool) -> Layout {
    give Layout {
        redzone: if windows { 0 as u64 } else { 128 as u64 },
    };
}

proc mixed_add(small: u8, wide: i64) -> i64 {
    give small + wide;
}

proc signed_float(value: i64) -> f64 {
    give value as f64;
}

proc shadow(flag: bool) -> i64 {
    let mut value: i64 = 7;

    if flag {
        let value: bool = true;
        if not value {
            give 1;
        }
    } else {
        let value: u64 = 4294967296;
        if value != 4294967296 {
            give 2;
        }
    }

    set value = value + 1;
    give value;
}

proc main() -> int {
    let windows: Layout = layout(true);
    let other: Layout = layout(false);

    if counter() != 5 or narrow_counter() != 5 {
        give 1;
    }
    if mixed_add(3 as u8, 4) != 7 {
        give 2;
    }
    if windows.redzone != 0 or other.redzone != 128 {
        give 3;
    }
    if signed_float(-3) != -3.0 {
        give 4;
    }
    if shadow(true) != 8 or shadow(false) != 8 {
        give 5;
    }
    give 0;
}
