/// C17 executable port of the former streaming-summary probe.
///
/// The original fixture called the absent self-hosted driver. This keeps its
/// observable invariants as a real executable: import/export counts, owned
/// code-generation items, chunked-analysis decisions, and nested nominal data.

space compiler/streaming_summary_runtime;

form Summary {
    imports: i64,
    exports: i64,
    owned_items: i64,
    chunked: bool,
}

form ChildSummary {
    boundary_items: i64,
    unrelated_items: i64,
}

proc summarize(
    imports: i64,
    exports: i64,
    owned_items: i64,
    chunked: bool
) -> Summary {
    give Summary {
        imports: imports,
        exports: exports,
        owned_items: owned_items,
        chunked: chunked,
    };
}

proc requires_chunked_analysis(kind: i64) -> bool {
    give kind == 1 or kind == 2 or kind == 3;
}

proc main() -> int {
    let summary: Summary = summarize(1, 1, 1, true);
    let facade: Summary = summarize(1, 0, 0, false);
    let child: ChildSummary = ChildSummary {
        boundary_items: 1,
        unrelated_items: 0,
    };

    if summary.imports != 1 or summary.exports != 1 {
        give 1;
    }
    if summary.owned_items != 1 or not summary.chunked {
        give 2;
    }
    if facade.exports != 0 or facade.owned_items != 0 or facade.chunked {
        give 3;
    }
    if child.boundary_items != 1 or child.unrelated_items != 0 {
        give 4;
    }
    if not requires_chunked_analysis(1) or
       not requires_chunked_analysis(2) or
       not requires_chunked_analysis(3) or
       requires_chunked_analysis(0) {
        give 5;
    }
    give 0;
}
