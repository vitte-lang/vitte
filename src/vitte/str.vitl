space vitte/str

use vitte/stdlib/core { * }
use vitte/stdlib/core/utils.{ trim_spaces, ends_with as core_ends_with }

proc from_int(value: int) -> string {
  give to_string_int(value)
}

proc from_i64(value: i64) -> string {
  give to_string_i64(value)
}

proc from_bool(value: bool) -> string {
  give to_string_bool(value)
}

proc trim(value: string) -> string {
  give trim_spaces(value)
}

proc ends_with(value: string, suffix: string) -> bool {
  give core_ends_with(value, suffix)
}

export *
