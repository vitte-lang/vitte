space vitte/compiler/tests/frontend_fixtures/valid/parser

proc grammar_surface_source() -> string {
  give
    "space demo/app;\n" +
    "use demo/math as math;\n" +
    "proc main() -> int { let x: int = 1; if x { set x = math.sum(x, 1); } give x; }\n";
}

proc bits_surface_source() -> string {
  give
    "bits Mode: u8 {\n" +
    "  read: 0 .. 1,\n" +
    "  write: 1 .. 2,\n" +
    "  exec: 2 .. 3,\n" +
    "}\n";
}

proc parser_total_surface_source() -> string {
  give
    "## parser-total surface doc\n" +
    "#[demo.attr(answer = 42, name = \"vitte\")]\n" +
    "space demo/parser/total;\n" +
    "use .demo.parser.{ alpha, beta as gamma, * };\n" +
    "flags Access {\n" +
    "  read,\n" +
    "  write,\n" +
    "}\n" +
    "form Pair {\n" +
    "  left: int,\n" +
    "  right: int,\n" +
    "}\n" +
    "proc combine[T: int](left: int, right: int, ...rest: int) -> int effects(io, alloc) requires(debug) where T: int {\n" +
    "  let rel = left < right;\n" +
    "  let exp = 1.0e+2;\n" +
    "  let tuple = (left, right);\n" +
    "  let call = alpha(left, named: right);\n" +
    "  let lambda = |item: int| item + 1;\n" +
    "  match tuple { (a, b) => { give a + b; } }\n" +
    "  give call;\n" +
    "}\n";
}

export *
