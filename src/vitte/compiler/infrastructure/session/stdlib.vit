space vitte/compiler/infrastructure/session/stdlib

form StdlibPackage {
  name: string
  version: string
  path: string
  valid: bool
}

form StdlibResolution {
  root_path: string
  packages: [StdlibPackage]
  core_entrypoint: string
  alloc_entrypoint: string
  std_entrypoint: string
  expected_version: string
  valid: bool
  message: string
}

proc stdlib_version_or_default(expected_version: string) -> string {
  if expected_version == "" {
    give "unknown";
  }
  give expected_version;
}

proc stdlib_entrypoint(root_path: string, name: string) -> string {
  give root_path + "/" + name + "/index.vit";
}

proc stdlib_package(name: string, version: string, path: string) -> StdlibPackage {
  give StdlibPackage {
    name: name,
    version: version,
    path: path,
    valid: name != "" and version != "" and path != ""
  };
}

proc resolve_stdlib(root_path: string, expected_version: string) -> StdlibResolution {
  if root_path == "" {
    give StdlibResolution {
      root_path: root_path,
      packages: [],
      core_entrypoint: "",
      alloc_entrypoint: "",
      std_entrypoint: "",
      expected_version: expected_version,
      valid: false,
      message: "stdlib introuvable"
    };
  }
  let version: string = stdlib_version_or_default(expected_version);
  let core_path: string = stdlib_entrypoint(root_path, "core");
  let alloc_path: string = stdlib_entrypoint(root_path, "alloc");
  let std_path: string = stdlib_entrypoint(root_path, "std");
  let core_pkg: StdlibPackage = stdlib_package("vitte.core", version, core_path);
  let alloc_pkg: StdlibPackage = stdlib_package("vitte.alloc", version, alloc_path);
  let std_pkg: StdlibPackage = stdlib_package("vitte.std", version, std_path);
  let valid: bool = core_pkg.valid and alloc_pkg.valid and std_pkg.valid;
  give StdlibResolution {
    root_path: root_path,
    packages: [core_pkg, alloc_pkg, std_pkg],
    core_entrypoint: core_path,
    alloc_entrypoint: alloc_path,
    std_entrypoint: std_path,
    expected_version: expected_version,
    valid: valid,
    message: if valid { "stdlib core/alloc/std loaded" } else { "stdlib introuvable" }
  };
}

proc verify_stdlib_versions(resolution: StdlibResolution) -> bool {
  if not resolution.valid {
    give false;
  }
  if resolution.expected_version == "" {
    give true;
  }
  let i: u64 = 0;
  while i < len(resolution.packages) {
    if resolution.packages[i].version != resolution.expected_version {
      give false;
    }
    set i = i + 1;
  }
  give true;
}
