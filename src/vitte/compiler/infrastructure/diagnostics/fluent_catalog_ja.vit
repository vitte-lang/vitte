    if code == "LIMIT_E_TRAIT_AMBIGUOUS" {
        give fluent_compact_fields("trait ambiguous");
    }

    if code == "LIMIT_E_GENERIC_ARGUMENT_MISSING" {
        give fluent_compact_fields("ジェネリック 引数 欠落");
    }

    if code == "LIMIT_E_GENERIC_BOUND_FAILED" {
        give fluent_compact_fields("ジェネリック bound失敗");
    }

    if code == "LIMIT_E_UNSUPPORTED_TARGET" {
        give fluent_compact_fields("対象は未対応です");
    }

    if code == "LIMIT_E_ABI_MISMATCH" {
        give fluent_compact_fields("abi不一致");
    }

    if code == "LIMIT_E_LINK_FAILED" {
        give fluent_compact_fields("link失敗");
    }

    if code == "LIMIT_E_RUNTIME_PANIC" {
        give fluent_compact_fields("runtime パニック");
    }

    give fluent_diagnostic_fields_empty();
}
