space vitte/compiler/frontend/syntax/attribute

use vitte/compiler/frontend/source/span.{ FrontendSpan }

pick AttributeValue {
    String,
    Identifier,
    Number,
    Bool
}

form AttributeArgument {
    name: string
    value: AttributeValue
    span: FrontendSpan
}

form Attribute {
    name: string
    arguments: [AttributeArgument]
    span: FrontendSpan
}

export *
