space vitte/compiler/frontend/syntax/attribute

use vitte/compiler/frontend/source/span.{ Span }

pick AttributeValue {
    String,
    Identifier,
    Number,
    Bool
}

form AttributeArgument {
    name: string
    value: AttributeValue
    span: Span
}

form Attribute {
    name: string
    arguments: [AttributeArgument]
    span: Span
}

export *
