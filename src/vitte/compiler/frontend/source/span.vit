space vitte/compiler/frontend/source/span

form FrontendSpan {
    file: string
    start: u64
    end: u64
    line: u64
    column: u64
}

proc span_empty() -> FrontendSpan {
    give FrontendSpan {
        file: "",
        start: 0,
        end: 0,
        line: 0,
        column: 0
    };
}

export *
