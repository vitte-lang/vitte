    set system.statistics.lookups =
        system.statistics.lookups + 1;

    let result =
        constant_resolver_resolve(
            ref mut system.pass.constants,
            name,
            allow_private,
            allow_package
        );

    if not result.found {
        set system.statistics.failures =
            system.statistics.failures + 1;
    }

    give result;
}

proc resolution_system_resolve_generic(
    system: ref mut ResolutionSystem,
    name: string
) -> GenericParameterResolution {
    set system.statistics.lookups =
        system.statistics.lookups + 1;

    let result =
        generic_resolver_resolve_parameter(
            ref mut system.pass.generics,
            name
        );

    if not result.found {
        set system.statistics.failures =
            system.statistics.failures + 1;
    }

    give result;
}

proc resolution_system_resolve_overload(
    system: ref mut ResolutionSystem,
    name: string,
    arguments: [OverloadArgument]
) -> OverloadResolution {
    set system.statistics.lookups =
        system.statistics.lookups + 1;

    let result =
        overload_resolver_resolve(
            ref mut system.pass.overloads,
            name,
            arguments
        );

    if not result.found {
        set system.statistics.failures =
            system.statistics.failures + 1;
    }

    give result;
}

proc resolution_system_run(
    system: ref mut ResolutionSystem,
    database: ref ModuleDatabase,
    imports: ref mut ModuleImportTable,
    exports: ref ModuleExportTable,
    module: ModuleId,
    root_scope: ScopeId
) -> ResolutionPassResult {
    set system.state =
        ResolutionSystemState.Running;

    set system.statistics.runs =
        system.statistics.runs + 1;

    let result =
        resolution_pass_run(
            ref mut system.pass,
            database,
            imports,
            exports,
            module,
            root_scope
        );

    if result.valid {
        set system.state =
            ResolutionSystemState.Complete;
    } else {
        set system.state =
            ResolutionSystemState.Failed;

        set system.statistics.failures =
            system.statistics.failures
            + result.failed;
    }

    give result;
}

proc resolution_system_invalidate(
    system: ref mut ResolutionSystem
) {
    resolution_pass_invalidate(
        ref mut system.pass
    );

    set system.statistics.generation =
        system.statistics.generation + 1;

    set system.state =
        ResolutionSystemState.Ready;
}

proc resolution_system_clear_cache(
    system: ref mut ResolutionSystem
) {
    resolution_pass_clear_cache(
        ref mut system.pass
    );
}

proc resolution_system_reset(
    system: ref mut ResolutionSystem
) {
    resolution_pass_reset(
        ref mut system.pass
    );

    set system.state =
        ResolutionSystemState.Ready;

    set system.statistics =
        resolution_system_statistics_empty();
}

proc resolution_system_is_ready(
    system: ref ResolutionSystem
) -> bool {
    give system.state
        == ResolutionSystemState.Ready
        or system.state
        == ResolutionSystemState.Complete;
}

proc resolution_system_has_failed(
    system: ref ResolutionSystem
) -> bool {
    give system.state
        == ResolutionSystemState.Failed;
}

proc resolution_system_statistics(
    system: ref ResolutionSystem
) -> ResolutionSystemStatistics {
    give system.statistics;
}

proc resolution_system_state_name(
    state: ResolutionSystemState
) -> string {
    pick state {
        ResolutionSystemState.Created {
            give "created";
        }

        ResolutionSystemState.Ready {
            give "ready";
        }

        ResolutionSystemState.Running {
            give "running";
        }

        ResolutionSystemState.Complete {
            give "complete";
        }

        ResolutionSystemState.Failed {
            give "failed";
        }
    }

    give "failed";
}
