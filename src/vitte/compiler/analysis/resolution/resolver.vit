    give result;
}

proc resolver_resolve_path(
    resolver: ref mut Resolver,
    database: ref ModuleDatabase,
    scope: ScopeId,
    path: string
) -> PathResolution {
    set resolver.statistics.paths =
        resolver.statistics.paths + 1;

    if resolver.config.track_state {
        resolver_state_set_phase(
            ref mut resolver.state,
            ResolverStatePhase.Paths
        );
    }

    let result =
        path_resolver_resolve_auto(
            ref mut resolver.paths,
            ref mut resolver.modules,
            ref mut resolver.namespaces,
            ref mut resolver.names,
            ref mut resolver.lookup,
            database,
            scope,
            path
        );

    resolver_record(
        resolver,
        result.found
    );

    give result;
}

