proc resolver_resolve_method_with_deref(
    resolver: ref mut Resolver,
    receiver: TypeId,
    deref_types: [TypeId],
    name: string,
    mutable: bool,
    owned: bool
) -> ResolvedMethod {
    set resolver.statistics.methods =
        resolver.statistics.methods + 1;

    let result =
        method_resolver_resolve_with_deref_chain(
            ref mut resolver.methods,
            receiver,
            deref_types,
            name,
            mutable,
            owned
        );

    resolver_record(
        resolver,
        result.found
    );

    give result;
}

proc resolver_resolve_trait(
    resolver: ref mut Resolver,
    trait_definition: DefId,
    subject_type: TypeId
) -> TraitResolution {
    set resolver.statistics.traits =
        resolver.statistics.traits + 1;

    if not resolver.config.resolve_traits {
        let result =
            trait_resolution_invalid(
                Some(trait_definition),
                subject_type,
                TraitResolutionErrorKind.InvalidTrait,
                "trait resolution is disabled"
            );

        resolver_record(
            resolver,
            false
        );

        give result;
    }

    if resolver.config.track_state {
        resolver_state_set_phase(
            ref mut resolver.state,
            ResolverStatePhase.Types
        );
    }

    let result =
        trait_resolver_resolve_simple(
            ref mut resolver.traits,
            trait_definition,
            subject_type
        );

    resolver_record(
        resolver,
        result.found
    );

    give result;
}

proc resolver_resolve_overload(
    resolver: ref mut Resolver,
    name: string,
    arguments: [OverloadArgument]
) -> OverloadResolution {
    set resolver.statistics.overloads =
        resolver.statistics.overloads + 1;

    if not resolver.config.resolve_overloads {
        let result =
            overload_resolution_invalid(
                name,
                "overload resolution is disabled"
            );

        resolver_record(
            resolver,
            false
        );

        give result;
    }

    if resolver.config.track_state {
        resolver_state_set_phase(
            ref mut resolver.state,
            ResolverStatePhase.Overloads
        );
    }

    let result =
        overload_resolver_resolve(
            ref mut resolver.overloads,
            name,
            arguments
        );

    resolver_record(
        resolver,
        result.found
    );

    give result;
}

proc resolver_check_visibility(
    resolver: ref mut Resolver,
    visibility: CandidateVisibility,
    context: VisibilityContext
) -> VisibilityResolution {
    if not resolver.config.resolve_visibility {
        give visibility_resolution_allowed(
            visibility
        );
    }

    give visibility_resolver_check(
        ref mut resolver.visibility,
        visibility,
        context
    );
}

proc resolver_resolve_scope(
    resolver: ref mut Resolver,
    scope: ScopeId
) -> ScopeResolution {
    give scope_resolver_resolve(
        ref mut resolver.scopes,
        scope
    );
}

proc resolver_invalidate(
    resolver: ref mut Resolver
) {
    set resolver.generation =
        resolver.generation + 1;

    lookup_cache_advance_generation(
        ref mut resolver.lookup.cache
    );

    set resolver.status =
        ResolverStatus.Ready;
}

proc resolver_clear_cache(
    resolver: ref mut Resolver
) {
    lookup_cache_clear(
        ref mut resolver.lookup.cache
    );
}

proc resolver_reset_statistics(
    resolver: ref mut Resolver
) {
    set resolver.statistics =
        resolver_statistics_empty();
}

proc resolver_statistics(
    resolver: ref Resolver
) -> ResolverStatistics {
    give resolver.statistics;
}

proc resolver_is_ready(
    resolver: ref Resolver
) -> bool {
    give resolver.status
        == ResolverStatus.Ready
        or resolver.status
        == ResolverStatus.Complete;
}

proc resolver_is_resolving(
    resolver: ref Resolver
) -> bool {
    give resolver.status
        == ResolverStatus.Resolving;
}

proc resolver_has_failed(
    resolver: ref Resolver
) -> bool {
    give resolver.status
        == ResolverStatus.Failed;
}

proc resolver_status_name(
    status: ResolverStatus
) -> string {
    pick status {
        ResolverStatus.Created {
            give "created";
        }

        ResolverStatus.Ready {
            give "ready";
        }

        ResolverStatus.Resolving {
            give "resolving";
        }

        ResolverStatus.Complete {
            give "complete";
        }

        ResolverStatus.Failed {
            give "failed";
        }
    }

    give "failed";
}
