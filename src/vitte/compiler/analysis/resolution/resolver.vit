    set resolver.statistics.constants =
        resolver.statistics.constants + 1;

    let result =
        constant_resolver_resolve(
            ref mut resolver.constants,
            name,
            allow_private,
            allow_package
        );

    resolver_record(
        resolver,
        result.found
