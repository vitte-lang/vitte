    set resolver.statistics.fields =
        resolver.statistics.fields + 1;

    if resolver.config.track_state {
        resolver_state_set_phase(
            ref mut resolver.state,
            ResolverStatePhase.Members
        );
    }

    let result =
        field_resolver_resolve(
            ref mut resolver.fields,
            owner,
            name,
            allow_private,
            allow_package
        );

    resolver_record(
        resolver,
        result.found
