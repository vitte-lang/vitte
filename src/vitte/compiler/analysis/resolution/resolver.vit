    give result;
}

proc resolver_resolve_method(
    resolver: ref mut Resolver,
    receiver: TypeId,
    name: string,
    mutable: bool,
    owned: bool
) -> ResolvedMethod {
    set resolver.statistics.methods =
        resolver.statistics.methods + 1;

    if resolver.config.track_state {
        resolver_state_set_phase(
            ref mut resolver.state,
            ResolverStatePhase.Members
        );
    }

    let result =
        method_resolver_resolve_exact(
            ref mut resolver.methods,
            receiver,
            name,
            mutable,
            owned
        );

    resolver_record(
        resolver,
        result.found
    );

    give result;
