use vitte/compiler/analysis/resolution/overload_resolution.{
    OverloadResolver,
    OverloadArgument,
    OverloadResolution,

    overload_resolver_create,
    overload_resolver_resolve
}

pick ResolverStatus {
    Created,
    Ready,
    Resolving,
    Complete,
    Failed
}

form ResolverConfig {
    enable_cache: bool

    track_state: bool

    resolve_visibility: bool
    resolve_traits: bool
    resolve_overloads: bool

    fail_fast: bool
}

form ResolverStatistics {
    resolutions: u64

    names: u64
    modules: u64
    namespaces: u64
    paths: u64
    symbols: u64

    constants: u64
    fields: u64
    methods: u64
    traits: u64
    overloads: u64

    resolved: u64
    failed: u64
}

form Resolver {
    config: ResolverConfig

    status: ResolverStatus

    context: ResolutionContext
    state: ResolverState

    lookup: Lookup

    scopes: ScopeResolver
    names: NameResolver
    symbols: SymbolResolver

    modules: ModuleResolver
    namespaces: NamespaceResolver
    paths: PathResolver

    visibility: VisibilityResolver

    constants: ConstantResolver
    fields: FieldResolver
    methods: MethodResolver
    generics: GenericResolver
    traits: TraitResolver
    overloads: OverloadResolver

    generation: u64

    statistics: ResolverStatistics
}

proc resolver_config_default()
    -> ResolverConfig
{
    give ResolverConfig {
        enable_cache: true,

        track_state: true,

        resolve_visibility: true,
        resolve_traits: true,
        resolve_overloads: true,

        fail_fast: false
    };
}

proc resolver_statistics_empty()
    -> ResolverStatistics
{
    give ResolverStatistics {
        resolutions: 0,

        names: 0,
        modules: 0,
        namespaces: 0,
        paths: 0,
        symbols: 0,

        constants: 0,
        fields: 0,
        methods: 0,
        traits: 0,
        overloads: 0,

        resolved: 0,
        failed: 0
    };
}

proc resolver_create_with_config(
    config: ResolverConfig
) -> Resolver {
    let cache =
        lookup_cache_create();

    give Resolver {
        config: config,

        status:
            ResolverStatus.Ready,

        context:
            resolution_context_create(),

        state:
            resolver_state_create(),

        lookup:
            lookup_create(cache),

        scopes:
            scope_resolver_create(),

        names:
            name_resolver_create(),

        symbols:
            symbol_resolver_create(),

        modules:
            module_resolver_create(),

        namespaces:
            namespace_resolver_create(),

        paths:
            path_resolver_create(),

        visibility:
            visibility_resolver_create(),

        constants:
            constant_resolver_create(),

        fields:
            field_resolver_create(),

        methods:
            method_resolver_create(),

        generics:
            generic_resolver_create(),

        traits:
            trait_resolver_create(),

        overloads:
            overload_resolver_create(),

        generation:
            1,

        statistics:
            resolver_statistics_empty()
    };
}

proc resolver_create()
    -> Resolver
{
    give resolver_create_with_config(
        resolver_config_default()
    );
}

proc resolver_begin(
    resolver: ref mut Resolver,
    module: ModuleId,
    scope: ScopeId
) -> bool {
    if not module_id_is_valid(module) {
        set resolver.status =
            ResolverStatus.Failed;

        set resolver.statistics.failed =
            resolver.statistics.failed + 1;

        give false;
    }

    if not resolution_context_set_module(
        ref mut resolver.context,
        module
    ) {
        set resolver.status =
            ResolverStatus.Failed;

        give false;
    }

    resolution_context_set_scope(
        ref mut resolver.context,
        scope
    );

    if resolver.config.track_state {
        if not resolver_state_begin(
            ref mut resolver.state,
            module,
            scope
        ) {
            set resolver.status =
                ResolverStatus.Failed;

            give false;
        }
    }

    set resolver.status =
        ResolverStatus.Resolving;

    give true;
}

proc resolver_finish(
    resolver: ref mut Resolver
) -> bool {
    if resolver.config.track_state {
        if not resolver_state_finish(
            ref mut resolver.state
        ) {
            set resolver.status =
                ResolverStatus.Failed;

            give false;
        }
    }

    set resolver.status =
        ResolverStatus.Complete;

    give true;
}

proc resolver_record(
    resolver: ref mut Resolver,
    success: bool
) {
    set resolver.statistics.resolutions =
        resolver.statistics.resolutions + 1;

    if success {
        set resolver.statistics.resolved =
            resolver.statistics.resolved + 1;
    } else {
        set resolver.statistics.failed =
            resolver.statistics.failed + 1;

        resolution_context_record_failure(
            ref mut resolver.context
        );
    }
}

proc resolver_register_scope(
    resolver: ref mut Resolver,
    scope: ScopeDefinition
) -> bool {
    let error =
        scope_resolver_register(
            ref mut resolver.scopes,
            scope
        );

    give error.kind
        == ScopeResolutionErrorKind.None;
}

proc resolver_register_lookup_scope(
    resolver: ref mut Resolver,
    scope: LookupScope
) {
    lookup_register_scope(
        ref mut resolver.lookup,
        scope
    );
}

proc resolver_register_lookup_symbol(
    resolver: ref mut Resolver,
    symbol: LookupSymbol
) -> bool {
    give lookup_register_symbol(
        ref mut resolver.lookup,
        symbol
    );
}

proc resolver_resolve_name(
    resolver: ref mut Resolver,
    scope: ScopeId,
    name: string,
    kind: NameResolutionKind
) -> NameResolution {
    set resolver.statistics.names =
        resolver.statistics.names + 1;

    resolution_context_record_lookup(
        ref mut resolver.context
    );

    if resolver.config.track_state {
        resolver_state_set_phase(
            ref mut resolver.state,
            ResolverStatePhase.Names
        );

        if not resolver_state_begin_resolution(
            ref mut resolver.state,
            ResolverStackFrameKind.Name,
            ResolverGraphNodeKind.Name,
            name,
            Some(scope),
            None,
            None
        ) {
            let result =
                name_resolution_invalid(
                    scope,
                    name,
                    kind,
                    NameResolutionErrorKind.InvalidScope,
                    "could not begin name resolution"
                );

            resolver_record(
                resolver,
                false
            );

            give result;
        }
    }

    let result =
        name_resolver_resolve(
            ref mut resolver.names,
            ref mut resolver.lookup,
            scope,
            name,
            kind
        );

    if resolver.config.track_state {
        resolver_state_complete_resolution(
            ref mut resolver.state,
            result.found
        );
    }

    resolver_record(
        resolver,
        result.found
    );

    give result;
}

proc resolver_resolve_symbol(
    resolver: ref mut Resolver,
    scope: ScopeId,
    name: string,
    kind: SymbolResolutionKind
) -> ResolvedSymbol {
    set resolver.statistics.symbols =
        resolver.statistics.symbols + 1;

    let result =
        symbol_resolver_resolve(
            ref mut resolver.symbols,
            ref mut resolver.names,
            ref mut resolver.lookup,
            scope,
            name,
            kind
        );

    resolver_record(
        resolver,
        result.found
    );

    give result;
}

