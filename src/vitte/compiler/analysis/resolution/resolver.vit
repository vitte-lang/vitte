}

proc resolver_resolve_namespace(
    resolver: ref mut Resolver,
    name: string
) -> ResolvedNamespace {
    set resolver.statistics.namespaces =
        resolver.statistics.namespaces + 1;

    let result =
        namespace_resolver_resolve_name(
