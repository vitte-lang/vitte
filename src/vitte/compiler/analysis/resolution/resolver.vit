    set resolver.statistics.modules =
        resolver.statistics.modules + 1;

    let result =
        module_resolver_resolve_name(
            ref mut resolver.modules,
            database,
            name
        );

    resolver_record(
        resolver,
        result.found
    );

    give result;
}

