    );

    give result;
}

proc resolver_resolve_namespace_qualified(
    resolver: ref mut Resolver,
    name: string
) -> ResolvedNamespace {
    set resolver.statistics.namespaces =
        resolver.statistics.namespaces + 1;

    let result =
        namespace_resolver_resolve_qualified(
            ref mut resolver.namespaces,
            name
        );

    resolver_record(
        resolver,
        result.found
