space vitte/compiler/analysis/resolution/path_resolution

export *

use vitte/compiler/analysis/modules/module_path.{
    ModulePath,
    ModulePathKind,
    ModulePathValidation,
    ModulePathSegment,

    module_path,
    module_path_invalid,
    module_path_validate,
    module_path_normalize,
    module_path_is_valid,
    module_path_is_relative,
    module_path_is_absolute,
    module_path_is_package,
    module_path_is_module,
    module_path_depth,
    module_path_name,
    module_path_parent,
    module_path_parent_text,
    module_path_join,
    module_path_segment_at,
    module_path_root_name
}

use vitte/compiler/analysis/modules/module_database.{
    ModuleId,
    ModuleDatabase,

    module_id_invalid,
    module_id_is_valid,

    module_database_get,
    module_database_get_by_name,
    module_database_get_by_path
}

use vitte/compiler/analysis/modules/module_namespace.{
    ModuleNamespace,

    module_namespace_root,
    module_namespace_invalid,
    module_namespace_is_valid,
    module_namespace_qualified_name
}

use vitte/compiler/analysis/resolution/module_resolution.{
    ModuleResolver,
    ResolvedModule,
    ModuleResolutionState,

    module_resolver_resolve_name,
    module_resolver_resolve_path,
    module_resolver_resolve_relative
}

use vitte/compiler/analysis/resolution/namespace_resolution.{
    NamespaceResolver,
    ResolvedNamespace,
    NamespaceResolutionState,

    namespace_resolver_resolve_name,
    namespace_resolver_resolve_qualified,
    namespace_resolver_resolve_child
}

use vitte/compiler/analysis/resolution/name_resolution.{
    NameResolver,
    NameResolution,
    NameResolutionKind,
    NameResolutionState,

    name_resolver_resolve
}

use vitte/compiler/analysis/resolution/lookup.{
    Lookup
}

pick PathResolutionTargetKind {
    Module,
    Namespace,
    Symbol,
    Unknown
}

pick PathResolutionState {
    Unresolved,
    Resolving,
    Resolved,
    Missing,
    Ambiguous,
    Invalid,
    Failed
}

pick PathResolutionErrorKind {
    None,

    EmptyPath,
    InvalidPath,
    InvalidBase,

    MissingRoot,
    MissingSegment,

    ModuleNotFound,
    NamespaceNotFound,
    SymbolNotFound,

    AmbiguousSegment,
    UnsupportedTarget,

    RelativeWithoutBase,
    TooDeep
}

form PathResolutionError {
    kind: PathResolutionErrorKind

    path: string
    segment: string
    index: usize

    message: string
}

form PathResolutionSegment {
    value: string
    index: usize

    module: Option<ModuleId>
    namespace: Option<ModuleNamespace>
    definition: Option<DefId>

    resolved: bool
}

form PathResolution {
    path: ModulePath

    target_kind: PathResolutionTargetKind
    state: PathResolutionState

    module: Option<ModuleId>
    namespace: Option<ModuleNamespace>
    definition: Option<DefId>

    segments: [PathResolutionSegment]

    error: PathResolutionError

    found: bool
}

form PathResolverConfig {
    allow_relative: bool
    allow_absolute: bool

    allow_module_target: bool
    allow_namespace_target: bool
    allow_symbol_target: bool

    max_depth: usize
}

form PathResolverStatistics {
    resolutions: u64

    resolved: u64
    missing: u64
    ambiguous: u64
    invalid: u64

    segments: u64

    module_targets: u64
    namespace_targets: u64
    symbol_targets: u64
}

form PathResolver {
    config: PathResolverConfig
    statistics: PathResolverStatistics
}

proc path_resolver_config_default()
    -> PathResolverConfig
{
    give PathResolverConfig {
        allow_relative: true,
        allow_absolute: true,

        allow_module_target: true,
        allow_namespace_target: true,
        allow_symbol_target: true,

        max_depth: 128
    };
}

proc path_resolver_statistics_empty()
    -> PathResolverStatistics
{
    give PathResolverStatistics {
        resolutions: 0,

        resolved: 0,
        missing: 0,
        ambiguous: 0,
        invalid: 0,

        segments: 0,

        module_targets: 0,
        namespace_targets: 0,
        symbol_targets: 0
    };
}

proc path_resolver_create_with_config(
    config: PathResolverConfig
) -> PathResolver {
    give PathResolver {
        config: config,

        statistics:
            path_resolver_statistics_empty()
    };
}

proc path_resolver_create()
    -> PathResolver
{
    give path_resolver_create_with_config(
        path_resolver_config_default()
    );
}

proc path_resolution_error_none()
    -> PathResolutionError
{
    give PathResolutionError {
        kind: PathResolutionErrorKind.None,

        path: "",
        segment: "",
        index: 0,

        message: ""
    };
}

proc path_resolution_error(
    kind: PathResolutionErrorKind,
    path: string,
    segment: string,
    index: usize,
    message: string
) -> PathResolutionError {
    give PathResolutionError {
        kind: kind,

        path: path,
        segment: segment,
        index: index,

        message: message
    };
}

proc path_resolution_segment(
    value: string,
    index: usize
) -> PathResolutionSegment {
    give PathResolutionSegment {
        value: value,
        index: index,

        module: None,
        namespace: None,
        definition: None,

        resolved: false
    };
}

proc path_resolution_empty(
    path: ModulePath
) -> PathResolution {
    give PathResolution {
        path: path,

        target_kind:
            PathResolutionTargetKind.Unknown,

        state:
            PathResolutionState.Unresolved,

        module: None,
        namespace: None,
        definition: None,

        segments: [],

        error:
            path_resolution_error_none(),

        found: false
    };
}

proc path_resolution_invalid(
    path: ModulePath,
    kind: PathResolutionErrorKind,
    segment: string,
    index: usize,
    message: string
) -> PathResolution {
    let mut result =
        path_resolution_empty(path);

    set result.state =
        PathResolutionState.Invalid;

    set result.error =
        path_resolution_error(
            kind,
            path.value,
            segment,
            index,
            message
        );

    give result;
}

proc path_resolution_missing(
    path: ModulePath,
    kind: PathResolutionErrorKind,
    segment: string,
    index: usize,
    message: string
) -> PathResolution {
    let mut result =
        path_resolution_empty(path);

    set result.state =
        PathResolutionState.Missing;

    set result.error =
        path_resolution_error(
            kind,
            path.value,
            segment,
            index,
            message
        );

    give result;
}

proc path_resolution_module(
    path: ModulePath,
    module: ModuleId,
    segments: [PathResolutionSegment]
) -> PathResolution {
    give PathResolution {
        path: path,

        target_kind:
            PathResolutionTargetKind.Module,

        state:
            PathResolutionState.Resolved,

        module:
            Some(module),

        namespace:
            None,

        definition:
            None,

        segments:
            segments,

        error:
            path_resolution_error_none(),

        found:
            true
    };
}

proc path_resolution_namespace(
    path: ModulePath,
    namespace: ModuleNamespace,
    segments: [PathResolutionSegment]
) -> PathResolution {
    give PathResolution {
        path: path,

        target_kind:
            PathResolutionTargetKind.Namespace,

        state:
            PathResolutionState.Resolved,

        module:
            None,

        namespace:
            Some(namespace),

        definition:
            None,

        segments:
            segments,

        error:
            path_resolution_error_none(),

        found:
            true
    };
}

proc path_resolution_symbol(
    path: ModulePath,
    definition: DefId,
    segments: [PathResolutionSegment]
) -> PathResolution {
    give PathResolution {
        path: path,

        target_kind:
            PathResolutionTargetKind.Symbol,

        state:
            PathResolutionState.Resolved,

        module:
            None,

        namespace:
            None,

        definition:
            Some(definition),

        segments:
            segments,

        error:
            path_resolution_error_none(),

        found:
            true
    };
}

proc path_resolver_validate(
    resolver: ref PathResolver,
    path: ModulePath
) -> Option<PathResolution> {
    if path.value == "" {
        give Some(
            path_resolution_invalid(
                path,
                PathResolutionErrorKind.EmptyPath,
                "",
                0,
                "path is empty"
            )
        );
    }

    let validation:
        ModulePathValidation =
        module_path_validate(path);

    if not validation.valid {
        give Some(
            path_resolution_invalid(
                path,
                PathResolutionErrorKind.InvalidPath,
                "",
                0,
                validation.message
            )
        );
    }

    if path.depth > resolver.config.max_depth {
        give Some(
            path_resolution_invalid(
                path,
                PathResolutionErrorKind.TooDeep,
                "",
                path.depth,
                "path exceeds resolver depth limit"
            )
        );
    }

    if module_path_is_relative(path)
        and not resolver.config.allow_relative
    {
        give Some(
            path_resolution_invalid(
                path,
                PathResolutionErrorKind.InvalidPath,
                "",
                0,
                "relative paths are disabled"
            )
        );
    }

    if module_path_is_absolute(path)
        and not resolver.config.allow_absolute
    {
        give Some(
            path_resolution_invalid(
                path,
                PathResolutionErrorKind.InvalidPath,
                "",
                0,
                "absolute paths are disabled"
            )
        );
    }

    give None;
}

proc path_resolver_segments(
    path: ModulePath
) -> [PathResolutionSegment] {
    let mut output:
        [PathResolutionSegment] = [];

    let mut index: usize = 0;

    while index < path.depth {
        let segment =
            module_path_segment_at(
                path,
                index
            );

        set output =
            output + [
                path_resolution_segment(
                    segment.value,
                    index
                )
            ];

        set index = index + 1;
    }

    give output;
}

proc path_resolver_resolve_module(
    resolver: ref mut PathResolver,
    module_resolver: ref mut ModuleResolver,
    database: ref ModuleDatabase,
    path: ModulePath
) -> PathResolution {
    if not resolver.config.allow_module_target {
        give path_resolution_invalid(
            path,
            PathResolutionErrorKind.UnsupportedTarget,
            "",
            0,
            "module path targets are disabled"
        );
    }

    let resolved =
        module_resolver_resolve_path(
            module_resolver,
            database,
            path.value
        );

    if resolved.state
        != ModuleResolutionState.Resolved
    {
        give path_resolution_missing(
            path,
            PathResolutionErrorKind.ModuleNotFound,
            module_path_name(path),
            path.depth - 1,
            "module path could not be resolved"
        );
    }

    let mut segments =
        path_resolver_segments(path);

    if len(segments) > 0 {
        set segments[
            len(segments) - 1
        ].module =
            Some(resolved.id);

        set segments[
            len(segments) - 1
        ].resolved =
            true;
    }

    give path_resolution_module(
        path,
        resolved.id,
        segments
    );
}

proc path_resolver_resolve_relative_module(
    resolver: ref mut PathResolver,
    module_resolver: ref mut ModuleResolver,
    database: ref ModuleDatabase,
    base: ModuleId,
    path: ModulePath
) -> PathResolution {
    if not resolver.config.allow_relative {
        give path_resolution_invalid(
            path,
            PathResolutionErrorKind.RelativeWithoutBase,
            "",
            0,
            "relative path resolution is disabled"
        );
    }

    if not module_id_is_valid(base) {
        give path_resolution_invalid(
            path,
            PathResolutionErrorKind.InvalidBase,
            "",
            0,
            "relative path requires a valid base module"
        );
    }

    let resolved =
        module_resolver_resolve_relative(
            module_resolver,
            database,
            base,
            path.value
        );

    if resolved.state
        != ModuleResolutionState.Resolved
    {
        give path_resolution_missing(
            path,
            PathResolutionErrorKind.ModuleNotFound,
            module_path_name(path),
            path.depth - 1,
            "relative module path could not be resolved"
        );
    }

    let mut segments =
        path_resolver_segments(path);

    if len(segments) > 0 {
        set segments[
            len(segments) - 1
        ].module =
            Some(resolved.id);

        set segments[
            len(segments) - 1
        ].resolved =
            true;
    }

    give path_resolution_module(
        path,
        resolved.id,
        segments
    );
}

proc path_resolver_resolve_namespace(
    resolver: ref mut PathResolver,
    namespace_resolver: ref mut NamespaceResolver,
    path: ModulePath
) -> PathResolution {
    if not resolver.config.allow_namespace_target {
        give path_resolution_invalid(
            path,
            PathResolutionErrorKind.UnsupportedTarget,
            "",
            0,
            "namespace path targets are disabled"
        );
    }

    let resolved =
        namespace_resolver_resolve_qualified(
            namespace_resolver,
            path.value
        );

    if resolved.state
        != NamespaceResolutionState.Resolved
    {
        give path_resolution_missing(
            path,
            PathResolutionErrorKind.NamespaceNotFound,
            module_path_name(path),
            path.depth - 1,
            "namespace path could not be resolved"
        );
    }

    pick resolved.namespace {
        None {
            give path_resolution_invalid(
                path,
                PathResolutionErrorKind.NamespaceNotFound,
                module_path_name(path),
                path.depth - 1,
                "resolved namespace has no namespace value"
            );
        }

        Some(namespace) {
            let mut segments =
                path_resolver_segments(path);

            if len(segments) > 0 {
                set segments[
                    len(segments) - 1
                ].namespace =
                    Some(namespace);

                set segments[
                    len(segments) - 1
                ].resolved =
                    true;
            }

            give path_resolution_namespace(
                path,
                namespace,
                segments
            );
        }
    }
}

proc path_resolver_resolve_symbol(
    resolver: ref mut PathResolver,
    name_resolver: ref mut NameResolver,
    lookup: ref mut Lookup,
    scope: ScopeId,
    path: ModulePath,
    kind: NameResolutionKind
) -> PathResolution {
    if not resolver.config.allow_symbol_target {
        give path_resolution_invalid(
            path,
            PathResolutionErrorKind.UnsupportedTarget,
            "",
            0,
            "symbol path targets are disabled"
        );
    }

    let name =
        module_path_name(path);

    if name == "" {
        give path_resolution_invalid(
            path,
            PathResolutionErrorKind.MissingSegment,
            "",
            path.depth,
            "symbol path has no terminal segment"
        );
    }

    let resolved =
        name_resolver_resolve(
            name_resolver,
            lookup,
            scope,
            name,
            kind
        );

    if resolved.state
        != NameResolutionState.Resolved
    {
        give path_resolution_missing(
            path,
            PathResolutionErrorKind.SymbolNotFound,
            name,
            path.depth - 1,
            "terminal path symbol could not be resolved"
        );
    }

    pick resolved.definition {
        None {
            give path_resolution_invalid(
                path,
                PathResolutionErrorKind.SymbolNotFound,
                name,
                path.depth - 1,
                "resolved symbol has no definition id"
            );
        }

        Some(definition) {
            let mut segments =
                path_resolver_segments(path);

            if len(segments) > 0 {
                set segments[
                    len(segments) - 1
                ].definition =
                    Some(definition);

                set segments[
                    len(segments) - 1
                ].resolved =
                    true;
            }

            give path_resolution_symbol(
                path,
                definition,
                segments
            );
        }
    }
}

proc path_resolver_resolve_auto(
    resolver: ref mut PathResolver,
    module_resolver: ref mut ModuleResolver,
    namespace_resolver: ref mut NamespaceResolver,
    name_resolver: ref mut NameResolver,
    lookup: ref mut Lookup,
    database: ref ModuleDatabase,
    scope: ScopeId,
    path_text: string
) -> PathResolution {
    let raw =
        module_path(path_text);

    let path =
        module_path_normalize(raw);

    let invalid =
        path_resolver_validate(
            ref resolver,
            path
        );

    pick invalid {
        Some(result) {
            give result;
        }

        None {}
    }

    if module_path_is_relative(path) {
        give path_resolution_invalid(
            path,
            PathResolutionErrorKind.RelativeWithoutBase,
            "",
            0,
            "automatic relative resolution requires a base module"
        );
    }

    let module_result =
        path_resolver_resolve_module(
            resolver,
            module_resolver,
            database,
            path
        );

    if module_result.found {
        give module_result;
    }

    let namespace_result =
        path_resolver_resolve_namespace(
            resolver,
            namespace_resolver,
            path
        );

    if namespace_result.found {
        give namespace_result;
    }

    give path_resolver_resolve_symbol(
        resolver,
        name_resolver,
        lookup,
        scope,
        path,
        NameResolutionKind.Any
    );
}

proc path_resolver_record(
    resolver: ref mut PathResolver,
    result: PathResolution
) {
    set resolver.statistics.resolutions =
        resolver.statistics.resolutions + 1;

    set resolver.statistics.segments =
        resolver.statistics.segments
        + len(result.segments);

    pick result.state {
        PathResolutionState.Resolved {
            set resolver.statistics.resolved =
                resolver.statistics.resolved + 1;
        }

        PathResolutionState.Missing {
            set resolver.statistics.missing =
                resolver.statistics.missing + 1;
        }

        PathResolutionState.Ambiguous {
            set resolver.statistics.ambiguous =
                resolver.statistics.ambiguous + 1;
        }

        PathResolutionState.Invalid {
            set resolver.statistics.invalid =
                resolver.statistics.invalid + 1;
        }

        _ {}
    }

    pick result.target_kind {
        PathResolutionTargetKind.Module {
            set resolver.statistics.module_targets =
                resolver.statistics.module_targets + 1;
        }

        PathResolutionTargetKind.Namespace {
            set resolver.statistics.namespace_targets =
                resolver.statistics.namespace_targets + 1;
        }

        PathResolutionTargetKind.Symbol {
            set resolver.statistics.symbol_targets =
                resolver.statistics.symbol_targets + 1;
        }

        PathResolutionTargetKind.Unknown {}
    }
}

proc path_resolution_is_resolved(
    result: PathResolution
) -> bool {
    give result.state
        == PathResolutionState.Resolved
        and result.found;
}

proc path_resolution_is_module(
    result: PathResolution
) -> bool {
    give path_resolution_is_resolved(result)
        and result.target_kind
        == PathResolutionTargetKind.Module;
}

proc path_resolution_is_namespace(
    result: PathResolution
) -> bool {
    give path_resolution_is_resolved(result)
        and result.target_kind
        == PathResolutionTargetKind.Namespace;
}

proc path_resolution_is_symbol(
    result: PathResolution
) -> bool {
    give path_resolution_is_resolved(result)
        and result.target_kind
        == PathResolutionTargetKind.Symbol;
}

proc path_resolution_has_error(
    result: PathResolution
) -> bool {
    give result.error.kind
        != PathResolutionErrorKind.None;
}

proc path_resolver_statistics(
    resolver: ref PathResolver
) -> PathResolverStatistics {
    give resolver.statistics;
}

proc path_resolver_reset_statistics(
    resolver: ref mut PathResolver
) {
    set resolver.statistics =
        path_resolver_statistics_empty();
}

proc path_resolution_target_kind_name(
    kind: PathResolutionTargetKind
) -> string {
    pick kind {
        PathResolutionTargetKind.Module {
            give "module";
        }

        PathResolutionTargetKind.Namespace {
            give "namespace";
        }

        PathResolutionTargetKind.Symbol {
            give "symbol";
        }

        PathResolutionTargetKind.Unknown {
            give "unknown";
        }
    }

    give "unknown";
}

proc path_resolution_state_name(
    state: PathResolutionState
) -> string {
    pick state {
        PathResolutionState.Unresolved {
            give "unresolved";
        }

        PathResolutionState.Resolving {
            give "resolving";
        }

        PathResolutionState.Resolved {
            give "resolved";
        }

        PathResolutionState.Missing {
            give "missing";
        }

        PathResolutionState.Ambiguous {
            give "ambiguous";
        }

        PathResolutionState.Invalid {
            give "invalid";
        }

        PathResolutionState.Failed {
            give "failed";
        }
    }

    give "invalid";
}
