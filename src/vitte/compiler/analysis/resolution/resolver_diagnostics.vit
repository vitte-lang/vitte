space vitte/compiler/analysis/resolution/resolver_diagnostics

export *

use vitte/compiler/infrastructure/diagnostics/diagnostic.{
    InfrastructureDiagnostic,
    DiagnosticSeverity,
    DiagnosticPhase,
    DiagnosticLabelKind,
    DiagnosticSuggestionKind,
    SourceSpan,

    span_empty,
    diagnostic_create,
    diagnostic_label,
    diagnostic_note,
    diagnostic_help,
    diagnostic_suggestion
}

use vitte/compiler/analysis/resolution/resolution_result.{
    ResolutionResult,
    ResolutionResultKind,
    ResolutionResultState,
    ResolutionFailure,
    ResolutionFailureKind
}

pick ResolverDiagnosticKind {
    NameNotFound,
    ModuleNotFound,
    NamespaceNotFound,
    PathNotFound,

    ImportNotFound,
    ExportNotFound,

    ConstantNotFound,
    FieldNotFound,
    MethodNotFound,
    GenericNotFound,

    AmbiguousName,
    AmbiguousModule,
    AmbiguousNamespace,
    AmbiguousPath,
    AmbiguousMethod,
    AmbiguousOverload,

    PrivateSymbol,
    PackageSymbol,

    InvalidPath,
    InvalidScope,
    InvalidModule,

    ArityMismatch,
    TypeMismatch,
    ConstraintFailure,

    Internal
}

form ResolverDiagnosticContext {
    subject: string

    span: SourceSpan

    module_name: string
    namespace_name: string

    expected: string
    found: string

    candidates: [string]
}

form ResolverDiagnosticReport {
    diagnostics: [InfrastructureDiagnostic]

    errors: usize
    warnings: usize

    valid: bool
}

proc resolver_diagnostic_context(
    subject: string,
    span: SourceSpan
) -> ResolverDiagnosticContext {
    give ResolverDiagnosticContext {
        subject: subject,

        span: span,

        module_name: "",
        namespace_name: "",

        expected: "",
        found: "",

        candidates: []
    };
}

proc resolver_diagnostic_report_create()
    -> ResolverDiagnosticReport
{
    give ResolverDiagnosticReport {
        diagnostics: [],

        errors: 0,
        warnings: 0,

        valid: true
    };
}

