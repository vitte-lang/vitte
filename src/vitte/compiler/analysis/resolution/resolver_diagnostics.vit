            give "RESOLVE_E005";
        }

        ResolverDiagnosticKind.ExportNotFound {
            give "RESOLVE_E006";
        }

        ResolverDiagnosticKind.ConstantNotFound {
            give "RESOLVE_E007";
        }

        ResolverDiagnosticKind.FieldNotFound {
            give "RESOLVE_E008";
        }

        ResolverDiagnosticKind.MethodNotFound {
            give "RESOLVE_E009";
        }

        ResolverDiagnosticKind.GenericNotFound {
            give "RESOLVE_E010";
        }

        ResolverDiagnosticKind.AmbiguousName {
            give "RESOLVE_E020";
        }

        ResolverDiagnosticKind.AmbiguousModule {
            give "RESOLVE_E021";
        }

        ResolverDiagnosticKind.AmbiguousNamespace {
            give "RESOLVE_E022";
        }

        ResolverDiagnosticKind.AmbiguousPath {
            give "RESOLVE_E023";
        }

        ResolverDiagnosticKind.AmbiguousMethod {
            give "RESOLVE_E024";
        }

        ResolverDiagnosticKind.AmbiguousOverload {
            give "RESOLVE_E025";
        }

        ResolverDiagnosticKind.PrivateSymbol {
            give "RESOLVE_E030";
        }

        ResolverDiagnosticKind.PackageSymbol {
