space vitte/compiler/analysis/static/constant_analysis

export *

pick ScopeBindingKind {
    Local,
    Parameter,
    Constant,
    Static,
    Global,
    Procedure,
    Type,
    Field,
    Method,
    Module,
    Import,
    Generic,
    Trait,
    Namespace,
    Builtin,
    Generated
}

pick ScopeBindingState {
    Declared,
    Defined,
    Imported,
    Shadowed,
    Invalidated
}

pick ScopeBindingVisibility {
    Public,
    Package,
    Module,
    Private
}

pick ScopeBindingErrorKind {
    None,
    EmptyName,
    InvalidScope,
    InvalidDefinition,
    DuplicateBinding,
    BindingNotFound,
    InvalidState
}

form ScopeBindingError {
    kind: ScopeBindingErrorKind

    name: string
    scope: ScopeId

    message: string
}

form ScopeBinding {
    name: string

    symbol: Option<SymbolId>
    definition: Option<DefId>
    type_id: Option<TypeId>

    scope: ScopeId

    kind: ScopeBindingKind
    state: ScopeBindingState
    visibility: ScopeBindingVisibility

    depth: usize
    priority: usize

    mutable: bool
    synthetic: bool

    generation: u64
    revision: u64
}

form ScopeBindingSet {
    bindings: [ScopeBinding]
}

form ScopeBindingStatistics {
    insertions: u64
    lookups: u64

    hits: u64
    misses: u64

    duplicates: u64
    shadowed: u64
    invalidated: u64
}

form ScopeBindingTable {
    scopes: [ScopeId]

    bindings: [ScopeBinding]

    generation: u64

    statistics: ScopeBindingStatistics
}

proc scope_binding_error_none()
    -> ScopeBindingError
{
    give ScopeBindingError {
        kind:
            ScopeBindingErrorKind.None,

        name:
            "",

        scope:
            0 as ScopeId,

        message:
            ""
    };
}

proc scope_binding_error(
    kind: ScopeBindingErrorKind,
    name: string,
    scope: ScopeId,
    message: string
) -> ScopeBindingError {
    give ScopeBindingError {
        kind: kind,

        name: name,
        scope: scope,

        message: message
    };
}

proc scope_binding_statistics_empty()
    -> ScopeBindingStatistics
{
    give ScopeBindingStatistics {
        insertions: 0,
        lookups: 0,

        hits: 0,
        misses: 0,

        duplicates: 0,
        shadowed: 0,
        invalidated: 0
    };
}

proc scope_binding_table_create()
    -> ScopeBindingTable
{
    give ScopeBindingTable {
        scopes: [],

        bindings: [],

        generation: 1,

        statistics:
            scope_binding_statistics_empty()
    };
}

proc scope_binding(
    name: string,
    scope: ScopeId,
    kind: ScopeBindingKind
) -> ScopeBinding {
    give ScopeBinding {
        name: name,

        symbol: None,
        definition: None,
        type_id: None,

        scope: scope,

        kind: kind,

        state:
            ScopeBindingState.Declared,

        visibility:
            ScopeBindingVisibility.Private,

        depth: 0,
        priority: 0,

        mutable: false,
        synthetic: false,

        generation: 1,
        revision: 1
    };
}

proc scope_binding_with_symbol(
    binding: ScopeBinding,
    symbol: SymbolId
) -> ScopeBinding {
    let mut result =
        binding;

    set result.symbol =
        Some(symbol);

    set result.revision =
        result.revision + 1;

    give result;
}

proc scope_binding_with_definition(
    binding: ScopeBinding,
    definition: DefId
) -> ScopeBinding {
    let mut result =
        binding;

    set result.definition =
        Some(definition);

    set result.revision =
        result.revision + 1;

    give result;
}

proc scope_binding_with_type(
    binding: ScopeBinding,
    type_id: TypeId
) -> ScopeBinding {
    let mut result =
        binding;

    set result.type_id =
        Some(type_id);

    set result.revision =
        result.revision + 1;

    give result;
}

proc scope_binding_with_visibility(
    binding: ScopeBinding,
    visibility: ScopeBindingVisibility
) -> ScopeBinding {
    let mut result =
        binding;

    set result.visibility =
        visibility;

    set result.revision =
        result.revision + 1;

    give result;
}

proc scope_binding_with_depth(
    binding: ScopeBinding,
    depth: usize
) -> ScopeBinding {
    let mut result =
        binding;

    set result.depth =
        depth;

    give result;
}

proc scope_binding_with_priority(
    binding: ScopeBinding,
    priority: usize
) -> ScopeBinding {
    let mut result =
        binding;

    set result.priority =
        priority;

    give result;
}

proc scope_binding_mark_mutable(
    binding: ScopeBinding
) -> ScopeBinding {
    let mut result =
        binding;

    set result.mutable =
        true;

    give result;
}

proc scope_binding_mark_synthetic(
    binding: ScopeBinding
) -> ScopeBinding {
    let mut result =
        binding;

    set result.synthetic =
        true;

    give result;
}

proc scope_binding_mark_defined(
    binding: ScopeBinding
) -> ScopeBinding {
    let mut result =
        binding;

    set result.state =
        ScopeBindingState.Defined;

    set result.revision =
        result.revision + 1;

    give result;
}

proc scope_binding_mark_imported(
    binding: ScopeBinding
) -> ScopeBinding {
    let mut result =
        binding;

    set result.state =
        ScopeBindingState.Imported;

    set result.revision =
        result.revision + 1;

    give result;
}

proc scope_binding_mark_shadowed(
    binding: ScopeBinding
) -> ScopeBinding {
    let mut result =
        binding;

    set result.state =
        ScopeBindingState.Shadowed;

    set result.revision =
        result.revision + 1;

    give result;
}

proc scope_binding_mark_invalidated(
    binding: ScopeBinding
) -> ScopeBinding {
    let mut result =
        binding;

    set result.state =
        ScopeBindingState.Invalidated;

    set result.revision =
        result.revision + 1;

    give result;
}

proc scope_binding_is_active(
    binding: ScopeBinding
) -> bool {
    give binding.state
        != ScopeBindingState.Invalidated
        and binding.state
        != ScopeBindingState.Shadowed;
}

proc scope_binding_has_symbol(
    binding: ScopeBinding
) -> bool {
    pick binding.symbol {
        Some(_) {
            give true;
        }

        None {
            give false;
        }
    }
}

proc scope_binding_has_definition(
    binding: ScopeBinding
) -> bool {
    pick binding.definition {
        Some(_) {
            give true;
        }

        None {
            give false;
        }
    }
}

proc scope_binding_has_type(
    binding: ScopeBinding
) -> bool {
    pick binding.type_id {
        Some(_) {
            give true;
        }

        None {
            give false;
        }
    }
}

proc scope_binding_set_create()
    -> ScopeBindingSet
{
    give ScopeBindingSet {
        bindings: []
    };
}

proc scope_binding_set_push(
    set: ref mut ScopeBindingSet,
    binding: ScopeBinding
) {
    set set.bindings =
        set.bindings + [binding];
}

proc scope_binding_set_count(
    set: ref ScopeBindingSet
) -> usize {
    give len(set.bindings);
}

proc scope_binding_set_is_empty(
    set: ref ScopeBindingSet
) -> bool {
    give len(set.bindings) == 0;
}

proc scope_binding_table_has_scope(
    table: ref ScopeBindingTable,
    scope: ScopeId
) -> bool {
    for current in table.scopes {
        if current == scope {
            give true;
        }
    }

    give false;
}

proc scope_binding_table_register_scope(
    table: ref mut ScopeBindingTable,
    scope: ScopeId
) -> bool {
    if scope_binding_table_has_scope(
        ref table,
        scope
    ) {
        give false;
    }

    set table.scopes =
        table.scopes + [scope];

    give true;
}

proc scope_binding_table_find_exact(
    table: ref ScopeBindingTable,
    scope: ScopeId,
    name: string
) -> Option<ScopeBinding> {
    let mut index: usize =
        len(table.bindings);

    while index > 0 {
        set index =
            index - 1;

        let binding =
            table.bindings[index];

        if binding.scope != scope {
            continue;
        }

        if binding.name != name {
            continue;
        }

        if not scope_binding_is_active(
            binding
        ) {
            continue;
        }

        give Some(binding);
    }

    give None;
}

proc scope_binding_table_contains_exact(
    table: ref ScopeBindingTable,
    scope: ScopeId,
    name: string
) -> bool {
    pick scope_binding_table_find_exact(
        table,
        scope,
        name
    ) {
        Some(_) {
            give true;
        }

        None {
            give false;
        }
    }
}

proc scope_binding_table_insert(
    table: ref mut ScopeBindingTable,
    binding: ScopeBinding
) -> ScopeBindingError {
    if binding.name == "" {
        give scope_binding_error(
            ScopeBindingErrorKind.EmptyName,
            binding.name,
            binding.scope,
            "scope binding name is empty"
        );
    }

    if not scope_binding_table_has_scope(
        ref table,
        binding.scope
    ) {
        give scope_binding_error(
            ScopeBindingErrorKind.InvalidScope,
            binding.name,
            binding.scope,
            "scope binding references an unknown scope"
        );
    }

    if scope_binding_table_contains_exact(
        ref table,
        binding.scope,
        binding.name
    ) {
        set table.statistics.duplicates =
            table.statistics.duplicates + 1;

        give scope_binding_error(
            ScopeBindingErrorKind.DuplicateBinding,
            binding.name,
            binding.scope,
            "binding already exists in this scope"
        );
    }

    let mut value =
        binding;

    set value.generation =
        table.generation;

    set table.bindings =
        table.bindings + [value];

    set table.statistics.insertions =
        table.statistics.insertions + 1;

    give scope_binding_error_none();
}

proc scope_binding_table_insert_or_shadow(
    table: ref mut ScopeBindingTable,
    binding: ScopeBinding
) -> ScopeBindingError {
    let mut index: usize =
        len(table.bindings);

    while index > 0 {
        set index =
            index - 1;

        if table.bindings[index].name
            != binding.name
        {
            continue;
        }

        if table.bindings[index].scope
            == binding.scope
        {
            set table.statistics.duplicates =
                table.statistics.duplicates + 1;

            give scope_binding_error(
                ScopeBindingErrorKind.DuplicateBinding,
                binding.name,
                binding.scope,
                "binding already exists in this scope"
            );
        }

        if scope_binding_is_active(
            table.bindings[index]
        ) {
            set table.statistics.shadowed =
                table.statistics.shadowed + 1;

            break;
        }
    }

    give scope_binding_table_insert(
        table,
        binding
    );
}

proc scope_binding_table_lookup(
    table: ref mut ScopeBindingTable,
    scope: ScopeId,
    name: string
) -> Option<ScopeBinding> {
    set table.statistics.lookups =
        table.statistics.lookups + 1;

    let result =
        scope_binding_table_find_exact(
            ref table,
            scope,
            name
        );

    pick result {
        Some(binding) {
            set table.statistics.hits =
                table.statistics.hits + 1;

            give Some(binding);
        }

        None {
            set table.statistics.misses =
                table.statistics.misses + 1;

            give None;
        }
    }
}

proc scope_binding_table_bindings_in_scope(
    table: ref ScopeBindingTable,
    scope: ScopeId
) -> ScopeBindingSet {
    let mut result =
        scope_binding_set_create();

    for binding in table.bindings {
        if binding.scope == scope
            and scope_binding_is_active(
                binding
            )
        {
            scope_binding_set_push(
                ref mut result,
                binding
            );
        }
    }

    give result;
}

proc scope_binding_table_bindings_named(
    table: ref ScopeBindingTable,
    name: string
) -> ScopeBindingSet {
    let mut result =
        scope_binding_set_create();

    for binding in table.bindings {
        if binding.name == name
            and scope_binding_is_active(
                binding
            )
        {
            scope_binding_set_push(
                ref mut result,
                binding
            );
        }
    }

    give result;
}

proc scope_binding_table_find_symbol(
    table: ref ScopeBindingTable,
    symbol: SymbolId
) -> Option<ScopeBinding> {
    for binding in table.bindings {
        pick binding.symbol {
            Some(current) {
                if current == symbol {
                    give Some(binding);
                }
            }

            None {}
        }
    }

    give None;
}

proc scope_binding_table_find_definition(
    table: ref ScopeBindingTable,
    definition: DefId
) -> Option<ScopeBinding> {
    for binding in table.bindings {
        pick binding.definition {
            Some(current) {
                if current == definition {
                    give Some(binding);
                }
            }

            None {}
        }
    }

    give None;
}

proc scope_binding_table_invalidate_scope(
    table: ref mut ScopeBindingTable,
    scope: ScopeId
) -> usize {
    let mut count: usize = 0;
    let mut index: usize = 0;

    while index < len(table.bindings) {
        if table.bindings[index].scope
            == scope
            and table.bindings[index].state
            != ScopeBindingState.Invalidated
        {
            set table.bindings[index].state =
                ScopeBindingState.Invalidated;

            set table.bindings[index].revision =
                table.bindings[index].revision + 1;

            set count =
                count + 1;
        }

        set index =
            index + 1;
    }

    set table.statistics.invalidated =
        table.statistics.invalidated
        + count;

    give count;
}

proc scope_binding_table_invalidate_definition(
    table: ref mut ScopeBindingTable,
    definition: DefId
) -> usize {
    let mut count: usize = 0;
    let mut index: usize = 0;

    while index < len(table.bindings) {
        pick table.bindings[index].definition {
            Some(current) {
                if current == definition
                    and table.bindings[index].state
                    != ScopeBindingState.Invalidated
                {
                    set table.bindings[index].state =
                        ScopeBindingState.Invalidated;

                    set table.bindings[index].revision =
                        table.bindings[index].revision + 1;

                    set count =
                        count + 1;
                }
            }

            None {}
        }

        set index =
            index + 1;
    }

    set table.statistics.invalidated =
        table.statistics.invalidated
        + count;

    give count;
}

proc scope_binding_table_advance_generation(
    table: ref mut ScopeBindingTable
) -> u64 {
    set table.generation =
        table.generation + 1;

    give table.generation;
}

proc scope_binding_table_clear(
    table: ref mut ScopeBindingTable
) {
    set table.scopes = [];
    set table.bindings = [];

    set table.generation =
        table.generation + 1;
}

proc scope_binding_table_statistics(
    table: ref ScopeBindingTable
) -> ScopeBindingStatistics {
    give table.statistics;
}

proc scope_binding_table_reset_statistics(
    table: ref mut ScopeBindingTable
) {
    set table.statistics =
        scope_binding_statistics_empty();
}

proc scope_binding_kind_name(
    kind: ScopeBindingKind
) -> string {
    pick kind {
        ScopeBindingKind.Local {
            give "local";
        }

        ScopeBindingKind.Parameter {
            give "parameter";
        }

        ScopeBindingKind.Constant {
            give "constant";
        }

        ScopeBindingKind.Static {
            give "static";
        }

        ScopeBindingKind.Global {
            give "global";
        }

        ScopeBindingKind.Procedure {
            give "procedure";
        }

        ScopeBindingKind.Type {
            give "type";
        }

        ScopeBindingKind.Field {
            give "field";
        }

        ScopeBindingKind.Method {
            give "method";
        }

        ScopeBindingKind.Module {
            give "module";
        }

        ScopeBindingKind.Import {
            give "import";
        }

        ScopeBindingKind.Generic {
            give "generic";
        }

        ScopeBindingKind.Trait {
            give "trait";
        }

        ScopeBindingKind.Namespace {
            give "namespace";
        }

        ScopeBindingKind.Builtin {
            give "builtin";
        }

        ScopeBindingKind.Generated {
            give "generated";
        }
    }

    give "local";
}

proc scope_binding_state_name(
    state: ScopeBindingState
) -> string {
    pick state {
        ScopeBindingState.Declared {
            give "declared";
        }

        ScopeBindingState.Defined {
            give "defined";
        }

        ScopeBindingState.Imported {
            give "imported";
        }

        ScopeBindingState.Shadowed {
            give "shadowed";
        }

        ScopeBindingState.Invalidated {
            give "invalidated";
        }
    }

    give "invalidated";
}

proc scope_binding_visibility_name(
    visibility: ScopeBindingVisibility
) -> string {
    pick visibility {
        ScopeBindingVisibility.Public {
            give "public";
        }

        ScopeBindingVisibility.Package {
            give "package";
        }

        ScopeBindingVisibility.Module {
            give "module";
        }

        ScopeBindingVisibility.Private {
            give "private";
        }
    }

    give "private";
}
