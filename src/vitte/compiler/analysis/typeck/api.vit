space vitte/compiler/analysis/typeck

use vitte/compiler/analysis/typeck/checker.{ run_typeck_hir, run_typeck_hir_with_legacy_implicit_mutability }
use vitte/compiler/analysis/typeck/errors.{ TypeckResult }
use vitte/compiler/middle/hir/hir.{ HirUnit }

export *

proc production_typeck_pipeline_name() -> string {
  give "hir";
}

proc production_typeck_pipeline_status() -> string {
  give "canonical";
}

proc run_production_typeck_hir(hir: HirUnit) -> TypeckResult {
  give run_typeck_hir(hir);
}

proc run_bootstrap_typeck_hir(hir: HirUnit) -> TypeckResult {
  give run_typeck_hir_with_legacy_implicit_mutability(hir);
}
