space vitte/compiler/analysis/typeck

export *

proc join(values: [string], separator: string) -> string {
  let out: string = "";
  let i: u64 = 0;
  while i < len(values) {
    if i > 0 {
      set out = out + separator;
    }
    set out = out + values[i];
    set i = i + 1;
  }
  give out;
}

use vitte/compiler/analysis/typeck/errors.{ ExprTypeResult, TypeckResult, add_unique_diag, expr_result, typeck_assignment_mismatch, typeck_condition_type, typeck_conflicting_impl, typeck_constraint_cycle, typeck_diag, typeck_give_missing_path, typeck_give_value_in_unit_proc, typeck_invalid_hir_result, typeck_let_inference_failed, typeck_non_exhaustive_match, typeck_result, typeck_return_mismatch, typeck_set_immutable, typeck_unknown_type }
use vitte/compiler/analysis/typeck/infer.{ TypeBinding, constrained_generic_type_binding, env_get, env_has, env_index, expression_types_compatible, function_param_types, function_return_type, infer_expr_type, param_type_binding, resolved_call_generic_arguments, split_function_signature_types, trait_impl_binding_name, type_binding, type_identifier_index }
use vitte/compiler/analysis/typeck/traits.{ type_is_copy, type_is_integer, type_is_known, type_is_truthy }
use vitte/compiler/diagnostics/diagnostic.{ Diagnostic }
use vitte/compiler/source/span.{ Span }
use vitte/compiler/middle/hir/hir.{ HirExpr, HirExprKind, HirItem, HirItemKind, HirModule, HirNominalMember, HirNominalMemberKind, HirProcParam, HirStmt, HirStmtKind, HirUnit }
use vitte/stdlib/io/fileops.{ write_file }

form TypeckStmtWalk {
  stmts: [HirStmt]
  env: [TypeBinding]
  diagnostics: [Diagnostic]
  valid: bool
}

form TypeckMemberWalk {
  members: [HirNominalMember]
  diagnostics: [Diagnostic]
  valid: bool
}

proc type_binding_env_copy(env: [TypeBinding]) -> [TypeBinding] {
  let out: [TypeBinding] = [];
  set out = out + env;
  give out;
}

proc type_binding_env_merge(left: [TypeBinding], right: [TypeBinding]) -> [TypeBinding] {
  let out: [TypeBinding] = type_binding_env_copy(left);
  set out = out + right;
  give out;
}

proc type_binding_env_put_owned(env: [TypeBinding], name: string, ty: string) -> [TypeBinding] {
  let out: [TypeBinding] = env;
  let index: int = env_index(out, name);
  if index >= 0 {
    set out[index] = type_binding(name, ty);
  } else {
    set out = out + [type_binding(name, ty)];
  }
  give out;
}

proc type_binding_env_put_binding_reuse(env: [TypeBinding], binding: TypeBinding) -> [TypeBinding] {
  let out: [TypeBinding] = env;
  let empty_index: u64 = 0;
  while empty_index < len(out) {
    if not out[empty_index].valid {
      set out[empty_index] = binding;
      give out;
    }
    set empty_index = empty_index + 1;
  }
  set out = out + [binding];
  give out;
}

proc type_binding_env_add_reuse(env: [TypeBinding], bindings: [TypeBinding]) -> [TypeBinding] {
  let out: [TypeBinding] = env;
  let i: u64 = 0;
  while i < len(bindings) {
    set out = type_binding_env_put_binding_reuse(out, bindings[i]);
    set i = i + 1;
  }
  give out;
}

proc type_binding_env_clear_after(env: [TypeBinding], start: u64) -> [TypeBinding] {
  let out: [TypeBinding] = env;
  let empty: TypeBinding = type_binding("", "");
  let i: u64 = start;
  while i < len(out) {
    set out[i] = empty;
    set i = i + 1;
  }
  give out;
}

proc legacy_implicit_mutability_marker() -> string {
  give "@vitte-bootstrap-legacy-implicit-mutability";
}

proc typeck_assignment_compatible(env: [TypeBinding], expected: string, actual: string, expr: HirExpr) -> bool {
  if expression_types_compatible(expected, actual, expr) {
    give true;
  }
  give env_has(env, legacy_implicit_mutability_marker())
    and type_is_integer(expected)
    and type_is_integer(actual);
}

proc nominal_type_env_name(name: string) -> string {
  give "@type:" + name;
}

proc nominal_member_env_name(owner: string, member: string) -> string {
  give "@member:" + owner + "." + member;
}

proc nominal_member_provider_env_name(owner: string, member: string) -> string {
  give "@member-provider:" + owner + "." + member;
}

proc nominal_variants_env_name(owner: string) -> string {
  give "@variants:" + owner;
}

proc ambiguous_method_binding_type() -> string {
  give "@ambiguous-method";
}

proc provider_list_contains(providers: string, provider: string) -> bool {
  let values: [string] = split(providers, ",");
  let i: u64 = 0;
  while i < len(values) {
    if trim(values[i]) == provider {
      give true;
    }
    set i = i + 1;
  }
  give false;
}

proc append_member_provider(providers: string, provider: string) -> string {
  if providers == "" or providers == "opaque" {
    give provider;
  }
  if provider_list_contains(providers, provider) {
    give providers;
  }
  give providers + ", " + provider;
}

proc typeck_stmt_list_gives(stmts: [HirStmt]) -> bool {
  let i: u64 = 0;
  while i < len(stmts) {
    let stmt: HirStmt = stmts[i];
    if stmt.kind == HirStmtKind.Give {
      give true;
    }
    if stmt.kind == HirStmtKind.If and len(stmt.then_stmts) > 0 and len(stmt.else_stmts) > 0 and typeck_stmt_list_gives(stmt.then_stmts) and typeck_stmt_list_gives(stmt.else_stmts) {
      give true;
    }
    set i = i + 1;
  }
  give false;
}

proc typeck_proc_has_result(annotation_text: string) -> bool {
  let result: string = trim(annotation_text);
  give result != "" and result != "unit" and result != "void" and result != "()";
}

proc annotated_empty_list_type(annotation_text: string, expr: HirExpr, inferred_ty: string) -> string {
  if expr.kind == HirExprKind.Array and len(expr.children) == 0 and annotation_text != "" and (inferred_ty == "" or inferred_ty == "unknown" or inferred_ty == "array") {
    give annotation_text;
  }
  give inferred_ty;
}

proc nominal_variant_names(item: HirItem) -> [string] {
  let variants: [string] = [];
  let i: u64 = 0;
  while i < len(item.members) {
    if item.members[i].kind == HirNominalMemberKind.Variant and item.members[i].name != "" {
      set variants = variants + [item.members[i].name];
    }
    set i = i + 1;
  }
  give variants;
}

proc nominal_base_type(ty: string) -> string {
  let value: string = trim(ty);
  let bracket: int = find(value, "[");
  if bracket > 0 {
    give trim(slice(value, 0, bracket));
  }
  give value;
}

proc declaration_builtin_type(type_name: string) -> bool {
  let value: string = trim(type_name);
  if value == "bool" or value == "char" or value == "string" or value == "str" {
    give true;
  }
  if value == "unit" or value == "never" or value == "int" or value == "uint" {
    give true;
  }
  if value == "isize" or value == "usize" or value == "i8" or value == "i16" {
    give true;
  }
  if value == "i32" or value == "i64" or value == "i128" or value == "u8" {
    give true;
  }
  if value == "u16" or value == "u32" or value == "u64" or value == "u128" {
    give true;
  }
  give value == "float" or value == "f32" or value == "f64";
}

proc declaration_type_known(env: [TypeBinding], type_name: string) -> bool {
  let value: string = trim(type_name);
  if value == "" or value == "..." {
    give true;
  }
  if starts_with(value, "&mut ") or starts_with(value, "*mut ") {
    give declaration_type_known(env, trim(slice(value, 5, len(value))));
  }
  if starts_with(value, "*const ") {
    give declaration_type_known(env, trim(slice(value, 7, len(value))));
  }
  if starts_with(value, "&") or starts_with(value, "*") {
    give declaration_type_known(env, trim(slice(value, 1, len(value))));
  }
  if starts_with(value, "fn(") {
    let params: [string] = function_param_types(value);
    let i: u64 = 0;
    while i < len(params) {
      if not declaration_type_known(env, params[i]) {
        give false;
      }
      set i = i + 1;
    }
    give declaration_type_known(env, function_return_type(value));
  }
  if starts_with(value, "[") and ends_with(value, "]") {
    let inner: string = trim(slice(value, 1, len(value) - 1));
    let separator: int = find(inner, ";");
    let element_type: string = if separator >= 0 { trim(slice(inner, 0, separator)) } else { inner };
    give declaration_type_known(env, element_type);
  }
  if starts_with(value, "(") and ends_with(value, ")") {
    let elements: [string] = split_function_signature_types(slice(value, 1, len(value) - 1));
    let i: u64 = 0;
    while i < len(elements) {
      if not declaration_type_known(env, elements[i]) {
        give false;
      }
      set i = i + 1;
    }
    give true;
  }
  let generic_open: int = find(value, "[");
  if generic_open > 0 and ends_with(value, "]") {
    let base: string = trim(slice(value, 0, generic_open));
    if not declaration_type_known(env, base) {
      give false;
    }
    let arguments: [string] = split_function_signature_types(slice(value, generic_open + 1, len(value) - 1));
    let i: u64 = 0;
    while i < len(arguments) {
      if not declaration_type_known(env, arguments[i]) {
        give false;
      }
      set i = i + 1;
    }
    give true;
  }
  if declaration_builtin_type(value) or value == "Self" {
    give true;
  }
  if env_has(env, nominal_type_env_name(value)) {
    give true;
  }
  if len(value) > 0 {
    let first: string = slice(value, 0, 1);
    if first >= "A" and first <= "Z" {
      give true;
    }
  }
  give find(value, "::") >= 0 or find(value, ".") >= 0;
}

proc generic_param_type_bindings(params: [string]) -> [TypeBinding] {
  let env: [TypeBinding] = [];
  let i: u64 = 0;
  while i < len(params) {
    if params[i] != "" {
      set env = type_binding_env_put_owned(env, nominal_type_env_name(params[i]), params[i]);
    }
    set i = i + 1;
  }
  give env;
}

proc validate_declared_type(diagnostics: [Diagnostic], env: [TypeBinding], type_name: string, declaration_context: string, span: Span) -> [Diagnostic] {
  if type_name == "" or declaration_type_known(env, type_name) {
    give diagnostics;
  }
  give add_unique_diag(diagnostics, typeck_unknown_type(type_name, declaration_context, span));
}

proc validate_proc_param_types(diagnostics: [Diagnostic], env: [TypeBinding], params: [HirProcParam], owner_name: string, span: Span) -> [Diagnostic] {
  let out: [Diagnostic] = diagnostics;
  let i: u64 = 0;
  while i < len(params) {
    if not params[i].variadic {
      set out = validate_declared_type(out, env, params[i].annotation_text, "parameter `" + params[i].name + "` of `" + owner_name + "`", span);
    }
    set i = i + 1;
  }
  give out;
}

proc validate_item_declared_types(module_env: [TypeBinding], item: HirItem) -> [Diagnostic] {
  let env: [TypeBinding] = type_binding_env_merge(module_env, generic_param_type_bindings(item.generic_params));
  let out: [Diagnostic] = [];
  set out = validate_proc_param_types(out, env, item.params, item.name, item.span);
  if item.kind == HirItemKind.Proc {
    set out = validate_declared_type(out, env, item.annotation_text, "return type of `" + item.name + "`", item.span);
  } elif item.annotation_text != "" {
    set out = validate_declared_type(out, env, item.annotation_text, "declared type of `" + item.name + "`", item.span);
  }
  if item.kind == HirItemKind.Impl {
    set out = validate_declared_type(out, env, item.target_type_text, "impl target for `" + item.name + "`", item.span);
  }
  let generic_index: u64 = 0;
  while generic_index < len(item.generic_param_info) {
    set out = validate_declared_type(
      out,
      env,
      item.generic_param_info[generic_index].default_type_text,
      "default type of generic parameter `" + item.generic_param_info[generic_index].name + "`",
      item.span
    );
    set generic_index = generic_index + 1;
  }
  let i: u64 = 0;
  while i < len(item.members) {
    let member = item.members[i];
    let member_context: string = "member `" + item.name + "." + member.name + "`";
    set out = validate_declared_type(out, env, member.annotation_text, member_context, member.span);
    set out = validate_proc_param_types(out, env, member.params, item.name + "." + member.name, member.span);
    set i = i + 1;
  }
  give out;
}

proc proc_param_signature_text(param: HirProcParam, target_type_text: string) -> string {
  let ty: string = if param.annotation_text == "Self" and target_type_text != "" { target_type_text } else { if param.annotation_text != "" { param.annotation_text } else { "opaque" } };
  if param.variadic {
    give "...";
  }
  if param.borrowed and param.mutable {
    give "&mut " + ty;
  }
  if param.borrowed {
    give "borrow " + ty;
  }
  if param.mutable {
    give "mut " + ty;
  }
  if param.mode != "" {
    give param.mode + " " + ty;
  }
  give ty;
}

proc proc_signature_type(params: [HirProcParam], return_type: string, target_type_text: string) -> string {
  let out: [string] = [];
  let i: u64 = 0;
  while i < len(params) {
    set out = out + [proc_param_signature_text(params[i], target_type_text)];
    set i = i + 1;
  }
  let ret: string = if return_type != "" { return_type } else { "unit" };
  give "fn(" + join(out, ", ") + ") -> " + ret;
}

proc bind_member_signature(item: HirItem, member: HirNominalMember) -> string {
  let params: [string] = [];
  let start_index: u64 = 0;
  if len(member.params) > 0 and (member.kind == HirNominalMemberKind.TraitMethod or member.kind == HirNominalMemberKind.ImplMethod) {
    let first: string = member.params[0].annotation_text;
    if first == "Self" or (item.target_type_text != "" and first == item.target_type_text) {
      set start_index = 1 as u64;
    }
  }
  let i: u64 = start_index;
  while i < len(member.params) {
    let param_ty: string = proc_param_signature_text(member.params[i], item.target_type_text);
    set params = params + [param_ty];
    set i = i + 1;
  }
  let joined: string = join(params, ", ");
  let ret: string = if member.annotation_text != "" { member.annotation_text } else { "unit" };
  give "fn(" + joined + ") -> " + ret;
}

proc nominal_member_binding_type(item: HirItem, member: HirNominalMember) -> string {
  if member.kind == HirNominalMemberKind.Field {
    if member.annotation_text != "" {
      give member.annotation_text;
    }
    give "opaque";
  }
  if member.kind == HirNominalMemberKind.Variant {
    if item.kind == HirItemKind.Bits or item.kind == HirItemKind.Flags {
      if item.annotation_text != "" {
        give item.annotation_text;
      }
      give item.name;
    }
    if member.annotation_text != "" {
      give "fn(" + member.annotation_text + ") -> " + item.name;
    }
    give item.name;
  }
  give bind_member_signature(item, member);
}

proc generic_param_index(params: [string], name: string) -> int {
  let i: int = 0;
  while i < len(params) {
    if params[i] == name {
      give i;
    }
    set i = i + 1;
  }
  give -1;
}

proc replace_generic_bound(bounds: [string], index: u64, bound: string) -> [string] {
  let out: [string] = [];
  let i: u64 = 0;
  while i < len(bounds) {
    if i == index {
      let next_bound: string = if bounds[i] == "" { trim(bound) } else { bounds[i] + " + " + trim(bound) };
      set out = out + [next_bound];
    } else {
      set out = out + [bounds[i]];
    }
    set i = i + 1;
  }
  give out;
}

proc item_generic_bounds(item: HirItem) -> [string] {
  let bounds: [string] = [];
  let i: u64 = 0;
  while i < len(item.generic_params) {
    let inline_bound: string = if i < len(item.generic_param_info) { item.generic_param_info[i].bound_text } else { "" };
    set bounds = bounds + [inline_bound];
    set i = i + 1;
  }

  let clause_index: u64 = 0;
  while clause_index < len(item.where_clauses) {
    let clause: string = trim(item.where_clauses[clause_index]);
    let colon: int = find(clause, ":");
    if colon > 0 {
      let param_name: string = trim(slice(clause, 0, colon));
      let bound: string = trim(slice(clause, colon + 1, len(clause)));
      let index: int = generic_param_index(item.generic_params, param_name);
      if index >= 0 and bound != "" {
        set bounds = replace_generic_bound(bounds, index as u64, bound);
      }
    }
    set clause_index = clause_index + 1;
  }
  give bounds;
}

proc string_list_contains(values: [string], value: string) -> bool {
  let i: u64 = 0;
  while i < len(values) {
    if values[i] == value {
      give true;
    }
    set i = i + 1;
  }
  give false;
}

proc direct_bound_references_param(bound_text: string, param_name: string) -> bool {
  let bounds: [string] = split(bound_text, "+");
  let i: u64 = 0;
  while i < len(bounds) {
    if trim(bounds[i]) == param_name {
      give true;
    }
    set i = i + 1;
  }
  give false;
}

proc generic_constraint_references(item: HirItem, source_index: u64, target_param: string) -> bool {
  let bounds: [string] = item_generic_bounds(item);
  if source_index < len(bounds) and direct_bound_references_param(bounds[source_index], target_param) {
    give true;
  }
  if source_index < len(item.generic_param_info) {
    let default_type: string = item.generic_param_info[source_index].default_type_text;
    if default_type != "" and type_identifier_index(default_type, target_param) >= 0 {
      give true;
    }
  }
  give false;
}

proc generic_constraint_reaches(item: HirItem, source_index: u64, target_param: string, visited: [string]) -> bool {
  if source_index >= len(item.generic_params) or len(visited) > len(item.generic_params) {
    give false;
  }

  let i: u64 = 0;
  while i < len(item.generic_params) {
    let dependency: string = item.generic_params[i];
    if generic_constraint_references(item, source_index, dependency) {
      if dependency == target_param {
        give true;
      }
      if not string_list_contains(visited, dependency)
        and generic_constraint_reaches(item, i, target_param, visited + [dependency]) {
        give true;
      }
    }
    set i = i + 1;
  }
  give false;
}

proc generic_constraint_cycle_start(item: HirItem) -> string {
  let i: u64 = 0;
  while i < len(item.generic_params) {
    let param_name: string = item.generic_params[i];
    if generic_constraint_reaches(item, i, param_name, [param_name]) {
      give param_name;
    }
    set i = i + 1;
  }
  give "";
}

proc builtin_type_bindings() -> [TypeBinding] {
  give [
    constrained_generic_type_binding("len", "fn(opaque) -> u64", [], []),
    constrained_generic_type_binding("trim", "fn(string) -> string", [], []),
    constrained_generic_type_binding("starts_with", "fn(string, string) -> bool", [], []),
    constrained_generic_type_binding("ends_with", "fn(string, string) -> bool", [], []),
    constrained_generic_type_binding("print", "fn(string) -> unit", [], []),
    constrained_generic_type_binding("println", "fn(string) -> unit", [], []),
    constrained_generic_type_binding("eprint", "fn(string) -> unit", [], []),
    constrained_generic_type_binding("eprintln", "fn(string) -> unit", [], []),
    constrained_generic_type_binding("panic", "fn(string) -> unit", [], []),
    constrained_generic_type_binding("assert", "fn(bool) -> unit", [], []),
    constrained_generic_type_binding("slice", "fn(string, opaque, opaque) -> string", [], []),
    constrained_generic_type_binding("to_string", "fn(opaque) -> string", [], []),
    constrained_generic_type_binding("type_name", "fn(opaque) -> string", [], []),
    constrained_generic_type_binding("find", "fn(string, string) -> int", [], [])
  ];
}

proc check_generic_constraint_cycles(item: HirItem) -> [Diagnostic] {
  let cycle_start: string = generic_constraint_cycle_start(item);
  if cycle_start == "" {
    give [];
  }
  give [typeck_constraint_cycle(item.name, cycle_start, item.span)];
}

proc nominal_type_bindings(items: [HirItem]) -> [TypeBinding] {
  let out: [TypeBinding] = [];
  let i: u64 = 0;
  while i < len(items) {
    let item: HirItem = items[i];
    if item.name != "" and item.kind != HirItemKind.Space and item.kind != HirItemKind.Use and item.kind != HirItemKind.Export {
      if item.kind == HirItemKind.Proc {
        set out = out + [constrained_generic_type_binding(item.name, proc_signature_type(item.params, item.annotation_text, item.target_type_text), item.generic_params, item_generic_bounds(item))];
      } elif item.kind == HirItemKind.Const {
        let const_type: string = if item.annotation_text != "" { item.annotation_text } else { item.expr.inferred_type };
        if const_type != "" and const_type != "unknown" {
          set out = type_binding_env_put_owned(out, item.name, const_type);
        }
      }
      if item.kind == HirItemKind.Impl and item.name != "" and item.target_type_text != "" {
        set out = type_binding_env_put_owned(out, trait_impl_binding_name(item.name, item.target_type_text), "impl");
      }
      if item.kind == HirItemKind.Pick {
        let variants: [string] = nominal_variant_names(item);
        if len(variants) > 0 {
          set out = type_binding_env_put_owned(out, nominal_variants_env_name(item.name), join(variants, ","));
        }
      }
      set out = type_binding_env_put_owned(out, nominal_type_env_name(item.name), item.name);
      let owner_name: string = if item.kind == HirItemKind.Impl and item.target_type_text != "" { item.target_type_text } else { item.name };
      let j: u64 = 0;
      while j < len(item.members) {
        if item.members[j].name != "" and owner_name != "" {
          let member_name: string = item.members[j].name;
          let member_key: string = nominal_member_env_name(owner_name, member_name);
          if item.kind == HirItemKind.Impl {
            let provider_key: string = nominal_member_provider_env_name(owner_name, member_name);
            let providers: string = env_get(out, provider_key);
            if providers == "opaque" {
              set out = type_binding_env_put_owned(out, member_key, nominal_member_binding_type(item, item.members[j]));
              set out = type_binding_env_put_owned(out, provider_key, item.name);
            } elif not provider_list_contains(providers, item.name) {
              set out = type_binding_env_put_owned(out, member_key, ambiguous_method_binding_type());
              set out = type_binding_env_put_owned(out, provider_key, append_member_provider(providers, item.name));
            }
          } else {
            set out = type_binding_env_put_owned(out, member_key, nominal_member_binding_type(item, item.members[j]));
          }
        }
        set j = j + 1;
      }
    }
    set i = i + 1;
  }
  give out;
}

proc match_stmt_has_fallback_arm(stmt: HirStmt) -> bool {
  let i: u64 = 0;
  while i < len(stmt.then_stmts) {
    let is_fallback_arm: bool = stmt.then_stmts[i].name == "_" or stmt.then_stmts[i].name == "else";
    if stmt.then_stmts[i].kind == HirStmtKind.When and is_fallback_arm {
      give true;
    }
    set i = i + 1;
  }
  give false;
}

proc match_pattern_covers(pattern: string, case_name: string) -> bool {
  let value: string = trim(pattern);
  if value == case_name {
    give true;
  }
  give type_identifier_index(value, case_name) >= 0;
}

proc match_stmt_covers_case(stmt: HirStmt, case_name: string) -> bool {
  let i: u64 = 0;
  while i < len(stmt.then_stmts) {
    if stmt.then_stmts[i].kind == HirStmtKind.When and match_pattern_covers(stmt.then_stmts[i].name, case_name) {
      give true;
    }
    set i = i + 1;
  }
  give false;
}

proc match_missing_case(env: [TypeBinding], stmt: HirStmt, matched_type: string) -> string {
  if match_stmt_has_fallback_arm(stmt) {
    give "";
  }
  if matched_type == "bool" {
    if not match_stmt_covers_case(stmt, "true") { give "true"; }
    if not match_stmt_covers_case(stmt, "false") { give "false"; }
    give "";
  }

  let variants_text: string = env_get(env, nominal_variants_env_name(nominal_base_type(matched_type)));
  if variants_text != "opaque" and variants_text != "" {
    let variants: [string] = split(variants_text, ",");
    let i: u64 = 0;
    while i < len(variants) {
      let variant: string = trim(variants[i]);
      if variant != "" and not match_stmt_covers_case(stmt, variant) {
        give variant;
      }
      set i = i + 1;
    }
    give "";
  }
  give "_";
}

proc trait_item_by_name(items: [HirItem], name: string) -> HirItem {
  let i: u64 = 0;
  while i < len(items) {
    if items[i].kind == HirItemKind.Trait and items[i].name == name {
      give items[i];
    }
    set i = i + 1;
  }
  give HirItem {
    id: 0,
    span: items[0].span,
    kind: HirItemKind.Unknown,
    name: "",
    resolved_id: 0,
    namespace: "",
    visibility: "",
    exported: false,
    abi: "",
    generic_count: 0,
    generic_params: [],
    generic_param_info: [],
    where_clauses: [],
    requires: [],
    type_param_count: 0,
    attribute_count: 0,
    modifier_count: 0,
    member_count: 0,
    signature_param_count: 0,
    params: [],
    annotation_text: "",
    target_type_text: "",
    expr: HirExpr { id: 0, span: items[0].span, kind: 0, text: "", name: "", operator: "", binding: "", resolved_id: 0, resolved_kind: "", external: false, value_mode: 0, inferred_type: "unknown", place_category: 0, copyable: false, constant: false, assignable: false, temporary: false, diagnostics: [], children: [], valid: false },
    stmts: [],
    members: [],
    message: "",
    scope_depth: 0,
    diagnostics: [],
    valid: false
  };
}

proc member_env(params: [HirProcParam], target_type_text: string) -> [TypeBinding] {
  let env: [TypeBinding] = [];
  let i: u64 = 0;
  while i < len(params) {
    let ty: string = if params[i].annotation_text == "Self" and target_type_text != "" { target_type_text } else { if params[i].annotation_text != "" { params[i].annotation_text } else { "opaque" } };
    if params[i].name != "" and not params[i].variadic {
      set env = env + [param_type_binding(params[i].name, ty, params[i].mutable, params[i].borrowed)];
    }
    set i = i + 1;
  }
  give env;
}

proc typeck_member(module_env: [TypeBinding], item: HirItem, member: HirNominalMember) -> TypeckMemberWalk {
  if member.kind == HirNominalMemberKind.Variant {
    give TypeckMemberWalk {
      members: [member],
      diagnostics: [],
      valid: member.valid
    };
  }

  let local_env: [TypeBinding] = type_binding_env_merge(module_env, member_env(member.params, item.target_type_text));
  let typed_expr: HirExpr = annotate_expr(local_env, member.expr);
  let body_result: TypeckStmtWalk = check_stmt_tree([], local_env, member.body_stmts, member.annotation_text, member.name);
  let diagnostics: [Diagnostic] = body_result.diagnostics;
  let typed_member: HirNominalMember = member;
  set typed_member.expr = typed_expr;
  set typed_member.body_stmts = body_result.stmts;
  give TypeckMemberWalk {
    members: [typed_member],
    diagnostics: diagnostics,
    valid: len(diagnostics) == 0
  };
}

proc typeck_members(module_env: [TypeBinding], item: HirItem) -> TypeckMemberWalk {
  let out: [HirNominalMember] = item.members;
  let diagnostics: [Diagnostic] = [];
  let i: u64 = 0;
  while i < len(item.members) {
    let walk: TypeckMemberWalk = typeck_member(module_env, item, item.members[i]);
    if len(walk.members) > 0 {
      set out[i] = walk.members[0];
    }
    set diagnostics = diagnostics + walk.diagnostics;
    set i = i + 1;
  }
  give TypeckMemberWalk { members: out, diagnostics: diagnostics, valid: len(diagnostics) == 0 };
}

proc find_member(members: [HirNominalMember], name: string) -> HirNominalMember {
  let i: u64 = 0;
  while i < len(members) {
    if members[i].name == name {
      give members[i];
    }
    set i = i + 1;
  }
  give HirNominalMember { id: 0, span: members[0].span, kind: 0, name: "", annotation_text: "", expr: HirExpr { id: 0, span: members[0].span, kind: 0, text: "", name: "", operator: "", binding: "", resolved_id: 0, resolved_kind: "", external: false, value_mode: 0, inferred_type: "unknown", place_category: 0, copyable: false, constant: false, assignable: false, temporary: false, diagnostics: [], children: [], valid: false }, params: [], body_stmts: [], message: "", valid: false };
}

proc check_impl_against_trait(items: [HirItem], item: HirItem) -> [Diagnostic] {
  let out: [Diagnostic] = [];
  if item.kind != HirItemKind.Impl or len(item.members) == 0 {
    give out;
  }
  let trait_item: HirItem = trait_item_by_name(items, item.name);
  if not trait_item.valid {
    give out + [typeck_diag("TYPECK_E_IMPL_UNKNOWN_TRAIT", "impl target trait is not declared", [item.name], "declare the trait before implementing it", item.span, true)];
  }
  let i: u64 = 0;
  while i < len(trait_item.members) {
    let trait_member: HirNominalMember = trait_item.members[i];
    let impl_member: HirNominalMember = find_member(item.members, trait_member.name);
    if not impl_member.valid {
      set out = out + [typeck_diag("TYPECK_E_IMPL_MISSING_MEMBER", "impl is missing a required trait method", [item.name, trait_member.name], "define the missing method on the impl", item.span, true)];
    } else {
      if len(impl_member.params) != len(trait_member.params) {
        set out = out + [typeck_diag("TYPECK_E_IMPL_SIGNATURE_MISMATCH", "impl method parameter count does not match trait method", [trait_member.name], "align impl method arity with the trait declaration", impl_member.span, true)];
      } elif impl_member.annotation_text != trait_member.annotation_text {
        set out = out + [typeck_diag("TYPECK_E_IMPL_SIGNATURE_MISMATCH", "impl method return type does not match trait method", [trait_member.name, trait_member.annotation_text, impl_member.annotation_text], "align impl method return type with the trait declaration", impl_member.span, true)];
      } else {
        let j: u64 = 0;
        while j < len(trait_member.params) and j < len(impl_member.params) {
          if trait_member.params[j].annotation_text != impl_member.params[j].annotation_text {
            set out = out + [typeck_diag("TYPECK_E_IMPL_SIGNATURE_MISMATCH", "impl method parameter type does not match trait method", [trait_member.name, trait_member.params[j].annotation_text, impl_member.params[j].annotation_text], "align impl method parameter types with the trait declaration", impl_member.span, true)];
          }
          set j = j + 1;
        }
      }
    }
    set i = i + 1;
  }
  give out;
}

proc check_impl_coherence(items: [HirItem], item_index: u64) -> [Diagnostic] {
  let out: [Diagnostic] = [];
  if item_index >= len(items) {
    give out;
  }

  let item: HirItem = items[item_index];
  let trait_name: string = trim(item.name);
  let target_type: string = trim(item.target_type_text);
  if item.kind != HirItemKind.Impl or trait_name == "" or target_type == "" {
    give out;
  }

  let i: u64 = 0;
  while i < item_index {
    let previous: HirItem = items[i];
    if previous.kind == HirItemKind.Impl
      and trim(previous.name) == trait_name
      and trim(previous.target_type_text) == target_type {
      give [typeck_conflicting_impl(trait_name, target_type, previous.span, item.span)];
    }
    set i = i + 1;
  }

  give out;
}

proc run_typeck_hir(hir: HirUnit) -> TypeckResult {
  if not hir.valid {
    give typeck_invalid_hir_result(hir);
  }

  let checked: TypeckResult = check_module([], [], hir);
  give checked;
}

proc run_typeck_hir_with_legacy_implicit_mutability(hir: HirUnit) -> TypeckResult {
  if not hir.valid {
    give typeck_invalid_hir_result(hir);
  }

  let compatibility_env: [TypeBinding] = [
    param_type_binding(legacy_implicit_mutability_marker(), "bool", true, false)
  ];
  give check_module([], compatibility_env, hir);
}

proc bootstrap_call_param_value_type(param_type: string) -> string {
  let value: string = trim(param_type);
  if starts_with(value, "&mut ") {
    give trim(slice(value, 5, len(value)));
  }
  if starts_with(value, "&") {
    give trim(slice(value, 1, len(value)));
  }
  if starts_with(value, "mut ") {
    give trim(slice(value, 4, len(value)));
  }
  give value;
}

proc annotate_bootstrap_call_arguments(env: [TypeBinding], expr: HirExpr) -> HirExpr {
  if not env_has(env, legacy_implicit_mutability_marker())
    or expr.kind != HirExprKind.Call
    or len(expr.children) == 0 {
    give expr;
  }
  let callee_type: string = expr.children[0].inferred_type;
  if not starts_with(callee_type, "fn(") {
    give expr;
  }
  let params: [string] = function_param_types(callee_type);
  let typed: HirExpr = expr;
  let i: u64 = 1;
  while i < len(typed.children) and i - 1 < len(params) {
    let expected: string = bootstrap_call_param_value_type(params[i - 1]);
    let contextual_empty_array: bool = typed.children[i].kind == HirExprKind.Array
      and len(typed.children[i].children) == 0
      and typed.children[i].inferred_type == "unknown";
    let contextual_integer: bool = typed.children[i].kind == HirExprKind.Int
      and type_is_integer(expected);
    if expected != "" and expected != "opaque" and (contextual_empty_array or contextual_integer) {
      set typed.children[i].inferred_type = expected;
      set typed.children[i].copyable = type_is_copy(expected);
    }
    set i = i + 1;
  }
  give typed;
}

proc annotate_expr(env: [TypeBinding], expr: HirExpr) -> HirExpr {
  let children: [HirExpr] = expr.children;
  let i: u64 = 0;
  while i < len(expr.children) {
    set children[i] = annotate_expr(env, expr.children[i]);
    set i = i + 1;
  }

  let base: HirExpr = expr;
  set base.children = children;
  set base = annotate_bootstrap_call_arguments(env, base);
  let inferred = infer_expr_type(env, base);
  let generic_arguments: [string] = if base.kind == HirExprKind.Call and inferred.valid {
    resolved_call_generic_arguments(env, base)
  } else {
    base.generic_arguments
  };
  set base.inferred_type = inferred.ty;
  set base.copyable = type_is_copy(inferred.ty);
  set base.generic_arguments = generic_arguments;
  give base;
}

// Preserve accepted literal types in HIR, not only in the binding environment.
// This includes empty arrays, whose later reads already have the declared type.
proc contextual_literal(env: [TypeBinding], expr: HirExpr, expected: string) -> HirExpr {
  let integer: bool = expr.kind == HirExprKind.Int and type_is_integer(expected)
    and typeck_assignment_compatible(env, expected, expr.inferred_type, expr);
  let empty_array: bool = expr.kind == HirExprKind.Array and len(expr.children) == 0
    and starts_with(expected, "[") and ends_with(expected, "]");
  if integer or empty_array {
    let typed: HirExpr = expr;
    set typed.inferred_type = expected;
    set typed.copyable = type_is_copy(expected);
    give typed;
  }
  give expr;
}

proc check_stmt_tree_branch(env: [TypeBinding], stmts: [HirStmt], return_type: string, owner_name: string) -> TypeckStmtWalk {
  if len(stmts) == 0 {
    give TypeckStmtWalk { stmts: [], env: env, diagnostics: [], valid: true };
  }
  if env_has(env, legacy_implicit_mutability_marker()) {
    give check_stmt_tree([], env, stmts, return_type, owner_name);
  }
  let branch_env: [TypeBinding] = type_binding_env_copy(env);
  give check_stmt_tree([], branch_env, stmts, return_type, owner_name);
}

proc check_stmt_tree(diagnostics: [Diagnostic], env: [TypeBinding], stmts: [HirStmt], return_type: string, owner_name: string) -> TypeckStmtWalk {
  let out: [Diagnostic] = diagnostics;
  let current_env: [TypeBinding] = env;
  let typed: [HirStmt] = stmts;
  let bootstrap_legacy: bool = env_has(current_env, legacy_implicit_mutability_marker());
  let j: u64 = 0;
  while j < len(stmts) {
    let stmt: HirStmt = stmts[j];
    let typed_expr: HirExpr = annotate_expr(current_env, stmt.expr);
    let result: ExprTypeResult = if bootstrap_legacy {
      expr_result(typed_expr.inferred_type, [], typed_expr.inferred_type != "unknown")
    } else {
      infer_expr_type(current_env, stmt.expr)
    };
    set out = out + result.diagnostics;
    if stmt.annotation_text != "" {
      set out = validate_declared_type(out, current_env, stmt.annotation_text, "local declaration `" + stmt.name + "`", stmt.span);
    }

    let then_checked: TypeckStmtWalk = check_stmt_tree_branch(current_env, stmt.then_stmts, return_type, owner_name);
    let else_checked: TypeckStmtWalk = check_stmt_tree_branch(current_env, stmt.else_stmts, return_type, owner_name);
    set out = out + then_checked.diagnostics + else_checked.diagnostics;

    if stmt.kind == HirStmtKind.Let {
      let effective_ty: string = annotated_empty_list_type(stmt.annotation_text, stmt.expr, result.ty);
      if not type_is_known(effective_ty) {
        set out = add_unique_diag(out, typeck_let_inference_failed(stmt.name, stmt.span));
      }
      if stmt.annotation_text != "" and type_is_known(effective_ty) and not typeck_assignment_compatible(current_env, stmt.annotation_text, effective_ty, stmt.expr) {
        set out = add_unique_diag(out, typeck_assignment_mismatch(stmt.name, stmt.annotation_text, effective_ty, stmt.span));
      }
      if stmt.name != "" {
        let binding_type: string = if stmt.annotation_text != "" { stmt.annotation_text } else { effective_ty };
        set typed_expr = contextual_literal(current_env, typed_expr, binding_type);
        set current_env = type_binding_env_put_binding_reuse(current_env, param_type_binding(stmt.name, binding_type, stmt.mutable, false));
      }
    } elif stmt.kind == HirStmtKind.Set {
      let target_name: string = stmt.target_binding;
      if target_name == "" {
        set target_name = stmt.target;
      }
      if target_name != "" and env_has(current_env, target_name) {
        let binding: TypeBinding = current_env[env_index(current_env, target_name)];
        if stmt.target == target_name {
          set typed_expr = contextual_literal(current_env, typed_expr, binding.ty);
        }
        if not binding.mutable and not env_has(current_env, legacy_implicit_mutability_marker()) {
          set out = add_unique_diag(out, typeck_set_immutable(target_name, stmt.span));
        } elif type_is_known(result.ty) and not typeck_assignment_compatible(current_env, binding.ty, result.ty, stmt.expr) {
          set out = add_unique_diag(out, typeck_assignment_mismatch(
            target_name,
            binding.ty,
            result.ty,
            stmt.span
          ));
        }
      } elif target_name != "" and not env_has(current_env, target_name) {
        set current_env = type_binding_env_put_owned(current_env, target_name, result.ty);
      }
    } elif stmt.kind == HirStmtKind.StaticAssert or stmt.kind == HirStmtKind.If or stmt.kind == HirStmtKind.While {
      if not type_is_truthy(result.ty) {
        set out = add_unique_diag(out, typeck_condition_type(
          result.ty,
          stmt.span
        ));
      }
    } elif stmt.kind == HirStmtKind.Match {
      let missing_case: string = match_missing_case(current_env, stmt, result.ty);
      if missing_case != "" {
        set out = add_unique_diag(out, typeck_non_exhaustive_match(
          missing_case,
          stmt.span
        ));
      }
    } elif stmt.kind == HirStmtKind.Give {
      set typed_expr = contextual_literal(current_env, typed_expr, return_type);
      if return_type != "" and type_is_known(result.ty) and not typeck_assignment_compatible(current_env, return_type, result.ty, stmt.expr) {
        set out = add_unique_diag(out, typeck_return_mismatch(
          owner_name,
          return_type,
          result.ty,
          stmt.span
        ));
      } elif not typeck_proc_has_result(return_type) and stmt.expr.valid and stmt.expr.text != "" and type_is_known(result.ty) and result.ty != "unit" {
        set out = add_unique_diag(out, typeck_give_value_in_unit_proc(owner_name, result.ty, stmt.span));
      }
    }

    set typed[j].expr = typed_expr;
    set typed[j].then_stmts = then_checked.stmts;
    set typed[j].else_stmts = else_checked.stmts;
    set j = j + 1;
  }

  give TypeckStmtWalk {
    stmts: typed,
    env: current_env,
    diagnostics: out,
    valid: len(out) == 0
  };
}

proc check_module(diagnostics: [Diagnostic], env: [TypeBinding], hir: HirUnit) -> TypeckResult {
  let out: [Diagnostic] = diagnostics;
  let items: [HirItem] = hir.module.items;
  let module_env: [TypeBinding] = type_binding_env_merge(type_binding_env_merge(env, builtin_type_bindings()), nominal_type_bindings(hir.module.items));
  let module_binding_count: u64 = len(module_env);
  let bootstrap_legacy: bool = env_has(module_env, legacy_implicit_mutability_marker());
  let i: u64 = 0;
  while i < len(hir.module.items) {
    set module_env = type_binding_env_clear_after(module_env, module_binding_count);
    let item: HirItem = hir.module.items[i];
    let typeck_item_progress_written: bool = write_file(
      "target/reports/compiler_typeck_item_progress.txt",
      to_string(i + 1) + "/" + to_string(len(hir.module.items)) + " " + item.name
        + " diagnostics=" + to_string(len(out)) + " env=" + to_string(len(module_env)) + "\n"
    );
    if not bootstrap_legacy {
      set out = out + check_generic_constraint_cycles(item);
      set out = out + validate_item_declared_types(module_env, item);
    }
    if item.kind == HirItemKind.Unknown {
      set out = add_unique_diag(out, typeck_diag(
        "TYPECK_E_UNKNOWN_ITEM",
        "unknown HIR item kind",
        [item.name],
        "lower the item into a supported HIR kind",
        item.span,
        true
      ));
    }

    let mut typed_item_expr: HirExpr = annotate_expr(module_env, item.expr);
    let mut item_result: ExprTypeResult = expr_result("unit", [], true);
    if item.expr.valid {
      if bootstrap_legacy {
        set item_result = expr_result(typed_item_expr.inferred_type, [], typed_item_expr.inferred_type != "unknown");
      } else {
        set item_result = infer_expr_type(module_env, item.expr);
      }
    } else {
      set typed_item_expr = item.expr;
    }
    set out = out + item_result.diagnostics;
    if item.kind == HirItemKind.Const and item.name != "" {
      if env_has(module_env, item.name) {
        set module_env = type_binding_env_put_owned(module_env, item.name, item_result.ty);
      }
    }

    let item_env: [TypeBinding] = module_env;
    set item_env = type_binding_env_add_reuse(item_env, generic_param_type_bindings(item.generic_params));
    set item_env = type_binding_env_add_reuse(item_env, member_env(item.params, ""));
    let stmt_result: TypeckStmtWalk = check_stmt_tree([], item_env, item.stmts, item.annotation_text, item.name);
    set module_env = type_binding_env_clear_after(module_env, module_binding_count);
    let member_result: TypeckMemberWalk = typeck_members(module_env, item);
    set out = out + stmt_result.diagnostics;
    if item.kind == HirItemKind.Proc
        and typeck_proc_has_result(item.annotation_text)
        and not env_has(module_env, legacy_implicit_mutability_marker())
        and not typeck_stmt_list_gives(item.stmts) {
      set out = add_unique_diag(out, typeck_give_missing_path(item.name, item.annotation_text, item.span));
    }
    set out = out + member_result.diagnostics;
    if not bootstrap_legacy {
      set out = out + check_impl_against_trait(hir.module.items, item);
      set out = out + check_impl_coherence(hir.module.items, i);
    }
    set items[i].expr = typed_item_expr;
    set items[i].stmts = stmt_result.stmts;
    set items[i].members = member_result.members;
    set i = i + 1;
  }

  let typed_hir: HirUnit = HirUnit {
      source_path: hir.source_path,
      module: HirModule {
        items: items,
        valid: hir.module.valid
      },
      node_count: hir.node_count,
      symbol_count: hir.symbol_count,
      scope_count: hir.scope_count,
      valid: hir.valid
  };
  give typeck_result(typed_hir, out);
}
