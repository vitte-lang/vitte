space vitte/compiler/analysis/modules/module_kind

export *

pick ModuleKind {
    Source,
    Library,
    Executable,
    Test,
    Benchmark,
    Example,
    Build,
    Script,
    Plugin,
    ProcMacro,
    StaticLibrary,
    SharedLibrary,
    Object,
    Interface,
    Header,
    Package,
    Workspace,
    Prelude,
    Runtime,
    Stdlib,
    Compiler,
    Builtin,
    Generated,
    External,
    Virtual
}

pick ModuleKindCategory {
    Source,
    Binary,
    Library,
    Tooling,
    System,
    Synthetic,
    External
}

pick ModuleArtifactKind {
    None,
    Executable,
    StaticLibrary,
    SharedLibrary,
    Object,
    Interface,
    Metadata
}

pick ModuleEntryPointPolicy {
    Forbidden,
    Optional,
    Required
}

pick ModuleKindError {
    None,
    EmptyName,
    UnknownKind,
    UnsupportedArtifact,
    InvalidEntryPoint,
    InvalidCombination
}

form ModuleKindResult {
    kind: Option<ModuleKind>
    error: ModuleKindError
    message: string
}

form ModuleKindProfile {
    kind: ModuleKind
    category: ModuleKindCategory
    artifact: ModuleArtifactKind
    entry_point: ModuleEntryPointPolicy

    compilable: bool
    linkable: bool
    executable: bool
    importable: bool
    publishable: bool
    testable: bool

    synthetic: bool
    system: bool
    external: bool
}

proc module_kind_result_ok(
    kind: ModuleKind
) -> ModuleKindResult {
    give ModuleKindResult {
        kind: Some(kind),
        error: ModuleKindError.None,
        message: ""
    };
}

proc module_kind_result_error(
    error: ModuleKindError,
    message: string
) -> ModuleKindResult {
    give ModuleKindResult {
        kind: None,
        error: error,
        message: message
    };
}

proc module_kind_default() -> ModuleKind {
    give ModuleKind.Source;
}

proc module_kind_category(
    kind: ModuleKind
) -> ModuleKindCategory {
    pick kind {
        ModuleKind.Source {
            give ModuleKindCategory.Source;
        }

        ModuleKind.Interface {
            give ModuleKindCategory.Source;
        }

        ModuleKind.Header {
            give ModuleKindCategory.Source;
        }

        ModuleKind.Executable {
            give ModuleKindCategory.Binary;
        }

        ModuleKind.Test {
            give ModuleKindCategory.Binary;
        }

        ModuleKind.Benchmark {
            give ModuleKindCategory.Binary;
        }

        ModuleKind.Example {
            give ModuleKindCategory.Binary;
        }

        ModuleKind.Script {
            give ModuleKindCategory.Binary;
        }

        ModuleKind.Library {
            give ModuleKindCategory.Library;
        }

        ModuleKind.StaticLibrary {
            give ModuleKindCategory.Library;
        }

        ModuleKind.SharedLibrary {
            give ModuleKindCategory.Library;
        }

        ModuleKind.Object {
            give ModuleKindCategory.Library;
        }

        ModuleKind.Plugin {
            give ModuleKindCategory.Library;
        }

        ModuleKind.ProcMacro {
            give ModuleKindCategory.Library;
        }

        ModuleKind.Build {
            give ModuleKindCategory.Tooling;
        }

        ModuleKind.Package {
            give ModuleKindCategory.Tooling;
        }

        ModuleKind.Workspace {
            give ModuleKindCategory.Tooling;
        }

        ModuleKind.Prelude {
            give ModuleKindCategory.System;
        }

        ModuleKind.Runtime {
            give ModuleKindCategory.System;
        }

        ModuleKind.Stdlib {
            give ModuleKindCategory.System;
        }

        ModuleKind.Compiler {
            give ModuleKindCategory.System;
        }

        ModuleKind.Builtin {
            give ModuleKindCategory.System;
        }

        ModuleKind.Generated {
            give ModuleKindCategory.Synthetic;
        }

        ModuleKind.Virtual {
            give ModuleKindCategory.Synthetic;
        }

        ModuleKind.External {
            give ModuleKindCategory.External;
        }
    }
}

proc module_kind_artifact(
    kind: ModuleKind
) -> ModuleArtifactKind {
    pick kind {
        ModuleKind.Executable {
            give ModuleArtifactKind.Executable;
        }

        ModuleKind.Test {
            give ModuleArtifactKind.Executable;
        }

        ModuleKind.Benchmark {
            give ModuleArtifactKind.Executable;
        }

        ModuleKind.Example {
            give ModuleArtifactKind.Executable;
        }

        ModuleKind.Script {
            give ModuleArtifactKind.Executable;
        }

        ModuleKind.StaticLibrary {
            give ModuleArtifactKind.StaticLibrary;
        }

        ModuleKind.SharedLibrary {
            give ModuleArtifactKind.SharedLibrary;
        }

        ModuleKind.Plugin {
            give ModuleArtifactKind.SharedLibrary;
        }

        ModuleKind.ProcMacro {
            give ModuleArtifactKind.SharedLibrary;
        }

        ModuleKind.Object {
            give ModuleArtifactKind.Object;
        }

        ModuleKind.Interface {
            give ModuleArtifactKind.Interface;
        }

        ModuleKind.Header {
            give ModuleArtifactKind.Interface;
        }

        ModuleKind.Package {
            give ModuleArtifactKind.Metadata;
        }

        ModuleKind.Workspace {
            give ModuleArtifactKind.Metadata;
        }

        _ {
            give ModuleArtifactKind.None;
        }
    }
}

proc module_kind_entry_point_policy(
    kind: ModuleKind
) -> ModuleEntryPointPolicy {
    pick kind {
        ModuleKind.Executable {
            give ModuleEntryPointPolicy.Required;
        }

        ModuleKind.Test {
            give ModuleEntryPointPolicy.Optional;
        }

        ModuleKind.Benchmark {
            give ModuleEntryPointPolicy.Optional;
        }

        ModuleKind.Example {
            give ModuleEntryPointPolicy.Required;
        }

        ModuleKind.Script {
            give ModuleEntryPointPolicy.Required;
        }

        ModuleKind.Build {
            give ModuleEntryPointPolicy.Required;
        }

        _ {
            give ModuleEntryPointPolicy.Forbidden;
        }
    }
}

proc module_kind_is_source(
    kind: ModuleKind
) -> bool {
    give module_kind_category(kind)
        == ModuleKindCategory.Source;
}

proc module_kind_is_binary(
    kind: ModuleKind
) -> bool {
    give module_kind_category(kind)
        == ModuleKindCategory.Binary;
}

proc module_kind_is_library(
    kind: ModuleKind
) -> bool {
    give kind == ModuleKind.Library
        or kind == ModuleKind.StaticLibrary
        or kind == ModuleKind.SharedLibrary
        or kind == ModuleKind.Object
        or kind == ModuleKind.Plugin
        or kind == ModuleKind.ProcMacro;
}

proc module_kind_is_executable(
    kind: ModuleKind
) -> bool {
    give module_kind_artifact(kind)
        == ModuleArtifactKind.Executable;
}

proc module_kind_is_test(
    kind: ModuleKind
) -> bool {
    give kind == ModuleKind.Test;
}

proc module_kind_is_benchmark(
    kind: ModuleKind
) -> bool {
    give kind == ModuleKind.Benchmark;
}

proc module_kind_is_example(
    kind: ModuleKind
) -> bool {
    give kind == ModuleKind.Example;
}

proc module_kind_is_build_script(
    kind: ModuleKind
) -> bool {
    give kind == ModuleKind.Build;
}

proc module_kind_is_plugin(
    kind: ModuleKind
) -> bool {
    give kind == ModuleKind.Plugin
        or kind == ModuleKind.ProcMacro;
}

proc module_kind_is_system(
    kind: ModuleKind
) -> bool {
    give module_kind_category(kind)
        == ModuleKindCategory.System;
}

proc module_kind_is_synthetic(
    kind: ModuleKind
) -> bool {
    give module_kind_category(kind)
        == ModuleKindCategory.Synthetic;
}

proc module_kind_is_external(
    kind: ModuleKind
) -> bool {
    give kind == ModuleKind.External;
}

proc module_kind_is_container(
    kind: ModuleKind
) -> bool {
    give kind == ModuleKind.Package
        or kind == ModuleKind.Workspace
        or kind == ModuleKind.Virtual;
}

proc module_kind_is_compilable(
    kind: ModuleKind
) -> bool {
    give not module_kind_is_container(kind)
        and kind != ModuleKind.Header
        and kind != ModuleKind.External;
}

proc module_kind_is_linkable(
    kind: ModuleKind
) -> bool {
    give kind == ModuleKind.Executable
        or kind == ModuleKind.Test
        or kind == ModuleKind.Benchmark
        or kind == ModuleKind.Example
        or kind == ModuleKind.Script
        or kind == ModuleKind.StaticLibrary
        or kind == ModuleKind.SharedLibrary
        or kind == ModuleKind.Plugin
        or kind == ModuleKind.ProcMacro;
}

proc module_kind_is_importable(
    kind: ModuleKind
) -> bool {
    give kind != ModuleKind.Executable
        and kind != ModuleKind.Test
        and kind != ModuleKind.Benchmark
        and kind != ModuleKind.Example
        and kind != ModuleKind.Script
        and kind != ModuleKind.Build
        and kind != ModuleKind.Workspace;
}

proc module_kind_is_publishable(
    kind: ModuleKind
) -> bool {
    give kind == ModuleKind.Library
        or kind == ModuleKind.StaticLibrary
        or kind == ModuleKind.SharedLibrary
        or kind == ModuleKind.Plugin
        or kind == ModuleKind.ProcMacro
        or kind == ModuleKind.Executable
        or kind == ModuleKind.Package;
}

proc module_kind_is_testable(
    kind: ModuleKind
) -> bool {
    give kind != ModuleKind.External
        and kind != ModuleKind.Virtual
        and kind != ModuleKind.Workspace
        and kind != ModuleKind.Header;
}

proc module_kind_requires_entry_point(
    kind: ModuleKind
) -> bool {
    give module_kind_entry_point_policy(kind)
        == ModuleEntryPointPolicy.Required;
}

proc module_kind_allows_entry_point(
    kind: ModuleKind
) -> bool {
    give module_kind_entry_point_policy(kind)
        != ModuleEntryPointPolicy.Forbidden;
}

proc module_kind_profile(
    kind: ModuleKind
) -> ModuleKindProfile {
    give ModuleKindProfile {
        kind: kind,
        category: module_kind_category(kind),
        artifact: module_kind_artifact(kind),
        entry_point: module_kind_entry_point_policy(kind),

        compilable: module_kind_is_compilable(kind),
        linkable: module_kind_is_linkable(kind),
        executable: module_kind_is_executable(kind),
        importable: module_kind_is_importable(kind),
        publishable: module_kind_is_publishable(kind),
        testable: module_kind_is_testable(kind),

        synthetic: module_kind_is_synthetic(kind),
        system: module_kind_is_system(kind),
        external: module_kind_is_external(kind)
    };
}

proc module_kind_name(
    kind: ModuleKind
) -> string {
    pick kind {
        ModuleKind.Source {
            give "source";
        }

        ModuleKind.Library {
            give "library";
        }

        ModuleKind.Executable {
            give "executable";
        }

        ModuleKind.Test {
            give "test";
        }

        ModuleKind.Benchmark {
            give "benchmark";
        }

        ModuleKind.Example {
            give "example";
        }

        ModuleKind.Build {
            give "build";
        }

        ModuleKind.Script {
            give "script";
        }

        ModuleKind.Plugin {
            give "plugin";
        }

        ModuleKind.ProcMacro {
            give "proc-macro";
        }

        ModuleKind.StaticLibrary {
            give "static-library";
        }

        ModuleKind.SharedLibrary {
            give "shared-library";
        }

        ModuleKind.Object {
            give "object";
        }

        ModuleKind.Interface {
            give "interface";
        }

        ModuleKind.Header {
            give "header";
        }

        ModuleKind.Package {
            give "package";
        }

        ModuleKind.Workspace {
            give "workspace";
        }

        ModuleKind.Prelude {
            give "prelude";
        }

        ModuleKind.Runtime {
            give "runtime";
        }

        ModuleKind.Stdlib {
            give "stdlib";
        }

        ModuleKind.Compiler {
            give "compiler";
        }

        ModuleKind.Builtin {
            give "builtin";
        }

        ModuleKind.Generated {
            give "generated";
        }

        ModuleKind.External {
            give "external";
        }

        ModuleKind.Virtual {
            give "virtual";
        }
    }
}

