proc module_kind_from_string(
    value: string
) -> ModuleKindResult {
    if len(value) == 0 {
        give module_kind_result_error(
            ModuleKindError.EmptyName,
            "module kind must not be empty"
        );
    }

    if value == "source" {
        give module_kind_result_ok(ModuleKind.Source);
    }

    if value == "library" or value == "lib" {
        give module_kind_result_ok(ModuleKind.Library);
    }

    if value == "executable" or value == "binary"
        or value == "bin"
    {
        give module_kind_result_ok(ModuleKind.Executable);
    }

    if value == "test" {
        give module_kind_result_ok(ModuleKind.Test);
    }

    if value == "benchmark" or value == "bench" {
        give module_kind_result_ok(ModuleKind.Benchmark);
    }

    if value == "example" {
        give module_kind_result_ok(ModuleKind.Example);
    }

    if value == "build" or value == "build-script" {
        give module_kind_result_ok(ModuleKind.Build);
    }

    if value == "script" {
        give module_kind_result_ok(ModuleKind.Script);
    }

    if value == "plugin" {
        give module_kind_result_ok(ModuleKind.Plugin);
    }

    if value == "proc-macro" or value == "proc_macro" {
        give module_kind_result_ok(ModuleKind.ProcMacro);
    }

    if value == "static-library" or value == "staticlib" {
        give module_kind_result_ok(ModuleKind.StaticLibrary);
    }

    if value == "shared-library" or value == "sharedlib"
        or value == "dylib"
    {
        give module_kind_result_ok(ModuleKind.SharedLibrary);
    }

    if value == "object" or value == "obj" {
        give module_kind_result_ok(ModuleKind.Object);
    }

    if value == "interface" {
        give module_kind_result_ok(ModuleKind.Interface);
    }

    if value == "header" {
        give module_kind_result_ok(ModuleKind.Header);
    }

    if value == "package" {
        give module_kind_result_ok(ModuleKind.Package);
    }

    if value == "workspace" {
        give module_kind_result_ok(ModuleKind.Workspace);
    }

    if value == "prelude" {
        give module_kind_result_ok(ModuleKind.Prelude);
    }

    if value == "runtime" {
        give module_kind_result_ok(ModuleKind.Runtime);
    }

    if value == "stdlib" or value == "standard-library" {
        give module_kind_result_ok(ModuleKind.Stdlib);
    }

    if value == "compiler" {
        give module_kind_result_ok(ModuleKind.Compiler);
    }

    if value == "builtin" {
        give module_kind_result_ok(ModuleKind.Builtin);
    }

    if value == "generated" {
        give module_kind_result_ok(ModuleKind.Generated);
    }

    if value == "external" {
        give module_kind_result_ok(ModuleKind.External);
    }

    if value == "virtual" {
        give module_kind_result_ok(ModuleKind.Virtual);
    }

    give module_kind_result_error(
        ModuleKindError.UnknownKind,
        "unknown module kind: " + value
    );
}

proc module_kind_validate_entry_point(
    kind: ModuleKind,
    has_entry_point: bool
) -> ModuleKindError {
    let policy = module_kind_entry_point_policy(kind);

    if policy == ModuleEntryPointPolicy.Required
        and not has_entry_point
    {
        give ModuleKindError.InvalidEntryPoint;
    }

    if policy == ModuleEntryPointPolicy.Forbidden
        and has_entry_point
    {
        give ModuleKindError.InvalidEntryPoint;
    }

    give ModuleKindError.None;
}

proc module_kind_validate_artifact(
    kind: ModuleKind,
    artifact: ModuleArtifactKind
) -> ModuleKindError {
    let expected = module_kind_artifact(kind);

    if expected == ModuleArtifactKind.None {
        if artifact != ModuleArtifactKind.None
            and artifact != ModuleArtifactKind.Metadata
        {
            give ModuleKindError.UnsupportedArtifact;
        }

        give ModuleKindError.None;
    }

    if expected != artifact {
        give ModuleKindError.UnsupportedArtifact;
    }

    give ModuleKindError.None;
}

proc module_kind_error_code(
    error: ModuleKindError
) -> string {
    pick error {
        ModuleKindError.None {
            give "";
        }

        ModuleKindError.EmptyName {
            give "E_MODULE_KIND_EMPTY";
        }

        ModuleKindError.UnknownKind {
            give "E_MODULE_KIND_UNKNOWN";
        }

        ModuleKindError.UnsupportedArtifact {
            give "E_MODULE_KIND_ARTIFACT";
        }

        ModuleKindError.InvalidEntryPoint {
            give "E_MODULE_KIND_ENTRY_POINT";
        }

        ModuleKindError.InvalidCombination {
            give "E_MODULE_KIND_COMBINATION";
        }
    }
}
