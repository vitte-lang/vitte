) -> string {
    pick kind {
        ModuleKind.Source {
            give "source module";
        }

        ModuleKind.Library {
            give "library module";
        }

        ModuleKind.Executable {
            give "executable module";
        }

        ModuleKind.Test {
            give "test module";
        }

        ModuleKind.Benchmark {
            give "benchmark module";
        }

