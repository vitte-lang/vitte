proc scope_lookup_result_is_found(
    result: ScopeLookupResult
) -> bool {
    give result.state
        == ScopeLookupState.Found;
}

proc scope_lookup_result_is_missing(
    result: ScopeLookupResult
) -> bool {
    give result.state
        == ScopeLookupState.Missing;
}

proc scope_lookup_result_is_ambiguous(
    result: ScopeLookupResult
) -> bool {
    give result.state
        == ScopeLookupState.Ambiguous;
}

proc scope_lookup_result_definition(
    result: ScopeLookupResult
) -> Option<DefId> {
    pick result.candidate {
        None {
            give None;
        }

        Some(candidate) {
            pick candidate.source {
                ScopeLookupSource.Binding {
                    pick candidate.binding {
                        Some(value) {
                            give value.definition;
                        }

                        None {
                            give None;
                        }
                    }
                }

                ScopeLookupSource.Generic {
                    pick candidate.generic {
                        Some(value) {
                            give Some(
                                value.definition
                            );
                        }

                        None {
                            give None;
                        }
                    }
                }

                ScopeLookupSource.Import {
                    pick candidate.import {
                        Some(value) {
                            give value.definition;
                        }

                        None {
                            give None;
                        }
                    }
                }
            }
        }
    }

    give None;
}

proc scope_lookup_result_symbol(
    result: ScopeLookupResult
) -> Option<SymbolId> {
    pick result.candidate {
        None {
            give None;
        }

        Some(candidate) {
            pick candidate.source {
                ScopeLookupSource.Binding {
                    pick candidate.binding {
                        Some(value) {
                            give value.symbol;
                        }

                        None {
                            give None;
                        }
                    }
                }

                ScopeLookupSource.Import {
                    pick candidate.import {
                        Some(value) {
                            give value.symbol;
                        }

                        None {
                            give None;
                        }
                    }
                }

                ScopeLookupSource.Generic {
                    give None;
                }
            }
        }
    }

    give None;
}

proc scope_lookup_result_type(
    result: ScopeLookupResult
) -> Option<TypeId> {
    pick result.candidate {
        None {
            give None;
        }

        Some(candidate) {
            pick candidate.source {
                ScopeLookupSource.Binding {
                    pick candidate.binding {
                        Some(value) {
                            give value.type_id;
                        }

                        None {
                            give None;
                        }
                    }
                }

                ScopeLookupSource.Generic {
                    pick candidate.generic {
                        Some(value) {
                            give value.type_id;
                        }

                        None {
                            give None;
                        }
                    }
                }

                ScopeLookupSource.Import {
                    pick candidate.import {
                        Some(value) {
                            give value.type_id;
                        }

                        None {
                            give None;
                        }
                    }
                }
            }
        }
    }

    give None;
}

proc scope_lookup_reset_statistics(
    lookup: ref mut ScopeLookup
) {
    set lookup.statistics =
        scope_lookup_statistics_empty();
}

proc scope_lookup_statistics(
    lookup: ref ScopeLookup
) -> ScopeLookupStatistics {
    give lookup.statistics;
}

// lexical lookup
//
// current ScopeId
//      |
//      v
// bindings / generics / imports
//      |
//      +-- found unique candidate
//      |       |
//      |       v
//      |   ScopeLookupResult.Found
//      |
//      +-- several equivalent candidates
//      |       |
//      |       v
//      |   ScopeLookupResult.Ambiguous
//      |
//      +-- nothing found
//              |
//              v
//          parent scope
//              |
//              v
//          repeat lookup
//
// scope_lookup.vit
//     = lexical scope traversal
//
// resolution/lookup.vit
//     = higher-level semantic lookup and candidate resolution
