        builder,
        name,
        ScopeBindingKind.Procedure,
        definition
    );
}

proc scope_builder_bind_constant(
    builder: ref mut ScopeBuilder,
    name: string,
    definition: DefId,
    type_id: Option<TypeId>
) -> ScopeBindingError {
    let binding =
        scope_builder_make_binding(
            ref builder,
            name,
            ScopeBindingKind.Constant
        );

    pick binding {
