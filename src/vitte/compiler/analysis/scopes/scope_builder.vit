            );
        }
    }
}

proc scope_builder_invalidate_current(
    builder: ref mut ScopeBuilder
) -> usize {
    let current =
        scope_builder_current(
            ref builder
        );

    pick current {
        None {
            give 0;
        }

        Some(scope) {
            let bindings =
                scope_binding_table_invalidate_scope(
                    ref mut builder.bindings,
                    scope
                );

            let mut blocks: usize = 0;

            if builder.config.track_blocks {
                set blocks =
                    scope_block_table_invalidate_tree(
                        ref mut builder.blocks,
                        scope
                    );
            }

            let count =
                bindings + blocks;

            set builder.statistics.invalidations =
                builder.statistics.invalidations
                + count;

            give count;
        }
    }
}

proc scope_builder_finish(
    builder: ref mut ScopeBuilder
) -> bool {
    while not scope_builder_is_empty(
        ref builder
    ) {
        scope_builder_leave(
            builder
        );
    }

    if builder.state
        == ScopeBuilderState.Failed
    {
        give false;
    }

    set builder.state =
        ScopeBuilderState.Complete;

    give true;
}

proc scope_builder_advance_generation(
    builder: ref mut ScopeBuilder
) -> u64 {
    set builder.generation =
        builder.generation + 1;

    set builder.blocks.generation =
        builder.blocks.generation + 1;

    set builder.bindings.generation =
        builder.bindings.generation + 1;

    give builder.generation;
}

proc scope_builder_reset(
    builder: ref mut ScopeBuilder
) {
    set builder.blocks =
        scope_block_table_create();

    set builder.bindings =
        scope_binding_table_create();

    set builder.stack = [];

    set builder.next_scope_id = 1;

    set builder.generation =
        builder.generation + 1;

    set builder.state =
        ScopeBuilderState.Created;
}

proc scope_builder_statistics(
    builder: ref ScopeBuilder
) -> ScopeBuilderStatistics {
    give builder.statistics;
}

proc scope_builder_reset_statistics(
    builder: ref mut ScopeBuilder
) {
    set builder.statistics =
        scope_builder_statistics_empty();
}

proc scope_builder_state_name(
    state: ScopeBuilderState
) -> string {
    pick state {
        ScopeBuilderState.Created {
            give "created";
        }

        ScopeBuilderState.Building {
            give "building";
        }

        ScopeBuilderState.Complete {
            give "complete";
        }

        ScopeBuilderState.Failed {
            give "failed";
        }
    }

    give "failed";
}
