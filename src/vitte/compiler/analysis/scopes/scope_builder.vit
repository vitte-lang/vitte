proc scope_builder_bind_generic(
    builder: ref mut ScopeBuilder,
    name: string,
    definition: DefId
) -> ScopeBindingError {
    give scope_builder_bind_definition(
        builder,
        name,
        ScopeBindingKind.Generic,
        definition
    );
}

