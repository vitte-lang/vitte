space vitte/compiler/driver

export *

use vitte/compiler/driver/commands
use vitte/compiler/driver/exit_status
use vitte/compiler/driver/compile.{ DriverCompileConfig, DriverModuleInput }
use vitte/compiler/driver/result.{ CliReportResult, CliRunResult }
use vitte/compiler/driver/cli.{ run_check_diagnostics_json_cli as cli_run_check_diagnostics_json, run_check_hir_json_cli as cli_run_check_hir_json, run_check_mir_json_cli as cli_run_check_mir_json, run_parse_ast_json_cli as cli_run_parse_ast_json }
use vitte/compiler/driver/pipeline.{ main_driver as pipeline_main_driver, main_driver_report_json as pipeline_main_driver_report_json, main_driver_report_json_with_config as pipeline_main_driver_report_json_with_config, main_driver_set as pipeline_main_driver_set, main_driver_set_report_json as pipeline_main_driver_set_report_json, main_driver_set_report_json_with_config as pipeline_main_driver_set_report_json_with_config, main_driver_set_with_config as pipeline_main_driver_set_with_config, main_driver_surface_report_json as pipeline_main_driver_surface_report_json, main_driver_surface_report_json_from_args as pipeline_main_driver_surface_report_json_from_args, main_driver_surface_report_json_from_args_with_config as pipeline_main_driver_surface_report_json_from_args_with_config, main_driver_surface_report_json_with_config as pipeline_main_driver_surface_report_json_with_config, main_driver_with_config as pipeline_main_driver_with_config }
use vitte/compiler/driver/integration_registry.{ compiler_critical_modules as integration_compiler_critical_modules }

proc main_driver(command_name: string, source_path: string, source_text: string) -> CliRunResult {
    give pipeline_main_driver(command_name, source_path, source_text);
}

proc main_driver_with_config(command_name: string, source_path: string, source_text: string, config: DriverCompileConfig) -> CliRunResult {
    give pipeline_main_driver_with_config(command_name, source_path, source_text, config);
}

proc main_driver_report_json(command_name: string, source_path: string, source_text: string) -> string {
    give pipeline_main_driver_report_json(command_name, source_path, source_text);
}

proc main_driver_report_json_with_config(command_name: string, source_path: string, source_text: string, config: DriverCompileConfig) -> string {
    give pipeline_main_driver_report_json_with_config(command_name, source_path, source_text, config);
}

proc main_driver_surface_report_json(command_name: string, dump_flag: string, source_path: string, source_text: string) -> CliReportResult {
    give pipeline_main_driver_surface_report_json(command_name, dump_flag, source_path, source_text);
}

proc main_driver_surface_report_json_with_config(command_name: string, dump_flag: string, source_path: string, source_text: string, config: DriverCompileConfig) -> CliReportResult {
    give pipeline_main_driver_surface_report_json_with_config(command_name, dump_flag, source_path, source_text, config);
}

proc main_driver_surface_report_json_from_args(command_name: string, args: [string], source_path: string, source_text: string) -> CliReportResult {
    give pipeline_main_driver_surface_report_json_from_args(command_name, args, source_path, source_text);
}

proc main_driver_surface_report_json_from_args_with_config(command_name: string, args: [string], source_path: string, source_text: string, config: DriverCompileConfig) -> CliReportResult {
    give pipeline_main_driver_surface_report_json_from_args_with_config(command_name, args, source_path, source_text, config);
}

proc main_driver_set(command_name: string, inputs: [DriverModuleInput]) -> CliRunResult {
    give pipeline_main_driver_set(command_name, inputs);
}

proc main_driver_set_with_config(command_name: string, inputs: [DriverModuleInput], config: DriverCompileConfig) -> CliRunResult {
    give pipeline_main_driver_set_with_config(command_name, inputs, config);
}

proc main_driver_set_report_json(command_name: string, inputs: [DriverModuleInput]) -> string {
    give pipeline_main_driver_set_report_json(command_name, inputs);
}

proc main_driver_set_report_json_with_config(command_name: string, inputs: [DriverModuleInput], config: DriverCompileConfig) -> string {
    give pipeline_main_driver_set_report_json_with_config(command_name, inputs, config);
}

proc run_parse_ast_json_cli(source_path: string, source_text: string) -> CliReportResult {
    give cli_run_parse_ast_json(source_path, source_text);
}

proc run_check_hir_json_cli(source_path: string, source_text: string) -> CliReportResult {
    give cli_run_check_hir_json(source_path, source_text);
}

proc run_check_mir_json_cli(source_path: string, source_text: string) -> CliReportResult {
    give cli_run_check_mir_json(source_path, source_text);
}

proc run_check_diagnostics_json_cli(source_path: string, source_text: string) -> CliReportResult {
    give cli_run_check_diagnostics_json(source_path, source_text);
}

proc compiler_critical_modules() -> [string] {
    give integration_compiler_critical_modules();
}
