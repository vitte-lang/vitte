space vitte/compiler/backends/llvm_bindings

proc string(value: u64) -> string {
  if value == 0 {
    give "0";
  }
  let digit: u64 = value % 10;
  let digit_text: string = if digit == 0 { "0" } elif digit == 1 { "1" } elif digit == 2 { "2" } elif digit == 3 { "3" } elif digit == 4 { "4" } elif digit == 5 { "5" } elif digit == 6 { "6" } elif digit == 7 { "7" } elif digit == 8 { "8" } else { "9" };
  let prefix: u64 = value / 10 as u64;
  if prefix == 0 {
    give digit_text;
  }
  give string(prefix) + digit_text;
}

proc contains(text: string, needle: string) -> bool {
  give find(text, needle) >= 0;
}

export *

use vitte/compiler/backend/ir/ir.{ IrBlock, IrFunction, IrInstruction, IrInstructionKind, IrLinkage, IrModule, IrModuleKind, IrNominalType, IrTarget, IrUnit, IrValue, IrValueKind, instruction_create, value_place, target_native_x86_64_linux, unit_is_valid }
use vitte/compiler/backend/target/layout.{ TargetLayout, TypeLayout, target_layout_for, type_layout_for_name }
use vitte/compiler/backend/target/triple.{ triple_text }
use vitte/compiler/analysis/typeck/unify.{ unify_integer_types }
use vitte/compiler/analysis/typeck/traits.{ type_is_integer }
use vitte/stdlib/io/fileops.{ append_file, read_file, write_file }
use vitte/stdlib/io/host_runtime.{ host_memory_checkpoint, host_memory_rewind }

pick LlvmDiagnosticLevel {
  Note,
  Warning,
  Error,
}

pick LlvmSectionKind {
  Text,
  SymbolTable,
  StringTable,
  Relocation,
  Debug,
  Metadata,
}

form LlvmDiagnostic {
  level: LlvmDiagnosticLevel
  code: string
  message: string
  stage: string
  valid: bool
}

form LlvmBuildOptions {
  target: string
  opt_level: string
  packaging: string
  deterministic: bool
  debug_enabled: bool
  emit_debug_sections: bool
  lto_enabled: bool
  pgo_mode: string
  prefer_native_toolchain: bool
  valid: bool
}

form LlvmToolchainPaths {
  clang_path: string
  lld_path: string
  llvm_as_path: string
  llc_path: string
  llvm_mc_path: string
  ar_path: string
  valid: bool
}

form LlvmToolchainStatus {
  native_object_ready: bool
  native_link_ready: bool
  missing_tools: [string]
  summary: string
  valid: bool
}

form LlvmObjectSection {
  id: u64
  name: string
  kind: LlvmSectionKind
  alignment: u64
  offset: u64
  size: u64
  content: string
  valid: bool
}

form LlvmObjectSymbol {
  id: u64
  name: string
  section_id: u64
  offset: u64
  size: u64
  global: bool
  defined: bool
  valid: bool
}

form LlvmObjectRelocation {
  id: u64
  section_id: u64
  offset: u64
  kind: string
  target_symbol: string
  addend: int
  resolved: bool
  valid: bool
}

form LlvmObjectResult {
  target: string
  object_format: string
  ir_text: string
  object_text: string
  sections: [LlvmObjectSection]
  symbols: [LlvmObjectSymbol]
  relocations: [LlvmObjectRelocation]
  diagnostics: [LlvmDiagnostic]
  module_count: u64
  function_count: u64
  valid: bool
}

form LlvmBindingResult {
  target: string
  ir_text: string
  module_count: u64
  function_count: u64
  valid: bool
}

form LlvmStringGlobalSet {
  names: [string]
  lines: [string]
}

form LlvmStringGlobalValues {
  ids: [u64]
  values: [IrValue]
}

proc supported_opt_levels() -> string {
  give "O0,O1,O2,O3,Os,Oz";
}

proc llvm_eq() -> string {
  give slice("a=b", 1, 2);
}

proc llvm_kv(key: string, value: string) -> string {
  give key + llvm_eq() + value;
}

proc canonical_backend_surface() -> string {
  give "src/vitte/compiler/backend/" + "*";
}

proc emit_llvm_ir_from_mir() -> string {
  give "llvm adapter consumes canonical IR lowering";
}

proc debug_info_format() -> string {
  give "dwarf";
}

proc pgo_enabled() -> string {
  give "false";
}

proc emit_debug_info() -> string {
  give "emit_debug_info via llvm adapter";
}

proc emit_pgo_instrumentation() -> string {
  give "emit_pgo_instrumentation unavailable in adapter mode";
}

proc llvm_diagnostic(level: LlvmDiagnosticLevel, code: string, message: string, stage: string) -> LlvmDiagnostic {
  give LlvmDiagnostic {
    level: level,
    code: code,
    message: message,
    stage: stage,
    valid: code != "" and message != "" and stage != ""
  };
}

proc llvm_toolchain_paths(clang_path: string, lld_path: string, llvm_as_path: string, llc_path: string, llvm_mc_path: string, ar_path: string) -> LlvmToolchainPaths {
  give LlvmToolchainPaths {
    clang_path: clang_path,
    lld_path: lld_path,
    llvm_as_path: llvm_as_path,
    llc_path: llc_path,
    llvm_mc_path: llvm_mc_path,
    ar_path: ar_path,
    valid: clang_path != "" or lld_path != "" or ar_path != ""
  };
}

proc default_llvm_toolchain_paths() -> LlvmToolchainPaths {
  give llvm_toolchain_paths("", "", "", "", "", "");
}

proc llvm_build_options(target: string, opt_level: string, packaging: string, deterministic: bool, debug_enabled: bool, emit_debug_sections: bool, lto_enabled: bool, pgo_mode: string, prefer_native_toolchain: bool) -> LlvmBuildOptions {
  give LlvmBuildOptions {
    target: target,
    opt_level: opt_level,
    packaging: packaging,
    deterministic: deterministic,
    debug_enabled: debug_enabled,
    emit_debug_sections: emit_debug_sections,
    lto_enabled: lto_enabled,
    pgo_mode: pgo_mode,
    prefer_native_toolchain: prefer_native_toolchain,
    valid: target != "" and opt_level != "" and packaging != ""
  };
}

proc default_llvm_build_options(target: string) -> LlvmBuildOptions {
  give llvm_build_options(target, "O2", "executable", true, true, true, false, "off", false);
}

proc llvm_toolchain_status(paths: LlvmToolchainPaths, packaging: string, prefer_native_toolchain: bool) -> LlvmToolchainStatus {
  let missing_tools: [string] = [];
  let built: [string] = missing_tools;
  if prefer_native_toolchain and paths.clang_path == "" {
    set built = built + ["clang"];
  }
  if prefer_native_toolchain and packaging == "executable" and paths.lld_path == "" {
    set built = built + ["ld.lld"];
  }
  if prefer_native_toolchain and packaging == "shared-library" and paths.lld_path == "" {
    set built = built + ["ld.lld"];
  }
  if prefer_native_toolchain and packaging == "static-library" and paths.ar_path == "" {
    set built = built + ["ar"];
  }
  let native_object_ready: bool = paths.clang_path != "";
  let native_link_ready: bool = if packaging == "object" {
    native_object_ready
  } elif packaging == "static-library" {
    native_object_ready and paths.ar_path != ""
  } else {
    native_object_ready and paths.lld_path != ""
  };
  let summary: string = if not prefer_native_toolchain {
    "native llvm toolchain not requested"
  } elif len(built) == 0 {
    "native llvm toolchain ready"
  } else {
    "missing llvm native tools: " + built[0]
  };
  give LlvmToolchainStatus {
    native_object_ready: native_object_ready,
    native_link_ready: native_link_ready,
    missing_tools: built,
    summary: summary,
    valid: not prefer_native_toolchain or len(built) == 0
  };
}

proc llvm_type_for_value_text(text: string) -> string {
  if text == "true" or text == "false" {
    give "i1";
  }
  give "i64";
}

proc llvm_alignment_for_type(module0: IrModule, type_name: string) -> u64 {
  let target_layout: TargetLayout = target_layout_for(module0.target.triple);
  let value_layout: TypeLayout = type_layout_for_name(target_layout, type_name);
  if value_layout.valid {
    give value_layout.alignment;
  }
  give target_layout.pointer_alignment;
}

proc llvm_operand_text(instruction: IrInstruction) -> string {
  if len(instruction.args) == 0 {
    give "0";
  }
  let value = instruction.args[0];
  give llvm_value_text(value);
}

proc llvm_type_for_param(type_name: string, borrowed: bool) -> string {
  let base: string = if type_name == "bool" {
    "i1"
  } elif type_name == "char" or type_name == "i32" or type_name == "u32" {
    "i32"
  } elif type_name == "i8" or type_name == "u8" {
    "i8"
  } elif type_name == "i16" or type_name == "u16" {
    "i16"
  } elif type_name == "f32" {
    "float"
  } elif type_name == "f64" or type_name == "float" {
    "double"
  } elif type_name == "string" {
    "i8*"
  } elif type_name == "void" or type_name == "unit" or type_name == "never" {
    "void"
  } else {
    "i64"
  };
  if borrowed {
    give base + "*";
  }
  give base;
}

proc llvm_sanitize_type_name(name: string) -> string {
  let out: string = "";
  let i: u64 = 0;
  while i < len(name) {
    let ch: string = slice(name, i, i + 1);
    let valid: bool = (ch >= "a" and ch <= "z")
      or (ch >= "A" and ch <= "Z")
      or (ch >= "0" and ch <= "9")
      or ch == "_";
    set out = out + if valid { ch } else { "_" };
    set i = i + 1;
  }
  if out != "" { give out; }
  give "anonymous";
}

proc llvm_module_nominal(module0: IrModule, name: string) -> IrNominalType {
  let i: u64 = 0;
  while i < len(module0.nominal_types) {
    if module0.nominal_types[i].name == name {
      give module0.nominal_types[i];
    }
    set i = i + 1;
  }
  give llvm_invalid_nominal();
}

proc llvm_type_for_name(module0: IrModule, type_name: string, borrowed: bool) -> string {
  let nominal: IrNominalType = llvm_module_nominal(module0, type_name);
  let base: string = if nominal.valid and nominal.kind != "bits" and nominal.kind != "flags" {
    "%" + llvm_sanitize_type_name(type_name)
  } elif nominal.valid and (nominal.kind == "bits" or nominal.kind == "flags") {
    llvm_type_for_param(if nominal.underlying_type != "" { nominal.underlying_type } else { "u64" }, false)
  } elif type_name == "array" or type_name == "tuple" or type_name == "aggregate"
    or (starts_with(type_name, "[") and ends_with(type_name, "]"))
    or (starts_with(type_name, "(") and ends_with(type_name, ")")) {
    "%VitteAggregate"
  } else {
    llvm_type_for_param(type_name, false)
  };
  if borrowed {
    give base + "*";
  }
  give base;
}

proc llvm_is_string_literal(text: string) -> bool {
  if len(text) < 2 {
    give false;
  }
  give slice(text, 0, 1) == "\"" and slice(text, len(text) - 1, len(text)) == "\"";
}

proc llvm_string_payload(literal: string) -> string {
  if not llvm_is_string_literal(literal) {
    give literal;
  }
  give slice(literal, 1, len(literal) - 1);
}

proc llvm_string_global_name(value: IrValue) -> string {
  give "@.vitte.str." + string(value.id);
}

proc llvm_known_escape_size(next: string) -> u64 {
  if next == "n" or next == "r" or next == "t" or next == "\"" or next == "\\" or next == "0" {
    give 1;
  }
  give 2;
}

proc llvm_string_payload_size(payload: string) -> u64 {
  let size: u64 = 0;
  let i: u64 = 0;
  while i < len(payload) {
    let ch: string = slice(payload, i, i + 1);
    if ch == "\\" and i + 1 < len(payload) {
      let next: string = slice(payload, i + 1, i + 2);
      set size = size + llvm_known_escape_size(next);
      set i = i + 2;
      continue;
    }
    set size = size + 1;
    set i = i + 1;
  }
  give size;
}

proc llvm_escape_sequence_text(next: string) -> string {
  if next == "n" {
    give "\\0A";
  }
  if next == "r" {
    give "\\0D";
  }
  if next == "t" {
    give "\\09";
  }
  if next == "\"" {
    give "\\22";
  }
  if next == "\\" {
    give "\\5C";
  }
  if next == "0" {
    give "\\00";
  }
  give "\\5C" + next;
}

proc llvm_c_string_payload(payload: string) -> string {
  let out: string = "";
  let i: u64 = 0;
  while i < len(payload) {
    let ch: string = slice(payload, i, i + 1);
    if ch == "\\" and i + 1 < len(payload) {
      set out = out + llvm_escape_sequence_text(slice(payload, i + 1, i + 2));
      set i = i + 2;
      continue;
    }
    if ch == "\"" {
      set out = out + "\\22";
    } elif ch == "\\" {
      set out = out + "\\5C";
    } else {
      set out = out + ch;
    }
    set i = i + 1;
  }
  give out;
}

proc llvm_string_literal_size(literal: string) -> u64 {
  give llvm_string_payload_size(llvm_string_payload(literal)) + 1;
}

proc llvm_string_pointer_expr(value: IrValue) -> string {
  let size_text: string = string(llvm_string_literal_size(value.constant));
  let name: string = llvm_string_global_name(value);
  give "getelementptr inbounds ([" + size_text + " x i8], [" + size_text + " x i8]* " + name + ", i64 0, i64 0)";
}

proc llvm_string_global_line(value: IrValue) -> string {
  let payload: string = llvm_string_payload(value.constant);
  let size_text: string = string(llvm_string_literal_size(value.constant));
  give llvm_string_global_name(value) + " = private unnamed_addr constant [" + size_text + " x i8] c\"" + llvm_c_string_payload(payload) + "\\00\", align 1";
}

proc llvm_string_global_set_empty() -> LlvmStringGlobalSet {
  give LlvmStringGlobalSet { names: [], lines: [] };
}

proc llvm_string_global_seen(names: [string], name: string) -> bool {
  let i: u64 = 0;
  while i < len(names) {
    if names[i] == name {
      give true;
    }
    set i = i + 1;
  }
  give false;
}

proc llvm_string_global_set_add_value(set0: LlvmStringGlobalSet, value: IrValue) -> LlvmStringGlobalSet {
  if value.type_name != "string" or not llvm_is_string_literal(value.constant) {
    give set0;
  }
  let name: string = llvm_string_global_name(value);
  if llvm_string_global_seen(set0.names, name) {
    give set0;
  }
  give LlvmStringGlobalSet {
    names: set0.names + [name],
    lines: set0.lines + [llvm_string_global_line(value)]
  };
}

proc llvm_string_globals_for_instruction(set0: LlvmStringGlobalSet, instruction: IrInstruction) -> LlvmStringGlobalSet {
  let built: LlvmStringGlobalSet = set0;
  let i: u64 = 0;
  while i < len(instruction.args) {
    set built = llvm_string_global_set_add_value(built, instruction.args[i]);
    set i = i + 1;
  }
  give built;
}

proc llvm_string_globals_for_block(set0: LlvmStringGlobalSet, block: IrBlock) -> LlvmStringGlobalSet {
  let built: LlvmStringGlobalSet = set0;
  let i: u64 = 0;
  while i < len(block.instructions) {
    set built = llvm_string_globals_for_instruction(built, block.instructions[i]);
    set i = i + 1;
  }
  give llvm_string_globals_for_instruction(built, block.terminator);
}

proc llvm_string_globals_for_function(set0: LlvmStringGlobalSet, fn0: IrFunction) -> LlvmStringGlobalSet {
  let built: LlvmStringGlobalSet = set0;
  let i: u64 = 0;
  while i < len(fn0.blocks) {
    set built = llvm_string_globals_for_block(built, fn0.blocks[i]);
    set i = i + 1;
  }
  give built;
}

proc llvm_string_globals_for_module(module0: IrModule) -> [string] {
  let built: LlvmStringGlobalSet = llvm_string_global_set_empty();
  let i: u64 = 0;
  while i < len(module0.functions) {
    set built = llvm_string_globals_for_function(built, module0.functions[i]);
    set i = i + 1;
  }
  give built.lines;
}

proc llvm_string_global_id_seen(ids: [u64], id: u64) -> bool {
  let i: u64 = 0;
  while i < len(ids) {
    if ids[i] == id {
      give true;
    }
    set i = i + 1;
  }
  give false;
}

proc llvm_string_global_values_add(set0: LlvmStringGlobalValues, value: IrValue) -> LlvmStringGlobalValues {
  let built: LlvmStringGlobalValues = set0;
  if value.type_name == "string" and llvm_is_string_literal(value.constant) and not llvm_string_global_id_seen(built.ids, value.id) {
    set built.ids = built.ids + [value.id];
    set built.values = built.values + [value];
  }
  give built;
}

proc llvm_string_global_values_for_instruction(set0: LlvmStringGlobalValues, instruction: IrInstruction) -> LlvmStringGlobalValues {
  let built: LlvmStringGlobalValues = set0;
  let i: u64 = 0;
  while i < len(instruction.args) {
    set built = llvm_string_global_values_add(built, instruction.args[i]);
    set i = i + 1;
  }
  give built;
}

proc llvm_string_global_values_for_module(module0: IrModule) -> LlvmStringGlobalValues {
  let built: LlvmStringGlobalValues = LlvmStringGlobalValues { ids: [], values: [] };
  let i: u64 = 0;
  while i < len(module0.functions) {
    let j: u64 = 0;
    while j < len(module0.functions[i].blocks) {
      let block: IrBlock = module0.functions[i].blocks[j];
      let k: u64 = 0;
      while k < len(block.instructions) {
        set built = llvm_string_global_values_for_instruction(built, block.instructions[k]);
        set k = k + 1;
      }
      set built = llvm_string_global_values_for_instruction(built, block.terminator);
      set j = j + 1;
    }
    set i = i + 1;
  }
  give built;
}

proc llvm_value_text(value: IrValue) -> string {
  if value.type_name == "string" and llvm_is_string_literal(value.constant) {
    give llvm_string_pointer_expr(value);
  }
  if value.constant != "" {
    give value.constant;
  }
  if value.name != "" {
    give "%" + value.name;
  }
  if value.text != "" {
    give value.text;
  }
  give "0";
}

proc llvm_call_arg_text(module0: IrModule, instruction: IrInstruction, index: u64) -> string {
  let value = instruction.args[index];
  let borrowed: bool = value.kind == IrValueKind.Reference;
  let arg_ty: string = llvm_type_for_name(module0, value.type_name, borrowed);
  let symbol: string = llvm_call_symbol(instruction.text);
  let param_index: u64 = if index >= instruction.call_arg_start { index - instruction.call_arg_start } else { 0 };
  let i: u64 = 0;
  while i < len(module0.functions) {
    if llvm_sanitize_type_name(module0.functions[i].name) == symbol and param_index < len(module0.functions[i].params) and not module0.functions[i].params[param_index].variadic {
      set arg_ty = llvm_type_for_name(module0, module0.functions[i].params[param_index].type_name, module0.functions[i].params[param_index].borrowed);
      break;
    }
    set i = i + 1;
  }
  if borrowed {
    if value.kind == IrValueKind.Reference and value.name != "" {
      if value.ref_passthrough {
        give arg_ty + " %" + value.name;
      }
      let suffix: string = if value.ref_mutable { ".mutref" } else { ".ref" };
      give arg_ty + " %" + value.name + suffix;
    }
    if value.name != "" {
      give arg_ty + " %" + value.name;
    }
    give arg_ty + " null";
  }
  give arg_ty + " " + llvm_value_text(value);
}

proc llvm_rhs_text(instruction: IrInstruction) -> string {
  if len(instruction.args) <= 1 {
    give "0";
  }
  let value = instruction.args[1];
  give llvm_value_text(value);
}

proc llvm_impl_method_symbol_name(trait_name: string, target_type: string, method_name: string) -> string {
  give "vitte_impl_" + trait_name + "_for_" + target_type + "_" + method_name;
}

proc llvm_invalid_module() -> IrModule {
  let target0: IrTarget = target_native_x86_64_linux();
  give IrModule {
    id: 0,
    name: "",
    source_path: "",
    kind: IrModuleKind.Binary,
    target: IrTarget {
      triple: target0.triple,
      data_layout: target0.data_layout,
      pointer_width: target0.pointer_width,
      little_endian: target0.little_endian,
      feature_set: target0.feature_set,
      valid: false
    },
    functions: [],
    nominal_types: [],
    imports: [],
    external_symbols: [],
    exports: [],
    valid: false
  };
}

proc llvm_invalid_nominal() -> IrNominalType {
  give IrNominalType {
    name: "",
    source_path: "",
    kind: "",
    abi: "",
    underlying_type: "",
    target_type: "",
    generic_count: 0,
    member_count: 0,
    signature_param_count: 0,
    member_names: [],
    member_kinds: [],
    member_annotations: [],
    member_types: [],
    member_param_names: [],
    member_param_types: [],
    member_param_modes: [],
    member_param_mutables: [],
    member_param_borroweds: [],
    member_param_variadics: [],
    exported: false,
    valid: false
  };
}

proc llvm_nominal_member_index(nominal: IrNominalType, member_name: string, member_kind: string) -> int {
  let i: int = 0;
  while i < len(nominal.member_names) {
    if nominal.member_names[i] == member_name and i < len(nominal.member_kinds) and nominal.member_kinds[i] == member_kind {
      give i;
    }
    set i = i + 1;
  }
  give -1;
}

proc llvm_module_pick_nominal(module0: IrModule, name: string) -> IrNominalType {
  let i: u64 = 0;
  while i < len(module0.nominal_types) {
    if module0.nominal_types[i].kind == "pick" and module0.nominal_types[i].name == name {
      give module0.nominal_types[i];
    }
    set i = i + 1;
  }
  give llvm_invalid_nominal();
}

proc llvm_module_impl_nominal(module0: IrModule, symbol_name: string) -> IrNominalType {
  let i: u64 = 0;
  while i < len(module0.nominal_types) {
    let nominal: IrNominalType = module0.nominal_types[i];
    if nominal.kind == "impl" {
      let trait_name: string = nominal.name;
      if trait_name == "" and nominal.underlying_type != "" {
        set trait_name = nominal.underlying_type;
      }
      let j: u64 = 0;
      while j < len(nominal.member_names) {
        if j < len(nominal.member_kinds)
          and nominal.member_kinds[j] == "impl-method"
          and llvm_impl_method_symbol_name(trait_name, nominal.target_type, nominal.member_names[j]) == symbol_name {
          give nominal;
        }
        set j = j + 1;
      }
    }
    set i = i + 1;
  }
  give llvm_invalid_nominal();
}

proc llvm_nominal_call_metadata(module0: IrModule, instruction: IrInstruction) -> [string] {
  if instruction.kind != IrInstructionKind.Call {
    give [];
  }
  if instruction.operator == "variant-ctor" {
    let sep: int = find(instruction.text, "::");
    if sep > 0 {
      let pick_name: string = slice(instruction.text, 0, sep);
      let variant_name: string = slice(instruction.text, sep + 2, len(instruction.text));
      let nominal: IrNominalType = llvm_module_pick_nominal(module0, pick_name);
      if nominal.kind == "pick" {
        let member_index: int = llvm_nominal_member_index(nominal, variant_name, "variant");
        if member_index >= 0 {
          let payload: string = if member_index < len(nominal.member_annotations) { nominal.member_annotations[member_index] } else { "" };
          give ["  ; nominal-variant pick=" + pick_name + " variant=" + variant_name + " payload=" + payload];
        }
      }
    }
  }
  if instruction.operator == "method-dispatch" {
    let nominal: IrNominalType = llvm_module_impl_nominal(module0, instruction.text);
    if nominal.kind == "impl" {
      let trait_name: string = nominal.name;
      if trait_name == "" and nominal.underlying_type != "" {
        set trait_name = nominal.underlying_type;
      }
      let j: int = 0;
      while j < len(nominal.member_names) {
        if j < len(nominal.member_kinds)
          and nominal.member_kinds[j] == "impl-method"
          and llvm_impl_method_symbol_name(trait_name, nominal.target_type, nominal.member_names[j]) == instruction.text {
          let params: string = if j < len(nominal.member_param_types) { nominal.member_param_types[j] } else { "" };
          let return_type: string = if j < len(nominal.member_annotations) { nominal.member_annotations[j] } else { "" };
          give ["  ; nominal-dispatch trait=" + trait_name + " target=" + nominal.target_type + " method=" + nominal.member_names[j] + " params=" + params + " return=" + return_type];
        }
        set j = j + 1;
      }
    }
  }
  give [];
}

proc llvm_invalid_lines(message: string) -> [string] {
  give ["  ; invalid " + message];
}

proc llvm_lines_failure(lines: [string]) -> string {
  let i: u64 = 0;
  while i < len(lines) {
    if starts_with(lines[i], "  ; invalid ") or starts_with(lines[i], "  ; unsupported ") {
      give trim(lines[i]);
    }
    set i = i + 1;
  }
  give "";
}

proc llvm_call_symbol(text: string) -> string {
  let open0: int = find(text, "(");
  let name: string = if open0 > 0 { trim(slice(text, 0, open0)) } else { trim(text) };
  give llvm_sanitize_type_name(name);
}

proc llvm_function_return_type(module0: IrModule, function_name: string, fallback: string) -> string {
  let i: u64 = 0;
  while i < len(module0.functions) {
    if llvm_sanitize_type_name(module0.functions[i].name) == function_name {
      give llvm_type_for_name(module0, module0.functions[i].return_type, false);
    }
    set i = i + 1;
  }
  give llvm_type_for_name(module0, fallback, false);
}

proc llvm_binary_opcode(operator: string, ty: string) -> string {
  if operator == "-" {
    if ty == "float" or ty == "double" { give "fsub"; }
    give "sub";
  }
  if operator == "*" {
    if ty == "float" or ty == "double" { give "fmul"; }
    give "mul";
  }
  if operator == "/" {
    if ty == "float" or ty == "double" { give "fdiv"; }
    give "sdiv";
  }
  if operator == "%" { give "srem"; }
  if operator == "&" { give "and"; }
  if operator == "|" { give "or"; }
  if operator == "^" { give "xor"; }
  if ty == "float" or ty == "double" { give "fadd"; }
  give "add";
}

proc llvm_comparison_predicate(operator: string, floating: bool, unsigned_value: bool) -> string {
  if floating {
    if operator == "==" { give "oeq"; }
    if operator == "!=" { give "one"; }
    if operator == "<" { give "olt"; }
    if operator == "<=" { give "ole"; }
    if operator == ">" { give "ogt"; }
    give "oge";
  }
  if operator == "==" { give "eq"; }
  if operator == "!=" { give "ne"; }
  if operator == "<" {
    if unsigned_value { give "ult"; }
    give "slt";
  }
  if operator == "<=" {
    if unsigned_value { give "ule"; }
    give "sle";
  }
  if operator == ">" {
    if unsigned_value { give "ugt"; }
    give "sgt";
  }
  if unsigned_value { give "uge"; }
  give "sge";
}

proc llvm_binary_lines(module0: IrModule, instruction: IrInstruction) -> [string] {
  if len(instruction.args) == 2
    and type_is_integer(instruction.args[0].type_name) and type_is_integer(instruction.args[1].type_name)
    and llvm_integer_width(llvm_type_for_name(module0, instruction.args[0].type_name, false)) > 1
    and llvm_integer_width(llvm_type_for_name(module0, instruction.args[1].type_name, false)) > 1 {
    let left: IrValue = instruction.args[0];
    let right: IrValue = instruction.args[1];
    let target_type: string = instruction.dest.type_name;
    if target_type == "bool" {
      // Integer literals have a contextual type; computed operands instead
      // follow the type checker's integer promotion rules.
      let left_width: u64 = llvm_integer_width(llvm_type_for_name(module0, left.type_name, false));
      let right_width: u64 = llvm_integer_width(llvm_type_for_name(module0, right.type_name, false));
      set target_type = if left.constant != "" and right.constant == "" and right_width >= left_width { right.type_name }
        elif right.constant != "" and left.constant == "" and left_width >= right_width { left.type_name }
        else { unify_integer_types(left.type_name, right.type_name) };
    }
    let target_ty: string = llvm_type_for_name(module0, target_type, false);
    if llvm_integer_width(target_ty) > 1 {
      let lines: [string] = [];
      let args: [IrValue] = [];
      let i: u64 = 0;
      while i < 2 {
        let source: IrValue = instruction.args[i];
        let converted: IrValue = IrValue {
          id: source.id, kind: source.kind, text: source.text, name: source.name,
          place: source.place, type_name: target_type, constant: source.constant,
          ref_mutable: source.ref_mutable, ref_passthrough: source.ref_passthrough,
          external: source.external, valid: source.valid
        };
        if source.constant == "" and llvm_type_for_name(module0, source.type_name, false) != target_ty {
          let name: string = instruction.dest.name + ".operand" + string(i);
          set converted = value_place(source.id, name, name, target_type);
          set lines = lines + llvm_cast_lines(module0, instruction_create(instruction.id, IrInstructionKind.Assign, "", "as", converted, [source], instruction.span));
        }
        set args = args + [converted];
        set i = i + 1;
      }
      give lines + llvm_binary_lines_typed(module0, llvm_instruction_with_values(instruction, instruction.dest, args));
    }
  }
  give llvm_binary_lines_typed(module0, instruction);
}

proc llvm_binary_lines_typed(module0: IrModule, instruction: IrInstruction) -> [string] {
  if len(instruction.args) < 2 {
    give llvm_invalid_lines("binary operand count");
  }
  let left_type_name: string = instruction.args[0].type_name;
  let right_type_name: string = instruction.args[1].type_name;
  let left_ty: string = llvm_type_for_name(module0, left_type_name, false);
  let left_value: string = llvm_operand_text(instruction);
  let right_value: string = llvm_rhs_text(instruction);
  let result_name: string = "%" + instruction.dest.name;
  let pick_nominal: IrNominalType = llvm_module_pick_nominal(module0, left_type_name);
  if pick_nominal.valid {
    if left_type_name != right_type_name or llvm_pick_has_payload(pick_nominal)
      or (instruction.operator != "==" and instruction.operator != "!=") {
      give llvm_invalid_lines("unsupported pick comparison " + left_type_name);
    }
    give [
      "  " + result_name + ".left_tag = extractvalue " + left_ty + " " + left_value + ", 0",
      "  " + result_name + ".right_tag = extractvalue " + left_ty + " " + right_value + ", 0",
      "  " + result_name + " = icmp " + llvm_comparison_predicate(instruction.operator, false, false)
        + " i32 " + result_name + ".left_tag, " + result_name + ".right_tag"
    ];
  }
  let string_operands: bool = left_type_name == "string" and right_type_name == "string";
  if string_operands {
    if instruction.operator == "+" {
      give ["  " + result_name + " = call i8* @vitte_llvm_string_concat(i8* " + left_value + ", i8* " + right_value + ")"];
    }
    let compare_name: string = result_name + ".compare";
    let predicate: string = if instruction.operator == "==" {
      "eq"
    } elif instruction.operator == "!=" {
      "ne"
    } elif instruction.operator == "<" {
      "slt"
    } elif instruction.operator == "<=" {
      "sle"
    } elif instruction.operator == ">" {
      "sgt"
    } else {
      "sge"
    };
    give [
      "  " + compare_name + " = call i32 @vitte_llvm_string_compare(i8* " + left_value + ", i8* " + right_value + ")",
      "  " + result_name + " = icmp " + predicate + " i32 " + compare_name + ", 0"
    ];
  }
  let comparison: bool = instruction.operator == "==" or instruction.operator == "!="
    or instruction.operator == "<" or instruction.operator == "<="
    or instruction.operator == ">" or instruction.operator == ">=";
  let floating: bool = left_ty == "float" or left_ty == "double";
  if comparison {
    let unsigned_value: bool = starts_with(left_type_name, "u");
    let opcode: string = if floating { "fcmp" } else { "icmp" };
    give ["  " + result_name + " = " + opcode + " " + llvm_comparison_predicate(instruction.operator, floating, unsigned_value) + " " + left_ty + " " + left_value + ", " + right_value];
  }
  if instruction.operator == "&&" or instruction.operator == "and" {
    give ["  " + result_name + " = and " + left_ty + " " + left_value + ", " + right_value];
  }
  if instruction.operator == "||" or instruction.operator == "or" {
    give ["  " + result_name + " = or " + left_ty + " " + left_value + ", " + right_value];
  }
  if instruction.operator == "<<" {
    give ["  " + result_name + " = shl " + left_ty + " " + left_value + ", " + right_value];
  }
  if instruction.operator == ">>" {
    give ["  " + result_name + " = ashr " + left_ty + " " + left_value + ", " + right_value];
  }
  give ["  " + result_name + " = " + llvm_binary_opcode(instruction.operator, left_ty) + " " + left_ty + " " + left_value + ", " + right_value];
}

proc llvm_pick_has_payload(nominal: IrNominalType) -> bool {
  let i: u64 = 0;
  while i < len(nominal.member_names) {
    if i < len(nominal.member_kinds) and nominal.member_kinds[i] == "variant" {
      if i < len(nominal.member_annotations) and nominal.member_annotations[i] != "" {
        give true;
      }
      if i < len(nominal.member_param_types) and nominal.member_param_types[i] != "" {
        give true;
      }
    }
    set i = i + 1;
  }
  give false;
}

proc llvm_pick_payload_type(module0: IrModule, nominal: IrNominalType) -> string {
  let i: u64 = 0;
  while i < len(nominal.member_annotations) {
    if nominal.member_annotations[i] != "" {
      give llvm_type_for_name(module0, nominal.member_annotations[i], false);
    }
    set i = i + 1;
  }
  give "i64";
}

proc emit_llvm_nominal_type(module0: IrModule, nominal: IrNominalType) -> [string] {
  let name: string = "%" + llvm_sanitize_type_name(nominal.name);
  if nominal.kind == "form" or nominal.kind == "class" {
    let fields: string = "";
    let i: u64 = 0;
    while i < len(nominal.member_types) {
      if i < len(nominal.member_kinds) and nominal.member_kinds[i] == "field" {
        if fields != "" { set fields = fields + ", "; }
        set fields = fields + llvm_type_for_name(module0, nominal.member_types[i], false);
      }
      set i = i + 1;
    }
    give [name + " = type { " + (if fields != "" { fields } else { "i8" }) + " }"];
  }
  if nominal.kind == "union" {
    give [name + " = type { [16 x i8] }"];
  }
  if nominal.kind == "pick" {
    give [name + " = type { i32, " + llvm_pick_payload_type(module0, nominal) + " }"];
  }
  give [];
}

proc llvm_struct_aggregate_lines(module0: IrModule, instruction: IrInstruction) -> [string] {
  let nominal: IrNominalType = llvm_module_nominal(module0, instruction.dest.type_name);
  if not nominal.valid {
    give llvm_invalid_lines("aggregate type " + instruction.dest.type_name);
  }
  let aggregate_ty: string = "%" + llvm_sanitize_type_name(nominal.name);
  let lines: [string] = [];
  let current: string = "undef";
  let operand_index: u64 = 0;
  let member_index: u64 = 0;
  while member_index < len(nominal.member_types) and operand_index < len(instruction.args) {
    if member_index < len(nominal.member_kinds) and nominal.member_kinds[member_index] == "field" {
      let result_name: string = if operand_index + 1 == len(instruction.args) { instruction.dest.name } else { instruction.dest.name + ".field" + string(operand_index) };
      let field_ty: string = llvm_type_for_name(module0, nominal.member_types[member_index], false);
      set lines = lines + ["  %" + result_name + " = insertvalue " + aggregate_ty + " " + current + ", " + field_ty + " " + llvm_value_text(instruction.args[operand_index]) + ", " + string(operand_index)];
      set current = "%" + result_name;
      set operand_index = operand_index + 1;
      if nominal.kind == "union" { break; }
    }
    set member_index = member_index + 1;
  }
  if len(instruction.args) == 0 {
    set lines = ["  %" + instruction.dest.name + " = freeze " + aggregate_ty + " zeroinitializer"];
  }
  give lines;
}

proc llvm_array_element_type(type_name: string) -> string {
  if starts_with(type_name, "[") and ends_with(type_name, "]") {
    give trim(slice(type_name, 1, len(type_name) - 1));
  }
  give "";
}

proc llvm_array_size_lines(name: string, element_ty: string) -> [string] {
  // Let LLVM compute the stride, including padding in nested nominal types.
  give [
    "  " + name + ".sizeptr = getelementptr " + element_ty + ", " + element_ty + "* null, i64 1",
    "  " + name + ".size = ptrtoint " + element_ty + "* " + name + ".sizeptr to i64"
  ];
}

proc llvm_array_lines(module0: IrModule, instruction: IrInstruction) -> [string] {
  let count: u64 = len(instruction.args);
  let name: string = "%" + instruction.dest.name;
  if count == 0 {
    give ["  " + name + " = freeze %VitteAggregate zeroinitializer"];
  }
  let element_type: string = llvm_array_element_type(instruction.dest.type_name);
  if element_type == "" { give llvm_invalid_lines("array element type " + instruction.dest.type_name); }
  let element_ty: string = llvm_type_for_name(module0, element_type, false);
  let lines: [string] = llvm_array_size_lines(name, element_ty) + [
    "  " + name + ".data = call i8* @vitte_llvm_array_alloc(i64 " + string(count) + ", i64 " + name + ".size)",
    "  " + name + ".values = bitcast i8* " + name + ".data to " + element_ty + "*"
  ];
  let i: u64 = 0;
  while i < count {
    let source: IrValue = instruction.args[i];
    let source_ty: string = llvm_type_for_name(module0, source.type_name, false);
    let value: string = llvm_value_text(source);
    if source_ty != element_ty {
      let converted: IrValue = value_place(source.id, instruction.dest.name + ".item" + string(i), instruction.dest.name + ".item" + string(i), element_type);
      set lines = lines + llvm_cast_lines(module0, instruction_create(instruction.id, IrInstructionKind.Assign, "", "as", converted, [source], instruction.span));
      set value = llvm_value_text(converted);
    }
    set lines = lines + [
      "  " + name + ".slot" + string(i) + " = getelementptr inbounds " + element_ty + ", " + element_ty + "* " + name + ".values, i64 " + string(i),
      "  store " + element_ty + " " + value + ", " + element_ty + "* " + name + ".slot" + string(i)
    ];
    set i = i + 1;
  }
  give lines + [
    "  " + name + ".length = insertvalue %VitteAggregate zeroinitializer, i64 " + string(count) + ", 0",
    "  " + name + " = insertvalue %VitteAggregate " + name + ".length, i8* " + name + ".data, 1"
  ];
}

proc llvm_array_index_lines(module0: IrModule, instruction: IrInstruction) -> [string] {
  if len(instruction.args) != 2 { give llvm_invalid_lines("array index operand count"); }
  let owner: IrValue = instruction.args[0];
  let index: IrValue = instruction.args[1];
  let element_type: string = llvm_array_element_type(owner.type_name);
  let element_ty: string = llvm_type_for_name(module0, element_type, false);
  if element_type == "" or element_ty != llvm_type_for_name(module0, instruction.dest.type_name, false) {
    give llvm_invalid_lines("array index type " + owner.type_name + " to " + instruction.dest.type_name);
  }
  let index_ty: string = llvm_type_for_name(module0, index.type_name, false);
  if llvm_integer_width(index_ty) == 0 { give llvm_invalid_lines("array index integer type"); }
  let name: string = "%" + instruction.dest.name;
  let index_value: string = llvm_value_text(index);
  let lines: [string] = llvm_array_size_lines(name, element_ty);
  if index_ty != "i64" {
    let opcode: string = if starts_with(index.type_name, "u") { "zext" } else { "sext" };
    set lines = lines + ["  " + name + ".index = " + opcode + " " + index_ty + " " + index_value + " to i64"];
    set index_value = name + ".index";
  }
  give lines + [
    "  " + name + ".length = extractvalue %VitteAggregate " + llvm_value_text(owner) + ", 0",
    "  " + name + ".data = extractvalue %VitteAggregate " + llvm_value_text(owner) + ", 1",
    "  " + name + ".address = call i8* @vitte_llvm_array_at(i8* " + name + ".data, i64 " + name + ".length, i64 " + index_value + ", i64 " + name + ".size)",
    "  " + name + ".slot = bitcast i8* " + name + ".address to " + element_ty + "*",
    "  " + name + " = load " + element_ty + ", " + element_ty + "* " + name + ".slot"
  ];
}

proc llvm_erased_aggregate_lines(module0: IrModule, instruction: IrInstruction) -> [string] {
  if instruction.operator == "array" { give llvm_array_lines(module0, instruction); }
  let count: u64 = len(instruction.args);
  let lines: [string] = [];
  if count == 0 {
    give [
      "  %" + instruction.dest.name + ".length = insertvalue %VitteAggregate zeroinitializer, i64 0, 0",
      "  %" + instruction.dest.name + " = insertvalue %VitteAggregate %" + instruction.dest.name + ".length, i8* null, 1"
    ];
  }
  let aggregate_alignment: u64 = llvm_alignment_for_type(module0, "i64");
  set lines = lines + ["  %" + instruction.dest.name + ".values = alloca [" + string(count) + " x i64], align " + string(aggregate_alignment)];
  let i: u64 = 0;
  while i < count {
    let source_ty: string = llvm_type_for_name(module0, instruction.args[i].type_name, false);
    let source_value: string = llvm_value_text(instruction.args[i]);
    let widened: string = source_value;
    if source_ty == "i1" or source_ty == "i8" or source_ty == "i16" or source_ty == "i32" {
      set lines = lines + ["  %" + instruction.dest.name + ".item" + string(i) + " = zext " + source_ty + " " + source_value + " to i64"];
      set widened = "%" + instruction.dest.name + ".item" + string(i);
    } elif source_ty == "float" {
      set lines = lines + [
        "  %" + instruction.dest.name + ".item32." + string(i) + " = bitcast float " + source_value + " to i32",
        "  %" + instruction.dest.name + ".item" + string(i) + " = zext i32 %" + instruction.dest.name + ".item32." + string(i) + " to i64"
      ];
      set widened = "%" + instruction.dest.name + ".item" + string(i);
    } elif source_ty == "double" {
      set lines = lines + ["  %" + instruction.dest.name + ".item" + string(i) + " = bitcast double " + source_value + " to i64"];
      set widened = "%" + instruction.dest.name + ".item" + string(i);
    } elif contains(source_ty, "*") {
      set lines = lines + ["  %" + instruction.dest.name + ".item" + string(i) + " = ptrtoint " + source_ty + " " + source_value + " to i64"];
      set widened = "%" + instruction.dest.name + ".item" + string(i);
    }
    set lines = lines + [
      "  %" + instruction.dest.name + ".slot" + string(i) + " = getelementptr inbounds [" + string(count) + " x i64], [" + string(count) + " x i64]* %" + instruction.dest.name + ".values, i64 0, i64 " + string(i),
      "  store i64 " + widened + ", i64* %" + instruction.dest.name + ".slot" + string(i)
    ];
    set i = i + 1;
  }
  set lines = lines + [
    "  %" + instruction.dest.name + ".data = bitcast [" + string(count) + " x i64]* %" + instruction.dest.name + ".values to i8*",
    "  %" + instruction.dest.name + ".length = insertvalue %VitteAggregate zeroinitializer, i64 " + string(count) + ", 0",
    "  %" + instruction.dest.name + " = insertvalue %VitteAggregate %" + instruction.dest.name + ".length, i8* %" + instruction.dest.name + ".data, 1"
  ];
  give lines;
}

proc llvm_variant_ctor_lines(module0: IrModule, instruction: IrInstruction) -> [string] {
  let sep: int = find(instruction.text, "::");
  if sep <= 0 { give llvm_invalid_lines("variant constructor " + instruction.text); }
  let pick_name: string = slice(instruction.text, 0, sep);
  let variant_name: string = slice(instruction.text, sep + 2, len(instruction.text));
  let nominal: IrNominalType = llvm_module_pick_nominal(module0, pick_name);
  let member_index: int = llvm_nominal_member_index(nominal, variant_name, "variant");
  if not nominal.valid or member_index < 0 { give llvm_invalid_lines("variant constructor " + instruction.text); }
  let ty: string = "%" + llvm_sanitize_type_name(pick_name);
  let lines: [string] = llvm_nominal_call_metadata(module0, instruction);
  if len(instruction.args) == 0 {
    give lines + ["  %" + instruction.dest.name + " = insertvalue " + ty + " zeroinitializer, i32 " + to_string(member_index) + ", 0"];
  }
  let payload_ty: string = llvm_pick_payload_type(module0, nominal);
  set lines = lines + [
    "  %" + instruction.dest.name + ".tag = insertvalue " + ty + " zeroinitializer, i32 " + to_string(member_index) + ", 0",
    "  %" + instruction.dest.name + " = insertvalue " + ty + " %" + instruction.dest.name + ".tag, " + payload_ty + " " + llvm_value_text(instruction.args[instruction.call_arg_start]) + ", 1"
  ];
  give lines;
}

proc llvm_member_access_lines(module0: IrModule, instruction: IrInstruction) -> [string] {
  if len(instruction.args) < 2 {
    give llvm_invalid_lines("member operand count");
  }
  let owner: IrValue = instruction.args[0];
  let member_value: IrValue = instruction.args[1];
  let member_name: string = if member_value.name != "" { member_value.name } else { member_value.text };
  let nominal: IrNominalType = llvm_module_nominal(module0, owner.type_name);
  if nominal.valid and nominal.kind == "pick" and (owner.name == nominal.name or owner.text == nominal.name) {
    let variant_index: int = llvm_nominal_member_index(nominal, member_name, "variant");
    if variant_index < 0 {
      give llvm_invalid_lines("unknown pick variant " + nominal.name + "." + member_name);
    }
    if (variant_index < len(nominal.member_annotations) and nominal.member_annotations[variant_index] != "")
      or (variant_index < len(nominal.member_param_types) and nominal.member_param_types[variant_index] != "") {
      give llvm_invalid_lines("pick variant requires a payload " + nominal.name + "." + member_name);
    }
    give ["  %" + instruction.dest.name + " = insertvalue %" + llvm_sanitize_type_name(nominal.name)
      + " zeroinitializer, i32 " + to_string(variant_index) + ", 0"];
  }
  let member_index: int = llvm_nominal_member_index(nominal, member_name, "field");
  if not nominal.valid or member_index < 0 {
    give llvm_invalid_lines("member access " + owner.type_name + "." + member_name);
  }
  let owner_ty: string = llvm_type_for_name(module0, owner.type_name, false);
  give ["  %" + instruction.dest.name + " = extractvalue " + owner_ty + " " + llvm_value_text(owner) + ", " + to_string(member_index)];
}

proc llvm_integer_width(ty: string) -> u64 {
  if ty == "i1" { give 1; }
  if ty == "i8" { give 8; }
  if ty == "i16" { give 16; }
  if ty == "i32" { give 32; }
  if ty == "i64" { give 64; }
  give 0;
}

proc llvm_cast_lines(module0: IrModule, instruction: IrInstruction) -> [string] {
  if len(instruction.args) == 0 {
    give llvm_invalid_lines("cast operand count");
  }
  let source: IrValue = instruction.args[0];
  let source_ty: string = llvm_type_for_name(module0, source.type_name, false);
  let target_ty: string = llvm_type_for_name(module0, instruction.dest.type_name, false);
  let source_value: string = llvm_value_text(source);
  let result_name: string = "%" + instruction.dest.name;
  if target_ty == "i8*" and source_ty != "i8*" {
    let source_width: u64 = llvm_integer_width(source_ty);
    if source_width == 0 {
      give llvm_invalid_lines("string cast from " + source_ty);
    }
    if source_ty == "i64" {
      give ["  " + result_name + " = call i8* @vitte_llvm_i64_to_string(i64 " + source_value + ")"];
    }
    let integer_name: string = result_name + ".integer";
    let extend_opcode: string = if starts_with(source.type_name, "u") or source_ty == "i1" { "zext" } else { "sext" };
    give [
      "  " + integer_name + " = " + extend_opcode + " " + source_ty + " " + source_value + " to i64",
      "  " + result_name + " = call i8* @vitte_llvm_i64_to_string(i64 " + integer_name + ")"
    ];
  }
  if source_ty == target_ty {
    give ["  " + result_name + " = freeze " + target_ty + " " + source_value];
  }
  let source_width: u64 = llvm_integer_width(source_ty);
  let target_width: u64 = llvm_integer_width(target_ty);
  if source_width > 0 and (target_ty == "float" or target_ty == "double") {
    let opcode: string = if starts_with(source.type_name, "u") or source_ty == "i1" { "uitofp" } else { "sitofp" };
    give ["  " + result_name + " = " + opcode + " " + source_ty + " " + source_value + " to " + target_ty];
  }
  if (source_ty == "float" or source_ty == "double") and target_width > 0 {
    let opcode: string = if starts_with(instruction.dest.type_name, "u") or target_ty == "i1" { "fptoui" } else { "fptosi" };
    give ["  " + result_name + " = " + opcode + " " + source_ty + " " + source_value + " to " + target_ty];
  }
  if source_width > 0 and target_width > 0 {
    if source_width < target_width {
      let extend_opcode: string = if starts_with(source.type_name, "u") or source_ty == "i1" { "zext" } else { "sext" };
      give ["  " + result_name + " = " + extend_opcode + " " + source_ty + " " + source_value + " to " + target_ty];
    }
    give ["  " + result_name + " = trunc " + source_ty + " " + source_value + " to " + target_ty];
  }
  if source_ty == "float" and target_ty == "double" {
    give ["  " + result_name + " = fpext float " + source_value + " to double"];
  }
  if source_ty == "double" and target_ty == "float" {
    give ["  " + result_name + " = fptrunc double " + source_value + " to float"];
  }
  if contains(source_ty, "*") and contains(target_ty, "*") {
    give ["  " + result_name + " = bitcast " + source_ty + " " + source_value + " to " + target_ty];
  }
  give llvm_invalid_lines("cast from " + source_ty + " to " + target_ty);
}

proc llvm_builtin_call_supported(symbol: string) -> bool {
  give symbol == "len" or symbol == "slice" or symbol == "find" or symbol == "trim"
    or symbol == "starts_with" or symbol == "ends_with"
    or symbol == "to_string" or symbol == "to_string_int" or symbol == "to_string_i64"
    or symbol == "to_string_u64" or symbol == "to_string_usize"
    or symbol == "print" or symbol == "println" or symbol == "eprint" or symbol == "eprintln"
    or symbol == "panic" or symbol == "assert";
}

proc llvm_builtin_call_lines(module0: IrModule, instruction: IrInstruction, symbol: string) -> [string] {
  if instruction.call_arg_start >= len(instruction.args) {
    give llvm_invalid_lines("builtin call operand " + symbol);
  }
  let argument: IrValue = instruction.args[instruction.call_arg_start];
  let argument_ty: string = llvm_type_for_name(module0, argument.type_name, false);
  let argument_value: string = llvm_value_text(argument);
  let result_name: string = "%" + instruction.dest.name;
  if symbol == "len" {
    if argument_ty == "i8*" {
      give ["  " + result_name + " = call i64 @vitte_llvm_string_len(i8* " + argument_value + ")"];
    }
    if argument_ty == "%VitteAggregate" {
      give ["  " + result_name + " = extractvalue %VitteAggregate " + argument_value + ", 0"];
    }
    give llvm_invalid_lines("len argument " + argument_ty);
  }
  if symbol == "to_string" or symbol == "to_string_int" or symbol == "to_string_i64"
    or symbol == "to_string_u64" or symbol == "to_string_usize" {
    if argument_ty == "i64" {
      give ["  " + result_name + " = call i8* @vitte_llvm_i64_to_string(i64 " + argument_value + ")"];
    }
    let integer_name: string = result_name + ".integer";
    let extend_opcode: string = if starts_with(argument.type_name, "u") or argument_ty == "i1" { "zext" } else { "sext" };
    give [
      "  " + integer_name + " = " + extend_opcode + " " + argument_ty + " " + argument_value + " to i64",
      "  " + result_name + " = call i8* @vitte_llvm_i64_to_string(i64 " + integer_name + ")"
    ];
  }
  if symbol == "trim" {
    give ["  " + result_name + " = call i8* @vitte_llvm_string_trim(i8* " + argument_value + ")"];
  }
  if symbol == "find" and instruction.call_arg_start + 1 < len(instruction.args) {
    let needle: string = llvm_value_text(instruction.args[instruction.call_arg_start + 1]);
    give ["  " + result_name + " = call i64 @vitte_llvm_string_find(i8* " + argument_value + ", i8* " + needle + ")"];
  }
  if (symbol == "starts_with" or symbol == "ends_with") and instruction.call_arg_start + 1 < len(instruction.args) {
    let suffix: string = if symbol == "starts_with" { "starts_with" } else { "ends_with" };
    let expected: string = llvm_value_text(instruction.args[instruction.call_arg_start + 1]);
    let compare_name: string = result_name + ".result";
    give [
      "  " + compare_name + " = call i32 @vitte_llvm_string_" + suffix + "(i8* " + argument_value + ", i8* " + expected + ")",
      "  " + result_name + " = icmp ne i32 " + compare_name + ", 0"
    ];
  }
  if symbol == "slice" and instruction.call_arg_start + 2 < len(instruction.args) {
    let start_arg: IrValue = instruction.args[instruction.call_arg_start + 1];
    let end_arg: IrValue = instruction.args[instruction.call_arg_start + 2];
    let start_ty: string = llvm_type_for_name(module0, start_arg.type_name, false);
    let end_ty: string = llvm_type_for_name(module0, end_arg.type_name, false);
    let start_value: string = llvm_value_text(start_arg);
    let end_value: string = llvm_value_text(end_arg);
    let lines: [string] = [];
    let start_i64: string = start_value;
    let end_i64: string = end_value;
    if start_ty != "i64" {
      set start_i64 = result_name + ".start";
      let start_extend: string = if starts_with(start_arg.type_name, "u") or start_ty == "i1" { "zext" } else { "sext" };
      set lines = lines + ["  " + start_i64 + " = " + start_extend + " " + start_ty + " " + start_value + " to i64"];
    }
    if end_ty != "i64" {
      set end_i64 = result_name + ".end";
      let end_extend: string = if starts_with(end_arg.type_name, "u") or end_ty == "i1" { "zext" } else { "sext" };
      set lines = lines + ["  " + end_i64 + " = " + end_extend + " " + end_ty + " " + end_value + " to i64"];
    }
    give lines + ["  " + result_name + " = call i8* @vitte_llvm_string_slice(i8* " + argument_value + ", i64 " + start_i64 + ", i64 " + end_i64 + ")"];
  }
  if symbol == "print" or symbol == "println" or symbol == "eprint" or symbol == "eprintln" or symbol == "panic" {
    give ["  call void @vitte_llvm_" + symbol + "(i8* " + argument_value + ")"];
  }
  if symbol == "assert" {
    let condition_name: string = result_name + ".condition";
    give [
      "  " + condition_name + " = zext i1 " + argument_value + " to i32",
      "  call void @vitte_llvm_assert(i32 " + condition_name + ")"
    ];
  }
  give llvm_invalid_lines("builtin call " + symbol);
}

proc llvm_return_value_lines(module0: IrModule, fn0: IrFunction, instruction: IrInstruction) -> [string] {
  let return_ty: string = llvm_type_for_name(module0, fn0.return_type, false);
  let source = instruction.args[0];
  let source_ty: string = llvm_type_for_name(module0, source.type_name, false);
  let source_value: string = llvm_value_text(source);
  if source_ty == return_ty {
    give ["  ret " + return_ty + " " + source_value];
  }
  let cast_name: string = "%__return_cast_" + string(instruction.id);
  if (source_ty == "i1" or source_ty == "i8" or source_ty == "i16" or source_ty == "i32") and return_ty == "i64" {
    give ["  " + cast_name + " = sext " + source_ty + " " + source_value + " to i64", "  ret i64 " + cast_name];
  }
  if source_ty == "i64" and (return_ty == "i1" or return_ty == "i8" or return_ty == "i16" or return_ty == "i32") {
    give ["  " + cast_name + " = trunc i64 " + source_value + " to " + return_ty, "  ret " + return_ty + " " + cast_name];
  }
  if source_ty == "float" and return_ty == "double" {
    give ["  " + cast_name + " = fpext float " + source_value + " to double", "  ret double " + cast_name];
  }
  if source_ty == "double" and return_ty == "float" {
    give ["  " + cast_name + " = fptrunc double " + source_value + " to float", "  ret float " + cast_name];
  }
  if contains(source_ty, "*") and contains(return_ty, "*") {
    give ["  " + cast_name + " = bitcast " + source_ty + " " + source_value + " to " + return_ty, "  ret " + return_ty + " " + cast_name];
  }
  give llvm_invalid_lines("return conversion " + source_ty + " to " + return_ty) + ["  ret " + return_ty + " zeroinitializer"];
}

proc llvm_unary_lines(module0: IrModule, instruction: IrInstruction) -> [string] {
  if len(instruction.args) != 1 { give llvm_invalid_lines("unary operand count"); }
  let source: IrValue = instruction.args[0];
  let ty: string = llvm_type_for_name(module0, source.type_name, false);
  let name: string = "%" + instruction.dest.name;
  let value: string = llvm_value_text(source);
  if instruction.operator == "-" {
    if ty == "float" or ty == "double" { give ["  " + name + " = fneg " + ty + " " + value]; }
    if llvm_integer_width(ty) > 1 { give ["  " + name + " = sub " + ty + " 0, " + value]; }
  }
  if instruction.operator == "not" or instruction.operator == "!" {
    if ty == "i1" { give ["  " + name + " = xor i1 " + value + ", true"]; }
    if llvm_integer_width(ty) > 1 { give ["  " + name + " = icmp eq " + ty + " " + value + ", 0"]; }
  }
  give llvm_invalid_lines("unary " + instruction.operator + " on " + ty);
}

proc emit_llvm_instruction_in_function(module0: IrModule, fn0: IrFunction, instruction: IrInstruction) -> [string] {
  if instruction.kind == IrInstructionKind.Assign {
    if instruction.operator == "-" or instruction.operator == "not" or instruction.operator == "!" {
      give llvm_unary_lines(module0, instruction);
    }
    if instruction.operator == "." {
      give llvm_member_access_lines(module0, instruction);
    }
    if instruction.operator == "[]" {
      give llvm_array_index_lines(module0, instruction);
    }
    if instruction.operator == "as" {
      give llvm_cast_lines(module0, instruction);
    }
    let ty: string = llvm_type_for_name(module0, instruction.dest.type_name, false);
    give ["  %" + instruction.dest.name + " = freeze " + ty + " " + llvm_operand_text(instruction)];
  }
  if instruction.kind == IrInstructionKind.Binary {
    give llvm_binary_lines(module0, instruction);
  }
  if instruction.kind == IrInstructionKind.Aggregate {
    if instruction.operator == "struct" { give llvm_struct_aggregate_lines(module0, instruction); }
    give llvm_erased_aggregate_lines(module0, instruction);
  }
  if instruction.kind == IrInstructionKind.Discriminant {
    let source_ty: string = llvm_type_for_name(module0, instruction.args[0].type_name, false);
    give ["  %" + instruction.dest.name + " = extractvalue " + source_ty + " " + llvm_value_text(instruction.args[0]) + ", 0"];
  }
  if instruction.kind == IrInstructionKind.Call {
    if instruction.operator == "variant-ctor" { give llvm_variant_ctor_lines(module0, instruction); }
    let lines: [string] = llvm_nominal_call_metadata(module0, instruction);
    if instruction.operator == "method-dispatch" and len(lines) == 0 { give llvm_invalid_lines("canonical nominal call " + instruction.text); }
    let args_text: string = "";
    let i: u64 = instruction.call_arg_start;
    while i < len(instruction.args) {
      if args_text != "" { set args_text = args_text + ", "; }
      set args_text = args_text + llvm_call_arg_text(module0, instruction, i);
      set i = i + 1;
    }
    let symbol: string = llvm_call_symbol(instruction.text);
    if llvm_builtin_call_supported(symbol) {
      give lines + llvm_builtin_call_lines(module0, instruction, symbol);
    }
    let return_ty: string = llvm_function_return_type(module0, symbol, instruction.dest.type_name);
    let call_text: string = "call " + return_ty + " @" + symbol + "(" + args_text + ")";
    if return_ty == "void" { give lines + ["  " + call_text]; }
    give lines + ["  %" + instruction.dest.name + " = " + call_text];
  }
  if instruction.kind == IrInstructionKind.Assert {
    give ["  ; assert " + instruction.text];
  }
  if instruction.kind == IrInstructionKind.ReturnValue {
    give llvm_return_value_lines(module0, fn0, instruction);
  }
  if instruction.kind == IrInstructionKind.BorrowShared or instruction.kind == IrInstructionKind.BorrowMut {
    let source: IrValue = instruction.dest;
    let base_ty: string = llvm_type_for_name(module0, source.type_name, false);
    let ref_name: string = "%" + instruction.dest.name + ".ref";
    let value_name: string = "%" + source.name;
    let value_alignment: u64 = llvm_alignment_for_type(module0, source.type_name);
    give [
      "  " + ref_name + " = alloca " + base_ty + ", align " + string(value_alignment),
      "  store " + base_ty + " " + value_name + ", " + base_ty + "* " + ref_name + ", align " + string(value_alignment)
    ];
  }
  give ["  ; unsupported " + instruction.text];
}

proc emit_llvm_instruction(module0: IrModule, instruction: IrInstruction) -> [string] {
  if len(module0.functions) == 0 {
    give llvm_invalid_lines("instruction without function context");
  }
  let fallback: IrFunction = module0.functions[0];
  give emit_llvm_instruction_in_function(module0, fallback, instruction);
}

proc llvm_block_has_return_value(block: IrBlock) -> bool {
  let i: u64 = 0;
  while i < len(block.instructions) {
    if block.instructions[i].kind == IrInstructionKind.ReturnValue { give true; }
    set i = i + 1;
  }
  give false;
}

proc emit_llvm_terminator(module0: IrModule, fn0: IrFunction, block: IrBlock) -> [string] {
  let terminator = block.terminator;
  if llvm_block_has_return_value(block) and terminator.kind == IrInstructionKind.Return { give []; }
  if terminator.kind == IrInstructionKind.Jump { give ["  br label %bb" + string(terminator.target_block)]; }
  if terminator.kind == IrInstructionKind.Branch {
    let condition = terminator.args[0];
    let condition_ty: string = llvm_type_for_name(module0, condition.type_name, false);
    let lines: [string] = [];
    let condition_text: string = llvm_value_text(condition);
    if condition_ty != "i1" {
      set lines = ["  %bb" + string(block.id) + ".condition = icmp ne " + condition_ty + " " + condition_text + ", 0"];
      set condition_text = "%bb" + string(block.id) + ".condition";
    }
    give lines + ["  br i1 " + condition_text + ", label %bb" + string(terminator.target_block) + ", label %bb" + string(terminator.else_block)];
  }
  if terminator.kind == IrInstructionKind.Switch {
    let condition = terminator.args[0];
    let condition_ty: string = llvm_type_for_name(module0, condition.type_name, false);
    let lines: [string] = ["  switch " + condition_ty + " " + llvm_value_text(condition) + ", label %bb" + string(terminator.else_block) + " ["];
    let i: u64 = 0;
    while i < len(terminator.switch_values) and i < len(terminator.switch_targets) {
      set lines = lines + ["    " + condition_ty + " " + terminator.switch_values[i] + ", label %bb" + string(terminator.switch_targets[i])];
      set i = i + 1;
    }
    give lines + ["  ]"];
  }
  if terminator.kind == IrInstructionKind.Return {
    let return_ty: string = llvm_type_for_name(module0, fn0.return_type, false);
    give [if return_ty == "void" { "  ret void" } else { "  ret " + return_ty + " zeroinitializer" }];
  }
  give ["  unreachable"];
}

proc emit_llvm_block(block: IrBlock) -> [string] {
  let lines: [string] = ["bb" + string(block.id) + ":"];
  let i: u64 = 0;
  while i < len(block.instructions) {
    set lines = lines + ["  ; " + block.instructions[i].text];
    set i = i + 1;
  }
  give lines + ["  ret i64 0"];
}

proc emit_llvm_block_in_module(module0: IrModule, fn0: IrFunction, block: IrBlock) -> [string] {
  let lines: [string] = ["bb" + string(block.id) + ":"];
  let i: u64 = 0;
  while i < len(block.instructions) {
    set lines = lines + emit_llvm_instruction_in_function(module0, fn0, block.instructions[i]);
    set i = i + 1;
  }
  give lines + emit_llvm_terminator(module0, fn0, block);
}

proc llvm_function_params_text(module0: IrModule, fn0: IrFunction, include_names: bool) -> string {
  let params_text: string = "";
  let i: u64 = 0;
  while i < len(fn0.params) {
    if params_text != "" { set params_text = params_text + ", "; }
    if fn0.params[i].variadic {
      set params_text = params_text + "...";
    } else {
      let param_ty: string = llvm_type_for_name(module0, fn0.params[i].type_name, fn0.params[i].borrowed);
      set params_text = params_text + param_ty;
      if include_names { set params_text = params_text + " %" + if fn0.params[i].name != "" { fn0.params[i].name } else { "arg" + string(i) }; }
    }
    set i = i + 1;
  }
  give params_text;
}

proc llvm_function_symbol(fn0: IrFunction) -> string {
  if fn0.name == "main" and len(fn0.params) > 0 {
    give "vitte_entry_main";
  }
  give llvm_sanitize_type_name(fn0.name);
}

proc llvm_local_index(locals: [IrValue], value: IrValue) -> int {
  if value.constant != "" or value.name == "" or value.place != value.name {
    give -1;
  }
  let i: u64 = 0;
  while i < len(locals) {
    if locals[i].name == value.name { give i as int; }
    set i = i + 1;
  }
  give -1;
}

proc llvm_instruction_defines_local(instruction: IrInstruction) -> bool {
  give instruction.dest.valid and instruction.dest.name != ""
    and instruction.dest.place == instruction.dest.name
    and (instruction.kind == IrInstructionKind.Assign or instruction.kind == IrInstructionKind.Binary
      or instruction.kind == IrInstructionKind.Call or instruction.kind == IrInstructionKind.Aggregate
      or instruction.kind == IrInstructionKind.Discriminant);
}

// Canonical IR places are mutable, not LLVM SSA registers. Spill only names
// assigned more than once (including a parameter's incoming definition).
// Slots live in the entry block so they dominate loops and both branch arms.
proc llvm_mutable_locals(fn0: IrFunction) -> [IrValue] {
  let candidates: [IrValue] = [];
  let locals: [IrValue] = [];
  let i: u64 = 0;
  while i < len(fn0.params) {
    set candidates = candidates + [value_place(i + 1, fn0.params[i].name, fn0.params[i].name, fn0.params[i].type_name)];
    set i = i + 1;
  }
  set i = 0;
  while i < len(fn0.blocks) {
    let j: u64 = 0;
    while j < len(fn0.blocks[i].instructions) {
      let instruction: IrInstruction = fn0.blocks[i].instructions[j];
      if llvm_instruction_defines_local(instruction) {
        let index: int = llvm_local_index(candidates, instruction.dest);
        if index < 0 {
          set candidates = candidates + [instruction.dest];
        } elif llvm_local_index(locals, instruction.dest) < 0 {
          set locals = locals + [candidates[index as u64]];
        }
      }
      set j = j + 1;
    }
    set i = i + 1;
  }
  give locals;
}

proc llvm_local_slot(index: u64) -> string {
  give "__vitte.local.slot." + string(index);
}

proc llvm_local_allocations(module0: IrModule, fn0: IrFunction, locals: [IrValue]) -> [string] {
  let lines: [string] = [];
  let i: u64 = 0;
  while i < len(locals) {
    let ty: string = llvm_type_for_name(module0, locals[i].type_name, false);
    let slot: string = "%" + llvm_local_slot(i);
    set lines = lines + ["  " + slot + " = alloca " + ty];
    let p: u64 = 0;
    while p < len(fn0.params) {
      if fn0.params[p].name == locals[i].name {
        set lines = lines + ["  store " + ty + " %" + locals[i].name + ", " + ty + "* " + slot];
      }
      set p = p + 1;
    }
    set i = i + 1;
  }
  give lines;
}

proc llvm_instruction_with_values(instruction: IrInstruction, dest: IrValue, args: [IrValue]) -> IrInstruction {
  give IrInstruction {
    id: instruction.id, kind: instruction.kind, text: instruction.text,
    operator: instruction.operator, dest: dest, args: args,
    call_arg_start: instruction.call_arg_start, target_block: instruction.target_block,
    else_block: instruction.else_block, switch_values: instruction.switch_values,
    switch_targets: instruction.switch_targets, span: instruction.span, valid: instruction.valid
  };
}

form LlvmLocalOperands {
  args: [IrValue]
  lines: [string]
}

proc llvm_load_local_operands(module0: IrModule, instruction: IrInstruction, locals: [IrValue], prefix: string) -> LlvmLocalOperands {
  let args: [IrValue] = [];
  let lines: [string] = [];
  let i: u64 = 0;
  while i < len(instruction.args) {
    let arg: IrValue = instruction.args[i];
    let index: int = llvm_local_index(locals, arg);
    if index < 0 {
      set args = args + [arg];
    } elif arg.kind == IrValueKind.Reference {
      let slot: string = llvm_local_slot(index as u64);
      set args = args + [IrValue {
        id: arg.id, kind: arg.kind, text: slot, name: slot, place: slot,
        type_name: arg.type_name, constant: "", ref_mutable: arg.ref_mutable,
        ref_passthrough: true, external: arg.external, valid: arg.valid
      }];
    } else {
      let ty: string = llvm_type_for_name(module0, locals[index as u64].type_name, false);
      let name: string = prefix + ".load." + string(i);
      set lines = lines + ["  %" + name + " = load " + ty + ", " + ty + "* %" + llvm_local_slot(index as u64)];
      let loaded: IrValue = value_place(arg.id, name, name, locals[index as u64].type_name);
      if llvm_type_for_name(module0, arg.type_name, false) != ty {
        let converted: IrValue = value_place(arg.id, name + ".cast", name + ".cast", arg.type_name);
        let cast: IrInstruction = instruction_create(instruction.id, IrInstructionKind.Assign, "", "as", converted, [loaded], instruction.span);
        set lines = lines + llvm_cast_lines(module0, cast);
        set args = args + [converted];
      } else {
        set args = args + [loaded];
      }
    }
    set i = i + 1;
  }
  give LlvmLocalOperands { args: args, lines: lines };
}

proc emit_llvm_block_with_locals(module0: IrModule, fn0: IrFunction, block: IrBlock, locals: [IrValue], entry: bool) -> [string] {
  let lines: [string] = ["bb" + string(block.id) + ":"];
  if entry { set lines = lines + llvm_local_allocations(module0, fn0, locals); }
  let i: u64 = 0;
  while i < len(block.instructions) {
    let instruction: IrInstruction = block.instructions[i];
    let index: int = llvm_local_index(locals, instruction.dest);
    if index >= 0 and (instruction.kind == IrInstructionKind.BorrowShared or instruction.kind == IrInstructionKind.BorrowMut) {
      // Call operands refer directly to the existing mutable slot.
      set i = i + 1;
      continue;
    }
    let prefix: string = "__vitte.local.bb" + string(block.id) + ".ins" + string(i);
    let operands: LlvmLocalOperands = llvm_load_local_operands(module0, instruction, locals, prefix);
    let dest: IrValue = if index >= 0 and llvm_instruction_defines_local(instruction) {
      value_place(instruction.dest.id, prefix + ".value", prefix + ".value", instruction.dest.type_name)
    } else { instruction.dest };
    let rewritten: IrInstruction = llvm_instruction_with_values(instruction, dest, operands.args);
    set lines = lines + operands.lines + emit_llvm_instruction_in_function(module0, fn0, rewritten);
    if index >= 0 and llvm_instruction_defines_local(instruction) {
      let ty: string = llvm_type_for_name(module0, locals[index as u64].type_name, false);
      let stored: IrValue = dest;
      if ty != llvm_type_for_name(module0, dest.type_name, false) {
        set stored = value_place(dest.id, prefix + ".store", prefix + ".store", locals[index as u64].type_name);
        set lines = lines + llvm_cast_lines(module0, instruction_create(instruction.id, IrInstructionKind.Assign, "", "as", stored, [dest], instruction.span));
      }
      set lines = lines + ["  store " + ty + " " + llvm_value_text(stored) + ", " + ty + "* %" + llvm_local_slot(index as u64)];
    }
    set i = i + 1;
  }
  let operands: LlvmLocalOperands = llvm_load_local_operands(module0, block.terminator, locals, "__vitte.local.bb" + string(block.id) + ".term");
  let rewritten_block: IrBlock = IrBlock {
    id: block.id, label: block.label, instructions: block.instructions,
    terminator: llvm_instruction_with_values(block.terminator, block.terminator.dest, operands.args), valid: block.valid
  };
  give lines + operands.lines + emit_llvm_terminator(module0, fn0, rewritten_block);
}

proc emit_llvm_function(module0: IrModule, fn0: IrFunction) -> [string] {
  let return_ty: string = llvm_type_for_name(module0, fn0.return_type, false);
  let symbol: string = llvm_function_symbol(fn0);
  if fn0.linkage == IrLinkage.External or fn0.linkage == IrLinkage.Imported {
    give ["declare " + return_ty + " @" + symbol + "(" + llvm_function_params_text(module0, fn0, false) + ")", ""];
  }
  let lines: [string] = ["define " + return_ty + " @" + symbol + "(" + llvm_function_params_text(module0, fn0, true) + ") {"];
  let locals: [IrValue] = llvm_mutable_locals(fn0);
  let i: u64 = 0;
  while i < len(fn0.blocks) {
    if len(locals) > 0 {
      set lines = lines + emit_llvm_block_with_locals(module0, fn0, fn0.blocks[i], locals, i == 0);
    } else {
      set lines = lines + emit_llvm_block_in_module(module0, fn0, fn0.blocks[i]);
    }
    set i = i + 1;
  }
  give lines + ["}", ""];
}

proc emit_llvm_c_main_wrapper(module0: IrModule, fn0: IrFunction) -> [string] {
  let return_ty: string = llvm_type_for_name(module0, fn0.return_type, false);
  let lines: [string] = [
    "define i32 @main(i32 %argc, i8** %argv) {"
  ];
  if len(fn0.params) == 0 {
    if return_ty == "void" {
      give lines + [
        "  call void @vitte_entry_main()",
        "  ret i32 0",
        "}",
        ""
      ];
    }
    set lines = lines + ["  %vitte_entry_result = call " + return_ty + " @vitte_entry_main()"];
  } else {
    let first_ty: string = llvm_type_for_name(module0, fn0.params[0].type_name, fn0.params[0].borrowed);
    if first_ty == "i32" {
      set lines = lines + ["  %vitte_entry_result = call i32 @vitte_entry_main(i32 %argc)"];
    } elif first_ty == "i64" {
      set lines = lines + [
        "  %vitte_entry_arg = zext i32 %argc to i64",
        "  %vitte_entry_result = call i64 @vitte_entry_main(i64 %vitte_entry_arg)"
      ];
    } else {
      set lines = lines + ["  %vitte_entry_result = call " + first_ty + " @vitte_entry_main(" + first_ty + " zeroinitializer)"];
    }
  }
  if return_ty == "i32" {
    set lines = lines + ["  ret i32 %vitte_entry_result"];
  } elif return_ty == "i64" {
    set lines = lines + [
      "  %vitte_entry_exit = trunc i64 %vitte_entry_result to i32",
      "  ret i32 %vitte_entry_exit"
    ];
  } else {
    set lines = lines + ["  ret i32 0"];
  }
  give lines + ["}", ""];
}

proc emit_llvm_module_header(module0: IrModule) -> [string] {
  let lines: [string] = [
    "; module " + module0.name,
    "target triple = \"" + triple_text(module0.target.triple) + "\"",
    "target datalayout = \"" + module0.target.data_layout + "\"",
    "",
    "declare i8* @vitte_llvm_string_concat(i8*, i8*)",
    "declare i32 @vitte_llvm_string_compare(i8*, i8*)",
    "declare i8* @vitte_llvm_i64_to_string(i64)",
    "declare i64 @vitte_llvm_string_len(i8*)",
    "declare i8* @vitte_llvm_string_slice(i8*, i64, i64)",
    "declare i64 @vitte_llvm_string_find(i8*, i8*)",
    "declare i8* @vitte_llvm_string_trim(i8*)",
    "declare i32 @vitte_llvm_string_starts_with(i8*, i8*)",
    "declare i32 @vitte_llvm_string_ends_with(i8*, i8*)",
    "declare void @vitte_llvm_print(i8*)",
    "declare void @vitte_llvm_println(i8*)",
    "declare void @vitte_llvm_eprint(i8*)",
    "declare void @vitte_llvm_eprintln(i8*)",
    "declare void @vitte_llvm_panic(i8*)",
    "declare void @vitte_llvm_assert(i32)",
    "declare i8* @vitte_llvm_array_alloc(i64, i64)",
    "declare i8* @vitte_llvm_array_at(i8*, i64, i64, i64)",
    // llvm_module_fragment strips the shared header through this final marker.
    "%VitteAggregate = type { i64, i8* }"
  ];
  give lines;
}

proc emit_llvm_module_nominals(module0: IrModule) -> [string] {
  let lines: [string] = [];
  let n: u64 = 0;
  while n < len(module0.nominal_types) {
    let nominal = module0.nominal_types[n];
    set lines = lines + emit_llvm_nominal_type(module0, nominal) + [
      "; nominal name=" + nominal.name + " kind=" + nominal.kind + " members=" + to_string(nominal.member_count),
      "; nominal member_annotations=" + join(nominal.member_annotations, ","),
      "; nominal member_param_names=" + join(nominal.member_param_names, ","),
      "; nominal member_param_types=" + join(nominal.member_param_types, ",")
    ];
    set n = n + 1;
  }
  set lines = lines + [""];
  give lines;
}

proc emit_llvm_owned_nominals(module0: IrModule) -> [string] {
  let lines: [string] = [];
  let i: u64 = 0;
  while i < len(module0.nominal_types) {
    let nominal: IrNominalType = module0.nominal_types[i];
    if nominal.source_path == "" or nominal.source_path == module0.source_path {
      set lines = lines + emit_llvm_nominal_type(module0, nominal);
    }
    set i = i + 1;
  }
  give lines;
}

proc emit_llvm_module_prelude(module0: IrModule) -> [string] {
  let lines: [string] = emit_llvm_module_header(module0);
  let string_globals: [string] = llvm_string_globals_for_module(module0);
  if len(string_globals) > 0 {
    set lines = lines + string_globals;
  }
  give lines + emit_llvm_module_nominals(module0);
}

proc emit_llvm_module(module0: IrModule) -> [string] {
  let lines: [string] = emit_llvm_module_prelude(module0);
  let i: u64 = 0;
  let entry_index: u64 = len(module0.functions);
  while i < len(module0.functions) {
    set lines = lines + emit_llvm_function(module0, module0.functions[i]);
    if module0.functions[i].name == "main" and len(module0.functions[i].params) > 0 {
      set entry_index = i;
    }
    set i = i + 1;
  }
  if entry_index < len(module0.functions) {
    set lines = lines + emit_llvm_c_main_wrapper(module0, module0.functions[entry_index]);
  }
  give lines;
}

proc join_lines_range(lines: [string], start: u64, end: u64) -> string {
  if start >= end {
    give "";
  }
  if start + 1 == end {
    give lines[start];
  }
  let middle: u64 = start + (end - start) / 2;
  let left: string = join_lines_range(lines, start, middle);
  let right: string = join_lines_range(lines, middle, end);
  give left + "\n" + right;
}

proc join_lines(lines: [string]) -> string {
  give join_lines_range(lines, 0, len(lines));
}

proc llvm_section(id: u64, name: string, kind: LlvmSectionKind, alignment: u64, offset: u64, content: string) -> LlvmObjectSection {
  give LlvmObjectSection {
    id: id,
    name: name,
    kind: kind,
    alignment: alignment,
    offset: offset,
    size: len(content),
    content: content,
    valid: id > 0 and name != ""
  };
}

proc llvm_symbol(id: u64, name: string, section_id: u64, offset: u64, size: u64, global: bool, defined: bool) -> LlvmObjectSymbol {
  give LlvmObjectSymbol {
    id: id,
    name: name,
    section_id: section_id,
    offset: offset,
    size: size,
    global: global,
    defined: defined,
    valid: id > 0 and name != ""
  };
}

proc llvm_relocation(id: u64, section_id: u64, offset: u64, kind: string, target_symbol: string, addend: int, resolved: bool) -> LlvmObjectRelocation {
  give LlvmObjectRelocation {
    id: id,
    section_id: section_id,
    offset: offset,
    kind: kind,
    target_symbol: target_symbol,
    addend: addend,
    resolved: resolved,
    valid: id > 0 and section_id > 0 and kind != "" and target_symbol != ""
  };
}

proc llvm_object_text(sections: [LlvmObjectSection], symbols: [LlvmObjectSymbol], relocations: [LlvmObjectRelocation], diagnostics: [LlvmDiagnostic], options: LlvmBuildOptions) -> string {
  let deterministic: string = if options.deterministic { "true" } else { "false" };
  let debug_enabled: string = if options.debug_enabled { "true" } else { "false" };
  let emit_debug_sections: string = if options.emit_debug_sections { "true" } else { "false" };
  let lto_enabled: string = if options.lto_enabled { "true" } else { "false" };
  let section_count: string = to_string(len(sections));
  let symbol_count: string = to_string(len(symbols));
  let relocation_count: string = to_string(len(relocations));
  let diagnostic_count: string = to_string(len(diagnostics));
  let lines: [string] = [
    "llvm-object-bundle",
    llvm_kv("target", options.target),
    llvm_kv("opt_level", options.opt_level),
    llvm_kv("deterministic", deterministic),
    llvm_kv("debug_enabled", debug_enabled),
    llvm_kv("emit_debug_sections", emit_debug_sections),
    llvm_kv("lto_enabled", lto_enabled),
    llvm_kv("pgo_mode", options.pgo_mode),
    llvm_kv("section_count", section_count),
    llvm_kv("symbol_count", symbol_count),
    llvm_kv("relocation_count", relocation_count),
    llvm_kv("diagnostic_count", diagnostic_count),
    ""
  ];
  let built: [string] = lines;
  let i: u64 = 0;
  while i < len(sections) {
    let section0 = sections[i];
    let index_text: string = to_string(i);
    let offset_text: string = to_string(section0.offset);
    let size_text: string = to_string(section0.size);
    set built = built + ["section[" + index_text + "]" + llvm_eq() + section0.name + " " + llvm_kv("offset", offset_text) + " " + llvm_kv("size", size_text)];
    set i = i + 1;
  }
  set i = 0;
  while i < len(symbols) {
    let symbol0 = symbols[i];
    let index_text: string = to_string(i);
    let section_id: string = to_string(symbol0.section_id);
    let offset_text: string = to_string(symbol0.offset);
    set built = built + ["symbol[" + index_text + "]" + llvm_eq() + symbol0.name + " " + llvm_kv("section", section_id) + " " + llvm_kv("offset", offset_text)];
    set i = i + 1;
  }
  set i = 0;
  while i < len(relocations) {
    let reloc0 = relocations[i];
    let index_text: string = to_string(i);
    let section_id: string = to_string(reloc0.section_id);
    let offset_text: string = to_string(reloc0.offset);
    set built = built + ["relocation[" + index_text + "]" + llvm_eq() + reloc0.kind + " " + llvm_kv("section", section_id) + " " + llvm_kv("offset", offset_text) + " " + llvm_kv("target", reloc0.target_symbol)];
    set i = i + 1;
  }
  set i = 0;
  while i < len(diagnostics) {
    let diag0 = diagnostics[i];
    let index_text: string = to_string(i);
    set built = built + ["diagnostic[" + index_text + "]" + llvm_eq() + diag0.code + ":" + diag0.message];
    set i = i + 1;
  }
  give join_lines(built);
}

proc function_text_size(fn0: IrFunction) -> u64 {
  let size: u64 = 0;
  let i: u64 = 0;
  while i < len(fn0.blocks) {
    set size = size + len(fn0.blocks[i].instructions) + 1;
    set i = i + 1;
  }
  if size == 0 {
    give 1 as u64;
  }
  give size * 4;
}

proc emit_llvm_ir_from_ir(unit: IrUnit) -> LlvmBindingResult {
  if not unit_is_valid(unit) {
    give LlvmBindingResult {
      target: "llvm-ir",
      ir_text: "",
      module_count: len(unit.modules),
      function_count: 0,
      valid: false
    };
  }
  let lines: [string] = ["; LLVM IR generated from canonical Vitte IR", ""];
  let function_count: u64 = 0;
  let i: u64 = 0;
  while i < len(unit.modules) {
    set lines = lines + emit_llvm_module(unit.modules[i]);
    set function_count = function_count + len(unit.modules[i].functions);
    set i = i + 1;
  }
  give LlvmBindingResult {
    target: "llvm-ir",
    ir_text: join_lines(lines),
    module_count: len(unit.modules),
    function_count: function_count,
    valid: function_count > 0 and llvm_lines_failure(lines) == ""
  };
}

proc emit_llvm_ir_fragment_from_ir_streamed(unit: IrUnit, output_path: string, include_header: bool, include_nominals: bool) -> LlvmBindingResult {
  if not unit_is_valid(unit) or not write_file(output_path, if include_header { "; LLVM IR generated from canonical Vitte IR\n\n" } else { "" }) {
    give LlvmBindingResult {
      target: "llvm-ir",
      ir_text: "",
      module_count: len(unit.modules),
      function_count: 0,
      valid: false
    };
  }

  let function_count: u64 = 0;
  let all_written: bool = true;
  let i: u64 = 0;
  while i < len(unit.modules) and all_written {
    let module0: IrModule = unit.modules[i];
    if include_header {
      let header_checkpoint: u64 = host_memory_checkpoint();
      let header_text: string = join_lines(emit_llvm_module_header(module0));
      set all_written = append_file(output_path, header_text + "\n");
      let header_rewind_status: int = host_memory_rewind(header_checkpoint);
      if header_rewind_status != 0 {
        set all_written = false;
      }
    }

    let string_values: LlvmStringGlobalValues = llvm_string_global_values_for_module(module0);
    let string_index: u64 = 0;
    while string_index < len(string_values.values) and all_written {
      let string_checkpoint: u64 = host_memory_checkpoint();
      let string_line: string = llvm_string_global_line(string_values.values[string_index]);
      set all_written = append_file(output_path, string_line + "\n");
      let string_rewind_status: int = host_memory_rewind(string_checkpoint);
      if string_rewind_status != 0 {
        set all_written = false;
      }
      set string_index = string_index + 1;
    }

    if include_nominals {
      let nominal_checkpoint: u64 = host_memory_checkpoint();
      let nominal_text: string = join_lines(emit_llvm_owned_nominals(module0));
      set all_written = all_written and append_file(output_path, nominal_text + "\n");
      let nominal_rewind_status: int = host_memory_rewind(nominal_checkpoint);
      if nominal_rewind_status != 0 {
        set all_written = false;
      }
    }

    let entry_index: u64 = len(module0.functions);
    let j: u64 = 0;
    while j < len(module0.functions) and all_written {
      // Imported signatures are metadata here: their definitions are supplied
      // by another fragment of this same module set, not redeclared per chunk.
      if module0.functions[j].linkage == IrLinkage.Imported {
        set j = j + 1;
        continue;
      }
      let llvm_function_progress_written: bool = write_file(
        "target/reports/compiler_llvm_function_progress.txt",
        to_string(j + 1) + "/" + to_string(len(module0.functions)) + " " + module0.functions[j].name
          + " blocks=" + to_string(len(module0.functions[j].blocks)) + "\n"
      );
      if module0.functions[j].name == "main" and len(module0.functions[j].params) > 0 {
        set entry_index = j;
      }
      let function_checkpoint: u64 = host_memory_checkpoint();
      let function_lines: [string] = emit_llvm_function(module0, module0.functions[j]);
      let function_failure: string = llvm_lines_failure(function_lines);
      if function_failure != "" {
        let failure_written: bool = write_file("target/reports/compiler_llvm_failure.txt",
          module0.source_path + ":" + module0.functions[j].name + ": " + function_failure + "\n");
        set all_written = false;
      } else {
        let function_text: string = join_lines(function_lines);
        set all_written = append_file(output_path, function_text + "\n");
      }
      let function_rewind_status: int = host_memory_rewind(function_checkpoint);
      if function_rewind_status != 0 {
        set all_written = false;
      }
      set function_count = function_count + 1;
      set j = j + 1;
    }

    if entry_index < len(module0.functions) and all_written {
      let wrapper_checkpoint: u64 = host_memory_checkpoint();
      let wrapper_text: string = join_lines(emit_llvm_c_main_wrapper(module0, module0.functions[entry_index]));
      set all_written = append_file(output_path, wrapper_text + "\n");
      let wrapper_rewind_status: int = host_memory_rewind(wrapper_checkpoint);
      if wrapper_rewind_status != 0 {
        set all_written = false;
      }
    }
    set i = i + 1;
  }

  let ir_text: string = if all_written { read_file(output_path) } else { "" };
  give LlvmBindingResult {
    target: "llvm-ir",
    ir_text: ir_text,
    module_count: len(unit.modules),
    function_count: function_count,
    valid: all_written and function_count > 0 and ir_text != ""
  };
}

proc emit_llvm_ir_from_ir_streamed(unit: IrUnit, output_path: string) -> LlvmBindingResult {
  give emit_llvm_ir_fragment_from_ir_streamed(unit, output_path, true, true);
}

proc llvm_profile_diagnostics(options: LlvmBuildOptions) -> [LlvmDiagnostic] {
  let diagnostics: [LlvmDiagnostic] = [];
  if options.emit_debug_sections and not options.debug_enabled {
    set diagnostics = diagnostics + [llvm_diagnostic(LlvmDiagnosticLevel.Warning, "llvm.debug.mismatch", "debug sections requested while debug is disabled", "llvm")];
  }
  if options.pgo_mode != "off" {
    set diagnostics = diagnostics + [llvm_diagnostic(LlvmDiagnosticLevel.Note, "llvm.pgo.adapter", "PGO recorded as adapter metadata only", "llvm")];
  }
  if options.lto_enabled {
    set diagnostics = diagnostics + [llvm_diagnostic(LlvmDiagnosticLevel.Note, "llvm.lto.adapter", "LTO recorded as adapter metadata only", "llvm")];
  }
  give diagnostics;
}

proc emit_llvm_object_from_ir(unit: IrUnit, options: LlvmBuildOptions) -> LlvmObjectResult {
  give emit_llvm_object_from_ir_with_toolchain(unit, options, default_llvm_toolchain_paths());
}

proc emit_llvm_object_from_ir_with_toolchain(unit: IrUnit, options: LlvmBuildOptions, toolchain: LlvmToolchainPaths) -> LlvmObjectResult {
  let ir_result: LlvmBindingResult = emit_llvm_ir_from_ir(unit);
  if not unit_is_valid(unit) or not options.valid or not ir_result.valid {
    give LlvmObjectResult {
      target: options.target,
      object_format: "llvm-object",
      ir_text: "",
      object_text: "",
      sections: [],
      symbols: [],
      relocations: [],
      diagnostics: [llvm_diagnostic(LlvmDiagnosticLevel.Error, "llvm.object.invalid", "cannot build LLVM object from invalid IR unit", "llvm")],
      module_count: len(unit.modules),
      function_count: 0,
      valid: false
    };
  }

  let diagnostics: [LlvmDiagnostic] = llvm_profile_diagnostics(options);
  let toolchain_status: LlvmToolchainStatus = llvm_toolchain_status(toolchain, options.packaging, options.prefer_native_toolchain);
  if options.prefer_native_toolchain and not toolchain_status.valid {
    let native_diagnostics: [LlvmDiagnostic] = diagnostics;
    let object_stage: string = if options.packaging == "object" { "native object emission" } else { "native object/link emission" };
    let built_native_diagnostics: [LlvmDiagnostic] = native_diagnostics + [
      llvm_diagnostic(LlvmDiagnosticLevel.Error, "llvm.native.toolchain.required", object_stage + " requested but unavailable", "llvm")
    ];
    let final_native_diagnostics: [LlvmDiagnostic] = if not toolchain_status.native_object_ready {
      built_native_diagnostics + [llvm_diagnostic(LlvmDiagnosticLevel.Error, "llvm.native.object.unavailable", "native object emission requested without clang path", "llvm")]
    } else {
      built_native_diagnostics
    };
    let final_link_diagnostics: [LlvmDiagnostic] = if options.packaging != "object" and not toolchain_status.native_link_ready {
      final_native_diagnostics + [llvm_diagnostic(LlvmDiagnosticLevel.Error, "llvm.native.link.unavailable", toolchain_status.summary, "llvm")]
    } else {
      final_native_diagnostics
    };
    give LlvmObjectResult {
      target: options.target,
      object_format: "llvm-object",
      ir_text: ir_result.ir_text,
      object_text: "",
      sections: [],
      symbols: [],
      relocations: [],
      diagnostics: final_link_diagnostics,
      module_count: len(unit.modules),
      function_count: 0,
      valid: false
    };
  }
  let built_diagnostics: [LlvmDiagnostic] = diagnostics;
  if options.prefer_native_toolchain and not toolchain_status.native_object_ready {
    set built_diagnostics = built_diagnostics + [llvm_diagnostic(LlvmDiagnosticLevel.Warning, "llvm.native.object.unavailable", "native object emission requested without clang path", "llvm")];
  }
  if options.prefer_native_toolchain and not toolchain_status.native_link_ready and options.packaging != "object" {
    set built_diagnostics = built_diagnostics + [llvm_diagnostic(LlvmDiagnosticLevel.Warning, "llvm.native.link.unavailable", toolchain_status.summary, "llvm")];
  }
  let text_section_offset: u64 = 64;
  let text_content: string = ir_result.ir_text;
  let text_section: LlvmObjectSection = llvm_section(1, ".text", LlvmSectionKind.Text, 16, text_section_offset, text_content);
  let symtab_offset: u64 = text_section.offset + text_section.size;
  let strtab_offset: u64 = symtab_offset + 128;
  let reloc_offset: u64 = strtab_offset + 128;
  let debug_offset: u64 = reloc_offset + 128;
  let metadata_offset: u64 = if options.emit_debug_sections { debug_offset + 128 } else { reloc_offset + 128 };
  let metadata_text: string = llvm_kv("opt", options.opt_level) + "," + llvm_kv("pgo", options.pgo_mode);

  let sections: [LlvmObjectSection] = [
    text_section,
    llvm_section(2, ".symtab", LlvmSectionKind.SymbolTable, 8, symtab_offset, "llvm symtab"),
    llvm_section(3, ".strtab", LlvmSectionKind.StringTable, 1, strtab_offset, "llvm strtab"),
    llvm_section(4, ".rela.text", LlvmSectionKind.Relocation, 8, reloc_offset, "llvm relocations"),
    llvm_section(5, ".llvm.meta", LlvmSectionKind.Metadata, 8, metadata_offset, metadata_text)
  ];
  let built_sections: [LlvmObjectSection] = if options.emit_debug_sections {
    sections + [llvm_section(6, ".debug_info", LlvmSectionKind.Debug, 1, debug_offset, "dwarf-like debug info")]
  } else {
    sections
  };

  let symbols: [LlvmObjectSymbol] = [];
  let relocations: [LlvmObjectRelocation] = [];
  let built_symbols: [LlvmObjectSymbol] = symbols;
  let built_relocations: [LlvmObjectRelocation] = relocations;
  let next_symbol_id: u64 = 1;
  let next_relocation_id: u64 = 1;
  let current_offset: u64 = 0;
  let function_count: u64 = 0;
  let i: u64 = 0;
  while i < len(unit.modules) {
    let module0: IrModule = unit.modules[i];
    let j: u64 = 0;
    while j < len(module0.functions) {
      let fn0: IrFunction = module0.functions[j];
      let fn_size: u64 = function_text_size(fn0);
      set built_symbols = built_symbols + [llvm_symbol(next_symbol_id, fn0.name, 1, current_offset, fn_size, true, true)];
      set next_symbol_id = next_symbol_id + 1;
      let k: u64 = 0;
      while k < len(fn0.blocks) {
        let block0: IrBlock = fn0.blocks[k];
        let m: u64 = 0;
        while m < len(block0.instructions) {
          let instruction: IrInstruction = block0.instructions[m];
          if instruction.kind == IrInstructionKind.Call {
            let relocation_stride: u64 = m * 4;
            let relocation_offset: u64 = current_offset + relocation_stride;
            set built_relocations = built_relocations + [llvm_relocation(next_relocation_id, 1, relocation_offset, "R_CALL64", instruction.text, 0, true)];
            set next_relocation_id = next_relocation_id + 1;
          }
          set m = m + 1;
        }
        set k = k + 1;
      }
      set current_offset = current_offset + fn_size;
      set function_count = function_count + 1;
      set j = j + 1;
    }
    set i = i + 1;
  }

  give LlvmObjectResult {
    target: options.target,
    object_format: "llvm-object",
    ir_text: ir_result.ir_text,
    object_text: llvm_object_text(built_sections, built_symbols, built_relocations, built_diagnostics, options),
    sections: built_sections,
    symbols: built_symbols,
    relocations: built_relocations,
    diagnostics: built_diagnostics,
    module_count: len(unit.modules),
    function_count: function_count,
    valid: len(built_sections) >= 5 and len(built_symbols) == function_count
  };
}
