                phase_name(
                    diagnostic.phase
                )
            )
        ),

        json_key_value(
            "family",
            json_quote(
                diagnostic_code_family(
                    diagnostic.phase,
                    diagnostic.code
                )
            )
        ),

        json_key_value(
            "strategy",
            json_quote(
                diagnostic_correction_strategy(
                    diagnostic.phase,
