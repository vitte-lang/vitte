<<<
    JSON serialization layer for Vitte diagnostics.
>>>

space vitte/compiler/diagnostics/json

use vitte/compiler/diagnostics/diagnostic.{
    Diagnostic,
    DiagnosticReport,
    DiagnosticEnvelope,
    DiagnosticSeverity,
    DiagnosticPhase,
    DiagnosticLabel,
    DiagnosticLabelKind,
    DiagnosticNote,
    DiagnosticHelp,
    DiagnosticSuggestion,
    DiagnosticSuggestionKind,
    DiagnosticFixPlan,
    DiagnosticQuality,
    SourceSpan,
    severity_name,
    phase_name,
    label_kind_name,
    suggestion_kind_name,
    suggestion_strategy_name,
    applicability_name,
    fix_kind_name,
    diagnostic_code_family,
    diagnostic_correction_strategy,
    diagnostic_recovery_scope,
    diagnostic_confidence,
    diagnostic_counterfactual_outcome_name,
    diagnostic_fix_plans,
    diagnostic_quality,
    diagnostic_schema_version,
    diagnostic_kind_name
}

proc json_control_escape(ch: string) -> string {
    if ch == "\u0000" { give "\\u0000"; }
    if ch == "\u0001" { give "\\u0001"; }
    if ch == "\u0002" { give "\\u0002"; }
    if ch == "\u0003" { give "\\u0003"; }
    if ch == "\u0004" { give "\\u0004"; }
    if ch == "\u0005" { give "\\u0005"; }
    if ch == "\u0006" { give "\\u0006"; }
    if ch == "\u0007" { give "\\u0007"; }
    if ch == "\u000b" { give "\\u000b"; }
    if ch == "\u000e" { give "\\u000e"; }
    if ch == "\u000f" { give "\\u000f"; }
    if ch == "\u0010" { give "\\u0010"; }
    if ch == "\u0011" { give "\\u0011"; }
    if ch == "\u0012" { give "\\u0012"; }
    if ch == "\u0013" { give "\\u0013"; }
    if ch == "\u0014" { give "\\u0014"; }
    if ch == "\u0015" { give "\\u0015"; }
    if ch == "\u0016" { give "\\u0016"; }
    if ch == "\u0017" { give "\\u0017"; }
    if ch == "\u0018" { give "\\u0018"; }
    if ch == "\u0019" { give "\\u0019"; }
    if ch == "\u001a" { give "\\u001a"; }
    if ch == "\u001b" { give "\\u001b"; }
    if ch == "\u001c" { give "\\u001c"; }
    if ch == "\u001d" { give "\\u001d"; }
    if ch == "\u001e" { give "\\u001e"; }
    if ch == "\u001f" { give "\\u001f"; }
    give "";
}

proc json_escape(text: string) -> string {
    let out: string = "";
    let i: u64 = 0;

    while i < len(text) {
        let ch: string = slice(text, i, i + 1);

        if ch == "\\" {
            set out = out + "\\\\";
        } elif ch == "\"" {
            set out = out + "\\\"";
        } elif ch == "\n" {
            set out = out + "\\n";
        } elif ch == "\r" {
            set out = out + "\\r";
        } elif ch == "\t" {
            set out = out + "\\t";
        } elif ch == "\u0008" {
            set out = out + "\\b";
        } elif ch == "\u000c" {
            set out = out + "\\f";
        } else {
            let control: string = json_control_escape(ch);
            set out = out + if control != "" { control } else { ch };
        }

        set i = i + 1;
    }

    give out;
}

proc json_quote(text: string) -> string {
    give "\"" + json_escape(text) + "\"";
}

proc json_bool(value: bool) -> string {
    if value {
        give "true";
    }

    give "false";
}

proc json_key_value(key: string, value: string) -> string {
    give json_quote(key) + ": " + value;
}

proc json_join(values: [string]) -> string {
    let out: string = "";
    let i: u64 = 0;

    while i < len(values) {
        if i > 0 {
            set out = out + ", ";
        }

        set out = out + values[i];
        set i = i + 1;
    }

    give out;
}

proc json_array(values: [string]) -> string {
    give "[" + json_join(values) + "]";
}

proc json_object(fields: [string]) -> string {
    give "{ " + json_join(fields) + " }";
}

proc json_string_array(values: [string]) -> string {
    let encoded: [string] = [];
    let i: u64 = 0;

    while i < len(values) {
        set encoded = encoded + [json_quote(values[i])];

        set i = i + 1;
    }

    give json_array(encoded);
}

proc json_phase_array(values: [DiagnosticPhase]) -> string {
    let encoded: [string] = [];
    let i: u64 = 0;

    while i < len(values) {
        set encoded = encoded + [json_quote(phase_name(values[i]))];
        set i = i + 1;
    }

    give json_array(encoded);
}

proc json_optional_string(value: string) -> string {
    give json_quote(value);
}

proc json_source_span(span: SourceSpan) -> string {
    give json_object([
        json_key_value("file", json_quote(span.file)),
        json_key_value("start_line", to_string(span.start_line)),
        json_key_value("start_column", to_string(span.start_column)),
        json_key_value("end_line", to_string(span.end_line)),
        json_key_value("end_column", to_string(span.end_column)),
        json_key_value("length", to_string(span.length)),
        json_key_value("valid", json_bool(span.valid))
    ]);
}

proc json_source_spans(spans: [SourceSpan]) -> string {
    let encoded: [string] = [];
    let i: u64 = 0;

    while i < len(spans) {
        set encoded = encoded + [json_source_span(spans[i])];
        set i = i + 1;
    }

    give json_array(encoded);
}

proc json_label(label: DiagnosticLabel) -> string {
    give json_object([
        json_key_value(
            "kind",
            json_quote(
                label_kind_name(label.kind)
            )
        ),

        json_key_value(
            "message",
            json_quote(label.message)
        ),

        json_key_value(
            "span",
            json_source_span(label.span)
        ),

        json_key_value(
            "primary",
            json_bool(label.primary)
        ),

        json_key_value(
            "valid",
            json_bool(label.valid)
        )
    ]);
}

proc json_labels(labels: [DiagnosticLabel]) -> string {
    let encoded: [string] = [];
    let i: u64 = 0;

    while i < len(labels) {
        set encoded = encoded + [json_label(labels[i])];

        set i = i + 1;
    }

    give json_array(encoded);
}

