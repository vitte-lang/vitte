        json_key_value(
            "message",
            json_quote(
                diagnostic.message
            )
        ),

        json_key_value(
            "explanation",
            json_optional_string(
                diagnostic.explanation
            )
        ),

        json_key_value(
            "technical_note",
            json_optional_string(
                diagnostic.technical_note
            )
        ),

        json_key_value(
            "span",
            json_source_span(
                diagnostic.span
            )
        ),

        json_key_value(
            "primary_span",
            json_source_span(
                diagnostic.primary_span
            )
        ),

        json_key_value(
            "secondary_spans",
            json_source_spans(
                diagnostic.secondary_spans
            )
        ),

        json_key_value(
            "labels",
            json_labels(
                diagnostic.labels
            )
        ),

        json_key_value(
            "notes",
            json_notes(
                diagnostic.notes
            )
        ),

        json_key_value(
            "helps",
            json_helps(
                diagnostic.helps
            )
        ),

        json_key_value(
            "suggestions",
