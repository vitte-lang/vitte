        json_key_value(
            "kind",
            json_quote(
                suggestion_kind_name(
                    suggestion.kind
                )
            )
        ),

        json_key_value(
            "message",
            json_quote(
                suggestion.message
            )
        ),

        json_key_value(
            "replacement",
            json_quote(
                suggestion.replacement
            )
        ),

        json_key_value(
            "machine_applicable",
            json_bool(
                suggestion.machine_applicable
            )
        ),

        json_key_value(
            "applicability",
            json_quote(
                applicability_name(
                    suggestion.applicability
                )
            )
        ),

        json_key_value(
            "confidence",
            json_quote(
                suggestion.confidence
            )
        ),

        json_key_value(
            "reason",
            json_quote(
                suggestion.reason
            )
        ),

        json_key_value(
            "strategy",
            json_quote(
                suggestion_strategy_name(
                    suggestion.strategy
                )
            )
        ),

        json_key_value(
            "proof",
            json_quote(
                suggestion.proof
            )
        ),

        json_key_value(
            "verified_phases",
            json_phase_array(
                suggestion.verified_phases
            )
        ),

        json_key_value(
            "risk",
            json_quote(
                suggestion.risk
            )
        ),

        json_key_value(
            "score",
            to_string(suggestion.public_score)
        ),

        json_key_value(
            "net_score",
            json_quote(
                suggestion.net_score
            )
        ),

        json_key_value(
            "errors_removed",
            to_string(suggestion.errors_removed)
        ),

        json_key_value(
            "new_errors",
            to_string(suggestion.new_errors)
        ),

        json_key_value(
            "error_moved",
            json_bool(
                suggestion.error_moved
            )
        ),

        json_key_value(
            "behavior_changed",
            json_bool(
                suggestion.behavior_changed
            )
        ),

        json_key_value(
            "before_fingerprint",
            json_quote(
                suggestion.before_fingerprint
            )
        ),

        json_key_value(
            "after_fingerprint",
            json_quote(
                suggestion.after_fingerprint
            )
        ),

        json_key_value(
            "structural_fingerprint",
            json_quote(
                suggestion.structural_fingerprint
            )
        ),

        json_key_value(
            "span",
            json_source_span(
                suggestion.span
            )
        ),

        json_key_value(
            "secondary_spans",
            json_source_spans(
                suggestion.secondary_spans
            )
        ),

        json_key_value(
            "counterfactual_verified",
            json_bool(
                suggestion.counterfactual_verified
            )
        ),

        json_key_value(
            "counterfactual_rank",
            to_string(suggestion.counterfactual_rank)
        ),

        json_key_value(
            "counterfactual_errors_removed",
            to_string(suggestion.counterfactual_errors_removed)
        ),

        json_key_value(
            "counterfactual_total_errors",
            to_string(suggestion.counterfactual_total_errors)
        ),

        json_key_value(
            "counterfactual_outcomes",
            json_counterfactual_outcomes(
                suggestion.counterfactual_outcomes
            )
        ),

        json_key_value(
            "counterfactual_report",
            json_quote(
                suggestion.counterfactual_report
            )
        ),

        json_key_value(
            "valid",
            json_bool(
                suggestion.valid
            )
        )
    ]);
}

proc json_suggestions(suggestions: [DiagnosticSuggestion]) -> string {
    let encoded: [string] = [];
    let i: u64 = 0;

    while i < len(suggestions) {
        set encoded = encoded + [json_suggestion(suggestions[i])];

        set i = i + 1;
    }

    give json_array(encoded);
}

proc json_quality(quality: DiagnosticQuality) -> string {
    give json_object([
        json_key_value("score", to_string(quality.score)),
        json_key_value("span_score", to_string(quality.span_score)),
        json_key_value("context_score", to_string(quality.context_score)),
        json_key_value("fix_score", to_string(quality.fix_score)),
        json_key_value("stability_score", to_string(quality.stability_score)),
        json_key_value("cascade_score", to_string(quality.cascade_score)),
        json_key_value("valid", json_bool(quality.valid))
    ]);
}

proc json_fix(plan: DiagnosticFixPlan) -> string {
    give json_object([
        json_key_value("id", json_quote(plan.id)),
        json_key_value("kind", json_quote(fix_kind_name(plan.kind))),
        json_key_value("message", json_quote(plan.message)),
        json_key_value("replacement", json_quote(plan.replacement)),
        json_key_value("machine_applicable", json_bool(plan.machine_applicable)),
        json_key_value("confidence", json_quote(plan.confidence)),
        json_key_value("reason", json_quote(plan.reason)),
        json_key_value("counterfactual_verified", json_bool(plan.counterfactual_verified)),
        json_key_value("counterfactual_report", json_quote(plan.counterfactual_report)),
        json_key_value("span", json_source_span(plan.span)),
        json_key_value("secondary_spans", json_source_spans(plan.secondary_spans)),
        json_key_value("valid", json_bool(plan.valid))
    ]);
}

proc json_fixes(plans: [DiagnosticFixPlan]) -> string {
    let encoded: [string] = [];
    let i: u64 = 0;

    while i < len(plans) {
        set encoded = encoded + [json_fix(plans[i])];
        set i = i + 1;
    }

    give json_array(encoded);
}

proc json_diagnostic_id(diagnostic: Diagnostic) -> string {
    give diagnostic.code + ":" + diagnostic.span.file + ":" + to_string(diagnostic.span.start_line) + ":" + to_string(diagnostic.span.start_column);
}

proc json_diagnostic_location(diagnostic: Diagnostic) -> string {
    give diagnostic.span.file + ":" + to_string(diagnostic.span.start_line) + ":" + to_string(diagnostic.span.start_column);
}

proc json_diagnostic_help_text(diagnostic: Diagnostic) -> string {
    if len(diagnostic.helps) > 0 {
        give diagnostic.helps[0].message;
    }
    give diagnostic.probable_fix;
}

proc json_diagnostic_fix_text(diagnostic: Diagnostic) -> string {
    if diagnostic.probable_fix != "" {
        give diagnostic.probable_fix;
    }
    if len(diagnostic.suggestions) > 0 {
        give diagnostic.suggestions[0].message;
    }
    give json_diagnostic_help_text(diagnostic);
}

proc json_diagnostic(diagnostic: Diagnostic) -> string {
    give json_object([
        json_key_value(
            "code",
            json_quote(
                diagnostic.code
            )
        ),

        json_key_value(
            "id",
            json_quote(
                json_diagnostic_id(diagnostic)
            )
        ),

        json_key_value(
            "category",
            json_quote(
                phase_name(diagnostic.phase)
            )
        ),

        json_key_value(
            "fluent_key",
            json_quote(
                diagnostic.code
            )
        ),

        json_key_value(
            "location",
            json_quote(
                json_diagnostic_location(diagnostic)
            )
        ),

        json_key_value(
            "severity",
            json_quote(
                severity_name(
                    diagnostic.severity
                )
            )
        ),

