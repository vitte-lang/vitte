}

proc json_diagnostics(diagnostics: [Diagnostic]) -> string {
    let encoded: [string] = [];
    let i: u64 = 0;

    while i < len(diagnostics) {
        set encoded = encoded + [json_diagnostic(diagnostics[i])];

        set i = i + 1;
    }

    give json_array(encoded);
}

proc json_report(report: DiagnosticReport) -> string {
    give json_object([
        json_key_value(
            "valid",
            json_bool(report.valid)
        ),

        json_key_value(
            "error_count",
            to_string(report.error_count)
        ),

        json_key_value(
            "warning_count",
            to_string(report.warning_count)
        ),

        json_key_value(
            "fatal_count",
            to_string(report.fatal_count)
        ),

        json_key_value(
            "root_count",
            to_string(report.root_count)
        ),

        json_key_value(
            "cascade_count",
            to_string(report.cascade_count)
        ),

        json_key_value(
            "suppressed_cascade_count",
            to_string(report.suppressed_cascade_count)
        ),

        json_key_value(
            "duplicate_count",
            to_string(report.duplicate_count)
        ),

        json_key_value(
            "recovery_possible",
            json_bool(report.recovery_possible)
        ),

        json_key_value(
            "quality_score",
            to_string(report.quality_score)
        ),

        json_key_value(
            "causality",
            json_object([
                json_key_value("root_count", to_string(report.root_count)),
                json_key_value("cascade_count", to_string(report.cascade_count)),
                json_key_value("suppressed_cascade_count", to_string(report.suppressed_cascade_count)),
                json_key_value("duplicate_count", to_string(report.duplicate_count)),
                json_key_value("recovery_possible", json_bool(report.recovery_possible))
            ])
        ),

        json_key_value(
            "diagnostics",
            json_diagnostics(
                report.diagnostics
            )
        )
    ]);
}

proc json_envelope(envelope: DiagnosticEnvelope) -> string {
    give json_object([
        json_key_value("schema", json_quote(envelope.schema)),
        json_key_value("schema_version", json_quote(envelope.schema_version)),
        json_key_value("producer", json_quote(envelope.producer)),
        json_key_value("command", json_quote(envelope.command)),
        json_key_value("source", json_quote(envelope.source)),
        json_key_value("quality_score", to_string(envelope.report.quality_score)),
        json_key_value(
            "causality",
            json_object([
                json_key_value("root_count", to_string(envelope.report.root_count)),
                json_key_value("cascade_count", to_string(envelope.report.cascade_count)),
                json_key_value("suppressed_cascade_count", to_string(envelope.report.suppressed_cascade_count)),
                json_key_value("duplicate_count", to_string(envelope.report.duplicate_count)),
                json_key_value("recovery_possible", json_bool(envelope.report.recovery_possible))
            ])
        ),
        json_key_value("report", json_report(envelope.report)),
        json_key_value("valid", json_bool(envelope.valid))
    ]);
}

proc json_report_envelope_with_canonical_context(report: DiagnosticReport, producer: string, command: string, source: string, pipeline_failed_at: string, pipeline_failure_reason: string, validation_reason: string) -> string {
    give json_object([
        json_key_value("schema", json_quote("vitte.diagnostics")),
        json_key_value("schema_version", json_quote(diagnostic_schema_version())),
        json_key_value("producer", json_quote(producer)),
        json_key_value("command", json_quote(command)),
        json_key_value("source", json_quote(source)),
        json_key_value("pipeline_failed_at", json_quote(pipeline_failed_at)),
        json_key_value("pipeline_failure_reason", json_quote(pipeline_failure_reason)),
        json_key_value("validation_reason", json_quote(validation_reason)),
        json_key_value("quality_score", to_string(report.quality_score)),
        json_key_value(
            "causality",
            json_object([
                json_key_value("root_count", to_string(report.root_count)),
                json_key_value("cascade_count", to_string(report.cascade_count)),
                json_key_value("suppressed_cascade_count", to_string(report.suppressed_cascade_count)),
                json_key_value("duplicate_count", to_string(report.duplicate_count)),
                json_key_value("recovery_possible", json_bool(report.recovery_possible))
            ])
        ),
        json_key_value("report", json_report(report)),
        json_key_value("valid", json_bool(report.valid))
    ]);
}

proc json_report_envelope(report: DiagnosticReport, producer: string, command: string, source: string) -> string {
    give json_report_envelope_with_canonical_context(report, producer, command, source, "none", "none", "none");
}

proc json_diagnostic_output(report: DiagnosticReport, command: string, source: string) -> string {
    give json_report_envelope_with_canonical_context(
        report,
        "vitte",
        command,
        source,
        "none",
        "canonical Diagnostic JSON renderer",
        "diagnostics are serialized from the shared DiagnosticReport"
    );
}

proc json_compact_diagnostic(diagnostic: Diagnostic) -> string {
    give json_object([
        json_key_value(
            "code",
            json_quote(
                diagnostic.code
            )
        ),

        json_key_value(
            "severity",
            json_quote(
                severity_name(
                    diagnostic.severity
                )
            )
        ),

        json_key_value(
            "message",
            json_quote(
                diagnostic.message
            )
        ),

        json_key_value(
            "file",
            json_quote(
                diagnostic.span.file
            )
        ),

        json_key_value(
            "line",
            to_string(diagnostic.span.start_line)
        ),

        json_key_value(
            "column",
            to_string(diagnostic.span.start_column)
        )
    ]);
}

proc json_compact_report(report: DiagnosticReport) -> string {
    let encoded: [string] = [];
    let i: u64 = 0;

    while i < len(report.diagnostics) {
        set encoded = encoded + [json_compact_diagnostic(report.diagnostics[i])];

        set i = i + 1;
    }

    give json_object([
        json_key_value(
            "valid",
            json_bool(report.valid)
        ),

        json_key_value(
            "diagnostics",
            json_array(encoded)
        )
    ]);
}

proc json_summary(report: DiagnosticReport) -> string {
    give json_object([
        json_key_value(
            "errors",
            to_string(report.error_count)
        ),

        json_key_value(
            "warnings",
            to_string(report.warning_count)
        ),

        json_key_value(
            "fatals",
            to_string(report.fatal_count)
        ),

        json_key_value(
            "valid",
            json_bool(report.valid)
        )
    ]);
}

