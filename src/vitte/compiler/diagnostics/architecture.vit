space vitte/compiler/diagnostics/architecture

use vitte/compiler/diagnostics/diagnostic.{
  Diagnostic,
  DiagnosticPhase,
  DiagnosticReport,
  DiagnosticSeverity,
  SourceSpan,
  diagnostic_add_pipeline_context,
  diagnostic_create,
  diagnostic_localized,
  diagnostic_report,
  diagnostic_with_probable_fix,
  diagnostic_with_root_cause,
  diagnostic_with_rule,
  phase_name
}
use vitte/compiler/diagnostics/json.{ json_key_value, json_object, json_quote, json_report }
use vitte/compiler/diagnostics/lsp.{ lsp_publish_diagnostics_json_rpc, span_uri }
use vitte/compiler/diagnostics/render.{ RenderColorMode, render_terminal_report }
use vitte/compiler/infrastructure/diagnostics/fluent_catalog.{ fluent_catalog_message_or }

pick CompilerDiagnosticStage {
  Cli
  Io
  Lexer
  Parser
  Resolver
  Sema
  TypeChecker
  BorrowChecker
  Mir
  Ir
  Backend
  Linker
}

form CompilerDiagnosticOrigin {
  stage: CompilerDiagnosticStage
  phase: DiagnosticPhase
  component: string
  rule: string
  valid: bool
}

form CompilerDiagnosticSurface {
  report: DiagnosticReport
  text: string
  json: string
  lsp: string
  locale: string
  command: string
  source: string
  valid: bool
}

proc canonical_diagnostic_stage_count() -> u64 {
  give 12 as u64;
}

proc stage_name(stage: CompilerDiagnosticStage) -> string {
  if stage == CompilerDiagnosticStage.Cli {
    give "cli";
  }
  if stage == CompilerDiagnosticStage.Io {
    give "io";
  }
  if stage == CompilerDiagnosticStage.Lexer {
    give "lexer";
  }
  if stage == CompilerDiagnosticStage.Parser {
    give "parser";
  }
  if stage == CompilerDiagnosticStage.Resolver {
    give "resolver";
  }
  if stage == CompilerDiagnosticStage.Sema {
    give "sema";
  }
  if stage == CompilerDiagnosticStage.TypeChecker {
    give "type_checker";
  }
  if stage == CompilerDiagnosticStage.BorrowChecker {
    give "borrow_checker";
  }
  if stage == CompilerDiagnosticStage.Mir {
    give "mir";
  }
  if stage == CompilerDiagnosticStage.Ir {
    give "ir";
  }
  if stage == CompilerDiagnosticStage.Backend {
    give "backend";
  }
  give "linker";
}

proc stage_phase(stage: CompilerDiagnosticStage) -> DiagnosticPhase {
  if stage == CompilerDiagnosticStage.Cli {
    give DiagnosticPhase.Cli;
  }
  if stage == CompilerDiagnosticStage.Io {
    give DiagnosticPhase.Io;
  }
  if stage == CompilerDiagnosticStage.Lexer {
    give DiagnosticPhase.Lexer;
  }
  if stage == CompilerDiagnosticStage.Parser {
    give DiagnosticPhase.Parser;
  }
  if stage == CompilerDiagnosticStage.Resolver {
    give DiagnosticPhase.SymbolResolution;
  }
  if stage == CompilerDiagnosticStage.Sema {
    give DiagnosticPhase.Sema;
  }
  if stage == CompilerDiagnosticStage.TypeChecker {
    give DiagnosticPhase.Typeck;
  }
  if stage == CompilerDiagnosticStage.BorrowChecker {
    give DiagnosticPhase.Borrowck;
  }
  if stage == CompilerDiagnosticStage.Mir {
    give DiagnosticPhase.Mir;
  }
  if stage == CompilerDiagnosticStage.Ir {
    give DiagnosticPhase.Ir;
  }
  if stage == CompilerDiagnosticStage.Backend {
    give DiagnosticPhase.Backend;
  }
  give DiagnosticPhase.Linker;
}

proc stage_component(stage: CompilerDiagnosticStage) -> string {
  if stage == CompilerDiagnosticStage.Cli {
    give "driver.cli";
  }
  if stage == CompilerDiagnosticStage.Io {
    give "driver.io";
  }
  if stage == CompilerDiagnosticStage.Lexer {
    give "frontend.lexer";
  }
  if stage == CompilerDiagnosticStage.Parser {
    give "frontend.parser";
  }
  if stage == CompilerDiagnosticStage.Resolver {
    give "analysis.resolver";
  }
  if stage == CompilerDiagnosticStage.Sema {
    give "analysis.sema";
  }
  if stage == CompilerDiagnosticStage.TypeChecker {
    give "middle.typecheck";
  }
  if stage == CompilerDiagnosticStage.BorrowChecker {
    give "middle.borrow";
  }
  if stage == CompilerDiagnosticStage.Mir {
    give "middle.mir";
  }
  if stage == CompilerDiagnosticStage.Ir {
    give "backend.ir";
  }
  if stage == CompilerDiagnosticStage.Backend {
    give "backend.codegen";
  }
  give "backend.linker";
}

proc stage_rule(stage: CompilerDiagnosticStage) -> string {
  if stage == CompilerDiagnosticStage.Cli {
    give "command line contract";
  }
  if stage == CompilerDiagnosticStage.Io {
    give "input output contract";
  }
  if stage == CompilerDiagnosticStage.Lexer {
    give "token stream";
  }
  if stage == CompilerDiagnosticStage.Parser {
    give "syntax tree";
  }
  if stage == CompilerDiagnosticStage.Resolver {
    give "name resolution";
  }
  if stage == CompilerDiagnosticStage.Sema {
    give "semantic contract";
  }
  if stage == CompilerDiagnosticStage.TypeChecker {
    give "type contract";
  }
  if stage == CompilerDiagnosticStage.BorrowChecker {
    give "ownership contract";
  }
  if stage == CompilerDiagnosticStage.Mir {
    give "middle ir contract";
  }
  if stage == CompilerDiagnosticStage.Ir {
    give "backend ir contract";
  }
  if stage == CompilerDiagnosticStage.Backend {
    give "code generation contract";
  }
  give "link contract";
}

proc stage_root_cause(stage: CompilerDiagnosticStage) -> string {
  give stage_component(stage) + " rejected " + stage_rule(stage);
}

proc stage_probable_fix(stage: CompilerDiagnosticStage) -> string {
  if stage == CompilerDiagnosticStage.Cli {
    give "repair the command arguments before invoking the compiler pipeline";
  }
  if stage == CompilerDiagnosticStage.Io {
    give "repair the input path, permissions, or output destination before compilation";
  }
  if stage == CompilerDiagnosticStage.Lexer {
    give "repair the highlighted token before parser recovery";
  }
  if stage == CompilerDiagnosticStage.Parser {
    give "repair the highlighted grammar shape before AST lowering";
  }
  if stage == CompilerDiagnosticStage.Resolver {
    give "bind the highlighted name through scope or imports before semantic analysis";
  }
  if stage == CompilerDiagnosticStage.Sema {
    give "repair the semantic invariant before type checking";
  }
  if stage == CompilerDiagnosticStage.TypeChecker {
    give "make the highlighted expression satisfy its required type contract";
  }
  if stage == CompilerDiagnosticStage.BorrowChecker {
    give "repair the ownership transition before MIR validation";
  }
  if stage == CompilerDiagnosticStage.Mir {
    give "repair the MIR invariant before backend lowering";
  }
  if stage == CompilerDiagnosticStage.Ir {
    give "repair the IR invariant before object emission";
  }
  if stage == CompilerDiagnosticStage.Backend {
    give "repair backend inputs before object emission";
  }
  give "repair object symbols and libraries before final link";
}

proc compiler_diagnostic_stage_from_code(code: string) -> CompilerDiagnosticStage {
  if starts_with(code, "E_CLI_") or starts_with(code, "DRIVER_") {
    give CompilerDiagnosticStage.Cli;
  }
  if starts_with(code, "E_IO_") {
    give CompilerDiagnosticStage.Io;
  }
  if starts_with(code, "LEX") or starts_with(code, "FLEX") {
    give CompilerDiagnosticStage.Lexer;
  }
  if starts_with(code, "PARSE_") or starts_with(code, "P") or starts_with(code, "E00") {
    give CompilerDiagnosticStage.Parser;
  }
  if starts_with(code, "MOD_") or starts_with(code, "MODULE_") or starts_with(code, "RESOLVE_") {
    give CompilerDiagnosticStage.Resolver;
  }
  if starts_with(code, "SEMA_") {
    give CompilerDiagnosticStage.Sema;
  }
  if starts_with(code, "TYPECK_") or starts_with(code, "TYPE_") {
    give CompilerDiagnosticStage.TypeChecker;
  }
  if starts_with(code, "BORROWCK_") or starts_with(code, "OWNERSHIP_") or starts_with(code, "LIFETIME_") {
    give CompilerDiagnosticStage.BorrowChecker;
  }
  if starts_with(code, "MIR_") {
    give CompilerDiagnosticStage.Mir;
  }
  if starts_with(code, "IR_") {
    give CompilerDiagnosticStage.Ir;
  }
  if starts_with(code, "BACKEND_") {
    give CompilerDiagnosticStage.Backend;
  }
  if starts_with(code, "LINK_") or starts_with(code, "LINKER_") {
    give CompilerDiagnosticStage.Linker;
  }
  give CompilerDiagnosticStage.Sema;
}

proc compiler_diagnostic_origin(stage: CompilerDiagnosticStage) -> CompilerDiagnosticOrigin {
  let phase: DiagnosticPhase = stage_phase(stage);
  give CompilerDiagnosticOrigin {
    stage: stage,
    phase: phase,
    component: stage_component(stage),
    rule: stage_rule(stage),
    valid: phase_name(phase) != "" and stage_component(stage) != ""
  };
}

proc compiler_diagnostic(stage: CompilerDiagnosticStage, code: string, severity: DiagnosticSeverity, message: string, span: SourceSpan) -> Diagnostic {
  let origin: CompilerDiagnosticOrigin = compiler_diagnostic_origin(stage);
  let diag0: Diagnostic = diagnostic_create(code, origin.phase, severity, message, span);
  let diag1: Diagnostic = diagnostic_with_rule(diag0, origin.rule);
  let diag2: Diagnostic = diagnostic_with_root_cause(diag1, stage_root_cause(stage));
  let diag3: Diagnostic = diagnostic_with_probable_fix(diag2, stage_probable_fix(stage));
  let diag4: Diagnostic = diagnostic_add_pipeline_context(diag3, "diagnostic_architecture=canonical");
  let diag5: Diagnostic = diagnostic_add_pipeline_context(diag4, "stage=" + stage_name(stage));
  let diag6: Diagnostic = diagnostic_add_pipeline_context(diag5, "component=" + origin.component);
  give diagnostic_add_pipeline_context(diag6, "canonical_phase=" + phase_name(origin.phase));
}

proc compiler_diagnostic_error(stage: CompilerDiagnosticStage, code: string, message_key: string, span: SourceSpan) -> Diagnostic {
  let code_message: string = fluent_catalog_message_or("en", code, message_key);
  let message: string = fluent_catalog_message_or("en", message_key, code_message);
  let diagnostic0: Diagnostic = compiler_diagnostic(stage, code, DiagnosticSeverity.Error, message, span);
  give diagnostic_add_pipeline_context(diagnostic0, "message_key=" + message_key);
}

proc compiler_diagnostic_cli_error(code: string, message_key: string, span: SourceSpan) -> Diagnostic {
  give compiler_diagnostic_error(CompilerDiagnosticStage.Cli, code, message_key, span);
}

proc compiler_diagnostic_io_error(code: string, message_key: string, span: SourceSpan) -> Diagnostic {
  give compiler_diagnostic_error(CompilerDiagnosticStage.Io, code, message_key, span);
}

proc compiler_diagnostic_backend_error(code: string, message_key: string, span: SourceSpan) -> Diagnostic {
  give compiler_diagnostic_error(CompilerDiagnosticStage.Backend, code, message_key, span);
}

proc compiler_diagnostic_linker_error(code: string, message_key: string, span: SourceSpan) -> Diagnostic {
  give compiler_diagnostic_error(CompilerDiagnosticStage.Linker, code, message_key, span);
}

proc compiler_diagnostic_report(diagnostics: [Diagnostic]) -> DiagnosticReport {
  give diagnostic_report(diagnostics);
}

proc compiler_diagnostic_localized_report(report: DiagnosticReport, lang: string) -> DiagnosticReport {
  let localized: [Diagnostic] = [];
  let i: u64 = 0;
  while i < len(report.diagnostics) {
    set localized = localized + [diagnostic_localized(report.diagnostics[i], lang)];
    set i = i + 1;
  }
  give diagnostic_report(localized);
}

proc compiler_diagnostic_json(command: string, source: string, report: DiagnosticReport) -> string {
  give json_object([
    json_key_value("schema", json_quote("vitte.compiler.diagnostics")),
    json_key_value("schema_version", json_quote("1.0.0")),
    json_key_value("command", json_quote(command)),
    json_key_value("source", json_quote(source)),
    json_key_value("status", json_quote(if report.valid { "ok" } else { "error" })),
    json_key_value("primary_report", json_report(report))
  ]);
}

proc compiler_diagnostic_surface(report: DiagnosticReport, lang: string, command: string, source: string) -> CompilerDiagnosticSurface {
  let localized: DiagnosticReport = compiler_diagnostic_localized_report(report, lang);
  let uri: string = if len(localized.diagnostics) > 0 { span_uri(localized.diagnostics[0].span) } elif source != "" { "file:///" + source } else { "file:///<cli>" };
  let text: string = render_terminal_report(localized, RenderColorMode.Never, 100 as u64);
  let json: string = compiler_diagnostic_json(command, source, localized);
  let lsp: string = lsp_publish_diagnostics_json_rpc(uri, localized);
  give CompilerDiagnosticSurface {
    report: localized,
    text: text,
    json: json,
    lsp: lsp,
    locale: lang,
    command: command,
    source: source,
    valid: len(localized.diagnostics) > 0 and text != "" and json != "" and lsp != ""
  };
}

proc compiler_diagnostic_render(report: DiagnosticReport, format: string, lang: string, command: string, source: string) -> string {
  let surface: CompilerDiagnosticSurface = compiler_diagnostic_surface(report, lang, command, source);
  if format == "json" {
    give surface.json;
  }
  if format == "lsp" {
    give surface.lsp;
  }
  give surface.text;
}

proc compiler_single_diagnostic_render(diagnostic: Diagnostic, format: string, lang: string, command: string, source: string) -> string {
  give compiler_diagnostic_render(diagnostic_report([diagnostic]), format, lang, command, source);
}

proc diagnostic_architecture_covers_required_stages() -> bool {
  give canonical_diagnostic_stage_count() == 12
    and stage_phase(CompilerDiagnosticStage.Cli) == DiagnosticPhase.Cli
    and stage_phase(CompilerDiagnosticStage.Io) == DiagnosticPhase.Io
    and stage_phase(CompilerDiagnosticStage.Lexer) == DiagnosticPhase.Lexer
    and stage_phase(CompilerDiagnosticStage.Parser) == DiagnosticPhase.Parser
    and stage_phase(CompilerDiagnosticStage.Resolver) == DiagnosticPhase.SymbolResolution
    and stage_phase(CompilerDiagnosticStage.Sema) == DiagnosticPhase.Sema
    and stage_phase(CompilerDiagnosticStage.TypeChecker) == DiagnosticPhase.Typeck
    and stage_phase(CompilerDiagnosticStage.BorrowChecker) == DiagnosticPhase.Borrowck
    and stage_phase(CompilerDiagnosticStage.Mir) == DiagnosticPhase.Mir
    and stage_phase(CompilerDiagnosticStage.Ir) == DiagnosticPhase.Ir
    and stage_phase(CompilerDiagnosticStage.Backend) == DiagnosticPhase.Backend
    and stage_phase(CompilerDiagnosticStage.Linker) == DiagnosticPhase.Linker;
}

share CompilerDiagnosticStage
share CompilerDiagnosticOrigin
share CompilerDiagnosticSurface
share canonical_diagnostic_stage_count
share stage_name
share stage_phase
share stage_component
share stage_rule
share stage_root_cause
share stage_probable_fix
share compiler_diagnostic_stage_from_code
share compiler_diagnostic_origin
share compiler_diagnostic
share compiler_diagnostic_error
share compiler_diagnostic_cli_error
share compiler_diagnostic_io_error
share compiler_diagnostic_backend_error
share compiler_diagnostic_linker_error
share compiler_diagnostic_report
share compiler_diagnostic_localized_report
share compiler_diagnostic_json
share compiler_diagnostic_surface
share compiler_diagnostic_render
share compiler_single_diagnostic_render
share diagnostic_architecture_covers_required_stages
