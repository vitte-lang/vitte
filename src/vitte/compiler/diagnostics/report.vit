space vitte/compiler/diagnostics/report

use vitte/compiler/infrastructure/diagnostics/fluent_catalog.{ fluent_catalog_lookup, fluent_catalog_normalize_locale }

form TextDiagnostic {
    severity: string
    code: string
    file: string
    line: u64
    column: u64
    message: string
    valid: bool
}

proc text_diagnostic(severity: string, code: string, file: string, line: u64, column: u64, message: string) -> TextDiagnostic {
    let sev: string = severity;
    let ln: u64 = line;
    let col: u64 = column;

    if sev == "" {
        set sev = "error";
    }
    if ln == 0 {
        set ln = 1 as u64;
    }
    if col == 0 {
        set col = 1 as u64;
    }

    give TextDiagnostic {
        severity: sev,
        code: code,
        file: file,
        line: ln,
        column: col,
        message: message,
        valid: code != "" and message != ""
    };
}

proc error_text(message: string) -> TextDiagnostic {
    give text_diagnostic("error", "DRIVER_E_TEXT", "", 1 as u64, 1 as u64, message);
}

proc ansi_reset() -> string {
    give "\u001b[0m";
}

proc ansi_bold() -> string {
    give "\u001b[1m";
}

proc ansi_bright_red() -> string {
    give "\u001b[91m";
}

proc ansi_yellow() -> string {
    give "\u001b[33m";
}

proc ansi_blue() -> string {
    give "\u001b[34m";
}

proc ansi_cyan() -> string {
    give "\u001b[36m";
}

proc report_eq() -> string {
    give slice("a=b", 1, 2);
}

proc colorize_severity(severity: string) -> string {
    let text: string = severity;

    if severity == "fatal" or severity == "error" {
        give ansi_bold() + ansi_bright_red() + text + ansi_reset();
    }

    if severity == "warning" {
        give ansi_bold() + ansi_yellow() + text + ansi_reset();
    }

    if severity == "note" {
        give ansi_blue() + text + ansi_reset();
    }

    if severity == "help" {
        give ansi_cyan() + text + ansi_reset();
    }

    give text;
}

proc render_text(diagnostic0: TextDiagnostic) -> string {
    let severity_text: string = colorize_severity(diagnostic0.severity);
    let line_text: string = diagnostic0.line as string;
    let column_text: string = diagnostic0.column as string;
    let span_text: string = diagnostic0.file + ":" + line_text + ":" + column_text;
    give "severity" + report_eq() + severity_text + " code" + report_eq() + diagnostic0.code + " span" + report_eq() + span_text + " message" + report_eq() + diagnostic0.message;
}

proc render_text_lang(diagnostic0: TextDiagnostic, lang: string) -> string {
    let locale: string = fluent_catalog_normalize_locale(lang);
    let localized: string = fluent_catalog_lookup(locale, diagnostic0.code);
    let message: string = if localized != "" { localized } else { diagnostic0.message };
    give render_text(text_diagnostic(diagnostic0.severity, diagnostic0.code, diagnostic0.file, diagnostic0.line, diagnostic0.column, message));
}

export *
