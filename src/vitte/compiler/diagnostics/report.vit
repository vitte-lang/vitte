space vitte/compiler/diagnostics/report

use vitte/compiler/diagnostics/architecture.{ compiler_diagnostic_error, compiler_diagnostic_stage_from_code, compiler_single_diagnostic_render }
use vitte/compiler/diagnostics/diagnostic.{ Diagnostic, DiagnosticSeverity, SourceSpan, span_create }

proc diagnostic(severity: string, code: string, file: string, line: u64, column: u64, message: string) -> Diagnostic {
    let source_file: string = if file != "" { file } else { "<cli>" };
    let source_line: u64 = if line > 0 { line } else { 1 as u64 };
    let source_column: u64 = if column > 0 { column } else { 1 as u64 };
    let span0: SourceSpan = span_create(source_file, source_line, source_column, 1 as u64);
    let diagnostic0: Diagnostic = compiler_diagnostic_error(compiler_diagnostic_stage_from_code(code), code, message, span0);

    if severity == "fatal" {
        set diagnostic0.severity = DiagnosticSeverity.Fatal;
        set diagnostic0.fatal = true;
    } elif severity == "warning" {
        set diagnostic0.severity = DiagnosticSeverity.Warning;
    } elif severity == "note" {
        set diagnostic0.severity = DiagnosticSeverity.Note;
    } elif severity == "help" {
        set diagnostic0.severity = DiagnosticSeverity.Help;
    }

    give diagnostic0;
}

proc error_text(message: string) -> Diagnostic {
    give diagnostic("error", "DRIVER_E_TEXT", "<cli>", 1 as u64, 1 as u64, message);
}

proc render_text(diagnostic0: Diagnostic) -> string {
    give compiler_single_diagnostic_render(diagnostic0, "terminal", "en", "check", diagnostic0.span.file);
}

proc render_text_lang(diagnostic0: Diagnostic, lang: string) -> string {
    give compiler_single_diagnostic_render(diagnostic0, "terminal", lang, "check", diagnostic0.span.file);
}

share Diagnostic
share diagnostic
share error_text
share render_text
share render_text_lang
