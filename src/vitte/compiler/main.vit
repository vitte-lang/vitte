space vitte/compiler/main

const VITTE_SOURCE_COMPILER: int = 1
const VERSION_TEXT: string = "vittec vitte-compiler 0.1.0"
const BANNER_TEXT: string = "vittec Vitte compiler driver"
const COMPILER_SOURCE_ROOT: string = "src/vitte/compiler"
const COMPILER_ENTRY_POINT: string = "src/vitte/compiler/main.vit"

use vitte/compiler/driver/compiler::{ run_cli_main_with_ice_boundary }
use vitte/compiler/infrastructure/session/panic_boundary.{
    PanicBoundaryState,
    native_panic_boundary_begin,
    native_panic_boundary_end,
    native_panic_boundary_mark_triggered,
    native_panic_boundary_ok,
}

proc version_text() -> string {
    give VERSION_TEXT
}

proc banner_text() -> string {
    give BANNER_TEXT
}

proc compiler_source_root() -> string {
    give COMPILER_SOURCE_ROOT
}

proc compiler_entry_point() -> string {
    give COMPILER_ENTRY_POINT
}

proc main(args: list[string]) -> int {
    let boundary0: PanicBoundaryState = native_panic_boundary_begin();
    let code: int = run_cli_main_with_ice_boundary(args);
    let mut boundary1: PanicBoundaryState = boundary0;
    if code == 2 {
        set boundary1 = native_panic_boundary_mark_triggered(boundary0, code);
    }
    let boundary2: PanicBoundaryState = native_panic_boundary_end(boundary1);
    if not native_panic_boundary_ok(boundary2) and code == 0 {
        give 2;
    }
    give code;
}

export *
