space vitte/stdlib/index

const STDLIB_ENTRYPOINT_SCHEMA: string = "vitte.stdlib.entrypoint.v1"
const STDLIB_SOURCE_ROOT: string = "src/vitte/stdlib"
const STDLIB_CANONICAL_ENTRYPOINT: string = "src/vitte/stdlib/index.vit"
const STDLIB_OFFICIAL_MANIFEST: string = "src/vitte/stdlib/modules.vitte.json"

const STDLIB_CORE_INDEX: string = "src/vitte/stdlib/core/index.vit"
const STDLIB_ALLOC_INDEX: string = "src/vitte/stdlib/alloc/index.vit"
const STDLIB_FFI_INDEX: string = "src/vitte/stdlib/ffi/index.vit"
const STDLIB_JSON_INDEX: string = "src/vitte/stdlib/json/index.vit"

const STDLIB_REQUIRED_FAMILY_COUNT: usize = 4
const STDLIB_TOTAL_GATE: string = "stdlib-total-gate"
const STDLIB_ALLOC_GATE: string = "stdlib-alloc-gate"
const STDLIB_FFI_GATE: string = "stdlib-ffi-gate"
const STDLIB_JSON_GATE: string = "stdlib-json-gate"

proc stdlib_entrypoint_is_canonical() -> bool {
    give STDLIB_SOURCE_ROOT == "src/vitte/stdlib"
        and STDLIB_CANONICAL_ENTRYPOINT == "src/vitte/stdlib/index.vit"
        and STDLIB_OFFICIAL_MANIFEST == "src/vitte/stdlib/modules.vitte.json";
}

proc stdlib_compiler_families_declared() -> bool {
    give STDLIB_REQUIRED_FAMILY_COUNT == 4
        and STDLIB_CORE_INDEX != ""
        and STDLIB_ALLOC_INDEX != ""
        and STDLIB_FFI_INDEX != ""
        and STDLIB_JSON_INDEX != "";
}

proc stdlib_required_gates_declared() -> bool {
    give STDLIB_TOTAL_GATE != ""
        and STDLIB_ALLOC_GATE != ""
        and STDLIB_FFI_GATE != ""
        and STDLIB_JSON_GATE != "";
}

export *
