space vitte/stdlib/ffi/index

const STDLIB_FFI_INDEX: string = "ffi"
const STDLIB_FFI_MODULE_COUNT: usize = 13
const STDLIB_FFI_PROFILED_MODULE_COUNT: usize = 13

const STDLIB_FFI_ABI: string = "src/vitte/stdlib/ffi/abi.vitl"
const STDLIB_FFI_BINDGEN: string = "src/vitte/stdlib/ffi/bindgen.vitl"
const STDLIB_FFI_CALL: string = "src/vitte/stdlib/ffi/call.vitl"
const STDLIB_FFI_CALLBACK: string = "src/vitte/stdlib/ffi/callback.vitl"
const STDLIB_FFI_ERROR: string = "src/vitte/stdlib/ffi/error.vitl"
const STDLIB_FFI_FFI: string = "src/vitte/stdlib/ffi/ffi.vitl"
const STDLIB_FFI_LIBRARY: string = "src/vitte/stdlib/ffi/library.vitl"
const STDLIB_FFI_MEMORY: string = "src/vitte/stdlib/ffi/memory.vitl"
const STDLIB_FFI_POINTER: string = "src/vitte/stdlib/ffi/pointer.vitl"
const STDLIB_FFI_REGISTRY: string = "src/vitte/stdlib/ffi/registry.vitl"
const STDLIB_FFI_SAFETY: string = "src/vitte/stdlib/ffi/safety.vitl"
const STDLIB_FFI_SYMBOL: string = "src/vitte/stdlib/ffi/symbol.vitl"
const STDLIB_FFI_TYPES: string = "src/vitte/stdlib/ffi/types.vitl"
const STDLIB_FFI_MAX_CONTRACTS: string = "src/vitte/stdlib/tests/ffi_max_contracts.vit"

proc stdlib_ffi_index_complete() -> bool {
    give STDLIB_FFI_MODULE_COUNT == 13
        and STDLIB_FFI_ABI != ""
        and STDLIB_FFI_BINDGEN != ""
        and STDLIB_FFI_CALL != ""
        and STDLIB_FFI_CALLBACK != ""
        and STDLIB_FFI_ERROR != ""
        and STDLIB_FFI_FFI != ""
        and STDLIB_FFI_LIBRARY != ""
        and STDLIB_FFI_MEMORY != ""
        and STDLIB_FFI_POINTER != ""
        and STDLIB_FFI_REGISTRY != ""
        and STDLIB_FFI_SAFETY != ""
        and STDLIB_FFI_SYMBOL != ""
        and STDLIB_FFI_TYPES != "";
}

proc stdlib_ffi_profiles_complete() -> bool {
    give STDLIB_FFI_PROFILED_MODULE_COUNT == STDLIB_FFI_MODULE_COUNT
        and STDLIB_FFI_MAX_CONTRACTS != "";
}
