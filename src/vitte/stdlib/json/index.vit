space vitte/stdlib/json/index

const STDLIB_JSON_INDEX: string = "json"
const STDLIB_JSON_MODULE_COUNT: usize = 19
const STDLIB_JSON_PROFILED_MODULE_COUNT: usize = 19

const STDLIB_JSON_BUILDER: string = "src/vitte/stdlib/json/builder.vitl"
const STDLIB_JSON_ERROR: string = "src/vitte/stdlib/json/error.vitl"
const STDLIB_JSON_ESCAPE: string = "src/vitte/stdlib/json/escape.vitl"
const STDLIB_JSON_LEXER: string = "src/vitte/stdlib/json/lexer.vitl"
const STDLIB_JSON_NUMBER: string = "src/vitte/stdlib/json/number.vitl"
const STDLIB_JSON_PARSE: string = "src/vitte/stdlib/json/parse.vitl"
const STDLIB_JSON_PARSER: string = "src/vitte/stdlib/json/parser.vitl"
const STDLIB_JSON_PATCH: string = "src/vitte/stdlib/json/patch.vitl"
const STDLIB_JSON_PATH: string = "src/vitte/stdlib/json/path.vitl"
const STDLIB_JSON_POINTER: string = "src/vitte/stdlib/json/pointer.vitl"
const STDLIB_JSON_READER: string = "src/vitte/stdlib/json/reader.vitl"
const STDLIB_JSON_RESULT: string = "src/vitte/stdlib/json/result.vitl"
const STDLIB_JSON_SCHEMA: string = "src/vitte/stdlib/json/schema.vitl"
const STDLIB_JSON_SERIALIZE: string = "src/vitte/stdlib/json/serialize.vitl"
const STDLIB_JSON_STREAM: string = "src/vitte/stdlib/json/stream.vitl"
const STDLIB_JSON_STRINGIFY: string = "src/vitte/stdlib/json/stringify.vitl"
const STDLIB_JSON_TOKEN: string = "src/vitte/stdlib/json/token.vitl"
const STDLIB_JSON_TYPES: string = "src/vitte/stdlib/json/types.vitl"
const STDLIB_JSON_WRITER: string = "src/vitte/stdlib/json/writer.vitl"
const STDLIB_JSON_MAX_CONTRACTS: string = "src/vitte/stdlib/tests/json_max_contracts.vit"

proc stdlib_json_index_complete() -> bool {
    give STDLIB_JSON_MODULE_COUNT == 19
        and STDLIB_JSON_BUILDER != ""
        and STDLIB_JSON_ERROR != ""
        and STDLIB_JSON_ESCAPE != ""
        and STDLIB_JSON_LEXER != ""
        and STDLIB_JSON_NUMBER != ""
        and STDLIB_JSON_PARSE != ""
        and STDLIB_JSON_PARSER != ""
        and STDLIB_JSON_PATCH != ""
        and STDLIB_JSON_PATH != ""
        and STDLIB_JSON_POINTER != ""
        and STDLIB_JSON_READER != ""
        and STDLIB_JSON_RESULT != ""
        and STDLIB_JSON_SCHEMA != ""
        and STDLIB_JSON_SERIALIZE != ""
        and STDLIB_JSON_STREAM != ""
        and STDLIB_JSON_STRINGIFY != ""
        and STDLIB_JSON_TOKEN != ""
        and STDLIB_JSON_TYPES != ""
        and STDLIB_JSON_WRITER != "";
}

proc stdlib_json_profiles_complete() -> bool {
    give STDLIB_JSON_PROFILED_MODULE_COUNT == STDLIB_JSON_MODULE_COUNT
        and STDLIB_JSON_MAX_CONTRACTS != "";
}
