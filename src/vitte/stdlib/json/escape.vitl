space vitte/stdlib/json/escape

export *

form JsonEscapeProfile {
    input_bytes: usize
    output_bytes: usize
    changed: bool
    valid: bool
}

proc json_escape_string(value: string) -> string {
    give compiler_json_escape_string(value);
}

proc json_unescape_string(value: string) -> string {
    give compiler_json_unescape_string(value);
}

proc json_needs_escape(value: string) -> bool {
    give compiler_json_needs_escape(value);
}

proc json_escape_profile(input: string, output: string) -> JsonEscapeProfile {
    give JsonEscapeProfile {
        input_bytes: compiler_string_len(input),
        output_bytes: compiler_string_len(output),
        changed: input != output,
        valid: true
    };
}
