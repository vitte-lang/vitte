use src/vitte/stdlib/alloc/bump
use src/vitte/stdlib/alloc/bump/reset

proc test_mark_empty() -> bool {
    let bump = bump_default("reset-mark-empty");

    let mark = bump_reset_mark(
        bump
    );

    give mark.offset == 0
        and mark.generation == bump_generation(bump)
        and bump_reset_mark_is_valid(
            bump,
            mark
        );
}

proc test_mark_after_alloc() -> bool {
    let mut bump = bump_default("reset-mark");

    let allocation = bump_alloc_bytes(
        ref mut bump,
        128,
        8
    );

    if is_none(allocation) {
        give false;
    }

    let mark = bump_reset_mark(
        bump
    );

    give mark.offset == bump_used(bump)
        and bump_reset_mark_is_valid(
            bump,
            mark
        );
}

proc test_rewind_basic() -> bool {
    let mut bump = bump_default("reset-rewind");

    let first = bump_alloc_bytes(
        ref mut bump,
        64,
        8
    );

    if is_none(first) {
        give false;
    }

    let mark = bump_reset_mark(
        bump
    );

    let second = bump_alloc_bytes(
        ref mut bump,
        128,
        8
    );

    if is_none(second) {
        give false;
    }

    let result = bump_rewind_to_mark(
        ref mut bump,
        mark
    );

    give result.success
        and result.state == BumpResetState.Applied
        and result.mode == BumpResetMode.Rewind
        and bump_used(bump) == mark.offset;
}

proc test_rewind_reclaimed() -> bool {
    let mut bump = bump_default("reset-reclaimed");

    let mark = bump_reset_mark(
        bump
    );

    let allocation = bump_alloc_bytes(
        ref mut bump,
        256,
        8
    );

    if is_none(allocation) {
        give false;
    }

    let result = bump_rewind_to_mark(
        ref mut bump,
        mark
    );

    give result.success
        and result.reclaimed >= 256
        and bump_reset_reclaimed(result) >= 256;
}

proc test_rewind_preserves_generation() -> bool {
    let mut bump = bump_default("reset-rewind-generation");

    let mark = bump_reset_mark(
        bump
    );

    let generation = bump_generation(
        bump
    );

    let allocation = bump_alloc_bytes(
        ref mut bump,
        128,
        8
    );

    if is_none(allocation) {
        give false;
    }

    let result = bump_rewind_to_mark(
        ref mut bump,
        mark
    );

    give result.success
        and bump_generation(bump) == generation
        and bump_reset_preserves_generation(
            result
        );
}

proc test_rewind_changes_revision() -> bool {
    let mut bump = bump_default("reset-rewind-revision");

    let mark = bump_reset_mark(
        bump
    );

    let allocation = bump_alloc_bytes(
        ref mut bump,
        128,
        8
    );

    if is_none(allocation) {
        give false;
    }

    let before = bump_revision(
        bump
    );

    let result = bump_rewind_to_mark(
        ref mut bump,
        mark
    );

    give result.success
        and bump_revision(bump) > before
        and result.revision_changed;
}

proc test_rewind_same_offset_skipped() -> bool {
    let mut bump = bump_default("reset-rewind-same");

    let mark = bump_reset_mark(
        bump
    );

    let result = bump_rewind_to_mark(
        ref mut bump,
        mark
    );

    give result.success
        and result.state == BumpResetState.Skipped
        and not bump_reset_changed(result)
        and result.reclaimed == 0;
}

proc test_rewind_to_offset() -> bool {
    let mut bump = bump_default("reset-offset");

    let first = bump_alloc_bytes(
        ref mut bump,
        64,
        8
    );

    if is_none(first) {
        give false;
    }

    let offset = bump_used(
        bump
    );

    let second = bump_alloc_bytes(
        ref mut bump,
        128,
        8
    );

    if is_none(second) {
        give false;
    }

    let result = bump_rewind_to_offset(
        ref mut bump,
        offset
    );

    give result.success
        and bump_used(bump) == offset;
}

proc test_rewind_invalid_offset() -> bool {
    let mut bump = bump_default("reset-invalid-offset");

    let result = bump_rewind_to_offset(
        ref mut bump,
        128
    );

    give not result.success
        and result.failure == BumpResetFailure.InvalidOffset;
}

proc test_rewind_all() -> bool {
    let mut bump = bump_default("reset-all");

    let allocation = bump_alloc_bytes(
        ref mut bump,
        512,
        8
    );

    if is_none(allocation) {
        give false;
    }

    let result = bump_rewind_all(
        ref mut bump
    );

    give result.success
        and bump_reset_is_rewind(result)
        and bump_reset_clears_used(result)
        and bump_used(bump) == 0
        and bump_is_empty(bump);
}

proc test_rewind_if_valid() -> bool {
    let mut bump = bump_default("reset-if-valid");

    let mark = bump_reset_mark(
