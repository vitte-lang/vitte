    );

    let allocation = bump_alloc_bytes(
        ref mut bump,
        128,
        8
    );

    if is_none(allocation) {
        give false;
    }

    give bump_rewind_if_valid(
        ref mut bump,
        mark
    );
}

proc test_reset_basic() -> bool {
    let mut bump = bump_default("reset-basic");

    let allocation = bump_alloc_bytes(
        ref mut bump,
        512,
        8
    );

    if is_none(allocation) {
        give false;
    }

    let result = bump_reset_default(
        ref mut bump
    );

    give result.success
        and result.mode == BumpResetMode.Reset
        and result.state == BumpResetState.Applied
        and bump_reset_clears_used(result)
        and bump_is_empty(bump);
}

proc test_reset_reclaims_all() -> bool {
    let mut bump = bump_default("reset-reclaim-all");

    let allocation = bump_alloc_bytes(
        ref mut bump,
        512,
        8
    );

    if is_none(allocation) {
        give false;
    }

    let used = bump_used(
        bump
    );

    let result = bump_reset_default(
        ref mut bump
    );

    give result.success
        and result.reclaimed == used
        and bump_used(bump) == 0;
}

proc test_reset_changes_generation() -> bool {
    let mut bump = bump_default("reset-generation");

    let before = bump_generation(
        bump
    );

    let result = bump_reset_default(
        ref mut bump
    );

    give result.success
        and bump_generation(bump) > before
        and result.generation_changed
        and bump_reset_invalidates_marks(
            result
        );
}

