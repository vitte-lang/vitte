proc test_release_twice() -> bool {
    let mut bump = bump_default("reset-release-twice");

    let first = bump_release_all(
        ref mut bump
    );

    let second = bump_release_all(
        ref mut bump
    );

    give first.success
        and second.success
        and second.state == BumpResetState.Skipped
        and second.failure == BumpResetFailure.AlreadyReleased;
}

proc test_release_if_active() -> bool {
    let mut bump = bump_default("reset-release-active");

    let result = bump_release_if_active(
        ref mut bump
    );

    give result.success
        and bump_is_released(bump);
}

proc test_release_if_active_twice() -> bool {
    let mut bump = bump_default("reset-release-if-twice");

    let first = bump_release_if_active(
        ref mut bump
    );

    let second = bump_release_if_active(
        ref mut bump
    );

    give first.success
        and second.success
        and second.state == BumpResetState.Skipped;
}

proc test_reset_after_release_fails() -> bool {
    let mut bump = bump_default("reset-after-release");

    let release = bump_release_all(
        ref mut bump
    );

    if not release.success {
        give false;
    }

    let result = bump_reset_default(
        ref mut bump
    );

    give not result.success
        and result.failure == BumpResetFailure.AlreadyReleased;
}

proc test_rewind_after_release_fails() -> bool {
    let mut bump = bump_default("rewind-after-release");

    let mark = bump_reset_mark(
        bump
    );

    let release = bump_release_all(
        ref mut bump
    );

    if not release.success {
        give false;
    }

    let result = bump_rewind_to_mark(
        ref mut bump,
        mark
    );

    give not result.success
        and result.failure == BumpResetFailure.AlreadyReleased;
}

proc test_result_success_predicates() -> bool {
    let mut bump = bump_default("reset-predicates");

    let result = bump_reset_default(
        ref mut bump
    );

    give bump_reset_succeeded(result)
        and not bump_reset_failed(result)
        and bump_reset_was_applied(result)
        and not bump_reset_was_skipped(result);
}

proc test_result_skipped_predicates() -> bool {
    let mut bump = bump_default("reset-skipped");

    let result = bump_reset_if_not_empty(
        ref mut bump
    );

    give bump_reset_succeeded(result)
        and bump_reset_was_skipped(result)
        and not bump_reset_was_applied(result);
}

