space vitte/stdlib/alloc/bump/error

export *

use src/vitte/stdlib/alloc/bump/bump as bump
use src/vitte/stdlib/alloc/bump/core as bump_core

pick BumpErrorKind {
    None,

    InvalidBump,
    InvalidState,
    InvalidBlock,

    InvalidRequest,
    InvalidSize,
    InvalidAlignment,
    InvalidLayout,

    Overflow,
    CapacityExceeded,
    Exhausted,
    OutOfMemory,

    InvalidMark,
    MarkGenerationMismatch,
    InvalidRewind,
    RewindFailed,

    ResetFailed,
    ReleaseFailed,
    AlreadyReleased,

    InvalidPointer,
    RuntimeFailure,
    Internal
}

pick BumpErrorSeverity {
    Note,
    Warning,
    Error,
    Fatal
}

pick BumpErrorDomain {
    General,
    Bump,
    Allocation,
    Mark,
    Rewind,
    Reset,
    Release,
    Runtime,
    Internal
}

pick BumpErrorOperation {
    None,

    New,
    Allocate,
    AllocateBytes,
    AllocateValue,
    AllocateArray,
    AllocateZeroed,

    Mark,
    Rewind,
    Reset,
    Release,

    Validate
}

form BumpErrorContext {
    operation: BumpErrorOperation

    state: bump.BumpState

    used: usize
    capacity: usize
    remaining: usize

    requested_size: usize
    requested_align: usize
    requested_count: usize

    mark_offset: usize

    generation: u64
    revision: u64
}

form BumpError {
    kind: BumpErrorKind
    severity: BumpErrorSeverity
    domain: BumpErrorDomain

    context: BumpErrorContext

    message: string
}

form BumpErrorStatistics {
    total: u64

    notes: u64
    warnings: u64
    errors: u64
    fatals: u64

    bump_errors: u64
    allocation_errors: u64
    mark_errors: u64
    rewind_errors: u64
    reset_errors: u64
    release_errors: u64
    runtime_errors: u64
    internal_errors: u64
}

// -----------------------------------------------------------------------------
// Context
// -----------------------------------------------------------------------------

proc bump_error_context_empty()
    -> BumpErrorContext
{
    give BumpErrorContext {
        operation:
            BumpErrorOperation.None,

        state:
            bump.BumpState.Invalid,

        used:
            0,

        capacity:
            0,

        remaining:
            0,

        requested_size:
            0,

        requested_align:
            0,

        requested_count:
            0,

        mark_offset:
            0,

        generation:
            0,

        revision:
            0
    };
}

proc bump_error_context_from_bump(
    value: bump.Bump,
    operation: BumpErrorOperation
) -> BumpErrorContext {
    give BumpErrorContext {
        operation:
            operation,

        state:
            bump.bump_state(value),

        used:
            bump.bump_used(value),

        capacity:
            bump.bump_capacity(value),

        remaining:
            bump.bump_remaining(value),

        requested_size:
            0,

        requested_align:
            0,

        requested_count:
            0,

        mark_offset:
            0,

        generation:
            bump.bump_generation(value),

        revision:
            bump.bump_revision(value)
    };
}

proc bump_error_context_request(
    value: bump.Bump,
    operation: BumpErrorOperation,
    size: usize,
    align: usize,
    count: usize
) -> BumpErrorContext {
    let context =
        bump_error_context_from_bump(
            value,
            operation
        );

    set context.requested_size =
        size;

    set context.requested_align =
        align;

    set context.requested_count =
        count;

    give context;
}

proc bump_error_context_mark(
    value: bump.Bump,
    operation: BumpErrorOperation,
    mark: bump.BumpMark
) -> BumpErrorContext {
    let context =
        bump_error_context_from_bump(
            value,
            operation
        );

    set context.mark_offset =
        mark.offset;

    give context;
}

// -----------------------------------------------------------------------------
// Constructors
// -----------------------------------------------------------------------------

proc bump_error(
    kind: BumpErrorKind,
    severity: BumpErrorSeverity,
    domain: BumpErrorDomain,
    context: BumpErrorContext,
    message: string
) -> BumpError {
    give BumpError {
        kind:
            kind,

        severity:
            severity,

        domain:
            domain,

        context:
            context,

        message:
            message
    };
}

proc bump_error_none()
    -> BumpError
{
    give bump_error(
        BumpErrorKind.None,
        BumpErrorSeverity.Note,
        BumpErrorDomain.General,
        bump_error_context_empty(),
        ""
    );
}

proc bump_error_simple(
    kind: BumpErrorKind,
    message: string
) -> BumpError {
    give bump_error(
        kind,
        BumpErrorSeverity.Error,
        bump_error_domain_for_kind(
            kind
        ),
        bump_error_context_empty(),
        message
    );
}

proc bump_error_fatal(
    kind: BumpErrorKind,
    message: string
) -> BumpError {
    give bump_error(
        kind,
        BumpErrorSeverity.Fatal,
        bump_error_domain_for_kind(
            kind
        ),
        bump_error_context_empty(),
        message
    );
}

// -----------------------------------------------------------------------------
// Bump errors
// -----------------------------------------------------------------------------

proc bump_error_invalid_bump(
    value: bump.Bump
) -> BumpError {
    give bump_error(
        BumpErrorKind.InvalidBump,
        BumpErrorSeverity.Fatal,
        BumpErrorDomain.Bump,
        bump_error_context_from_bump(
            value,
            BumpErrorOperation.Validate
        ),
        "bump allocator is invalid"
    );
}

proc bump_error_invalid_state(
    value: bump.Bump
) -> BumpError {
    give bump_error(
        BumpErrorKind.InvalidState,
        BumpErrorSeverity.Error,
        BumpErrorDomain.Bump,
        bump_error_context_from_bump(
            value,
            BumpErrorOperation.Validate
        ),
        "bump allocator state is invalid"
    );
}

proc bump_error_invalid_block(
    value: bump.Bump
) -> BumpError {
    give bump_error(
        BumpErrorKind.InvalidBlock,
        BumpErrorSeverity.Fatal,
        BumpErrorDomain.Bump,
        bump_error_context_from_bump(
            value,
            BumpErrorOperation.Validate
        ),
        "bump backing block is invalid"
    );
}

// -----------------------------------------------------------------------------
// Allocation errors
// -----------------------------------------------------------------------------

proc bump_error_invalid_request(
    value: bump.Bump,
    size: usize,
    align: usize,
    count: usize
) -> BumpError {
    give bump_error(
        BumpErrorKind.InvalidRequest,
        BumpErrorSeverity.Error,
        BumpErrorDomain.Allocation,
        bump_error_context_request(
            value,
            BumpErrorOperation.Allocate,
            size,
            align,
            count
        ),
        "bump allocation request is invalid"
    );
}

proc bump_error_invalid_size(
    value: bump.Bump,
    size: usize
) -> BumpError {
    give bump_error(
        BumpErrorKind.InvalidSize,
        BumpErrorSeverity.Error,
        BumpErrorDomain.Allocation,
        bump_error_context_request(
            value,
            BumpErrorOperation.AllocateBytes,
            size,
            0,
            1
        ),
        "bump allocation size is invalid"
    );
}

proc bump_error_invalid_alignment(
    value: bump.Bump,
    align: usize
) -> BumpError {
    give bump_error(
        BumpErrorKind.InvalidAlignment,
        BumpErrorSeverity.Error,
        BumpErrorDomain.Allocation,
        bump_error_context_request(
            value,
            BumpErrorOperation.AllocateBytes,
            0,
            align,
            1
        ),
        "bump allocation alignment is invalid"
    );
}

proc bump_error_invalid_layout(
    value: bump.Bump,
    size: usize,
    align: usize
) -> BumpError {
    give bump_error(
        BumpErrorKind.InvalidLayout,
        BumpErrorSeverity.Error,
        BumpErrorDomain.Allocation,
        bump_error_context_request(
            value,
            BumpErrorOperation.Allocate,
            size,
            align,
            1
        ),
        "bump allocation layout is invalid"
    );
}

proc bump_error_overflow(
    value: bump.Bump,
    size: usize,
    count: usize
) -> BumpError {
    give bump_error(
        BumpErrorKind.Overflow,
        BumpErrorSeverity.Error,
        BumpErrorDomain.Allocation,
        bump_error_context_request(
            value,
            BumpErrorOperation.AllocateArray,
            size,
            0,
            count
        ),
        "bump allocation size overflow"
    );
}

proc bump_error_capacity_exceeded(
    value: bump.Bump,
    size: usize,
    align: usize
) -> BumpError {
    give bump_error(
        BumpErrorKind.CapacityExceeded,
        BumpErrorSeverity.Error,
        BumpErrorDomain.Allocation,
        bump_error_context_request(
            value,
            BumpErrorOperation.Allocate,
            size,
            align,
            1
        ),
        "bump allocation exceeds remaining capacity"
    );
}

proc bump_error_exhausted(
    value: bump.Bump
) -> BumpError {
    give bump_error(
        BumpErrorKind.Exhausted,
        BumpErrorSeverity.Error,
        BumpErrorDomain.Allocation,
        bump_error_context_from_bump(
            value,
            BumpErrorOperation.Allocate
        ),
        "bump allocator is exhausted"
    );
}

proc bump_error_out_of_memory(
    value: bump.Bump,
