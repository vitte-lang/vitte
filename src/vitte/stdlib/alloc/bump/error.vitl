) -> BumpError {
    give bump_error(
        BumpErrorKind.OutOfMemory,
        BumpErrorSeverity.Fatal,
        BumpErrorDomain.Allocation,
        bump_error_context_request(
            value,
            BumpErrorOperation.Allocate,
            size,
            align,
            1
        ),
        "bump allocator is out of memory"
    );
}

proc bump_error_invalid_pointer(
    value: bump.Bump
) -> BumpError {
    give bump_error(
        BumpErrorKind.InvalidPointer,
        BumpErrorSeverity.Fatal,
        BumpErrorDomain.Allocation,
        bump_error_context_from_bump(
            value,
            BumpErrorOperation.Allocate
