            give "invalid-block-size";
        }

        ArenaErrorKind.InvalidBlockIndex {
            give "invalid-block-index";
        }

        ArenaErrorKind.InvalidLayout {
            give "invalid-layout";
        }

        ArenaErrorKind.InvalidSize {
            give "invalid-size";
        }

        ArenaErrorKind.InvalidAlignment {
            give "invalid-alignment";
        }

        ArenaErrorKind.InvalidCount {
            give "invalid-count";
        }

        ArenaErrorKind.AllocationFailed {
            give "allocation-failed";
        }

        ArenaErrorKind.OutOfMemory {
            give "out-of-memory";
        }

        ArenaErrorKind.Overflow {
            give "overflow";
        }

        ArenaErrorKind.Underflow {
            give "underflow";
        }

        ArenaErrorKind.InvalidMark {
            give "invalid-mark";
        }

        ArenaErrorKind.MarkGenerationMismatch {
            give "mark-generation-mismatch";
        }

        ArenaErrorKind.RewindFailed {
            give "rewind-failed";
        }

        ArenaErrorKind.ResetFailed {
            give "reset-failed";
        }

        ArenaErrorKind.ReleaseFailed {
            give "release-failed";
        }

        ArenaErrorKind.CapacityExceeded {
            give "capacity-exceeded";
        }

        ArenaErrorKind.LimitExceeded {
            give "limit-exceeded";
        }

        ArenaErrorKind.RuntimeFailure {
            give "runtime-failure";
        }

        ArenaErrorKind.Internal {
            give "internal";
        }
    }

    give "internal";
}

