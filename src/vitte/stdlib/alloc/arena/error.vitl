// -----------------------------------------------------------------------------
// Error model
// -----------------------------------------------------------------------------
//
// arena/error.vitl
//
//     arena
//       |
//       +-- invalid state
//       +-- invalid arena
//
//     blocks
//       |
//       +-- invalid block
//       +-- invalid size
//       +-- invalid index
//
//     allocation
//       |
//       +-- invalid layout
//       +-- invalid size
//       +-- invalid alignment
//       +-- invalid count
//       +-- overflow
//       +-- out of memory
//       +-- capacity exceeded
//
//     marks
//       |
//       +-- invalid mark
//       +-- generation mismatch
//
//     lifecycle
//       |
//       +-- rewind failure
//       +-- reset failure
//       +-- release failure
//
// Diagnostic rendering and localization should stay outside this module.
