proc test_rewind_all() -> bool {
    let mut arena = arena_default("rewind-all");

    let first = arena_alloc_bytes(
        ref mut arena,
        64,
        8
    );

    let second = arena_alloc_bytes(
        ref mut arena,
        128,
        8
    );

    if is_none(first) or is_none(second) {
        give false;
    }

    let result = arena_rewind_all(
        ref mut arena
    );

    give result.success
        and arena_allocated(arena) == 0
        and arena_is_empty(arena);
}

proc test_reset_keep_capacity() -> bool {
    let mut arena = arena_default("reset-keep-capacity");

    let first = arena_alloc_bytes(
        ref mut arena,
        128,
        8
    );

    if is_none(first) {
        give false;
    }

    let blocks_before = arena_block_count(arena);

    let result = arena_reset_keep_capacity(
        ref mut arena
    );

    give result.success
        and arena_allocated(arena) == 0
        and arena_is_empty(arena)
        and arena_block_count(arena) == blocks_before;
}

