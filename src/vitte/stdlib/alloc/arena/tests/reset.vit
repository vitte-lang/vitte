use src/vitte/stdlib/alloc/arena
use src/vitte/stdlib/alloc/arena/reset

proc test_rewind_basic() -> bool {
    let mut arena = arena_default("rewind-basic");

    let first = arena_alloc_bytes(
        ref mut arena,
        64,
        8
    );

    if is_none(first) {
        give false;
    }

    let mark = arena_mark(arena);

    let second = arena_alloc_bytes(
        ref mut arena,
        128,
        8
    );

    if is_none(second) {
        give false;
    }

    let result = arena_rewind_to_mark(
        ref mut arena,
        mark
    );

    give result.success
        and result.mode == ArenaResetMode.Rewind
        and result.state == ArenaResetState.Applied
        and arena_allocated(arena) == mark.allocated;
}

proc test_rewind_reclaims_bytes() -> bool {
    let mut arena = arena_default("rewind-bytes");

    let first = arena_alloc_bytes(
        ref mut arena,
        64,
        8
    );

    if is_none(first) {
        give false;
    }

    let mark = arena_mark(arena);

    let second = arena_alloc_bytes(
        ref mut arena,
        128,
        8
    );

    if is_none(second) {
        give false;
    }

    let result = arena_rewind_to_mark(
        ref mut arena,
        mark
    );

    give result.success
        and result.reclaimed >= 128;
}

proc test_rewind_preserves_generation() -> bool {
    let mut arena = arena_default("rewind-generation");

    let first = arena_alloc_bytes(
        ref mut arena,
        32,
        8
    );

    if is_none(first) {
        give false;
    }

    let mark = arena_mark(arena);
    let generation = arena_generation(arena);

    let second = arena_alloc_bytes(
        ref mut arena,
        32,
        8
    );

    if is_none(second) {
        give false;
    }

    let result = arena_rewind_to_mark(
        ref mut arena,
        mark
    );

    give result.success
        and arena_generation(arena) == generation;
}

proc test_rewind_changes_revision() -> bool {
    let mut arena = arena_default("rewind-revision");

    let first = arena_alloc_bytes(
        ref mut arena,
        32,
        8
    );

    if is_none(first) {
        give false;
    }

    let mark = arena_mark(arena);

    let second = arena_alloc_bytes(
        ref mut arena,
        32,
        8
    );

    if is_none(second) {
        give false;
    }

    let before = arena_revision(arena);

    let result = arena_rewind_to_mark(
        ref mut arena,
        mark
    );

    give result.success
        and arena_revision(arena) > before;
}

proc test_rewind_invalid_mark() -> bool {
    let mut arena = arena_default("rewind-invalid");

    let mark = arena_mark(arena);

    arena_reset(ref mut arena);

    let result = arena_rewind_to_mark(
        ref mut arena,
        mark
    );

    give not result.success
        and result.state == ArenaResetState.Failed;
}

