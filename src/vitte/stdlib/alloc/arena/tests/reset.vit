proc test_release() -> bool {
    let mut arena = arena_default("release");

    let allocation = arena_alloc_bytes(
        ref mut arena,
        128,
        8
    );

    if is_none(allocation) {
        give false;
    }

    let result = arena_release(
        ref mut arena
    );

    give result.success
        and result.mode == ArenaResetMode.Release
        and arena_is_released(arena)
        and arena_allocated(arena) == 0;
}

proc test_release_changes_generation() -> bool {
    let mut arena = arena_default("release-generation");

    let before = arena_generation(arena);

    let result = arena_release(
        ref mut arena
    );

    give result.success
        and arena_generation(arena) > before;
}

proc test_release_if_active() -> bool {
    let mut arena = arena_default("release-active");

    let result = arena_release_if_active(
        ref mut arena
    );

    give result.success
        and arena_is_released(arena);
}

proc test_release_twice() -> bool {
    let mut arena = arena_default("release-twice");

    let first = arena_release_if_active(
        ref mut arena
    );

    let second = arena_release_if_active(
        ref mut arena
    );

    give first.success
        and second.success
        and second.state == ArenaResetState.Ready;
}

proc test_snapshot_equal() -> bool {
    let arena = arena_default("snapshot-equal");

    let first = arena_reset_snapshot(arena);
    let second = arena_reset_snapshot(arena);

    give arena_reset_snapshot_equal(
        first,
        second
    );
}

proc test_snapshot_changed_after_alloc() -> bool {
    let mut arena = arena_default("snapshot-change");

    let before = arena_reset_snapshot(arena);

    let allocation = arena_alloc_bytes(
        ref mut arena,
        64,
        8
    );

    if is_none(allocation) {
        give false;
    }

    let after = arena_reset_snapshot(arena);

    give arena_reset_snapshot_changed(
        before,
        after
    );
}

proc test_result_reclaimed() -> bool {
    let mut arena = arena_default("result-reclaimed");

    let allocation = arena_alloc_bytes(
