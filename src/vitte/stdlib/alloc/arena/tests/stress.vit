    let mut arena = arena_new(
        "stress-large-block",
        65536
    );

    let index: usize = 0;

    while index < 1000 {
        let result = arena_alloc_bytes(
            ref mut arena,
            4096,
            16
        );

        if is_none(result) {
            give false;
        }

        set index = index + 1;
    }

    give arena_is_valid(arena)
        and arena_allocated(arena) >= 4096000;
}

proc test_exact_growth_stress() -> bool {
    let mut arena = arena_new_with_growth(
        "stress-exact",
        4096,
        ArenaGrowthMode.Exact
    );

    let index: usize = 1;

    while index <= 1000 {
        let result = arena_alloc_bytes(
            ref mut arena,
            index,
            8
        );

        if is_none(result) {
            give false;
        }

        set index = index + 1;
    }

    give arena_is_valid(arena);
}

proc test_fixed_growth_stress() -> bool {
    let mut arena = arena_new_with_growth(
        "stress-fixed",
        1024,
        ArenaGrowthMode.Fixed
    );

    let index: usize = 0;

    while index < 2000 {
        let result = arena_alloc_bytes(
            ref mut arena,
            256,
            8
        );

        if is_none(result) {
            give false;
        }

        set index = index + 1;
    }

    give arena_is_valid(arena);
}

proc test_geometric_growth_stress() -> bool {
    let mut arena = arena_new_with_growth(
        "stress-geometric",
        256,
        ArenaGrowthMode.Geometric
    );

    let index: usize = 0;

    while index < 5000 {
        let result = arena_alloc_bytes(
            ref mut arena,
            128,
            8
        );

        if is_none(result) {
            give false;
        }

        set index = index + 1;
    }

    give arena_is_valid(arena);
}

proc test_long_lived_mark() -> bool {
    let mut arena = arena_default("stress-long-mark");

    let root = arena_mark(arena);

    let index: usize = 0;

    while index < 10000 {
        let allocation = arena_alloc_bytes(
            ref mut arena,
            16,
            8
        );

        if is_none(allocation) {
            give false;
        }

        set index = index + 1;
    }

    let result = arena_rewind_to_mark(
        ref mut arena,
        root
    );

    give result.success
        and arena_allocated(arena) == 0
        and arena_is_valid(arena);
}

proc test_interleaved_marks() -> bool {
    let mut arena = arena_default("stress-interleaved");

    let cycle: usize = 0;

    while cycle < 1000 {
        let root = arena_mark(arena);

        let a = arena_alloc_bytes(
            ref mut arena,
            16,
            8
        );

        if is_none(a) {
            give false;
        }

        let middle = arena_mark(arena);

        let b = arena_alloc_bytes(
            ref mut arena,
            32,
            8
        );

        if is_none(b) {
            give false;
        }

        if not arena_rewind(
            ref mut arena,
            middle
        ) {
            give false;
        }

        let c = arena_alloc_bytes(
            ref mut arena,
            64,
            8
        );

        if is_none(c) {
            give false;
        }

        if not arena_rewind(
            ref mut arena,
            root
        ) {
            give false;
        }

        set cycle = cycle + 1;
    }

    give arena_is_empty(arena)
        and arena_is_valid(arena);
}

proc test_profile_valid_during_stress() -> bool {
    let mut arena = arena_default("stress-profile-valid");

    let index: usize = 0;

    while index < 5000 {
        let allocation = arena_alloc_bytes(
            ref mut arena,
            24,
            8
        );

        if is_none(allocation) {
            give false;
        }

        if not arena_profile(arena).valid {
            give false;
        }

        set index = index + 1;
    }

    give true;
}

proc test_reset_after_large_pressure() -> bool {
    let mut arena = arena_default("stress-pressure-reset");

    let index: usize = 0;

    while index < 1000 {
        let allocation = arena_alloc_bytes(
            ref mut arena,
            4096,
            16
        );

        if is_none(allocation) {
            give false;
        }

        set index = index + 1;
    }

    let before = arena_allocated(arena);

    let result = arena_reset_default(
        ref mut arena
    );

    give before >= 4096000
        and result.success
        and result.reclaimed >= 4096000
        and arena_is_empty(arena)
        and arena_is_valid(arena);
}

proc test_keep_capacity_after_pressure() -> bool {
    let mut arena = arena_default("stress-pressure-keep");

    let index: usize = 0;

    while index < 1000 {
        let allocation = arena_alloc_bytes(
            ref mut arena,
            1024,
            16
        );

        if is_none(allocation) {
            give false;
        }

        set index = index + 1;
    }

    let blocks = arena_block_count(arena);

    let result = arena_reset_keep_capacity(
        ref mut arena
    );

    give result.success
        and arena_is_empty(arena)
        and arena_block_count(arena) == blocks
        and arena_is_valid(arena);
}

proc test_stress_reuse_keep_capacity() -> bool {
    let mut arena = arena_default("stress-reuse-keep");

    let cycle: usize = 0;

    while cycle < 500 {
        let index: usize = 0;

        while index < 128 {
            let allocation = arena_alloc_bytes(
                ref mut arena,
                32,
                8
            );

            if is_none(allocation) {
                give false;
            }

            set index = index + 1;
        }

        let reset = arena_reset_keep_capacity(
            ref mut arena
        );

        if not reset.success {
            give false;
        }

        set cycle = cycle + 1;
    }

    give arena_is_valid(arena)
        and arena_is_empty(arena);
}

proc test_release_after_pressure() -> bool {
    let mut arena = arena_default("stress-release");

    let index: usize = 0;

    while index < 1000 {
        let allocation = arena_alloc_bytes(
            ref mut arena,
            128,
            8
        );

        if is_none(allocation) {
            give false;
        }

        set index = index + 1;
    }

    let result = arena_release(
        ref mut arena
    );

    give result.success
        and arena_is_released(arena)
        and arena_allocated(arena) == 0;
}

proc run_stress_tests() -> bool {
    give test_many_tiny_allocations()
        and test_many_small_allocations()
        and test_many_medium_allocations()
        and test_many_large_allocations()
        and test_variable_size_allocations()
        and test_alignment_stress()

        and test_emplace_stress()
        and test_form_emplace_stress()

        and test_mark_rewind_stress()
        and test_nested_mark_stress()
        and test_repeated_rewind()
        and test_long_lived_mark()
        and test_interleaved_marks()

        and test_reset_stress()
        and test_reset_keep_capacity_stress()
        and test_repeated_large_reset()
        and test_stress_reuse_keep_capacity()

        and test_generation_stress()
        and test_revision_stress()
        and test_snapshot_stress()
        and test_rewind_snapshot_stress()

        and test_multiple_arenas()
        and test_independent_resets()
        and test_mixed_size_cycle()
        and test_mark_generation_after_many_resets()

        and test_reset_result_stress()
        and test_rewind_result_stress()
        and test_reset_statistics_stress()
        and test_rewind_statistics_stress()

        and test_custom_small_block_stress()
        and test_custom_large_block_stress()
        and test_exact_growth_stress()
        and test_fixed_growth_stress()
        and test_geometric_growth_stress()

        and test_profile_valid_during_stress()
        and test_reset_after_large_pressure()
        and test_keep_capacity_after_pressure()
        and test_release_after_pressure();
}

proc main() -> int {
    if run_stress_tests() {
        give 0;
    }

    give 1;
}
