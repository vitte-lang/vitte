use src/vitte/stdlib/alloc/arena
use src/vitte/stdlib/alloc/arena/reset

form Point {
    x: int
    y: int
}

proc test_many_tiny_allocations() -> bool {
    let mut arena = arena_default("stress-tiny");

    let index: usize = 0;

    while index < 10000 {
        let result = arena_alloc_bytes(
            ref mut arena,
            1,
            1
        );

        if is_none(result) {
            give false;
        }

        set index = index + 1;
    }

    give arena_allocated(arena) >= 10000
        and arena_is_valid(arena);
}

proc test_many_small_allocations() -> bool {
    let mut arena = arena_default("stress-small");

    let index: usize = 0;

    while index < 5000 {
        let result = arena_alloc_bytes(
            ref mut arena,
            16,
            8
        );

        if is_none(result) {
            give false;
        }

        set index = index + 1;
    }

    give arena_allocated(arena) >= 80000
        and arena_is_valid(arena);
}

proc test_many_medium_allocations() -> bool {
    let mut arena = arena_default("stress-medium");

    let index: usize = 0;

    while index < 2000 {
        let result = arena_alloc_bytes(
            ref mut arena,
            128,
            16
        );

        if is_none(result) {
            give false;
        }

        set index = index + 1;
    }

    give arena_allocated(arena) >= 256000
        and arena_is_valid(arena);
