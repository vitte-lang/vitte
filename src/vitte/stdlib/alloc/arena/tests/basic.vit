proc test_profile_after_reset() -> bool {
    let mut arena = arena_default(
        "profile-reset"
    );

    let result = arena_alloc_bytes(
        ref mut arena,
        128,
        8
    );

    if is_none(result) {
        give false;
    }

    arena_reset(
        ref mut arena
    );

    let profile = arena_profile(arena);

    give profile.allocated == 0
        and profile.empty
        and profile.active
        and profile.valid;
}

proc test_profile_after_drop() -> bool {
    let mut arena = arena_default(
        "profile-drop"
    );

    arena_drop(
        ref mut arena
    );

    give arena_is_released(arena)
        and arena_allocated(arena) == 0;
