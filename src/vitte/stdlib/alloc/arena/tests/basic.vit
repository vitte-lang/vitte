proc test_advance_generation() -> bool {
    let mut arena = arena_default(
        "advance-generation"
    );

    let before = arena_generation(arena);

    let after = arena_advance_generation(
        ref mut arena
    );

    give after > before
        and arena_generation(arena) == after;
}

proc test_validation() -> bool {
    let arena = arena_default(
