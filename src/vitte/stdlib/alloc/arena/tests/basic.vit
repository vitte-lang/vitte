proc test_statistics_empty() -> bool {
    let statistics = arena_statistics_empty();

    give statistics.allocations == 0
        and statistics.allocation_failures == 0
        and statistics.bytes_requested == 0
        and statistics.bytes_allocated == 0
        and statistics.marks == 0
        and statistics.rewinds == 0
        and statistics.resets == 0
        and statistics.drops == 0;
}

proc test_statistics_total_empty() -> bool {
    let statistics = arena_statistics_empty();

    give arena_statistics_total_operations(
        statistics
    ) == 0;
}

proc test_state_name_empty() -> bool {
    let arena = arena_default(
        "state-name"
    );

    give arena_state_name(
