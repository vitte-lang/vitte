use src/vitte/stdlib/alloc/arena

form Point {
    x: int
    y: int
}

form User {
    id: int
    name: string
    active: bool
}

proc test_new() -> bool {
    let arena = arena_new(
        "basic",
        4096
    );

    give arena_is_valid(arena);
}

proc test_default() -> bool {
    let arena = arena_default(
        "default"
    );

    give arena_is_valid(arena)
        and arena_default_block_size(arena) == 4096;
}

proc test_empty_initially() -> bool {
    let arena = arena_default(
        "empty"
    );

    give arena_is_empty(arena)
        and arena_allocated(arena) == 0;
}

proc test_initial_block_count() -> bool {
    let arena = arena_default(
        "blocks"
    );

    give arena_block_count(arena) == 0;
}

proc test_initial_generation() -> bool {
    let arena = arena_default(
        "generation"
    );

    give arena_generation(arena) >= 1;
}

proc test_initial_revision() -> bool {
    let arena = arena_default(
        "revision"
    );

    give arena_revision(arena) >= 1;
}

proc test_initial_active() -> bool {
    let arena = arena_default(
        "active"
    );

    give arena_is_active(arena);
}

proc test_initial_not_released() -> bool {
    let arena = arena_default(
        "released"
    );

    give not arena_is_released(arena);
}

proc test_allocate_bytes() -> bool {
    let mut arena = arena_default(
        "bytes"
    );

    let result = arena_alloc_bytes(
        ref mut arena,
        64,
        8
    );

    give is_some(result)
        and arena_allocated(arena) >= 64;
}

proc test_allocate_small_bytes() -> bool {
    let mut arena = arena_default(
        "small"
    );

    let result = arena_alloc_bytes(
        ref mut arena,
        1,
        1
    );

    give is_some(result)
        and not arena_is_empty(arena);
}

proc test_allocate_large_bytes() -> bool {
    let mut arena = arena_default(
        "large"
    );

    let result = arena_alloc_bytes(
        ref mut arena,
        8192,
        8
    );

    give is_some(result)
        and arena_allocated(arena) >= 8192;
}

proc test_allocate_changes_state() -> bool {
    let mut arena = arena_default(
        "state"
    );

    let result = arena_alloc_bytes(
        ref mut arena,
        32,
        8
    );

    give is_some(result)
        and not arena_is_empty(arena)
        and arena_is_active(arena);
}

proc test_multiple_allocations() -> bool {
    let mut arena = arena_default(
        "multiple"
    );

    let first = arena_alloc_bytes(
        ref mut arena,
        32,
        8
    );

    let second = arena_alloc_bytes(
        ref mut arena,
        64,
        8
    );

    let third = arena_alloc_bytes(
        ref mut arena,
        128,
        8
    );

    give is_some(first)
        and is_some(second)
        and is_some(third)
        and arena_allocated(arena) >= 224;
}

proc test_allocated_increases() -> bool {
    let mut arena = arena_default(
        "increase"
    );

    let before = arena_allocated(arena);

    let result = arena_alloc_bytes(
        ref mut arena,
        128,
        8
    );

    let after = arena_allocated(arena);

    give is_some(result)
        and after > before;
}

proc test_allocated_monotonic() -> bool {
    let mut arena = arena_default(
        "monotonic"
    );

    let before = arena_allocated(arena);

    let first = arena_alloc_bytes(
        ref mut arena,
        32,
        8
    );

    let middle = arena_allocated(arena);

    let second = arena_alloc_bytes(
        ref mut arena,
        64,
        8
    );

    let after = arena_allocated(arena);

    give is_some(first)
        and is_some(second)
        and middle > before
        and after > middle;
}

proc test_mark_empty() -> bool {
    let arena = arena_default(
        "mark-empty"
    );

    let mark = arena_mark(arena);

    give mark.allocated == 0
        and mark.block_count == 0
        and arena_mark_is_valid(
            arena,
            mark
        );
}

proc test_mark_after_allocation() -> bool {
    let mut arena = arena_default(
        "mark"
    );

    let result = arena_alloc_bytes(
        ref mut arena,
        64,
        8
    );

    if is_none(result) {
        give false;
    }

    let mark = arena_mark(arena);

    give mark.allocated >= 64
        and arena_mark_is_valid(
            arena,
            mark
        );
}

proc test_mark_generation() -> bool {
    let arena = arena_default(
        "mark-generation"
    );

    let mark = arena_mark(arena);

    give mark.generation
        == arena_generation(arena);
}

proc test_bytes_until_mark_zero() -> bool {
    let arena = arena_default(
        "mark-zero"
    );

    let mark = arena_mark(arena);

    give arena_bytes_until_mark(
        arena,
        mark
    ) == 0;
}

proc test_bytes_until_mark() -> bool {
    let mut arena = arena_default(
        "mark-bytes"
    );

    let first = arena_alloc_bytes(
        ref mut arena,
        64,
        8
    );

    if is_none(first) {
        give false;
    }

    let mark = arena_mark(arena);

    let second = arena_alloc_bytes(
        ref mut arena,
        128,
        8
    );

    if is_none(second) {
        give false;
    }

    give arena_bytes_until_mark(
        arena,
        mark
    ) >= 128;
}

proc test_rewind() -> bool {
    let mut arena = arena_default(
        "rewind"
    );

    let first = arena_alloc_bytes(
        ref mut arena,
        64,
        8
    );

    if is_none(first) {
        give false;
    }

    let mark = arena_mark(arena);

    let second = arena_alloc_bytes(
        ref mut arena,
        128,
        8
    );

    if is_none(second) {
        give false;
    }

    give arena_rewind(
        ref mut arena,
        mark
    )
    and arena_allocated(arena) == mark.allocated;
}

proc test_rewind_keeps_generation() -> bool {
    let mut arena = arena_default(
        "rewind-generation"
    );

    let first = arena_alloc_bytes(
        ref mut arena,
        32,
        8
    );

    if is_none(first) {
        give false;
    }

    let mark = arena_mark(arena);

    let generation = arena_generation(arena);

    let second = arena_alloc_bytes(
        ref mut arena,
        32,
        8
    );

    if is_none(second) {
        give false;
    }

    if not arena_rewind(
        ref mut arena,
        mark
    ) {
        give false;
    }

    give arena_generation(arena)
        == generation;
}

proc test_rewind_then_allocate() -> bool {
    let mut arena = arena_default(
        "rewind-reuse"
    );

    let first = arena_alloc_bytes(
        ref mut arena,
        64,
        8
    );

    if is_none(first) {
        give false;
    }

    let mark = arena_mark(arena);

    let second = arena_alloc_bytes(
        ref mut arena,
        128,
        8
    );

    if is_none(second) {
        give false;
    }

    if not arena_rewind(
        ref mut arena,
        mark
    ) {
        give false;
    }

    let third = arena_alloc_bytes(
        ref mut arena,
        256,
        8
    );

    give is_some(third)
        and arena_is_valid(arena);
}

proc test_reset() -> bool {
    let mut arena = arena_default(
        "reset"
    );

    let result = arena_alloc_bytes(
        ref mut arena,
        128,
        8
    );

    if is_none(result) {
        give false;
    }

    arena_reset(
        ref mut arena
    );

    give arena_allocated(arena) == 0
        and arena_is_empty(arena)
        and arena_is_active(arena);
}

proc test_reset_changes_generation() -> bool {
    let mut arena = arena_default(
        "reset-generation"
    );

    let before = arena_generation(arena);

    arena_reset(
        ref mut arena
    );

    give arena_generation(arena) > before;
}

proc test_reset_changes_revision() -> bool {
    let mut arena = arena_default(
        "reset-revision"
    );

    let before = arena_revision(arena);

    arena_reset(
        ref mut arena
    );

    give arena_revision(arena) > before;
}

proc test_reset_reusable() -> bool {
    let mut arena = arena_default(
        "reset-reusable"
    );

    let first = arena_alloc_bytes(
        ref mut arena,
        64,
        8
    );

    if is_none(first) {
        give false;
    }

    arena_reset(
        ref mut arena
    );

    let second = arena_alloc_bytes(
        ref mut arena,
        64,
        8
    );

    give is_some(second)
        and arena_allocated(arena) >= 64;
}

proc test_old_mark_invalid_after_reset() -> bool {
    let mut arena = arena_default(
        "old-mark"
    );

    let mark = arena_mark(arena);

    arena_reset(
        ref mut arena
    );

    give not arena_mark_is_valid(
        arena,
        mark
    );
}

proc test_drop() -> bool {
    let mut arena = arena_default(
        "drop"
    );

    let result = arena_alloc_bytes(
        ref mut arena,
        128,
        8
    );

    if is_none(result) {
        give false;
    }

    arena_drop(
        ref mut arena
    );

    give arena_allocated(arena) == 0
        and arena_is_released(arena);
}

proc test_drop_changes_generation() -> bool {
    let mut arena = arena_default(
        "drop-generation"
    );

    let before = arena_generation(arena);

    arena_drop(
        ref mut arena
    );

    give arena_generation(arena) > before;
}

proc test_drop_changes_revision() -> bool {
    let mut arena = arena_default(
        "drop-revision"
    );

    let before = arena_revision(arena);

    arena_drop(
        ref mut arena
    );

    give arena_revision(arena) > before;
}

proc test_profile_empty() -> bool {
    let arena = arena_default(
        "profile-empty"
    );

    let profile = arena_profile(arena);

    give profile.block_size == 4096
        and profile.allocated == 0
        and profile.empty
        and profile.active
        and profile.valid;
}

proc test_profile_after_allocation() -> bool {
    let mut arena = arena_default(
        "profile-allocation"
    );

    let result = arena_alloc_bytes(
        ref mut arena,
        256,
        8
    );

    if is_none(result) {
        give false;
    }

    let profile = arena_profile(arena);

    give profile.allocated >= 256
        and not profile.empty
        and profile.active
        and profile.valid;
}

proc test_profile_generation() -> bool {
    let arena = arena_default(
        "profile-generation"
    );

    let profile = arena_profile(arena);

    give profile.generation
        == arena_generation(arena);
}

proc test_profile_revision() -> bool {
    let arena = arena_default(
        "profile-revision"
    );

    let profile = arena_profile(arena);

    give profile.revision
        == arena_revision(arena);
}

