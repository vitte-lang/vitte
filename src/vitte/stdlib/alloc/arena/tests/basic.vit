proc test_large_custom_arena() -> bool {
    let mut arena = arena_new(
        "large-custom",
        65536
    );

    let allocation = arena_alloc_bytes(
        ref mut arena,
        32768,
        16
    );

    give is_some(allocation)
        and arena_default_block_size(arena) == 65536
        and arena_is_valid(arena);
}

proc test_several_large_blocks() -> bool {
    let mut arena = arena_new(
        "several-large",
        4096
    );

    let first = arena_alloc_bytes(
        ref mut arena,
        8192,
        16
    );

    let second = arena_alloc_bytes(
        ref mut arena,
        16384,
        16
    );

    let third = arena_alloc_bytes(
        ref mut arena,
        32768,
        16
    );

    give is_some(first)
        and is_some(second)
        and is_some(third)
        and arena_is_valid(arena);
}

proc test_arena_survives_many_cycles() -> bool {
    let mut arena = arena_default(
        "cycles"
    );

    let cycle: usize = 0;

    while cycle < 20 {
        let index: usize = 0;

        while index < 16 {
            let allocation = arena_alloc_bytes(
                ref mut arena,
                32,
                8
            );

            if is_none(allocation) {
                give false;
            }

            set index = index + 1;
        }

        arena_reset(
            ref mut arena
        );

        if not arena_is_valid(arena) {
            give false;
        }

        set cycle = cycle + 1;
    }

    give arena_is_empty(arena);
}

proc run_basic_tests() -> bool {
    give test_new()
        and test_default()
        and test_empty_initially()
        and test_initial_block_count()
        and test_initial_generation()
        and test_initial_revision()
        and test_initial_active()
        and test_initial_not_released()

        and test_allocate_bytes()
        and test_allocate_small_bytes()
        and test_allocate_large_bytes()
        and test_allocate_changes_state()
        and test_multiple_allocations()
        and test_allocated_increases()
        and test_allocated_monotonic()

        and test_mark_empty()
        and test_mark_after_allocation()
        and test_mark_generation()
        and test_bytes_until_mark_zero()
        and test_bytes_until_mark()
        and test_rewind()
        and test_rewind_keeps_generation()
        and test_rewind_then_allocate()

        and test_reset()
        and test_reset_changes_generation()
        and test_reset_changes_revision()
