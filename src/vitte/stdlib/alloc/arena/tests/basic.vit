proc test_utilization_initial() -> bool {
    let arena = arena_default(
        "utilization"
    );

    give arena_utilization(arena) == 0.0;
}

proc test_utilization_after_allocation() -> bool {
    let mut arena = arena_default(
        "utilization-active"
    );

    let result = arena_alloc_bytes(
        ref mut arena,
