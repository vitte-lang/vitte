proc test_would_allocate_valid_layout() -> bool {
    let arena = arena_default(
        "would"
    );

    let layout = layout(
        64,
        8
    );

    give arena_would_allocate(
        arena,
        layout
    );
}

proc test_next_block_size_small() -> bool {
    let arena = arena_default(
        "next-small"
    );

    give arena_next_block_size(
        arena,
        128
    ) >= 128;
}

proc test_next_block_size_large() -> bool {
    let arena = arena_default(
        "next-large"
    );

    give arena_next_block_size(
        arena,
        8192
    ) >= 8192;
}

proc test_many_small_allocations() -> bool {
    let mut arena = arena_default(
        "many-small"
    );

    let index: usize = 0;

    while index < 100 {
        let result = arena_alloc_bytes(
            ref mut arena,
            8,
            8
        );

        if is_none(result) {
            give false;
        }

        set index = index + 1;
    }

    give arena_allocated(arena) >= 800
        and arena_is_valid(arena);
}

proc test_many_medium_allocations() -> bool {
    let mut arena = arena_default(
        "many-medium"
    );

    let index: usize = 0;

    while index < 32 {
        let result = arena_alloc_bytes(
            ref mut arena,
            128,
            8
        );

        if is_none(result) {
            give false;
        }

        set index = index + 1;
    }

    give arena_allocated(arena) >= 4096
        and arena_is_valid(arena);
}

proc test_many_large_allocations() -> bool {
    let mut arena = arena_default(
        "many-large"
    );

    let index: usize = 0;

    while index < 8 {
        let result = arena_alloc_bytes(
            ref mut arena,
            4096,
            8
        );

        if is_none(result) {
            give false;
        }

        set index = index + 1;
    }

    give arena_allocated(arena) >= 32768
        and arena_is_valid(arena);
}

proc test_mixed_alignment() -> bool {
    let mut arena = arena_default(
        "mixed-align"
    );

    let a = arena_alloc_bytes(
        ref mut arena,
        8,
        1
    );

    let b = arena_alloc_bytes(
        ref mut arena,
        16,
        2
    );

    let c = arena_alloc_bytes(
        ref mut arena,
        32,
        4
    );

    let d = arena_alloc_bytes(
        ref mut arena,
        64,
        8
    );

    let e = arena_alloc_bytes(
        ref mut arena,
        128,
        16
    );

    give is_some(a)
        and is_some(b)
        and is_some(c)
        and is_some(d)
        and is_some(e)
        and arena_is_valid(arena);
}

proc test_multiple_marks() -> bool {
    let mut arena = arena_default(
        "multiple-marks"
    );

    let first = arena_mark(arena);

    let allocation = arena_alloc_bytes(
        ref mut arena,
        64,
        8
    );

    if is_none(allocation) {
        give false;
    }

    let second = arena_mark(arena);

    give arena_mark_is_valid(arena, first)
        and arena_mark_is_valid(arena, second)
        and second.allocated > first.allocated;
}

proc test_nested_rewind() -> bool {
    let mut arena = arena_default(
        "nested-rewind"
    );

    let first = arena_alloc_bytes(
        ref mut arena,
        32,
        8
    );

    if is_none(first) {
        give false;
    }

    let mark1 = arena_mark(arena);

    let second = arena_alloc_bytes(
        ref mut arena,
        64,
        8
    );

    if is_none(second) {
        give false;
    }

    let mark2 = arena_mark(arena);

    let third = arena_alloc_bytes(
        ref mut arena,
        128,
        8
    );

    if is_none(third) {
        give false;
    }

    if not arena_rewind(
        ref mut arena,
        mark2
    ) {
        give false;
    }

    if arena_allocated(arena)
        != mark2.allocated
    {
        give false;
    }

    if not arena_rewind(
        ref mut arena,
        mark1
    ) {
        give false;
    }

    give arena_allocated(arena)
        == mark1.allocated;
}

proc test_repeated_reset() -> bool {
    let mut arena = arena_default(
        "repeated-reset"
    );

    let index: usize = 0;

    while index < 10 {
        let allocation = arena_alloc_bytes(
            ref mut arena,
            64,
            8
        );

        if is_none(allocation) {
            give false;
        }

        arena_reset(
            ref mut arena
        );

        if not arena_is_empty(arena) {
            give false;
        }

        set index = index + 1;
    }

    give arena_is_valid(arena);
}

proc test_revision_changes_after_allocation() -> bool {
    let mut arena = arena_default(
        "revision-alloc"
    );

    let before = arena_revision(arena);

    let result = arena_alloc_bytes(
        ref mut arena,
        64,
        8
    );

    give is_some(result)
        and arena_revision(arena) > before;
}

proc test_touch() -> bool {
    let mut arena = arena_default(
        "touch"
    );

    let before = arena_revision(arena);

    arena_touch(
        ref mut arena
    );

    give arena_revision(arena) > before;
