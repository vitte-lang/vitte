proc test_mark_before_allocation() -> bool {
    let arena = arena_default(
        "mark"
    );

    let mark = arena_mark(
        arena
    );

    give mark.allocated == 0
        and arena_mark_is_valid(
            arena,
            mark
        );
}

proc test_mark_after_allocation() -> bool {
    let mut arena = arena_default(
        "mark-after"
    );

    let result = arena_allocate_bytes(
        ref mut arena,
        128
    );

    if is_none(result) {
        give false;
    }

    let mark = arena_mark(
        arena
    );

    give mark.allocated >= 128
        and arena_mark_is_valid(
            arena,
            mark
        );
}

proc test_rewind_restores_allocated() -> bool {
    let mut arena = arena_default(
        "rewind"
    );

    let first = arena_allocate_bytes(
        ref mut arena,
        64
    );

    if is_none(first) {
        give false;
    }

    let mark = arena_mark(
        arena
    );

    let second = arena_allocate_bytes(
        ref mut arena,
        128
    );

    if is_none(second) {
        give false;
    }

    let success = arena_rewind(
        ref mut arena,
        mark
    );

    give success
        and arena_allocated(arena) == mark.allocated;
}

proc test_bytes_until_mark() -> bool {
    let mut arena = arena_default(
        "mark-bytes"
    );

    let first = arena_allocate_bytes(
        ref mut arena,
        64
    );

    if is_none(first) {
        give false;
    }

    let mark = arena_mark(
        arena
    );

    let second = arena_allocate_bytes(
        ref mut arena,
        128
    );

    if is_none(second) {
        give false;
    }

    give arena_bytes_until_mark(
        arena,
        mark
    ) >= 128;
}

proc test_reset_clears_allocated() -> bool {
    let mut arena = arena_default(
        "reset"
    );

    let first = arena_allocate_bytes(
        ref mut arena,
        64
    );

    let second = arena_allocate_bytes(
        ref mut arena,
        128
    );

    if is_none(first)
        or is_none(second)
    {
        give false;
    }

    arena_reset(
        ref mut arena
    );

    give arena_allocated(arena) == 0
        and arena_is_empty(arena);
}

proc test_reset_reusable() -> bool {
    let mut arena = arena_default(
        "reset-reuse"
    );

    let first = arena_allocate_bytes(
        ref mut arena,
        64
    );

    if is_none(first) {
        give false;
    }

    arena_reset(
        ref mut arena
    );

    let second = arena_allocate_bytes(
        ref mut arena,
        64
    );

    give is_some(second)
        and arena_allocated(arena) >= 64;
}

proc test_many_small_allocations() -> bool {
    let mut arena = arena_default(
        "many-small"
    );

    let index: usize = 0;

    while index < 100 {
        let result = arena_allocate_bytes(
            ref mut arena,
            8
        );

        if is_none(result) {
            give false;
        }

        set index = index + 1;
    }

    give arena_allocated(arena) >= 800;
}

proc test_many_medium_allocations() -> bool {
    let mut arena = arena_default(
        "many-medium"
    );

    let index: usize = 0;

    while index < 32 {
        let result = arena_allocate_bytes(
            ref mut arena,
            128
        );

        if is_none(result) {
            give false;
        }

        set index = index + 1;
    }

    give arena_allocated(arena) >= 4096;
}

proc test_mixed_allocations() -> bool {
    let mut arena = arena_default(
        "mixed"
    );

    let a = arena_allocate_bytes(
        ref mut arena,
        8
    );

    let b = arena_allocate_bytes_aligned(
        ref mut arena,
        64,
        16
    );

    let c = arena_emplace(
        ref mut arena,
        42
    );

    let d = arena_emplace(
        ref mut arena,
        Point {
            x: 1
            y: 2
        }
    );

    give is_some(a)
        and is_some(b)
        and is_some(c)
        and is_some(d)
        and arena_allocated(arena) > 0
        and arena_is_valid(arena);
}

proc test_large_allocation_does_not_break_arena() -> bool {
    let mut arena = arena_default(
        "large-valid"
    );

    let result = arena_allocate_bytes(
        ref mut arena,
        16384
    );

    give is_some(result)
        and arena_is_valid(arena);
}

proc test_multiple_marks() -> bool {
    let mut arena = arena_default(
        "multi-mark"
    );

    let first = arena_mark(
        arena
    );

    let a = arena_allocate_bytes(
        ref mut arena,
        64
    );

    if is_none(a) {
        give false;
    }

    let second = arena_mark(
        arena
    );

    let b = arena_allocate_bytes(
        ref mut arena,
        128
    );

    if is_none(b) {
        give false;
    }

    give arena_mark_is_valid(arena, first)
        and arena_mark_is_valid(arena, second)
        and second.allocated > first.allocated;
}

proc test_rewind_second_mark() -> bool {
    let mut arena = arena_default(
        "rewind-second"
    );

    let first = arena_allocate_bytes(
        ref mut arena,
        64
    );

    if is_none(first) {
        give false;
    }

    let mark = arena_mark(
        arena
    );

    let second = arena_allocate_bytes(
        ref mut arena,
        128
    );

    let third = arena_allocate_bytes(
        ref mut arena,
        256
    );

    if is_none(second)
        or is_none(third)
    {
        give false;
    }

    give arena_rewind(
        ref mut arena,
        mark
    )
    and arena_allocated(arena) == mark.allocated;
}

proc test_profile_after_many_allocations() -> bool {
    let mut arena = arena_default(
        "profile-many"
    );

    let index: usize = 0;

    while index < 20 {
        let result = arena_allocate_bytes(
            ref mut arena,
            64
        );

        if is_none(result) {
            give false;
        }

        set index = index + 1;
    }

    let profile = arena_profile(
        arena
    );

    give profile.allocated >= 1280
        and profile.valid
        and profile.active;
}

proc test_default_block_size_preserved() -> bool {
    let mut arena = arena_new(
        "size",
        8192
    );

    let result = arena_allocate_bytes(
        ref mut arena,
        128
    );

    give is_some(result)
        and arena_default_block_size(arena) == 8192;
}

proc test_custom_small_block() -> bool {
    let mut arena = arena_new(
        "small-block",
        256
    );

    let result = arena_allocate_bytes(
        ref mut arena,
        128
    );

    give is_some(result)
        and arena_default_block_size(arena) == 256;
}

proc test_custom_large_block() -> bool {
    let mut arena = arena_new(
        "large-block",
        16384
    );

    let result = arena_allocate_bytes(
        ref mut arena,
        4096
    );

    give is_some(result)
        and arena_is_valid(arena);
}

proc test_allocation_result_bytes() -> bool {
    let mut arena = arena_default(
        "result-bytes"
    );

    let request = arena_allocation_request_bytes(
        512,
        8
    );

    let result = arena_allocate_request(
        ref mut arena,
        request
    );

    give result.success
        and result.bytes == 512;
}

proc test_allocation_result_failure_zero_align() -> bool {
    let mut arena = arena_default(
        "bad-align"
    );

    let request = arena_allocation_request_bytes(
        64,
        0
    );

    let result = arena_allocate_request(
        ref mut arena,
        request
    );

    give not result.success;
}

proc test_alloc_after_rewind() -> bool {
    let mut arena = arena_default(
        "alloc-after-rewind"
    );

    let first = arena_allocate_bytes(
        ref mut arena,
        64
    );

    if is_none(first) {
        give false;
    }

    let mark = arena_mark(
        arena
    );

    let second = arena_allocate_bytes(
        ref mut arena,
        128
    );

    if is_none(second) {
        give false;
    }

    if not arena_rewind(
        ref mut arena,
        mark
    ) {
        give false;
    }

    let third = arena_allocate_bytes(
        ref mut arena,
        256
    );

    give is_some(third)
        and arena_is_valid(arena);
}

proc test_repeated_reset_and_allocate() -> bool {
    let mut arena = arena_default(
        "repeat-reset"
    );

    let round: usize = 0;

    while round < 10 {
        let result = arena_allocate_bytes(
            ref mut arena,
            128
        );

        if is_none(result) {
            give false;
        }

        arena_reset(
            ref mut arena
        );

        if not arena_is_empty(arena) {
            give false;
        }

        set round = round + 1;
    }

    give arena_is_valid(arena);
}

proc test_emplace_after_reset() -> bool {
    let mut arena = arena_default(
        "emplace-reset"
    );

    let first = arena_emplace(
        ref mut arena,
        10
    );

    if is_none(first) {
        give false;
    }

    arena_reset(
        ref mut arena
    );

    let second = arena_emplace(
        ref mut arena,
        20
    );

    pick second {
        Some(value) {
            give *value == 20;
        }

        None {
            give false;
        }
    }
}

proc test_allocated_monotonic_without_reset() -> bool {
    let mut arena = arena_default(
        "monotonic"
    );

    let first_before = arena_allocated(
        arena
    );

    let first = arena_allocate_bytes(
        ref mut arena,
        32
    );

    let first_after = arena_allocated(
        arena
    );

    let second = arena_allocate_bytes(
        ref mut arena,
        64
    );

    let second_after = arena_allocated(
        arena
    );

    give is_some(first)
        and is_some(second)
        and first_after > first_before
        and second_after > first_after;
}

proc test_snapshot_after_reset() -> bool {
    let mut arena = arena_default(
        "snapshot-reset"
    );

    let result = arena_allocate_bytes(
        ref mut arena,
        128
    );

    if is_none(result) {
        give false;
    }

    let before = arena_allocation_snapshot(
        arena
    );

    arena_reset(
        ref mut arena
    );

    let after = arena_allocation_snapshot(
        arena
    );

    give before.allocated > 0
        and after.allocated == 0
        and arena_allocation_snapshot_changed(
            before,
            after
        );
}

proc test_zeroed_then_emplace() -> bool {
    let mut arena = arena_default(
        "zero-emplace"
    );

    let first = arena_allocate_zeroed(
        ref mut arena,
        64,
        8
    );

    let second = arena_emplace(
        ref mut arena,
        42
    );

    give is_some(first)
        and is_some(second)
        and arena_is_valid(arena);
}

proc test_many_point_emplace() -> bool {
    let mut arena = arena_default(
        "points"
    );

    let index: int = 0;

    while index < 50 {
        let result = arena_emplace(
            ref mut arena,
            Point {
                x: index
                y: index + 1
            }
        );

        if is_none(result) {
            give false;
        }

        set index = index + 1;
    }

    give arena_is_valid(arena)
        and arena_allocated(arena) > 0;
}

proc test_allocation_possible_after_reset() -> bool {
    let mut arena = arena_default(
        "possible-reset"
    );

    let first = arena_allocate_bytes(
        ref mut arena,
        64
    );

    if is_none(first) {
        give false;
    }

    arena_reset(
        ref mut arena
    );

    let request = arena_allocation_request_bytes(
        64,
        8
    );

    give arena_allocation_is_possible(
        arena,
        request
    );
}

proc run_alloc_tests() -> bool {
    give test_arena_new()
        and test_arena_default()

        and test_allocate_bytes()
        and test_allocate_bytes_small()
        and test_allocate_bytes_large()
        and test_allocate_aligned()
        and test_allocate_alignment_8()
        and test_allocate_alignment_32()
        and test_allocate_multiple_bytes()

        and test_allocate_int()
        and test_allocate_point()
        and test_allocate_array()
        and test_allocate_many()

        and test_allocate_zeroed()
        and test_allocate_zeroed_type()
        and test_allocate_zeroed_array()

        and test_emplace_int()
        and test_emplace_negative_int()
        and test_emplace_bool()
        and test_emplace_point()
        and test_emplace_point_mutate()
        and test_emplace_user()
        and test_multiple_emplace()

        and test_allocation_increases_allocated()
        and test_two_allocations_increase_allocated()
        and test_arena_becomes_nonempty()
        and test_arena_stays_valid_after_allocation()
        and test_arena_profile_after_allocation()

        and test_allocation_snapshot_before()
        and test_allocation_snapshot_change()
        and test_allocation_snapshot_not_equal()
        and test_allocation_delta()
        and test_allocation_delta_not_zero()

        and test_request_bytes()
        and test_request_aligned()
        and test_request_zeroed()
        and test_request_valid()
        and test_request_invalid_alignment_zero()
        and test_request_invalid_alignment_three()

        and test_alignment_valid_one()
        and test_alignment_valid_two()
        and test_alignment_valid_four()
        and test_alignment_valid_eight()
        and test_alignment_valid_sixteen()
        and test_alignment_invalid_zero()
        and test_alignment_invalid_three()
        and test_alignment_invalid_six()

        and test_mul_no_overflow()
        and test_mul_zero_no_overflow()
        and test_array_size()
        and test_array_size_zero_count()
        and test_round_up_already_aligned()
        and test_round_up_alignment()
        and test_round_up_invalid_align()

        and test_allocate_request()
        and test_allocate_zeroed_request()
        and test_allocate_invalid_request()
        and test_result_success_predicate()
        and test_result_failure_predicate()

        and test_profile_empty()
        and test_profile_record_request()
        and test_profile_record_two_requests()
        and test_profile_success_rate_empty()
        and test_profile_failure_rate_empty()

        and test_arena_allocation_used()
        and test_arena_allocation_reserved()
        and test_arena_allocation_live()
        and test_arena_allocation_overhead()
        and test_arena_utilization_empty()
        and test_arena_utilization_after_alloc()

        and test_allocation_possible()
        and test_allocation_would_fit_default_block()
        and test_allocation_larger_than_default_block()
        and test_next_block_size_small()
        and test_next_block_size_large()

        and test_mark_before_allocation()
        and test_mark_after_allocation()
        and test_rewind_restores_allocated()
        and test_bytes_until_mark()
        and test_reset_clears_allocated()
        and test_reset_reusable()

        and test_many_small_allocations()
        and test_many_medium_allocations()
        and test_mixed_allocations()
        and test_large_allocation_does_not_break_arena()

        and test_multiple_marks()
        and test_rewind_second_mark()
        and test_profile_after_many_allocations()

        and test_default_block_size_preserved()
        and test_custom_small_block()
        and test_custom_large_block()

        and test_allocation_result_bytes()
        and test_allocation_result_failure_zero_align()

        and test_alloc_after_rewind()
        and test_repeated_reset_and_allocate()
        and test_emplace_after_reset()
        and test_allocated_monotonic_without_reset()
        and test_snapshot_after_reset()
        and test_zeroed_then_emplace()
        and test_many_point_emplace()
        and test_allocation_possible_after_reset();
}

proc main() -> int {
    if run_alloc_tests() {
        give 0;
    }

    give 1;
}
