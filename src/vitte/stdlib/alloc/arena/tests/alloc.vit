use src/vitte/stdlib/alloc/arena
use src/vitte/stdlib/alloc/arena/alloc

form Point {
    x: int
    y: int
}

form User {
    id: int
    active: bool
}

proc test_arena_new() -> bool {
    let arena = arena_new(
        "test",
        4096
    );

    give arena_is_valid(arena)
        and arena_is_empty(arena)
        and arena_allocated(arena) == 0
        and arena_default_block_size(arena) == 4096;
}

proc test_arena_default() -> bool {
    let arena = arena_default(
        "default"
    );

    give arena_is_valid(arena)
        and arena_default_block_size(arena) == 4096;
}

proc test_allocate_bytes() -> bool {
    let mut arena = arena_default(
        "bytes"
    );

    let result = arena_allocate_bytes(
        ref mut arena,
        64
    );

    pick result {
        Some(allocation) {
            give allocation.layout.size == 64
                and arena_allocated(arena) >= 64;
        }

        None {
            give false;
        }
    }
}

proc test_allocate_bytes_small() -> bool {
    let mut arena = arena_default(
        "small"
    );

    let result = arena_allocate_bytes(
