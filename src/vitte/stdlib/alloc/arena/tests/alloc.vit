proc test_allocate_request() -> bool {
    let mut arena = arena_default(
        "request"
    );

    let request = arena_allocation_request_bytes(
        128,
        8
    );

    let result = arena_allocate_request(
        ref mut arena,
        request
    );

    give arena_allocation_result_is_success(
        result
    )
    and arena_allocation_result_has_allocation(
        result
    )
    and result.bytes == 128;
}

proc test_allocate_zeroed_request() -> bool {
    let mut arena = arena_default(
        "request-zero"
    );

    let request = arena_allocation_request_zeroed(
        128,
        8
    );

    let result = arena_allocate_request(
        ref mut arena,
        request
    );

    give result.success
        and result.bytes == 128;
}

proc test_allocate_invalid_request() -> bool {
    let mut arena = arena_default(
        "invalid"
    );

    let request = arena_allocation_request_bytes(
        64,
        3
    );

    let result = arena_allocate_request(
        ref mut arena,
        request
    );

    give arena_allocation_result_is_failure(
        result
    )
    and not result.success;
}

