proc test_emplace_int() -> bool {
    let mut arena = arena_default(
        "emplace-int"
    );

    let result = arena_emplace(
        ref mut arena,
        42
    );

    pick result {
        Some(value) {
            give *value == 42;
        }

        None {
            give false;
        }
    }
}

