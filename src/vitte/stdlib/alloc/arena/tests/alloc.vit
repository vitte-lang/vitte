proc test_profile_empty() -> bool {
    let profile = arena_allocation_profile_empty();

    give profile.request_count == 0
        and profile.success_count == 0
        and profile.failure_count == 0
        and profile.requested_bytes == 0
        and profile.allocated_bytes == 0;
}

proc test_profile_record_request() -> bool {
    let mut profile = arena_allocation_profile_empty();

    let request = arena_allocation_request_bytes(
        64,
        8
    );

    arena_allocation_profile_record_request(
        ref mut profile,
        request
    );

    give profile.request_count == 1
        and profile.requested_bytes == 64
        and profile.byte_allocations == 1;
}

proc test_profile_record_two_requests() -> bool {
    let mut profile = arena_allocation_profile_empty();

    let first = arena_allocation_request_bytes(
        64,
        8
    );

    let second = arena_allocation_request_bytes(
        128,
        8
    );

    arena_allocation_profile_record_request(
        ref mut profile,
        first
    );

    arena_allocation_profile_record_request(
        ref mut profile,
        second
    );

    give profile.request_count == 2
        and profile.requested_bytes == 192
        and profile.largest_request == 128
        and profile.smallest_request == 64;
}

proc test_profile_success_rate_empty() -> bool {
    let profile = arena_allocation_profile_empty();

    give arena_allocation_profile_success_rate(
        profile
    ) == 1.0;
}

proc test_profile_failure_rate_empty() -> bool {
    let profile = arena_allocation_profile_empty();

    give arena_allocation_profile_failure_rate(
        profile
    ) == 0.0;
}

