proc test_allocate_multiple_bytes() -> bool {
    let mut arena = arena_default(
        "multiple"
    );

    let first = arena_allocate_bytes(
        ref mut arena,
        32
    );

    let second = arena_allocate_bytes(
        ref mut arena,
        64
    );

    let third = arena_allocate_bytes(
        ref mut arena,
        128
    );

    give is_some(first)
        and is_some(second)
        and is_some(third)
        and arena_allocated(arena) >= 224;
}

