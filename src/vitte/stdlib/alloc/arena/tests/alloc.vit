proc test_emplace_point() -> bool {
    let mut arena = arena_default(
        "point"
    );

    let result = arena_emplace(
        ref mut arena,
        Point {
            x: 10
            y: 20
        }
    );

    pick result {
        Some(point) {
            give point.x == 10
                and point.y == 20;
        }

        None {
            give false;
        }
    }
}

proc test_emplace_point_mutate() -> bool {
    let mut arena = arena_default(
        "point-mut"
    );

    let result = arena_emplace(
        ref mut arena,
        Point {
            x: 1
            y: 2
        }
    );

    pick result {
        Some(point) {
            set point.x = 100;
            set point.y = 200;

            give point.x == 100
                and point.y == 200;
        }

        None {
            give false;
        }
    }
}

proc test_emplace_user() -> bool {
    let mut arena = arena_default(
        "user"
    );

    let result = arena_emplace(
        ref mut arena,
        User {
            id: 7
            active: true
        }
    );

    pick result {
        Some(user) {
            give user.id == 7
                and user.active;
        }

        None {
            give false;
        }
    }
}

proc test_multiple_emplace() -> bool {
    let mut arena = arena_default(
        "multi-emplace"
    );

    let first = arena_emplace(
        ref mut arena,
        1
    );

    let second = arena_emplace(
        ref mut arena,
        2
    );

    let third = arena_emplace(
        ref mut arena,
        3
    );

    pick first {
        Some(a) {
            pick second {
                Some(b) {
                    pick third {
                        Some(c) {
                            give *a == 1
                                and *b == 2
                                and *c == 3;
                        }

                        None {
                            give false;
                        }
                    }
                }

                None {
                    give false;
                }
            }
        }

        None {
            give false;
        }
    }
}

proc test_allocation_increases_allocated() -> bool {
    let mut arena = arena_default(
        "increase"
    );

    let before = arena_allocated(
        arena
    );

    let result = arena_allocate_bytes(
        ref mut arena,
        128
    );

    let after = arena_allocated(
        arena
    );

    give is_some(result)
        and after > before;
}

proc test_two_allocations_increase_allocated() -> bool {
    let mut arena = arena_default(
        "increase-two"
    );

    let before = arena_allocated(arena);

    let first = arena_allocate_bytes(
        ref mut arena,
        64
    );

    let middle = arena_allocated(arena);

    let second = arena_allocate_bytes(
        ref mut arena,
        64
    );

    let after = arena_allocated(arena);

    give is_some(first)
        and is_some(second)
        and middle > before
        and after > middle;
}

proc test_arena_becomes_nonempty() -> bool {
    let mut arena = arena_default(
        "nonempty"
    );

    let result = arena_allocate_bytes(
        ref mut arena,
        16
    );

    give is_some(result)
        and not arena_is_empty(arena);
}

proc test_arena_stays_valid_after_allocation() -> bool {
    let mut arena = arena_default(
        "valid"
    );

    let result = arena_allocate_bytes(
        ref mut arena,
        256
    );

    give is_some(result)
        and arena_is_valid(arena);
}

proc test_arena_profile_after_allocation() -> bool {
    let mut arena = arena_default(
        "profile"
    );

    let result = arena_allocate_bytes(
        ref mut arena,
        256
    );

    if is_none(result) {
        give false;
    }

    let profile = arena_profile(
        arena
    );

    give profile.allocated >= 256
        and not profile.empty
        and profile.active
        and profile.valid;
}

proc test_allocation_snapshot_before() -> bool {
    let arena = arena_default(
        "snapshot"
    );

    let snapshot = arena_allocation_snapshot(
        arena
    );

    give snapshot.allocated == 0;
}

proc test_allocation_snapshot_change() -> bool {
    let mut arena = arena_default(
        "snapshot-change"
    );

    let before = arena_allocation_snapshot(
        arena
    );

    let result = arena_allocate_bytes(
        ref mut arena,
        64
    );

    if is_none(result) {
        give false;
    }

    let after = arena_allocation_snapshot(
        arena
    );

    give arena_allocation_snapshot_changed(
        before,
        after
    );
}

proc test_allocation_snapshot_not_equal() -> bool {
    let mut arena = arena_default(
        "snapshot-ne"
    );

    let before = arena_allocation_snapshot(
        arena
    );

    let result = arena_allocate_bytes(
        ref mut arena,
        32
    );

    if is_none(result) {
        give false;
    }

    let after = arena_allocation_snapshot(
        arena
    );

    give not arena_allocation_snapshot_equal(
        before,
        after
    );
}

proc test_allocation_delta() -> bool {
    let mut arena = arena_default(
        "delta"
    );

    let before = arena_allocation_snapshot(
        arena
    );

    let result = arena_allocate_bytes(
        ref mut arena,
        128
    );

    if is_none(result) {
        give false;
    }

    let after = arena_allocation_snapshot(
        arena
    );

    let delta = arena_allocation_delta(
        before,
        after
    );

    give delta.allocated > 0;
}

proc test_allocation_delta_not_zero() -> bool {
    let mut arena = arena_default(
        "delta-nonzero"
    );

    let before = arena_allocation_snapshot(
        arena
    );

    let result = arena_allocate_bytes(
        ref mut arena,
        64
    );

    if is_none(result) {
        give false;
    }

    let after = arena_allocation_snapshot(
        arena
    );

    let delta = arena_allocation_delta(
        before,
        after
    );

    give not arena_allocation_delta_is_zero(
        delta
    );
}

proc test_request_bytes() -> bool {
    let request = arena_allocation_request_bytes(
        64,
        8
    );

    give request.size == 64
        and request.align == 8
        and request.count == 1
        and not request.zeroed;
}

proc test_request_aligned() -> bool {
    let request = arena_allocation_request_aligned(
        128,
        32
    );

    give request.size == 128
        and request.align == 32
        and request.count == 1;
}

proc test_request_zeroed() -> bool {
    let request = arena_allocation_request_zeroed(
        128,
        16
    );

    give request.size == 128
        and request.align == 16
        and request.zeroed;
}

