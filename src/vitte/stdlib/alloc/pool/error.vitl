    message: string
) -> PoolError {
    give pool_error(
        PoolErrorKind.RuntimeFailure,
        PoolErrorSeverity.Fatal,
        PoolErrorDomain.Runtime,
        pool_error_context_empty(),
        message
    );
}

proc pool_error_internal(
    message: string
) -> PoolError {
    give pool_error(
        PoolErrorKind.Internal,
        PoolErrorSeverity.Fatal,
        PoolErrorDomain.Internal,
        pool_error_context_empty(),
        message
    );
}

// -----------------------------------------------------------------------------
// Allocation failure mapping
// -----------------------------------------------------------------------------

proc pool_error_from_allocation_failure(
    block: pool_block.PoolBlock,
    request: pool_alloc.PoolAllocationRequest,
    failure: pool_alloc.PoolAllocationFailure
) -> PoolError {
    pick failure {
        pool_alloc.PoolAllocationFailure.None {
            give pool_error_none();
        }

        pool_alloc.PoolAllocationFailure.InvalidSize {
            give pool_error_invalid_size(
                request.size
            );
        }

        pool_alloc.PoolAllocationFailure.InvalidAlignment {
            give pool_error_invalid_alignment(
                request.align
            );
        }

        pool_alloc.PoolAllocationFailure.InvalidLayout {
            give pool_error_invalid_request(
                block,
                request
            );
        }

        pool_alloc.PoolAllocationFailure.SlotTooSmall {
            give pool_error_slot_too_small(
                block,
                request
            );
        }

        pool_alloc.PoolAllocationFailure.CapacityExceeded {
            give pool_error_capacity_exceeded(
                block
            );
        }

        pool_alloc.PoolAllocationFailure.Exhausted {
            give pool_error_exhausted(
                block
            );
        }

        pool_alloc.PoolAllocationFailure.InvalidIndex {
            give pool_error_invalid_slot_index(
                block,
                0
            );
        }

        pool_alloc.PoolAllocationFailure.InvalidPointer {
            give pool_error_invalid_pointer(
                block,
                0
            );
        }

        pool_alloc.PoolAllocationFailure.AlreadyAllocated {
            give pool_error_slot_already_allocated(
                block,
                0
            );
        }

        pool_alloc.PoolAllocationFailure.AlreadyReleased {
            give pool_error_slot_already_released(
                block,
                0
            );
        }

        pool_alloc.PoolAllocationFailure.OutOfMemory {
            give pool_error_out_of_memory(
                block.layout
            );
        }

        pool_alloc.PoolAllocationFailure.RuntimeFailure {
            give pool_error_runtime(
                "pool allocation runtime failure"
            );
        }
    }

    give pool_error_internal(
        "unknown pool allocation failure"
    );
}

proc pool_error_from_allocation_result(
    block: pool_block.PoolBlock,
    result: pool_alloc.PoolAllocationResult
) -> PoolError {
    if result.success {
        give pool_error_none();
    }

    let error =
        pool_error_from_allocation_failure(
            block,
            result.request,
            result.failure
        );

    set error.context.slot_index =
        result.slot;

    give error;
}

// -----------------------------------------------------------------------------
// Block validation mapping
// -----------------------------------------------------------------------------

proc pool_error_from_block_validation(
    block: pool_block.PoolBlock,
    validation: pool_block.PoolBlockValidation
) -> PoolError {
    if validation.valid {
        give pool_error_none();
    }

    if not validation.allocation_valid {
        give pool_error_invalid_block(
            block
        );
    }

    if not validation.layout_valid {
        give pool_error_invalid_layout(
            block.layout
        );
    }

    if not validation.accounting_valid {
        give pool_error_invalid_state(
            block
        );
    }

    if not validation.state_valid {
        give pool_error_invalid_state(
            block
        );
    }

    if not validation.hint_valid {
        give pool_error_internal(
            "pool allocation hint is invalid"
        );
    }

    give pool_error_internal(
        "unknown pool block validation failure"
    );
}

// -----------------------------------------------------------------------------
// Core validation mapping
// -----------------------------------------------------------------------------

proc pool_error_from_core_validation(
    profile: pool_core.PoolCoreProfile,
    validation: pool_core.PoolCoreValidation
) -> PoolError {
    if validation.valid {
        give pool_error_none();
    }

    if not validation.layout_valid {
        give pool_error_simple(
            PoolErrorKind.InvalidLayout,
            "pool core layout is invalid"
        );
    }

    if not validation.usage_valid {
        give pool_error_simple(
            PoolErrorKind.InvalidState,
            "pool core accounting is invalid"
        );
    }

    if not validation.state_valid {
        give pool_error_simple(
            PoolErrorKind.InvalidState,
            "pool core state is invalid"
        );
    }

    if not validation.access_valid {
        give pool_error_simple(
            PoolErrorKind.InvalidState,
            "pool core access state is invalid"
        );
    }

    if not validation.generation_valid {
        give pool_error_internal(
            "pool core generation metadata is invalid"
        );
    }

    give pool_error_internal(
        "unknown pool core validation failure"
    );
}

// -----------------------------------------------------------------------------
// Allocation checking
// -----------------------------------------------------------------------------

proc pool_error_for_request(
    block: pool_block.PoolBlock,
    request: pool_alloc.PoolAllocationRequest
) -> PoolError {
    if not pool_block.pool_block_is_active(
        block
    ) {
        give pool_error_invalid_state(
            block
        );
    }

    if request.size == 0 {
        give pool_error_invalid_size(
            request.size
        );
    }

    if not pool_alloc.pool_allocation_alignment_valid(
        request.align
    ) {
        give pool_error_invalid_alignment(
            request.align
        );
    }

    if request.size > block.layout.slot_size {
        give pool_error_slot_too_small(
            block,
            request
        );
    }

    if request.align > block.layout.slot_align {
        give pool_error_invalid_alignment(
            request.align
        );
    }

    if pool_block.pool_block_is_full(
        block
    ) {
        give pool_error_exhausted(
            block
        );
    }

    give pool_error_none();
}

// -----------------------------------------------------------------------------
// Slot checking
// -----------------------------------------------------------------------------

proc pool_error_for_slot(
    block: pool_block.PoolBlock,
    slot: pool_alloc.PoolAllocationSlot
) -> PoolError {
    if slot.index >= block.layout.slot_count {
        give pool_error_invalid_slot_index(
            block,
            slot.index
        );
    }

    if slot.offset >= block.allocation.layout.size {
        give pool_error_invalid_slot(
            block,
            slot.index
        );
    }

    give pool_error_none();
}

proc pool_error_for_allocate_slot(
    block: pool_block.PoolBlock,
    slot: pool_alloc.PoolAllocationSlot
) -> PoolError {
    let error =
        pool_error_for_slot(
            block,
            slot
        );

    if not pool_error_is_none(error) {
        give error;
    }

    if slot.allocated {
        give pool_error_slot_already_allocated(
            block,
            slot.index
        );
    }

    if pool_block.pool_block_is_full(
        block
    ) {
        give pool_error_exhausted(
            block
        );
    }

    give pool_error_none();
}

proc pool_error_for_release_slot(
    block: pool_block.PoolBlock,
    slot: pool_alloc.PoolAllocationSlot
) -> PoolError {
    let error =
        pool_error_for_slot(
            block,
            slot
        );

    if not pool_error_is_none(error) {
        give error;
    }

    if not slot.allocated {
        give pool_error_slot_already_released(
            block,
            slot.index
        );
    }

    give pool_error_none();
}

// -----------------------------------------------------------------------------
// Predicates
// -----------------------------------------------------------------------------

proc pool_error_is_none(
    error: PoolError
) -> bool {
    give error.kind
        == PoolErrorKind.None;
}

proc pool_error_is_warning(
    error: PoolError
) -> bool {
    give error.severity
        == PoolErrorSeverity.Warning;
}

proc pool_error_is_error(
    error: PoolError
) -> bool {
    give error.severity
        == PoolErrorSeverity.Error
        or error.severity
            == PoolErrorSeverity.Fatal;
}

proc pool_error_is_fatal(
    error: PoolError
) -> bool {
    give error.severity
        == PoolErrorSeverity.Fatal;
}

proc pool_error_is_pool(
    error: PoolError
) -> bool {
    give error.domain
        == PoolErrorDomain.Pool;
}

proc pool_error_is_layout(
    error: PoolError
) -> bool {
    give error.domain
        == PoolErrorDomain.Layout;
}

proc pool_error_is_allocation(
    error: PoolError
) -> bool {
    give error.domain
        == PoolErrorDomain.Allocation;
}

proc pool_error_is_slot(
    error: PoolError
) -> bool {
    give error.domain
        == PoolErrorDomain.Slot;
}

proc pool_error_is_release(
    error: PoolError
) -> bool {
    give error.domain
        == PoolErrorDomain.Release;
}

proc pool_error_is_reset(
    error: PoolError
) -> bool {
    give error.domain
        == PoolErrorDomain.Reset;
}

proc pool_error_is_exhaustion(
    error: PoolError
) -> bool {
    give error.kind
        == PoolErrorKind.PoolExhausted
        or error.kind
            == PoolErrorKind.CapacityExceeded;
}

// -----------------------------------------------------------------------------
// Domain mapping
// -----------------------------------------------------------------------------

proc pool_error_domain_for_kind(
    kind: PoolErrorKind
) -> PoolErrorDomain {
    pick kind {
        PoolErrorKind.None {
            give PoolErrorDomain.General;
        }

        PoolErrorKind.InvalidPool
        | PoolErrorKind.InvalidState
        | PoolErrorKind.InvalidBlock {
            give PoolErrorDomain.Pool;
        }

        PoolErrorKind.InvalidLayout
        | PoolErrorKind.InvalidSize
        | PoolErrorKind.InvalidAlignment
        | PoolErrorKind.InvalidCapacity {
            give PoolErrorDomain.Layout;
        }

        PoolErrorKind.InvalidRequest
        | PoolErrorKind.SlotTooSmall
        | PoolErrorKind.PoolExhausted
        | PoolErrorKind.CapacityExceeded
        | PoolErrorKind.OutOfMemory
        | PoolErrorKind.AllocationFailed {
            give PoolErrorDomain.Allocation;
        }

        PoolErrorKind.InvalidSlot
        | PoolErrorKind.InvalidSlotIndex
        | PoolErrorKind.InvalidSlotState
        | PoolErrorKind.SlotAlreadyAllocated
        | PoolErrorKind.InvalidPointer
        | PoolErrorKind.GenerationMismatch {
            give PoolErrorDomain.Slot;
        }

        PoolErrorKind.SlotAlreadyReleased
        | PoolErrorKind.ReleaseFailed {
            give PoolErrorDomain.Release;
        }

        PoolErrorKind.ResetFailed {
            give PoolErrorDomain.Reset;
        }

        PoolErrorKind.RuntimeFailure {
            give PoolErrorDomain.Runtime;
        }

        PoolErrorKind.Internal {
            give PoolErrorDomain.Internal;
        }
    }

    give PoolErrorDomain.Internal;
}

// -----------------------------------------------------------------------------
// Statistics
// -----------------------------------------------------------------------------

proc pool_error_statistics_empty()
    -> PoolErrorStatistics
{
    give PoolErrorStatistics {
        total: 0,

        notes: 0,
        warnings: 0,
        errors: 0,
        fatals: 0,

        pool_errors: 0,
        layout_errors: 0,
        allocation_errors: 0,
        slot_errors: 0,
        release_errors: 0,
        reset_errors: 0,
        runtime_errors: 0,
        internal_errors: 0
    };
}

proc pool_error_statistics_record(
    statistics: ref mut PoolErrorStatistics,
    error: PoolError
) {
    if pool_error_is_none(
        error
    ) {
        give;
    }

    set statistics.total =
        statistics.total + 1;

    pick error.severity {
        PoolErrorSeverity.Note {
            set statistics.notes =
                statistics.notes + 1;
        }

        PoolErrorSeverity.Warning {
            set statistics.warnings =
                statistics.warnings + 1;
        }

        PoolErrorSeverity.Error {
            set statistics.errors =
                statistics.errors + 1;
        }

        PoolErrorSeverity.Fatal {
            set statistics.fatals =
                statistics.fatals + 1;
        }
    }

    pick error.domain {
        PoolErrorDomain.Pool {
            set statistics.pool_errors =
                statistics.pool_errors + 1;
        }

        PoolErrorDomain.Layout {
            set statistics.layout_errors =
                statistics.layout_errors + 1;
        }

        PoolErrorDomain.Allocation {
            set statistics.allocation_errors =
                statistics.allocation_errors + 1;
        }

        PoolErrorDomain.Slot {
            set statistics.slot_errors =
                statistics.slot_errors + 1;
        }

        PoolErrorDomain.Release {
            set statistics.release_errors =
                statistics.release_errors + 1;
        }

        PoolErrorDomain.Reset {
            set statistics.reset_errors =
                statistics.reset_errors + 1;
        }

        PoolErrorDomain.Runtime {
            set statistics.runtime_errors =
                statistics.runtime_errors + 1;
        }

        PoolErrorDomain.Internal {
            set statistics.internal_errors =
                statistics.internal_errors + 1;
        }

        PoolErrorDomain.General {}
    }
}

proc pool_error_statistics_total(
    statistics: PoolErrorStatistics
) -> u64 {
    give statistics.total;
}

proc pool_error_statistics_reset(
    statistics: ref mut PoolErrorStatistics
) {
    set *statistics =
        pool_error_statistics_empty();
}

