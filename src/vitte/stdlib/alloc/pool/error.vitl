}

proc pool_error_domain_name(
    domain: PoolErrorDomain
) -> string {
    pick domain {
        PoolErrorDomain.General {
            give "general";
        }

        PoolErrorDomain.Pool {
            give "pool";
        }

        PoolErrorDomain.Layout {
            give "layout";
        }

        PoolErrorDomain.Allocation {
            give "allocation";
        }

        PoolErrorDomain.Slot {
            give "slot";
        }

        PoolErrorDomain.Release {
            give "release";
        }

        PoolErrorDomain.Reset {
            give "reset";
        }

        PoolErrorDomain.Runtime {
            give "runtime";
        }

        PoolErrorDomain.Internal {
            give "internal";
        }
    }

    give "internal";
}

proc pool_error_operation_name(
    operation: PoolErrorOperation
) -> string {
    pick operation {
        PoolErrorOperation.None {
            give "none";
        }

        PoolErrorOperation.New {
            give "new";
        }

        PoolErrorOperation.Allocate {
            give "allocate";
        }

        PoolErrorOperation.AllocateValue {
            give "allocate-value";
        }

        PoolErrorOperation.AllocateZeroed {
            give "allocate-zeroed";
        }

        PoolErrorOperation.GetSlot {
            give "get-slot";
        }

        PoolErrorOperation.ValidateSlot {
            give "validate-slot";
        }

        PoolErrorOperation.ReleaseSlot {
            give "release-slot";
        }

        PoolErrorOperation.Reset {
            give "reset";
        }

        PoolErrorOperation.ReleasePool {
            give "release-pool";
        }

        PoolErrorOperation.Validate {
            give "validate";
        }
    }

    give "none";
}

// -----------------------------------------------------------------------------
// Error model
// -----------------------------------------------------------------------------
//
// Pool errors are grouped into:
//
//     pool
//         invalid global state
//         invalid backing block
//
//     layout
//         invalid slot size
//         invalid alignment
//         invalid slot count
//
//     allocation
//         invalid request
//         slot too small
//         exhaustion
//         backing allocation failure
//
//     slot
//         invalid index
//         invalid state
//         duplicate allocation
//         stale generation
//
//     release
//         duplicate release
//         release failure
//
//     reset
//         reset failure
//
// Pool exhaustion is normally recoverable:
//
//     PoolExhausted
//
// means every fixed slot is currently allocated.
//
// Recovery may be:
//
//     release one slot
//     reset pool
//     create a larger pool
//
// Fundamental slot lifecycle:
//
//     Free
//       |
//       | allocate
//       v
//     Allocated
//       |
//       | release
//       v
//     Free
//
// Generation increments on release to help detect stale slot handles.
//
// Error rendering/localization stays outside this module.
