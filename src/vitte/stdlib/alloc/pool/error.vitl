        PoolErrorKind.InvalidPointer {
            give "invalid-pointer";
        }

        PoolErrorKind.AllocationFailed {
            give "allocation-failed";
        }

        PoolErrorKind.ReleaseFailed {
            give "release-failed";
        }

        PoolErrorKind.ResetFailed {
            give "reset-failed";
        }

        PoolErrorKind.GenerationMismatch {
            give "generation-mismatch";
        }

        PoolErrorKind.RuntimeFailure {
            give "runtime-failure";
        }

        PoolErrorKind.Internal {
            give "internal";
        }
    }

    give "internal";
}

proc pool_error_severity_name(
    severity: PoolErrorSeverity
