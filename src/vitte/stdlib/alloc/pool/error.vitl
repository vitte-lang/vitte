space vitte/stdlib/alloc/pool/error

export *

use src/vitte/stdlib/alloc/pool/alloc as pool_alloc
use src/vitte/stdlib/alloc/pool/block as pool_block
use src/vitte/stdlib/alloc/pool/core as pool_core

pick PoolErrorKind {
    None,

    InvalidPool,
    InvalidState,
    InvalidBlock,

    InvalidLayout,
    InvalidSize,
    InvalidAlignment,
    InvalidCapacity,

    InvalidRequest,
    SlotTooSmall,

    InvalidSlot,
    InvalidSlotIndex,
    InvalidSlotState,

    SlotAlreadyAllocated,
    SlotAlreadyReleased,

    PoolExhausted,
    CapacityExceeded,
    OutOfMemory,

    InvalidPointer,

    AllocationFailed,
    ReleaseFailed,
    ResetFailed,

    GenerationMismatch,

    RuntimeFailure,
    Internal
}

pick PoolErrorSeverity {
    Note,
    Warning,
    Error,
    Fatal
}

pick PoolErrorDomain {
    General,
    Pool,
    Layout,
    Allocation,
    Slot,
    Release,
    Reset,
    Runtime,
    Internal
}

pick PoolErrorOperation {
    None,

    New,

    Allocate,
    AllocateValue,
    AllocateZeroed,

    GetSlot,
    ValidateSlot,

    ReleaseSlot,
    Reset,
    ReleasePool,

    Validate
}

form PoolErrorContext {
    operation: PoolErrorOperation

    state: pool_core.PoolCoreState

    slot_index: usize

    slot_size: usize
    slot_align: usize
    slot_count: usize

    requested_size: usize
    requested_align: usize

    allocated: usize
    free: usize

    generation: u64
    revision: u64
}

form PoolError {
    kind: PoolErrorKind
    severity: PoolErrorSeverity
    domain: PoolErrorDomain

    context: PoolErrorContext

    message: string
}

form PoolErrorStatistics {
    total: u64

    notes: u64
    warnings: u64
    errors: u64
    fatals: u64

    pool_errors: u64
    layout_errors: u64
    allocation_errors: u64
    slot_errors: u64
    release_errors: u64
    reset_errors: u64
    runtime_errors: u64
    internal_errors: u64
}

// -----------------------------------------------------------------------------
// Context
// -----------------------------------------------------------------------------

proc pool_error_context_empty()
    -> PoolErrorContext
{
    give PoolErrorContext {
        operation:
            PoolErrorOperation.None,

        state:
            pool_core.PoolCoreState.Invalid,

        slot_index:
            0,

        slot_size:
            0,

        slot_align:
            0,

        slot_count:
            0,

        requested_size:
            0,

        requested_align:
            0,

        allocated:
            0,

        free:
            0,

        generation:
            0,

        revision:
            0
    };
}

proc pool_error_context_layout(
    layout: pool_alloc.PoolAllocationLayout,
    operation: PoolErrorOperation
) -> PoolErrorContext {
    give PoolErrorContext {
        operation:
            operation,

        state:
            pool_core.PoolCoreState.Empty,

        slot_index:
            0,

        slot_size:
            layout.slot_size,

        slot_align:
            layout.slot_align,

        slot_count:
            layout.slot_count,

        requested_size:
            0,

        requested_align:
            0,

        allocated:
            0,

        free:
            layout.slot_count,

        generation:
            0,

        revision:
            0
    };
}

proc pool_error_context_block(
    block: pool_block.PoolBlock,
    operation: PoolErrorOperation
) -> PoolErrorContext {
    let state = pool_block.pool_block_state(
        block
    );

    let core_state =
        if state == pool_block.PoolBlockState.Empty {
            pool_core.PoolCoreState.Empty
        } else if state == pool_block.PoolBlockState.Partial {
            pool_core.PoolCoreState.Partial
        } else if state == pool_block.PoolBlockState.Full {
            pool_core.PoolCoreState.Full
        } else if state == pool_block.PoolBlockState.Released {
            pool_core.PoolCoreState.Released
        } else {
            pool_core.PoolCoreState.Invalid
        };

    give PoolErrorContext {
        operation:
            operation,

        state:
            core_state,

        slot_index:
            0,

        slot_size:
            block.layout.slot_size,

        slot_align:
            block.layout.slot_align,

        slot_count:
            block.layout.slot_count,

        requested_size:
            0,

        requested_align:
            0,

        allocated:
            block.allocated,

        free:
            block.free,

        generation:
            block.generation,

        revision:
            block.revision
    };
}

proc pool_error_context_request(
    block: pool_block.PoolBlock,
    request: pool_alloc.PoolAllocationRequest,
    operation: PoolErrorOperation
) -> PoolErrorContext {
    let context =
        pool_error_context_block(
            block,
            operation
        );

    set context.requested_size =
        request.size;

    set context.requested_align =
        request.align;

    give context;
}

proc pool_error_context_slot(
    block: pool_block.PoolBlock,
    index: usize,
    operation: PoolErrorOperation
) -> PoolErrorContext {
    let context =
        pool_error_context_block(
            block,
            operation
        );

    set context.slot_index =
        index;

    give context;
}

// -----------------------------------------------------------------------------
// Constructors
// -----------------------------------------------------------------------------

proc pool_error(
    kind: PoolErrorKind,
    severity: PoolErrorSeverity,
    domain: PoolErrorDomain,
    context: PoolErrorContext,
    message: string
) -> PoolError {
    give PoolError {
        kind:
            kind,

        severity:
            severity,

        domain:
            domain,

        context:
            context,

        message:
            message
    };
}

proc pool_error_none()
    -> PoolError
{
    give pool_error(
        PoolErrorKind.None,
        PoolErrorSeverity.Note,
        PoolErrorDomain.General,
        pool_error_context_empty(),
        ""
    );
}

proc pool_error_simple(
    kind: PoolErrorKind,
    message: string
) -> PoolError {
    give pool_error(
        kind,
        PoolErrorSeverity.Error,
        pool_error_domain_for_kind(
            kind
        ),
        pool_error_context_empty(),
        message
    );
}

proc pool_error_fatal(
    kind: PoolErrorKind,
    message: string
) -> PoolError {
    give pool_error(
        kind,
        PoolErrorSeverity.Fatal,
        pool_error_domain_for_kind(
            kind
        ),
        pool_error_context_empty(),
        message
    );
}

// -----------------------------------------------------------------------------
// Pool state errors
// -----------------------------------------------------------------------------

proc pool_error_invalid_pool(
    block: pool_block.PoolBlock
) -> PoolError {
    give pool_error(
        PoolErrorKind.InvalidPool,
        PoolErrorSeverity.Fatal,
        PoolErrorDomain.Pool,
        pool_error_context_block(
            block,
            PoolErrorOperation.Validate
        ),
        "pool allocator is invalid"
    );
}

proc pool_error_invalid_state(
    block: pool_block.PoolBlock
) -> PoolError {
    give pool_error(
        PoolErrorKind.InvalidState,
        PoolErrorSeverity.Error,
        PoolErrorDomain.Pool,
        pool_error_context_block(
            block,
            PoolErrorOperation.Validate
        ),
        "pool allocator state is invalid"
    );
}

proc pool_error_invalid_block(
    block: pool_block.PoolBlock
) -> PoolError {
    give pool_error(
        PoolErrorKind.InvalidBlock,
        PoolErrorSeverity.Fatal,
        PoolErrorDomain.Pool,
        pool_error_context_block(
            block,
            PoolErrorOperation.Validate
        ),
        "pool backing block is invalid"
    );
}

// -----------------------------------------------------------------------------
// Layout errors
// -----------------------------------------------------------------------------

proc pool_error_invalid_layout(
    layout: pool_alloc.PoolAllocationLayout
) -> PoolError {
    give pool_error(
        PoolErrorKind.InvalidLayout,
        PoolErrorSeverity.Error,
        PoolErrorDomain.Layout,
        pool_error_context_layout(
            layout,
            PoolErrorOperation.New
        ),
        "pool allocation layout is invalid"
    );
}

proc pool_error_invalid_size(
    size: usize
) -> PoolError {
    let context =
        pool_error_context_empty();

    set context.requested_size =
        size;

    give pool_error(
        PoolErrorKind.InvalidSize,
        PoolErrorSeverity.Error,
        PoolErrorDomain.Layout,
        context,
        "pool allocation size is invalid"
    );
}

proc pool_error_invalid_alignment(
    align: usize
) -> PoolError {
    let context =
        pool_error_context_empty();

    set context.requested_align =
        align;

    give pool_error(
        PoolErrorKind.InvalidAlignment,
        PoolErrorSeverity.Error,
        PoolErrorDomain.Layout,
        context,
        "pool allocation alignment is invalid"
    );
}

proc pool_error_invalid_capacity(
    capacity: usize
) -> PoolError {
    let context =
        pool_error_context_empty();

    set context.slot_count =
        capacity;

    give pool_error(
        PoolErrorKind.InvalidCapacity,
        PoolErrorSeverity.Error,
        PoolErrorDomain.Layout,
        context,
        "pool capacity is invalid"
    );
}

