use src/vitte/stdlib/alloc/pool
use src/vitte/stdlib/alloc/pool/reset

proc test_reset_empty() -> bool {
    let mut pool = pool_new_for(
        "reset-empty",
        16
    );

    let result = pool_reset_all(
        ref mut pool
    );

    give result.success
        and result.mode == PoolResetMode.Reset
        and result.state == PoolResetState.Applied
        and result.released_slots == 0
        and pool_is_empty(pool)
        and pool_allocated(pool) == 0
        and pool_free_count(pool) == 16;
}

proc test_reset_partial() -> bool {
    let mut pool = pool_new_for(
        "reset-partial",
        16
    );

    let index: usize = 0;

    while index < 8 {
        if is_none(
            pool_emplace(
                ref mut pool,
                index as int
            )
        ) {
            give false;
        }

        set index = index + 1;
    }

    let result = pool_reset_all(
        ref mut pool
    );

    give result.success
        and result.state == PoolResetState.Applied
        and result.released_slots == 8
        and pool_allocated(pool) == 0
        and pool_free_count(pool) == 16
        and pool_is_empty(pool);
}

proc test_reset_full() -> bool {
    let mut pool = pool_new_for(
        "reset-full",
        8
    );

    let index: usize = 0;

    while index < 8 {
        if is_none(
            pool_emplace(
                ref mut pool,
                index as int
            )
        ) {
            give false;
        }

        set index = index + 1;
    }

    if not pool_is_full(pool) {
        give false;
    }

    let result = pool_reset_all(
        ref mut pool
    );

    give result.success
        and result.released_slots == 8
        and pool_is_empty(pool)
        and pool_free_count(pool) == 8;
}

proc test_reset_changes_generation() -> bool {
    let mut pool = pool_new_for(
        "reset-generation",
        16
    );

    let before = pool_generation(
        pool
    );

    let result = pool_reset_all(
        ref mut pool
    );

    give result.success
        and result.generation_changed
        and pool_generation(pool) > before;
}

proc test_reset_changes_revision() -> bool {
    let mut pool = pool_new_for(
        "reset-revision",
        16
    );

    let before = pool_revision(
        pool
    );

    let result = pool_reset_all(
        ref mut pool
    );

    give result.success
        and result.revision_changed
        and pool_revision(pool) > before;
}

proc test_reset_invalidates_handle() -> bool {
    let mut pool = pool_new_for(
        "reset-handle",
        16
    );

    let handle = pool_emplace_handle(
        ref mut pool,
        42
    );

    pick handle {
        Some(value) {
            if not pool_handle_valid(
                pool,
                value
            ) {
                give false;
            }

            let result = pool_reset_all(
                ref mut pool
            );

            give result.success
                and pool_reset_invalidates_handles(
                    result
                )
                and not pool_handle_valid(
                    pool,
                    value
                );
        }

        None {
            give false;
        }
    }
}

