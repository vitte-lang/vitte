proc test_reset_after_release() -> bool {
    let mut pool = pool_new_for(
        "reset-after-release",
        16
    );

    let release = pool_release_all(
        ref mut pool
    );

    if not release.success {
        give false;
    }

    let reset = pool_reset_all(
        ref mut pool
    );

    give not reset.success
        and reset.failure == PoolResetFailure.AlreadyReleased;
}

