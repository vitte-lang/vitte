proc test_statistics_empty() -> bool {
    let statistics =
        pool_reset_statistics_empty();

    give statistics.reset_attempts == 0
        and statistics.reset_successes == 0
        and statistics.reset_failures == 0
        and statistics.release_attempts == 0
        and statistics.release_successes == 0
        and statistics.release_failures == 0
        and statistics.skipped == 0
        and statistics.slots_reclaimed == 0;
}

proc test_statistics_reset_success() -> bool {
    let mut pool = pool_new_for(
        "stats-reset",
        16
    );

    let index: usize = 0;

    while index < 5 {
        if is_none(
            pool_emplace(
                ref mut pool,
                index as int
            )
        ) {
            give false;
        }

        set index = index + 1;
    }

    let result = pool_reset_all(
        ref mut pool
    );

    let mut statistics =
        pool_reset_statistics_empty();

    pool_reset_statistics_record(
        ref mut statistics,
        result
    );

    give statistics.reset_attempts == 1
        and statistics.reset_successes == 1
        and statistics.reset_failures == 0
        and statistics.slots_reclaimed == 5;
}

proc test_statistics_release_success() -> bool {
    let mut pool = pool_new_for(
        "stats-release",
        16
    );

    let result = pool_release_all(
        ref mut pool
    );

    let mut statistics =
        pool_reset_statistics_empty();

    pool_reset_statistics_record(
        ref mut statistics,
        result
    );

    give statistics.release_attempts == 1
        and statistics.release_successes == 1
        and statistics.release_failures == 0;
}

proc test_statistics_skip() -> bool {
    let mut pool = pool_new_for(
        "stats-skip",
