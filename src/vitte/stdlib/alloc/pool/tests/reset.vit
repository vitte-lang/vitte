    give result.success
        and pool_reset_clears_allocations(
            result
        )
        and pool_reset_restores_capacity(
            result
        );
}

proc test_reset_snapshot_changed() -> bool {
    let mut pool = pool_new_for(
        "reset-snapshot",
        16
    );

    if is_none(
        pool_emplace(
            ref mut pool,
            42
        )
    ) {
        give false;
    }

    let before = pool_reset_snapshot(
        pool
    );

    let result = pool_reset_all(
        ref mut pool
    );

    let after = pool_reset_snapshot(
        pool
    );

    give result.success
        and pool_reset_snapshot_changed(
            before,
            after
        );
}

