proc test_profile_empty() -> bool {
    let list = pool_free_list_default(16);

    let profile = pool_free_profile(
        list
    );

    give profile.capacity == 16
        and profile.free == 16
        and profile.allocated == 0
        and profile.empty
        and profile.available
        and not profile.exhausted
        and not profile.released
        and profile.valid;
}

proc test_profile_partial() -> bool {
    let mut list = pool_free_list_default(4);

    let mut entries: [PoolFreeEntry] = [
        pool_free_entry(0),
        pool_free_entry(1),
        pool_free_entry(2),
        pool_free_entry(3)
    ];

    if is_none(
        pool_free_allocate(
            ref mut list,
            ref mut entries
        )
    ) {
        give false;
    }

    let profile = pool_free_profile(
        list
    );

    give profile.free == 3
        and profile.allocated == 1
        and profile.available
        and not profile.empty;
}

proc test_profile_exhausted() -> bool {
    let mut list = pool_free_list_default(2);

    let mut entries: [PoolFreeEntry] = [
        pool_free_entry(0),
        pool_free_entry(1)
    ];

    if is_none(
        pool_free_allocate(
            ref mut list,
            ref mut entries
        )
    ) {
        give false;
    }

    if is_none(
        pool_free_allocate(
            ref mut list,
            ref mut entries
        )
    ) {
        give false;
    }

    let profile = pool_free_profile(
        list
    );

    give profile.exhausted
        and profile.free == 0
        and profile.allocated == 2;
}

proc test_snapshot_equal() -> bool {
    let list = pool_free_list_default(8);

    let first = pool_free_snapshot(
        list
    );

    let second = pool_free_snapshot(
        list
    );

    give pool_free_snapshot_equal(
        first,
        second
    );
}

proc test_snapshot_allocate_changed() -> bool {
    let mut list = pool_free_list_default(8);

    let mut entries: [PoolFreeEntry] = [
        pool_free_entry(0),
        pool_free_entry(1),
        pool_free_entry(2),
        pool_free_entry(3),
        pool_free_entry(4),
        pool_free_entry(5),
        pool_free_entry(6),
        pool_free_entry(7)
    ];

    let before = pool_free_snapshot(
        list
    );

    if is_none(
        pool_free_allocate(
            ref mut list,
            ref mut entries
        )
    ) {
        give false;
    }

    let after = pool_free_snapshot(
        list
    );

    give pool_free_snapshot_changed(
        before,
        after
    );
}

proc test_delta_allocate() -> bool {
    let mut list = pool_free_list_default(8);

    let mut entries: [PoolFreeEntry] = [
        pool_free_entry(0),
        pool_free_entry(1),
        pool_free_entry(2),
        pool_free_entry(3),
        pool_free_entry(4),
        pool_free_entry(5),
        pool_free_entry(6),
        pool_free_entry(7)
    ];

    let before = pool_free_snapshot(
        list
    );

    if is_none(
        pool_free_allocate(
            ref mut list,
            ref mut entries
        )
    ) {
        give false;
    }

    let after = pool_free_snapshot(
        list
    );

    let delta = pool_free_delta(
        before,
        after
    );

    give delta.changed
        and delta.free == -1
        and delta.revision > 0;
}

proc test_delta_release() -> bool {
    let mut list = pool_free_list_default(8);

    let mut entries: [PoolFreeEntry] = [
        pool_free_entry(0),
        pool_free_entry(1),
        pool_free_entry(2),
        pool_free_entry(3),
        pool_free_entry(4),
        pool_free_entry(5),
        pool_free_entry(6),
        pool_free_entry(7)
    ];

    let result = pool_free_allocate(
        ref mut list,
        ref mut entries
    );

    pick result {
        Some(index) {
            let before = pool_free_snapshot(
                list
            );

            if not pool_free_release(
                ref mut list,
                ref mut entries,
                index
            ) {
                give false;
            }

            let after = pool_free_snapshot(
                list
            );

            let delta = pool_free_delta(
                before,
                after
            );

            give delta.changed
                and delta.free == 1;
        }

        None {
            give false;
        }
    }
}

