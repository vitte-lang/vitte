use src/vitte/stdlib/alloc/pool/free

proc test_entry_free() -> bool {
    let entry = pool_free_entry(0);

    give pool_free_entry_is_free(entry)
        and not pool_free_entry_is_allocated(entry)
        and entry.index == 0;
}

proc test_entry_allocate() -> bool {
    let mut entry = pool_free_entry(2);

    give pool_free_entry_allocate(
        ref mut entry
    )
    and pool_free_entry_is_allocated(entry)
    and not pool_free_entry_is_free(entry);
}

proc test_entry_allocate_twice() -> bool {
    let mut entry = pool_free_entry(1);

    let first = pool_free_entry_allocate(
        ref mut entry
    );

    let second = pool_free_entry_allocate(
        ref mut entry
    );

    give first
        and not second;
}

proc test_entry_release() -> bool {
    let mut entry = pool_free_entry(3);

    if not pool_free_entry_allocate(
        ref mut entry
    ) {
        give false;
    }

    let generation =
        entry.generation;

    give pool_free_entry_release(
        ref mut entry
    )
    and pool_free_entry_is_free(entry)
    and entry.generation > generation;
}

proc test_entry_release_free() -> bool {
    let mut entry = pool_free_entry(3);

    give not pool_free_entry_release(
        ref mut entry
    );
}

proc test_list_default() -> bool {
    let list = pool_free_list_default(16);

    give pool_free_capacity(list) == 16
        and pool_free_count(list) == 16
        and pool_free_allocated_count(list) == 0
        and pool_free_is_empty(list)
        and pool_free_is_available(list)
        and pool_free_is_valid(list);
}

proc test_list_strategy() -> bool {
    let list = pool_free_list(
        16,
        PoolFreeStrategy.FirstFit
    );

    give list.strategy == PoolFreeStrategy.FirstFit
        and pool_free_strategy_name(
            list.strategy
        ) == "first-fit";
}

proc test_index_valid() -> bool {
    let list = pool_free_list_default(8);

    give pool_free_index_valid(list, 0)
        and pool_free_index_valid(list, 7)
        and not pool_free_index_valid(list, 8);
}

proc test_next_index() -> bool {
    let list = pool_free_list_default(8);

    give pool_free_next_index(list, 0) == 1
        and pool_free_next_index(list, 7) == 0;
}

proc test_previous_index() -> bool {
    let list = pool_free_list_default(8);

    give pool_free_previous_index(list, 1) == 0
