proc test_allocate() -> bool {
    let mut list = pool_free_list_default(4);

    let mut entries: [PoolFreeEntry] = [
        pool_free_entry(0),
        pool_free_entry(1),
        pool_free_entry(2),
        pool_free_entry(3)
    ];

    let result = pool_free_allocate(
        ref mut list,
        ref mut entries
    );

    pick result {
        Some(index) {
            give index == 0
                and pool_free_count(list) == 3
                and pool_free_allocated_count(list) == 1
                and pool_free_entry_is_allocated(
                    entries[index]
                );
        }

        None {
            give false;
        }
    }
}

proc test_allocate_multiple() -> bool {
    let mut list = pool_free_list_default(8);

    let mut entries: [PoolFreeEntry] = [
        pool_free_entry(0),
        pool_free_entry(1),
        pool_free_entry(2),
        pool_free_entry(3),
        pool_free_entry(4),
        pool_free_entry(5),
        pool_free_entry(6),
        pool_free_entry(7)
    ];

    let index: usize = 0;

    while index < 6 {
        if is_none(
            pool_free_allocate(
                ref mut list,
                ref mut entries
            )
        ) {
            give false;
        }

        set index = index + 1;
    }

    give pool_free_count(list) == 2
        and pool_free_allocated_count(list) == 6
        and pool_free_state(list)
            == PoolFreeState.Available;
}

proc test_exhaust() -> bool {
    let mut list = pool_free_list_default(4);

    let mut entries: [PoolFreeEntry] = [
        pool_free_entry(0),
        pool_free_entry(1),
        pool_free_entry(2),
        pool_free_entry(3)
    ];

    let index: usize = 0;

    while index < 4 {
        if is_none(
            pool_free_allocate(
                ref mut list,
                ref mut entries
            )
        ) {
            give false;
        }

        set index = index + 1;
    }

    give pool_free_is_exhausted(list)
        and pool_free_count(list) == 0
        and pool_free_allocated_count(list) == 4
        and is_none(
            pool_free_allocate(
                ref mut list,
                ref mut entries
            )
        );
}

proc test_release() -> bool {
    let mut list = pool_free_list_default(4);

    let mut entries: [PoolFreeEntry] = [
        pool_free_entry(0),
        pool_free_entry(1),
        pool_free_entry(2),
        pool_free_entry(3)
    ];

    let result = pool_free_allocate(
        ref mut list,
        ref mut entries
    );

    pick result {
        Some(index) {
            give pool_free_release(
                ref mut list,
                ref mut entries,
                index
            )
            and pool_free_count(list) == 4
            and pool_free_allocated_count(list) == 0
            and pool_free_entry_is_free(
                entries[index]
            );
        }

        None {
            give false;
        }
    }
}

proc test_release_twice() -> bool {
    let mut list = pool_free_list_default(4);

    let mut entries: [PoolFreeEntry] = [
        pool_free_entry(0),
        pool_free_entry(1),
        pool_free_entry(2),
        pool_free_entry(3)
    ];

    let result = pool_free_allocate(
        ref mut list,
        ref mut entries
    );

    pick result {
        Some(index) {
            let first = pool_free_release(
                ref mut list,
                ref mut entries,
                index
            );

            let second = pool_free_release(
                ref mut list,
                ref mut entries,
                index
            );

            give first
                and not second;
        }

        None {
            give false;
        }
    }
}

proc test_release_invalid_index() -> bool {
    let mut list = pool_free_list_default(4);

    let mut entries: [PoolFreeEntry] = [
        pool_free_entry(0),
        pool_free_entry(1),
        pool_free_entry(2),
        pool_free_entry(3)
    ];

    give not pool_free_release(
        ref mut list,
        ref mut entries,
        10
    );
}

proc test_reuse() -> bool {
    let mut list = pool_free_list_default(1);

    let mut entries: [PoolFreeEntry] = [
        pool_free_entry(0)
    ];

    let first = pool_free_allocate(
        ref mut list,
        ref mut entries
    );

    pick first {
        Some(old_index) {
            let old_generation =
                entries[old_index].generation;

            if not pool_free_release(
                ref mut list,
                ref mut entries,
                old_index
            ) {
                give false;
            }

            let second = pool_free_allocate(
                ref mut list,
                ref mut entries
            );

            pick second {
                Some(new_index) {
                    give new_index == old_index
                        and entries[new_index].generation
                            > old_generation
                        and pool_free_entry_is_allocated(
                            entries[new_index]
                        );
                }

                None {
                    give false;
                }
            }
        }

        None {
            give false;
        }
    }
}

proc test_reset() -> bool {
    let mut list = pool_free_list_default(8);

    let mut entries: [PoolFreeEntry] = [
        pool_free_entry(0),
        pool_free_entry(1),
        pool_free_entry(2),
        pool_free_entry(3),
        pool_free_entry(4),
        pool_free_entry(5),
        pool_free_entry(6),
        pool_free_entry(7)
    ];

    let index: usize = 0;

    while index < 6 {
        if is_none(
            pool_free_allocate(
                ref mut list,
                ref mut entries
            )
        ) {
            give false;
        }

        set index = index + 1;
    }

    let generation =
        list.generation;

    pool_free_reset(
        ref mut list,
        ref mut entries
    );

    give pool_free_is_empty(list)
        and pool_free_count(list) == 8
        and pool_free_allocated_count(list) == 0
        and list.generation > generation;
}

proc test_reset_entries() -> bool {
    let mut list = pool_free_list_default(4);

    let mut entries: [PoolFreeEntry] = [
        pool_free_entry(0),
        pool_free_entry(1),
        pool_free_entry(2),
        pool_free_entry(3)
    ];

    let index: usize = 0;

    while index < 4 {
        if is_none(
            pool_free_allocate(
                ref mut list,
                ref mut entries
            )
        ) {
            give false;
        }

        set index = index + 1;
    }

    pool_free_reset(
        ref mut list,
        ref mut entries
    );

    let check: usize = 0;

    while check < 4 {
        if not pool_free_entry_is_free(
            entries[check]
        ) {
            give false;
        }

        set check = check + 1;
    }

    give true;
}

