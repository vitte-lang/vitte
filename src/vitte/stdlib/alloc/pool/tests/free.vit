}

proc test_many_allocate_release_cycles() -> bool {
    let mut list = pool_free_list_default(64);

    let mut entries: [PoolFreeEntry] = [];

    let build: usize = 0;

    while build < 64 {
        set entries =
            entries + [
                pool_free_entry(build)
            ];

        set build = build + 1;
    }

    let cycle: usize = 0;

    while cycle < 10000 {
        let result = pool_free_allocate(
            ref mut list,
            ref mut entries
        );

        pick result {
            Some(index) {
                if not pool_free_release(
                    ref mut list,
                    ref mut entries,
                    index
                ) {
                    give false;
                }
            }

            None {
                give false;
            }
        }

        if not pool_free_is_empty(list) {
            give false;
        }

        if not pool_free_invariant_holds(list) {
            give false;
        }

        set cycle = cycle + 1;
    }

    give true;
}

proc test_many_full_reset_cycles() -> bool {
    let mut list = pool_free_list_default(64);

    let mut entries: [PoolFreeEntry] = [];

    let build: usize = 0;

    while build < 64 {
        set entries =
            entries + [
                pool_free_entry(build)
            ];

        set build = build + 1;
    }

    let cycle: usize = 0;

    while cycle < 1000 {
        let index: usize = 0;

        while index < 64 {
            if is_none(
                pool_free_allocate(
                    ref mut list,
                    ref mut entries
                )
            ) {
                give false;
            }

            set index = index + 1;
        }

        if not pool_free_is_exhausted(
            list
        ) {
            give false;
        }

        pool_free_reset(
            ref mut list,
            ref mut entries
        );

        if not pool_free_is_empty(
            list
        ) {
            give false;
        }

        set cycle = cycle + 1;
    }

    give pool_free_is_valid(list);
}

proc test_reuse_generation_stress() -> bool {
    let mut list = pool_free_list_default(1);

    let mut entries: [PoolFreeEntry] = [
        pool_free_entry(0)
    ];

    let generation =
        entries[0].generation;

    let cycle: usize = 0;

    while cycle < 10000 {
        let result = pool_free_allocate(
            ref mut list,
            ref mut entries
        );

        if is_none(result) {
            give false;
        }

        if not pool_free_release(
            ref mut list,
            ref mut entries,
            0
        ) {
            give false;
        }

        set cycle = cycle + 1;
    }

    give entries[0].generation
        > generation;
}

proc test_accounting_stress() -> bool {
    let mut list = pool_free_list_default(128);

    let mut entries: [PoolFreeEntry] = [];

    let build: usize = 0;

    while build < 128 {
        set entries =
            entries + [
                pool_free_entry(build)
            ];

        set build = build + 1;
    }

    let cycle: usize = 0;

    while cycle < 1000 {
        let count: usize = 0;

        while count < 100 {
            if is_none(
                pool_free_allocate(
                    ref mut list,
                    ref mut entries
                )
            ) {
                give false;
            }

            if pool_free_count(list)
                + pool_free_allocated_count(list)
                != pool_free_capacity(list)
            {
                give false;
            }

            set count = count + 1;
        }

        pool_free_reset(
            ref mut list,
            ref mut entries
        );

        set cycle = cycle + 1;
    }

    give pool_free_invariant_holds(
        list
    );
}

proc run_free_tests() -> bool {
    give test_entry_free()
        and test_entry_allocate()
        and test_entry_allocate_twice()
        and test_entry_release()
        and test_entry_release_free()

        and test_list_default()
        and test_list_strategy()

        and test_index_valid()
        and test_next_index()
        and test_previous_index()

        and test_hint()
        and test_invalid_hint()
        and test_advance_hint()

        and test_find_first()
        and test_find_first_after_allocate()
        and test_find_next()
        and test_find_lifo()
        and test_find_fifo()

        and test_allocate()
        and test_allocate_multiple()
        and test_exhaust()

        and test_release()
        and test_release_twice()
        and test_release_invalid_index()
        and test_reuse()

        and test_reset()
        and test_reset_entries()

        and test_release_list()
        and test_release_list_twice()

        and test_validation()
        and test_invariant()

        and test_profile_empty()
        and test_profile_partial()
        and test_profile_exhausted()

        and test_snapshot_equal()
        and test_snapshot_allocate_changed()
        and test_delta_allocate()
        and test_delta_release()

        and test_error_none()

        and test_core_state_empty()
        and test_core_state_partial()
        and test_core_state_full()

        and test_statistics_empty()
        and test_statistics_search_hit()
        and test_statistics_search_miss()
        and test_statistics_average_scan()
        and test_statistics_reset()

        and test_state_names()
        and test_strategy_names()

        and test_many_allocate_release_cycles()
        and test_many_full_reset_cycles()
        and test_reuse_generation_stress()
        and test_accounting_stress();
}

proc main() -> int {
    if run_free_tests() {
        give 0;
    }

    give 1;
}
