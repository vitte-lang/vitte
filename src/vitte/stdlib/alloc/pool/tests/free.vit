proc test_find_first() -> bool {
    let list = pool_free_list(
        4,
        PoolFreeStrategy.FirstFit
    );

    let entries: [PoolFreeEntry] = [
        pool_free_entry(0),
        pool_free_entry(1),
        pool_free_entry(2),
        pool_free_entry(3)
    ];

    let result = pool_free_find_first(
        list,
        ref entries
    );

    pick result {
        Some(index) {
            give index == 0;
        }

        None {
            give false;
        }
    }
}

proc test_find_first_after_allocate() -> bool {
    let list = pool_free_list(
