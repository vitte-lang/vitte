        pool_free_entry(1),
        pool_free_entry(2),
        pool_free_entry(3)
    ];

    pool_free_entry_allocate(
        ref mut entries[0]
    );

    let result = pool_free_find_first(
        list,
        ref entries
    );

    pick result {
        Some(index) {
            give index == 1;
        }

        None {
            give false;
        }
    }
}

