proc test_profile_empty() -> bool {
    let pool = pool_new_for(
        "profile-empty",
        32
    );

    let profile = pool_profile(
        pool
    );

    give profile.capacity == 32
        and profile.allocated == 0
        and profile.free == 32
        and profile.empty
        and not profile.partial
        and not profile.full
        and not profile.released
        and profile.valid;
}

proc test_profile_partial() -> bool {
    let mut pool = pool_new_for(
        "profile-partial",
        32
    );

    if is_none(
        pool_alloc(
            ref mut pool
        )
    ) {
        give false;
    }

    let profile = pool_profile(
        pool
    );

    give profile.allocated == 1
        and profile.free == 31
        and profile.partial
        and not profile.empty
        and not profile.full
        and profile.valid;
}

proc test_profile_full() -> bool {
    let mut pool = pool_new_for(
        "profile-full",
        2
    );

    if is_none(
        pool_alloc(
            ref mut pool
        )
    ) {
        give false;
    }

    if is_none(
        pool_alloc(
            ref mut pool
        )
    ) {
        give false;
    }

    let profile = pool_profile(
        pool
    );

    give profile.full
        and profile.allocated == 2
        and profile.free == 0;
}

