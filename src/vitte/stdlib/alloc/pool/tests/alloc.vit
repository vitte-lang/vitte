proc test_emplace_point() -> bool {
    let mut pool = pool_new_for(
        "emplace-point",
        32
    );

    let result = pool_emplace(
        ref mut pool,
        Point {
            x: 10
            y: 20
        }
    );

    pick result {
        Some(point) {
            give point.x == 10
                and point.y == 20;
        }

        None {
            give false;
        }
    }
}

proc test_emplace_mutate() -> bool {
    let mut pool = pool_new_for(
        "emplace-mut",
        32
    );

    let result = pool_emplace(
        ref mut pool,
        Point {
            x: 1
            y: 2
        }
    );

    pick result {
        Some(point) {
            set point.x = 100;
            set point.y = 200;

            give point.x == 100
                and point.y == 200;
        }

        None {
            give false;
        }
    }
}

proc test_handle_allocate() -> bool {
    let mut pool = pool_new_for(
        "handle",
        32
    );

    let result = pool_alloc_handle(
        ref mut pool
    );

    pick result {
        Some(handle) {
            give pool_handle_valid(
                pool,
                handle
            )
            and handle.index < 32;
        }

        None {
            give false;
        }
    }
}

proc test_handle_emplace() -> bool {
    let mut pool = pool_new_for(
        "handle-emplace",
        32
    );

    let result = pool_emplace_handle(
        ref mut pool,
        Point {
            x: 20
            y: 40
        }
    );

    pick result {
        Some(handle) {
            give pool_handle_valid(
                pool,
                handle
            );
        }

        None {
            give false;
        }
    }
}

proc test_handle_get() -> bool {
    let mut pool = pool_new_for(
        "handle-get",
        32
    );

    let result = pool_emplace_handle(
        ref mut pool,
        Point {
            x: 10
            y: 20
        }
    );

    pick result {
        Some(handle) {
            let value = pool_get(
                ref pool,
                handle
            );

            pick value {
                Some(point) {
                    give point.x == 10
                        and point.y == 20;
                }

                None {
                    give false;
                }
            }
        }

        None {
            give false;
        }
    }
}

proc test_handle_get_mut() -> bool {
    let mut pool = pool_new_for(
        "handle-get-mut",
        32
    );

    let result = pool_emplace_handle(
