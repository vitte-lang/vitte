    give validation.valid
        and validation.block_valid
        and validation.free_list_valid
        and validation.accounting_valid
        and validation.state_valid
        and validation.generation_valid;
}

proc test_validation_partial() -> bool {
    let mut pool = pool_new_for(
        "validation-partial",
        32
    );

    if is_none(
        pool_alloc(
            ref mut pool
        )
    ) {
        give false;
    }

    give pool_validate(pool).valid
        and pool_invariant_holds(pool);
}

proc test_snapshot_equal() -> bool {
    let pool = pool_new_for(
        "snapshot-equal",
        32
    );

    let first = pool_snapshot(pool);
    let second = pool_snapshot(pool);

    give pool_snapshot_equal(
        first,
        second
    );
}

proc test_snapshot_allocate_changed() -> bool {
    let mut pool = pool_new_for(
        "snapshot-alloc",
        32
    );

    let before = pool_snapshot(
        pool
    );

    if is_none(
        pool_alloc(
            ref mut pool
        )
    ) {
        give false;
    }

    let after = pool_snapshot(
        pool
    );

    give pool_snapshot_changed(
        before,
        after
    );
}

proc test_delta_allocate() -> bool {
    let mut pool = pool_new_for(
        "delta-alloc",
        32
    );

    let before = pool_snapshot(
        pool
    );

    if is_none(
        pool_alloc(
            ref mut pool
        )
    ) {
        give false;
    }

    let after = pool_snapshot(
        pool
    );

    let delta = pool_delta(
        before,
        after
    );

    give delta.changed
        and delta.allocated == 1
        and delta.free == -1
        and delta.revision > 0;
}

proc test_delta_release() -> bool {
    let mut pool = pool_new_for(
        "delta-release",
        32
    );

    let result = pool_emplace_handle(
        ref mut pool,
        42
    );

    pick result {
        Some(handle) {
            let before = pool_snapshot(
                pool
            );

            if not pool_release_handle(
                ref mut pool,
                handle
            ) {
                give false;
            }

            let after = pool_snapshot(
                pool
            );

            let delta = pool_delta(
                before,
                after
            );

            give delta.changed
                and delta.allocated == -1
                and delta.free == 1
                and delta.revision > 0;
        }

        None {
            give false;
        }
    }
}

proc test_reset() -> bool {
    let mut pool = pool_new_for(
        "reset",
        32
    );

    let index: usize = 0;

    while index < 20 {
        if is_none(
            pool_alloc(
                ref mut pool
            )
        ) {
            give false;
        }

        set index = index + 1;
    }

    pool_reset(
        ref mut pool
    );

    give pool_allocated(pool) == 0
        and pool_free_count(pool) == 32
        and pool_is_empty(pool)
        and pool_is_valid(pool);
}

proc test_reset_generation() -> bool {
    let mut pool = pool_new_for(
        "reset-generation",
        32
    );

    let before = pool_generation(
        pool
    );

    pool_reset(
        ref mut pool
    );

    give pool_generation(pool)
        > before;
}

proc test_reset_invalidates_handle() -> bool {
    let mut pool = pool_new_for(
        "reset-handle",
        32
    );

    let result = pool_emplace_handle(
        ref mut pool,
        42
    );

    pick result {
        Some(handle) {
            pool_reset(
                ref mut pool
            );

            give not pool_handle_valid(
                pool,
                handle
            );
        }

        None {
            give false;
        }
    }
}

proc test_reset_reuse() -> bool {
    let mut pool = pool_new_for(
        "reset-reuse",
        8
    );

    let index: usize = 0;

    while index < 8 {
        if is_none(
            pool_alloc(
                ref mut pool
            )
        ) {
            give false;
        }

        set index = index + 1;
    }

    if not pool_is_full(pool) {
        give false;
    }

    pool_reset(
        ref mut pool
    );

    let result = pool_alloc(
        ref mut pool
    );

    give is_some(result)
        and pool_allocated(pool) == 1;
}

