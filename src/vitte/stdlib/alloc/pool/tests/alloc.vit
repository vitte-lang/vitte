proc test_handle_multiple() -> bool {
    let mut pool = pool_new_for(
        "handle-multiple",
        16
    );

    let first = pool_emplace_handle(
        ref mut pool,
        10
    );

    let second = pool_emplace_handle(
        ref mut pool,
        20
    );

    pick first {
        Some(a) {
            pick second {
                Some(b) {
                    give a.index != b.index
                        and pool_handle_valid(pool, a)
                        and pool_handle_valid(pool, b);
                }

                None {
                    give false;
                }
            }
        }

        None {
            give false;
        }
    }
}

proc test_release_handle() -> bool {
    let mut pool = pool_new_for(
        "release-handle",
        16
    );

    let result = pool_emplace_handle(
        ref mut pool,
        42
    );

    pick result {
        Some(handle) {
            if not pool_release_handle(
                ref mut pool,
                handle
            ) {
                give false;
            }

            give pool_allocated(pool) == 0
                and pool_free_count(pool) == 16
                and pool_is_empty(pool);
        }

        None {
            give false;
        }
    }
}

proc test_released_handle_invalid() -> bool {
    let mut pool = pool_new_for(
        "release-invalid",
        16
    );

    let result = pool_emplace_handle(
        ref mut pool,
        42
    );

    pick result {
        Some(handle) {
            if not pool_release_handle(
                ref mut pool,
                handle
            ) {
                give false;
            }

            give not pool_handle_valid(
                pool,
                handle
            );
        }

        None {
            give false;
        }
    }
}

proc test_double_release_fails() -> bool {
    let mut pool = pool_new_for(
        "double-release",
        16
    );

    let result = pool_emplace_handle(
        ref mut pool,
        42
    );

    pick result {
        Some(handle) {
            let first = pool_release_handle(
                ref mut pool,
                handle
            );

            let second = pool_release_handle(
                ref mut pool,
                handle
            );

            give first
                and not second;
        }

        None {
            give false;
        }
    }
}

proc test_slot_reuse() -> bool {
    let mut pool = pool_new_for(
        "reuse",
        8
    );

    let first = pool_emplace_handle(
        ref mut pool,
        10
    );

    pick first {
        Some(old_handle) {
            let old_index =
                old_handle.index;

            if not pool_release_handle(
                ref mut pool,
                old_handle
            ) {
                give false;
            }

            let second = pool_emplace_handle(
                ref mut pool,
                20
            );

            pick second {
                Some(new_handle) {
                    give new_handle.index
                            == old_index
                        and new_handle.generation
                            != old_handle.generation
                        and not pool_handle_valid(
                            pool,
                            old_handle
                        )
                        and pool_handle_valid(
                            pool,
                            new_handle
                        );
                }

                None {
                    give false;
                }
            }
        }

        None {
            give false;
        }
    }
}

proc test_release_index() -> bool {
    let mut pool = pool_new_for(
        "release-index",
        16
    );

    let result = pool_emplace_handle(
        ref mut pool,
        42
    );

    pick result {
        Some(handle) {
            give pool_release_index(
                ref mut pool,
                handle.index
            )
            and pool_allocated(pool) == 0;
        }

        None {
            give false;
        }
    }
}

proc test_release_invalid_index() -> bool {
    let mut pool = pool_new_for(
        "release-invalid-index",
        16
    );

    give not pool_release_index(
        ref mut pool,
        99
    );
}

proc test_release_free_index() -> bool {
    let mut pool = pool_new_for(
        "release-free-index",
        16
    );

    give not pool_release_index(
        ref mut pool,
        0
    );
}

proc test_reuse_after_release() -> bool {
    let mut pool = pool_new_for(
        "reuse-release",
        1
    );

    let first = pool_emplace_handle(
        ref mut pool,
        10
    );

    pick first {
        Some(handle) {
            if not pool_is_full(pool) {
                give false;
            }

            if not pool_release_handle(
                ref mut pool,
                handle
            ) {
                give false;
            }

            if not pool_is_empty(pool) {
                give false;
            }

            let second = pool_emplace_handle(
                ref mut pool,
                20
            );

            give is_some(second)
                and pool_is_full(pool);
        }

        None {
            give false;
        }
    }
}

proc test_accounting() -> bool {
    let mut pool = pool_new_for(
        "accounting",
        64
    );

    let index: usize = 0;

    while index < 40 {
        if is_none(
            pool_alloc(
                ref mut pool
            )
        ) {
            give false;
        }

        set index = index + 1;
    }

    give pool_allocated(pool)
            + pool_free_count(pool)
            == pool_capacity(pool)
        and pool_accounting_valid(pool);
}

