use src/vitte/stdlib/alloc/pool

form Point {
    x: int
    y: int
}

form User {
    id: int
    active: bool
}

proc test_create() -> bool {
    let pool = pool_new_for(
        "alloc-create",
        64
    );

    give pool_capacity(pool) == 64
        and pool_allocated(pool) == 0
        and pool_free_count(pool) == 64
        and pool_is_empty(pool)
        and pool_is_valid(pool);
}

proc test_default() -> bool {
    let pool = pool_default_for(
        "alloc-default"
    );

    give pool_capacity(pool) == POOL_DEFAULT_SLOTS
        and pool_allocated(pool) == 0
        and pool_free_count(pool) == POOL_DEFAULT_SLOTS;
}

proc test_initial_state() -> bool {
    let pool = pool_new_for(
        "alloc-state",
        32
    );

    give pool_state(pool) == PoolState.Empty
        and pool_is_empty(pool)
        and not pool_is_partial(pool)
        and not pool_is_full(pool)
        and not pool_is_released(pool);
}

proc test_allocate() -> bool {
    let mut pool = pool_new_for(
        "alloc-one",
        16
    );

    let result = pool_alloc(
        ref mut pool
    );

    give is_some(result)
        and pool_allocated(pool) == 1
        and pool_free_count(pool) == 15
        and pool_is_partial(pool);
}

proc test_allocate_two() -> bool {
    let mut pool = pool_new_for(
        "alloc-two",
        16
    );

    let first = pool_alloc(
        ref mut pool
    );

    let second = pool_alloc(
        ref mut pool
    );

    give is_some(first)
        and is_some(second)
        and pool_allocated(pool) == 2
        and pool_free_count(pool) == 14;
}

proc test_allocate_many() -> bool {
    let mut pool = pool_new_for(
        "alloc-many",
        128
    );

    let index: usize = 0;

    while index < 100 {
        let result = pool_alloc(
            ref mut pool
        );

        if is_none(result) {
            give false;
        }

        set index = index + 1;
    }

    give pool_allocated(pool) == 100
        and pool_free_count(pool) == 28
        and pool_is_partial(pool);
}

proc test_fill_pool() -> bool {
    let mut pool = pool_new_for(
        "alloc-full",
        64
    );

    let index: usize = 0;

    while index < 64 {
        let result = pool_alloc(
            ref mut pool
        );

        if is_none(result) {
            give false;
        }

        set index = index + 1;
    }

    give pool_allocated(pool) == 64
        and pool_free_count(pool) == 0
        and pool_is_full(pool)
        and not pool_can_allocate(pool);
}

proc test_allocate_when_full() -> bool {
    let mut pool = pool_new_for(
        "alloc-full-failure",
        8
    );

    let index: usize = 0;

    while index < 8 {
        if is_none(
            pool_alloc(
                ref mut pool
            )
        ) {
            give false;
        }

        set index = index + 1;
    }

    let result = pool_alloc(
        ref mut pool
    );

    give is_none(result)
        and pool_is_full(pool)
        and pool_allocated(pool) == 8;
}

proc test_emplace_int() -> bool {
    let mut pool = pool_new_for(
        "emplace-int",
        32
    );

    let result = pool_emplace(
        ref mut pool,
        42
    );

    pick result {
        Some(value) {
            give *value == 42;
        }

        None {
            give false;
        }
    }
}

proc test_emplace_negative() -> bool {
    let mut pool = pool_new_for(
        "emplace-negative",
        32
    );

    let result = pool_emplace(
        ref mut pool,
        -42
    );

    pick result {
        Some(value) {
            give *value == -42;
        }

        None {
            give false;
        }
    }
}

proc test_emplace_bool() -> bool {
    let mut pool = pool_new_for(
        "emplace-bool",
        32
    );

    let result = pool_emplace(
        ref mut pool,
        true
    );

    pick result {
        Some(value) {
            give *value;
        }

        None {
            give false;
        }
