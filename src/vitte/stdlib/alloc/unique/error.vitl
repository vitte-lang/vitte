space vitte/stdlib/alloc/unique/error

export *

use src/vitte/stdlib/alloc/unique/core as unique_core
use src/vitte/stdlib/alloc/unique/alloc as unique_alloc
use src/vitte/stdlib/alloc/unique/drop as unique_drop

pick UniqueErrorKind {
    None,

    InvalidUnique,
    InvalidState,
    InvalidAllocation,
    InvalidDropState,

    AllocationFailed,
    ReallocationFailed,
    ResizeFailed,
    ReleaseFailed,

    ValueDropped,
    ValueMoved,
    AllocationReleased,
    AlreadyDropped,
    AlreadyReleased,
    AlreadyMoved,

    InvalidPointer,
    NullPointer,
    StaleReference,

    ReadDenied,
    WriteDenied,
    MoveDenied,
    ReplaceDenied,

    DropFailed,
    ForgetFailed,

    InvalidSize,
    InvalidAlignment,
    LayoutMismatch,

    RuntimeFailure,
    Internal
}

pick UniqueErrorSeverity {
    Note,
    Warning,
    Error,
    Fatal
}

pick UniqueErrorDomain {
    General,
    Unique,
    Allocation,
    Lifetime,
    Access,
    Move,
    Drop,
    Pointer,
    Layout,
    Runtime,
    Internal
}

pick UniqueErrorOperation {
    None,

    Create,
    Allocate,
    Reallocate,
    Resize,
    Release,

    Get,
    GetMut,
    Replace,

    Move,

    DropValue,
    DropAllocation,
    DropAll,
    Forget,

    Raw,
    Validate
}

form UniqueErrorContext {
    operation: UniqueErrorOperation

    core_state: unique_core.UniqueCoreState
    alloc_state: unique_alloc.UniqueAllocState
    drop_state: unique_drop.UniqueDropState

    size: usize
    align: usize

    generation: u64
    revision: u64
}

form UniqueError {
    kind: UniqueErrorKind
    severity: UniqueErrorSeverity
    domain: UniqueErrorDomain

    context: UniqueErrorContext

    message: string
}

form UniqueErrorProfile {
    kind: UniqueErrorKind
    severity: UniqueErrorSeverity
    domain: UniqueErrorDomain
    operation: UniqueErrorOperation

    none: bool
    warning: bool
    error: bool
    fatal: bool

    recoverable: bool
    lifetime: bool
    allocation: bool
    pointer: bool
    runtime: bool
    internal: bool
}

form UniqueErrorStatistics {
    total: u64

    notes: u64
    warnings: u64
    errors: u64
    fatals: u64

    unique_errors: u64
    allocation_errors: u64
    lifetime_errors: u64
    access_errors: u64
    move_errors: u64
    drop_errors: u64
    pointer_errors: u64
    layout_errors: u64
    runtime_errors: u64
    internal_errors: u64
}

// -----------------------------------------------------------------------------
// Context
// -----------------------------------------------------------------------------

proc unique_error_context_empty()
    -> UniqueErrorContext
{
    give UniqueErrorContext {
        operation:
            UniqueErrorOperation.None,

        core_state:
            unique_core.UniqueCoreState.Invalid,

        alloc_state:
            unique_alloc.UniqueAllocState.Invalid,

        drop_state:
            unique_drop.UniqueDropState.Invalid,

        size:
            0,

        align:
            0,

        generation:
            0,

        revision:
            0
    };
}

proc unique_error_context_alloc(
    allocation: ref unique_alloc.UniqueAlloc,
    operation: UniqueErrorOperation
) -> UniqueErrorContext {
    give UniqueErrorContext {
        operation:
            operation,

        core_state:
            unique_core.UniqueCoreState.Invalid,

        alloc_state:
            unique_alloc.unique_alloc_state(
                allocation
            ),

        drop_state:
            unique_drop.UniqueDropState.Invalid,

        size:
            unique_alloc.unique_alloc_size(
                allocation
            ),

        align:
            unique_alloc.unique_alloc_align(
                allocation
            ),

        generation:
            unique_alloc.unique_alloc_generation(
                allocation
            ),

        revision:
            unique_alloc.unique_alloc_revision(
                allocation
            )
    };
}

proc unique_error_context_drop(
    drop: ref unique_drop.UniqueDrop,
    operation: UniqueErrorOperation
) -> UniqueErrorContext {
    give UniqueErrorContext {
        operation:
            operation,

        core_state:
            unique_core.UniqueCoreState.Invalid,

        alloc_state:
            unique_alloc.UniqueAllocState.Invalid,

        drop_state:
            unique_drop.unique_drop_state(
                drop
            ),

        size:
            0,

        align:
            0,

        generation:
            unique_drop.unique_drop_generation(
                drop
            ),

        revision:
            unique_drop.unique_drop_revision(
                drop
            )
    };
}

proc unique_error_context_core(
    profile: unique_core.UniqueCoreProfile,
    operation: UniqueErrorOperation
) -> UniqueErrorContext {
    give UniqueErrorContext {
        operation:
            operation,

        core_state:
            profile.info.state,

        alloc_state:
            unique_alloc.UniqueAllocState.Invalid,

        drop_state:
            unique_drop.UniqueDropState.Invalid,

        size:
            0,

        align:
            0,

        generation:
            profile.meta.generation,

        revision:
            profile.meta.revision
    };
}

// -----------------------------------------------------------------------------
// Constructors
// -----------------------------------------------------------------------------

proc unique_error(
    kind: UniqueErrorKind,
    severity: UniqueErrorSeverity,
    domain: UniqueErrorDomain,
    context: UniqueErrorContext,
    message: string
) -> UniqueError {
    give UniqueError {
        kind:
            kind,

        severity:
            severity,

        domain:
            domain,

        context:
            context,

        message:
            message
    };
}

proc unique_error_none()
    -> UniqueError
{
    give unique_error(
        UniqueErrorKind.None,
        UniqueErrorSeverity.Note,
        UniqueErrorDomain.General,
        unique_error_context_empty(),
        ""
    );
}

proc unique_error_simple(
    kind: UniqueErrorKind,
    message: string
) -> UniqueError {
    give unique_error(
        kind,
        UniqueErrorSeverity.Error,
        unique_error_domain_for_kind(
            kind
        ),
        unique_error_context_empty(),
        message
    );
}

proc unique_error_warning(
    kind: UniqueErrorKind,
    message: string
) -> UniqueError {
    give unique_error(
        kind,
        UniqueErrorSeverity.Warning,
        unique_error_domain_for_kind(
            kind
        ),
        unique_error_context_empty(),
        message
    );
}

proc unique_error_fatal(
    kind: UniqueErrorKind,
    message: string
) -> UniqueError {
    give unique_error(
        kind,
        UniqueErrorSeverity.Fatal,
        unique_error_domain_for_kind(
            kind
        ),
        unique_error_context_empty(),
        message
    );
}

// -----------------------------------------------------------------------------
// Generic unique errors
// -----------------------------------------------------------------------------

proc unique_error_invalid_unique()
    -> UniqueError
{
    give unique_error(
        UniqueErrorKind.InvalidUnique,
        UniqueErrorSeverity.Fatal,
        UniqueErrorDomain.Unique,
        unique_error_context_empty(),
        "unique value is invalid"
    );
}

proc unique_error_invalid_state(
    profile: unique_core.UniqueCoreProfile
) -> UniqueError {
    give unique_error(
        UniqueErrorKind.InvalidState,
        UniqueErrorSeverity.Error,
        UniqueErrorDomain.Unique,
        unique_error_context_core(
            profile,
            UniqueErrorOperation.Validate
        ),
        "unique ownership state is invalid"
    );
}

// -----------------------------------------------------------------------------
// Allocation errors
// -----------------------------------------------------------------------------

proc unique_error_allocation_failed(
    size: usize,
    align: usize
) -> UniqueError {
    let context =
        unique_error_context_empty();

    set context.operation =
        UniqueErrorOperation.Allocate;

    set context.size =
        size;

    set context.align =
        align;

    give unique_error(
        UniqueErrorKind.AllocationFailed,
        UniqueErrorSeverity.Error,
        UniqueErrorDomain.Allocation,
        context,
        "unique allocation failed"
    );
}

proc unique_error_reallocation_failed(
    allocation: ref unique_alloc.UniqueAlloc
) -> UniqueError {
    give unique_error(
        UniqueErrorKind.ReallocationFailed,
        UniqueErrorSeverity.Error,
        UniqueErrorDomain.Allocation,
        unique_error_context_alloc(
            allocation,
            UniqueErrorOperation.Reallocate
        ),
        "unique reallocation failed"
    );
}

proc unique_error_resize_failed(
    allocation: ref unique_alloc.UniqueAlloc
) -> UniqueError {
    give unique_error(
        UniqueErrorKind.ResizeFailed,
        UniqueErrorSeverity.Error,
        UniqueErrorDomain.Allocation,
        unique_error_context_alloc(
            allocation,
            UniqueErrorOperation.Resize
        ),
        "unique allocation resize failed"
    );
}

proc unique_error_release_failed(
    allocation: ref unique_alloc.UniqueAlloc
) -> UniqueError {
    give unique_error(
        UniqueErrorKind.ReleaseFailed,
        UniqueErrorSeverity.Error,
        UniqueErrorDomain.Allocation,
        unique_error_context_alloc(
            allocation,
            UniqueErrorOperation.Release
        ),
        "unique allocation release failed"
    );
}

proc unique_error_invalid_allocation(
    allocation: ref unique_alloc.UniqueAlloc
) -> UniqueError {
    give unique_error(
        UniqueErrorKind.InvalidAllocation,
        UniqueErrorSeverity.Fatal,
        UniqueErrorDomain.Allocation,
        unique_error_context_alloc(
            allocation,
            UniqueErrorOperation.Validate
        ),
        "unique allocation is invalid"
    );
}

// -----------------------------------------------------------------------------
// Layout errors
// -----------------------------------------------------------------------------

proc unique_error_invalid_size(
    size: usize
) -> UniqueError {
    let context =
        unique_error_context_empty();

    set context.size =
        size;

    give unique_error(
        UniqueErrorKind.InvalidSize,
        UniqueErrorSeverity.Error,
        UniqueErrorDomain.Layout,
        context,
        "unique allocation size is invalid"
    );
}

proc unique_error_invalid_alignment(
    align: usize
) -> UniqueError {
    let context =
        unique_error_context_empty();

    set context.align =
        align;

    give unique_error(
        UniqueErrorKind.InvalidAlignment,
        UniqueErrorSeverity.Error,
        UniqueErrorDomain.Layout,
        context,
        "unique allocation alignment is invalid"
    );
}

proc unique_error_layout_mismatch(
    allocation: ref unique_alloc.UniqueAlloc
) -> UniqueError {
    give unique_error(
        UniqueErrorKind.LayoutMismatch,
        UniqueErrorSeverity.Error,
        UniqueErrorDomain.Layout,
        unique_error_context_alloc(
            allocation,
            UniqueErrorOperation.Get
        ),
        "unique allocation layout does not match requested type"
    );
}

