        message
    );
}

// -----------------------------------------------------------------------------
// Allocation checks
// -----------------------------------------------------------------------------

proc unique_error_for_allocate(
    size: usize,
    align: usize
) -> UniqueError {
    if size == 0 {
        give unique_error_invalid_size(
            size
        );
    }

    if not unique_alloc.unique_alloc_valid_align(
        align
    ) {
        give unique_error_invalid_alignment(
            align
        );
    }

    give unique_error_none();
}

proc unique_error_for_resize(
    allocation: ref unique_alloc.UniqueAlloc,
    new_size: usize
) -> UniqueError {
    if not unique_alloc.unique_alloc_is_allocated(
        allocation
    ) {
        give unique_error_invalid_allocation(
            allocation
        );
    }

    if new_size == 0 {
        give unique_error_invalid_size(
            new_size
        );
    }

    give unique_error_none();
}

proc unique_error_for_reallocate(
    allocation: ref unique_alloc.UniqueAlloc,
    new_size: usize,
    new_align: usize
) -> UniqueError {
    if not unique_alloc.unique_alloc_is_allocated(
        allocation
    ) {
        give unique_error_invalid_allocation(
            allocation
        );
    }

    if new_size == 0 {
        give unique_error_invalid_size(
            new_size
        );
    }

    if not unique_alloc.unique_alloc_valid_align(
        new_align
    ) {
        give unique_error_invalid_alignment(
            new_align
        );
    }

    give unique_error_none();
}

proc unique_error_for_release(
    allocation: ref unique_alloc.UniqueAlloc
) -> UniqueError {
    if unique_alloc.unique_alloc_is_released(
        allocation
    ) {
        give unique_error_allocation_released();
    }

    if not unique_alloc.unique_alloc_is_allocated(
        allocation
    ) {
        give unique_error_invalid_allocation(
            allocation
        );
    }

    give unique_error_none();
}

// -----------------------------------------------------------------------------
// Core access checks
// -----------------------------------------------------------------------------

proc unique_error_for_read(
    flags: unique_core.UniqueCoreFlags
) -> UniqueError {
    let state =
        unique_core.unique_core_state(
            flags
        );

    if state == unique_core.UniqueCoreState.Moved {
        give unique_error_value_moved();
    }

    if state == unique_core.UniqueCoreState.Dropped {
        give unique_error_value_dropped();
    }

    if state == unique_core.UniqueCoreState.Released {
        give unique_error_allocation_released();
    }

    if not unique_core.unique_core_can_read(
        flags
    ) {
        give unique_error_read_denied();
    }

    give unique_error_none();
}

proc unique_error_for_write(
    flags: unique_core.UniqueCoreFlags
) -> UniqueError {
    let state =
        unique_core.unique_core_state(
            flags
        );

    if state == unique_core.UniqueCoreState.Moved {
        give unique_error_value_moved();
    }

    if state == unique_core.UniqueCoreState.Dropped {
        give unique_error_value_dropped();
    }

    if state == unique_core.UniqueCoreState.Released {
        give unique_error_allocation_released();
    }

    if not unique_core.unique_core_can_write(
        flags
    ) {
        give unique_error_write_denied();
    }

    give unique_error_none();
}

proc unique_error_for_move(
    flags: unique_core.UniqueCoreFlags
) -> UniqueError {
    if unique_core.unique_core_is_moved(
        flags
    ) {
        give unique_error_already_moved();
    }

    if unique_core.unique_core_is_dropped(
        flags
    ) {
        give unique_error_value_dropped();
    }

    if unique_core.unique_core_is_released(
        flags
    ) {
        give unique_error_allocation_released();
    }

    if not unique_core.unique_core_can_move(
        flags
    ) {
        give unique_error_move_denied();
    }

    give unique_error_none();
}

proc unique_error_for_replace(
    flags: unique_core.UniqueCoreFlags
) -> UniqueError {
    let access =
        unique_error_for_write(
            flags
        );

    if not unique_error_is_none(
        access
    ) {
        give access;
    }

    if not unique_core.unique_core_can_replace(
        flags
    ) {
        give unique_error_replace_denied();
    }

    give unique_error_none();
}

// -----------------------------------------------------------------------------
// Drop checks
// -----------------------------------------------------------------------------

proc unique_error_for_drop_value(
    drop: ref unique_drop.UniqueDrop
) -> UniqueError {
    if drop.forgotten {
        give unique_error_forget_failed(
            drop
        );
    }

    if drop.value_dropped {
        give unique_error_already_dropped(
            drop
        );
    }

    if not unique_drop.unique_drop_can_drop_value(
        drop
    ) {
        give unique_error_drop_failed(
            drop
        );
    }

    give unique_error_none();
}

proc unique_error_for_drop_allocation(
    drop: ref unique_drop.UniqueDrop
) -> UniqueError {
    if drop.forgotten {
        give unique_error_forget_failed(
            drop
        );
    }

    if drop.allocation_released {
        give unique_error_already_released(
            drop
        );
    }

    if not drop.value_dropped {
        give unique_error_simple(
            UniqueErrorKind.DropFailed,
            "unique value must be dropped before allocation release"
        );
    }

    if not unique_drop.unique_drop_can_release_allocation(
        drop
    ) {
        give unique_error_drop_failed(
            drop
        );
    }

    give unique_error_none();
}

proc unique_error_for_forget(
    drop: ref unique_drop.UniqueDrop
) -> UniqueError {
    if drop.forgotten {
        give unique_error_forget_failed(
            drop
        );
    }

    if drop.value_dropped
        or drop.allocation_released
    {
        give unique_error_forget_failed(
            drop
        );
    }

    give unique_error_none();
}

// -----------------------------------------------------------------------------
// Allocation validation mapping
// -----------------------------------------------------------------------------

proc unique_error_from_alloc_validation(
    allocation: ref unique_alloc.UniqueAlloc,
    validation: unique_alloc.UniqueAllocValidation
) -> UniqueError {
    if validation.valid {
        give unique_error_none();
    }

    if not validation.state_valid {
        give unique_error_invalid_allocation(
            allocation
        );
    }

    if not validation.size_valid {
        give unique_error_invalid_size(
            allocation.size
        );
    }

    if not validation.align_valid {
        give unique_error_invalid_alignment(
            allocation.align
        );
    }

    if not validation.allocation_valid {
        give unique_error_invalid_allocation(
            allocation
        );
    }

    if not validation.generation_valid {
        give unique_error_internal(
            "unique allocation metadata is invalid"
        );
    }

    give unique_error_internal(
        "unknown unique allocation validation failure"
    );
}

proc unique_error_from_allocation(
    allocation: ref unique_alloc.UniqueAlloc
) -> UniqueError {
    give unique_error_from_alloc_validation(
        allocation,
        unique_alloc.unique_alloc_validate(
            allocation
        )
    );
}

// -----------------------------------------------------------------------------
// Drop validation mapping
// -----------------------------------------------------------------------------

proc unique_error_from_drop_validation(
    drop: ref unique_drop.UniqueDrop,
    validation: unique_drop.UniqueDropValidation
) -> UniqueError {
    if validation.valid {
        give unique_error_none();
    }

    if not validation.state_valid {
        give unique_error_invalid_drop_state(
            drop
        );
    }

    if not validation.value_valid {
        give unique_error_simple(
            UniqueErrorKind.DropFailed,
            "unique drop value lifecycle is invalid"
        );
    }

    if not validation.allocation_valid {
        give unique_error_simple(
            UniqueErrorKind.DropFailed,
            "unique drop allocation lifecycle is invalid"
        );
    }

    if not validation.generation_valid {
        give unique_error_internal(
            "unique drop metadata is invalid"
        );
    }

    give unique_error_internal(
        "unknown unique drop validation failure"
    );
}

proc unique_error_from_drop(
    drop: ref unique_drop.UniqueDrop
) -> UniqueError {
    give unique_error_from_drop_validation(
        drop,
        unique_drop.unique_drop_validate(
            drop
        )
    );
}

// -----------------------------------------------------------------------------
// Core validation mapping
// -----------------------------------------------------------------------------

proc unique_error_from_core_validation(
    profile: unique_core.UniqueCoreProfile,
    validation: unique_core.UniqueCoreValidation
) -> UniqueError {
    if validation.valid {
        give unique_error_none();
    }

    let context =
        unique_error_context_core(
            profile,
            UniqueErrorOperation.Validate
        );

    if not validation.flags_valid {
        give unique_error(
            UniqueErrorKind.InvalidUnique,
            UniqueErrorSeverity.Fatal,
            UniqueErrorDomain.Unique,
            context,
            "unique lifecycle flags are invalid"
        );
    }

    if not validation.state_valid {
        give unique_error(
            UniqueErrorKind.InvalidState,
            UniqueErrorSeverity.Error,
            UniqueErrorDomain.Unique,
            context,
            "unique state classification is invalid"
        );
    }

    if not validation.access_valid {
        give unique_error(
            UniqueErrorKind.ReadDenied,
            UniqueErrorSeverity.Error,
            UniqueErrorDomain.Access,
            context,
            "unique access classification is invalid"
        );
    }

    if not validation.ownership_valid {
        give unique_error(
            UniqueErrorKind.InvalidUnique,
            UniqueErrorSeverity.Error,
            UniqueErrorDomain.Unique,
            context,
            "unique ownership classification is invalid"
        );
    }

    if not validation.generation_valid {
        give unique_error(
            UniqueErrorKind.Internal,
            UniqueErrorSeverity.Fatal,
            UniqueErrorDomain.Internal,
            context,
            "unique generation metadata is invalid"
        );
    }

    give unique_error_internal(
        "unknown unique core validation failure"
    );
}

proc unique_error_from_core(
    profile: unique_core.UniqueCoreProfile
) -> UniqueError {
    give unique_error_from_core_validation(
        profile,
        unique_core.unique_core_validate(
            profile
        )
    );
}

// -----------------------------------------------------------------------------
// Predicates
// -----------------------------------------------------------------------------

proc unique_error_is_none(
    error: UniqueError
) -> bool {
    give error.kind
        == UniqueErrorKind.None;
}

proc unique_error_is_warning(
    error: UniqueError
) -> bool {
    give error.severity
        == UniqueErrorSeverity.Warning;
}

proc unique_error_is_error(
    error: UniqueError
) -> bool {
    give error.severity == UniqueErrorSeverity.Error
        or error.severity == UniqueErrorSeverity.Fatal;
}

proc unique_error_is_fatal(
    error: UniqueError
) -> bool {
    give error.severity
        == UniqueErrorSeverity.Fatal;
}

proc unique_error_is_recoverable(
    error: UniqueError
) -> bool {
    give error.severity == UniqueErrorSeverity.Note
        or error.severity == UniqueErrorSeverity.Warning
        or error.severity == UniqueErrorSeverity.Error;
}

proc unique_error_is_allocation(
    error: UniqueError
) -> bool {
    give error.domain
        == UniqueErrorDomain.Allocation;
}

proc unique_error_is_lifetime(
    error: UniqueError
) -> bool {
    give error.domain
        == UniqueErrorDomain.Lifetime;
}

proc unique_error_is_access(
    error: UniqueError
) -> bool {
    give error.domain
        == UniqueErrorDomain.Access;
}

proc unique_error_is_move(
    error: UniqueError
) -> bool {
    give error.domain
        == UniqueErrorDomain.Move;
}

proc unique_error_is_drop(
    error: UniqueError
) -> bool {
    give error.domain
        == UniqueErrorDomain.Drop;
}

proc unique_error_is_pointer(
    error: UniqueError
) -> bool {
    give error.domain
        == UniqueErrorDomain.Pointer;
}

proc unique_error_is_layout(
    error: UniqueError
) -> bool {
    give error.domain
        == UniqueErrorDomain.Layout;
}

proc unique_error_is_stale(
    error: UniqueError
) -> bool {
    give error.kind
        == UniqueErrorKind.StaleReference;
}

proc unique_error_is_moved(
    error: UniqueError
) -> bool {
    give error.kind == UniqueErrorKind.ValueMoved
        or error.kind == UniqueErrorKind.AlreadyMoved;
}

proc unique_error_is_dropped(
    error: UniqueError
) -> bool {
    give error.kind == UniqueErrorKind.ValueDropped
        or error.kind == UniqueErrorKind.AlreadyDropped;
}

proc unique_error_is_released(
    error: UniqueError
) -> bool {
    give error.kind == UniqueErrorKind.AllocationReleased
        or error.kind == UniqueErrorKind.AlreadyReleased;
}

// -----------------------------------------------------------------------------
// Profile
// -----------------------------------------------------------------------------

proc unique_error_profile(
    error: UniqueError
) -> UniqueErrorProfile {
    give UniqueErrorProfile {
        kind:
            error.kind,

        severity:
            error.severity,

        domain:
            error.domain,

        operation:
            error.context.operation,

        none:
            unique_error_is_none(
                error
            ),

        warning:
            unique_error_is_warning(
                error
            ),

        error:
            unique_error_is_error(
                error
            ),

        fatal:
            unique_error_is_fatal(
                error
            ),

        recoverable:
            unique_error_is_recoverable(
                error
            ),

        lifetime:
            error.domain
                == UniqueErrorDomain.Lifetime,

        allocation:
            error.domain
                == UniqueErrorDomain.Allocation,

        pointer:
            error.domain
                == UniqueErrorDomain.Pointer,

        runtime:
            error.domain
                == UniqueErrorDomain.Runtime,

        internal:
            error.domain
                == UniqueErrorDomain.Internal
    };
}

// -----------------------------------------------------------------------------
// Domain mapping
// -----------------------------------------------------------------------------

proc unique_error_domain_for_kind(
    kind: UniqueErrorKind
) -> UniqueErrorDomain {
    pick kind {
        UniqueErrorKind.None {
            give UniqueErrorDomain.General;
        }

        UniqueErrorKind.InvalidUnique
        | UniqueErrorKind.InvalidState {
            give UniqueErrorDomain.Unique;
        }

        UniqueErrorKind.InvalidAllocation
        | UniqueErrorKind.AllocationFailed
        | UniqueErrorKind.ReallocationFailed
        | UniqueErrorKind.ResizeFailed
        | UniqueErrorKind.ReleaseFailed {
            give UniqueErrorDomain.Allocation;
        }

        UniqueErrorKind.ValueDropped
        | UniqueErrorKind.AllocationReleased
        | UniqueErrorKind.AlreadyDropped
        | UniqueErrorKind.AlreadyReleased {
            give UniqueErrorDomain.Lifetime;
        }

        UniqueErrorKind.ValueMoved
        | UniqueErrorKind.AlreadyMoved
        | UniqueErrorKind.MoveDenied {
            give UniqueErrorDomain.Move;
        }

        UniqueErrorKind.ReadDenied
        | UniqueErrorKind.WriteDenied
        | UniqueErrorKind.ReplaceDenied {
            give UniqueErrorDomain.Access;
        }

        UniqueErrorKind.DropFailed
        | UniqueErrorKind.InvalidDropState
        | UniqueErrorKind.ForgetFailed {
            give UniqueErrorDomain.Drop;
        }

        UniqueErrorKind.InvalidPointer
        | UniqueErrorKind.NullPointer
        | UniqueErrorKind.StaleReference {
            give UniqueErrorDomain.Pointer;
        }

        UniqueErrorKind.InvalidSize
        | UniqueErrorKind.InvalidAlignment
        | UniqueErrorKind.LayoutMismatch {
            give UniqueErrorDomain.Layout;
        }

        UniqueErrorKind.RuntimeFailure {
            give UniqueErrorDomain.Runtime;
        }

        UniqueErrorKind.Internal {
            give UniqueErrorDomain.Internal;
        }
    }

    give UniqueErrorDomain.Internal;
}

// -----------------------------------------------------------------------------
// Statistics
// -----------------------------------------------------------------------------

proc unique_error_statistics_empty()
    -> UniqueErrorStatistics
{
    give UniqueErrorStatistics {
        total: 0,

        notes: 0,
        warnings: 0,
        errors: 0,
        fatals: 0,

        unique_errors: 0,
        allocation_errors: 0,
        lifetime_errors: 0,
        access_errors: 0,
        move_errors: 0,
        drop_errors: 0,
        pointer_errors: 0,
        layout_errors: 0,
        runtime_errors: 0,
        internal_errors: 0
    };
}

proc unique_error_statistics_record(
    statistics: ref mut UniqueErrorStatistics,
    error: UniqueError
) {
    if unique_error_is_none(
        error
    ) {
        give;
    }

    set statistics.total =
        statistics.total + 1;

    pick error.severity {
        UniqueErrorSeverity.Note {
            set statistics.notes =
                statistics.notes + 1;
        }

        UniqueErrorSeverity.Warning {
            set statistics.warnings =
                statistics.warnings + 1;
        }

        UniqueErrorSeverity.Error {
            set statistics.errors =
                statistics.errors + 1;
        }

        UniqueErrorSeverity.Fatal {
            set statistics.fatals =
                statistics.fatals + 1;
        }
    }

    pick error.domain {
        UniqueErrorDomain.General {}

        UniqueErrorDomain.Unique {
            set statistics.unique_errors =
                statistics.unique_errors + 1;
        }

        UniqueErrorDomain.Allocation {
            set statistics.allocation_errors =
                statistics.allocation_errors + 1;
        }

        UniqueErrorDomain.Lifetime {
            set statistics.lifetime_errors =
                statistics.lifetime_errors + 1;
        }

        UniqueErrorDomain.Access {
            set statistics.access_errors =
                statistics.access_errors + 1;
        }

        UniqueErrorDomain.Move {
            set statistics.move_errors =
                statistics.move_errors + 1;
        }

        UniqueErrorDomain.Drop {
            set statistics.drop_errors =
                statistics.drop_errors + 1;
        }

        UniqueErrorDomain.Pointer {
            set statistics.pointer_errors =
                statistics.pointer_errors + 1;
        }

        UniqueErrorDomain.Layout {
            set statistics.layout_errors =
                statistics.layout_errors + 1;
        }

        UniqueErrorDomain.Runtime {
            set statistics.runtime_errors =
                statistics.runtime_errors + 1;
        }

        UniqueErrorDomain.Internal {
            set statistics.internal_errors =
                statistics.internal_errors + 1;
        }
    }
}

proc unique_error_statistics_total(
    statistics: UniqueErrorStatistics
) -> u64 {
    give statistics.total;
}

proc unique_error_statistics_reset(
    statistics: ref mut UniqueErrorStatistics
) {
    set *statistics =
        unique_error_statistics_empty();
}

