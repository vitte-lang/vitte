// -----------------------------------------------------------------------------
// Mutable access
// -----------------------------------------------------------------------------

proc unique_get_mut<T>(
    value: ref mut Unique<T>
) -> ref mut T {
    let result =
        unique_owner.unique_owner_get_mut(
            ref mut value.owner
        );

    pick result {
        Some(inner) {
            give inner;
        }

        None {
            give compiler_unique_mutable_access_failure<T>();
        }
    }
}

proc unique_try_get_mut<T>(
    value: ref mut Unique<T>
) -> Option<ref mut T> {
    give unique_owner.unique_owner_get_mut(
        ref mut value.owner
    );
}

// -----------------------------------------------------------------------------
// Replace
// -----------------------------------------------------------------------------

proc unique_replace<T>(
    value: ref mut Unique<T>,
    next: T
) -> bool {
    give unique_owner.unique_owner_replace(
        ref mut value.owner,
        next
    );
}

