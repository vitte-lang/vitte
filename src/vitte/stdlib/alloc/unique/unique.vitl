}

proc unique_try_take<T>(
    value: ref mut Unique<T>
) -> Option<T> {
    give unique_owner.unique_owner_move(
        ref mut value.owner
    );
}

proc unique_move<T>(
    value: ref mut Unique<T>
) -> Option<T> {
    give unique_try_take(
