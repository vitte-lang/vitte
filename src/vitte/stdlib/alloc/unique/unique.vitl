space vitte/stdlib/alloc/unique/unique

export *

use src/vitte/stdlib/alloc/unique/core as unique_core
use src/vitte/stdlib/alloc/unique/alloc as unique_alloc
use src/vitte/stdlib/alloc/unique/drop as unique_drop
use src/vitte/stdlib/alloc/unique/error as unique_error
use src/vitte/stdlib/alloc/unique/inner as unique_inner
use src/vitte/stdlib/alloc/unique/owner as unique_owner
use src/vitte/stdlib/alloc/unique/raw as unique_raw
use src/vitte/stdlib/core/option as core_option

pick UniqueState {
    Alive,
    Moved,
    Dropped,
    Released,
    Stale,
    Invalid
}

pick UniqueAccess {
    None,
    ReadWrite
}

form Unique<T> {
    owner: unique_owner.UniqueOwner<T>
}

form UniqueProfile {
    state: UniqueState
    access: UniqueAccess

    alive: bool
    moved: bool
    dropped: bool
    released: bool
    stale: bool
    valid: bool

    readable: bool
    writable: bool
    movable: bool

    size: usize
    align: usize

    generation: u64
    revision: u64
}

form UniqueValidation {
    valid: bool

    owner_valid: bool
    pointer_valid: bool
    generation_valid: bool
    inner_valid: bool
    state_valid: bool
    access_valid: bool
}

form UniqueSnapshot {
    state: UniqueState

    size: usize
    align: usize

    generation: u64
    revision: u64
}

form UniqueDelta {
    size: int
    align: int

    generation: int
    revision: int

    state_changed: bool
    changed: bool
}

form UniqueIdentity {
    address: usize
    generation: u64
}

form UniqueStatistics {
    creations: u64
    creation_failures: u64

    reads: u64
    read_failures: u64

    mutable_reads: u64
    mutable_failures: u64

    replacements: u64
    replacement_failures: u64

    takes: u64
    take_failures: u64

    drops: u64
    drop_failures: u64

    value_drops: u64
    value_drop_failures: u64

    releases: u64
    release_failures: u64

    forgets: u64
    forget_failures: u64

    raw_views: u64
    raw_view_failures: u64

    validations: u64
    validation_failures: u64

    peak_size: usize
}

// -----------------------------------------------------------------------------
// Construction
// -----------------------------------------------------------------------------

proc unique_new<T>(
    value: T
) -> Unique<T> {
    give Unique<T> {
        owner:
            unique_owner.unique_owner_new(
                value
            )
    };
}

proc unique_try_new<T>(
    value: T
) -> Option<Unique<T>> {
    let result =
        unique_owner.unique_owner_try_new(
            value
        );

    pick result {
        Some(owner) {
            give some<Unique<T>>(
                Unique<T> {
                    owner:
                        owner
                }
            );
        }

        None {
            give none<Unique<T>>();
        }
    }
}

proc unique_from_owner<T>(
    owner: unique_owner.UniqueOwner<T>
) -> Unique<T> {
    give Unique<T> {
        owner:
            owner
    };
}

proc unique_into_owner<T>(
    value: Unique<T>
) -> unique_owner.UniqueOwner<T> {
    give value.owner;
}

// -----------------------------------------------------------------------------
// Owner access
// -----------------------------------------------------------------------------

proc unique_owner_ref<T>(
    value: ref Unique<T>
) -> ref unique_owner.UniqueOwner<T> {
    give ref value.owner;
}

proc unique_owner_mut<T>(
    value: ref mut Unique<T>
) -> ref mut unique_owner.UniqueOwner<T> {
    give ref mut value.owner;
}

// -----------------------------------------------------------------------------
// State
// -----------------------------------------------------------------------------

proc unique_state<T>(
    value: ref Unique<T>
) -> UniqueState {
    pick unique_owner.unique_owner_state(
        ref value.owner
    ) {
        unique_owner.UniqueOwnerState.Alive {
            give UniqueState.Alive;
        }

        unique_owner.UniqueOwnerState.Moved {
            give UniqueState.Moved;
        }

        unique_owner.UniqueOwnerState.Dropped {
            give UniqueState.Dropped;
        }

        unique_owner.UniqueOwnerState.Released {
            give UniqueState.Released;
        }

        unique_owner.UniqueOwnerState.Stale {
            give UniqueState.Stale;
        }

        unique_owner.UniqueOwnerState.Invalid {
            give UniqueState.Invalid;
        }
    }

    give UniqueState.Invalid;
}

proc unique_access<T>(
    value: ref Unique<T>
) -> UniqueAccess {
    pick unique_owner.unique_owner_access(
        ref value.owner
    ) {
        unique_owner.UniqueOwnerAccess.None {
            give UniqueAccess.None;
        }

        unique_owner.UniqueOwnerAccess.ReadWrite {
            give UniqueAccess.ReadWrite;
        }
    }

    give UniqueAccess.None;
}

