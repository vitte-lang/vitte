// -----------------------------------------------------------------------------
// Raw conversion
// -----------------------------------------------------------------------------

proc unique_from_raw<T>(
    raw: unique_raw.UniqueRaw<T>
) -> Option<Unique<T>> {
    let result =
        unique_raw.unique_raw_into_owner(
            raw
        );

    pick result {
        Some(owner) {
            give some<Unique<T>>(
                Unique<T> {
                    owner:
                        owner
                }
            );
        }

        None {
            give none<Unique<T>>();
        }
    }
}

