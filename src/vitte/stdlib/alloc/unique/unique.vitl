// Allocation access
// -----------------------------------------------------------------------------

proc unique_allocation<T>(
    value: ref Unique<T>
) -> Option<ref unique_alloc.UniqueAlloc> {
    give unique_owner.unique_owner_allocation(
        ref value.owner
    );
}

proc unique_allocation_mut<T>(
    value: ref mut Unique<T>
) -> Option<ref mut unique_alloc.UniqueAlloc> {
    give unique_owner.unique_owner_allocation_mut(
