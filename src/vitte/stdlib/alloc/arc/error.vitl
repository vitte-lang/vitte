// -----------------------------------------------------------------------------
// Validation
// -----------------------------------------------------------------------------

proc arc_error_validate_counts(
    strong: usize,
    weak: usize
) -> ArcError {
    let counts =
        arc_core.arc_core_counts(
            strong,
            weak
        );

    let validation =
        arc_core.arc_core_validate(
            counts,
            arc_core.arc_core_limits_default()
        );

    if not validation.strong_valid {
        give arc_error_invalid_strong_count(
            strong,
            weak
        );
    }

    if not validation.weak_valid {
        give arc_error_invalid_weak_count(
            strong,
            weak
        );
    }

    if not validation.invariant_valid {
        give arc_error_invalid_invariant(
            strong,
            weak
        );
    }

    give arc_error_none();
}

proc arc_error_from_core_validation(
    counts: arc_core.ArcCoreCounts,
    validation: arc_core.ArcCoreValidation
) -> ArcError {
    if validation.valid {
        give arc_error_none();
    }

    if not validation.strong_valid {
        give arc_error_invalid_strong_count(
            counts.strong,
            counts.weak
        );
    }

    if not validation.weak_valid {
        give arc_error_invalid_weak_count(
            counts.strong,
            counts.weak
        );
    }

    if not validation.state_valid {
        give arc_error_invalid_state(
            counts.strong,
            counts.weak
        );
    }

    if not validation.invariant_valid {
        give arc_error_invalid_invariant(
            counts.strong,
            counts.weak
        );
    }

    give arc_error_fatal(
        ArcErrorKind.Internal,
        "unknown Arc validation failure"
    );
}

// -----------------------------------------------------------------------------
// Predicates
// -----------------------------------------------------------------------------

proc arc_error_is_none(
    error: ArcError
) -> bool {
    give error.kind
        == ArcErrorKind.None;
}

proc arc_error_is_error(
    error: ArcError
) -> bool {
    give error.severity
        == ArcErrorSeverity.Error
        or error.severity
        == ArcErrorSeverity.Fatal;
}

proc arc_error_is_fatal(
    error: ArcError
) -> bool {
    give error.severity
        == ArcErrorSeverity.Fatal;
}

proc arc_error_is_warning(
    error: ArcError
) -> bool {
    give error.severity
        == ArcErrorSeverity.Warning;
}

proc arc_error_is_allocation(
    error: ArcError
) -> bool {
    give error.domain
        == ArcErrorDomain.Allocation;
}

proc arc_error_is_count(
    error: ArcError
) -> bool {
    give error.domain
        == ArcErrorDomain.ReferenceCount;
}

proc arc_error_is_ownership(
    error: ArcError
) -> bool {
    give error.domain
        == ArcErrorDomain.Ownership;
}

proc arc_error_is_weak(
    error: ArcError
) -> bool {
    give error.domain
        == ArcErrorDomain.Weak;
}

proc arc_error_is_raw(
    error: ArcError
) -> bool {
    give error.domain
        == ArcErrorDomain.Raw;
}

proc arc_error_is_internal(
    error: ArcError
) -> bool {
    give error.domain
        == ArcErrorDomain.Internal;
}

// -----------------------------------------------------------------------------
// Domain mapping
// -----------------------------------------------------------------------------

proc arc_error_domain_for_kind(
    kind: ArcErrorKind
) -> ArcErrorDomain {
    pick kind {
        ArcErrorKind.AllocationFailed
        | ArcErrorKind.InvalidAllocation
        | ArcErrorKind.InvalidPointer {
            give ArcErrorDomain.Allocation;
        }

        ArcErrorKind.InvalidStrongCount
        | ArcErrorKind.InvalidWeakCount
        | ArcErrorKind.CountOverflow
        | ArcErrorKind.CountUnderflow
        | ArcErrorKind.CountSaturated {
            give ArcErrorDomain.ReferenceCount;
        }

        ArcErrorKind.NotUnique
        | ArcErrorKind.SharedOwnership
        | ArcErrorKind.WeakReferencesPresent
        | ArcErrorKind.CannotUnwrap {
            give ArcErrorDomain.Ownership;
        }

        ArcErrorKind.CannotGetMut
        | ArcErrorKind.CannotMakeMut {
            give ArcErrorDomain.Mutation;
        }

        ArcErrorKind.WeakExpired
        | ArcErrorKind.WeakUpgradeFailed
        | ArcErrorKind.WeakDowngradeFailed {
            give ArcErrorDomain.Weak;
        }

        ArcErrorKind.RawPointerInvalid
        | ArcErrorKind.RawPointerNull
        | ArcErrorKind.RawPointerConsumed
        | ArcErrorKind.RawOwnershipMismatch {
            give ArcErrorDomain.Raw;
        }

        ArcErrorKind.RuntimeFailure {
            give ArcErrorDomain.Runtime;
        }

        ArcErrorKind.InvalidState
        | ArcErrorKind.InvalidTransition
        | ArcErrorKind.InvalidInvariant
        | ArcErrorKind.TypeMismatch
        | ArcErrorKind.Internal {
            give ArcErrorDomain.Internal;
        }

        ArcErrorKind.None {
            give ArcErrorDomain.General;
        }
    }

    give ArcErrorDomain.Internal;
}

// -----------------------------------------------------------------------------
// Statistics
// -----------------------------------------------------------------------------

proc arc_error_statistics_empty()
    -> ArcErrorStatistics
{
    give ArcErrorStatistics {
        total: 0,

        notes: 0,
        warnings: 0,
        errors: 0,
        fatals: 0,

        allocation: 0,
        counts: 0,
        ownership: 0,
        mutation: 0,
        weak: 0,
        raw: 0,
        runtime: 0,
        internal: 0
    };
}

proc arc_error_statistics_record(
    statistics: ref mut ArcErrorStatistics,
    error: ArcError
) {
    if arc_error_is_none(
        error
    ) {
        give;
    }

    set statistics.total =
        statistics.total + 1;

    pick error.severity {
        ArcErrorSeverity.Note {
            set statistics.notes =
                statistics.notes + 1;
        }

        ArcErrorSeverity.Warning {
            set statistics.warnings =
                statistics.warnings + 1;
        }

        ArcErrorSeverity.Error {
            set statistics.errors =
                statistics.errors + 1;
        }

        ArcErrorSeverity.Fatal {
            set statistics.fatals =
                statistics.fatals + 1;
        }
    }

    pick error.domain {
        ArcErrorDomain.Allocation {
            set statistics.allocation =
                statistics.allocation + 1;
        }

        ArcErrorDomain.ReferenceCount {
            set statistics.counts =
                statistics.counts + 1;
        }

        ArcErrorDomain.Ownership {
            set statistics.ownership =
                statistics.ownership + 1;
        }

        ArcErrorDomain.Mutation {
            set statistics.mutation =
                statistics.mutation + 1;
        }

        ArcErrorDomain.Weak {
            set statistics.weak =
                statistics.weak + 1;
        }

        ArcErrorDomain.Raw {
            set statistics.raw =
                statistics.raw + 1;
        }

        ArcErrorDomain.Runtime {
            set statistics.runtime =
                statistics.runtime + 1;
        }

        ArcErrorDomain.Internal {
            set statistics.internal =
                statistics.internal + 1;
        }

        ArcErrorDomain.General {}
    }
}

proc arc_error_statistics_reset(
    statistics: ref mut ArcErrorStatistics
) {
    set *statistics =
        arc_error_statistics_empty();
}

// -----------------------------------------------------------------------------
// Names
// -----------------------------------------------------------------------------

proc arc_error_kind_name(
    kind: ArcErrorKind
) -> string {
    pick kind {
        ArcErrorKind.None {
            give "none";
        }

        ArcErrorKind.AllocationFailed {
            give "allocation-failed";
        }

        ArcErrorKind.InvalidAllocation {
            give "invalid-allocation";
        }

        ArcErrorKind.InvalidPointer {
            give "invalid-pointer";
        }

        ArcErrorKind.InvalidStrongCount {
            give "invalid-strong-count";
        }

        ArcErrorKind.InvalidWeakCount {
            give "invalid-weak-count";
        }

        ArcErrorKind.CountOverflow {
            give "count-overflow";
        }

        ArcErrorKind.CountUnderflow {
            give "count-underflow";
        }

        ArcErrorKind.CountSaturated {
            give "count-saturated";
        }

        ArcErrorKind.InvalidState {
            give "invalid-state";
        }

        ArcErrorKind.InvalidTransition {
            give "invalid-transition";
        }

        ArcErrorKind.InvalidInvariant {
            give "invalid-invariant";
        }

        ArcErrorKind.NotUnique {
            give "not-unique";
        }

        ArcErrorKind.SharedOwnership {
            give "shared-ownership";
        }

        ArcErrorKind.WeakReferencesPresent {
            give "weak-references-present";
        }

        ArcErrorKind.CannotGetMut {
            give "cannot-get-mut";
        }

        ArcErrorKind.CannotMakeMut {
            give "cannot-make-mut";
        }

        ArcErrorKind.CannotUnwrap {
            give "cannot-unwrap";
        }

        ArcErrorKind.WeakExpired {
            give "weak-expired";
        }

        ArcErrorKind.WeakUpgradeFailed {
            give "weak-upgrade-failed";
        }

        ArcErrorKind.WeakDowngradeFailed {
            give "weak-downgrade-failed";
        }

        ArcErrorKind.RawPointerInvalid {
            give "raw-pointer-invalid";
        }

        ArcErrorKind.RawPointerNull {
            give "raw-pointer-null";
        }

        ArcErrorKind.RawPointerConsumed {
            give "raw-pointer-consumed";
        }

        ArcErrorKind.RawOwnershipMismatch {
            give "raw-ownership-mismatch";
        }

        ArcErrorKind.TypeMismatch {
            give "type-mismatch";
        }

        ArcErrorKind.RuntimeFailure {
            give "runtime-failure";
        }

        ArcErrorKind.Internal {
            give "internal";
        }
    }

    give "internal";
}

