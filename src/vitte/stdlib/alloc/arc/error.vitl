        ArcErrorOperation.Downgrade {
            give "downgrade";
        }

        ArcErrorOperation.Upgrade {
            give "upgrade";
        }

        ArcErrorOperation.IntoRaw {
            give "into-raw";
        }

        ArcErrorOperation.FromRaw {
            give "from-raw";
        }

        ArcErrorOperation.Validate {
            give "validate";
        }
    }

    give "none";
}

// -----------------------------------------------------------------------------
// Error model
// -----------------------------------------------------------------------------
//
// arc/error.vitl
//
//     allocation errors
//          |
//          +-- allocation failed
//          +-- invalid allocation
//          +-- invalid pointer
//
//     reference-count errors
//          |
//          +-- overflow
//          +-- underflow
//          +-- saturation
//          +-- invalid strong/weak counts
//
//     ownership errors
//          |
//          +-- not unique
//          +-- shared ownership
//          +-- cannot unwrap
//
//     mutation errors
//          |
//          +-- cannot get_mut
//          +-- cannot make_mut
//
//     weak-reference errors
//          |
//          +-- expired
//          +-- upgrade failure
//          +-- downgrade failure
//
//     raw-pointer errors
//          |
//          +-- invalid
//          +-- null
//          +-- consumed
//          +-- ownership mismatch
//
//     internal errors
//          |
//          +-- invalid state
//          +-- invalid transition
//          +-- invariant failure
//
// Public high-level APIs may convert these structured errors into Result<T, E>.
//
// Diagnostic rendering and localization should stay outside this file.
