space vitte/stdlib/alloc/arc/error

export *

use src/vitte/stdlib/alloc/arc/core as arc_core

// -----------------------------------------------------------------------------
// Error kinds
// -----------------------------------------------------------------------------

pick ArcErrorKind {
    None,

    AllocationFailed,
    InvalidAllocation,
    InvalidPointer,

    InvalidStrongCount,
    InvalidWeakCount,
    CountOverflow,
    CountUnderflow,
    CountSaturated,

    InvalidState,
    InvalidTransition,
    InvalidInvariant,

    NotUnique,
    SharedOwnership,
    WeakReferencesPresent,

    CannotGetMut,
    CannotMakeMut,
    CannotUnwrap,

    WeakExpired,
    WeakUpgradeFailed,
    WeakDowngradeFailed,

    RawPointerInvalid,
    RawPointerNull,
    RawPointerConsumed,
    RawOwnershipMismatch,

    TypeMismatch,

    RuntimeFailure,
    Internal
}

pick ArcErrorSeverity {
    Note,
    Warning,
    Error,
    Fatal
}

pick ArcErrorDomain {
    General,
    Allocation,
    ReferenceCount,
    Ownership,
    Mutation,
    Weak,
    Raw,
    Runtime,
    Internal
}

pick ArcErrorOperation {
    None,

    New,
    TryNew,

    Clone,
    Drop,

    Get,
    GetMut,
    MakeMut,

    TryUnwrap,

    StrongCount,
    WeakCount,

    Downgrade,
    Upgrade,

    IntoRaw,
    FromRaw,

    Validate
}

// -----------------------------------------------------------------------------
// Error context
// -----------------------------------------------------------------------------

form ArcErrorContext {
    operation: ArcErrorOperation

    strong: usize
    weak: usize

    expected_strong: Option<usize>
    expected_weak: Option<usize>

    has_pointer: bool
}

form ArcError {
    kind: ArcErrorKind
    severity: ArcErrorSeverity
    domain: ArcErrorDomain

    context: ArcErrorContext

    message: string
}

form ArcErrorResult {
    error: ArcError

    valid: bool
}

form ArcErrorStatistics {
    total: u64

    notes: u64
    warnings: u64
    errors: u64
    fatals: u64

    allocation: u64
    counts: u64
    ownership: u64
    mutation: u64
    weak: u64
    raw: u64
    runtime: u64
    internal: u64
}

// -----------------------------------------------------------------------------
// Context
// -----------------------------------------------------------------------------

proc arc_error_context_empty()
    -> ArcErrorContext
{
    give ArcErrorContext {
        operation:
            ArcErrorOperation.None,

        strong:
            0,

        weak:
            0,

        expected_strong:
            None,

        expected_weak:
            None,

        has_pointer:
            false
    };
}

proc arc_error_context(
    operation: ArcErrorOperation,
    strong: usize,
    weak: usize
) -> ArcErrorContext {
    give ArcErrorContext {
        operation:
            operation,

        strong:
            strong,

        weak:
            weak,

        expected_strong:
            None,

        expected_weak:
            None,

        has_pointer:
            true
    };
}

proc arc_error_context_with_expected_strong(
    context: ArcErrorContext,
    value: usize
) -> ArcErrorContext {
    let out =
        context;

    set out.expected_strong =
        Some(value);

    give out;
}

proc arc_error_context_with_expected_weak(
    context: ArcErrorContext,
    value: usize
) -> ArcErrorContext {
    let out =
        context;

    set out.expected_weak =
        Some(value);

    give out;
}

proc arc_error_context_without_pointer(
    context: ArcErrorContext
) -> ArcErrorContext {
    let out =
        context;

    set out.has_pointer =
        false;

    give out;
}

// -----------------------------------------------------------------------------
// Error constructors
// -----------------------------------------------------------------------------

proc arc_error(
    kind: ArcErrorKind,
    severity: ArcErrorSeverity,
    domain: ArcErrorDomain,
    context: ArcErrorContext,
    message: string
) -> ArcError {
    give ArcError {
        kind:
            kind,

        severity:
            severity,

        domain:
            domain,

        context:
            context,

        message:
            message
    };
}

proc arc_error_none()
    -> ArcError
{
    give arc_error(
        ArcErrorKind.None,
        ArcErrorSeverity.Note,
        ArcErrorDomain.General,
        arc_error_context_empty(),
        ""
    );
}

proc arc_error_simple(
    kind: ArcErrorKind,
    message: string
) -> ArcError {
    give arc_error(
        kind,
        ArcErrorSeverity.Error,
        arc_error_domain_for_kind(
            kind
        ),
        arc_error_context_empty(),
        message
    );
}

proc arc_error_fatal(
    kind: ArcErrorKind,
    message: string
) -> ArcError {
    give arc_error(
        kind,
        ArcErrorSeverity.Fatal,
        arc_error_domain_for_kind(
            kind
        ),
        arc_error_context_empty(),
        message
    );
}

// -----------------------------------------------------------------------------
// Allocation errors
// -----------------------------------------------------------------------------

proc arc_error_allocation_failed()
    -> ArcError
{
    give arc_error(
        ArcErrorKind.AllocationFailed,
        ArcErrorSeverity.Error,
        ArcErrorDomain.Allocation,
        arc_error_context(
            ArcErrorOperation.New,
            0,
            0
        ),
        "arc allocation failed"
    );
}

proc arc_error_invalid_allocation()
    -> ArcError
{
    give arc_error(
        ArcErrorKind.InvalidAllocation,
        ArcErrorSeverity.Fatal,
        ArcErrorDomain.Allocation,
        arc_error_context_empty(),
        "arc allocation is invalid"
    );
}

proc arc_error_invalid_pointer()
    -> ArcError
{
    give arc_error(
        ArcErrorKind.InvalidPointer,
        ArcErrorSeverity.Fatal,
        ArcErrorDomain.Allocation,
        arc_error_context_empty(),
        "arc pointer is invalid"
    );
}

