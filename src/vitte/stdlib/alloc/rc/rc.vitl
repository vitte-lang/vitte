space vitte/stdlib/alloc/rc/rc

export *

use src/vitte/stdlib/alloc/rc/core as rc_core
use src/vitte/stdlib/alloc/rc/count as rc_count
use src/vitte/stdlib/alloc/rc/error as rc_error
use src/vitte/stdlib/alloc/rc/inner as rc_inner
use src/vitte/stdlib/alloc/rc/raw as rc_raw
use src/vitte/stdlib/alloc/allocator as alloc_allocator
use src/vitte/stdlib/core/option as core_option

pick RcState {
    Alive,
    WeakOnly,
    Released,
    Invalid
}

form Rc<T> {
    inner: raw ref rc_inner.RcInner<T>

    generation: u64
    revision: u64
}

form RcWeak<T> {
    inner: raw ref rc_inner.RcInner<T>

    generation: u64
    revision: u64
}

form RcProfile {
    strong: usize
    weak: usize

    state: RcState

    unique: bool
    shared: bool

    alive: bool
    weak_only: bool
    released: bool
    valid: bool

    generation: u64
    revision: u64
}

form RcWeakProfile {
    strong: usize
    weak: usize

    state: RcState

    expired: bool
    upgradeable: bool

    alive: bool
    released: bool
    stale: bool
    valid: bool

    generation: u64
    revision: u64
}

form RcValidation {
    valid: bool

    pointer_valid: bool
    generation_valid: bool
    inner_valid: bool
    strong_valid: bool
    state_valid: bool
}

form RcWeakValidation {
    valid: bool

    pointer_valid: bool
    generation_valid: bool
    inner_valid: bool
    weak_valid: bool
    state_valid: bool
}

form RcSnapshot {
    strong: usize
    weak: usize

    state: RcState

    generation: u64
    revision: u64
}

form RcDelta {
    strong: int
    weak: int

    generation: int
    revision: int

    state_changed: bool
    changed: bool
}

form RcStatistics {
    created: u64

    strong_clones: u64
    strong_drops: u64

    weak_creations: u64
    weak_clones: u64
    weak_drops: u64

    upgrades: u64
    upgrade_failures: u64

    reads: u64
    writes: u64

    replacements: u64

    raw_conversions: u64

    failures: u64

    peak_strong: usize
    peak_weak: usize
}

// -----------------------------------------------------------------------------
// Construction
// -----------------------------------------------------------------------------

proc rc_new<T>(
    value: T
) -> Rc<T> {
    let layout =
        alloc_allocator.layout(
            compiler_size_of<rc_inner.RcInner<T>>(),
            compiler_align_of<rc_inner.RcInner<T>>()
        );

    let mut allocator =
        alloc_allocator.allocator(
            "rc",
            alloc_allocator.GrowthPolicy.Exact
        );

    let allocation =
        alloc_allocator.allocator_allocate(
            ref mut allocator,
            layout
        );

    if is_none(allocation) {
        give compiler_rc_allocation_failure<T>();
    }

    let storage =
        unwrap(allocation);

    let ptr =
        compiler_allocation_as_mut<rc_inner.RcInner<T>>(
            storage
        );

    let inner =
        rc_inner.rc_inner_new(
            value,
            storage
        );

    set *ptr =
        inner;

    give Rc<T> {
        inner:
            compiler_mut_ref_as_raw(
                ptr
            ),

        generation:
            ptr.generation,

        revision:
            ptr.revision
    };
}

proc rc_try_new<T>(
    value: T
) -> Option<Rc<T>> {
    let layout =
        alloc_allocator.layout(
            compiler_size_of<rc_inner.RcInner<T>>(),
            compiler_align_of<rc_inner.RcInner<T>>()
        );

    let mut allocator =
        alloc_allocator.allocator(
            "rc",
            alloc_allocator.GrowthPolicy.Exact
        );

    let allocation =
        alloc_allocator.allocator_allocate(
            ref mut allocator,
            layout
        );

    if is_none(allocation) {
        give none<Rc<T>>();
    }

    let storage =
        unwrap(allocation);

    let ptr =
        compiler_allocation_as_mut<rc_inner.RcInner<T>>(
            storage
        );

    set *ptr =
        rc_inner.rc_inner_new(
            value,
            storage
        );

    give some<Rc<T>>(
        Rc<T> {
            inner:
                compiler_mut_ref_as_raw(
                    ptr
                ),

            generation:
                ptr.generation,

            revision:
                ptr.revision
        }
    );
}

// -----------------------------------------------------------------------------
// Inner access
// -----------------------------------------------------------------------------

proc rc_inner_ref<T>(
    value: ref Rc<T>
) -> Option<ref rc_inner.RcInner<T>> {
    if compiler_raw_ptr_is_null(
        value.inner
    ) {
        give none<ref rc_inner.RcInner<T>>();
    }

    give some<ref rc_inner.RcInner<T>>(
        compiler_raw_as_ref(
            value.inner
        )
    );
}

proc rc_inner_mut<T>(
    value: ref mut Rc<T>
) -> Option<ref mut rc_inner.RcInner<T>> {
    if compiler_raw_ptr_is_null(
        value.inner
    ) {
        give none<ref mut rc_inner.RcInner<T>>();
    }

    give some<ref mut rc_inner.RcInner<T>>(
        compiler_raw_as_mut(
            value.inner
        )
    );
}

proc rc_weak_inner_ref<T>(
    value: ref RcWeak<T>
) -> Option<ref rc_inner.RcInner<T>> {
    if compiler_raw_ptr_is_null(
        value.inner
    ) {
        give none<ref rc_inner.RcInner<T>>();
    }

    give some<ref rc_inner.RcInner<T>>(
        compiler_raw_as_ref(
            value.inner
        )
    );
}

proc rc_weak_inner_mut<T>(
    value: ref mut RcWeak<T>
) -> Option<ref mut rc_inner.RcInner<T>> {
    if compiler_raw_ptr_is_null(
        value.inner
    ) {
        give none<ref mut rc_inner.RcInner<T>>();
    }

    give some<ref mut rc_inner.RcInner<T>>(
        compiler_raw_as_mut(
            value.inner
        )
    );
}

// -----------------------------------------------------------------------------
// Metadata refresh
// -----------------------------------------------------------------------------

proc rc_refresh<T>(
    value: ref mut Rc<T>
) -> bool {
    let inner =
        rc_inner_ref(
            ref *value
        );

    pick inner {
        Some(current) {
            set value.generation =
                current.generation;

            set value.revision =
                current.revision;

            give true;
        }

        None {
            give false;
        }
    }
}

proc rc_weak_refresh<T>(
    value: ref mut RcWeak<T>
) -> bool {
    let inner =
        rc_weak_inner_ref(
            ref *value
        );

    pick inner {
        Some(current) {
            set value.generation =
                current.generation;

            set value.revision =
                current.revision;

            give true;
        }

        None {
            give false;
        }
    }
}

// -----------------------------------------------------------------------------
// State
// -----------------------------------------------------------------------------

proc rc_state<T>(
    value: ref Rc<T>
) -> RcState {
    let inner =
        rc_inner_ref(
            value
        );

    pick inner {
        Some(current) {
            if current.generation
                != value.generation
            {
                give RcState.Invalid;
            }

            pick rc_inner.rc_inner_state(
                current
            ) {
                rc_inner.RcInnerState.Alive {
                    give RcState.Alive;
                }

                rc_inner.RcInnerState.WeakOnly {
                    give RcState.WeakOnly;
                }

                rc_inner.RcInnerState.Released {
                    give RcState.Released;
                }

                rc_inner.RcInnerState.Invalid {
                    give RcState.Invalid;
                }
            }
        }

        None {
            give RcState.Invalid;
        }
    }

    give RcState.Invalid;
}

proc rc_weak_state<T>(
    value: ref RcWeak<T>
) -> RcState {
    let inner =
        rc_weak_inner_ref(
            value
        );

    pick inner {
        Some(current) {
            if current.generation
                != value.generation
            {
                give RcState.Invalid;
            }

            pick rc_inner.rc_inner_state(
                current
            ) {
                rc_inner.RcInnerState.Alive {
                    give RcState.Alive;
                }

                rc_inner.RcInnerState.WeakOnly {
                    give RcState.WeakOnly;
                }

                rc_inner.RcInnerState.Released {
                    give RcState.Released;
                }

                rc_inner.RcInnerState.Invalid {
                    give RcState.Invalid;
                }
            }
        }

        None {
            give RcState.Invalid;
        }
    }

    give RcState.Invalid;
}

// -----------------------------------------------------------------------------
// Predicates
// -----------------------------------------------------------------------------

proc rc_is_alive<T>(
    value: ref Rc<T>
) -> bool {
    give rc_state(value)
        == RcState.Alive;
}

proc rc_is_unique<T>(
    value: ref Rc<T>
) -> bool {
    let inner =
        rc_inner_ref(
            value
        );

    pick inner {
        Some(current) {
            give rc_inner.rc_inner_is_unique(
                current
            );
        }

        None {
            give false;
        }
    }
}

proc rc_is_shared<T>(
    value: ref Rc<T>
) -> bool {
    let inner =
        rc_inner_ref(
            value
        );

    pick inner {
        Some(current) {
            give rc_inner.rc_inner_is_shared(
                current
            );
        }

        None {
            give false;
        }
    }
}

proc rc_is_released<T>(
    value: ref Rc<T>
) -> bool {
    give rc_state(value)
        == RcState.Released;
}

proc rc_is_valid<T>(
    value: ref Rc<T>
) -> bool {
    give rc_state(value)
        != RcState.Invalid;
}

proc rc_weak_is_expired<T>(
    value: ref RcWeak<T>
) -> bool {
    let inner =
        rc_weak_inner_ref(
            value
        );

    pick inner {
        Some(current) {
            give not current.value_alive
                or rc_inner.rc_inner_strong_count(
                    current
                ) == 0;
        }

        None {
            give true;
        }
    }
}

proc rc_weak_is_valid<T>(
    value: ref RcWeak<T>
) -> bool {
    give rc_weak_state(value)
        != RcState.Invalid;
}

