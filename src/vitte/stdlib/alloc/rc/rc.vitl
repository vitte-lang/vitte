// -----------------------------------------------------------------------------
// Clone
// -----------------------------------------------------------------------------

proc rc_clone<T>(
    value: Rc<T>
) -> Rc<T> {
    let inner =
        compiler_raw_as_mut(
            value.inner
        );

    if not rc_inner.rc_inner_clone_strong(
        inner
    ) {
        give compiler_rc_clone_failure<T>();
    }

    give Rc<T> {
        inner:
            value.inner,

        generation:
            inner.generation,

        revision:
            inner.revision
    };
}

proc rc_try_clone<T>(
    value: Rc<T>
) -> Option<Rc<T>> {
    if compiler_raw_ptr_is_null(
        value.inner
    ) {
        give none<Rc<T>>();
    }

    let inner =
        compiler_raw_as_mut(
            value.inner
        );

    if not rc_inner.rc_inner_clone_strong(
        inner
    ) {
        give none<Rc<T>>();
    }

    give some<Rc<T>>(
        Rc<T> {
            inner:
                value.inner,

            generation:
                inner.generation,

            revision:
                inner.revision
        }
    );
}

// -----------------------------------------------------------------------------
// Read access
// -----------------------------------------------------------------------------

proc rc_get<T>(
    value: ref Rc<T>
) -> ref T {
    let inner =
        rc_inner_ref(
            value
        );

    pick inner {
        Some(current) {
            let result =
                rc_inner.rc_inner_get(
                    current
                );

            pick result {
                Some(item) {
                    give item;
                }

                None {
                    give compiler_rc_access_failure<T>();
                }
            }
        }

        None {
            give compiler_rc_access_failure<T>();
        }
    }
}

proc rc_try_get<T>(
    value: ref Rc<T>
) -> Option<ref T> {
    let inner =
        rc_inner_ref(
            value
        );

    pick inner {
        Some(current) {
            give rc_inner.rc_inner_get(
                current
            );
        }

        None {
            give none<ref T>();
        }
    }
}

// -----------------------------------------------------------------------------
// Mutable access
// -----------------------------------------------------------------------------

proc rc_get_mut<T>(
    value: ref mut Rc<T>
) -> Option<ref mut T> {
    let inner =
        rc_inner_mut(
            value
        );

    pick inner {
        Some(current) {
            give rc_inner.rc_inner_get_mut(
                current
            );
        }

        None {
            give none<ref mut T>();
        }
    }
}

proc rc_is_mutable<T>(
    value: ref Rc<T>
) -> bool {
    give rc_is_unique(
        value
    );
}

// -----------------------------------------------------------------------------
// Replace
// -----------------------------------------------------------------------------

proc rc_replace<T>(
    value: ref mut Rc<T>,
    item: T
) -> bool {
    let inner =
        rc_inner_mut(
            value
        );

    pick inner {
        Some(current) {
            let result =
                rc_inner.rc_inner_replace(
                    current,
                    item
                );

            if result {
                rc_refresh(
                    value
                );
            }

            give result;
        }

        None {
            give false;
        }
    }
}

// -----------------------------------------------------------------------------
// Make mutable
// -----------------------------------------------------------------------------

proc rc_make_mut<T>(
    value: ref mut Rc<T>
) -> ref mut T {
    let existing =
        rc_get_mut(
            value
        );

    pick existing {
        Some(item) {
            give item;
        }

        None {}
    }

    let source =
        rc_get(
            ref *value
        );

    let copied =
        compiler_clone_value(
            source
        );

    let replacement =
        rc_new(
            copied
        );

    rc_drop(
        value
    );

    set *value =
        replacement;

    let result =
        rc_get_mut(
            value
        );

    pick result {
        Some(item) {
            give item;
        }

        None {
            give compiler_rc_mutable_access_failure<T>();
        }
    }
}

