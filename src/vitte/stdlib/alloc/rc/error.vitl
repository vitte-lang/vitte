// Names
// -----------------------------------------------------------------------------

proc rc_error_kind_name(
    kind: RcErrorKind
) -> string {
    pick kind {
        RcErrorKind.None {
            give "none";
        }

        RcErrorKind.InvalidRc {
            give "invalid-rc";
        }

        RcErrorKind.InvalidState {
            give "invalid-state";
        }

        RcErrorKind.InvalidControlBlock {
            give "invalid-control-block";
        }

        RcErrorKind.InvalidStrongCount {
            give "invalid-strong-count";
        }

        RcErrorKind.InvalidWeakCount {
            give "invalid-weak-count";
        }

        RcErrorKind.CountOverflow {
            give "count-overflow";
        }

        RcErrorKind.CountUnderflow {
            give "count-underflow";
        }

        RcErrorKind.CloneFailed {
            give "clone-failed";
        }

        RcErrorKind.DropFailed {
            give "drop-failed";
        }

        RcErrorKind.UpgradeFailed {
            give "upgrade-failed";
        }

        RcErrorKind.DowngradeFailed {
            give "downgrade-failed";
        }

        RcErrorKind.ValueDropped {
            give "value-dropped";
        }

        RcErrorKind.AllocationReleased {
            give "allocation-released";
        }

        RcErrorKind.InvalidPointer {
            give "invalid-pointer";
        }

        RcErrorKind.NullPointer {
            give "null-pointer";
        }

        RcErrorKind.StaleReference {
            give "stale-reference";
        }

        RcErrorKind.NotUnique {
            give "not-unique";
        }

        RcErrorKind.NotAlive {
            give "not-alive";
        }

        RcErrorKind.InvalidAccess {
            give "invalid-access";
        }

        RcErrorKind.MutableAccessDenied {
            give "mutable-access-denied";
        }

        RcErrorKind.RuntimeFailure {
            give "runtime-failure";
        }

        RcErrorKind.Internal {
            give "internal";
        }
    }

    give "internal";
}

proc rc_error_severity_name(
    severity: RcErrorSeverity
) -> string {
    pick severity {
        RcErrorSeverity.Note {
            give "note";
        }

        RcErrorSeverity.Warning {
            give "warning";
        }

        RcErrorSeverity.Error {
            give "error";
        }

        RcErrorSeverity.Fatal {
            give "fatal";
        }
    }

    give "error";
}

proc rc_error_domain_name(
    domain: RcErrorDomain
) -> string {
    pick domain {
        RcErrorDomain.General {
            give "general";
        }

        RcErrorDomain.Rc {
            give "rc";
        }

        RcErrorDomain.Count {
            give "count";
        }

        RcErrorDomain.Strong {
            give "strong";
        }

        RcErrorDomain.Weak {
            give "weak";
        }

        RcErrorDomain.Upgrade {
            give "upgrade";
        }

        RcErrorDomain.Downgrade {
            give "downgrade";
        }

        RcErrorDomain.Access {
            give "access";
        }

        RcErrorDomain.Pointer {
            give "pointer";
        }

        RcErrorDomain.Runtime {
            give "runtime";
        }

        RcErrorDomain.Internal {
            give "internal";
        }
    }

    give "internal";
}

proc rc_error_operation_name(
    operation: RcErrorOperation
) -> string {
    pick operation {
        RcErrorOperation.None {
            give "none";
        }

        RcErrorOperation.New {
            give "new";
        }

        RcErrorOperation.CloneStrong {
            give "clone-strong";
        }

        RcErrorOperation.DropStrong {
            give "drop-strong";
        }

        RcErrorOperation.CloneWeak {
            give "clone-weak";
        }

        RcErrorOperation.DropWeak {
            give "drop-weak";
        }

        RcErrorOperation.Upgrade {
            give "upgrade";
        }

        RcErrorOperation.Downgrade {
            give "downgrade";
        }

        RcErrorOperation.Get {
            give "get";
        }

        RcErrorOperation.GetMut {
            give "get-mut";
        }

        RcErrorOperation.DropValue {
            give "drop-value";
        }

        RcErrorOperation.ReleaseAllocation {
            give "release-allocation";
        }

        RcErrorOperation.Validate {
            give "validate";
        }
    }

    give "none";
}

// -----------------------------------------------------------------------------
// Error model
// -----------------------------------------------------------------------------
//
// Rc errors:
//
//     counts
//       |
//       +-- overflow
//       +-- underflow
//       +-- invalid strong count
//       +-- invalid weak count
//
//     strong
//       |
//       +-- clone failed
//       +-- drop failed
//
//     weak
//       |
//       +-- clone failed
//       +-- drop failed
//
//     upgrade
//       |
//       +-- value already dropped
//       +-- no valid weak reference
//
//     access
//       |
//       +-- value dead
//       +-- mutable access while shared
//
//     pointer
//       |
//       +-- null pointer
//       +-- stale reference
//       +-- released allocation
//
// Mutable access requires:
//
//     strong == 1
//
// Read access requires:
//
//     strong > 0
//
// Weak upgrade requires:
//
//     weak > 0
//     strong > 0
//
// Value destruction occurs when:
//
//     strong -> 0
//
// Control allocation release occurs when:
//
//     strong == 0
//     weak == 0
//
// Count overflow is treated as fatal because reference-count correctness can
// no longer be guaranteed after an overflowing increment.
//
// Diagnostics rendering and localization remain outside this module.
