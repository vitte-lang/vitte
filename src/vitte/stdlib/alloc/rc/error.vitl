// -----------------------------------------------------------------------------
// Count checking
// -----------------------------------------------------------------------------

proc rc_error_for_strong_clone(
    counts: rc_count.RcCountPair
) -> RcError {
    if counts.strong.value == 0 {
        give rc_error_not_alive(
            counts
        );
    }

    if not rc_count.rc_count_can_increment(
        counts.strong
    ) {
        give rc_error_count_overflow(
            counts,
            RcErrorOperation.CloneStrong
        );
    }

    give rc_error_none();
}

proc rc_error_for_strong_drop(
    counts: rc_count.RcCountPair
) -> RcError {
    if not rc_count.rc_count_can_decrement(
        counts.strong
    ) {
        give rc_error_count_underflow(
            counts,
            RcErrorOperation.DropStrong
        );
    }

    give rc_error_none();
}

proc rc_error_for_weak_clone(
    counts: rc_count.RcCountPair
) -> RcError {
    if not rc_count.rc_count_can_increment(
        counts.weak
    ) {
        give rc_error_count_overflow(
            counts,
            RcErrorOperation.CloneWeak
        );
    }

    give rc_error_none();
}

proc rc_error_for_weak_drop(
    counts: rc_count.RcCountPair
) -> RcError {
    if not rc_count.rc_count_can_decrement(
        counts.weak
    ) {
        give rc_error_count_underflow(
            counts,
            RcErrorOperation.DropWeak
        );
    }

    give rc_error_none();
}

// -----------------------------------------------------------------------------
// Upgrade / downgrade checking
// -----------------------------------------------------------------------------

proc rc_error_for_upgrade(
    counts: rc_count.RcCountPair
) -> RcError {
    if counts.weak.value == 0 {
        give rc_error_upgrade_failed(
            counts
        );
    }

    if counts.strong.value == 0 {
        give rc_error_value_dropped(
            counts
        );
    }

    if not rc_count.rc_count_can_increment(
        counts.strong
    ) {
        give rc_error_count_overflow(
            counts,
            RcErrorOperation.Upgrade
        );
    }

    give rc_error_none();
}

proc rc_error_for_downgrade(
    counts: rc_count.RcCountPair
) -> RcError {
    if counts.strong.value == 0 {
        give rc_error_not_alive(
            counts
        );
    }

    if not rc_count.rc_count_can_increment(
        counts.weak
    ) {
        give rc_error_count_overflow(
            counts,
            RcErrorOperation.Downgrade
        );
    }

    give rc_error_none();
}

// -----------------------------------------------------------------------------
// Access checking
// -----------------------------------------------------------------------------

proc rc_error_for_read(
    counts: rc_count.RcCountPair
) -> RcError {
    if not rc_count.rc_count_is_alive(
        counts
    ) {
        give rc_error_not_alive(
            counts
        );
    }

    give rc_error_none();
}

proc rc_error_for_write(
    counts: rc_count.RcCountPair
) -> RcError {
    if not rc_count.rc_count_is_alive(
        counts
    ) {
        give rc_error_not_alive(
            counts
        );
    }

    if not rc_count.rc_count_strong_is_unique(
        counts
    ) {
        give rc_error_not_unique(
            counts
        );
    }

    give rc_error_none();
}

// -----------------------------------------------------------------------------
// Count validation mapping
// -----------------------------------------------------------------------------

proc rc_error_from_count_validation(
    count: rc_count.RcCount,
    validation: rc_count.RcCountValidation
) -> RcError {
    if validation.valid {
        give rc_error_none();
    }

    if not validation.kind_valid {
        give rc_error_internal(
            "rc count kind is invalid"
        );
    }

    if not validation.state_valid {
        if count.kind
            == rc_count.RcCountKind.Strong
        {
            give rc_error_simple(
                RcErrorKind.InvalidStrongCount,
                "rc strong counter state is invalid"
            );
        }

        give rc_error_simple(
            RcErrorKind.InvalidWeakCount,
            "rc weak counter state is invalid"
        );
    }

    if not validation.generation_valid {
        give rc_error_internal(
            "rc count generation metadata is invalid"
        );
    }

    give rc_error_internal(
        "unknown rc count validation failure"
    );
}

proc rc_error_from_count_pair(
    counts: rc_count.RcCountPair
) -> RcError {
    let strong =
        rc_count.rc_count_validate(
            counts.strong
        );

    if not strong.valid {
        give rc_error_from_count_validation(
            counts.strong,
            strong
        );
    }

    let weak =
        rc_count.rc_count_validate(
            counts.weak
        );

    if not weak.valid {
        give rc_error_from_count_validation(
            counts.weak,
            weak
        );
    }

    if not rc_count.rc_count_pair_valid(
        counts
    ) {
        give rc_error_invalid_rc(
            counts
        );
    }

    give rc_error_none();
}

// -----------------------------------------------------------------------------
// Core validation mapping
// -----------------------------------------------------------------------------

proc rc_error_from_core_validation(
    profile: rc_core.RcCoreProfile,
    validation: rc_core.RcCoreValidation
) -> RcError {
    if validation.valid {
        give rc_error_none();
    }

    let context =
        rc_error_context_core(
            profile,
            RcErrorOperation.Validate
        );

    if not validation.counts_valid {
        give rc_error(
            RcErrorKind.InvalidRc,
            RcErrorSeverity.Fatal,
            RcErrorDomain.Count,
            context,
            "rc reference counts are invalid"
        );
    }

    if not validation.state_valid {
        give rc_error(
            RcErrorKind.InvalidState,
            RcErrorSeverity.Error,
            RcErrorDomain.Rc,
            context,
            "rc core state is invalid"
        );
    }

    if not validation.ownership_valid {
        give rc_error(
            RcErrorKind.InvalidState,
            RcErrorSeverity.Error,
            RcErrorDomain.Rc,
            context,
            "rc ownership state is invalid"
        );
    }

    if not validation.access_valid {
        give rc_error(
            RcErrorKind.InvalidAccess,
            RcErrorSeverity.Error,
            RcErrorDomain.Access,
            context,
            "rc access state is invalid"
        );
    }

    if not validation.generation_valid {
        give rc_error(
            RcErrorKind.Internal,
            RcErrorSeverity.Fatal,
            RcErrorDomain.Internal,
            context,
            "rc generation metadata is invalid"
        );
    }

    give rc_error_internal(
        "unknown rc core validation failure"
    );
}

// -----------------------------------------------------------------------------
// Predicates
// -----------------------------------------------------------------------------

proc rc_error_is_none(
    error: RcError
) -> bool {
    give error.kind
        == RcErrorKind.None;
}

proc rc_error_is_warning(
    error: RcError
) -> bool {
    give error.severity
        == RcErrorSeverity.Warning;
}

proc rc_error_is_error(
    error: RcError
) -> bool {
    give error.severity
        == RcErrorSeverity.Error
        or error.severity
            == RcErrorSeverity.Fatal;
}

proc rc_error_is_fatal(
    error: RcError
) -> bool {
    give error.severity
        == RcErrorSeverity.Fatal;
}

proc rc_error_is_count(
    error: RcError
) -> bool {
    give error.domain
        == RcErrorDomain.Count;
}

proc rc_error_is_strong(
    error: RcError
) -> bool {
    give error.domain
        == RcErrorDomain.Strong;
}

proc rc_error_is_weak(
    error: RcError
) -> bool {
    give error.domain
        == RcErrorDomain.Weak;
}

proc rc_error_is_upgrade(
    error: RcError
) -> bool {
    give error.domain
        == RcErrorDomain.Upgrade;
}

proc rc_error_is_downgrade(
    error: RcError
) -> bool {
    give error.domain
        == RcErrorDomain.Downgrade;
}

proc rc_error_is_access(
    error: RcError
) -> bool {
    give error.domain
        == RcErrorDomain.Access;
}

proc rc_error_is_pointer(
    error: RcError
) -> bool {
    give error.domain
        == RcErrorDomain.Pointer;
}

proc rc_error_is_overflow(
    error: RcError
) -> bool {
    give error.kind
        == RcErrorKind.CountOverflow;
}

proc rc_error_is_underflow(
    error: RcError
) -> bool {
    give error.kind
        == RcErrorKind.CountUnderflow;
}

proc rc_error_is_stale(
    error: RcError
) -> bool {
    give error.kind
        == RcErrorKind.StaleReference;
}

// -----------------------------------------------------------------------------
// Domain mapping
// -----------------------------------------------------------------------------

proc rc_error_domain_for_kind(
    kind: RcErrorKind
) -> RcErrorDomain {
    pick kind {
        RcErrorKind.None {
            give RcErrorDomain.General;
        }

        RcErrorKind.InvalidRc
        | RcErrorKind.InvalidState
        | RcErrorKind.InvalidControlBlock
        | RcErrorKind.ValueDropped
        | RcErrorKind.AllocationReleased
        | RcErrorKind.NotAlive {
            give RcErrorDomain.Rc;
        }

        RcErrorKind.InvalidStrongCount
        | RcErrorKind.InvalidWeakCount
        | RcErrorKind.CountOverflow
        | RcErrorKind.CountUnderflow {
            give RcErrorDomain.Count;
        }

        RcErrorKind.CloneFailed
        | RcErrorKind.DropFailed {
            give RcErrorDomain.Strong;
        }

        RcErrorKind.UpgradeFailed {
            give RcErrorDomain.Upgrade;
        }

        RcErrorKind.DowngradeFailed {
            give RcErrorDomain.Downgrade;
        }

        RcErrorKind.NotUnique
        | RcErrorKind.InvalidAccess
        | RcErrorKind.MutableAccessDenied {
            give RcErrorDomain.Access;
        }

        RcErrorKind.InvalidPointer
        | RcErrorKind.NullPointer
        | RcErrorKind.StaleReference {
            give RcErrorDomain.Pointer;
        }

        RcErrorKind.RuntimeFailure {
            give RcErrorDomain.Runtime;
        }

        RcErrorKind.Internal {
            give RcErrorDomain.Internal;
        }
    }

    give RcErrorDomain.Internal;
}

// -----------------------------------------------------------------------------
// Statistics
// -----------------------------------------------------------------------------

proc rc_error_statistics_empty()
    -> RcErrorStatistics
{
    give RcErrorStatistics {
        total: 0,

        notes: 0,
        warnings: 0,
        errors: 0,
        fatals: 0,

        rc_errors: 0,
        count_errors: 0,
        strong_errors: 0,
        weak_errors: 0,
        upgrade_errors: 0,
        downgrade_errors: 0,
        access_errors: 0,
        pointer_errors: 0,
        runtime_errors: 0,
        internal_errors: 0
    };
}

proc rc_error_statistics_record(
    statistics: ref mut RcErrorStatistics,
    error: RcError
) {
    if rc_error_is_none(
        error
    ) {
        give;
    }

    set statistics.total =
        statistics.total + 1;

    pick error.severity {
        RcErrorSeverity.Note {
            set statistics.notes =
                statistics.notes + 1;
        }

        RcErrorSeverity.Warning {
            set statistics.warnings =
                statistics.warnings + 1;
        }

        RcErrorSeverity.Error {
            set statistics.errors =
                statistics.errors + 1;
        }

        RcErrorSeverity.Fatal {
            set statistics.fatals =
                statistics.fatals + 1;
        }
    }

    pick error.domain {
        RcErrorDomain.Rc {
            set statistics.rc_errors =
                statistics.rc_errors + 1;
        }

        RcErrorDomain.Count {
            set statistics.count_errors =
                statistics.count_errors + 1;
        }

        RcErrorDomain.Strong {
            set statistics.strong_errors =
                statistics.strong_errors + 1;
        }

        RcErrorDomain.Weak {
            set statistics.weak_errors =
                statistics.weak_errors + 1;
        }

        RcErrorDomain.Upgrade {
            set statistics.upgrade_errors =
                statistics.upgrade_errors + 1;
        }

        RcErrorDomain.Downgrade {
            set statistics.downgrade_errors =
                statistics.downgrade_errors + 1;
        }

        RcErrorDomain.Access {
            set statistics.access_errors =
                statistics.access_errors + 1;
        }

        RcErrorDomain.Pointer {
            set statistics.pointer_errors =
                statistics.pointer_errors + 1;
        }

        RcErrorDomain.Runtime {
            set statistics.runtime_errors =
                statistics.runtime_errors + 1;
        }

        RcErrorDomain.Internal {
            set statistics.internal_errors =
                statistics.internal_errors + 1;
        }

        RcErrorDomain.General {}
    }
}

proc rc_error_statistics_reset(
    statistics: ref mut RcErrorStatistics
) {
    set *statistics =
        rc_error_statistics_empty();
}

