space vitte/stdlib/alloc/rc/error

export *

use src/vitte/stdlib/alloc/rc/core as rc_core
use src/vitte/stdlib/alloc/rc/count as rc_count

pick RcErrorKind {
    None,

    InvalidRc,
    InvalidState,
    InvalidControlBlock,

    InvalidStrongCount,
    InvalidWeakCount,
    CountOverflow,
    CountUnderflow,

    CloneFailed,
    DropFailed,

    UpgradeFailed,
    DowngradeFailed,

    ValueDropped,
    AllocationReleased,

    InvalidPointer,
    NullPointer,
    StaleReference,

    NotUnique,
    NotAlive,

    InvalidAccess,
    MutableAccessDenied,

    RuntimeFailure,
    Internal
}

pick RcErrorSeverity {
    Note,
    Warning,
    Error,
    Fatal
}

pick RcErrorDomain {
    General,
    Rc,
    Count,
    Strong,
    Weak,
    Upgrade,
    Downgrade,
    Access,
    Pointer,
    Runtime,
    Internal
}

pick RcErrorOperation {
    None,

    New,

    CloneStrong,
    DropStrong,

    CloneWeak,
    DropWeak,

    Upgrade,
    Downgrade,

    Get,
    GetMut,

    DropValue,
    ReleaseAllocation,

    Validate
}

form RcErrorContext {
    operation: RcErrorOperation

    state: rc_core.RcCoreState
    ownership: rc_core.RcCoreOwnership
    access: rc_core.RcCoreAccess

    strong: usize
    weak: usize

    generation: u64
    revision: u64
}

form RcError {
    kind: RcErrorKind
    severity: RcErrorSeverity
    domain: RcErrorDomain

    context: RcErrorContext

    message: string
}

form RcErrorStatistics {
    total: u64

    notes: u64
    warnings: u64
    errors: u64
    fatals: u64

    rc_errors: u64
    count_errors: u64
    strong_errors: u64
    weak_errors: u64
    upgrade_errors: u64
    downgrade_errors: u64
    access_errors: u64
    pointer_errors: u64
    runtime_errors: u64
    internal_errors: u64
}

// -----------------------------------------------------------------------------
// Context
// -----------------------------------------------------------------------------

proc rc_error_context_empty()
    -> RcErrorContext
{
    give RcErrorContext {
        operation:
            RcErrorOperation.None,

        state:
            rc_core.RcCoreState.Invalid,

        ownership:
            rc_core.RcCoreOwnership.Dead,

        access:
            rc_core.RcCoreAccess.None,

        strong:
            0,

        weak:
            0,

        generation:
            0,

        revision:
            0
    };
}

proc rc_error_context_counts(
    counts: rc_count.RcCountPair,
    operation: RcErrorOperation
) -> RcErrorContext {
    let core =
        rc_count.rc_count_core(
            counts
        );

    give RcErrorContext {
        operation:
            operation,

        state:
            rc_core.rc_core_state(
                core
            ),

        ownership:
            rc_core.rc_core_ownership(
                core
            ),

        access:
            rc_core.rc_core_access(
                core
            ),

        strong:
            counts.strong.value,

        weak:
            counts.weak.value,

        generation:
            counts.strong.generation,

        revision:
            counts.strong.revision
    };
}

proc rc_error_context_core(
    profile: rc_core.RcCoreProfile,
    operation: RcErrorOperation
) -> RcErrorContext {
    give RcErrorContext {
        operation:
            operation,

        state:
            profile.info.state,

        ownership:
            profile.info.ownership,

        access:
            profile.info.access,

        strong:
            profile.counts.strong,

        weak:
            profile.counts.weak,

        generation:
            profile.meta.generation,

        revision:
            profile.meta.revision
    };
}

// -----------------------------------------------------------------------------
// Constructors
// -----------------------------------------------------------------------------

proc rc_error(
    kind: RcErrorKind,
    severity: RcErrorSeverity,
    domain: RcErrorDomain,
    context: RcErrorContext,
    message: string
) -> RcError {
    give RcError {
        kind:
            kind,

        severity:
            severity,

        domain:
            domain,

        context:
            context,

        message:
            message
    };
}

proc rc_error_none()
    -> RcError
{
    give rc_error(
        RcErrorKind.None,
        RcErrorSeverity.Note,
        RcErrorDomain.General,
        rc_error_context_empty(),
        ""
    );
}

proc rc_error_simple(
    kind: RcErrorKind,
    message: string
) -> RcError {
    give rc_error(
        kind,
        RcErrorSeverity.Error,
        rc_error_domain_for_kind(
            kind
        ),
        rc_error_context_empty(),
        message
    );
}

proc rc_error_fatal(
    kind: RcErrorKind,
    message: string
) -> RcError {
    give rc_error(
        kind,
        RcErrorSeverity.Fatal,
        rc_error_domain_for_kind(
            kind
        ),
        rc_error_context_empty(),
        message
    );
}

// -----------------------------------------------------------------------------
// Rc errors
// -----------------------------------------------------------------------------

proc rc_error_invalid_rc(
    counts: rc_count.RcCountPair
) -> RcError {
    give rc_error(
        RcErrorKind.InvalidRc,
        RcErrorSeverity.Fatal,
        RcErrorDomain.Rc,
        rc_error_context_counts(
            counts,
            RcErrorOperation.Validate
        ),
        "rc value is invalid"
    );
}

