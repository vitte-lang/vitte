use src/vitte/stdlib/alloc/rc/rc

form Point {
    x: int
    y: int
}

proc test_downgrade() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    give rc_strong_count(ref value) == 1
        and rc_weak_count(ref value) == 1
        and rc_weak_strong_count(ref weak) == 1
        and rc_weak_weak_count(ref weak) == 1
        and not rc_weak_is_expired(ref weak);
}

proc test_try_downgrade() -> bool {
    let value = rc_new(42);

    let result = rc_try_downgrade(
        ref value
    );

    pick result {
        Some(weak) {
            give rc_weak_strong_count(ref weak) == 1
                and rc_weak_weak_count(ref weak) == 1;
        }

        None {
            give false;
        }
    }
}

proc test_weak_clone() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    let copy = rc_weak_clone(
        weak
    );

    give rc_weak_weak_count(ref weak) == 2
        and rc_weak_weak_count(ref copy) == 2
        and rc_weak_ptr_equal(
            ref weak,
            ref copy
        );
}

proc test_weak_try_clone() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    let result = rc_weak_try_clone(
        weak
    );

    pick result {
        Some(copy) {
            give rc_weak_weak_count(ref copy) == 2
                and rc_weak_ptr_equal(
                    ref weak,
                    ref copy
                );
        }

        None {
            give false;
        }
    }
}

proc test_upgrade() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    let result = rc_upgrade(
        ref weak
    );

    pick result {
        Some(copy) {
            give *rc_get(ref copy) == 42
                and rc_strong_count(ref value) == 2
                and rc_ptr_eq_weak(
                    ref copy,
                    ref weak
                );
        }

        None {
            give false;
        }
    }
}

proc test_upgrade_point() -> bool {
    let value = rc_new(
        Point {
            x: 10
            y: 20
        }
    );

    let weak = rc_downgrade(
        ref value
    );

    let result = rc_upgrade(
        ref weak
    );

    pick result {
        Some(copy) {
            let point = rc_get(
                ref copy
            );

            give point.x == 10
                and point.y == 20;
        }

        None {
            give false;
        }
    }
}

proc test_upgrade_increments_strong() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    let before = rc_strong_count(
        ref value
    );

    let result = rc_upgrade(
        ref weak
    );

    pick result {
        Some(copy) {
            give rc_strong_count(ref value)
                    == before + 1
                and rc_strong_count(ref copy)
                    == before + 1;
        }

        None {
            give false;
        }
    }
}

proc test_upgrade_does_not_change_weak() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    let before = rc_weak_count(
        ref value
    );

    let result = rc_upgrade(
        ref weak
    );

    pick result {
        Some(copy) {
            give rc_weak_count(ref value) == before
                and rc_weak_count(ref copy) == before;
        }

        None {
            give false;
        }
    }
}

proc test_weak_ptr_matches_strong() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    give rc_ptr_eq_weak(
        ref value,
        ref weak
    );
}

proc test_multiple_weak() -> bool {
    let value = rc_new(42);

    let first = rc_downgrade(
        ref value
    );

    let second = rc_weak_clone(
        first
    );

    let third = rc_weak_clone(
        second
    );

    give rc_weak_count(ref value) == 3
        and rc_weak_weak_count(ref first) == 3
        and rc_weak_weak_count(ref second) == 3
        and rc_weak_weak_count(ref third) == 3;
}

proc test_drop_weak() -> bool {
    let value = rc_new(42);

    let mut weak = rc_downgrade(
        ref value
    );

    if rc_weak_count(ref value) != 1 {
        give false;
    }

    give rc_weak_drop(
        ref mut weak
    )
    and rc_weak_count(ref value) == 0;
}

proc test_drop_one_of_many_weak() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    let mut copy = rc_weak_clone(
        weak
    );

    if rc_weak_count(ref value) != 2 {
        give false;
    }

    if not rc_weak_drop(
        ref mut copy
    ) {
        give false;
    }

    give rc_weak_count(ref value) == 1
        and rc_weak_weak_count(ref weak) == 1;
}

proc test_drop_all_weak() -> bool {
    let value = rc_new(42);

    let mut first = rc_downgrade(
        ref value
    );

    let mut second = rc_weak_clone(
        first
    );

    let mut third = rc_weak_clone(
        second
    );

    if rc_weak_count(ref value) != 3 {
        give false;
    }

    if not rc_weak_drop(ref mut first) {
        give false;
    }

    if rc_weak_count(ref value) != 2 {
        give false;
    }

    if not rc_weak_drop(ref mut second) {
        give false;
    }

    if rc_weak_count(ref value) != 1 {
        give false;
    }

    if not rc_weak_drop(ref mut third) {
        give false;
    }

    give rc_weak_count(ref value) == 0;
}

proc test_double_weak_drop_fails() -> bool {
    let value = rc_new(42);

    let mut weak = rc_downgrade(
        ref value
    );

    let first = rc_weak_drop(
        ref mut weak
    );

    let second = rc_weak_drop(
        ref mut weak
    );

    give first
        and not second;
}

proc test_weak_alive_before_strong_drop() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    give not rc_weak_is_expired(
        ref weak
    )
    and rc_weak_strong_count(ref weak) == 1;
}

proc test_weak_expires_after_strong_drop() -> bool {
    let mut value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    if not rc_drop(
        ref mut value
    ) {
        give false;
    }

    give rc_weak_is_expired(
        ref weak
    )
    and rc_weak_strong_count(ref weak) == 0
    and rc_weak_weak_count(ref weak) == 1;
}

proc test_upgrade_expired_fails() -> bool {
    let mut value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    if not rc_drop(
        ref mut value
    ) {
        give false;
    }

    give is_none(
        rc_upgrade(
            ref weak
        )
    );
}

proc test_weak_profile_alive() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    let profile = rc_weak_profile(
        ref weak
    );

    give profile.strong == 1
        and profile.weak == 1
        and profile.alive
        and profile.upgradeable
        and not profile.expired
        and profile.valid;
}

proc test_weak_profile_expired() -> bool {
    let mut value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    if not rc_drop(
        ref mut value
    ) {
        give false;
    }

    let profile = rc_weak_profile(
        ref weak
    );

    give profile.strong == 0
        and profile.weak == 1
        and profile.expired
        and not profile.upgradeable;
}

proc test_weak_validation() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    let validation = rc_weak_validate(
        ref weak
    );

    give validation.valid
        and validation.pointer_valid
        and validation.generation_valid
        and validation.inner_valid
        and validation.weak_valid
        and validation.state_valid;
}

proc test_weak_invariant() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    give rc_weak_invariant_holds(
        ref weak
    );
}

proc test_weak_snapshot_equal() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    let first = rc_weak_snapshot(
        ref weak
    );

    let second = rc_weak_snapshot(
        ref weak
    );

    give rc_snapshot_equal(
        first,
        second
    );
}

proc test_weak_snapshot_clone_changed() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    let before = rc_weak_snapshot(
        ref weak
    );

    let copy = rc_weak_clone(
        weak
    );

    let after = rc_weak_snapshot(
        ref weak
    );

    give rc_snapshot_changed(
        before,
        after
    )
    and rc_weak_weak_count(ref copy) == 2;
}

proc test_weak_delta_clone() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    let before = rc_weak_snapshot(
        ref weak
    );

    let copy = rc_weak_clone(
        weak
    );

    let after = rc_weak_snapshot(
        ref weak
    );

    let delta = rc_delta(
        before,
        after
    );

    give delta.changed
        and delta.strong == 0
        and delta.weak == 1
        and rc_weak_weak_count(ref copy) == 2;
}

proc test_weak_delta_upgrade() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    let before = rc_weak_snapshot(
        ref weak
    );

    let result = rc_upgrade(
        ref weak
    );

    pick result {
        Some(copy) {
            let after = rc_weak_snapshot(
                ref weak
            );

            let delta = rc_delta(
                before,
                after
            );

            give delta.changed
                and delta.strong == 1
                and delta.weak == 0
                and rc_strong_count(ref copy) == 2;
        }

        None {
            give false;
        }
    }
}

proc test_weak_raw_conversion() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    let raw = rc_weak_as_raw(
        ref weak
    );

    give rc_raw_is_alive(raw)
        and rc_raw_strong_count(raw) == 1
        and rc_raw_weak_count(raw) == 1;
}

proc test_weak_from_raw() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    let raw = rc_weak_as_raw(
        ref weak
    );

    let result = rc_weak_from_raw(
        raw
    );

    pick result {
        Some(copy) {
            give rc_weak_ptr_equal(
                ref weak,
                ref copy
            );
        }

        None {
            give false;
        }
    }
}

proc test_weak_clone_raw_identity() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    let copy = rc_weak_clone(
        weak
    );

    let left = rc_weak_as_raw(
        ref weak
    );

    let right = rc_weak_as_raw(
        ref copy
    );

    give rc_raw_same_allocation(
        left,
        right
    );
}

proc test_weak_with_multiple_strong() -> bool {
    let value = rc_new(42);

    let copy = rc_clone(
        value
    );

    let weak = rc_downgrade(
        ref value
    );

    give rc_weak_strong_count(ref weak) == 2
        and rc_weak_weak_count(ref weak) == 1
        and not rc_weak_is_expired(ref weak)
        and rc_strong_count(ref copy) == 2;
}

proc test_weak_stays_alive_until_final_strong_drop() -> bool {
    let mut value = rc_new(42);

    let mut copy = rc_clone(
        value
    );

    let weak = rc_downgrade(
        ref value
    );

    if not rc_drop(
        ref mut copy
    ) {
        give false;
    }

    if rc_weak_is_expired(
        ref weak
    ) {
        give false;
    }

    if not rc_drop(
        ref mut value
    ) {
        give false;
    }

    give rc_weak_is_expired(
        ref weak
    );
}

proc test_upgrade_then_drop_copy() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    let result = rc_upgrade(
        ref weak
    );

    pick result {
        Some(copy) {
            let mut temp = copy;

            if rc_strong_count(
                ref value
            ) != 2 {
                give false;
            }

            if not rc_drop(
                ref mut temp
            ) {
                give false;
            }

            give rc_strong_count(
                ref value
            ) == 1
            and not rc_weak_is_expired(
                ref weak
            );
        }

        None {
            give false;
        }
    }
}

proc test_upgrade_many_times() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    let cycle: usize = 0;

    while cycle < 10000 {
        let result = rc_upgrade(
            ref weak
        );

        pick result {
            Some(copy) {
                let mut temp = copy;

                if rc_strong_count(
                    ref value
                ) != 2 {
                    give false;
                }

                if not rc_drop(
                    ref mut temp
                ) {
                    give false;
                }
            }

            None {
                give false;
            }
        }

        if rc_strong_count(
            ref value
        ) != 1 {
            give false;
        }

        set cycle = cycle + 1;
    }

    give true;
}

proc test_clone_drop_weak_stress() -> bool {
    let value = rc_new(42);

    let cycle: usize = 0;

    while cycle < 10000 {
        let mut weak = rc_downgrade(
            ref value
        );

        if rc_weak_count(ref value) != 1 {
            give false;
        }

        if not rc_weak_drop(
            ref mut weak
        ) {
            give false;
        }

        if rc_weak_count(ref value) != 0 {
            give false;
        }

        set cycle = cycle + 1;
    }

    give rc_strong_count(
        ref value
    ) == 1;
}

proc test_weak_clone_stress() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    let cycle: usize = 0;

    while cycle < 10000 {
        let mut copy = rc_weak_clone(
            weak
        );

        if rc_weak_count(ref value) != 2 {
            give false;
        }

        if not rc_weak_drop(
            ref mut copy
        ) {
            give false;
        }

        if rc_weak_count(ref value) != 1 {
            give false;
        }

        set cycle = cycle + 1;
    }

    give true;
}

proc test_weak_snapshot_stress() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    let cycle: usize = 0;

    while cycle < 10000 {
        let before = rc_weak_snapshot(
            ref weak
        );

        let mut copy = rc_weak_clone(
            weak
        );

        let after_clone = rc_weak_snapshot(
            ref weak
        );

        let delta = rc_delta(
            before,
            after_clone
        );

        if delta.weak != 1 {
            give false;
        }

        if not rc_weak_drop(
            ref mut copy
        ) {
            give false;
        }

        let after_drop = rc_weak_snapshot(
            ref weak
        );

        if after_drop.weak
            != before.weak {
            give false;
        }

        set cycle = cycle + 1;
    }

    give true;
}

proc test_weak_validation_stress() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    let cycle: usize = 0;

    while cycle < 10000 {
        let mut copy = rc_weak_clone(
            weak
        );

        if not rc_weak_validate(
            ref weak
        ).valid {
            give false;
        }

        if not rc_weak_validate(
            ref copy
        ).valid {
            give false;
        }

        if not rc_weak_drop(
            ref mut copy
        ) {
            give false;
        }

        if not rc_weak_invariant_holds(
            ref weak
        ) {
            give false;
        }

        set cycle = cycle + 1;
    }

    give true;
}

proc test_many_weak_refs() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    let values: [RcWeak<int>] = [
        weak
    ];

    let index: usize = 1;

    while index < 256 {
        set values =
            values + [
                rc_weak_clone(
                    weak
                )
            ];

        set index = index + 1;
    }

    if rc_weak_count(ref value) != 256 {
        give false;
    }

    let check: usize = 0;

    while check < 256 {
        if rc_weak_is_expired(
            ref values[check]
        ) {
            give false;
        }

        if rc_weak_weak_count(
            ref values[check]
        ) != 256 {
            give false;
        }

        set check = check + 1;
    }

    give true;
}

proc test_many_weak_drop_all() -> bool {
    let value = rc_new(42);

    let root = rc_downgrade(
        ref value
    );

    let values: [RcWeak<int>] = [
        root
    ];

    let index: usize = 1;

    while index < 128 {
        set values =
            values + [
                rc_weak_clone(
                    root
                )
            ];

        set index = index + 1;
    }

    if rc_weak_count(ref value) != 128 {
        give false;
    }

    let release: usize = 0;

    while release < 128 {
        if not rc_weak_drop(
            ref mut values[release]
        ) {
            give false;
        }

        set release = release + 1;
    }

    give rc_weak_count(ref value) == 0;
}

proc test_many_expired_weak() -> bool {
    let mut value = rc_new(42);

    let root = rc_downgrade(
        ref value
    );

    let values: [RcWeak<int>] = [
        root
    ];

    let index: usize = 1;

    while index < 128 {
        set values =
            values + [
                rc_weak_clone(
                    root
                )
            ];

        set index = index + 1;
    }

    if not rc_drop(
        ref mut value
    ) {
        give false;
    }

    let check: usize = 0;

    while check < 128 {
        if not rc_weak_is_expired(
            ref values[check]
        ) {
            give false;
        }

        if is_some(
            rc_upgrade(
                ref values[check]
            )
        ) {
            give false;
        }

        set check = check + 1;
    }

    give true;
}

proc test_statistics_empty() -> bool {
    let statistics =
        rc_statistics_empty();

    give statistics.weak_creations == 0
        and statistics.weak_clones == 0
        and statistics.weak_drops == 0
        and statistics.upgrades == 0
        and statistics.upgrade_failures == 0;
}

proc test_statistics_downgrade() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    let mut statistics =
        rc_statistics_empty();

    rc_statistics_record_downgrade(
        ref mut statistics,
        ref value,
        true
    );

    give statistics.weak_creations == 1
        and statistics.peak_weak == 1
        and rc_weak_weak_count(ref weak) == 1;
}

proc test_statistics_weak_clone() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    let copy = rc_weak_clone(
        weak
    );

    let mut statistics =
        rc_statistics_empty();

    rc_statistics_record_weak_clone(
        ref mut statistics,
        ref weak,
        true
    );

    give statistics.weak_clones == 1
        and statistics.peak_weak == 2
        and rc_weak_weak_count(ref copy) == 2;
}

proc test_statistics_weak_drop() -> bool {
    let mut statistics =
        rc_statistics_empty();

    rc_statistics_record_weak_drop(
        ref mut statistics,
        true
    );

    give statistics.weak_drops == 1;
}

proc test_statistics_upgrade() -> bool {
    let value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    let result = rc_upgrade(
        ref weak
    );

    let mut statistics =
        rc_statistics_empty();

    rc_statistics_record_upgrade(
        ref mut statistics,
        ref weak,
        is_some(result)
    );

    give statistics.upgrades == 1
        and statistics.upgrade_failures == 0;
}

proc test_statistics_upgrade_failure() -> bool {
    let mut value = rc_new(42);

    let weak = rc_downgrade(
        ref value
    );

    if not rc_drop(
        ref mut value
    ) {
        give false;
    }

    let result = rc_upgrade(
        ref weak
    );

    let mut statistics =
        rc_statistics_empty();

    rc_statistics_record_upgrade(
        ref mut statistics,
        ref weak,
        is_some(result)
    );

    give statistics.upgrades == 0
        and statistics.upgrade_failures == 1
        and statistics.failures == 1;
}

proc run_weak_tests() -> bool {
    give test_downgrade()
        and test_try_downgrade()

        and test_weak_clone()
        and test_weak_try_clone()

        and test_upgrade()
        and test_upgrade_point()
        and test_upgrade_increments_strong()
        and test_upgrade_does_not_change_weak()

        and test_weak_ptr_matches_strong()
        and test_multiple_weak()

        and test_drop_weak()
        and test_drop_one_of_many_weak()
        and test_drop_all_weak()
        and test_double_weak_drop_fails()

        and test_weak_alive_before_strong_drop()
        and test_weak_expires_after_strong_drop()
        and test_upgrade_expired_fails()

        and test_weak_profile_alive()
        and test_weak_profile_expired()

        and test_weak_validation()
        and test_weak_invariant()

        and test_weak_snapshot_equal()
        and test_weak_snapshot_clone_changed()
        and test_weak_delta_clone()
        and test_weak_delta_upgrade()

        and test_weak_raw_conversion()
        and test_weak_from_raw()
        and test_weak_clone_raw_identity()

        and test_weak_with_multiple_strong()
        and test_weak_stays_alive_until_final_strong_drop()
        and test_upgrade_then_drop_copy()

        and test_upgrade_many_times()
        and test_clone_drop_weak_stress()
        and test_weak_clone_stress()
        and test_weak_snapshot_stress()
        and test_weak_validation_stress()

        and test_many_weak_refs()
        and test_many_weak_drop_all()
        and test_many_expired_weak()

        and test_statistics_empty()
        and test_statistics_downgrade()
        and test_statistics_weak_clone()
        and test_statistics_weak_drop()
        and test_statistics_upgrade()
        and test_statistics_upgrade_failure();
}

proc main() -> int {
    if run_weak_tests() {
        give 0;
    }

    give 1;
}
