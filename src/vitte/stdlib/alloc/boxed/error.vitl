    value: boxed.Box<T>
) -> BoxError {
    give box_error(
        BoxErrorKind.WriteAfterMove,
        BoxErrorSeverity.Fatal,
        BoxErrorDomain.Access,
        box_error_context_from_box(
            value,
            BoxErrorOperation.Write
        ),
        "cannot write a moved box"
