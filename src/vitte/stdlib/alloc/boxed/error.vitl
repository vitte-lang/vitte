// -----------------------------------------------------------------------------
// Runtime / internal
// -----------------------------------------------------------------------------

proc box_error_runtime(
    message: string
) -> BoxError {
    give box_error(
        BoxErrorKind.RuntimeFailure,
        BoxErrorSeverity.Fatal,
        BoxErrorDomain.Runtime,
        box_error_context_empty(),
        message
    );
}

proc box_error_internal(
    message: string
) -> BoxError {
    give box_error(
        BoxErrorKind.Internal,
        BoxErrorSeverity.Fatal,
        BoxErrorDomain.Internal,
        box_error_context_empty(),
        message
    );
}

// -----------------------------------------------------------------------------
// From validation
// -----------------------------------------------------------------------------

proc box_error_from_validation<T>(
    value: boxed.Box<T>,
    validation: boxed.BoxValidation
) -> BoxError {
    if validation.valid {
        give box_error_none();
    }

    if not validation.pointer_valid {
        give box_error_invalid_pointer(
            value
        );
    }

    if not validation.layout_valid {
        give box_error_invalid_layout(
            value.allocation.layout.size,
            value.allocation.layout.align
        );
    }

    if not validation.allocation_valid {
        give box_error_invalid_allocation(
            value
        );
    }

    if not validation.ownership_valid {
        give box_error_invalid_ownership(
            value
        );
    }

    if not validation.state_valid {
        give box_error_invalid_state(
            value
        );
    }

    give box_error_internal(
        "unknown box validation failure"
    );
}

proc box_error_from_core_validation(
    profile: box_core.BoxCoreProfile,
    validation: box_core.BoxCoreValidation
) -> BoxError {
    if validation.valid {
        give box_error_none();
    }

    if not validation.layout_valid {
        give box_error_invalid_layout(
            profile.meta.layout.size,
            profile.meta.layout.align
        );
    }

    if not validation.state_valid {
        give box_error_simple(
            BoxErrorKind.InvalidState,
            "box core state is invalid"
        );
    }

    if not validation.ownership_valid {
        give box_error_simple(
            BoxErrorKind.InvalidOwnership,
            "box core ownership is invalid"
        );
    }

    if not validation.access_valid {
        give box_error_simple(
            BoxErrorKind.InvalidState,
            "box core access state is invalid"
        );
    }

    give box_error_internal(
        "unknown box core validation failure"
    );
}

// -----------------------------------------------------------------------------
// Access checking
// -----------------------------------------------------------------------------

proc box_error_for_read<T>(
    value: boxed.Box<T>
) -> BoxError {
    pick value.state {
        boxed.BoxState.Valid {
            give box_error_none();
        }

        boxed.BoxState.Moved {
            give box_error_read_after_move(
                value
            );
        }

        boxed.BoxState.Released {
            give box_error_read_after_release(
                value
            );
        }

        boxed.BoxState.Invalid {
            give box_error_invalid_box(
                value
            );
        }
    }

    give box_error_invalid_box(
        value
    );
}

proc box_error_for_write<T>(
    value: boxed.Box<T>
) -> BoxError {
    pick value.state {
        boxed.BoxState.Valid {
            give box_error_none();
        }

        boxed.BoxState.Moved {
            give box_error_write_after_move(
                value
            );
        }

        boxed.BoxState.Released {
            give box_error_write_after_release(
                value
            );
        }

        boxed.BoxState.Invalid {
            give box_error_invalid_box(
                value
            );
        }
    }

    give box_error_invalid_box(
        value
    );
}

proc box_error_for_move<T>(
    value: boxed.Box<T>
) -> BoxError {
    pick value.state {
        boxed.BoxState.Valid {
            give box_error_none();
        }

        boxed.BoxState.Moved {
            give box_error_already_moved(
                value
            );
        }

        boxed.BoxState.Released {
            give box_error_already_released(
                value
            );
        }

        boxed.BoxState.Invalid {
            give box_error_invalid_box(
                value
            );
        }
    }

    give box_error_move_failed(
        value
    );
}

proc box_error_for_drop<T>(
    value: boxed.Box<T>
) -> BoxError {
    pick value.state {
        boxed.BoxState.Valid {
            give box_error_none();
        }

        boxed.BoxState.Moved {
            give box_error_already_moved(
                value
            );
        }

        boxed.BoxState.Released {
            give box_error_already_released(
                value
            );
        }

        boxed.BoxState.Invalid {
            give box_error_invalid_box(
                value
            );
        }
    }

    give box_error_drop_failed(
        value
    );
}

// -----------------------------------------------------------------------------
// Predicates
// -----------------------------------------------------------------------------

proc box_error_is_none(
    error: BoxError
) -> bool {
    give error.kind
        == BoxErrorKind.None;
}

proc box_error_is_error(
    error: BoxError
) -> bool {
    give error.severity
        == BoxErrorSeverity.Error
        or error.severity
            == BoxErrorSeverity.Fatal;
}

proc box_error_is_fatal(
    error: BoxError
) -> bool {
    give error.severity
        == BoxErrorSeverity.Fatal;
}

proc box_error_is_warning(
    error: BoxError
) -> bool {
    give error.severity
        == BoxErrorSeverity.Warning;
}

proc box_error_is_ownership(
    error: BoxError
) -> bool {
    give error.domain
        == BoxErrorDomain.Ownership;
}

proc box_error_is_allocation(
    error: BoxError
) -> bool {
    give error.domain
        == BoxErrorDomain.Allocation;
}

proc box_error_is_access(
    error: BoxError
) -> bool {
    give error.domain
        == BoxErrorDomain.Access;
}

proc box_error_is_move(
    error: BoxError
) -> bool {
    give error.domain
        == BoxErrorDomain.Move;
}

proc box_error_is_drop(
    error: BoxError
) -> bool {
    give error.domain
        == BoxErrorDomain.Drop;
}

proc box_error_is_raw(
    error: BoxError
) -> bool {
    give error.domain
        == BoxErrorDomain.Raw;
}

// -----------------------------------------------------------------------------
// Domain mapping
// -----------------------------------------------------------------------------

proc box_error_domain_for_kind(
    kind: BoxErrorKind
) -> BoxErrorDomain {
    pick kind {
        BoxErrorKind.None {
            give BoxErrorDomain.General;
        }

        BoxErrorKind.InvalidBox
        | BoxErrorKind.InvalidState
        | BoxErrorKind.InvalidOwnership {
            give BoxErrorDomain.Ownership;
        }

        BoxErrorKind.InvalidAllocation
        | BoxErrorKind.InvalidPointer
        | BoxErrorKind.InvalidLayout
        | BoxErrorKind.InvalidSize
        | BoxErrorKind.InvalidAlignment
        | BoxErrorKind.AllocationFailed
        | BoxErrorKind.OutOfMemory
        | BoxErrorKind.Overflow {
            give BoxErrorDomain.Allocation;
        }

        BoxErrorKind.ReadAfterMove
        | BoxErrorKind.WriteAfterMove
        | BoxErrorKind.ReadAfterRelease
        | BoxErrorKind.WriteAfterRelease {
            give BoxErrorDomain.Access;
        }

        BoxErrorKind.AlreadyMoved
        | BoxErrorKind.MoveFailed {
            give BoxErrorDomain.Move;
        }

        BoxErrorKind.AlreadyReleased
        | BoxErrorKind.DropFailed
        | BoxErrorKind.DeallocationFailed {
            give BoxErrorDomain.Drop;
        }

        BoxErrorKind.RawConversionFailed
        | BoxErrorKind.RawOwnershipViolation {
            give BoxErrorDomain.Raw;
        }

        BoxErrorKind.RuntimeFailure {
            give BoxErrorDomain.Runtime;
        }

        BoxErrorKind.Internal {
            give BoxErrorDomain.Internal;
        }
    }

    give BoxErrorDomain.Internal;
}

// -----------------------------------------------------------------------------
// Statistics
// -----------------------------------------------------------------------------

proc box_error_statistics_empty()
    -> BoxErrorStatistics
{
    give BoxErrorStatistics {
        total: 0,

        notes: 0,
        warnings: 0,
        errors: 0,
        fatals: 0,

        ownership: 0,
        allocation: 0,
        access: 0,
        move_errors: 0,
        drop_errors: 0,
        raw_errors: 0,
        runtime: 0,
        internal: 0
    };
}

proc box_error_statistics_record(
    statistics: ref mut BoxErrorStatistics,
    error: BoxError
) {
    if box_error_is_none(
        error
    ) {
        give;
    }

    set statistics.total =
        statistics.total + 1;

    pick error.severity {
        BoxErrorSeverity.Note {
            set statistics.notes =
                statistics.notes + 1;
        }

        BoxErrorSeverity.Warning {
            set statistics.warnings =
                statistics.warnings + 1;
        }

        BoxErrorSeverity.Error {
            set statistics.errors =
                statistics.errors + 1;
        }

        BoxErrorSeverity.Fatal {
            set statistics.fatals =
                statistics.fatals + 1;
        }
    }

    pick error.domain {
        BoxErrorDomain.Ownership {
            set statistics.ownership =
                statistics.ownership + 1;
        }

        BoxErrorDomain.Allocation {
            set statistics.allocation =
                statistics.allocation + 1;
        }

        BoxErrorDomain.Access {
            set statistics.access =
                statistics.access + 1;
        }

        BoxErrorDomain.Move {
            set statistics.move_errors =
                statistics.move_errors + 1;
        }

        BoxErrorDomain.Drop {
            set statistics.drop_errors =
                statistics.drop_errors + 1;
        }

        BoxErrorDomain.Raw {
            set statistics.raw_errors =
                statistics.raw_errors + 1;
        }

        BoxErrorDomain.Runtime {
            set statistics.runtime =
                statistics.runtime + 1;
        }

        BoxErrorDomain.Internal {
            set statistics.internal =
                statistics.internal + 1;
        }

        BoxErrorDomain.General {}
    }
}

proc box_error_statistics_reset(
    statistics: ref mut BoxErrorStatistics
) {
    set *statistics =
        box_error_statistics_empty();
}

// -----------------------------------------------------------------------------
// Names
// -----------------------------------------------------------------------------

proc box_error_kind_name(
    kind: BoxErrorKind
) -> string {
    pick kind {
        BoxErrorKind.None {
            give "none";
        }

        BoxErrorKind.InvalidBox {
            give "invalid-box";
        }

        BoxErrorKind.InvalidState {
            give "invalid-state";
        }

        BoxErrorKind.InvalidOwnership {
            give "invalid-ownership";
        }

        BoxErrorKind.InvalidAllocation {
            give "invalid-allocation";
        }

        BoxErrorKind.InvalidPointer {
            give "invalid-pointer";
        }

        BoxErrorKind.InvalidLayout {
            give "invalid-layout";
        }

        BoxErrorKind.InvalidSize {
            give "invalid-size";
        }

        BoxErrorKind.InvalidAlignment {
            give "invalid-alignment";
        }

        BoxErrorKind.AllocationFailed {
            give "allocation-failed";
        }

        BoxErrorKind.OutOfMemory {
            give "out-of-memory";
        }

        BoxErrorKind.Overflow {
            give "overflow";
        }

        BoxErrorKind.AlreadyMoved {
            give "already-moved";
        }

        BoxErrorKind.AlreadyReleased {
            give "already-released";
        }

        BoxErrorKind.MoveFailed {
            give "move-failed";
        }

        BoxErrorKind.ReadAfterMove {
            give "read-after-move";
        }

        BoxErrorKind.WriteAfterMove {
            give "write-after-move";
        }

        BoxErrorKind.ReadAfterRelease {
            give "read-after-release";
        }

        BoxErrorKind.WriteAfterRelease {
            give "write-after-release";
        }

        BoxErrorKind.DropFailed {
            give "drop-failed";
        }

        BoxErrorKind.DeallocationFailed {
            give "deallocation-failed";
        }

        BoxErrorKind.RawConversionFailed {
            give "raw-conversion-failed";
        }

        BoxErrorKind.RawOwnershipViolation {
            give "raw-ownership-violation";
        }

        BoxErrorKind.RuntimeFailure {
            give "runtime-failure";
        }

        BoxErrorKind.Internal {
            give "internal";
        }
    }

    give "internal";
}

proc box_error_severity_name(
    severity: BoxErrorSeverity
) -> string {
    pick severity {
        BoxErrorSeverity.Note {
            give "note";
        }

        BoxErrorSeverity.Warning {
            give "warning";
        }

        BoxErrorSeverity.Error {
            give "error";
        }

        BoxErrorSeverity.Fatal {
            give "fatal";
        }
    }

    give "error";
}

proc box_error_domain_name(
    domain: BoxErrorDomain
) -> string {
    pick domain {
        BoxErrorDomain.General {
            give "general";
        }

        BoxErrorDomain.Ownership {
            give "ownership";
        }

        BoxErrorDomain.Allocation {
            give "allocation";
        }

        BoxErrorDomain.Access {
            give "access";
        }

        BoxErrorDomain.Move {
            give "move";
        }

        BoxErrorDomain.Drop {
            give "drop";
        }

        BoxErrorDomain.Raw {
            give "raw";
        }

        BoxErrorDomain.Runtime {
            give "runtime";
        }

        BoxErrorDomain.Internal {
            give "internal";
        }
    }

    give "internal";
}

proc box_error_operation_name(
    operation: BoxErrorOperation
) -> string {
    pick operation {
        BoxErrorOperation.None {
            give "none";
        }

        BoxErrorOperation.New {
            give "new";
        }

        BoxErrorOperation.Allocate {
            give "allocate";
        }

        BoxErrorOperation.Read {
            give "read";
        }

        BoxErrorOperation.Write {
            give "write";
        }

        BoxErrorOperation.Replace {
            give "replace";
        }

        BoxErrorOperation.Move {
            give "move";
        }

        BoxErrorOperation.IntoInner {
            give "into-inner";
        }

        BoxErrorOperation.Drop {
            give "drop";
        }

        BoxErrorOperation.Release {
            give "release";
        }

        BoxErrorOperation.IntoRaw {
            give "into-raw";
        }

        BoxErrorOperation.FromRaw {
            give "from-raw";
        }

        BoxErrorOperation.Validate {
            give "validate";
        }
    }

    give "none";
}

// -----------------------------------------------------------------------------
// Error model
// -----------------------------------------------------------------------------
//
// Box errors are grouped by subsystem:
//
//     ownership
//         invalid box
//         moved value
//         released value
//
//     allocation
//         invalid layout
//         invalid pointer
//         overflow
//         out of memory
//
//     access
//         read after move
//         write after move
//         read after release
//         write after release
//
//     move
//         duplicate move
//         move failure
//
//     drop
//         duplicate release
//         destructor failure
//         deallocation failure
//
//     raw
//         invalid ownership transfer
//         invalid reconstruction
//
// A Box must follow:
//
//     Valid
//       |
//       +-- read/write
//       +-- move ------> Moved
//       +-- drop ------> Released
//
// Moved and Released states cannot be dereferenced.
//
// Diagnostics rendering/localization should remain outside this module.
