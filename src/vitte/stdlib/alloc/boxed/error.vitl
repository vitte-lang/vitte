space vitte/stdlib/alloc/boxed/error

export *

use src/vitte/stdlib/alloc/boxed/boxed as boxed
use src/vitte/stdlib/alloc/boxed/core as box_core

pick BoxErrorKind {
    None,

    InvalidBox,
    InvalidState,
    InvalidOwnership,

    InvalidAllocation,
    InvalidPointer,
    InvalidLayout,
    InvalidSize,
    InvalidAlignment,

    AllocationFailed,
    OutOfMemory,
    Overflow,

    AlreadyMoved,
    AlreadyReleased,

    MoveFailed,
    ReadAfterMove,
    WriteAfterMove,

    ReadAfterRelease,
    WriteAfterRelease,

    DropFailed,
    DeallocationFailed,

    RawConversionFailed,
    RawOwnershipViolation,

    RuntimeFailure,
    Internal
}

pick BoxErrorSeverity {
    Note,
    Warning,
    Error,
    Fatal
}

pick BoxErrorDomain {
    General,
    Ownership,
    Allocation,
    Access,
    Move,
    Drop,
    Raw,
    Runtime,
    Internal
}

pick BoxErrorOperation {
    None,

    New,
    Allocate,
    Read,
    Write,
    Replace,
    Move,
    IntoInner,

    Drop,
    Release,

    IntoRaw,
    FromRaw,

    Validate
}

form BoxErrorContext {
    operation: BoxErrorOperation

    state: boxed.BoxState

    size: usize
    align: usize

    generation: u64
    revision: u64
}

form BoxError {
    kind: BoxErrorKind
    severity: BoxErrorSeverity
    domain: BoxErrorDomain

    context: BoxErrorContext

    message: string
}

form BoxErrorStatistics {
    total: u64

    notes: u64
    warnings: u64
    errors: u64
    fatals: u64

    ownership: u64
    allocation: u64
    access: u64
    move_errors: u64
    drop_errors: u64
    raw_errors: u64
    runtime: u64
    internal: u64
}

// -----------------------------------------------------------------------------
// Context
// -----------------------------------------------------------------------------

proc box_error_context_empty() -> BoxErrorContext {
    give BoxErrorContext {
        operation:
            BoxErrorOperation.None,

        state:
            boxed.BoxState.Invalid,

        size:
            0,

        align:
            0,

        generation:
            0,

        revision:
            0
    };
}

proc box_error_context(
    operation: BoxErrorOperation,
    state: boxed.BoxState,
    size: usize,
    align: usize,
    generation: u64,
    revision: u64
) -> BoxErrorContext {
    give BoxErrorContext {
        operation:
            operation,

        state:
            state,

        size:
            size,

        align:
            align,

        generation:
            generation,

        revision:
            revision
    };
}

proc box_error_context_from_box<T>(
    value: boxed.Box<T>,
    operation: BoxErrorOperation
) -> BoxErrorContext {
    give BoxErrorContext {
        operation:
            operation,

        state:
            value.state,

        size:
            value.allocation.layout.size,

        align:
            value.allocation.layout.align,

        generation:
            value.generation,

        revision:
            value.revision
    };
}

// -----------------------------------------------------------------------------
// Constructors
// -----------------------------------------------------------------------------

proc box_error(
    kind: BoxErrorKind,
    severity: BoxErrorSeverity,
    domain: BoxErrorDomain,
    context: BoxErrorContext,
    message: string
) -> BoxError {
    give BoxError {
        kind:
            kind,

        severity:
            severity,

        domain:
            domain,

        context:
            context,

        message:
            message
    };
}

proc box_error_none() -> BoxError {
    give box_error(
        BoxErrorKind.None,
        BoxErrorSeverity.Note,
        BoxErrorDomain.General,
        box_error_context_empty(),
        ""
    );
}

proc box_error_simple(
    kind: BoxErrorKind,
    message: string
) -> BoxError {
    give box_error(
        kind,
        BoxErrorSeverity.Error,
        box_error_domain_for_kind(kind),
        box_error_context_empty(),
        message
    );
}

proc box_error_fatal(
    kind: BoxErrorKind,
    message: string
) -> BoxError {
    give box_error(
        kind,
        BoxErrorSeverity.Fatal,
        box_error_domain_for_kind(kind),
        box_error_context_empty(),
        message
    );
}

// -----------------------------------------------------------------------------
// Ownership errors
// -----------------------------------------------------------------------------

proc box_error_invalid_box<T>(
    value: boxed.Box<T>
) -> BoxError {
    give box_error(
        BoxErrorKind.InvalidBox,
        BoxErrorSeverity.Fatal,
        BoxErrorDomain.Ownership,
        box_error_context_from_box(
            value,
            BoxErrorOperation.Validate
        ),
        "box is invalid"
    );
}

proc box_error_invalid_state<T>(
    value: boxed.Box<T>
) -> BoxError {
    give box_error(
        BoxErrorKind.InvalidState,
        BoxErrorSeverity.Error,
        BoxErrorDomain.Ownership,
        box_error_context_from_box(
            value,
            BoxErrorOperation.Validate
        ),
        "box state is invalid"
    );
}

proc box_error_invalid_ownership<T>(
    value: boxed.Box<T>
) -> BoxError {
    give box_error(
        BoxErrorKind.InvalidOwnership,
        BoxErrorSeverity.Fatal,
        BoxErrorDomain.Ownership,
        box_error_context_from_box(
            value,
            BoxErrorOperation.Validate
        ),
        "box ownership invariant is invalid"
    );
}

proc box_error_already_moved<T>(
    value: boxed.Box<T>
) -> BoxError {
    give box_error(
        BoxErrorKind.AlreadyMoved,
        BoxErrorSeverity.Error,
        BoxErrorDomain.Move,
        box_error_context_from_box(
            value,
            BoxErrorOperation.Move
        ),
        "box ownership was already moved"
    );
}

proc box_error_already_released<T>(
    value: boxed.Box<T>
) -> BoxError {
    give box_error(
        BoxErrorKind.AlreadyReleased,
        BoxErrorSeverity.Error,
        BoxErrorDomain.Drop,
        box_error_context_from_box(
            value,
            BoxErrorOperation.Release
        ),
        "box was already released"
    );
}

