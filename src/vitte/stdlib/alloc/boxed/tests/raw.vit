// -----------------------------------------------------------------------------
// Delta / revision / generation
// -----------------------------------------------------------------------------

proc test_raw_delta_touch() -> bool {
    let value = box_new(42);

    let raw_value = box_as_raw(
        ref value
    );

    let mut raw = raw_value;

    let before = box_raw_snapshot(
        raw
    );

    box_raw_touch(
        ref mut raw
    );

    let after = box_raw_snapshot(
        raw
    );

    let delta = box_raw_delta(
        before,
        after
    );

    give delta.changed
        and delta.revision > 0
        and not delta.state_changed
        and not delta.ownership_changed;
}

proc test_raw_delta_reconstruct() -> bool {
    let mut value = box_new(42);

    let result = box_into_raw(
        ref mut value
    );

    pick result {
        Some(raw_value) {
            let mut raw = raw_value;

            let before = box_raw_snapshot(
                raw
            );

            let reconstructed = box_raw_reconstruct(
                ref mut raw
            );

            if is_none(reconstructed) {
                give false;
            }

            let after = box_raw_snapshot(
                raw
            );

            let delta = box_raw_delta(
                before,
                after
            );

            give delta.changed
                and delta.state_changed
                and delta.ownership_changed
                and delta.revision > 0;
        }

        None {
            give false;
        }
    }
}

proc test_raw_delta_release() -> bool {
    let mut value = box_new(42);

    let result = box_into_raw(
        ref mut value
    );

    pick result {
        Some(raw_value) {
            let mut raw = raw_value;

            let before = box_raw_snapshot(
                raw
            );

            if not box_raw_release(
                ref mut raw
            ) {
                give false;
            }

            let after = box_raw_snapshot(
                raw
            );

            let delta = box_raw_delta(
                before,
                after
            );

            give delta.changed
                and delta.state_changed
                and delta.ownership_changed
                and delta.generation > 0
                and delta.revision > 0;
        }

        None {
            give false;
        }
    }
}

proc test_raw_generation_initial() -> bool {
    let value = box_new(42);

    let raw = box_as_raw(
        ref value
    );

    give box_raw_generation(raw) >= 1;
}

proc test_raw_revision_initial() -> bool {
    let value = box_new(42);

    let raw = box_as_raw(
        ref value
    );

    give box_raw_revision(raw) >= 1;
}

proc test_raw_touch() -> bool {
    let value = box_new(42);

    let raw_value = box_as_raw(
        ref value
    );

    let mut raw = raw_value;

    let before = box_raw_revision(
        raw
    );

    box_raw_touch(
        ref mut raw
    );

    give box_raw_revision(raw) > before;
}

proc test_raw_advance_generation() -> bool {
    let value = box_new(42);

    let raw_value = box_as_raw(
        ref value
    );

    let mut raw = raw_value;

    let before = box_raw_generation(
        raw
    );

    let after = box_raw_advance_generation(
        ref mut raw
    );

    give after > before
        and box_raw_generation(raw) == after;
}

