proc test_into_raw_layout_preserved() -> bool {
    let mut value = box_new(42);

    let size = box_size(value);
    let align = box_align(value);

    let result = box_into_raw(
        ref mut value
    );

    pick result {
        Some(raw) {
            give box_raw_size(raw) == size
                and box_raw_align(raw) == align;
        }

