// -----------------------------------------------------------------------------
// Names
// -----------------------------------------------------------------------------

proc test_raw_state_names() -> bool {
    give box_raw_state_name(
        BoxRawState.Borrowed
    ) == "borrowed"
        and box_raw_state_name(
            BoxRawState.Owned
        ) == "owned"
        and box_raw_state_name(
            BoxRawState.Consumed
        ) == "consumed"
        and box_raw_state_name(
            BoxRawState.Released
        ) == "released"
        and box_raw_state_name(
            BoxRawState.Invalid
        ) == "invalid";
}

proc test_raw_ownership_names() -> bool {
    give box_raw_ownership_name(
        BoxRawOwnership.None
    ) == "none"
        and box_raw_ownership_name(
            BoxRawOwnership.Borrowed
        ) == "borrowed"
        and box_raw_ownership_name(
            BoxRawOwnership.Owned
        ) == "owned"
        and box_raw_ownership_name(
            BoxRawOwnership.Transferred
        ) == "transferred"
        and box_raw_ownership_name(
            BoxRawOwnership.Released
        ) == "released";
}

proc test_raw_kind_names() -> bool {
    give box_raw_kind_name(
        BoxRawKind.Shared
    ) == "shared"
        and box_raw_kind_name(
            BoxRawKind.Mutable
        ) == "mutable"
        and box_raw_kind_name(
            BoxRawKind.Owned
        ) == "owned";
}

proc test_raw_failure_names() -> bool {
    give box_raw_failure_name(
        BoxRawFailure.None
    ) == "none"
        and box_raw_failure_name(
            BoxRawFailure.InvalidBox
        ) == "invalid-box"
        and box_raw_failure_name(
            BoxRawFailure.InvalidPointer
        ) == "invalid-pointer"
        and box_raw_failure_name(
            BoxRawFailure.InvalidLayout
        ) == "invalid-layout"
        and box_raw_failure_name(
            BoxRawFailure.InvalidOwnership
        ) == "invalid-ownership"
        and box_raw_failure_name(
            BoxRawFailure.AlreadyConsumed
        ) == "already-consumed"
        and box_raw_failure_name(
            BoxRawFailure.AlreadyReleased
        ) == "already-released"
        and box_raw_failure_name(
            BoxRawFailure.ReconstructionFailed
        ) == "reconstruction-failed"
        and box_raw_failure_name(
            BoxRawFailure.ReleaseFailed
        ) == "release-failed";
}

// -----------------------------------------------------------------------------
// Statistics
// -----------------------------------------------------------------------------

proc test_raw_statistics_empty() -> bool {
    let statistics = box_raw_statistics_empty();

    give statistics.borrowed_views == 0
        and statistics.mutable_views == 0
        and statistics.ownership_transfers == 0
        and statistics.reconstructions == 0
        and statistics.reconstruction_failures == 0
        and statistics.releases == 0
        and statistics.release_failures == 0
        and statistics.validations == 0;
}

proc test_raw_statistics_total_empty() -> bool {
    let statistics = box_raw_statistics_empty();

    give box_raw_statistics_total(
        statistics
    ) == 0;
}

proc test_raw_statistics_reset() -> bool {
    let mut statistics = box_raw_statistics_empty();

    set statistics.borrowed_views = 10;
    set statistics.ownership_transfers = 5;
    set statistics.reconstructions = 2;

    box_raw_statistics_reset(
        ref mut statistics
    );

    give statistics.borrowed_views == 0
        and statistics.ownership_transfers == 0
        and statistics.reconstructions == 0;
}

// -----------------------------------------------------------------------------
// Multiple boxes / independence
// -----------------------------------------------------------------------------

proc test_multiple_raw_borrowed_independent() -> bool {
    let first = box_new(1);
    let second = box_new(2);
    let third = box_new(3);

    let first_raw = box_as_raw(
        ref first
    );

    let second_raw = box_as_raw(
        ref second
    );

    let third_raw = box_as_raw(
        ref third
    );

    give box_raw_ptr_ne(
        first_raw,
        second_raw
    )
    and box_raw_ptr_ne(
        second_raw,
        third_raw
    )
    and box_raw_ptr_ne(
        first_raw,
        third_raw
    );
}

proc test_multiple_raw_values() -> bool {
    let first = box_new(10);
    let second = box_new(20);
    let third = box_new(30);

    let first_raw = box_as_raw(
        ref first
    );

    let second_raw = box_as_raw(
        ref second
    );

    let third_raw = box_as_raw(
        ref third
    );

    let a = box_raw_as_ref(first_raw);
    let b = box_raw_as_ref(second_raw);
    let c = box_raw_as_ref(third_raw);

    pick a {
        Some(av) {
            pick b {
                Some(bv) {
                    pick c {
                        Some(cv) {
                            give *av == 10
                                and *bv == 20
                                and *cv == 30;
                        }

                        None {
                            give false;
                        }
                    }
                }

                None {
                    give false;
                }
            }
        }

        None {
            give false;
        }
    }
}

proc test_raw_mutation_independence() -> bool {
    let mut first = box_new(1);
    let mut second = box_new(2);

    let first_raw_value = box_as_raw_mut(
        ref mut first
    );

    let mut first_raw = first_raw_value;

    let first_inner = box_raw_as_mut(
        ref mut first_raw
    );

    pick first_inner {
        Some(value) {
            set *value = 100;
        }

        None {
            give false;
        }
    }

    give *box_get(ref first) == 100
        and *box_get(ref second) == 2;
}

// -----------------------------------------------------------------------------
// Reconstruction / clone independence
// -----------------------------------------------------------------------------

proc test_reconstruct_then_mutate() -> bool {
    let mut original = box_new(
        Point {
            x: 1
            y: 2
        }
    );

    let raw_result = box_into_raw(
        ref mut original
    );

    pick raw_result {
        Some(raw_value) {
            let mut raw = raw_value;

            let result = box_raw_reconstruct(
                ref mut raw
            );

            pick result {
                Some(boxed_value) {
                    let mut restored = boxed_value;

                    let point = box_get_mut(
                        ref mut restored
                    );

                    set point.x = 100;

                    give box_get(ref restored).x == 100
                        and box_raw_is_consumed(raw);
                }

                None {
                    give false;
                }
            }
        }

        None {
            give false;
        }
    }
}

proc test_clone_raw_identity_separate() -> bool {
    let first = box_new(
        Point {
            x: 1
            y: 2
        }
    );

    let second = box_clone(
        ref first
    );

    let left = box_as_raw(
        ref first
    );

    let right = box_as_raw(
        ref second
    );

    give box_raw_ptr_ne(
        left,
        right
    );
}

// -----------------------------------------------------------------------------
// Stress borrowed
// -----------------------------------------------------------------------------

proc test_stress_borrowed_views() -> bool {
    let value = box_new(42);

    let index: usize = 0;

    while index < 10000 {
        let raw = box_as_raw(
            ref value
        );

        if not box_raw_is_valid(raw) {
            give false;
        }

        let result = box_raw_as_ref(raw);

        pick result {
            Some(inner) {
                if *inner != 42 {
                    give false;
                }
            }

            None {
                give false;
            }
        }

        set index = index + 1;
    }

    give box_is_valid(value);
}

proc test_stress_mutable_views() -> bool {
    let mut value = box_new(0);

    let index: int = 0;

    while index < 5000 {
        let raw_value = box_as_raw_mut(
            ref mut value
        );

        let mut raw = raw_value;

        let result = box_raw_as_mut(
            ref mut raw
        );

        pick result {
            Some(inner) {
                set *inner = index;
            }

            None {
                give false;
            }
        }

        if *box_get(ref value) != index {
            give false;
        }

        set index = index + 1;
    }

    give box_is_valid(value);
}

// -----------------------------------------------------------------------------
// Stress ownership transfer
// -----------------------------------------------------------------------------

proc test_stress_into_raw_reconstruct() -> bool {
    let index: int = 0;

    while index < 5000 {
        let mut value = box_new(index);

        let raw_result = box_into_raw(
            ref mut value
        );

        pick raw_result {
            Some(raw_value) {
                let mut raw = raw_value;

                let reconstructed =
                    box_raw_reconstruct(
                        ref mut raw
                    );

                pick reconstructed {
                    Some(restored) {
                        if *box_get(ref restored)
                            != index
                        {
                            give false;
                        }

                        if not box_raw_is_consumed(
                            raw
                        ) {
                            give false;
                        }
                    }

                    None {
                        give false;
                    }
                }
            }

            None {
                give false;
            }
        }

        set index = index + 1;
    }

    give true;
}

proc test_stress_into_raw_release() -> bool {
    let index: usize = 0;

    while index < 5000 {
        let mut value = box_new(42);

        let raw_result = box_into_raw(
            ref mut value
        );

        pick raw_result {
            Some(raw_value) {
                let mut raw = raw_value;

                if not box_raw_release(
                    ref mut raw
                ) {
                    give false;
                }

                if not box_raw_is_released(
                    raw
                ) {
                    give false;
                }
            }

            None {
                give false;
            }
        }

        set index = index + 1;
    }

    give true;
}

proc test_stress_raw_mutate_reconstruct() -> bool {
    let index: int = 0;

    while index < 3000 {
        let mut value = box_new(index);

        let raw_result = box_into_raw(
            ref mut value
        );

        pick raw_result {
            Some(raw_value) {
                let mut raw = raw_value;

                let inner = box_raw_as_mut(
                    ref mut raw
                );

                pick inner {
                    Some(data) {
                        set *data = index + 1;
                    }

                    None {
                        give false;
                    }
                }

                let restored =
                    box_raw_reconstruct(
                        ref mut raw
                    );

                pick restored {
                    Some(boxed_value) {
                        if *box_get(
                            ref boxed_value
                        ) != index + 1
                        {
                            give false;
                        }
                    }

                    None {
                        give false;
                    }
                }
            }

            None {
                give false;
            }
        }

        set index = index + 1;
    }

    give true;
}

proc test_stress_point_reconstruct() -> bool {
    let index: int = 0;

    while index < 2000 {
        let mut value = box_new(
            Point {
                x: index
                y: index + 1
            }
        );

        let raw_result = box_into_raw(
            ref mut value
        );

        pick raw_result {
            Some(raw_value) {
                let mut raw = raw_value;

                let restored =
                    box_raw_reconstruct(
                        ref mut raw
                    );

                pick restored {
                    Some(boxed_value) {
                        let point = box_get(
                            ref boxed_value
                        );

                        if point.x != index
                            or point.y != index + 1
                        {
                            give false;
                        }
                    }

                    None {
                        give false;
                    }
                }
            }

            None {
                give false;
            }
        }

        set index = index + 1;
    }

    give true;
}

// -----------------------------------------------------------------------------
// Stress snapshot / revision
// -----------------------------------------------------------------------------

proc test_stress_raw_touch() -> bool {
    let value = box_new(42);

    let raw_value = box_as_raw(
        ref value
    );

    let mut raw = raw_value;

    let previous = box_raw_revision(
        raw
    );

    let index: usize = 0;

    while index < 5000 {
        box_raw_touch(
            ref mut raw
        );

        let current =
            box_raw_revision(raw);

        if current <= previous {
            give false;
        }

        set previous = current;
        set index = index + 1;
    }

    give true;
}

proc test_stress_raw_generation() -> bool {
    let value = box_new(42);

    let raw_value = box_as_raw(
        ref value
    );

    let mut raw = raw_value;

    let previous =
        box_raw_generation(raw);

    let index: usize = 0;

    while index < 1000 {
        let current =
            box_raw_advance_generation(
                ref mut raw
            );

        if current <= previous {
            give false;
        }

        set previous = current;
        set index = index + 1;
    }

    give true;
}

proc test_stress_validation() -> bool {
    let value = box_new(42);

    let index: usize = 0;

    while index < 5000 {
        let raw = box_as_raw(
            ref value
        );

        if not box_raw_validate(raw).valid {
            give false;
        }

        if not box_raw_invariant_holds(raw) {
            give false;
        }

        set index = index + 1;
    }

    give true;
}

proc test_stress_profiles() -> bool {
    let value = box_new(42);

    let index: usize = 0;

    while index < 5000 {
        let raw = box_as_raw(
            ref value
        );

        let profile = box_raw_profile(
            raw
        );

        if not profile.valid
            or not profile.borrowed
            or not profile.readable
        {
            give false;
        }

        set index = index + 1;
    }

    give true;
}

// -----------------------------------------------------------------------------
// Mixed lifecycle stress
// -----------------------------------------------------------------------------

proc test_stress_mixed_raw_lifecycle() -> bool {
    let index: usize = 0;

    while index < 3000 {
        let mut value = box_new(42);

        if index % 2 == 0 {
            let raw_result = box_into_raw(
                ref mut value
            );

            pick raw_result {
                Some(raw_value) {
                    let mut raw = raw_value;

                    let restored =
                        box_raw_reconstruct(
                            ref mut raw
                        );

                    if is_none(restored) {
                        give false;
                    }

                    if not box_raw_is_consumed(raw) {
                        give false;
                    }
                }

                None {
                    give false;
                }
            }
        } else {
            let raw_result = box_into_raw(
                ref mut value
            );

            pick raw_result {
                Some(raw_value) {
                    let mut raw = raw_value;

                    if not box_raw_release(
                        ref mut raw
                    ) {
                        give false;
                    }

                    if not box_raw_is_released(raw) {
                        give false;
                    }
                }

                None {
                    give false;
                }
            }
        }

        set index = index + 1;
    }

    give true;
}

proc test_stress_multiple_raw_boxes() -> bool {
    let index: int = 0;

    while index < 3000 {
        let first = box_new(index);
        let second = box_new(index + 1);

        let first_raw = box_as_raw(
            ref first
        );

        let second_raw = box_as_raw(
            ref second
        );

        if not box_raw_ptr_ne(
            first_raw,
            second_raw
        ) {
            give false;
        }

        let a = box_raw_as_ref(
            first_raw
        );

        let b = box_raw_as_ref(
            second_raw
        );

        pick a {
            Some(av) {
                pick b {
                    Some(bv) {
                        if *av != index
                            or *bv != index + 1
                        {
                            give false;
                        }
                    }

                    None {
                        give false;
                    }
                }
            }

            None {
                give false;
            }
        }

        set index = index + 1;
    }

    give true;
}

// -----------------------------------------------------------------------------
// Full suite
// -----------------------------------------------------------------------------

proc run_raw_tests() -> bool {
    give test_as_raw_basic()
        and test_as_raw_int_read()
        and test_as_raw_negative_int()
        and test_as_raw_bool()
        and test_as_raw_string()
        and test_as_raw_point()
        and test_as_raw_user()
        and test_borrowed_keeps_box_alive()
        and test_borrowed_layout()
        and test_borrowed_kind_shared()
        and test_borrowed_ownership()
        and test_borrowed_state()

        and test_as_raw_mut_basic()
        and test_as_raw_mut_write_int()
        and test_as_raw_mut_write_point()
        and test_as_raw_mut_write_user()
        and test_shared_raw_not_writable()
        and test_mut_raw_writable()

        and test_into_raw_basic()
        and test_into_raw_state()
        and test_into_raw_ownership()
        and test_into_raw_kind()
        and test_into_raw_preserves_value()
        and test_into_raw_preserves_string()
        and test_into_raw_preserves_point()
        and test_into_raw_layout_preserved()

        and test_owned_raw_mutate()
        and test_owned_raw_mutate_point()

        and test_from_raw()
        and test_from_raw_string()
        and test_from_raw_point()
        and test_raw_reconstruct()
        and test_raw_reconstruct_point()
        and test_raw_reconstruct_once()
        and test_consumed_raw_cannot_read()
        and test_consumed_raw_cannot_write()
        and test_consumed_raw_cannot_reconstruct()

        and test_borrowed_cannot_reconstruct()
        and test_mut_borrowed_cannot_reconstruct()

        and test_raw_release()
        and test_raw_release_string()
        and test_raw_release_point()
        and test_raw_release_once()
        and test_borrowed_cannot_release()
        and test_mut_borrowed_cannot_release()

        and test_raw_forget()
        and test_borrowed_raw_forget_fails()
        and test_raw_forget_once()

        and test_raw_ptr_eq_same_box()
        and test_raw_ptr_ne_different_boxes()
        and test_raw_ptr_eq_mut_and_shared_same_box()
        and test_clone_has_different_raw_pointer()
        and test_move_raw_identity()
        and test_reconstruct_identity()

        and test_raw_validation_borrowed()
        and test_raw_validation_mut_borrowed()
        and test_raw_validation_owned()
        and test_raw_validation_consumed()
        and test_raw_validation_released()
        and test_raw_invariant_borrowed()
        and test_raw_invariant_owned()

        and test_raw_profile_borrowed()
        and test_raw_profile_mutable()
        and test_raw_profile_owned()
        and test_raw_profile_consumed()
        and test_raw_profile_released()
        and test_profile_validation()

        and test_raw_snapshot_equal()
        and test_raw_snapshot_touch_changes()
        and test_raw_snapshot_reconstruct_changes()
        and test_raw_snapshot_release_changes()

        and test_raw_delta_touch()
        and test_raw_delta_reconstruct()
        and test_raw_delta_release()

        and test_raw_generation_initial()
        and test_raw_revision_initial()
        and test_raw_touch()
        and test_raw_advance_generation()

        and test_raw_error_borrowed_none()
        and test_raw_error_owned_none()

        and test_raw_core_state_borrowed()
        and test_raw_core_state_owned()
        and test_raw_core_state_consumed()
        and test_raw_core_state_released()

        and test_raw_state_names()
        and test_raw_ownership_names()
        and test_raw_kind_names()
        and test_raw_failure_names()

        and test_raw_statistics_empty()
        and test_raw_statistics_total_empty()
        and test_raw_statistics_reset()

        and test_multiple_raw_borrowed_independent()
        and test_multiple_raw_values()
        and test_raw_mutation_independence()
        and test_reconstruct_then_mutate()
        and test_clone_raw_identity_separate()

        and test_stress_borrowed_views()
        and test_stress_mutable_views()
        and test_stress_into_raw_reconstruct()
        and test_stress_into_raw_release()
        and test_stress_raw_mutate_reconstruct()
        and test_stress_point_reconstruct()
        and test_stress_raw_touch()
        and test_stress_raw_generation()
        and test_stress_validation()
        and test_stress_profiles()
        and test_stress_mixed_raw_lifecycle()
        and test_stress_multiple_raw_boxes();
}

proc main() -> int {
    if run_raw_tests() {
        give 0;
    }

    give 1;
}
