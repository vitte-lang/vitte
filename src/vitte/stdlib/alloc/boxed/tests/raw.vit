use src/vitte/stdlib/alloc/boxed
use src/vitte/stdlib/alloc/boxed/raw

form Point {
    x: int
    y: int
}

form User {
    id: int
    name: string
    active: bool
}

// -----------------------------------------------------------------------------
// Borrowed raw views
// -----------------------------------------------------------------------------

proc test_as_raw_basic() -> bool {
    let value = box_new(42);

    let raw = box_as_raw(
        ref value
    );

    give box_raw_is_borrowed(raw)
        and not box_raw_is_owned(raw)
        and not box_raw_is_consumed(raw)
        and not box_raw_is_released(raw)
        and box_raw_can_read(raw)
        and not box_raw_can_reconstruct(raw)
        and not box_raw_can_release(raw);
}

proc test_as_raw_int_read() -> bool {
    let value = box_new(42);

    let raw = box_as_raw(
        ref value
    );

    let result = box_raw_as_ref(raw);

    pick result {
        Some(inner) {
            give *inner == 42;
        }

        None {
            give false;
        }
    }
}

proc test_as_raw_negative_int() -> bool {
    let value = box_new(-42);

    let raw = box_as_raw(
        ref value
    );

    let result = box_raw_as_ref(raw);

    pick result {
        Some(inner) {
            give *inner == -42;
        }

        None {
            give false;
        }
    }
}

proc test_as_raw_bool() -> bool {
    let value = box_new(true);

    let raw = box_as_raw(
        ref value
    );

    let result = box_raw_as_ref(raw);

    pick result {
        Some(inner) {
            give *inner;
        }

        None {
            give false;
        }
    }
}

proc test_as_raw_string() -> bool {
    let value = box_new("Vitte");

    let raw = box_as_raw(
        ref value
    );

    let result = box_raw_as_ref(raw);

    pick result {
        Some(inner) {
            give *inner == "Vitte";
        }

        None {
            give false;
        }
    }
}

proc test_as_raw_point() -> bool {
    let value = box_new(
        Point {
            x: 10
            y: 20
        }
    );

    let raw = box_as_raw(
        ref value
    );

    let result = box_raw_as_ref(raw);

    pick result {
        Some(point) {
            give point.x == 10
                and point.y == 20;
        }

        None {
            give false;
        }
    }
}

proc test_as_raw_user() -> bool {
    let value = box_new(
        User {
            id: 7
            name: "Vincent"
            active: true
        }
    );

    let raw = box_as_raw(
        ref value
    );

    let result = box_raw_as_ref(raw);

    pick result {
        Some(user) {
            give user.id == 7
                and user.name == "Vincent"
                and user.active;
        }

        None {
            give false;
        }
    }
}

proc test_borrowed_keeps_box_alive() -> bool {
    let value = box_new(42);

    let raw = box_as_raw(
        ref value
    );

    give box_raw_is_valid(raw)
        and box_is_valid(value)
        and *box_get(ref value) == 42;
}

proc test_borrowed_layout() -> bool {
    let value = box_new(42);

    let raw = box_as_raw(
        ref value
    );

    give box_raw_size(raw) == box_size(value)
        and box_raw_align(raw) == box_align(value);
}

proc test_borrowed_kind_shared() -> bool {
    let value = box_new(42);

    let raw = box_as_raw(
        ref value
    );

    give box_raw_kind(raw)
        == BoxRawKind.Shared;
}

proc test_borrowed_ownership() -> bool {
    let value = box_new(42);

    let raw = box_as_raw(
        ref value
    );

    give box_raw_ownership(raw)
        == BoxRawOwnership.Borrowed;
}

proc test_borrowed_state() -> bool {
    let value = box_new(42);

    let raw = box_as_raw(
        ref value
    );

    give box_raw_state(raw)
        == BoxRawState.Borrowed;
}

// -----------------------------------------------------------------------------
// Mutable raw views
// -----------------------------------------------------------------------------

proc test_as_raw_mut_basic() -> bool {
    let mut value = box_new(42);

    let raw = box_as_raw_mut(
        ref mut value
    );

    give box_raw_is_borrowed(raw)
        and box_raw_kind(raw)
            == BoxRawKind.Mutable
        and box_raw_can_read(raw)
        and box_raw_can_write(raw)
        and not box_raw_can_reconstruct(raw);
}

proc test_as_raw_mut_write_int() -> bool {
    let mut value = box_new(10);

    let mut raw = box_as_raw_mut(
        ref mut value
    );

    let result = box_raw_as_mut(
        ref mut raw
    );

    pick result {
        Some(inner) {
            set *inner = 20;

            give *box_get(ref value) == 20;
        }

        None {
            give false;
        }
    }
}

proc test_as_raw_mut_write_point() -> bool {
    let mut value = box_new(
        Point {
            x: 1
            y: 2
        }
    );

    let mut raw = box_as_raw_mut(
        ref mut value
    );

    let result = box_raw_as_mut(
        ref mut raw
    );

    pick result {
        Some(point) {
            set point.x = 100;
            set point.y = 200;

            give box_get(ref value).x == 100
                and box_get(ref value).y == 200;
        }

        None {
            give false;
        }
    }
}

proc test_as_raw_mut_write_user() -> bool {
    let mut value = box_new(
        User {
            id: 1
            name: "before"
            active: false
        }
    );

    let mut raw = box_as_raw_mut(
        ref mut value
    );

    let result = box_raw_as_mut(
        ref mut raw
    );

    pick result {
        Some(user) {
            set user.id = 2;
            set user.name = "after";
            set user.active = true;

            let current = box_get(
                ref value
            );

            give current.id == 2
                and current.name == "after"
                and current.active;
        }

        None {
            give false;
        }
    }
}

proc test_shared_raw_not_writable() -> bool {
    let value = box_new(42);

    let raw = box_as_raw(
        ref value
    );

    give not box_raw_can_write(raw);
}

proc test_mut_raw_writable() -> bool {
    let mut value = box_new(42);

    let raw = box_as_raw_mut(
        ref mut value
    );

    give box_raw_can_write(raw);
}

// -----------------------------------------------------------------------------
// Owned raw transfer
// -----------------------------------------------------------------------------

proc test_into_raw_basic() -> bool {
    let mut value = box_new(42);

    let result = box_into_raw(
        ref mut value
    );

    pick result {
        Some(raw) {
            give box_is_moved(value)
                and box_raw_is_owned(raw)
                and box_raw_can_read(raw)
                and box_raw_can_write(raw)
                and box_raw_can_reconstruct(raw)
                and box_raw_can_release(raw);
        }

        None {
            give false;
        }
    }
}

proc test_into_raw_state() -> bool {
    let mut value = box_new(42);

    let result = box_into_raw(
        ref mut value
    );

    pick result {
        Some(raw) {
            give box_raw_state(raw)
                == BoxRawState.Owned;
        }

        None {
            give false;
        }
    }
}

proc test_into_raw_ownership() -> bool {
    let mut value = box_new(42);

    let result = box_into_raw(
        ref mut value
    );

    pick result {
        Some(raw) {
            give box_raw_ownership(raw)
                == BoxRawOwnership.Owned;
        }

        None {
            give false;
        }
    }
}

proc test_into_raw_kind() -> bool {
    let mut value = box_new(42);

    let result = box_into_raw(
        ref mut value
    );

    pick result {
        Some(raw) {
            give box_raw_kind(raw)
                == BoxRawKind.Owned;
        }

        None {
            give false;
        }
    }
}

proc test_into_raw_preserves_value() -> bool {
    let mut value = box_new(42);

    let result = box_into_raw(
        ref mut value
    );

    pick result {
        Some(raw) {
            let inner = box_raw_as_ref(raw);

            pick inner {
                Some(data) {
                    give *data == 42;
                }

                None {
                    give false;
                }
            }
        }

        None {
            give false;
        }
    }
}

proc test_into_raw_preserves_string() -> bool {
    let mut value = box_new("Vitte");

    let result = box_into_raw(
        ref mut value
    );

    pick result {
        Some(raw) {
            let inner = box_raw_as_ref(raw);

            pick inner {
                Some(data) {
                    give *data == "Vitte";
                }

                None {
                    give false;
                }
            }
        }

        None {
            give false;
        }
    }
}

proc test_into_raw_preserves_point() -> bool {
    let mut value = box_new(
        Point {
            x: 4
            y: 8
        }
    );

    let result = box_into_raw(
        ref mut value
    );

    pick result {
        Some(raw) {
            let inner = box_raw_as_ref(raw);

            pick inner {
                Some(point) {
                    give point.x == 4
                        and point.y == 8;
                }

                None {
                    give false;
                }
            }
