}

// -----------------------------------------------------------------------------
// Owned raw mutation
// -----------------------------------------------------------------------------

proc test_owned_raw_mutate() -> bool {
    let mut value = box_new(10);

    let result = box_into_raw(
        ref mut value
    );

    pick result {
        Some(raw_value) {
            let mut raw = raw_value;

            let inner = box_raw_as_mut(
                ref mut raw
            );

            pick inner {
                Some(data) {
                    set *data = 20;

                    let read = box_raw_as_ref(raw);

                    pick read {
                        Some(after) {
                            give *after == 20;
                        }

                        None {
                            give false;
                        }
                    }
                }

                None {
                    give false;
                }
            }
        }

        None {
            give false;
        }
    }
}

proc test_owned_raw_mutate_point() -> bool {
    let mut value = box_new(
        Point {
            x: 1
            y: 2
        }
    );

    let result = box_into_raw(
        ref mut value
    );

    pick result {
        Some(raw_value) {
            let mut raw = raw_value;

            let inner = box_raw_as_mut(
                ref mut raw
            );

            pick inner {
                Some(point) {
                    set point.x = 50;
                    set point.y = 60;

                    let read = box_raw_as_ref(raw);

                    pick read {
                        Some(after) {
                            give after.x == 50
                                and after.y == 60;
                        }

                        None {
                            give false;
                        }
                    }
                }

                None {
                    give false;
                }
            }
        }

        None {
            give false;
        }
    }
}

// -----------------------------------------------------------------------------
// Reconstruction
// -----------------------------------------------------------------------------

proc test_from_raw() -> bool {
    let mut value = box_new(42);

    let raw_result = box_into_raw(
        ref mut value
    );

    pick raw_result {
        Some(raw) {
            let reconstructed = box_from_raw(
                raw
            );

            pick reconstructed {
                Some(boxed_value) {
                    give *box_get(
                        ref boxed_value
                    ) == 42;
                }

                None {
                    give false;
                }
            }
        }

        None {
            give false;
        }
    }
}

proc test_from_raw_string() -> bool {
    let mut value = box_new("Vitte");

    let raw_result = box_into_raw(
        ref mut value
    );

    pick raw_result {
        Some(raw) {
            let reconstructed = box_from_raw(
                raw
            );

            pick reconstructed {
                Some(boxed_value) {
                    give *box_get(
                        ref boxed_value
                    ) == "Vitte";
                }

                None {
                    give false;
                }
            }
        }

        None {
            give false;
        }
    }
}

proc test_from_raw_point() -> bool {
    let mut value = box_new(
        Point {
            x: 10
            y: 20
        }
    );

    let raw_result = box_into_raw(
        ref mut value
    );

    pick raw_result {
        Some(raw) {
            let reconstructed = box_from_raw(
                raw
            );

            pick reconstructed {
                Some(boxed_value) {
                    let point = box_get(
                        ref boxed_value
                    );

                    give point.x == 10
                        and point.y == 20;
                }

                None {
                    give false;
                }
            }
        }

        None {
            give false;
        }
    }
}

proc test_raw_reconstruct() -> bool {
    let mut value = box_new(42);

    let raw_result = box_into_raw(
        ref mut value
    );

    pick raw_result {
        Some(raw_value) {
            let mut raw = raw_value;

            let reconstructed =
                box_raw_reconstruct(
                    ref mut raw
                );

            pick reconstructed {
                Some(boxed_value) {
                    give *box_get(
                        ref boxed_value
                    ) == 42
                        and box_raw_is_consumed(raw)
                        and not box_raw_can_read(raw)
                        and not box_raw_can_write(raw)
                        and not box_raw_can_reconstruct(raw)
                        and not box_raw_can_release(raw);
                }

                None {
                    give false;
                }
            }
        }

        None {
            give false;
        }
    }
}

proc test_raw_reconstruct_point() -> bool {
    let mut value = box_new(
        Point {
            x: 8
            y: 16
        }
    );

    let raw_result = box_into_raw(
        ref mut value
    );

    pick raw_result {
        Some(raw_value) {
            let mut raw = raw_value;

            let reconstructed =
                box_raw_reconstruct(
                    ref mut raw
                );

            pick reconstructed {
                Some(boxed_value) {
                    let point = box_get(
                        ref boxed_value
                    );

                    give point.x == 8
                        and point.y == 16
                        and box_raw_is_consumed(raw);
                }

                None {
                    give false;
                }
            }
        }

        None {
            give false;
        }
    }
}

proc test_raw_reconstruct_once() -> bool {
    let mut value = box_new(42);

    let raw_result = box_into_raw(
        ref mut value
    );

    pick raw_result {
        Some(raw_value) {
            let mut raw = raw_value;

            let first = box_raw_reconstruct(
                ref mut raw
            );

            let second = box_raw_reconstruct(
                ref mut raw
            );

            pick first {
                Some(boxed_value) {
                    give is_none(second)
                        and *box_get(
                            ref boxed_value
                        ) == 42;
                }

                None {
                    give false;
                }
            }
        }

        None {
            give false;
        }
    }
}

proc test_consumed_raw_cannot_read() -> bool {
    let mut value = box_new(42);

    let raw_result = box_into_raw(
        ref mut value
    );

    pick raw_result {
        Some(raw_value) {
            let mut raw = raw_value;

            let reconstructed =
                box_raw_reconstruct(
                    ref mut raw
                );

            if is_none(reconstructed) {
                give false;
            }

            give not box_raw_can_read(raw)
                and is_none(
                    box_raw_as_ref(raw)
                );
        }

        None {
            give false;
        }
    }
}

proc test_consumed_raw_cannot_write() -> bool {
    let mut value = box_new(42);

    let raw_result = box_into_raw(
        ref mut value
    );

    pick raw_result {
        Some(raw_value) {
            let mut raw = raw_value;

            let reconstructed =
                box_raw_reconstruct(
                    ref mut raw
                );

            if is_none(reconstructed) {
                give false;
            }

            give not box_raw_can_write(raw)
                and is_none(
                    box_raw_as_mut(
                        ref mut raw
                    )
                );
        }

        None {
            give false;
        }
    }
}

proc test_consumed_raw_cannot_reconstruct() -> bool {
    let mut value = box_new(42);

    let raw_result = box_into_raw(
        ref mut value
    );

    pick raw_result {
        Some(raw_value) {
            let mut raw = raw_value;

            let first = box_raw_reconstruct(
                ref mut raw
            );

            if is_none(first) {
                give false;
            }

            give not box_raw_can_reconstruct(raw);
        }

        None {
            give false;
        }
    }
}

// -----------------------------------------------------------------------------
// Borrowed reconstruction rejection
// -----------------------------------------------------------------------------

proc test_borrowed_cannot_reconstruct() -> bool {
    let value = box_new(42);

    let raw = box_as_raw(
        ref value
    );

    give not box_raw_can_reconstruct(raw)
        and is_none(
            box_from_raw(raw)
        );
}

proc test_mut_borrowed_cannot_reconstruct() -> bool {
    let mut value = box_new(42);

    let raw = box_as_raw_mut(
        ref mut value
    );

    give not box_raw_can_reconstruct(raw)
        and is_none(
            box_from_raw(raw)
        );
}

// -----------------------------------------------------------------------------
// Raw release
// -----------------------------------------------------------------------------

proc test_raw_release() -> bool {
    let mut value = box_new(42);

    let raw_result = box_into_raw(
        ref mut value
    );

    pick raw_result {
        Some(raw_value) {
            let mut raw = raw_value;

            let released = box_raw_release(
                ref mut raw
            );

            give released
                and box_raw_is_released(raw)
                and not box_raw_can_read(raw)
                and not box_raw_can_write(raw)
                and not box_raw_can_reconstruct(raw)
                and not box_raw_can_release(raw);
        }

        None {
            give false;
        }
    }
}

proc test_raw_release_string() -> bool {
    let mut value = box_new("Vitte");

    let raw_result = box_into_raw(
        ref mut value
    );

    pick raw_result {
        Some(raw_value) {
            let mut raw = raw_value;

            give box_raw_release(
                ref mut raw
            )
            and box_raw_is_released(raw);
        }

        None {
            give false;
        }
    }
}

proc test_raw_release_point() -> bool {
    let mut value = box_new(
        Point {
            x: 1
            y: 2
        }
    );

    let raw_result = box_into_raw(
        ref mut value
    );

    pick raw_result {
        Some(raw_value) {
            let mut raw = raw_value;

            give box_raw_release(
                ref mut raw
            )
            and box_raw_is_released(raw);
        }

        None {
            give false;
        }
    }
}

proc test_raw_release_once() -> bool {
    let mut value = box_new(42);

    let raw_result = box_into_raw(
        ref mut value
    );

    pick raw_result {
        Some(raw_value) {
            let mut raw = raw_value;

            let first = box_raw_release(
                ref mut raw
            );

            let second = box_raw_release(
                ref mut raw
            );

            give first
                and not second;
        }

        None {
            give false;
        }
    }
}

proc test_borrowed_cannot_release() -> bool {
    let value = box_new(42);

    let raw_value = box_as_raw(
        ref value
    );

    let mut raw = raw_value;

    give not box_raw_release(
        ref mut raw
    )
    and box_is_valid(value)
    and *box_get(ref value) == 42;
}

proc test_mut_borrowed_cannot_release() -> bool {
    let mut value = box_new(42);

    let raw_value = box_as_raw_mut(
        ref mut value
    );

    let mut raw = raw_value;

    give not box_raw_release(
        ref mut raw
    )
    and box_is_valid(value);
}

// -----------------------------------------------------------------------------
// Forget
// -----------------------------------------------------------------------------

proc test_raw_forget() -> bool {
    let mut value = box_new(42);

    let raw_result = box_into_raw(
        ref mut value
    );

    pick raw_result {
        Some(raw_value) {
            let mut raw = raw_value;

            give box_raw_forget(
                ref mut raw
            )
            and box_raw_is_consumed(raw)
            and not box_raw_can_reconstruct(raw);
        }

        None {
            give false;
        }
    }
}

proc test_borrowed_raw_forget_fails() -> bool {
    let value = box_new(42);

    let raw_value = box_as_raw(
        ref value
    );

    let mut raw = raw_value;

    give not box_raw_forget(
        ref mut raw
    );
}

proc test_raw_forget_once() -> bool {
    let mut value = box_new(42);

    let raw_result = box_into_raw(
        ref mut value
    );

    pick raw_result {
        Some(raw_value) {
            let mut raw = raw_value;

            let first = box_raw_forget(
                ref mut raw
            );

            let second = box_raw_forget(
                ref mut raw
            );

            give first
                and not second;
        }

        None {
            give false;
        }
    }
}

// -----------------------------------------------------------------------------
// Identity
// -----------------------------------------------------------------------------

proc test_raw_ptr_eq_same_box() -> bool {
    let value = box_new(42);

    let first = box_as_raw(
        ref value
    );

    let second = box_as_raw(
        ref value
    );

    give box_raw_ptr_eq(
        first,
        second
    );
}

proc test_raw_ptr_ne_different_boxes() -> bool {
    let first_box = box_new(42);
    let second_box = box_new(42);

    let first = box_as_raw(
        ref first_box
    );

    let second = box_as_raw(
        ref second_box
    );

    give box_raw_ptr_ne(
        first,
        second
    );
}

proc test_raw_ptr_eq_mut_and_shared_same_box() -> bool {
    let mut value = box_new(42);

    let shared = box_as_raw(
        ref value
    );

    let mutable = box_as_raw_mut(
        ref mut value
    );

    give box_raw_ptr_eq(
        shared,
        mutable
    );
}

proc test_clone_has_different_raw_pointer() -> bool {
    let first = box_new(42);
    let second = box_clone(
        ref first
    );

    let first_raw = box_as_raw(
        ref first
    );

    let second_raw = box_as_raw(
        ref second
    );

    give box_raw_ptr_ne(
        first_raw,
        second_raw
    );
}

proc test_move_raw_identity() -> bool {
    let mut value = box_new(42);

    let before = box_as_raw(
        ref value
    );

    let result = box_into_raw(
        ref mut value
    );

    pick result {
        Some(after) {
            give box_raw_ptr_eq(
                before,
                after
            );
        }

        None {
            give false;
        }
    }
}

proc test_reconstruct_identity() -> bool {
    let mut value = box_new(42);

    let raw_result = box_into_raw(
        ref mut value
    );

    pick raw_result {
        Some(raw_value) {
            let before = raw_value;
            let mut raw = raw_value;

            let result = box_raw_reconstruct(
                ref mut raw
            );

            pick result {
                Some(boxed_value) {
                    let after = box_as_raw(
                        ref boxed_value
                    );

                    give box_raw_ptr_eq(
                        before,
                        after
                    );
                }

                None {
                    give false;
                }
            }
        }

        None {
            give false;
        }
    }
}

