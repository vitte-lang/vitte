proc shared_error_domain_name(
    domain: SharedErrorDomain
) -> string {
    pick domain {
        SharedErrorDomain.General {
            give "general";
        }

        SharedErrorDomain.Shared {
            give "shared";
        }

        SharedErrorDomain.Count {
            give "count";
        }

        SharedErrorDomain.Strong {
            give "strong";
        }

        SharedErrorDomain.Weak {
            give "weak";
        }

        SharedErrorDomain.Upgrade {
            give "upgrade";
        }

        SharedErrorDomain.Downgrade {
            give "downgrade";
        }

        SharedErrorDomain.Access {
            give "access";
        }

        SharedErrorDomain.Pointer {
            give "pointer";
        }

        SharedErrorDomain.Runtime {
            give "runtime";
        }

        SharedErrorDomain.Internal {
            give "internal";
        }
    }

    give "internal";
}

proc shared_error_operation_name(
    operation: SharedErrorOperation
) -> string {
    pick operation {
        SharedErrorOperation.None {
            give "none";
        }

        SharedErrorOperation.New {
            give "new";
        }

        SharedErrorOperation.CloneStrong {
            give "clone-strong";
        }

        SharedErrorOperation.DropStrong {
            give "drop-strong";
        }

        SharedErrorOperation.CloneWeak {
            give "clone-weak";
        }

        SharedErrorOperation.DropWeak {
            give "drop-weak";
        }

        SharedErrorOperation.Upgrade {
            give "upgrade";
        }

        SharedErrorOperation.Downgrade {
            give "downgrade";
        }

        SharedErrorOperation.Get {
            give "get";
        }

        SharedErrorOperation.GetMut {
            give "get-mut";
        }

        SharedErrorOperation.Replace {
            give "replace";
        }

        SharedErrorOperation.DropValue {
            give "drop-value";
        }

        SharedErrorOperation.ReleaseAllocation {
            give "release-allocation";
        }

        SharedErrorOperation.Validate {
            give "validate";
        }
    }

    give "none";
}

// -----------------------------------------------------------------------------
// Shared error model
// -----------------------------------------------------------------------------
//
// Shared errors cover:
//
//     reference counts
//     ownership state
//     lifetime
//     access
//     raw pointers
//     upgrade / downgrade
//
// Strong clone:
//
//     strong > 0
//     strong < usize_max()
//
// Strong drop:
//
//     strong > 0
//
// Weak clone:
//
//     weak < usize_max()
//
// Weak drop:
//
//     weak > 0
//
// Upgrade:
//
//     weak > 0
//     strong > 0
//     strong < usize_max()
//
// Downgrade:
//
//     strong > 0
//     weak < usize_max()
//
// Read:
//
//     strong > 0
//
// Mutable access:
//
//     strong == 1
//
// Value lifetime:
//
//     strong > 0
//         alive
//
//     strong == 0
//         dropped
//
// Control allocation:
//
//     strong == 0
//     weak == 0
//
//     releasable
//
// Fatal conditions:
//
//     counter overflow
//     counter underflow
//     invalid pointer metadata
//     invalid control block
//     internal invariant failure
//
// Recoverable conditions:
//
//     upgrade on expired weak reference
//     mutable access while shared
//     ordinary invalid operation
//
// This module only classifies failures.
//
// It does not:
//
//     allocate memory
//     mutate counters
//     destroy values
//     release control blocks
//
// Concrete state transitions remain in:
//
//     core.vitl
//     count.vitl
//
// Higher-level shared modules convert their runtime failures into this
// normalized error representation.
