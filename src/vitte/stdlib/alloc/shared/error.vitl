// -----------------------------------------------------------------------------
// Strong checks
// -----------------------------------------------------------------------------

proc shared_error_for_strong_clone(
    counts: shared_count.SharedCountPair
) -> SharedError {
    if counts.strong.value == 0 {
        give shared_error_not_alive(
            counts
        );
    }

    if not shared_count.shared_count_can_increment(
        counts.strong
    ) {
        give shared_error_count_overflow(
            counts,
            SharedErrorOperation.CloneStrong
        );
    }

    give shared_error_none();
}

proc shared_error_for_strong_drop(
    counts: shared_count.SharedCountPair
) -> SharedError {
    if not shared_count.shared_count_can_decrement(
        counts.strong
    ) {
        give shared_error_count_underflow(
            counts,
            SharedErrorOperation.DropStrong
        );
    }

    give shared_error_none();
}

// -----------------------------------------------------------------------------
// Weak checks
// -----------------------------------------------------------------------------

proc shared_error_for_weak_clone(
    counts: shared_count.SharedCountPair
) -> SharedError {
    if not shared_count.shared_count_can_increment(
        counts.weak
    ) {
        give shared_error_count_overflow(
            counts,
            SharedErrorOperation.CloneWeak
        );
    }

    give shared_error_none();
}

proc shared_error_for_weak_drop(
    counts: shared_count.SharedCountPair
) -> SharedError {
    if not shared_count.shared_count_can_decrement(
        counts.weak
    ) {
        give shared_error_count_underflow(
            counts,
            SharedErrorOperation.DropWeak
        );
    }

    give shared_error_none();
}

// -----------------------------------------------------------------------------
// Upgrade / downgrade checks
// -----------------------------------------------------------------------------

proc shared_error_for_upgrade(
    counts: shared_count.SharedCountPair
) -> SharedError {
    if counts.weak.value == 0 {
        give shared_error_upgrade_failed(
            counts
        );
    }

    if counts.strong.value == 0 {
        give shared_error_value_dropped(
            counts
        );
    }

    if not shared_count.shared_count_can_increment(
        counts.strong
    ) {
        give shared_error_count_overflow(
            counts,
            SharedErrorOperation.Upgrade
        );
    }

    give shared_error_none();
}

proc shared_error_for_downgrade(
    counts: shared_count.SharedCountPair
) -> SharedError {
    if counts.strong.value == 0 {
        give shared_error_not_alive(
            counts
        );
    }

    if not shared_count.shared_count_can_increment(
        counts.weak
    ) {
        give shared_error_count_overflow(
            counts,
            SharedErrorOperation.Downgrade
        );
    }

    give shared_error_none();
}

// -----------------------------------------------------------------------------
// Access checks
// -----------------------------------------------------------------------------

proc shared_error_for_read(
    counts: shared_count.SharedCountPair
) -> SharedError {
    if not shared_count.shared_count_is_alive(
        counts
    ) {
        give shared_error_not_alive(
            counts
        );
    }

    give shared_error_none();
}

proc shared_error_for_write(
    counts: shared_count.SharedCountPair
) -> SharedError {
    if not shared_count.shared_count_is_alive(
        counts
    ) {
        give shared_error_not_alive(
            counts
        );
    }

    if not shared_count.shared_count_strong_is_unique(
        counts
    ) {
        give shared_error_not_unique(
            counts
        );
    }

    give shared_error_none();
}

proc shared_error_for_replace(
    counts: shared_count.SharedCountPair
) -> SharedError {
    let access =
        shared_error_for_write(
            counts
        );

    if not shared_error_is_none(
        access
    ) {
        give access;
    }

    give shared_error_none();
}

// -----------------------------------------------------------------------------
// Count validation mapping
// -----------------------------------------------------------------------------

proc shared_error_from_count_validation(
    count: shared_count.SharedCount,
    validation: shared_count.SharedCountValidation
) -> SharedError {
    if validation.valid {
        give shared_error_none();
    }

    if not validation.kind_valid {
        give shared_error_internal(
            "shared count kind is invalid"
        );
    }

    if not validation.state_valid {
        if count.kind
            == shared_count.SharedCountKind.Strong
        {
            give shared_error_simple(
                SharedErrorKind.InvalidStrongCount,
                "shared strong counter state is invalid"
            );
        }

        give shared_error_simple(
            SharedErrorKind.InvalidWeakCount,
            "shared weak counter state is invalid"
        );
    }

    if not validation.generation_valid {
        give shared_error_internal(
            "shared count generation metadata is invalid"
        );
    }

    give shared_error_internal(
        "unknown shared count validation failure"
    );
}

proc shared_error_from_count_pair(
    counts: shared_count.SharedCountPair
) -> SharedError {
    let strong =
        shared_count.shared_count_validate(
            counts.strong
        );

    if not strong.valid {
        give shared_error_from_count_validation(
            counts.strong,
            strong
        );
    }

    let weak =
        shared_count.shared_count_validate(
            counts.weak
        );

    if not weak.valid {
        give shared_error_from_count_validation(
            counts.weak,
            weak
        );
    }

    let pair =
        shared_count.shared_count_pair_validate(
            counts
        );

    if not pair.total_valid {
        give shared_error_count_overflow(
            counts,
            SharedErrorOperation.Validate
        );
    }

    if not pair.lifecycle_valid {
        give shared_error_invalid_state(
            counts
        );
    }

    if not pair.valid {
        give shared_error_invalid_shared(
            counts
        );
    }

    give shared_error_none();
}

// -----------------------------------------------------------------------------
// Core validation mapping
// -----------------------------------------------------------------------------

proc shared_error_from_core_validation(
    profile: shared_core.SharedCoreProfile,
    validation: shared_core.SharedCoreValidation
) -> SharedError {
    if validation.valid {
        give shared_error_none();
    }

    let context =
        shared_error_context_core(
            profile,
            SharedErrorOperation.Validate
        );

    if not validation.counts_valid {
        give shared_error(
            SharedErrorKind.InvalidShared,
            SharedErrorSeverity.Fatal,
            SharedErrorDomain.Count,
            context,
            "shared reference counts are invalid"
        );
    }

    if not validation.state_valid {
        give shared_error(
            SharedErrorKind.InvalidState,
            SharedErrorSeverity.Error,
            SharedErrorDomain.Shared,
            context,
            "shared core state is invalid"
        );
    }

    if not validation.ownership_valid {
        give shared_error(
            SharedErrorKind.InvalidState,
            SharedErrorSeverity.Error,
            SharedErrorDomain.Shared,
            context,
            "shared ownership classification is invalid"
        );
    }

    if not validation.access_valid {
        give shared_error(
            SharedErrorKind.InvalidAccess,
            SharedErrorSeverity.Error,
            SharedErrorDomain.Access,
            context,
            "shared access classification is invalid"
        );
    }

    if not validation.generation_valid {
        give shared_error(
            SharedErrorKind.Internal,
            SharedErrorSeverity.Fatal,
            SharedErrorDomain.Internal,
            context,
            "shared generation metadata is invalid"
        );
    }

    give shared_error_internal(
        "unknown shared core validation failure"
    );
}

// -----------------------------------------------------------------------------
// Predicates
// -----------------------------------------------------------------------------

proc shared_error_is_none(
    error: SharedError
) -> bool {
    give error.kind
        == SharedErrorKind.None;
}

proc shared_error_is_warning(
    error: SharedError
) -> bool {
    give error.severity
        == SharedErrorSeverity.Warning;
}

proc shared_error_is_error(
    error: SharedError
) -> bool {
    give error.severity
        == SharedErrorSeverity.Error
        or error.severity
            == SharedErrorSeverity.Fatal;
}

proc shared_error_is_fatal(
    error: SharedError
) -> bool {
    give error.severity
        == SharedErrorSeverity.Fatal;
}

proc shared_error_is_recoverable(
    error: SharedError
) -> bool {
    give error.severity
        == SharedErrorSeverity.Note
        or error.severity
            == SharedErrorSeverity.Warning
        or error.severity
            == SharedErrorSeverity.Error;
}

proc shared_error_is_count(
    error: SharedError
) -> bool {
    give error.domain
        == SharedErrorDomain.Count;
}

proc shared_error_is_strong(
    error: SharedError
) -> bool {
    give error.domain
        == SharedErrorDomain.Strong;
}

proc shared_error_is_weak(
    error: SharedError
) -> bool {
    give error.domain
        == SharedErrorDomain.Weak;
}

proc shared_error_is_upgrade(
    error: SharedError
) -> bool {
    give error.domain
        == SharedErrorDomain.Upgrade;
}

proc shared_error_is_downgrade(
    error: SharedError
) -> bool {
    give error.domain
        == SharedErrorDomain.Downgrade;
}

proc shared_error_is_access(
    error: SharedError
) -> bool {
    give error.domain
        == SharedErrorDomain.Access;
}

proc shared_error_is_pointer(
    error: SharedError
) -> bool {
    give error.domain
        == SharedErrorDomain.Pointer;
}

proc shared_error_is_overflow(
    error: SharedError
) -> bool {
    give error.kind
        == SharedErrorKind.CountOverflow;
}

proc shared_error_is_underflow(
    error: SharedError
) -> bool {
    give error.kind
        == SharedErrorKind.CountUnderflow;
}

proc shared_error_is_stale(
    error: SharedError
) -> bool {
    give error.kind
        == SharedErrorKind.StaleReference;
}

proc shared_error_is_lifetime(
    error: SharedError
) -> bool {
    give error.kind == SharedErrorKind.ValueDropped
        or error.kind == SharedErrorKind.AllocationReleased
        or error.kind == SharedErrorKind.NotAlive;
}

// -----------------------------------------------------------------------------
// Profile
// -----------------------------------------------------------------------------

proc shared_error_profile(
    error: SharedError
) -> SharedErrorProfile {
    give SharedErrorProfile {
        kind:
            error.kind,

        severity:
            error.severity,

        domain:
            error.domain,

        operation:
            error.context.operation,

        none:
            shared_error_is_none(
                error
            ),

        warning:
            shared_error_is_warning(
                error
            ),

        error:
            shared_error_is_error(
                error
            ),

        fatal:
            shared_error_is_fatal(
                error
            ),

        recoverable:
            shared_error_is_recoverable(
                error
            ),

        runtime:
            error.domain
                == SharedErrorDomain.Runtime,

        internal:
            error.domain
                == SharedErrorDomain.Internal
    };
}

// -----------------------------------------------------------------------------
// Domain mapping
// -----------------------------------------------------------------------------

proc shared_error_domain_for_kind(
    kind: SharedErrorKind
) -> SharedErrorDomain {
    pick kind {
        SharedErrorKind.None {
            give SharedErrorDomain.General;
        }

        SharedErrorKind.InvalidShared
        | SharedErrorKind.InvalidState
        | SharedErrorKind.InvalidControlBlock
        | SharedErrorKind.ValueDropped
        | SharedErrorKind.AllocationReleased
        | SharedErrorKind.NotAlive {
            give SharedErrorDomain.Shared;
        }

        SharedErrorKind.InvalidStrongCount
        | SharedErrorKind.InvalidWeakCount
        | SharedErrorKind.CountOverflow
        | SharedErrorKind.CountUnderflow {
            give SharedErrorDomain.Count;
        }

        SharedErrorKind.CloneFailed
        | SharedErrorKind.DropFailed {
            give SharedErrorDomain.Strong;
        }

        SharedErrorKind.UpgradeFailed {
            give SharedErrorDomain.Upgrade;
        }

        SharedErrorKind.DowngradeFailed {
            give SharedErrorDomain.Downgrade;
        }

        SharedErrorKind.NotUnique
        | SharedErrorKind.InvalidAccess
        | SharedErrorKind.MutableAccessDenied {
            give SharedErrorDomain.Access;
        }

        SharedErrorKind.InvalidPointer
        | SharedErrorKind.NullPointer
        | SharedErrorKind.StaleReference {
            give SharedErrorDomain.Pointer;
        }

        SharedErrorKind.RuntimeFailure {
            give SharedErrorDomain.Runtime;
        }

        SharedErrorKind.Internal {
            give SharedErrorDomain.Internal;
        }
    }

    give SharedErrorDomain.Internal;
}

// -----------------------------------------------------------------------------
// Statistics
// -----------------------------------------------------------------------------

proc shared_error_statistics_empty()
    -> SharedErrorStatistics
{
    give SharedErrorStatistics {
        total: 0,

        notes: 0,
        warnings: 0,
        errors: 0,
        fatals: 0,

        shared_errors: 0,
        count_errors: 0,
        strong_errors: 0,
        weak_errors: 0,
        upgrade_errors: 0,
        downgrade_errors: 0,
        access_errors: 0,
        pointer_errors: 0,
        runtime_errors: 0,
        internal_errors: 0
    };
}

proc shared_error_statistics_record(
    statistics: ref mut SharedErrorStatistics,
    error: SharedError
) {
    if shared_error_is_none(
        error
    ) {
        give;
    }

    set statistics.total =
        statistics.total + 1;

    pick error.severity {
        SharedErrorSeverity.Note {
            set statistics.notes =
                statistics.notes + 1;
        }

        SharedErrorSeverity.Warning {
            set statistics.warnings =
                statistics.warnings + 1;
        }

        SharedErrorSeverity.Error {
            set statistics.errors =
                statistics.errors + 1;
        }

        SharedErrorSeverity.Fatal {
            set statistics.fatals =
                statistics.fatals + 1;
        }
    }

    pick error.domain {
        SharedErrorDomain.Shared {
            set statistics.shared_errors =
                statistics.shared_errors + 1;
        }

        SharedErrorDomain.Count {
            set statistics.count_errors =
                statistics.count_errors + 1;
        }

        SharedErrorDomain.Strong {
            set statistics.strong_errors =
                statistics.strong_errors + 1;
        }

        SharedErrorDomain.Weak {
            set statistics.weak_errors =
                statistics.weak_errors + 1;
        }

        SharedErrorDomain.Upgrade {
            set statistics.upgrade_errors =
                statistics.upgrade_errors + 1;
        }

        SharedErrorDomain.Downgrade {
            set statistics.downgrade_errors =
                statistics.downgrade_errors + 1;
        }

        SharedErrorDomain.Access {
            set statistics.access_errors =
                statistics.access_errors + 1;
        }

        SharedErrorDomain.Pointer {
            set statistics.pointer_errors =
                statistics.pointer_errors + 1;
        }

        SharedErrorDomain.Runtime {
            set statistics.runtime_errors =
                statistics.runtime_errors + 1;
        }

        SharedErrorDomain.Internal {
            set statistics.internal_errors =
                statistics.internal_errors + 1;
        }

        SharedErrorDomain.General {}
    }
}

proc shared_error_statistics_total(
    statistics: SharedErrorStatistics
) -> u64 {
    give statistics.total;
}

proc shared_error_statistics_reset(
    statistics: ref mut SharedErrorStatistics
) {
    set *statistics =
        shared_error_statistics_empty();
}

