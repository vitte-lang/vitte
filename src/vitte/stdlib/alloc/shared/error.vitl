space vitte/stdlib/alloc/shared/error

export *

use src/vitte/stdlib/alloc/shared/core as shared_core
use src/vitte/stdlib/alloc/shared/count as shared_count

pick SharedErrorKind {
    None,

    InvalidShared,
    InvalidState,
    InvalidControlBlock,

    InvalidStrongCount,
    InvalidWeakCount,
    CountOverflow,
    CountUnderflow,

    CloneFailed,
    DropFailed,

    UpgradeFailed,
    DowngradeFailed,

    ValueDropped,
    AllocationReleased,

    InvalidPointer,
    NullPointer,
    StaleReference,

    NotUnique,
    NotAlive,

    InvalidAccess,
    MutableAccessDenied,

    RuntimeFailure,
    Internal
}

pick SharedErrorSeverity {
    Note,
    Warning,
    Error,
    Fatal
}

pick SharedErrorDomain {
    General,
    Shared,
    Count,
    Strong,
    Weak,
    Upgrade,
    Downgrade,
    Access,
    Pointer,
    Runtime,
    Internal
}

pick SharedErrorOperation {
    None,

    New,

    CloneStrong,
    DropStrong,

    CloneWeak,
    DropWeak,

    Upgrade,
    Downgrade,

    Get,
    GetMut,

    Replace,

    DropValue,
    ReleaseAllocation,

    Validate
}

form SharedErrorContext {
    operation: SharedErrorOperation

    state: shared_core.SharedCoreState
    ownership: shared_core.SharedCoreOwnership
    access: shared_core.SharedCoreAccess

    strong: usize
    weak: usize

    generation: u64
    revision: u64
}

form SharedError {
    kind: SharedErrorKind
    severity: SharedErrorSeverity
    domain: SharedErrorDomain

    context: SharedErrorContext

    message: string
}

form SharedErrorProfile {
    kind: SharedErrorKind
    severity: SharedErrorSeverity
    domain: SharedErrorDomain
    operation: SharedErrorOperation

    none: bool
    warning: bool
    error: bool
    fatal: bool

    recoverable: bool
    runtime: bool
    internal: bool
}

form SharedErrorStatistics {
    total: u64

    notes: u64
    warnings: u64
    errors: u64
    fatals: u64

    shared_errors: u64
    count_errors: u64
    strong_errors: u64
    weak_errors: u64
    upgrade_errors: u64
    downgrade_errors: u64
    access_errors: u64
    pointer_errors: u64
    runtime_errors: u64
    internal_errors: u64
}

// -----------------------------------------------------------------------------
// Context
// -----------------------------------------------------------------------------

proc shared_error_context_empty()
    -> SharedErrorContext
{
    give SharedErrorContext {
        operation:
            SharedErrorOperation.None,

        state:
            shared_core.SharedCoreState.Invalid,

        ownership:
            shared_core.SharedCoreOwnership.Dead,

        access:
            shared_core.SharedCoreAccess.None,

        strong:
            0,

        weak:
            0,

        generation:
            0,

        revision:
            0
    };
}

proc shared_error_context_counts(
    counts: shared_count.SharedCountPair,
    operation: SharedErrorOperation
) -> SharedErrorContext {
    let core =
        shared_count.shared_count_core(
            counts
        );

    give SharedErrorContext {
        operation:
            operation,

        state:
            shared_core.shared_core_state(
                core
            ),

        ownership:
            shared_core.shared_core_ownership(
                core
            ),

        access:
            shared_core.shared_core_access(
                core
            ),

        strong:
            counts.strong.value,

        weak:
            counts.weak.value,

        generation:
            counts.strong.generation,

        revision:
            counts.strong.revision
    };
}

proc shared_error_context_core(
    profile: shared_core.SharedCoreProfile,
    operation: SharedErrorOperation
) -> SharedErrorContext {
    give SharedErrorContext {
        operation:
            operation,

        state:
            profile.info.state,

        ownership:
            profile.info.ownership,

        access:
            profile.info.access,

        strong:
            profile.counts.strong,

        weak:
            profile.counts.weak,

        generation:
            profile.meta.generation,

        revision:
            profile.meta.revision
    };
}

// -----------------------------------------------------------------------------
// Constructors
// -----------------------------------------------------------------------------

proc shared_error(
    kind: SharedErrorKind,
    severity: SharedErrorSeverity,
    domain: SharedErrorDomain,
    context: SharedErrorContext,
    message: string
) -> SharedError {
    give SharedError {
        kind:
            kind,

        severity:
            severity,

        domain:
            domain,

        context:
            context,

        message:
            message
    };
}

proc shared_error_none()
    -> SharedError
{
    give shared_error(
        SharedErrorKind.None,
        SharedErrorSeverity.Note,
        SharedErrorDomain.General,
        shared_error_context_empty(),
        ""
    );
}

proc shared_error_simple(
    kind: SharedErrorKind,
    message: string
) -> SharedError {
    give shared_error(
        kind,
        SharedErrorSeverity.Error,
        shared_error_domain_for_kind(
            kind
        ),
        shared_error_context_empty(),
        message
    );
}

proc shared_error_warning(
    kind: SharedErrorKind,
    message: string
) -> SharedError {
    give shared_error(
        kind,
        SharedErrorSeverity.Warning,
        shared_error_domain_for_kind(
            kind
        ),
        shared_error_context_empty(),
        message
    );
}

proc shared_error_fatal(
    kind: SharedErrorKind,
    message: string
) -> SharedError {
    give shared_error(
        kind,
        SharedErrorSeverity.Fatal,
        shared_error_domain_for_kind(
            kind
        ),
        shared_error_context_empty(),
        message
    );
}

// -----------------------------------------------------------------------------
// Shared errors
// -----------------------------------------------------------------------------

proc shared_error_invalid_shared(
    counts: shared_count.SharedCountPair
) -> SharedError {
    give shared_error(
        SharedErrorKind.InvalidShared,
        SharedErrorSeverity.Fatal,
        SharedErrorDomain.Shared,
        shared_error_context_counts(
            counts,
            SharedErrorOperation.Validate
        ),
        "shared value is invalid"
    );
}

