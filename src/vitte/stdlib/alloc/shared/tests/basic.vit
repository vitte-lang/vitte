use src/vitte/stdlib/alloc/shared/shared

form Point {
    x: int
    y: int
}

proc test_new() -> bool {
    let value = shared_new(42);

    give shared_is_alive(ref value)
        and shared_is_unique(ref value)
        and not shared_is_shared(ref value)
        and shared_strong_count(ref value) == 1
        and shared_weak_count(ref value) == 0;
}

proc test_get() -> bool {
    let value = shared_new(42);

    give *shared_get(ref value) == 42;
}

proc test_try_get() -> bool {
    let value = shared_new(42);

    let result = shared_try_get(
        ref value
    );

    pick result {
        Some(inner) {
            give *inner == 42;
        }

        None {
            give false;
        }
    }
}

proc test_point() -> bool {
    let value = shared_new(
        Point {
            x: 10
            y: 20
        }
    );

    let point = shared_get(
        ref value
    );

    give point.x == 10
        and point.y == 20;
}

proc test_get_mut_unique() -> bool {
    let mut value = shared_new(10);

    let result = shared_get_mut(
        ref mut value
    );

    pick result {
        Some(inner) {
            set *inner = 20;

            give *shared_get(ref value) == 20;
        }

        None {
            give false;
        }
    }
}

proc test_point_mutation() -> bool {
    let mut value = shared_new(
        Point {
            x: 1
            y: 2
        }
    );

    let result = shared_get_mut(
        ref mut value
    );

    pick result {
        Some(point) {
            set point.x = 100;
            set point.y = 200;

            give point.x == 100
                and point.y == 200;
        }

        None {
            give false;
        }
    }
}

proc test_replace() -> bool {
    let mut value = shared_new(10);

    if not shared_replace(
        ref mut value,
        99
    ) {
        give false;
    }

    give *shared_get(ref value) == 99;
}

proc test_clone() -> bool {
    let value = shared_new(42);
    let copy = shared_clone(value);

    give shared_ptr_equal(
        ref value,
        ref copy
    )
    and shared_strong_count(ref value) == 2
    and shared_strong_count(ref copy) == 2
    and shared_is_shared(ref value)
    and shared_is_shared(ref copy);
}

proc test_try_clone() -> bool {
    let value = shared_new(42);

    let result = shared_try_clone(
        value
    );

    pick result {
        Some(copy) {
            give shared_ptr_equal(
                ref value,
                ref copy
            )
            and shared_strong_count(ref value) == 2;
        }

        None {
            give false;
        }
    }
}

proc test_mutable_denied_when_shared() -> bool {
    let mut value = shared_new(42);
    let copy = shared_clone(value);

    if shared_strong_count(ref value) != 2 {
        give false;
    }

    give is_none(
        shared_get_mut(
            ref mut value
        )
    )
    and *shared_get(ref copy) == 42;
}

proc test_drop_clone_restores_unique() -> bool {
    let mut value = shared_new(42);
    let mut copy = shared_clone(value);

    if not shared_drop(
        ref mut copy
    ) {
        give false;
    }

    give shared_strong_count(ref value) == 1
        and shared_is_unique(ref value);
}

proc test_mutable_after_clone_drop() -> bool {
    let mut value = shared_new(42);
    let mut copy = shared_clone(value);

    if not shared_drop(
        ref mut copy
    ) {
        give false;
    }

    let result = shared_get_mut(
        ref mut value
    );

    pick result {
        Some(inner) {
            set *inner = 84;

            give *shared_get(ref value) == 84;
        }

        None {
            give false;
        }
    }
}

proc test_downgrade() -> bool {
    let value = shared_new(42);

    let weak = shared_downgrade(
        ref value
    );

    give shared_strong_count(ref value) == 1
        and shared_weak_count(ref value) == 1
        and shared_weak_strong_count(ref weak) == 1
        and shared_weak_weak_count(ref weak) == 1
        and not shared_weak_is_expired(ref weak);
}

proc test_try_downgrade() -> bool {
    let value = shared_new(42);

    let result = shared_try_downgrade(
        ref value
    );

    pick result {
        Some(weak) {
            give shared_weak_strong_count(ref weak) == 1
                and shared_weak_weak_count(ref weak) == 1;
        }

        None {
            give false;
        }
    }
}

proc test_upgrade() -> bool {
    let value = shared_new(42);

    let weak = shared_downgrade(
        ref value
    );

    let result = shared_upgrade(
        ref weak
    );

    pick result {
        Some(copy) {
            give *shared_get(ref copy) == 42
                and shared_strong_count(ref value) == 2
                and shared_ptr_equal(
                    ref value,
                    ref copy
                );
        }

        None {
            give false;
        }
    }
}

proc test_weak_clone() -> bool {
    let value = shared_new(42);

    let weak = shared_downgrade(
        ref value
    );

    let copy = shared_weak_clone(
        weak
    );

    give shared_weak_weak_count(ref weak) == 2
        and shared_weak_weak_count(ref copy) == 2
        and shared_weak_ptr_equal(
            ref weak,
            ref copy
        );
}

proc test_weak_drop() -> bool {
    let value = shared_new(42);

    let mut weak = shared_downgrade(
        ref value
    );

    if shared_weak_count(ref value) != 1 {
        give false;
    }

    give shared_weak_drop(
        ref mut weak
    )
    and shared_weak_count(ref value) == 0;
}

proc test_weak_expires_after_final_strong_drop() -> bool {
    let mut value = shared_new(42);

    let weak = shared_downgrade(
        ref value
    );

    if not shared_drop(
        ref mut value
    ) {
        give false;
    }

    give shared_weak_is_expired(
        ref weak
    )
    and shared_weak_strong_count(
        ref weak
    ) == 0;
}

proc test_upgrade_expired_fails() -> bool {
    let mut value = shared_new(42);

    let weak = shared_downgrade(
        ref value
    );

    if not shared_drop(
        ref mut value
    ) {
        give false;
    }

    give is_none(
        shared_upgrade(
            ref weak
        )
    );
}

proc test_ptr_identity() -> bool {
    let value = shared_new(42);
    let copy = shared_clone(value);

    give shared_ptr_equal(
        ref value,
        ref copy
    );
}

proc test_weak_ptr_identity() -> bool {
    let value = shared_new(42);

    let weak = shared_downgrade(
        ref value
    );

    give shared_ptr_eq_weak(
        ref value,
        ref weak
    );
}

proc test_identity() -> bool {
    let value = shared_new(42);
    let copy = shared_clone(value);

    let left = shared_identity(
        ref value
    );

    let right = shared_identity(
        ref copy
    );

    give shared_identity_equal(
        left,
        right
    );
}

proc test_profile_unique() -> bool {
    let value = shared_new(42);

    let profile = shared_profile(
        ref value
    );

    give profile.strong == 1
        and profile.weak == 0
        and profile.unique
        and not profile.shared
        and profile.alive
        and profile.valid;
}

proc test_profile_shared() -> bool {
    let value = shared_new(42);
    let copy = shared_clone(value);

    let profile = shared_profile(
        ref value
    );

    give profile.strong == 2
        and profile.shared
        and not profile.unique
        and profile.alive
        and profile.valid
        and *shared_get(ref copy) == 42;
}

proc test_weak_profile_alive() -> bool {
    let value = shared_new(42);

    let weak = shared_downgrade(
        ref value
    );

    let profile = shared_weak_profile(
        ref weak
    );

    give profile.strong == 1
        and profile.weak == 1
        and profile.alive
        and profile.upgradeable
        and not profile.expired;
}

proc test_weak_profile_expired() -> bool {
    let mut value = shared_new(42);

    let weak = shared_downgrade(
        ref value
    );

    if not shared_drop(
        ref mut value
    ) {
        give false;
    }

    let profile = shared_weak_profile(
        ref weak
    );

    give profile.strong == 0
        and profile.weak == 1
        and profile.expired
        and not profile.upgradeable;
}

proc test_validation() -> bool {
    let value = shared_new(42);

    let validation = shared_validate(
        ref value
    );

    give validation.valid
        and validation.owner_valid
        and validation.pointer_valid
        and validation.generation_valid
        and validation.inner_valid
        and validation.strong_valid
        and validation.state_valid;
}

proc test_weak_validation() -> bool {
    let value = shared_new(42);

    let weak = shared_downgrade(
        ref value
    );

    let validation = shared_weak_validate(
        ref weak
    );

    give validation.valid
        and validation.pointer_valid
        and validation.generation_valid
        and validation.inner_valid
        and validation.weak_valid
        and validation.state_valid;
}

proc test_invariant() -> bool {
    let value = shared_new(42);

    give shared_invariant_holds(
        ref value
    );
}

proc test_weak_invariant() -> bool {
    let value = shared_new(42);

    let weak = shared_downgrade(
        ref value
    );

    give shared_weak_invariant_holds(
        ref weak
    );
}

proc test_snapshot_equal() -> bool {
    let value = shared_new(42);

    let first = shared_snapshot(
        ref value
    );

    let second = shared_snapshot(
        ref value
    );

    give shared_snapshot_equal(
        first,
        second
    );
}

proc test_clone_changes_snapshot() -> bool {
    let value = shared_new(42);

    let before = shared_snapshot(
        ref value
    );

    let copy = shared_clone(value);

    let after = shared_snapshot(
        ref value
    );

    give shared_snapshot_changed(
        before,
        after
    )
    and shared_strong_count(ref copy) == 2;
}

proc test_clone_delta() -> bool {
    let value = shared_new(42);

    let before = shared_snapshot(
        ref value
    );

    let copy = shared_clone(value);

    let after = shared_snapshot(
        ref value
    );

    let delta = shared_delta(
        before,
        after
    );

    give delta.changed
        and delta.strong == 1
        and delta.weak == 0
        and shared_strong_count(ref copy) == 2;
}

proc test_downgrade_delta() -> bool {
    let value = shared_new(42);

    let before = shared_snapshot(
        ref value
    );

    let weak = shared_downgrade(
        ref value
    );

    let after = shared_snapshot(
        ref value
    );

    let delta = shared_delta(
        before,
        after
    );

    give delta.changed
        and delta.strong == 0
        and delta.weak == 1
        and shared_weak_weak_count(ref weak) == 1;
}

proc test_make_mut_unique() -> bool {
    let mut value = shared_new(42);

    let before = shared_identity(
        ref value
    );

    let inner = shared_make_mut(
        ref mut value
    );

    set *inner = 99;

    let after = shared_identity(
        ref value
    );

    give *shared_get(ref value) == 99
        and shared_is_unique(ref value)
        and shared_identity_equal(
            before,
            after
        );
}

proc test_make_mut_shared_detaches() -> bool {
    let mut value = shared_new(42);
    let copy = shared_clone(value);

    let before = shared_identity(
        ref value
    );

    let inner = shared_make_mut(
        ref mut value
    );

    set *inner = 100;

    let after = shared_identity(
        ref value
    );

    give *shared_get(ref value) == 100
        and *shared_get(ref copy) == 42
        and not shared_identity_equal(
            before,
            after
        )
        and not shared_ptr_equal(
            ref value,
            ref copy
        )
        and shared_is_unique(ref value)
        and shared_is_unique(ref copy);
}

proc test_make_mut_point() -> bool {
    let mut value = shared_new(
        Point {
            x: 1
            y: 2
        }
    );

    let copy = shared_clone(value);

    let point = shared_make_mut(
        ref mut value
    );

    set point.x = 100;
    set point.y = 200;

    let old = shared_get(
        ref copy
    );

    give point.x == 100
        and point.y == 200
        and old.x == 1
        and old.y == 2;
}

proc test_value_ptr() -> bool {
    let value = shared_new(42);

    let ptr = shared_value_ptr(
        ref value
    );

    give not compiler_raw_ptr_is_null(
        ptr
    );
}

proc test_value_ptr_mut() -> bool {
    let mut value = shared_new(42);

    let result = shared_value_ptr_mut(
        ref mut value
    );

    pick result {
        Some(ptr) {
            let inner = compiler_raw_as_mut(
                ptr
            );

            set *inner = 84;

            give *shared_get(ref value) == 84;
        }

        None {
            give false;
        }
    }
}

proc test_state_names() -> bool {
    give shared_state_name(
        SharedState.Alive
    ) == "alive"
        and shared_state_name(
            SharedState.Unique
        ) == "unique"
        and shared_state_name(
            SharedState.Shared
        ) == "shared"
        and shared_state_name(
            SharedState.WeakOnly
        ) == "weak-only"
        and shared_state_name(
            SharedState.Released
        ) == "released"
        and shared_state_name(
            SharedState.Stale
        ) == "stale"
        and shared_state_name(
            SharedState.Invalid
        ) == "invalid";
}

proc test_access_names() -> bool {
    give shared_access_name(
        SharedAccess.None
    ) == "none"
        and shared_access_name(
            SharedAccess.Read
        ) == "read"
        and shared_access_name(
            SharedAccess.ReadWrite
        ) == "read-write";
}

proc test_statistics_empty() -> bool {
    let statistics =
        shared_statistics_empty();

    give statistics.creations == 0
        and statistics.clones == 0
        and statistics.drops == 0
        and statistics.weak_creations == 0
        and statistics.weak_clones == 0
        and statistics.weak_drops == 0
        and statistics.upgrades == 0
        and statistics.validation_failures == 0;
}

proc test_statistics_create() -> bool {
    let value = shared_new(42);

    let mut statistics =
        shared_statistics_empty();

    shared_statistics_record_create(
        ref mut statistics,
        ref value,
        true
    );

    give statistics.creations == 1
        and statistics.peak_strong == 1;
}

proc test_statistics_clone() -> bool {
    let value = shared_new(42);
    let copy = shared_clone(value);

    let mut statistics =
        shared_statistics_empty();

    shared_statistics_record_clone(
        ref mut statistics,
        ref value,
        true
    );

    give statistics.clones == 1
        and statistics.peak_strong == 2
        and shared_strong_count(ref copy) == 2;
}

proc test_statistics_weak_create() -> bool {
    let value = shared_new(42);

    let weak = shared_downgrade(
        ref value
    );

    let mut statistics =
        shared_statistics_empty();

    shared_statistics_record_weak_create(
        ref mut statistics,
        ref value,
        true
    );

    give statistics.weak_creations == 1
        and statistics.peak_weak == 1
        and shared_weak_weak_count(ref weak) == 1;
}

proc test_statistics_upgrade() -> bool {
    let value = shared_new(42);

    let weak = shared_downgrade(
        ref value
    );

    let result = shared_upgrade(
        ref weak
    );

    let mut statistics =
        shared_statistics_empty();

    shared_statistics_record_upgrade(
        ref mut statistics,
        ref weak,
        is_some(result)
    );

    give statistics.upgrades == 1
        and statistics.upgrade_failures == 0;
}

proc test_statistics_failure() -> bool {
    let mut statistics =
        shared_statistics_empty();

    shared_statistics_record_drop(
        ref mut statistics,
        false
    );

    give statistics.drop_failures == 1
        and shared_statistics_failures(
            statistics
        ) == 1;
}

proc test_statistics_reset() -> bool {
    let mut statistics =
        shared_statistics_empty();

    set statistics.creations = 10;
    set statistics.clones = 20;
    set statistics.drops = 5;
    set statistics.validation_failures = 2;

    shared_statistics_reset(
        ref mut statistics
    );

    give statistics.creations == 0
        and statistics.clones == 0
        and statistics.drops == 0
        and statistics.validation_failures == 0;
}

proc test_clone_drop_stress() -> bool {
    let value = shared_new(42);

    let cycle: usize = 0;

    while cycle < 10000 {
        let mut copy = shared_clone(
            value
        );

        if shared_strong_count(
            ref value
        ) != 2 {
            give false;
        }

        if not shared_ptr_equal(
            ref value,
            ref copy
        ) {
            give false;
        }

        if not shared_drop(
            ref mut copy
        ) {
            give false;
        }

        if shared_strong_count(
            ref value
        ) != 1 {
            give false;
        }

        if not shared_is_unique(
            ref value
        ) {
            give false;
        }

        set cycle = cycle + 1;
    }

    give shared_invariant_holds(
        ref value
    );
}

proc test_weak_stress() -> bool {
    let value = shared_new(42);

    let cycle: usize = 0;

    while cycle < 10000 {
        let mut weak = shared_downgrade(
            ref value
        );

        if shared_weak_count(
            ref value
        ) != 1 {
            give false;
        }

        if not shared_weak_drop(
            ref mut weak
        ) {
            give false;
        }

        if shared_weak_count(
            ref value
        ) != 0 {
            give false;
        }

        set cycle = cycle + 1;
    }

    give true;
}

proc test_upgrade_stress() -> bool {
    let value = shared_new(42);

    let weak = shared_downgrade(
        ref value
    );

    let cycle: usize = 0;

    while cycle < 10000 {
        let result = shared_upgrade(
            ref weak
        );

        pick result {
            Some(copy) {
                let mut temp = copy;

                if shared_strong_count(
                    ref value
                ) != 2 {
                    give false;
                }

                if not shared_drop(
                    ref mut temp
                ) {
                    give false;
                }
            }

            None {
                give false;
            }
        }

        if shared_strong_count(
            ref value
        ) != 1 {
            give false;
        }

        set cycle = cycle + 1;
    }

    give true;
}

proc test_many_shared_values() -> bool {
    let values: [Shared<int>] = [];

    let index: usize = 0;

    while index < 1000 {
        set values =
            values + [
                shared_new(
                    index as int
                )
            ];

        set index = index + 1;
    }

    let check: usize = 0;

    while check < 1000 {
        if *shared_get(
            ref values[check]
        ) != check as int
        {
            give false;
        }

        if shared_strong_count(
            ref values[check]
        ) != 1 {
            give false;
        }

        if not shared_is_unique(
            ref values[check]
        ) {
            give false;
        }

        set check = check + 1;
    }

    give true;
}

proc test_many_points() -> bool {
    let values: [Shared<Point>] = [];

    let index: usize = 0;

    while index < 1000 {
        set values =
            values + [
                shared_new(
                    Point {
                        x: index as int
                        y: (index as int) + 1
                    }
                )
            ];

        set index = index + 1;
    }

    let check: usize = 0;

    while check < 1000 {
        let point =
            shared_get(
                ref values[check]
            );

        if point.x != check as int {
            give false;
        }

        if point.y
            != (check as int) + 1
        {
            give false;
        }

        set check = check + 1;
    }

    give true;
}

proc run_basic_tests() -> bool {
    give test_new()
        and test_get()
        and test_try_get()
        and test_point()
        and test_get_mut_unique()
        and test_point_mutation()
        and test_replace()

        and test_clone()
        and test_try_clone()
        and test_mutable_denied_when_shared()
        and test_drop_clone_restores_unique()
        and test_mutable_after_clone_drop()

        and test_downgrade()
        and test_try_downgrade()
        and test_upgrade()
        and test_weak_clone()
        and test_weak_drop()
        and test_weak_expires_after_final_strong_drop()
        and test_upgrade_expired_fails()

        and test_ptr_identity()
        and test_weak_ptr_identity()
        and test_identity()

        and test_profile_unique()
        and test_profile_shared()
        and test_weak_profile_alive()
        and test_weak_profile_expired()

        and test_validation()
        and test_weak_validation()
        and test_invariant()
        and test_weak_invariant()

        and test_snapshot_equal()
        and test_clone_changes_snapshot()
        and test_clone_delta()
        and test_downgrade_delta()

        and test_make_mut_unique()
        and test_make_mut_shared_detaches()
        and test_make_mut_point()

        and test_value_ptr()
        and test_value_ptr_mut()

        and test_state_names()
        and test_access_names()

        and test_statistics_empty()
        and test_statistics_create()
        and test_statistics_clone()
        and test_statistics_weak_create()
        and test_statistics_upgrade()
        and test_statistics_failure()
        and test_statistics_reset()

        and test_clone_drop_stress()
        and test_weak_stress()
        and test_upgrade_stress()
        and test_many_shared_values()
        and test_many_points();
}

proc main() -> int {
    if run_basic_tests() {
        give 0;
    }

    give 1;
}
