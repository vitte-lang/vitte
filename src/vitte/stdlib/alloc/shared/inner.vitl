space vitte/stdlib/alloc/shared/inner

export *

use src/vitte/stdlib/alloc/shared/core as shared_core
use src/vitte/stdlib/alloc/shared/count as shared_count
use src/vitte/stdlib/alloc/shared/error as shared_error
use src/vitte/stdlib/alloc/allocator as alloc_allocator
use src/vitte/stdlib/core/option as core_option

pick SharedInnerState {
    Alive,
    WeakOnly,
    Released,
    Invalid
}

pick SharedInnerAccess {
    None,
    Read,
    ReadWrite
}

form SharedInner<T> {
    value: T

    counts: shared_count.SharedCountPair

    allocation: alloc_allocator.Allocation

    value_alive: bool
    allocation_alive: bool

    generation: u64
    revision: u64
}

form SharedInnerHandle {
    generation: u64
    revision: u64
}

form SharedInnerProfile {
    strong: usize
    weak: usize

    state: SharedInnerState
    access: SharedInnerAccess

    value_alive: bool
    allocation_alive: bool

    unique: bool
    shared: bool
    weak_only: bool
    released: bool

    valid: bool

    generation: u64
    revision: u64
}

form SharedInnerValidation {
    valid: bool

    counts_valid: bool
    value_state_valid: bool
    allocation_state_valid: bool
    lifecycle_valid: bool
    generation_valid: bool
}

form SharedInnerSnapshot {
    strong: usize
    weak: usize

    value_alive: bool
    allocation_alive: bool

    state: SharedInnerState

    generation: u64
    revision: u64
}

form SharedInnerDelta {
    strong: int
    weak: int

    generation: int
    revision: int

    value_alive_changed: bool
    allocation_alive_changed: bool
    state_changed: bool

    changed: bool
}

form SharedInnerStatistics {
    creations: u64

    strong_clones: u64
    strong_drops: u64

    weak_clones: u64
    weak_drops: u64

    upgrades: u64
    downgrades: u64

    value_drops: u64
    allocation_releases: u64

    reads: u64
    writes: u64
    replacements: u64

    validations: u64
    failures: u64

    peak_strong: usize
    peak_weak: usize
    peak_total: usize
}

// -----------------------------------------------------------------------------
// Construction
// -----------------------------------------------------------------------------

proc shared_inner_new<T>(
    value: T,
    allocation: alloc_allocator.Allocation
) -> SharedInner<T> {
    give SharedInner<T> {
        value:
            value,

        counts:
            shared_count.shared_count_pair_new(),

        allocation:
            allocation,

        value_alive:
            true,

        allocation_alive:
            true,

        generation:
            1,

        revision:
            1
    };
}

proc shared_inner_from_counts<T>(
    value: T,
    allocation: alloc_allocator.Allocation,
    counts: shared_count.SharedCountPair
) -> SharedInner<T> {
    let strong =
        shared_count.shared_count_pair_strong(
            counts
        );

    let weak =
        shared_count.shared_count_pair_weak(
            counts
        );

    give SharedInner<T> {
        value:
            value,

        counts:
            counts,

        allocation:
            allocation,

        value_alive:
            strong > 0,

        allocation_alive:
            strong > 0
            or weak > 0,

        generation:
            1,

        revision:
            1
    };
}

// -----------------------------------------------------------------------------
// Counts
// -----------------------------------------------------------------------------

proc shared_inner_strong_count<T>(
    inner: ref SharedInner<T>
) -> usize {
    give shared_count.shared_count_pair_strong(
        inner.counts
    );
}

proc shared_inner_weak_count<T>(
    inner: ref SharedInner<T>
) -> usize {
    give shared_count.shared_count_pair_weak(
        inner.counts
    );
}

proc shared_inner_total_count<T>(
    inner: ref SharedInner<T>
) -> usize {
    give shared_count.shared_count_pair_total(
        inner.counts
    );
}

// -----------------------------------------------------------------------------
// Metadata
// -----------------------------------------------------------------------------

proc shared_inner_generation<T>(
    inner: ref SharedInner<T>
) -> u64 {
    give inner.generation;
}

proc shared_inner_revision<T>(
    inner: ref SharedInner<T>
) -> u64 {
    give inner.revision;
}

proc shared_inner_touch<T>(
    inner: ref mut SharedInner<T>
) {
    set inner.revision =
        inner.revision + 1;
}

proc shared_inner_advance_generation<T>(
    inner: ref mut SharedInner<T>
) -> u64 {
    set inner.generation =
        inner.generation + 1;

    set inner.revision =
        inner.revision + 1;

    give inner.generation;
}

// -----------------------------------------------------------------------------
// State
// -----------------------------------------------------------------------------

proc shared_inner_state<T>(
    inner: ref SharedInner<T>
) -> SharedInnerState {
    if not inner.allocation_alive {
        if inner.value_alive {
            give SharedInnerState.Invalid;
        }

        give SharedInnerState.Released;
    }

    let strong =
        shared_inner_strong_count(
            inner
        );

    let weak =
        shared_inner_weak_count(
            inner
        );

    if inner.value_alive {
        if strong == 0 {
            give SharedInnerState.Invalid;
        }

        give SharedInnerState.Alive;
    }

    if strong > 0 {
        give SharedInnerState.Invalid;
    }

    if weak > 0 {
        give SharedInnerState.WeakOnly;
    }

    give SharedInnerState.Invalid;
}

proc shared_inner_access<T>(
    inner: ref SharedInner<T>
) -> SharedInnerAccess {
    if not inner.value_alive
        or not inner.allocation_alive
    {
        give SharedInnerAccess.None;
    }

    let strong =
        shared_inner_strong_count(
            inner
        );

    if strong == 1 {
        give SharedInnerAccess.ReadWrite;
    }

    if strong > 1 {
        give SharedInnerAccess.Read;
    }

    give SharedInnerAccess.None;
}

// -----------------------------------------------------------------------------
// Predicates
// -----------------------------------------------------------------------------

proc shared_inner_is_alive<T>(
    inner: ref SharedInner<T>
) -> bool {
    give inner.value_alive
        and inner.allocation_alive
        and shared_inner_strong_count(inner) > 0;
}

proc shared_inner_is_unique<T>(
    inner: ref SharedInner<T>
) -> bool {
    give shared_inner_is_alive(inner)
        and shared_inner_strong_count(inner) == 1;
}

proc shared_inner_is_shared<T>(
    inner: ref SharedInner<T>
) -> bool {
    give shared_inner_is_alive(inner)
        and shared_inner_strong_count(inner) > 1;
}

proc shared_inner_is_weak_only<T>(
    inner: ref SharedInner<T>
) -> bool {
    give inner.allocation_alive
        and not inner.value_alive
        and shared_inner_strong_count(inner) == 0
        and shared_inner_weak_count(inner) > 0;
}

proc shared_inner_is_released<T>(
    inner: ref SharedInner<T>
) -> bool {
    give not inner.allocation_alive;
}

proc shared_inner_can_read<T>(
    inner: ref SharedInner<T>
) -> bool {
    let access =
        shared_inner_access(
            inner
        );

    give access == SharedInnerAccess.Read
        or access == SharedInnerAccess.ReadWrite;
}

proc shared_inner_can_write<T>(
    inner: ref SharedInner<T>
) -> bool {
    give shared_inner_access(inner)
        == SharedInnerAccess.ReadWrite;
}

proc shared_inner_can_upgrade<T>(
    inner: ref SharedInner<T>
) -> bool {
    give inner.value_alive
        and inner.allocation_alive
        and shared_inner_strong_count(inner) > 0
        and shared_inner_weak_count(inner) > 0;
}

proc shared_inner_should_drop_value<T>(
    inner: ref SharedInner<T>
) -> bool {
    give inner.value_alive
        and shared_inner_strong_count(inner) == 0;
}

proc shared_inner_should_release<T>(
    inner: ref SharedInner<T>
) -> bool {
    give inner.allocation_alive
        and shared_inner_strong_count(inner) == 0
        and shared_inner_weak_count(inner) == 0;
}

// -----------------------------------------------------------------------------
// Handle
// -----------------------------------------------------------------------------

proc shared_inner_handle<T>(
    inner: ref SharedInner<T>
) -> SharedInnerHandle {
    give SharedInnerHandle {
        generation:
            inner.generation,

        revision:
            inner.revision
    };
}

proc shared_inner_handle_valid<T>(
    inner: ref SharedInner<T>,
    handle: SharedInnerHandle
) -> bool {
    give inner.allocation_alive
        and inner.generation
            == handle.generation;
}

proc shared_inner_handle_current<T>(
    inner: ref SharedInner<T>,
    handle: SharedInnerHandle
) -> bool {
    give shared_inner_handle_valid(
        inner,
        handle
    )
    and inner.revision
        == handle.revision;
}

// -----------------------------------------------------------------------------
// Strong operations
// -----------------------------------------------------------------------------

proc shared_inner_clone_strong<T>(
    inner: ref mut SharedInner<T>
) -> bool {
    if not inner.value_alive
        or not inner.allocation_alive
    {
        give false;
    }

    let error =
        shared_error.shared_error_for_strong_clone(
            inner.counts
        );

    if not shared_error.shared_error_is_none(
        error
    ) {
        give false;
    }

    if not shared_count.shared_count_strong_clone(
        ref mut inner.counts
    ) {
        give false;
    }

    set inner.revision =
        inner.revision + 1;

    give true;
}

proc shared_inner_drop_strong<T>(
    inner: ref mut SharedInner<T>
) -> bool {
    if not inner.allocation_alive {
        give false;
    }

    let before =
        inner.counts;

    let error =
        shared_error.shared_error_for_strong_drop(
            inner.counts
        );

    if not shared_error.shared_error_is_none(
        error
    ) {
        give false;
    }

    if not shared_count.shared_count_strong_drop(
        ref mut inner.counts
    ) {
        give false;
    }

    let after =
        inner.counts;

    set inner.revision =
        inner.revision + 1;

    if shared_count.shared_count_should_drop_value(
        before,
        after
    ) {
        shared_inner_drop_value(
            inner
        );
    }

    if shared_count.shared_count_should_release_control(
        inner.counts
    ) {
        shared_inner_release_allocation(
            inner
        );
    }

    give true;
}

// -----------------------------------------------------------------------------
// Weak operations
// -----------------------------------------------------------------------------

proc shared_inner_clone_weak<T>(
    inner: ref mut SharedInner<T>
) -> bool {
    if not inner.allocation_alive {
        give false;
    }

    let error =
        shared_error.shared_error_for_weak_clone(
            inner.counts
        );

    if not shared_error.shared_error_is_none(
        error
    ) {
        give false;
    }

    if not shared_count.shared_count_weak_clone(
        ref mut inner.counts
    ) {
        give false;
    }

    set inner.revision =
        inner.revision + 1;

    give true;
}

proc shared_inner_drop_weak<T>(
    inner: ref mut SharedInner<T>
) -> bool {
    if not inner.allocation_alive {
        give false;
    }

    let error =
        shared_error.shared_error_for_weak_drop(
            inner.counts
        );

    if not shared_error.shared_error_is_none(
        error
    ) {
        give false;
    }

    if not shared_count.shared_count_weak_drop(
        ref mut inner.counts
    ) {
        give false;
    }

    set inner.revision =
        inner.revision + 1;

    if shared_count.shared_count_should_release_control(
        inner.counts
    ) {
        shared_inner_release_allocation(
            inner
        );
    }

    give true;
}

// -----------------------------------------------------------------------------
// Downgrade
// -----------------------------------------------------------------------------

proc shared_inner_downgrade<T>(
    inner: ref mut SharedInner<T>
) -> bool {
    if not inner.value_alive
        or not inner.allocation_alive
    {
        give false;
    }

    let error =
        shared_error.shared_error_for_downgrade(
            inner.counts
        );

    if not shared_error.shared_error_is_none(
        error
    ) {
        give false;
    }

    if not shared_count.shared_count_downgrade(
        ref mut inner.counts
    ) {
        give false;
    }

    set inner.revision =
        inner.revision + 1;

    give true;
}

// -----------------------------------------------------------------------------
// Upgrade
// -----------------------------------------------------------------------------

proc shared_inner_upgrade<T>(
    inner: ref mut SharedInner<T>
) -> bool {
    if not inner.value_alive
        or not inner.allocation_alive
    {
        give false;
    }

    let error =
        shared_error.shared_error_for_upgrade(
            inner.counts
        );

    if not shared_error.shared_error_is_none(
        error
    ) {
        give false;
    }

    if not shared_count.shared_count_upgrade(
        ref mut inner.counts
    ) {
        give false;
    }

    set inner.revision =
        inner.revision + 1;

    give true;
}

// -----------------------------------------------------------------------------
// Value access
// -----------------------------------------------------------------------------

proc shared_inner_get<T>(
    inner: ref SharedInner<T>
) -> Option<ref T> {
    if not shared_inner_can_read(
        inner
    ) {
        give none<ref T>();
    }

    give some<ref T>(
        ref inner.value
    );
}

proc shared_inner_get_mut<T>(
    inner: ref mut SharedInner<T>
) -> Option<ref mut T> {
    if not shared_inner_can_write(
        inner
    ) {
        give none<ref mut T>();
    }

    give some<ref mut T>(
        ref mut inner.value
    );
}

// -----------------------------------------------------------------------------
// Replacement
// -----------------------------------------------------------------------------

proc shared_inner_replace<T>(
    inner: ref mut SharedInner<T>,
    value: T
) -> bool {
    if not shared_inner_can_write(
        inner
    ) {
        give false;
    }

    let error =
        shared_error.shared_error_for_replace(
            inner.counts
        );

    if not shared_error.shared_error_is_none(
        error
    ) {
        give false;
    }

    compiler_drop_in_place<T>(
        ref mut inner.value
    );

    set inner.value =
        value;

    set inner.revision =
        inner.revision + 1;

    give true;
}

// -----------------------------------------------------------------------------
// Value drop
// -----------------------------------------------------------------------------

proc shared_inner_drop_value<T>(
    inner: ref mut SharedInner<T>
) -> bool {
    if not inner.value_alive {
        give false;
    }

    if shared_inner_strong_count(
        inner
    ) != 0 {
        give false;
    }

    compiler_drop_in_place<T>(
        ref mut inner.value
    );

    set inner.value_alive =
        false;

    set inner.generation =
        inner.generation + 1;

    set inner.revision =
        inner.revision + 1;

    give true;
}

// -----------------------------------------------------------------------------
// Allocation release
// -----------------------------------------------------------------------------

proc shared_inner_release_allocation<T>(
    inner: ref mut SharedInner<T>
) -> bool {
    if not inner.allocation_alive {
        give false;
    }

    if shared_inner_strong_count(inner) != 0
        or shared_inner_weak_count(inner) != 0
    {
        give false;
    }

    if inner.value_alive {
        give false;
    }

    set inner.allocation_alive =
        false;

    set inner.generation =
        inner.generation + 1;

    set inner.revision =
        inner.revision + 1;

    give true;
}

// -----------------------------------------------------------------------------
// Finalization
// -----------------------------------------------------------------------------

proc shared_inner_finalize<T>(
    inner: ref mut SharedInner<T>
) {
    if shared_inner_should_drop_value(
        inner
    ) {
        shared_inner_drop_value(
            inner
        );
    }

    if shared_inner_should_release(
        inner
    ) {
        shared_inner_release_allocation(
            inner
        );
    }
}

// -----------------------------------------------------------------------------
// Core conversion
// -----------------------------------------------------------------------------

proc shared_inner_core_counts<T>(
    inner: ref SharedInner<T>
) -> shared_core.SharedCoreCounts {
    give shared_count.shared_count_core(
        inner.counts
    );
}

proc shared_inner_core_profile<T>(
    inner: ref SharedInner<T>
) -> shared_core.SharedCoreProfile {
    give shared_core.shared_core_profile(
        shared_inner_core_counts(
            inner
        ),
        shared_core.SharedCoreMeta {
            generation:
                inner.generation,

            revision:
                inner.revision
        }
    );
}

// -----------------------------------------------------------------------------
// Validation
// -----------------------------------------------------------------------------

proc shared_inner_validate<T>(
    inner: ref SharedInner<T>
) -> SharedInnerValidation {
    let counts_valid =
        shared_count.shared_count_pair_valid(
            inner.counts
        );

    let strong =
        shared_inner_strong_count(
            inner
        );

    let weak =
        shared_inner_weak_count(
            inner
        );

    let value_state_valid =
        if inner.value_alive {
            strong > 0
        } else {
            strong == 0
        };

    let allocation_state_valid =
        if inner.allocation_alive {
            strong > 0
            or weak > 0
        } else {
            strong == 0
            and weak == 0
        };

    let lifecycle_valid =
        if strong > 0 {
            inner.value_alive
            and inner.allocation_alive
        } else if weak > 0 {
            not inner.value_alive
            and inner.allocation_alive
        } else {
            not inner.value_alive
            and not inner.allocation_alive
        };

    let generation_valid =
        inner.generation > 0
        and inner.revision > 0;

    give SharedInnerValidation {
        valid:
            counts_valid
            and value_state_valid
            and allocation_state_valid
            and lifecycle_valid
            and generation_valid,

        counts_valid:
            counts_valid,

        value_state_valid:
            value_state_valid,

        allocation_state_valid:
            allocation_state_valid,

        lifecycle_valid:
            lifecycle_valid,

        generation_valid:
            generation_valid
    };
}

proc shared_inner_is_valid<T>(
    inner: ref SharedInner<T>
) -> bool {
    give shared_inner_validate(
        inner
    ).valid;
}

proc shared_inner_invariant_holds<T>(
    inner: ref SharedInner<T>
) -> bool {
    give shared_inner_is_valid(
        inner
    );
}

// -----------------------------------------------------------------------------
// Error mapping
// -----------------------------------------------------------------------------

proc shared_inner_error<T>(
    inner: ref SharedInner<T>
) -> shared_error.SharedError {
    let validation =
        shared_inner_validate(
            inner
        );

    if validation.valid {
        give shared_error.shared_error_none();
    }

    if not validation.counts_valid {
        give shared_error.shared_error_from_count_pair(
            inner.counts
        );
    }

    if not validation.value_state_valid {
        give shared_error.shared_error_simple(
            shared_error.SharedErrorKind.InvalidState,
            "shared value lifetime does not match strong count"
        );
    }

    if not validation.allocation_state_valid {
        give shared_error.shared_error_simple(
            shared_error.SharedErrorKind.InvalidControlBlock,
            "shared allocation lifetime is invalid"
        );
    }

    if not validation.lifecycle_valid {
        give shared_error.shared_error_simple(
            shared_error.SharedErrorKind.InvalidState,
            "shared lifecycle invariant is invalid"
        );
    }

    if not validation.generation_valid {
        give shared_error.shared_error_internal(
            "shared generation metadata is invalid"
        );
    }

    give shared_error.shared_error_internal(
        "unknown shared inner validation failure"
    );
}

// -----------------------------------------------------------------------------
// Profile
// -----------------------------------------------------------------------------

proc shared_inner_profile<T>(
    inner: ref SharedInner<T>
) -> SharedInnerProfile {
    let strong =
        shared_inner_strong_count(
            inner
        );

    let weak =
        shared_inner_weak_count(
            inner
        );

    let state =
        shared_inner_state(
            inner
        );

    give SharedInnerProfile {
        strong:
            strong,

        weak:
            weak,

        state:
            state,

        access:
            shared_inner_access(
                inner
            ),

        value_alive:
            inner.value_alive,

        allocation_alive:
            inner.allocation_alive,

        unique:
            strong == 1
            and inner.value_alive,

        shared:
            strong > 1
            and inner.value_alive,

        weak_only:
            strong == 0
            and weak > 0
            and not inner.value_alive,

        released:
            not inner.allocation_alive,

        valid:
            shared_inner_is_valid(
                inner
            ),

        generation:
            inner.generation,

        revision:
            inner.revision
    };
}

// -----------------------------------------------------------------------------
// Snapshot
// -----------------------------------------------------------------------------

proc shared_inner_snapshot<T>(
    inner: ref SharedInner<T>
) -> SharedInnerSnapshot {
    give SharedInnerSnapshot {
        strong:
            shared_inner_strong_count(
                inner
            ),

        weak:
            shared_inner_weak_count(
                inner
            ),

        value_alive:
            inner.value_alive,

        allocation_alive:
            inner.allocation_alive,

        state:
            shared_inner_state(
                inner
            ),

        generation:
            inner.generation,

        revision:
            inner.revision
    };
}

proc shared_inner_snapshot_equal(
    left: SharedInnerSnapshot,
    right: SharedInnerSnapshot
) -> bool {
    give left.strong == right.strong
        and left.weak == right.weak
        and left.value_alive == right.value_alive
        and left.allocation_alive == right.allocation_alive
        and left.state == right.state
        and left.generation == right.generation
        and left.revision == right.revision;
}

proc shared_inner_snapshot_changed(
    left: SharedInnerSnapshot,
    right: SharedInnerSnapshot
) -> bool {
    give not shared_inner_snapshot_equal(
        left,
        right
    );
}

// -----------------------------------------------------------------------------
// Delta
// -----------------------------------------------------------------------------

proc shared_inner_usize_delta(
    before: usize,
    after: usize
) -> int {
    if after > before {
        give (after - before) as int;
    }

    if after < before {
        give -((before - after) as int);
    }

    give 0;
}

proc shared_inner_u64_delta(
    before: u64,
    after: u64
) -> int {
    if after > before {
        give (after - before) as int;
    }

    if after < before {
        give -((before - after) as int);
    }

    give 0;
}

proc shared_inner_delta(
    before: SharedInnerSnapshot,
    after: SharedInnerSnapshot
) -> SharedInnerDelta {
    let strong =
        shared_inner_usize_delta(
            before.strong,
            after.strong
        );

    let weak =
        shared_inner_usize_delta(
            before.weak,
            after.weak
        );

    let generation =
        shared_inner_u64_delta(
            before.generation,
            after.generation
        );

    let revision =
        shared_inner_u64_delta(
            before.revision,
            after.revision
        );

    let value_alive_changed =
        before.value_alive
            != after.value_alive;

    let allocation_alive_changed =
        before.allocation_alive
            != after.allocation_alive;

    let state_changed =
        before.state
            != after.state;

    give SharedInnerDelta {
        strong:
            strong,

        weak:
            weak,

        generation:
            generation,

        revision:
            revision,

        value_alive_changed:
            value_alive_changed,

        allocation_alive_changed:
            allocation_alive_changed,

        state_changed:
            state_changed,

        changed:
            strong != 0
            or weak != 0
            or generation != 0
            or revision != 0
            or value_alive_changed
            or allocation_alive_changed
            or state_changed
    };
}

proc shared_inner_delta_is_zero(
    delta: SharedInnerDelta
) -> bool {
    give not delta.changed;
}

// -----------------------------------------------------------------------------
// Statistics
// -----------------------------------------------------------------------------

proc shared_inner_statistics_empty()
    -> SharedInnerStatistics
{
    give SharedInnerStatistics {
        creations: 0,

        strong_clones: 0,
        strong_drops: 0,

        weak_clones: 0,
        weak_drops: 0,

        upgrades: 0,
        downgrades: 0,

        value_drops: 0,
        allocation_releases: 0,

        reads: 0,
        writes: 0,
        replacements: 0,

        validations: 0,
        failures: 0,

        peak_strong: 1,
        peak_weak: 0,
        peak_total: 1
    };
}

proc shared_inner_statistics_update_peaks<T>(
    statistics: ref mut SharedInnerStatistics,
    inner: ref SharedInner<T>
) {
    let strong =
        shared_inner_strong_count(
            inner
        );

    let weak =
        shared_inner_weak_count(
            inner
        );

    let total =
        shared_inner_total_count(
            inner
        );

    if strong > statistics.peak_strong {
        set statistics.peak_strong =
            strong;
    }

    if weak > statistics.peak_weak {
        set statistics.peak_weak =
            weak;
    }

    if total > statistics.peak_total {
        set statistics.peak_total =
            total;
    }
}

proc shared_inner_statistics_record_create<T>(
    statistics: ref mut SharedInnerStatistics,
    inner: ref SharedInner<T>
) {
    set statistics.creations =
        statistics.creations + 1;

    shared_inner_statistics_update_peaks(
        statistics,
        inner
    );
}

proc shared_inner_statistics_record_strong_clone<T>(
    statistics: ref mut SharedInnerStatistics,
    inner: ref SharedInner<T>,
    success: bool
) {
    if success {
        set statistics.strong_clones =
            statistics.strong_clones + 1;

        shared_inner_statistics_update_peaks(
            statistics,
            inner
        );
    } else {
        set statistics.failures =
            statistics.failures + 1;
    }
}

proc shared_inner_statistics_record_strong_drop(
    statistics: ref mut SharedInnerStatistics,
    success: bool
) {
    if success {
        set statistics.strong_drops =
            statistics.strong_drops + 1;
    } else {
        set statistics.failures =
            statistics.failures + 1;
    }
}

