) {
    if success {
        set statistics.value_drops =
            statistics.value_drops + 1;
    } else {
        set statistics.failures =
            statistics.failures + 1;
    }
}

proc shared_inner_statistics_record_allocation_release(
    statistics: ref mut SharedInnerStatistics,
    success: bool
) {
    if success {
        set statistics.allocation_releases =
            statistics.allocation_releases + 1;
    } else {
        set statistics.failures =
            statistics.failures + 1;
    }
}

proc shared_inner_statistics_record_read(
    statistics: ref mut SharedInnerStatistics,
    success: bool
) {
    if success {
        set statistics.reads =
            statistics.reads + 1;
    } else {
        set statistics.failures =
            statistics.failures + 1;
    }
}

proc shared_inner_statistics_record_write(
    statistics: ref mut SharedInnerStatistics,
    success: bool
) {
    if success {
        set statistics.writes =
            statistics.writes + 1;
    } else {
        set statistics.failures =
            statistics.failures + 1;
    }
}

proc shared_inner_statistics_record_replace(
    statistics: ref mut SharedInnerStatistics,
    success: bool
) {
    if success {
        set statistics.replacements =
            statistics.replacements + 1;
    } else {
        set statistics.failures =
            statistics.failures + 1;
    }
}

proc shared_inner_statistics_record_validation(
    statistics: ref mut SharedInnerStatistics,
    valid: bool
) {
    set statistics.validations =
        statistics.validations + 1;

    if not valid {
        set statistics.failures =
            statistics.failures + 1;
    }
}

proc shared_inner_statistics_total(
    statistics: SharedInnerStatistics
) -> u64 {
    give statistics.creations
        + statistics.strong_clones
        + statistics.strong_drops
        + statistics.weak_clones
        + statistics.weak_drops
        + statistics.upgrades
        + statistics.downgrades
        + statistics.value_drops
        + statistics.allocation_releases
        + statistics.reads
        + statistics.writes
        + statistics.replacements
        + statistics.validations
        + statistics.failures;
}

proc shared_inner_statistics_reset(
    statistics: ref mut SharedInnerStatistics
) {
    set *statistics =
        shared_inner_statistics_empty();
}

// -----------------------------------------------------------------------------
// Names
// -----------------------------------------------------------------------------

proc shared_inner_state_name(
    state: SharedInnerState
) -> string {
    pick state {
        SharedInnerState.Alive {
            give "alive";
        }

        SharedInnerState.WeakOnly {
            give "weak-only";
        }

        SharedInnerState.Released {
            give "released";
        }

        SharedInnerState.Invalid {
            give "invalid";
        }
    }

    give "invalid";
}

proc shared_inner_access_name(
    access: SharedInnerAccess
) -> string {
    pick access {
        SharedInnerAccess.None {
            give "none";
        }

        SharedInnerAccess.Read {
            give "read";
        }

        SharedInnerAccess.ReadWrite {
            give "read-write";
        }
    }

    give "none";
}

// -----------------------------------------------------------------------------
// Shared inner model
// -----------------------------------------------------------------------------
//
// SharedInner<T> is the concrete control block for shared ownership.
//
// Layout:
//
//     SharedInner<T>
//     +----------------------------------+
//     | value: T                         |
//     |                                  |
//     | strong count                     |
//     | weak count                       |
//     |                                  |
//     | allocation                       |
//     |                                  |
//     | value_alive                      |
//     | allocation_alive                 |
//     |                                  |
//     | generation                       |
//     | revision                         |
//     +----------------------------------+
//
// Initial state:
//
//     strong = 1
//     weak   = 0
//
//     value_alive      = true
//     allocation_alive = true
//
// -----------------------------------------------------------------------------
//
// Strong clone:
//
//     strong++
//
// Shared ownership:
//
//     strong > 1
//
// Unique ownership:
//
//     strong == 1
//
// -----------------------------------------------------------------------------
//
// Downgrade:
//
//     weak++
//
// The strong reference remains alive.
//
// -----------------------------------------------------------------------------
//
// Upgrade:
//
//     weak > 0
//     strong > 0
//
//     strong++
//
// Upgrade cannot resurrect a value after:
//
//     strong == 0
//
// -----------------------------------------------------------------------------
//
// Final strong drop:
//
//     strong: 1 -> 0
//
// then:
//
//     drop T
//     value_alive = false
//
// If weak references remain:
//
//     strong = 0
//     weak   > 0
//
// state:
//
//     WeakOnly
//
// The control allocation stays alive.
//
// -----------------------------------------------------------------------------
//
// Final weak drop:
//
//     strong = 0
//     weak: 1 -> 0
//
// then:
//
//     allocation_alive = false
//
// state:
//
//     Released
//
// -----------------------------------------------------------------------------
//
// Access:
//
//     strong == 1
//
//         ReadWrite
//
//     strong > 1
//
//         Read
//
//     strong == 0
//
//         None
//
// -----------------------------------------------------------------------------
//
// Generation:
//
//     changed when the managed value dies
//     changed when the control allocation dies
//
// This allows higher-level handles to detect stale references.
//
// Revision:
//
//     incremented on successful mutations.
//
// -----------------------------------------------------------------------------
//
// Handle:
//
//     SharedInnerHandle {
//         generation
//         revision
//     }
//
// Generation matching:
//
//     handle.generation == inner.generation
//
// indicates that the handle still belongs to the same lifetime generation.
//
// Revision matching additionally means no tracked mutation occurred since the
// handle was created.
//
// -----------------------------------------------------------------------------
//
// Fundamental invariants:
//
//     value_alive
//         => strong > 0
//
//     !value_alive
//         => strong == 0
//
//     allocation_alive
//         => strong > 0 or weak > 0
//
//     !allocation_alive
//         => strong == 0 and weak == 0
//
//     strong > 0
//         => value_alive
//         => allocation_alive
//
//     strong == 0 && weak > 0
//         => !value_alive
//         => allocation_alive
//
//     strong == 0 && weak == 0
//         => !value_alive
//         => !allocation_alive
//
//     mutable access
//         => strong == 1
//
//     shared read access
//         => strong > 0
//
//     weak upgrade
//         => strong > 0
//         => weak > 0
//
// -----------------------------------------------------------------------------
//
// Module responsibilities:
//
//     core.vitl
//         pure ownership state machine
//
//     count.vitl
//         concrete strong/weak counters
//
//     error.vitl
//         normalized failure model
//
//     inner.vitl
//         concrete value + control-block lifecycle
//
// Higher-level modules can build:
//
//     Shared<T>
//     SharedWeak<T>
//     strong handles
//     weak handles
//     raw pointer interfaces
//
// on top of this control block.
