/// =========================================================================
/// Configuration
/// =========================================================================

const API_MAX_SOURCE_SIZE: usize = 1073741824 as u64;
const API_MAX_PATH_LENGTH: usize = 32768;
const API_INITIAL_OUTPUT_CAPACITY: usize = 4096;
const API_INITIAL_FILE_CAPACITY: usize = 8192;
const API_MODULE_MAX_DEPTH: usize = 128;

const API_RESULT_MAGIC: u64 = 0x5649545445524553;
const API_CONTEXT_MAGIC: u64 = 0x5649545445435458;

// Keep this as a C constant expression understood by both compiler backends.
const API_SIZE_MAX_VALUE: usize = (0 as usize) - 1;


/// Host operating-system boundary. The API and file-loading policy remain
/// implemented here in Vitte; these declarations call only the C runtime's
/// standard file and allocation primitives, never the C bootstrap API.
extern proc vitte_native_api_file_open(path: *mut u8, mode: *mut u8) -> *mut u8;
extern proc vitte_native_api_file_read(data: *mut u8, element_size: usize, element_count: usize, file: *mut u8) -> usize;
extern proc vitte_native_api_file_error(file: *mut u8) -> i32;
extern proc vitte_native_api_file_close(file: *mut u8) -> i32;
extern proc vitte_native_api_allocate(size: usize) -> *mut u8;
extern proc vitte_native_api_deallocate(pointer: *mut u8);
extern proc vitte_native_api_bytes_to_string(data: *mut u8, length: usize) -> ?string;
extern proc vitte_native_environment_value(name: string) -> ?str;
extern proc vitte_native_write_stdout(data: *const char, length: usize);
extern proc vitte_native_write_stderr(data: *const char, length: usize);
extern proc vitte_native_write_stdout_bytes(data: *const u8, length: usize);
extern proc vitte_native_write_stderr_bytes(data: *const u8, length: usize);
extern proc vitte_native_write_file(path: string, data: *const u8, length: usize) -> i32;


/// =========================================================================
/// API state
/// =========================================================================

export pick ApiState {
    Uninitialized,
    Ready,
    Compiling,
    Failed,
    Destroyed,
}


/// =========================================================================
/// Internal byte buffer
/// =========================================================================

form ApiBuffer {
    data: [u8],
    length: usize,
    capacity: usize,
}

form ApiModuleExpansion {
    output: ApiBuffer,
    active_paths: [string],
    loaded_paths: [string],
}


/// =========================================================================
/// Public compilation result
/// =========================================================================

export form ApiResult {
    magic: u64,

    status: Status,

    source_name: string,

    output: [u8],
    output_size: usize,

    diagnostics: [u8],
    diagnostics_size: usize,

    owns_source_name: bool,

    error_count: usize,
    warning_count: usize,
    note_count: usize,

    succeeded: bool,
}


/// =========================================================================
/// API context
/// =========================================================================

export form Api {
    magic: u64,

    state: ApiState,

    context: Context,

    compilation_count: usize,
    successful_compilation_count: usize,
    failed_compilation_count: usize,

    last_error: Error,
}


/// =========================================================================
/// Integer safety
/// =========================================================================

proc size_add_overflow(
    a: usize,
    b: usize,
    result: &mut usize
) -> bool {
    if a > API_SIZE_MAX_VALUE - b {
        return true;
    }

    set *result = a + b;

    return false;
}

proc size_mul_overflow(
    a: usize,
    b: usize,
    result: &mut usize
) -> bool {
    if a != 0  and  b > API_SIZE_MAX_VALUE / a {
        return true;
    }

    set *result = a * b;

    return false;
}


/// =========================================================================
/// Text utilities
/// =========================================================================

proc path_is_valid(path: str) -> bool {
    let length: usize = path.length;
    if length == 0 {
        return false;
    }

    if length >= API_MAX_PATH_LENGTH {
        return false;
    }

    let mut index: usize = 0;
    while index < length {
        if path[index] == '\0' {
            return false;
        }

        set index += 1;
    }

    return true;
}

proc c_string_copy(text: str) -> *mut u8 {
    let text_bytes: [u8] = text.bytes();
    let mut allocation_size: usize = 0;
    if size_add_overflow(text_bytes.length, 1, &mut allocation_size) {
        return null;
    }

    let output: *mut u8 = vitte_native_api_allocate(allocation_size);
    if output == null {
        return null;
    }

    let mut index: usize = 0;
    while index < text_bytes.length {
        set output[index] = text_bytes[index];
        set index += 1;
    }
    set output[index] = 0;

    return output;
}

proc duplicate_string_n(
    text: str,
    length: usize
) -> ?string {
    let mut allocation_size: usize = 0;

    if size_add_overflow(
        length,
        1,
        &mut allocation_size
    ) {
        return null;
    }

    let mut result: string = "";

    if length != 0 {
        set result = string.from_bytes(
            text,
            length
        );
    }

    return result;
}

proc duplicate_string(text: str) -> ?string {
    return duplicate_string_n(
        text,
        text.length
    );
}


/// =========================================================================
/// Global error propagation
/// =========================================================================

proc set_last_error(
    status: Status,
    code: str,
    message: str
) {
    let mut error: Error = error_ok();
    set error.status = status;
    set error.code = code;
    set error.message = message;
    set error.details = "";

    error_set_last(&error);
}


/// =========================================================================
/// Byte buffer
/// =========================================================================

proc buffer_init(buffer: &mut ApiBuffer) {
    set buffer.data = [];
    set buffer.length = 0;
    set buffer.capacity = 0;
}

proc buffer_destroy(buffer: &mut ApiBuffer) {
    if buffer.capacity != 0 {
        vitte_native_api_deallocate(buffer.data.as_ptr() as *mut u8);
    }
    set buffer.data = [];
    set buffer.length = 0;
    set buffer.capacity = 0;
}

proc buffer_reserve(
    buffer: &mut ApiBuffer,
    required: usize
) -> bool {
    if required <= buffer.capacity {
        return true;
    }

    let mut new_capacity: usize = buffer.capacity;

    if new_capacity == 0 {
        set new_capacity = API_INITIAL_OUTPUT_CAPACITY;
    }

    while new_capacity < required {
        if new_capacity > API_SIZE_MAX_VALUE / 2 {
            set new_capacity = required;
            break;
        }

        let next: usize = new_capacity * 2;

        if next <= new_capacity {
            set new_capacity = required;
            break;
        }

        set new_capacity = next;
    }

    if new_capacity < required {
        return false;
    }

    if not buffer.data.reserve(new_capacity) {
        return false;
    }

    set buffer.capacity = new_capacity;

    return true;
}

proc buffer_append(
    buffer: &mut ApiBuffer,
    data: [u8],
    length: usize
) -> bool {
    if length == 0 {
        return true;
    }

    let mut required: usize = 0;

    if size_add_overflow(
        buffer.length,
        length,
        &mut required
    ) {
        return false;
    }

    if not buffer_reserve(
        buffer,
        required
    ) {
        return false;
    }

    let mut index: usize = 0;
    while index < length {
        if not buffer.data.push(data[index]) {
            return false;
        }
        set index += 1;
    }

    set buffer.length = required;

    return true;
}

proc buffer_append_byte(
    buffer: &mut ApiBuffer,
    value: u8
) -> bool {
    let mut required: usize = 0;

    if size_add_overflow(
        buffer.length,
        1,
        &mut required
    ) {
        return false;
    }

    if not buffer_reserve(
        buffer,
        required
    ) {
        return false;
    }

    if not buffer.data.push(value) {
        return false;
    }

    set buffer.length += 1;

    return true;
}

proc buffer_append_range(
    buffer: &mut ApiBuffer,
    data: str,
    start: usize,
    end: usize
) -> bool {
    if start > end or end > data.len() {
        return false;
    }
    let mut index = start;
    while index < end {
        if not buffer_append_byte(buffer, data[index] as u8) {
            return false;
        }
        set index += 1;
    }
    return true;
}

proc api_module_append_text(buffer: &mut ApiBuffer, text: str) -> bool {
    let bytes = text.as_bytes();
    let mut index: usize = 0;
    while index < bytes.len() {
        if not buffer_append_byte(buffer, bytes[index] as u8) {
            return false;
        }
        set index += 1;
    }
    return true;
}

proc api_module_normalize_path(path: str) -> ?string {
    let normalized: string = vitte_filesystem_normalize(path);
    if normalized.len() == 0 { return null; }
    return normalized;
}

proc api_module_try_root(root: str, relative: str) -> ?string {
    let root_bytes = root.as_bytes();
    let mut base = relative;
    if root.len() != 0 and root != "." {
        if root_bytes[root_bytes.len() - 1] == 47 or
           root_bytes[root_bytes.len() - 1] == 92 {
            set base = root + relative;
        } else {
            set base = root + "/" + relative;
        }
    }

    let candidate_a = base + ".vitte";
    if vitte_filesystem_is_file(candidate_a) {
        return api_module_normalize_path(candidate_a);
    }
    let candidate_b = base + ".vit";
    if vitte_filesystem_is_file(candidate_b) {
        return api_module_normalize_path(candidate_b);
    }
    let candidate_c = base + "/mod.vitte";
    if vitte_filesystem_is_file(candidate_c) {
        return api_module_normalize_path(candidate_c);
    }
    let candidate_d = base + "/mod.vit";
    if vitte_filesystem_is_file(candidate_d) {
        return api_module_normalize_path(candidate_d);
    }
    return null;
}

proc api_module_import_path(name: str) -> string {
    let bytes = name.as_bytes();
    let mut path: string = "";
    let mut index: usize = 0;
    while index < bytes.len() {
        if index + 1 < bytes.len() and bytes[index] == 58 and bytes[index + 1] == 58 {
            set path += "/";
            set index += 2;
        } else {
            set path += string.from_byte(bytes[index]);
            set index += 1;
        }
    }
    return path;
}

proc api_module_directory(path: str) -> string {
    let bytes = path.as_bytes();
    let mut end: usize = 0;
    let mut index: usize = 0;
    while index < bytes.len() {
        if bytes[index] == 47 or bytes[index] == 92 {
            set end = index + 1;
        }
        set index += 1;
    }
    if end == 0 {
        return ".";
    }
    return path.slice(0, end);
}

proc api_module_resolve_path(importer: str, name: str) -> ?string {
    let relative = api_module_import_path(name);
    let local = api_module_try_root(api_module_directory(importer), relative);
    if local != null {
        return local?;
    }

    let configured = vitte_native_environment_value("VITTE_MODULE_PATH");
    if configured != null {
        let roots: str = configured?;
        let root_bytes = roots.as_bytes();
        let mut root_start: usize = 0;
        let mut index: usize = 0;
        while index <= root_bytes.len() {
            let at_end = index == root_bytes.len();
            let semicolon = not at_end and root_bytes[index] == 59;
            let colon = not at_end and root_bytes[index] == 58 and
                not (index == root_start + 1 and index + 1 < root_bytes.len() and
                    (root_bytes[index + 1] == 47 or root_bytes[index + 1] == 92));
            if at_end or semicolon or colon {
                if index > root_start {
                    let root: str = roots.slice(root_start, index);
                    let candidate = api_module_try_root(root, relative);
                    if candidate != null {
                        return candidate?;
                    }
                }
                set root_start = index + 1;
            }
            set index += 1;
        }
    }

    let fallback_roots: [string] = [".", "src", "modules/core/src"];
    let mut root_index: usize = 0;
    while root_index < fallback_roots.len() {
        let candidate = api_module_try_root(fallback_roots[root_index], relative);
        if candidate != null {
            return candidate?;
        }
        set root_index += 1;
    }
    return null;
}

proc api_module_use_name(source: str, start: usize, end: usize) -> ?string {
    let bytes = source.as_bytes();
    let mut cursor = start;
    while cursor < end and (bytes[cursor] == 32 or bytes[cursor] == 9) {
        set cursor += 1;
    }
    if end - cursor < 4 or bytes[cursor] != 117 or
       bytes[cursor + 1] != 115 or bytes[cursor + 2] != 101 or
       (bytes[cursor + 3] != 32 and bytes[cursor + 3] != 9) {
        return null;
    }
    set cursor += 4;
    while cursor < end and (bytes[cursor] == 32 or bytes[cursor] == 9) {
        set cursor += 1;
    }
    let name_start = cursor;
    while cursor < end and bytes[cursor] != 59 and bytes[cursor] != 123 and
          bytes[cursor] != 32 and bytes[cursor] != 9 and bytes[cursor] != 10 {
        set cursor += 1;
    }
    while cursor > name_start and bytes[cursor - 1] == 58 {
        set cursor -= 1;
    }
    if cursor == name_start {
        return null;
    }
    return source.slice(name_start, cursor);
}

proc api_module_append_namespace_open(
    output: &mut ApiBuffer,
    name: str
) -> usize {
    let bytes = name.as_bytes();
    let mut segment_start: usize = 0;
    let mut index: usize = 0;
    let mut depth: usize = 0;
    while index <= bytes.len() {
        let end_segment = index == bytes.len() or
            (index + 1 < bytes.len() and bytes[index] == 58 and bytes[index + 1] == 58);
        if end_segment {
            if index == segment_start or
               not api_module_append_text(output, "export space ") or
               not buffer_append_range(output, name, segment_start, index) or
               not api_module_append_text(output, " {\n") {
                return 0;
            }
            set depth += 1;
            if index == bytes.len() {
                break;
            }
            set index += 2;
            set segment_start = index;
        } else {
            set index += 1;
        }
    }
    return depth;
}

proc api_module_append_namespace_close(output: &mut ApiBuffer, depth: usize) -> bool {
    let mut remaining = depth;
    while remaining != 0 {
        if not api_module_append_text(output, "}\n") {
            return false;
        }
        set remaining -= 1;
    }
    return true;
}

proc api_module_declaration_priority(
    lexer: &Lexer,
    start: usize,
    end: usize
) -> usize {
    let mut index = start;
    while index <= end and index < lexer.token_count {
        let kind = lexer.tokens[index].kind;
        if kind == TokenKind.KwUse { return 0; }
        if kind == TokenKind.KwSpace { return 1; }
        if kind == TokenKind.KwForm or kind == TokenKind.KwPick or
           kind == TokenKind.KwType or kind == TokenKind.KwOpaque or
           kind == TokenKind.KwTrait {
            return 2;
        }
        if kind == TokenKind.KwConst or kind == TokenKind.KwStatic {
            return 3;
        }
        if kind == TokenKind.KwImpl or kind == TokenKind.KwMacro {
            return 4;
        }
        if kind == TokenKind.KwProc or kind == TokenKind.KwExtern {
            return 5;
        }
        if kind == TokenKind.KwTest { return 6; }
        set index += 1;
    }
    return 6;
}

proc api_module_segment_end(lexer: &Lexer, start: usize) -> usize {
    let mut index = start;
    let mut parentheses: usize = 0;
    let mut brackets: usize = 0;
    let mut braces: usize = 0;
    while index < lexer.token_count {
        let kind = lexer.tokens[index].kind;
        if kind == TokenKind.Eof {
            return index;
        }
        if kind == TokenKind.LeftParen {
            set parentheses += 1;
        } elif kind == TokenKind.RightParen and parentheses != 0 {
            set parentheses -= 1;
        } elif kind == TokenKind.LeftBracket {
            set brackets += 1;
        } elif kind == TokenKind.RightBracket and brackets != 0 {
            set brackets -= 1;
        } elif kind == TokenKind.LeftBrace {
            set braces += 1;
        } elif kind == TokenKind.RightBrace and braces != 0 {
            set braces -= 1;
            if braces == 0 and parentheses == 0 and brackets == 0 {
                let next = index + 1;
                if next < lexer.token_count and
                   lexer.tokens[next].kind == TokenKind.Semicolon {
                    return next;
                }
                return index;
            }
        } elif kind == TokenKind.Semicolon and parentheses == 0 and
               brackets == 0 and braces == 0 {
            return index;
        }
        set index += 1;
    }
    return lexer.token_count - 1;
}

proc api_module_segment_is_space_header(
    lexer: &Lexer,
    start: usize,
    end: usize
) -> bool {
    let mut index = start;
    while index <= end and index < lexer.token_count {
        let kind = lexer.tokens[index].kind;
        if kind == TokenKind.KwSpace {
            let mut scan = index + 1;
            while scan <= end {
                if lexer.tokens[scan].kind == TokenKind.LeftBrace {
                    return false;
                }
                set scan += 1;
            }
            return true;
        }
        if kind != TokenKind.KwExport and kind != TokenKind.KwPub {
            return false;
        }
        set index += 1;
    }
    return false;
}

proc api_module_append_namespaced_declarations(
    output: &mut ApiBuffer,
    name: str,
    source: str
) -> bool {
    let mut lexer: Lexer = Lexer {};
    if not vitte_lexer_init(&mut lexer, source, source.length, 1) or
       not vitte_lexer_run(&mut lexer) {
        vitte_lexer_destroy(&mut lexer);
        return false;
    }

    let mut priority: usize = 0;
    while priority <= 6 {
        let mut segment_start: usize = 0;
        while segment_start < lexer.token_count and
              lexer.tokens[segment_start].kind != TokenKind.Eof {
            let segment_end = api_module_segment_end(&lexer, segment_start);
            if segment_end < segment_start or segment_end >= lexer.token_count {
                vitte_lexer_destroy(&mut lexer);
                return false;
            }
            let token_begin = lexer.tokens[segment_start].span.begin;
            let token_end = lexer.tokens[segment_end].span.end;
            if lexer.tokens[segment_start].span.valid and
               lexer.tokens[segment_end].span.valid and
               token_begin <= token_end and token_end <= source.length and
               not api_module_segment_is_space_header(
                   &lexer,
                   segment_start,
                   segment_end
               ) and api_module_declaration_priority(
                   &lexer,
                   segment_start,
                   segment_end
               ) == priority {
                let namespace_depth = api_module_append_namespace_open(output, name);
                if namespace_depth == 0 or
                   not buffer_append_range(output, source, token_begin, token_end) or
                   not buffer_append_byte(output, 10) or
                   not api_module_append_namespace_close(output, namespace_depth) {
                    vitte_lexer_destroy(&mut lexer);
                    return false;
                }
            }
            set segment_start = segment_end + 1;
        }
        set priority += 1;
    }

    vitte_lexer_destroy(&mut lexer);
    return true;
}

proc api_module_path_index(paths: [string], path: str) -> usize {
    let mut index: usize = 0;
    while index < paths.len() {
        if paths[index] == path {
            return index;
        }
        set index += 1;
    }
    return API_SIZE_MAX_VALUE;
}

proc api_module_expansion_destroy(expansion: &mut ApiModuleExpansion) {
    let mut index: usize = 0;
    while index < expansion.active_paths.len() {
        let path = expansion.active_paths[index];
        if api_module_path_index(expansion.loaded_paths, path) == API_SIZE_MAX_VALUE {
            vitte_native_api_deallocate(path.as_ptr() as *mut u8);
        }
        set index += 1;
    }

    set index = 0;
    while index < expansion.loaded_paths.len() {
        vitte_native_api_deallocate(
            expansion.loaded_paths[index].as_ptr() as *mut u8
        );
        set index += 1;
    }

    vitte_native_api_deallocate(expansion.active_paths.as_ptr() as *mut u8);
    vitte_native_api_deallocate(expansion.loaded_paths.as_ptr() as *mut u8);
    set expansion.active_paths = [];
    set expansion.loaded_paths = [];
}

proc api_module_expand_source(
    api: &mut Api,
    expansion: &mut ApiModuleExpansion,
    path: string,
    module_name: ?str,
    depth: usize
) -> bool {
    if depth > API_MODULE_MAX_DEPTH {
        return false;
    }
    if api_module_path_index(expansion.loaded_paths, path) != API_SIZE_MAX_VALUE {
        return true;
    }
    if api_module_path_index(expansion.active_paths, path) != API_SIZE_MAX_VALUE {
        return false;
    }
    if not expansion.active_paths.push(path) {
        return false;
    }

    let source_value = read_file(api, path);
    if source_value == null {
        return false;
    }
    let source: string = source_value?;
    let bytes = source.as_bytes();

    let mut offset: usize = 0;
    while offset < bytes.len() {
        let mut line_end = offset;
        while line_end < bytes.len() and bytes[line_end] != 10 {
            set line_end += 1;
        }
        let import_name = api_module_use_name(source, offset, line_end);
        if import_name != null {
            let mut directive_end = offset;
            while directive_end < bytes.len() and bytes[directive_end] != 59 {
                set directive_end += 1;
            }
            if directive_end == bytes.len() {
                vitte_native_api_deallocate(source.as_ptr() as *mut u8);
                return false;
            }
            let imported_path = api_module_resolve_path(path, import_name?);
            if imported_path == null or not api_module_expand_source(
                api,
                expansion,
                imported_path?,
                import_name,
                depth + 1
            ) {
                vitte_native_api_deallocate(source.as_ptr() as *mut u8);
                return false;
            }
            set offset = directive_end + 1;
        } else {
            set offset = if line_end < bytes.len() { line_end + 1 } else { line_end };
        }
    }

    let mut namespace_depth: usize = 0;
    if module_name != null {
        if not api_module_append_namespaced_declarations(
            &mut expansion.output,
            module_name?,
            source
        ) {
            vitte_native_api_deallocate(source.as_ptr() as *mut u8);
            return false;
        }
    } else {
        set offset = 0;
        while offset < bytes.len() {
            let mut line_end = offset;
            while line_end < bytes.len() and bytes[line_end] != 10 {
                set line_end += 1;
            }
            let mut directive_start = offset;
            while directive_start < line_end and
                  (bytes[directive_start] == 32 or bytes[directive_start] == 9) {
                set directive_start += 1;
            }
            let import_name = api_module_use_name(source, offset, line_end);
            if import_name != null {
                let mut directive_end = offset;
                while directive_end < bytes.len() and bytes[directive_end] != 59 {
                    set directive_end += 1;
                }
                if directive_end == bytes.len() or
                   not buffer_append_range(
                       &mut expansion.output,
                       source,
                       offset,
                       directive_end + 1
                   ) or not buffer_append_byte(&mut expansion.output, 10) {
                    vitte_native_api_deallocate(source.as_ptr() as *mut u8);
                    return false;
                }
                set offset = directive_end + 1;
                if offset < bytes.len() and bytes[offset] == 10 {
                    set offset += 1;
                }
            } elif line_end - directive_start >= 6 and
                  bytes[directive_start] == 115 and bytes[directive_start + 1] == 112 and
                  bytes[directive_start + 2] == 97 and bytes[directive_start + 3] == 99 and
                  bytes[directive_start + 4] == 101 and bytes[directive_start + 5] == 32 {
                set offset = if line_end < bytes.len() { line_end + 1 } else { line_end };
                if line_end < bytes.len() and not buffer_append_byte(&mut expansion.output, 10) {
                    vitte_native_api_deallocate(source.as_ptr() as *mut u8);
                    return false;
                }
            } else {
                if not buffer_append_range(
                    &mut expansion.output,
                    source,
                    offset,
                    line_end
                ) {
                    vitte_native_api_deallocate(source.as_ptr() as *mut u8);
                    return false;
                }
                if line_end < bytes.len() {
                    if not buffer_append_byte(&mut expansion.output, 10) {
                        vitte_native_api_deallocate(source.as_ptr() as *mut u8);
                        return false;
                    }
                    set offset = line_end + 1;
                } else {
                    set offset = line_end;
                }
            }
        }
    }

    if not api_module_append_namespace_close(&mut expansion.output, namespace_depth) {
        vitte_native_api_deallocate(source.as_ptr() as *mut u8);
        return false;
    }
    let loaded: bool = expansion.loaded_paths.push(path);
    vitte_native_api_deallocate(source.as_ptr() as *mut u8);
    return loaded;
}

/// =========================================================================
/// Internal error handling
/// =========================================================================

proc fail(
    api: ?&mut Api,
    status: Status,
    code: str,
    message: str
) -> Status {
    if api != null {
        let api_value = api?;
        error_set(
            &mut api_value.last_error,
            status,
            code,
            message
        );
    }

    set_last_error(
        status,
        code,
        message
    );

    return status;
}

proc api_invalid_argument(
    api: ?&mut Api,
    message: str
) -> Status {
    return fail(
        api,
        Status.ErrorInvalidArgument,
        "VITTE_API_INVALID_ARGUMENT",
        message
    );
}

proc api_invalid_state(
    api: ?&mut Api,
    message: str
) -> Status {
    return fail(
        api,
        Status.ErrorInvalidState,
        "VITTE_API_INVALID_STATE",
        message
    );
}

proc api_out_of_memory(
    api: ?&mut Api
) -> Status {
    return fail(
        api,
        Status.ErrorOutOfMemory,
        "VITTE_API_OUT_OF_MEMORY",
        "out of memory"
    );
}

proc io_error(
    api: ?&mut Api,
    message: str
) -> Status {
    return fail(
        api,
        Status.ErrorIo,
        "VITTE_API_IO_ERROR",
        message
    );
}

proc api_internal_error(
    api: ?&mut Api,
    message: str
) -> Status {
    return fail(
        api,
        Status.ErrorInternal,
        "VITTE_API_INTERNAL_ERROR",
        message
    );
}

proc propagate_context_error(
    api: &mut Api,
    status: Status,
    code: str,
    message: str
) {
    if error_is_set(&api.context.last_error) {
        error_copy(
            &mut api.last_error,
            &api.context.last_error
        );
        error_set_last(&api.last_error);
        return;
    }

    fail(
        api,
        status,
        code,
        message
    );
}


/// =========================================================================
/// Validation
/// =========================================================================

proc api_context_is_valid(
    api: ?&Api
) -> bool {
    if api == null {
        return false;
    }

    if api.magic != API_CONTEXT_MAGIC {
        return false;
    }

    if api.state == ApiState.Destroyed {
        return false;
    }

    return true;
}

proc result_is_valid(
    result: ?&ApiResult
) -> bool {
    if result == null {
        return false;
    }

    return result.magic == API_RESULT_MAGIC;
}


/// =========================================================================
/// Result lifecycle
/// =========================================================================

proc result_create() -> ApiResult {
    return ApiResult {
        magic: API_RESULT_MAGIC,

        status: Status.Ok,

        source_name: "",

        output: [],
        output_size: 0,

        diagnostics: [],
        diagnostics_size: 0,

        owns_source_name: false,

        error_count: 0,
        warning_count: 0,
        note_count: 0,

        succeeded: false,
    };
}

proc result_destroy_internal(
    result: &mut ApiResult
) {
    if not result_is_valid(result) {
        return;
    }

    if result.owns_source_name and result.source_name.length != 0 {
        vitte_native_api_deallocate(result.source_name.as_ptr() as *mut u8);
    }
    if result.output.capacity != 0 {
        vitte_native_api_deallocate(result.output.as_ptr() as *mut u8);
    }
    if result.diagnostics.capacity != 0 {
        vitte_native_api_deallocate(result.diagnostics.as_ptr() as *mut u8);
    }

    set result.magic = 0;

    set result.source_name = "";

    set result.output = [];
    set result.output_size = 0;

    set result.diagnostics = [];
    set result.diagnostics_size = 0;
    set result.owns_source_name = false;

    set result.error_count = 0;
    set result.warning_count = 0;
    set result.note_count = 0;

    set result.succeeded = false;
}


/// =========================================================================
/// Source validation
/// =========================================================================

proc validate_source(
    api: &mut Api,
    source_name: ?str,
    source: ?str,
    source_length: usize
) -> Status {
    if source == null  and  source_length != 0 {
        return api_invalid_argument(
            api,
            "source is null while source length is non-zero"
        );
    }

    if source_length > API_MAX_SOURCE_SIZE {
        return api_invalid_argument(
            api,
            "source exceeds the maximum supported API source size"
        );
    }

    if source_name != null  and
       not path_is_valid(source_name?) {
        return api_invalid_argument(
            api,
            "invalid source name"
        );
    }

    return Status.Ok;
}


/// =========================================================================
/// File loading
/// =========================================================================

proc api_cli_size_to_string(value: usize) -> string {
    if value < 10 {
        return string.from_byte((48 + value) as u8);
    }
    return api_cli_size_to_string(value / 10) +
        string.from_byte((48 + (value % 10)) as u8);
}

proc api_cli_write_error(prefix: string, message: string) {
    let output = prefix + message + "\n";
    vitte_native_write_stderr(output.as_ptr() as *const char, output.length);
}

export proc vitte_api_lex_path(path: string) -> i32 {
    let mut api: Api = api_create();
    let source_value = read_file(&mut api, path);
    if source_value == null {
        api_cli_write_error("vitte lex: ", api.last_error.message);
        api_destroy(&mut api);
        return 1;
    }

    let source: string = source_value?;
    let mut lexer: Lexer = Lexer {};
    if not vitte_lexer_init(&mut lexer, source, source.length, 1) or
       not vitte_lexer_run(&mut lexer) {
        api_cli_write_error(
            "vitte lex: ",
            vitte_lexer_error_name(lexer.last_error)
        );
        vitte_lexer_destroy(&mut lexer);
        vitte_native_api_deallocate(source.as_ptr() as *mut u8);
        api_destroy(&mut api);
        return 1;
    }

    let mut output: string = "";
    let mut index: usize = 0;
    while index < lexer.token_count {
        let token: Token = lexer.tokens[index];
        set output += api_cli_size_to_string(index) + "  " +
            vitte_token_kind_name(token.kind) + "  [" +
            api_cli_size_to_string(token.span.begin) + ", " +
            api_cli_size_to_string(token.span.end) + ")  " +
            api_cli_size_to_string(token.line) + ":" +
            api_cli_size_to_string(token.column) + "\n";
        set index += 1;
    }
    vitte_native_write_stdout(output.as_ptr() as *const char, output.length);
    vitte_lexer_destroy(&mut lexer);
    vitte_native_api_deallocate(source.as_ptr() as *mut u8);
    api_destroy(&mut api);
    return 0;
}

export proc vitte_api_parse_path(path: string) -> i32 {
    let mut api: Api = api_create();
    let source_value = read_file(&mut api, path);
    if source_value == null {
        api_cli_write_error("vitte parse: ", api.last_error.message);
        api_destroy(&mut api);
        return 1;
    }

    let source: string = source_value?;
    let mut lexer: Lexer = Lexer {};
    if not vitte_lexer_init(&mut lexer, source, source.length, 1) or
       not vitte_lexer_run(&mut lexer) {
        api_cli_write_error(
            "vitte parse: ",
            vitte_lexer_error_name(lexer.last_error)
        );
        vitte_lexer_destroy(&mut lexer);
        vitte_native_api_deallocate(source.as_ptr() as *mut u8);
        api_destroy(&mut api);
        return 1;
    }

    let mut parser_tokens: [ParserToken] = [];
    let mut index: usize = 0;
    while index < lexer.token_count {
        let token: Token = lexer.tokens[index];
        if not parser_tokens.push(ParserToken {
            kind: token.kind,
            span: ParserTokenSpan {
                file_id: 1,
                begin: token.span.begin,
                end: token.span.end,
                valid: token.span.valid
            },
            line: token.line,
            column: token.column,
            lexeme: token.lexeme,
            length: token.length
        }) {
            api_cli_write_error("vitte parse: ", "out of memory while adapting tokens");
            vitte_lexer_destroy(&mut lexer);
            vitte_native_api_deallocate(source.as_ptr() as *mut u8);
            api_destroy(&mut api);
            return 1;
        }
        set index += 1;
    }

    let mut parser: Parser = Parser {};
    if not vitte_parser_init(&mut parser, parser_tokens.as_ptr(), parser_tokens.length) or
       not vitte_parser_run(&mut parser) {
        api_cli_write_error(
            "vitte parse: ",
            vitte_parser_error_name(parser.last_error)
        );
        vitte_parser_destroy(&mut parser);
        vitte_lexer_destroy(&mut lexer);
        vitte_native_api_deallocate(source.as_ptr() as *mut u8);
        api_destroy(&mut api);
        return 1;
    }

    let root: *const ASTNode = vitte_parser_get_node(&parser, parser.root);
    if root == null {
        api_cli_write_error("vitte parse: ", "parser produced no translation unit");
        vitte_parser_destroy(&mut parser);
        vitte_lexer_destroy(&mut lexer);
        vitte_native_api_deallocate(source.as_ptr() as *mut u8);
        api_destroy(&mut api);
        return 1;
    }

    let output = "AST root kind: " +
        vitte_ast_node_kind_name((*root).kind) +
        "\nnodes: " + api_cli_size_to_string(vitte_parser_node_count(&parser)) + "\n";
    vitte_native_write_stdout(output.as_ptr() as *const char, output.length);
    vitte_parser_destroy(&mut parser);
    vitte_lexer_destroy(&mut lexer);
    vitte_native_api_deallocate(source.as_ptr() as *mut u8);
    api_destroy(&mut api);
    return 0;
}

proc read_file(
    api: &mut Api,
    path: str
) -> ?string {
    if not path_is_valid(path) {
        api_invalid_argument(
            api,
            "invalid input file path"
        );

        return null;
    }

    // C stdio consumes NUL-terminated pointers. Copy the Vitte path into a
    // temporary C string instead of passing the Vitte string value as though
    // it were a C char pointer.
    let c_path: *mut u8 = c_string_copy(path);
    if c_path == null {
        api_out_of_memory(api);
        return null;
    }

    let c_mode: *mut u8 = c_string_copy("rb");
    if c_mode == null {
        vitte_native_api_deallocate(c_path);
        api_out_of_memory(api);
        return null;
    }

    let file: *mut u8 = vitte_native_api_file_open(
        c_path,
        c_mode
    );
    vitte_native_api_deallocate(c_mode);
    vitte_native_api_deallocate(c_path);

    if file == null {
        io_error(api, "unable to open input file");
        return null;
    }

    let mut capacity: usize = API_INITIAL_FILE_CAPACITY;
    let mut allocation_size: usize = capacity + 1;
    let mut length: usize = 0;

    let mut file_data: *mut u8 = vitte_native_api_allocate(allocation_size);

    if file_data == null {
        vitte_native_api_file_close(file);
        api_out_of_memory(api);
        return null;
    }

    while true {
        if length == API_MAX_SOURCE_SIZE {
            let extra_byte: usize = vitte_native_api_file_read(
                add_bytes(file_data, length),
                1,
                1,
                file
            );

            if extra_byte != 0 {
                vitte_native_api_deallocate(file_data);
                vitte_native_api_file_close(file);
                api_invalid_argument(
                    api,
                    "input file exceeds maximum source size"
                );
                return null;
            }

            if vitte_native_api_file_error(file) != 0 {
                vitte_native_api_deallocate(file_data);
                vitte_native_api_file_close(file);
                io_error(api, "unable to read input file");
                return null;
            }

            break;
        }

        let available: usize = capacity - length;

        let bytes_read: usize = vitte_native_api_file_read(
            add_bytes(file_data, length),
            1,
            available,
            file
        );

        set length += bytes_read;

        if vitte_native_api_file_error(file) != 0 {
            vitte_native_api_deallocate(file_data);
            vitte_native_api_file_close(file);
            io_error(api, "unable to read input file");
            return null;
        }

        if bytes_read < available {
            break;
        }

        if length == capacity {
            let mut new_capacity: usize = capacity * 2;

            if new_capacity > API_MAX_SOURCE_SIZE {
                set new_capacity = API_MAX_SOURCE_SIZE;
            }

            if new_capacity <= capacity or
               size_add_overflow(
                   new_capacity,
                   1,
                   &mut allocation_size
               ) {
                vitte_native_api_deallocate(file_data);
                vitte_native_api_file_close(file);
                api_invalid_argument(
                    api,
                    "input file size overflows the source buffer"
                );
                return null;
            }

            let new_data: *mut u8 = vitte_native_api_allocate(allocation_size);

            if new_data == null {
                vitte_native_api_deallocate(file_data);
                vitte_native_api_file_close(file);
                api_out_of_memory(api);
                return null;
            }

            let mut index: usize = 0;

            while index < length {
                set new_data[index] = file_data[index];
                set index += 1;
            }

            vitte_native_api_deallocate(file_data);
            set file_data = new_data;
            set capacity = new_capacity;
        }
    }

    let close_failed: bool = vitte_native_api_file_close(file) != 0;

    if close_failed {
        vitte_native_api_deallocate(file_data);
        io_error(api, "unable to close input file");
        return null;
    }

    let source: string = string.from_bytes(
        file_data,
        length
    );

    vitte_native_api_deallocate(file_data);

    return source;
}


/// =========================================================================
/// Diagnostic rendering
/// =========================================================================

proc capture_diagnostics(
    api: &mut Api,
    result: &mut ApiResult
) -> Status {
    let bag: ?&DiagnosticBag = context_diagnostics(
        &api.context
    );

    if bag == null {
        return Status.Ok;
    }

    let bag_value = bag?;

    set result.error_count =
        diagnostic_error_count(bag_value);

    set result.warning_count =
        diagnostic_warning_count(bag_value);

    set result.note_count = bag_value.counts.note_count;

    let mut buffer: ApiBuffer = ApiBuffer {
        data: [],
        length: 0,
        capacity: 0,
    };
    buffer_init(&mut buffer);

    let count: usize =
        diagnostic_bag_count(bag_value);

    let mut index: usize = 0;

    while index < count {
        let diagnostic_value: *Diagnostic =
            diagnostic_at(
                bag_value,
                index
            );

        if diagnostic_value != null {
            let diagnostic_entry: &Diagnostic = &*diagnostic_value;
            let rendered: string = diagnostic_format_one(diagnostic_entry);
            let rendered_bytes: [u8] = rendered.bytes();
            if not buffer_append(&mut buffer, rendered_bytes, rendered_bytes.length) or
               not buffer_append_byte(&mut buffer, '\n' as u8) {
                buffer_destroy(&mut buffer);
                return api_out_of_memory(api);
            }
        }

        set index += 1;
    }

    if buffer.length != 0 {
        if not buffer_append_byte(&mut buffer, 0) {
            buffer_destroy(&mut buffer);
            return api_out_of_memory(api);
        }
        set result.diagnostics_size = buffer.length - 1;
        set result.diagnostics = buffer.data;
        set buffer.data = [];
        set buffer.length = 0;
        set buffer.capacity = 0;
    } else {
        set result.diagnostics = [];
        set result.diagnostics_size = 0;
    }
    buffer_destroy(&mut buffer);

    return Status.Ok;
}

proc append_pipeline_diagnostic(
    api: &mut Api,
    source_name: string,
    code: string,
    message: string,
    details: string,
    origin: DiagnosticOrigin
) {
    let bag: ?&mut DiagnosticBag = context_diagnostics_mut(&mut api.context);
    if bag == null {
        return;
    }
    let bag_value = bag?;

    let mut item: Diagnostic = diagnostic_default();
    set item.severity = DiagnosticSeverity.Error;
    set item.origin = origin;
    set item.code = code;
    set item.message = message;
    set item.details = details;
    set item.source_name = source_name;
    set item.is_primary = true;

    diagnostic_add(bag_value, item);
}

proc api_append_json_cstring(buffer: &mut ApiBuffer, text: *const char) -> bool {
    if not buffer_append_byte(buffer, '"' as u8) { return false; }
    if text != null {
        let length = cstring_length(text as *const u8);
        let text_bytes = text as *const u8;
        let mut index: usize = 0;
        while index < length {
            let byte: u8 = text_bytes[index];
            if byte == '"' as u8 {
                if not buffer_append_byte(buffer, '\\' as u8) or
                   not buffer_append_byte(buffer, '"' as u8) { return false; }
            } elif byte == '\\' as u8 {
                if not buffer_append_byte(buffer, '\\' as u8) or
                   not buffer_append_byte(buffer, '\\' as u8) { return false; }
            } elif byte == '\n' as u8 {
                if not buffer_append_byte(buffer, '\\' as u8) or
                   not buffer_append_byte(buffer, 'n' as u8) { return false; }
            } elif byte == '\r' as u8 {
                if not buffer_append_byte(buffer, '\\' as u8) or
                   not buffer_append_byte(buffer, 'r' as u8) { return false; }
            } elif byte == '\t' as u8 {
                if not buffer_append_byte(buffer, '\\' as u8) or
                   not buffer_append_byte(buffer, 't' as u8) { return false; }
            } elif byte < 32 {
                if not buffer_append_byte(buffer, ' ' as u8) { return false; }
            } else if not buffer_append_byte(buffer, byte) {
                return false;
            }
            set index += 1;
        }
    }
    return buffer_append_byte(buffer, '"' as u8);
}

proc api_pipeline_diagnostic_phase(origin: CliDiagnosticOrigin) -> string {
    match origin {
        case CliDiagnosticOrigin.Lexer => return "lexer";
        case CliDiagnosticOrigin.Scanner => return "scanner";
        case CliDiagnosticOrigin.Parser => return "parser";
        case CliDiagnosticOrigin.Import => return "import";
        case CliDiagnosticOrigin.NameResolution => return "name_resolution";
        case CliDiagnosticOrigin.TypeCheck => return "type_check";
        case CliDiagnosticOrigin.Contract => return "contract";
        case CliDiagnosticOrigin.ConstantEval => return "constant_evaluation";
        case CliDiagnosticOrigin.Hir => return "hir";
        case CliDiagnosticOrigin.Ir => return "ir";
        case CliDiagnosticOrigin.Codegen => return "codegen";
        case CliDiagnosticOrigin.C17Backend => return "backend";
        case CliDiagnosticOrigin.CCompiler => return "c_compiler";
        case CliDiagnosticOrigin.Linker => return "linker";
        case CliDiagnosticOrigin.Runtime => return "runtime";
        case CliDiagnosticOrigin.Driver => return "driver";
        case CliDiagnosticOrigin.Internal => return "internal";
        case _ => return "compiler";
    }
}

proc api_render_pipeline_diagnostics_json(
    result: &mut ApiResult,
    diagnostics: *mut u8,
    diagnostic_count: usize
) -> bool {
    if diagnostics == null or diagnostic_count == 0 { return false; }
    let entries = diagnostics as *CliDiagnostic;
    let mut buffer: ApiBuffer = ApiBuffer {
        data: [],
        length: 0,
        capacity: 0,
    };
    buffer_init(&mut buffer);
    if not api_module_append_text(&mut buffer, "{\"diagnostics\":[") {
        buffer_destroy(&mut buffer);
        return false;
    }
    let mut index: usize = 0;
    while index < diagnostic_count {
        if index != 0 and not buffer_append_byte(&mut buffer, ',' as u8) {
            buffer_destroy(&mut buffer);
            return false;
        }
        let diagnostic_entry = &entries[index];
        let phase = api_pipeline_diagnostic_phase((*diagnostic_entry).origin);
        let internal_code: string = string.from_bytes(
            (*diagnostic_entry).code as *const u8,
            cstring_length((*diagnostic_entry).code as *const u8)
        );
        let registry_entry = vitte_diagnostic_registry_find_internal(internal_code);
        let public_code = if registry_entry != null { (*registry_entry).public_code } else { "E0000" };
        let severity = vitte_cli_diagnostic_severity_name((*diagnostic_entry).severity);
        if not api_module_append_text(&mut buffer, "{\"code\":\"") or
           not api_module_append_text(&mut buffer, public_code) or
           not api_module_append_text(&mut buffer, "\",\"severity\":\"") or
           not api_module_append_text(&mut buffer, severity) or
           not api_module_append_text(&mut buffer, "\",\"internal_code\":") or
           not api_append_json_cstring(&mut buffer, (*diagnostic_entry).code) or
           not api_module_append_text(&mut buffer, ",\"phase\":\"") or
           not api_module_append_text(&mut buffer, phase) or
           not api_module_append_text(&mut buffer, "\",\"message\":") or
           not api_append_json_cstring(&mut buffer, (*diagnostic_entry).message) or
           not api_module_append_text(&mut buffer, ",\"details\":") or
           not api_append_json_cstring(&mut buffer, (*diagnostic_entry).details) {
            buffer_destroy(&mut buffer);
            return false;
        }
        if (*diagnostic_entry).help != null and
           cstring_length((*diagnostic_entry).help as *const u8) != 0 {
            if not api_module_append_text(&mut buffer, ",\"help\":") or
               not api_append_json_cstring(&mut buffer, (*diagnostic_entry).help) {
                buffer_destroy(&mut buffer);
                return false;
            }
        }
        if (*diagnostic_entry).has_span {
            if not api_module_append_text(&mut buffer, ",\"location\":{\"source\":") or
               not api_append_json_cstring(&mut buffer, (*diagnostic_entry).source_name) or
               not api_module_append_text(&mut buffer, ",\"start\":{\"line\":") or
               not api_module_append_text(
                   &mut buffer,
                   api_cli_size_to_string((*diagnostic_entry).start_line)
               ) or
               not api_module_append_text(&mut buffer, ",\"column\":") or
               not api_module_append_text(
                   &mut buffer,
                   api_cli_size_to_string((*diagnostic_entry).start_column)
               ) or
               not api_module_append_text(&mut buffer, "},\"end\":{\"line\":") or
               not api_module_append_text(
                   &mut buffer,
                   api_cli_size_to_string((*diagnostic_entry).end_line)
               ) or
               not api_module_append_text(&mut buffer, ",\"column\":") or
               not api_module_append_text(
                   &mut buffer,
                   api_cli_size_to_string((*diagnostic_entry).end_column)
               ) or
               not api_module_append_text(&mut buffer, "}}") {
                buffer_destroy(&mut buffer);
                return false;
            }
        }
        if not buffer_append_byte(&mut buffer, '}' as u8) {
            buffer_destroy(&mut buffer);
            return false;
        }
        set index += 1;
    }
    if not api_module_append_text(&mut buffer, "]}\n") or
       not buffer_append_byte(&mut buffer, 0) {
        buffer_destroy(&mut buffer);
        return false;
    }

    if result.diagnostics.capacity != 0 {
        vitte_native_api_deallocate(result.diagnostics.as_ptr() as *mut u8);
    }
    set result.diagnostics = buffer.data;
    set result.diagnostics_size = buffer.length - 1;
    set buffer.data = [];
    set buffer.length = 0;
    set buffer.capacity = 0;
    buffer_destroy(&mut buffer);
    return true;
}

proc api_replace_pipeline_diagnostics_with_json(
    result: &mut ApiResult,
    action: u32,
    source_name: string,
    source: str,
    source_id: u64
) {
    let mut generated_source: *mut u8 = null;
    let mut generated_source_length: usize = 0;
    let mut diagnostics: *mut u8 = null;
    let mut diagnostic_count: usize = 0;
    let status = vitte_native_frontend_execute_with_diagnostics(
        action,
        source,
        source.length,
        source_id,
        source_name.as_ptr() as *const char,
        null,
        &mut generated_source,
        &mut generated_source_length,
        &mut diagnostics,
        &mut diagnostic_count
    );
    if status == 3 and diagnostic_count != 0 {
        let _ = api_render_pipeline_diagnostics_json(result, diagnostics, diagnostic_count);
    }
    if generated_source != null { vitte_native_frontend_release_output(generated_source); }
    if diagnostics != null { vitte_cli_diagnostic_transport_destroy(diagnostics); }
}


/// =========================================================================
/// Compilation core
/// =========================================================================

proc compile_internal(
    api: &mut Api,
    source_name: ?str,
    source: ?str,
    source_length: usize,
    action: u32,
    out_result: &mut ApiResult
) -> Status {
    if not api_context_is_valid(api) {
        set_last_error(
            Status.ErrorInvalidState,
            "VITTE_API_INVALID_STATE",
            "invalid compiler API context"
        );

        return Status.ErrorInvalidState;
    }

    let validation_status: Status =
        validate_source(
            api,
            source_name,
            source,
            source_length
        );

    if validation_status != Status.Ok {
        return validation_status;
    }

    if api.state == ApiState.Compiling {
        return api_invalid_state(
            api,
            "compiler context is already compiling"
        );
    }

    let mut result: ApiResult =
        result_create();

    if source_name != null {
        let source_name_value: str = source_name?;
        let source_name_copy: ?string = duplicate_string(source_name_value);
        if source_name_copy == null {
            return api_out_of_memory(api);
        }
        set result.source_name = source_name_copy?;
        set result.owns_source_name = true;
    } else {
        let memory_name: ?string = duplicate_string("<memory>");
        if memory_name == null {
            return api_out_of_memory(api);
        }
        set result.source_name = memory_name?;
        set result.owns_source_name = true;
    }

    if result.source_name.length == 0 {
        return api_out_of_memory(api);
    }

    set api.state = ApiState.Compiling;
    set api.compilation_count += 1;

    error_reset(&mut api.last_error);
    error_clear_last();

    let mut status: Status =
        context_begin_compilation(
            &mut api.context
        );

    if status != Status.Ok {
        propagate_context_error(
            api,
            status,
            "VITTE_API_CONTEXT_BEGIN",
            "unable to begin compiler context"
        );

        set api.state = ApiState.Failed;
        set api.failed_compilation_count += 1;

        set result.status = status;

        capture_diagnostics(
            api,
            &mut result
        );

        set *out_result = result;

        return status;
    }

    let mut source_id: u64 = 0;
    let source_text: str = if source == null { "" } else { source? };
    status = context_add_source(
        &mut api.context,
        result.source_name,
        source_text,
        source_length,
        &mut source_id
    );

    if status != Status.Ok {
        propagate_context_error(
            api,
            status,
            "VITTE_API_SOURCE_REGISTRATION",
            "unable to register source with compiler context"
        );
    }

    if status == Status.Ok {
        let pipeline: NativePipelineResult = if action == NATIVE_FRONTEND_ACTION_CHECK {
            native_pipeline_check(source_text, source_length, source_id)
        } elif action == NATIVE_FRONTEND_ACTION_EMIT_IR {
            native_pipeline_emit_ir(source_text, source_length, source_id)
        } else {
            native_pipeline_run(source_text, source_length, source_id)
        };

        if not pipeline.succeeded {
            let code: string = if pipeline.sema_error_count != 0 or pipeline.sema_error != 0 {
                "VITTE_SEMANTIC_ERROR"
            } else if pipeline.parser_diagnostic_count != 0 or pipeline.parser_error != 0 {
                if pipeline.parser_code.length != 0 {
                    pipeline.parser_code
                } else {
                    "VITTE_PARSER_ERROR"
                }
            } else if pipeline.hir_error != 0 {
                "VITTE_HIR_LOWERING_ERROR"
            } else if pipeline.ir_error != 0 {
                "VITTE_IR_LOWERING_ERROR"
            } else if pipeline.codegen_error != 0 {
                "VITTE_CODEGEN_ERROR"
            } else if pipeline.status == Status.ErrorParse {
                "VITTE_LEXER_ERROR"
            } else {
                "VITTE_PIPELINE_ERROR"
            };
            let message: string = if pipeline.sema_error_count != 0 or pipeline.sema_error != 0 {
                "semantic analysis found errors in the source"
            } else if pipeline.parser_diagnostic_count != 0 or pipeline.parser_error != 0 {
                if pipeline.parser_detail.length != 0 {
                    pipeline.parser_detail
                } else {
                    "native parser rejected the source"
                }
            } else if pipeline.hir_error != 0 {
                if pipeline.codegen_detail.length != 0 {
                    pipeline.codegen_detail
                } else {
                    "HIR lowering rejected the parsed source"
                }
            } else if pipeline.ir_error != 0 {
                if pipeline.codegen_detail.length != 0 {
                    pipeline.codegen_detail
                } else {
                    "IR lowering rejected the HIR"
                }
            } else if pipeline.codegen_error != 0 {
                if pipeline.codegen_detail.length != 0 {
                    pipeline.codegen_detail
                } else {
                    "C17 code generation rejected the IR"
                }
            } else if pipeline.status == Status.ErrorParse {
                "native lexer rejected the source"
            } else {
                "front-end pipeline failed"
            };
            let details: string = if pipeline.sema_error_count != 0 or pipeline.sema_error != 0 {
                "semantic analysis reported errors"
            } else if pipeline.parser_diagnostic_count != 0 or pipeline.parser_error != 0 {
                if pipeline.parser_detail.length != 0 {
                    pipeline.parser_detail
                } else {
                    "parser rejected the source"
                }
            } else if pipeline.hir_error != 0 {
                if pipeline.codegen_detail.length != 0 {
                    pipeline.codegen_detail
                } else {
                    "HIR lowering failed"
                }
            } else if pipeline.ir_error != 0 {
                if pipeline.codegen_detail.length != 0 {
                    pipeline.codegen_detail
                } else {
                    "IR lowering failed"
                }
            } else if pipeline.codegen_error != 0 {
                if pipeline.codegen_detail.length != 0 {
                    pipeline.codegen_detail
                } else {
                    "code generation failed"
                }
            } else {
                vitte_lexer_error_name(pipeline.lexer_error)
            };
            let origin: DiagnosticOrigin = if pipeline.sema_error_count != 0 or pipeline.sema_error != 0 {
                DiagnosticOrigin.NameResolution
            } else if pipeline.parser_diagnostic_count != 0 or pipeline.parser_error != 0 {
                DiagnosticOrigin.Parser
            } else if pipeline.hir_error != 0 {
                DiagnosticOrigin.Hir
            } else if pipeline.ir_error != 0 {
                DiagnosticOrigin.Ir
            } else if pipeline.codegen_error != 0 {
                DiagnosticOrigin.Codegen
            } else {
                DiagnosticOrigin.Lexer
            };

            set status = fail(
                api,
                pipeline.status,
                code,
                message
            );

            append_pipeline_diagnostic(
                api,
                result.source_name,
                code,
                message,
                details,
                origin
            );

            context_set_failure(
                &mut api.context,
                status,
                code,
                message
            );
        } else if pipeline.last_completed_phase == NativePipelinePhase.Lexed {
            /// A parser setup failure did not produce an AST.
            set status = fail(
                api,
                Status.ErrorInternal,
                "VITTE_API_FRONTEND_INCOMPLETE",
                "front-end stopped before parsing completed"
            );

            append_pipeline_diagnostic(
                api,
                result.source_name,
                "VITTE_API_FRONTEND_INCOMPLETE",
                "front-end stopped before parsing completed",
                vitte_parser_error_name(pipeline.parser_error as ParserError),
                DiagnosticOrigin.Driver
            );

            context_set_failure(
                &mut api.context,
                status,
                "VITTE_API_FRONTEND_INCOMPLETE",
                "front-end stopped before parsing completed"
            );
        } else if pipeline.last_completed_phase == NativePipelinePhase.Generated {
            let generated_bytes: [u8] = pipeline.generated_source.bytes();
            let mut output_buffer: ApiBuffer = ApiBuffer {
                data: [],
                length: 0,
                capacity: 0,
            };
            buffer_init(&mut output_buffer);
            if not buffer_append(
                &mut output_buffer,
                generated_bytes,
                generated_bytes.length
            ) {
                buffer_destroy(&mut output_buffer);
                set status = api_out_of_memory(api);
            } else {
                set result.output = output_buffer.data;
                set result.output_size = output_buffer.length;
                set output_buffer.data = [];
                set output_buffer.length = 0;
                set output_buffer.capacity = 0;
                set status = pipeline.status;
            }
        }
    }

    let end_status: Status =
        context_end_compilation(
            &mut api.context
        );

    if status == Status.Ok  and
       end_status != Status.Ok {
        set status = end_status;
    }

    if status != Status.Ok  and
       api.last_error.status == Status.Ok {
        propagate_context_error(
            api,
            status,
            "VITTE_API_CONTEXT_END",
            "compiler context failed to finalize compilation"
        );
    }

    set result.status = status;

    let diagnostic_status: Status =
        capture_diagnostics(
            api,
            &mut result
        );

    if status == Status.Ok  and
       diagnostic_status != Status.Ok {
        set status = diagnostic_status;
        set result.status = status;
    }

    set result.succeeded =
        status == Status.Ok  and
        result.error_count == 0;

    if not result.succeeded and source_id != 0 {
        api_replace_pipeline_diagnostics_with_json(
            &mut result,
            action,
            result.source_name,
            source_text,
            source_id
        );
    }

    if result.succeeded {
        set api.state = ApiState.Ready;
        set api.successful_compilation_count += 1;
    } else {
        set api.state = ApiState.Failed;
        set api.failed_compilation_count += 1;
    }

    set *out_result = result;

    return status;
}


/// =========================================================================
/// Public lifecycle
/// =========================================================================

export proc api_create() -> Api {
    let mut api: Api = Api {
        magic: API_CONTEXT_MAGIC,

        state: ApiState.Uninitialized,

        context: context_uninitialized(),

        compilation_count: 0,
        successful_compilation_count: 0,
        failed_compilation_count: 0,

        last_error: error_ok(),
    };

    error_init(
        &mut api.last_error
    );

    let status: Status =
        context_init(
            &mut api.context
        );

    if status != Status.Ok {
        set_last_error(
            status,
            "VITTE_API_CONTEXT_INIT",
            "unable to initialize compiler context"
        );

        set api.state = ApiState.Failed;
        return api;
    }

    set api.state = ApiState.Ready;

    return api;
}

/// Native CLI check operation implemented in Vitte while other commands are
/// still served by the compatibility driver.
export proc vitte_api_check_path(path: string) -> i32 {
    let mut api: Api = api_create();
    let mut result: ApiResult = api_compile_file_with_action(
        &mut api,
        path,
        NATIVE_FRONTEND_ACTION_CHECK
    );
    let diagnostics = api_result_diagnostics(&result);
    if diagnostics != null {
        let bytes = diagnostics?;
        vitte_native_write_stderr_bytes(
            bytes.as_ptr(),
            api_result_diagnostics_size(&result)
        );
    }

    let succeeded = api_result_succeeded(&result);
    api_result_destroy(&mut result);
    api_destroy(&mut api);
    if succeeded {
        return 0;
    }
    return 1;
}

export proc vitte_api_emit_ir_path(path: string) -> i32 {
    let mut api: Api = api_create();
    let mut result: ApiResult = api_compile_file_with_action(
        &mut api,
        path,
        NATIVE_FRONTEND_ACTION_EMIT_IR
    );
    let diagnostics = api_result_diagnostics(&result);
    if diagnostics != null {
        let bytes = diagnostics?;
        vitte_native_write_stderr_bytes(
            bytes.as_ptr(),
            api_result_diagnostics_size(&result)
        );
    }

    let output = api_result_output(&result);
    if output != null {
        let bytes = output?;
        vitte_native_write_stdout_bytes(
            bytes.as_ptr(),
            api_result_output_size(&result)
        );
    }

    let succeeded = api_result_succeeded(&result);
    api_result_destroy(&mut result);
    api_destroy(&mut api);
    if succeeded {
        return 0;
    }
    return 1;
}

/// Compile one source file through the Vitte API and write generated C17 to
/// stdout or the requested path. Filesystem output stays behind the small
/// native process boundary.
export proc vitte_api_compile_path(source_path: string, output_path: string) -> i32 {
    let mut api: Api = api_create();
    let mut result: ApiResult = api_compile_file(&mut api, source_path);
    let succeeded = api_result_succeeded(&result);

    if not succeeded {
        let diagnostics = api_result_diagnostics(&result);
        if diagnostics != null {
            let bytes = diagnostics?;
            vitte_native_write_stderr_bytes(
                bytes.as_ptr(),
                api_result_diagnostics_size(&result)
            );
        }
        api_result_destroy(&mut result);
        api_destroy(&mut api);
        return 1;
    }

    let output = api_result_output(&result);
    let output_size = api_result_output_size(&result);
    let mut write_succeeded = false;
    if output != null {
        let bytes = output?;
        if output_path == "" {
            vitte_native_write_stdout_bytes(bytes.as_ptr(), output_size);
            set write_succeeded = true;
        } else {
            set write_succeeded = vitte_native_write_file(
                output_path,
                bytes.as_ptr(),
                output_size
            ) != 0;
        }
    }

    api_result_destroy(&mut result);
    api_destroy(&mut api);
    if write_succeeded {
        return 0;
    }
    return 1;
}

/// Build or run one source file with the generated C17 passed to the host
/// toolchain boundary. Source loading, front-end validation, and diagnostics
/// remain owned by the Vitte API.
export proc vitte_api_build_path(
    source_path: string,
    output_path: ?string,
    run_program: bool,
    diagnostic_json: bool,
    run_argc: i32,
    run_argv: *mut *mut u8
) -> i32 {
    let mut api: Api = api_create();
    let mut result: ApiResult = api_compile_file(&mut api, source_path);
    if not api_result_succeeded(&result) {
        let diagnostics = api_result_diagnostics(&result);
        if diagnostics != null {
            let bytes = diagnostics?;
            vitte_native_write_stderr_bytes(
                bytes.as_ptr(),
                api_result_diagnostics_size(&result)
            );
        }
        api_result_destroy(&mut result);
        api_destroy(&mut api);
        return 1;
    }

    let generated = api_result_output(&result);
    if generated == null {
        api_result_destroy(&mut result);
        api_destroy(&mut api);
        return 1;
    }
    let generated_bytes = generated?;
    let mut failed_stage: u32 = 0;
    let host_output_path: *const u8 = if output_path == null {
        null
    } else {
        (output_path?).as_ptr() as *const u8
    };
    let host_status: u32 = vitte_native_driver_run_host_toolchain(
        generated_bytes.as_ptr(),
        api_result_output_size(&result),
        host_output_path,
        false,
        run_program,
        false,
        false,
        run_argc,
        run_argv,
        &mut failed_stage
    );

    api_result_destroy(&mut result);
    api_destroy(&mut api);
    if host_status == 0 {
        if not run_program {
            vitte_native_write_stdout("build succeeded\n".as_ptr() as *const char, 16);
        }
        return 0;
    }
    if failed_stage == 2 {
        vitte_native_write_stderr("vitte: generated C compilation failed\n".as_ptr() as *const char, 38);
    } else if failed_stage == 3 {
        vitte_native_write_stderr("vitte: linking generated program failed\n".as_ptr() as *const char, 40);
    } else if failed_stage == 4 and diagnostic_json {
        let diagnostic_text = "{\"diagnostics\":[{\"internal_code\":\"VITTE_BACKEND_E_EXECUTION\",\"phase\":\"runtime\",\"message\":\"generated program returned failure\"}]}\n";
            vitte_native_write_stderr(
            diagnostic_text.as_ptr() as *const char,
            diagnostic_text.length
        );
    } else if failed_stage == 4 {
        vitte_native_write_stderr("vitte: generated program returned failure\n".as_ptr() as *const char, 42);
    } else {
        vitte_native_write_stderr("vitte: host toolchain operation failed\n".as_ptr() as *const char, 39);
    }
    return 1;
}

/// Command entry used by the native executable trampoline. Command dispatch
/// itself lives in the Vitte CLI process module.
export proc vitte_api_process_entry(argc: i32, argv: *const string) -> i32 {
    return vitte_main_entry_vitte(argc, argv);
}

export proc api_destroy(
    api: &mut Api
) {
    if not api_context_is_valid(api) {
        return;
    }

    if api.state == ApiState.Compiling {
        return;
    }

    set api.state = ApiState.Destroyed;

    context_destroy(
        &mut api.context
    );

    error_reset(
        &mut api.last_error
    );

    set api.magic = 0;
}


/// =========================================================================
/// Public compilation
/// =========================================================================

proc api_compile_source_with_action(
    api: &mut Api,
    source_name: ?str,
    source: ?str,
    source_length: usize,
    action: u32
) -> ApiResult {
    let mut result: ApiResult = result_create();

    let status: Status =
        compile_internal(
            api,
            source_name,
            source,
            source_length,
            action,
            &mut result
        );
    if result.status == Status.Ok and status != Status.Ok {
        set result.status = status;
        let fallback_name: str = if source_name == null { "<memory>" } else { source_name? };
        let fallback_name_copy: ?string = duplicate_string(fallback_name);
        if fallback_name_copy != null {
            set result.source_name = fallback_name_copy?;
            set result.owns_source_name = true;
        }
    }
    return result;
}

export proc api_compile_source(
    api: &mut Api,
    source_name: ?str,
    source: ?str,
    source_length: usize
) -> ApiResult {
    return api_compile_source_with_action(
        api,
        source_name,
        source,
        source_length,
        0
    );
}

export proc api_compile_string(
    api: &mut Api,
    source: ?str
) -> ApiResult {
    if source == null {
        return api_compile_source(
            api,
            "<memory>",
            null,
            0
        );
    }

    return api_compile_source(
        api,
        "<memory>",
        source,
        source.length
    );
}

proc api_compile_file_with_action(
    api: &mut Api,
    path: str,
    action: u32
) -> ApiResult {
    if not api_context_is_valid(api) {
        set_last_error(
            Status.ErrorInvalidState,
            "VITTE_API_INVALID_STATE",
            "invalid compiler API context"
        );

        return ApiResult {
            magic: API_RESULT_MAGIC,

            status: Status.ErrorInvalidState,

            source_name: path,

            output: [],
            output_size: 0,

            diagnostics: [],
            diagnostics_size: 0,

            owns_source_name: false,

            error_count: 0,
            warning_count: 0,
            note_count: 0,

            succeeded: false,
        };
    }

    let normalized_path = api_module_normalize_path(path);
    if normalized_path == null {
        let status = api_invalid_argument(api, "unable to normalize the input source path");
        return ApiResult {
            magic: API_RESULT_MAGIC,

            status: status,

            source_name: path,

            output: [],
            output_size: 0,

            diagnostics: [],
            diagnostics_size: 0,

            owns_source_name: false,

            error_count: 0,
            warning_count: 0,
            note_count: 0,

            succeeded: false,
        };
    }

    let mut expansion: ApiModuleExpansion = ApiModuleExpansion {
        output: ApiBuffer { data: [], length: 0, capacity: 0 },
        active_paths: [],
        loaded_paths: [],
    };
    if not api_module_expand_source(
        api,
        &mut expansion,
        normalized_path?,
        null,
        0
    ) {
        buffer_destroy(&mut expansion.output);
        api_module_expansion_destroy(&mut expansion);
        let status: Status = if api.last_error.status != Status.Ok {
            api.last_error.status
        } else {
            api_invalid_argument(api, "unable to resolve or assemble imported modules")
        };
        return ApiResult {
            magic: API_RESULT_MAGIC,
            status: status,
            source_name: path,
            output: [],
            output_size: 0,
            diagnostics: [],
            diagnostics_size: 0,
            owns_source_name: false,
            error_count: 0,
            warning_count: 0,
            note_count: 0,
            succeeded: false,
        };
    }

    let source_text_value = vitte_native_api_bytes_to_string(
        expansion.output.data.as_ptr() as *mut u8,
        expansion.output.length
    );
    buffer_destroy(&mut expansion.output);
    api_module_expansion_destroy(&mut expansion);

    if source_text_value == null {
        let status: Status = api_out_of_memory(api);
        return ApiResult {
            magic: API_RESULT_MAGIC,
            status: status,
            source_name: path,
            output: [],
            output_size: 0,
            diagnostics: [],
            diagnostics_size: 0,
            owns_source_name: false,
            error_count: 0,
            warning_count: 0,
            note_count: 0,
            succeeded: false,
        };
    }
    let source_text: string = source_text_value?;

    let result: ApiResult = api_compile_source_with_action(
        api,
        path,
        source_text,
        source_text.length,
        action
    );
    vitte_native_api_deallocate(source_text.as_ptr() as *mut u8);
    return result;
}

export proc api_compile_file(
    api: &mut Api,
    path: str
) -> ApiResult {
    return api_compile_file_with_action(api, path, 0);
}


/// =========================================================================
/// Result API
/// =========================================================================

export proc api_result_destroy(
    result: &mut ApiResult
) {
    result_destroy_internal(result);
}

export proc api_result_status(
    result: &ApiResult
) -> Status {
    if not result_is_valid(result) {
        return Status.ErrorInvalidArgument;
    }

    return result.status;
}

export proc api_result_succeeded(
    result: &ApiResult
) -> bool {
    return result_is_valid(result)  and
           result.succeeded;
}

export proc api_result_source_name(
    result: &ApiResult
) -> ?str {
    if not result_is_valid(result) {
        return null;
    }

    return result.source_name;
}

export proc api_result_output(
    result: &ApiResult
) -> ?&[u8] {
    if not result_is_valid(result) {
        return null;
    }

    return &result.output;
}

export proc api_result_output_size(
    result: &ApiResult
) -> usize {
    if not result_is_valid(result) {
        return 0;
    }

    return result.output_size;
}

export proc api_result_diagnostics(
    result: &ApiResult
) -> ?&[u8] {
    if not result_is_valid(result) {
        return null;
    }

    return &result.diagnostics;
}

export proc api_result_diagnostics_size(
    result: &ApiResult
) -> usize {
    if not result_is_valid(result) {
        return 0;
    }

    return result.diagnostics_size;
}

export proc api_result_error_count(
    result: &ApiResult
) -> usize {
    if not result_is_valid(result) {
        return 0;
    }

    return result.error_count;
}

export proc api_result_warning_count(
    result: &ApiResult
) -> usize {
    if not result_is_valid(result) {
        return 0;
    }

    return result.warning_count;
}

export proc api_result_note_count(
    result: &ApiResult
) -> usize {
    if not result_is_valid(result) {
        return 0;
    }

    return result.note_count;
}


/// =========================================================================
/// API state
/// =========================================================================

export proc api_is_valid(
    api: &Api
) -> bool {
    return api_context_is_valid(api);
}

export proc api_is_compiling(
    api: &Api
) -> bool {
    return api_context_is_valid(api)  and
           api.state == ApiState.Compiling;
}

export proc api_compilation_count(
    api: &Api
) -> usize {
    if not api_context_is_valid(api) {
        return 0;
    }

    return api.compilation_count;
}

export proc api_successful_compilation_count(
    api: &Api
) -> usize {
    if not api_context_is_valid(api) {
        return 0;
    }

    return api.successful_compilation_count;
}

export proc api_failed_compilation_count(
    api: &Api
) -> usize {
    if not api_context_is_valid(api) {
        return 0;
    }

    return api.failed_compilation_count;
}


/// =========================================================================
/// Error access
/// =========================================================================

export proc api_last_error(
    api: &Api
) -> &Error {
    if not api_context_is_valid(api) {
        return error_last();
    }

    return &api.last_error;
}

export proc api_clear_error(
    api: &mut Api
) {
    if not api_context_is_valid(api) {
        return;
    }

    error_reset(
        &mut api.last_error
    );

    error_clear_last();
}


/// =========================================================================
/// Version
/// =========================================================================

export proc api_version() -> str {
    return version_string();
}

export proc api_version_major() -> u32 {
    return version_major();
}

export proc api_version_minor() -> u32 {
    return version_minor();
}

export proc api_version_patch() -> u32 {
    return version_patch();
}


/// =========================================================================
/// Build information
/// =========================================================================

export proc api_build_mode() -> str {
    return version_build_mode();
}

export proc api_compiler() -> str {
    return version_host_compiler();
}

export proc api_platform() -> str {
    return version_platform();
}

export proc api_architecture() -> str {
    return version_architecture();
}


/// =========================================================================
/// Sanity checking
/// =========================================================================

export proc api_validate(
    api: &Api
) -> bool {
    if not api_context_is_valid(api) {
        return false;
    }

    if api.successful_compilation_count >
       api.compilation_count {
        return false;
    }

    if api.failed_compilation_count >
       api.compilation_count {
        return false;
    }

    let mut completed: usize = 0;

    if size_add_overflow(
        api.successful_compilation_count,
        api.failed_compilation_count,
        &mut completed
    ) {
        return false;
    }

    if completed > api.compilation_count {
        return false;
    }

    return true;
}


/// =========================================================================
/// Convenience predicates and compilation
/// =========================================================================

export proc api_result_failed(
    result: &ApiResult
) -> bool {
    return not api_result_succeeded(result);
}

export proc api_result_has_errors(
    result: &ApiResult
) -> bool {
    return api_result_error_count(result) != 0;
}

export proc api_result_has_warnings(
    result: &ApiResult
) -> bool {
    return api_result_warning_count(result) != 0;
}

export proc api_result_has_notes(
    result: &ApiResult
) -> bool {
    return api_result_note_count(result) != 0;
}

export proc api_has_compiled(
    api: &Api
) -> bool {
    return api_compilation_count(api) != 0;
}

export proc api_check_string(
    api: &mut Api,
    source: ?str
) -> Status {
    let mut result: ApiResult =
        api_compile_string(
            api,
            source
        );

    let status: Status = result.status;

    api_result_destroy(
        &mut result
    );

    return status;
}

export proc api_check_file(
    api: &mut Api,
    path: str
) -> Status {
    let mut result: ApiResult =
        api_compile_file(
            api,
            path
        );

    let status: Status = result.status;

    api_result_destroy(
        &mut result
    );

    return status;
}

export proc api_status_is_ok(
    status: Status
) -> bool {
    return status == Status.Ok;
}

export proc api_status_is_error(
    status: Status
) -> bool {
    return status != Status.Ok;
}

/// =========================================================================
/// Stable C ABI bridge
/// =========================================================================

export proc vitte_api_native_create(
    out_api: &mut *mut Api
) -> Status {
    if out_api == null {
        return Status.ErrorInvalidArgument;
    }
    set *out_api = null;

    let mut api_value: Api = api_create();
    if api_value.state != ApiState.Ready {
        let status: Status = api_value.last_error.status;
        api_destroy(&mut api_value);
        return status;
    }

    let storage: *mut u8 = vitte_native_api_allocate(sizeof(Api));
    if storage == null {
        api_destroy(&mut api_value);
        return Status.ErrorOutOfMemory;
    }

    let api_pointer: *mut Api = storage as *mut Api;
    set *api_pointer = api_value;
    set *out_api = api_pointer;
    return Status.Ok;
}

export proc vitte_api_native_destroy(api: *mut Api) {
    if api == null {
        return;
    }
    api_destroy(&mut *api);
    vitte_native_api_deallocate(api as *mut u8);
}

export proc vitte_api_native_compile_source(
    api: &mut Api,
    source_name: ?str,
    source: ?str,
    source_length: usize,
    out_result: &mut *mut ApiResult
) -> Status {
    if out_result == null {
        return api_invalid_argument(api, "out_result is null");
    }
    set *out_result = null;

    let mut result: ApiResult = api_compile_source(
        api,
        source_name,
        source,
        source_length
    );
    let storage: *mut u8 = vitte_native_api_allocate(sizeof(ApiResult));
    if storage == null {
        api_result_destroy(&mut result);
        return api_out_of_memory(api);
    }

    let result_pointer: *mut ApiResult = storage as *mut ApiResult;
    set *result_pointer = result;
    set *out_result = result_pointer;
    return (*result_pointer).status;
}

export proc vitte_api_native_compile_string(
    api: &mut Api,
    source: ?str,
    out_result: &mut *mut ApiResult
) -> Status {
    if source == null {
        return vitte_api_native_compile_source(
            api,
            "<memory>",
            null,
            0,
            out_result
        );
    }
    let source_text: str = source?;
    return vitte_api_native_compile_source(
        api,
        "<memory>",
        source_text,
        source_text.length,
        out_result
    );
}

export proc vitte_api_native_compile_file(
    api: &mut Api,
    path: ?str,
    out_result: &mut *mut ApiResult
) -> Status {
    if out_result == null {
        return api_invalid_argument(api, "out_result is null");
    }
    set *out_result = null;

    let mut result: ApiResult = ApiResult {};
    if path == null {
        let status: Status = api_invalid_argument(api, "invalid input file path");
        set result = ApiResult {
            magic: API_RESULT_MAGIC,
            status: status,
            source_name: "",
            output: [],
            output_size: 0,
            diagnostics: [],
            diagnostics_size: 0,
            owns_source_name: false,
            error_count: 0,
            warning_count: 0,
            note_count: 0,
            succeeded: false,
        };
    } else {
        set result = api_compile_file(api, path?);
    }
    let storage: *mut u8 = vitte_native_api_allocate(sizeof(ApiResult));
    if storage == null {
        api_result_destroy(&mut result);
        return api_out_of_memory(api);
    }

    let result_pointer: *mut ApiResult = storage as *mut ApiResult;
    set *result_pointer = result;
    set *out_result = result_pointer;
    return (*result_pointer).status;
}

export proc vitte_api_native_result_destroy(result: *mut ApiResult) {
    if result == null {
        return;
    }
    api_result_destroy(&mut *result);
    vitte_native_api_deallocate(result as *mut u8);
}

export proc vitte_api_native_result_status(result: &ApiResult) -> Status {
    return api_result_status(result);
}

export proc vitte_api_native_result_succeeded(result: &ApiResult) -> bool {
    return api_result_succeeded(result);
}

export proc vitte_api_native_result_source_name(result: &ApiResult) -> str {
    if not result_is_valid(result) {
        return "";
    }
    return result.source_name;
}

export proc vitte_api_native_result_output_data(result: &ApiResult) -> *const u8 {
    if not result_is_valid(result) {
        return null;
    }
    return result.output.as_ptr() as *const u8;
}

export proc vitte_api_native_result_output_size(result: &ApiResult) -> usize {
    return api_result_output_size(result);
}

export proc vitte_api_native_result_diagnostics(result: &ApiResult) -> *const u8 {
    if not result_is_valid(result) {
        return null;
    }
    if result.diagnostics.length == 0 {
        return null;
    }
    return result.diagnostics.as_ptr() as *const u8;
}

export proc vitte_api_native_result_diagnostics_size(result: &ApiResult) -> usize {
    return api_result_diagnostics_size(result);
}

export proc vitte_api_native_result_error_count(result: &ApiResult) -> usize {
    return api_result_error_count(result);
}

export proc vitte_api_native_result_warning_count(result: &ApiResult) -> usize {
    return api_result_warning_count(result);
}

export proc vitte_api_native_result_note_count(result: &ApiResult) -> usize {
    return api_result_note_count(result);
}

export proc vitte_api_native_compilation_count(api: &Api) -> usize {
    return api_compilation_count(api);
}

export proc vitte_api_native_successful_compilation_count(api: &Api) -> usize {
    return api_successful_compilation_count(api);
}

export proc vitte_api_native_failed_compilation_count(api: &Api) -> usize {
    return api_failed_compilation_count(api);
}

export proc vitte_api_native_is_valid(api: &Api) -> bool {
    return api_context_is_valid(api);
}

export proc vitte_api_native_is_compiling(api: &Api) -> bool {
    return api_context_is_valid(api) and api.state == ApiState.Compiling;
}

export proc vitte_api_native_error_status(api: &Api) -> Status {
    return api.last_error.status;
}

export proc vitte_api_native_error_code(api: &Api) -> str {
    return api.last_error.code;
}

export proc vitte_api_native_error_message(api: &Api) -> str {
    return api.last_error.message;
}

export proc vitte_api_native_error_details(api: &Api) -> ?str {
    return api.last_error.details;
}

export proc vitte_api_native_clear_error(api: &mut Api) {
    api_clear_error(api);
}

export proc vitte_api_native_diagnostic_transport_destroy(diagnostics: *mut u8) {
    vitte_cli_diagnostic_transport_destroy(diagnostics);
}
