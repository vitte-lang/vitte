export proc vitte_hir_error_name(error: HIRError) -> string {
    match error {
        case HIRError.None => return "none";
        case HIRError.InvalidArgument => return "invalid-argument";
        case HIRError.InvalidContext => return "invalid-context";
        case HIRError.InvalidState => return "invalid-state";
        case HIRError.InvalidNode => return "invalid-node";
        case HIRError.InvalidNodeKind => return "invalid-node-kind";
        case HIRError.InvalidType => return "invalid-type";
        case HIRError.InvalidSymbol => return "invalid-symbol";
        case HIRError.InvalidScope => return "invalid-scope";
        case HIRError.InvalidBlock => return "invalid-block";
        case HIRError.InvalidString => return "invalid-string";
        case HIRError.TypeMismatch => return "type-mismatch";
        case HIRError.DuplicateSymbol => return "duplicate-symbol";
        case HIRError.UnresolvedSymbol => return "unresolved-symbol";
        case HIRError.TooManyNodes => return "too-many-nodes";
        case HIRError.TooManySymbols => return "too-many-symbols";
        case HIRError.TooManyTypes => return "too-many-types";
        case HIRError.StringLimit => return "string-limit";
        case HIRError.RecursionLimit => return "recursion-limit";
        case HIRError.Overflow => return "overflow";
        case HIRError.OutOfMemory => return "out-of-memory";
        case HIRError.Validation => return "validation";
        case HIRError.Corruption => return "corruption";
        case HIRError.Unsupported => return "unsupported";
        case HIRError.Internal => return "internal";
        case HIRError.Count => return "count";
    }
    return "unknown";
}

export proc vitte_hir_state_name(state: HIRState) -> string {
    match state {
        case HIRState.Invalid => return "invalid";
        case HIRState.Building => return "building";
        case HIRState.Sealed => return "sealed";
        case HIRState.Validated => return "validated";
        case HIRState.Destroyed => return "destroyed";
        case HIRState.Count => return "count";
    }
    return "unknown";
}

