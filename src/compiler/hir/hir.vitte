/// Vitte declarations ported from `src/src/hir/hir.h`.
space compiler::hir::hir;

use compiler::lexer::lexer::{TokenKind};
use compiler::parser::parser::{
    ASTNode,
    ASTNodeId,
    ASTNodeKind,
    PARSER_AST_FLAG_ASYNC,
    PARSER_AST_FLAG_COMPTIME,
    PARSER_AST_FLAG_MUTABLE,
    PARSER_AST_FLAG_PATTERN_HEAD,
    PARSER_AST_FLAG_PUBLIC,
    PARSER_AST_FLAG_UNSAFE,
    Parser,
    ParserSpan,
    ParserToken,
    vitte_parser_get_node,
    vitte_parser_has_root,
    vitte_parser_is_valid,
    vitte_parser_node_token,
    vitte_parser_root
};
use vitte::core::memory::{allocate, copy, deallocate, fill};

const HIR_MAGIC: u64 = 6217593481478031698;
const HIR_DEAD_MAGIC: u64 = 4919409929498481185;
const HIR_MAX_RECURSION_DEPTH: usize = 4096;
const HIR_U64_MAX: u64 = 18446744073709551615;
const HIR_FNV_OFFSET: u64 = 14695981039346656037;
const HIR_FNV_PRIME: u64 = 1099511628211;
const HIR_DEFAULT_INITIAL_CAPACITY: usize = 16;
const HIR_AST_TYPE_QUERY_TYPE_OPERAND: u32 = 131072;

