        let data_element = if data_type != null and ((*data_type).kind == IRTypeKind.Array or (*data_type).kind == IRTypeKind.Pointer) { (*data_type).element_type } else { 0 as IRTypeId };
        if slice_type == null or (*slice_type).kind != IRTypeKind.Slice or
           data_type == null or data_element != (*slice_type).element_type or
           length_type == null or not ir_is_integer((*length_type).kind) {
            return ir_fail(context, IRError.TypeMismatch);
        }
    }
    if (*value).opcode == IROpcode.PickMake {
        let result_type = vitte_ir_get_type(context, (*value).result_type);
        let tag = vitte_ir_get_value(context, (*value).operands[0]);
        let tag_type: *IRType = if tag == null { null } else { vitte_ir_get_type(context, (*tag).type_) };
        if result_type == null or (*result_type).kind != IRTypeKind.Pick or
           tag_type == null or not ir_is_integer((*tag_type).kind) {
            return ir_fail(context, IRError.TypeMismatch);
        }
        let mut payload_index: usize = 1;
        while payload_index < operands {
            let payload = vitte_ir_get_value(context, (*value).operands[payload_index]);
            let payload_type: *IRType = if payload == null { null } else { vitte_ir_get_type(context, (*payload).type_) };
            if payload_type == null or not ir_pick_payload_type_supported((*payload_type).kind) {
                return ir_fail(context, IRError.TypeMismatch);
            }
            set payload_index += 1;
        }
    }
    if (*value).opcode == IROpcode.PickTag or (*value).opcode == IROpcode.PickPayload {
        let operand = vitte_ir_get_value(context, (*value).operands[0]);
        let operand_type: *IRType = if operand == null { null } else { vitte_ir_get_type(context, (*operand).type_) };
        if operand_type == null or (*operand_type).kind != IRTypeKind.Pick { return ir_fail(context, IRError.TypeMismatch); }
        if (*value).opcode == IROpcode.PickTag {
            let result_type = vitte_ir_get_type(context, (*value).result_type);
            if result_type == null or not ir_is_integer((*result_type).kind) { return ir_fail(context, IRError.TypeMismatch); }
        } else {
            let index_value = vitte_ir_get_value(context, (*value).operands[1]);
            let index_type: *IRType = if index_value == null { null } else { vitte_ir_get_type(context, (*index_value).type_) };
            let result_type = vitte_ir_get_type(context, (*value).result_type);
            if index_value == null or (*index_value).kind != IRValueKind.ConstantInteger or index_type == null or
               not ir_is_integer((*index_type).kind) or (*index_value).integer_value >= 16 or result_type == null or
               not ir_pick_payload_type_supported((*result_type).kind) {
                return ir_fail(context, IRError.TypeMismatch);
            }
        }
    }
    if (*value).opcode == IROpcode.CondBr {
        let condition = vitte_ir_get_value(context, (*value).operands[0]);
        let condition_type: *IRType = if condition == null { null } else { vitte_ir_get_type(context, (*condition).type_) };
        if condition_type == null or (*condition_type).kind != IRTypeKind.Bool { return ir_fail(context, IRError.TypeMismatch); }
    }
    if (*value).opcode == IROpcode.Switch {
        let selector = vitte_ir_get_value(context, (*value).operands[0]);
        let selector_type: *IRType = if selector == null { null } else { vitte_ir_get_type(context, (*selector).type_) };
        if selector_type == null or not ir_is_integer((*selector_type).kind) { return ir_fail(context, IRError.TypeMismatch); }
    }
    if (*value).opcode == IROpcode.Return {
        let block = vitte_ir_get_block(context, (*value).block);
        let function: *IRFunction = if block == null { null } else { vitte_ir_get_function(context, (*block).function) };
        let signature: *IRType = if function == null { null } else { vitte_ir_get_type(context, (*function).type_) };
        if signature == null { return ir_fail(context, IRError.InvalidFunction); }
        let result_type = vitte_ir_get_type(context, (*signature).return_type);
        if result_type == null { return ir_fail(context, IRError.InvalidFunction); }
        if (*result_type).kind == IRTypeKind.Void {
            if (*value).operand_count != 0 { return ir_fail(context, IRError.TypeMismatch); }
        } else {
            if (*value).operand_count != 1 { return ir_fail(context, IRError.TypeMismatch); }
            let returned: *IRValue = vitte_ir_get_value(context, (*value).operands[0]);
            if returned == null or (*returned).type_ != (*signature).return_type { return ir_fail(context, IRError.TypeMismatch); }
        }
    }
    if (*value).opcode == IROpcode.Call {
        let callee = vitte_ir_get_value(context, (*value).operands[0]);
        let callee_type: *IRType = if callee == null { null } else { vitte_ir_get_type(context, (*callee).type_) };
        if callee_type == null or (*callee_type).kind != IRTypeKind.Function or (*callee_type).return_type != (*value).result_type { return ir_fail(context, IRError.TypeMismatch); }
        let arguments = (*value).operand_count - 1;
        if arguments < (*callee_type).parameter_count or (not (*callee_type).is_variadic and arguments != (*callee_type).parameter_count) { return ir_fail(context, IRError.TypeMismatch); }
        let mut argument_index: usize = 0;
        while argument_index < (*callee_type).parameter_count {
            let argument = vitte_ir_get_value(context, (*value).operands[argument_index + 1]);
            if argument == null or (*argument).type_ != (*callee_type).parameter_types[argument_index] { return ir_fail(context, IRError.TypeMismatch); }
            set argument_index += 1;
        }
    }
    if (*value).opcode == IROpcode.Phi {
        let parent = vitte_ir_get_block(context, (*value).block);
        let result_type = vitte_ir_get_type(context, (*value).result_type);
        if parent == null or result_type == null or (*result_type).kind == IRTypeKind.Void or
           (*value).phi_count != (*parent).predecessor_count { return ir_fail(context, IRError.InvalidPhi); }
        let mut incoming_index: usize = 0;
        while incoming_index < (*value).phi_count {
            let incoming = &(*value).phi_incomings[incoming_index];
            let mut found = false; let mut pred: usize = 0;
            while pred < (*parent).predecessor_count { if (*parent).predecessors[pred] == (*incoming).block { set found = true; break; } set pred += 1; }
            if not found { return ir_fail(context, IRError.InvalidPhi); }
            let mut previous: usize = 0;
            while previous < incoming_index { if (*value).phi_incomings[previous].block == (*incoming).block { return ir_fail(context, IRError.InvalidPhi); } set previous += 1; }
            set incoming_index += 1;
        }
    }
    if (*value).opcode == IROpcode.Select {
        if operands != 3 { return ir_fail(context, IRError.InvalidInstruction); }
        let condition = vitte_ir_get_value(context, (*value).operands[0]);
        let condition_type: *IRType = if condition == null { null } else { vitte_ir_get_type(context, (*condition).type_) };
        let yes = vitte_ir_get_value(context, (*value).operands[1]);
        let no = vitte_ir_get_value(context, (*value).operands[2]);
        if condition_type == null or (*condition_type).kind != IRTypeKind.Bool or yes == null or no == null or
           (*yes).type_ != (*value).result_type or (*no).type_ != (*value).result_type { return ir_fail(context, IRError.TypeMismatch); }
    }
    return true;
}

proc ir_validate_block(context: *mut IRContext, value: *IRBlock) -> bool {
    if value == null or vitte_ir_get_function(context, (*value).function) == null or (*value).instruction_count > (*value).instruction_capacity or
       (*value).predecessor_count > (*value).predecessor_capacity or (*value).successor_count > (*value).successor_capacity or
       ((*value).instruction_count != 0 and (*value).instructions == null) or
       ((*value).predecessor_count != 0 and (*value).predecessors == null) or
       ((*value).successor_count != 0 and (*value).successors == null) or
       ((*value).instruction_capacity != 0 and (*value).instructions == null) or
       ((*value).instruction_capacity == 0 and (*value).instructions != null) or
       ((*value).predecessor_capacity != 0 and (*value).predecessors == null) or
       ((*value).predecessor_capacity == 0 and (*value).predecessors != null) or
       ((*value).successor_capacity != 0 and (*value).successors == null) or ((*value).successor_capacity == 0 and (*value).successors != null) or
       ((*value).name != 0 and vitte_ir_get_string(context, (*value).name) == null) or not ir_span_is_valid((*value).span) { return ir_fail(context, IRError.InvalidBlock); }
    let mut index: usize = 0;
    let mut saw_non_phi = false;
    while index < (*value).instruction_count {
        let id: IRInstructionId = (*value).instructions[index];
        let instruction = vitte_ir_get_instruction(context, id);
        if instruction == null or (*instruction).block != (*value).id { return ir_fail(context, IRError.Corruption); }
        if (*instruction).opcode == IROpcode.Phi {
            if saw_non_phi { return ir_fail(context, IRError.InvalidPhi); }
        } else { set saw_non_phi = true; }
        let mut prior: usize = 0;
        while prior < index { if (*value).instructions[prior] == id { return ir_fail(context, IRError.Corruption); } set prior += 1; }
        let last = index + 1 == (*value).instruction_count;
        if vitte_ir_opcode_is_terminator((*instruction).opcode) != last { return ir_fail(context, if last { IRError.MissingTerminator } else { IRError.TerminatedBlock }); }
        set index += 1;
    }
    if (*value).instruction_count == 0 {
        if (*value).terminated or (*value).terminator != 0 or (*value).successor_count != 0 { return ir_fail(context, IRError.Corruption); }
    } else {
        let final_instruction = vitte_ir_get_instruction(context, (*value).instructions[(*value).instruction_count - 1]);
        if final_instruction == null or not (*value).terminated or (*value).terminator != (*final_instruction).id or
           not vitte_ir_opcode_is_terminator((*final_instruction).opcode) { return ir_fail(context, IRError.Corruption); }
        if (*final_instruction).opcode == IROpcode.Br {
            if (*value).successor_count != 1 or (*value).successors[0] != (*final_instruction).target_true { return ir_fail(context, IRError.InvalidCfg); }
        } elif (*final_instruction).opcode == IROpcode.CondBr {
            let expected_count: usize = if (*final_instruction).target_true == (*final_instruction).target_false { 1 as usize } else { 2 as usize };
            if (*value).successor_count != expected_count or
               not ir_cfg_block_has_id((*value).successors, (*value).successor_count, (*final_instruction).target_true) or
               not ir_cfg_block_has_id((*value).successors, (*value).successor_count, (*final_instruction).target_false) { return ir_fail(context, IRError.InvalidCfg); }
        } elif (*final_instruction).opcode == IROpcode.Switch {
            if (*value).successor_count != 1 or (*value).successors[0] != (*final_instruction).target_true { return ir_fail(context, IRError.InvalidCfg); }
        } elif (*value).successor_count != 0 { return ir_fail(context, IRError.InvalidCfg); }
    }
    set index = 0;
    while index < (*value).successor_count {
        let target = vitte_ir_get_block(context, (*value).successors[index]);
        if target == null or (*target).function != (*value).function { return ir_fail(context, IRError.InvalidCfg); }
        let mut duplicate: usize = 0;
        while duplicate < index { if (*value).successors[duplicate] == (*value).successors[index] { return ir_fail(context, IRError.InvalidCfg); } set duplicate += 1; }
        let mut found = false; let mut reverse: usize = 0;
        while reverse < (*target).predecessor_count { if (*target).predecessors[reverse] == (*value).id { set found = true; break; } set reverse += 1; }
        if not found { return ir_fail(context, IRError.InvalidCfg); }
        set index += 1;
    }
    set index = 0;
    while index < (*value).predecessor_count {
        let source = vitte_ir_get_block(context, (*value).predecessors[index]);
        if source == null or (*source).function != (*value).function or
           not ir_cfg_block_has_id((*source).successors, (*source).successor_count, (*value).id) { return ir_fail(context, IRError.InvalidCfg); }
        let mut duplicate: usize = 0;
        while duplicate < index { if (*value).predecessors[duplicate] == (*value).predecessors[index] { return ir_fail(context, IRError.InvalidCfg); } set duplicate += 1; }
        set index += 1;
    }
    return true;
}

proc ir_function_has_block(value: *IRFunction, block: IRBlockId) -> bool {
    if value == null or (*value).blocks == null { return false; }
    let mut index: usize = 0;
    while index < (*value).block_count { if (*value).blocks[index] == block { return true; } set index += 1; }
    return false;
}

proc ir_validate_function(context: *mut IRContext, value: *IRFunction) -> bool {
    if value == null or vitte_ir_get_string(context, (*value).name) == null or vitte_ir_get_type(context, (*value).type_) == null or
       (*value).linkage >= IRLinkage.Count or (*value).calling_convention >= IRCallingConvention.Count or
       (*value).parameter_count > (*value).parameter_capacity or (*value).block_count > (*value).block_capacity or
       ((*value).parameter_count != 0 and (*value).parameters == null) or ((*value).block_count != 0 and (*value).blocks == null) or
       ((*value).parameter_capacity != 0 and (*value).parameters == null) or ((*value).parameter_capacity == 0 and (*value).parameters != null) or
       ((*value).block_capacity != 0 and (*value).blocks == null) or ((*value).block_capacity == 0 and (*value).blocks != null) or
       not ir_span_is_valid((*value).span) { return ir_fail(context, IRError.InvalidFunction); }
    let signature = vitte_ir_get_type(context, (*value).type_);
    if (*signature).kind != IRTypeKind.Function or (*signature).parameter_count != (*value).parameter_count or (*signature).is_variadic != (*value).is_variadic { return ir_fail(context, IRError.TypeMismatch); }
    let mut index: usize = 0;
    while index < (*value).parameter_count {
        let parameter = vitte_ir_get_value(context, (*value).parameters[index]);
        if parameter == null or (*parameter).kind != IRValueKind.Parameter or (*parameter).function != (*value).id or (*parameter).parameter_index != index or (*parameter).type_ != (*signature).parameter_types[index] { return ir_fail(context, IRError.InvalidValue); }
        let mut prior: usize = 0;
        while prior < index { if (*value).parameters[prior] == (*value).parameters[index] { return ir_fail(context, IRError.InvalidFunction); } set prior += 1; }
        set index += 1;
    }
    if (*value).is_declaration {
        if (*value).block_count != 0 or (*value).entry_block != 0 { return ir_fail(context, IRError.InvalidFunction); }
    } elif (*value).block_count == 0 or vitte_ir_get_block(context, (*value).entry_block) == null or
          (*context).blocks[((*value).entry_block - 1) as usize].function != (*value).id or
          (*value).blocks[0] != (*value).entry_block { return ir_fail(context, IRError.InvalidFunction); }
    set index = 0;
    while index < (*value).block_count {
        let block = vitte_ir_get_block(context, (*value).blocks[index]);
        if block == null or (*block).function != (*value).id or (not (*value).is_declaration and not (*block).terminated) { return ir_fail(context, IRError.MissingTerminator); }
        let mut prior: usize = 0;
        while prior < index { if (*value).blocks[prior] == (*value).blocks[index] { return ir_fail(context, IRError.InvalidCfg); } set prior += 1; }
        set index += 1;
    }
    return true;
}

proc ir_cfg_path_exists(context: *mut IRContext, start: IRBlockId, target: IRBlockId, excluded: IRBlockId,
                        visited: *mut bool, stack: *mut IRBlockId) -> bool {
    if start == 0 or target == 0 or start == excluded or visited == null or stack == null { return false; }
    let mut index: usize = 0;
    while index < (*context).block_count { set visited[index] = false; set index += 1; }
    set visited[(start - 1) as usize] = true;
    set stack[0] = start;
    let mut stack_count: usize = 1;
    while stack_count != 0 {
        set stack_count -= 1;
        let current_id = stack[stack_count];
        if current_id == target { return true; }
        let current = vitte_ir_get_block(context, current_id);
        if current == null { continue; }
        let mut successor_index: usize = 0;
        while successor_index < (*current).successor_count {
            let next = (*current).successors[successor_index];
            if next != excluded and not visited[(next - 1) as usize] {
                set visited[(next - 1) as usize] = true;
                set stack[stack_count] = next;
                set stack_count += 1;
            }
            set successor_index += 1;
        }
    }
    return false;
}

proc ir_instruction_precedes(context: *mut IRContext, block_id: IRBlockId, definition: IRInstructionId, use_id: IRInstructionId) -> bool {
    let block = vitte_ir_get_block(context, block_id);
    if block == null { return false; }
    let mut found_definition = false;
    let mut index: usize = 0;
    while index < (*block).instruction_count {
        let id: IRInstructionId = (*block).instructions[index];
        if id == definition { set found_definition = true; }
        if id == use_id { return found_definition and definition != use_id; }
        set index += 1;
    }
    return false;
}

proc ir_validate_ssa_use(context: *mut IRContext, function: *IRFunction, value_id: IRValueId,
                         use_block: IRBlockId, use_instruction: IRInstructionId, phi_edge: bool,
                         visited: *mut bool, stack: *mut IRBlockId) -> bool {
    let value = vitte_ir_get_value(context, value_id);
    if value == null { return ir_fail(context, IRError.InvalidValue); }
    if (*value).kind == IRValueKind.Parameter {
        if (*value).function != (*function).id { return ir_fail(context, IRError.InvalidValue); }
        return true;
    }
    if (*value).kind != IRValueKind.Instruction { return true; }
    let definition = vitte_ir_get_instruction(context, (*value).instruction);
    if definition == null { return ir_fail(context, IRError.InvalidInstruction); }
    let definition_block = vitte_ir_get_block(context, (*definition).block);
    if definition_block == null or (*definition_block).function != (*function).id { return ir_fail(context, IRError.InvalidValue); }
    if (*definition).block == use_block {
        if phi_edge or ir_instruction_precedes(context, use_block, (*definition).id, use_instruction) { return true; }
        return ir_fail(context, IRError.InvalidValue);
    }
    if not ir_cfg_path_exists(context, (*function).entry_block, use_block, 0, visited, stack) { return true; }
    if ir_cfg_path_exists(context, (*function).entry_block, use_block, (*definition).block, visited, stack) { return ir_fail(context, IRError.InvalidValue); }
    return true;
}

proc ir_validate_function_ssa(context: *mut IRContext, function: *IRFunction) -> bool {
    if function == null or (*function).is_declaration { return true; }
    let mut bytes: usize = 0;
    if not ir_size_mul((*context).block_count, sizeof(IRBlockId), &mut bytes) { return ir_fail(context, IRError.Overflow); }
    let stack = allocate(bytes) as *mut IRBlockId;
    let visited = allocate((*context).block_count) as *mut bool;
    if stack == null or visited == null { deallocate(stack as *mut u8); deallocate(visited as *mut u8); return ir_fail(context, IRError.OutOfMemory); }
    let mut block_index: usize = 0;
    while block_index < (*function).block_count {
        let block = vitte_ir_get_block(context, (*function).blocks[block_index]);
        let mut instruction_index: usize = 0;
        while instruction_index < (*block).instruction_count {
            let instruction = vitte_ir_get_instruction(context, (*block).instructions[instruction_index]);
            let mut operand_index: usize = 0;
            while operand_index < (*instruction).operand_count {
                if not ir_validate_ssa_use(context, function, (*instruction).operands[operand_index], (*block).id,
                                           (*instruction).id, false, visited, stack) {
                    deallocate(stack as *mut u8); deallocate(visited as *mut u8); return false;
                }
                set operand_index += 1;
            }
            let mut phi_index: usize = 0;
            while phi_index < (*instruction).phi_count {
                let incoming = &(*instruction).phi_incomings[phi_index];
                if not ir_validate_ssa_use(context, function, (*incoming).value, (*incoming).block,
                                           (*instruction).id, true, visited, stack) {
                    deallocate(stack as *mut u8); deallocate(visited as *mut u8); return false;
                }
                set phi_index += 1;
            }
            set instruction_index += 1;
        }
        set block_index += 1;
    }
    deallocate(stack as *mut u8); deallocate(visited as *mut u8);
    return true;
}

proc ir_validate_instruction_ownership_and_uses(context: *mut IRContext) -> bool {
    let mut instruction_bytes: usize = 0;
    let mut value_bytes: usize = 0;
    if not ir_size_mul((*context).instruction_count, sizeof(u64), &mut instruction_bytes) or
       not ir_size_mul((*context).value_count, sizeof(u64), &mut value_bytes) { return ir_fail(context, IRError.Overflow); }
    let placements: *mut u64 = if instruction_bytes == 0 { null } else { allocate(instruction_bytes) as *mut u64 };
    let uses: *mut u64 = if value_bytes == 0 { null } else { allocate(value_bytes) as *mut u64 };
    if (instruction_bytes != 0 and placements == null) or (value_bytes != 0 and uses == null) {
        deallocate(placements as *mut u8); deallocate(uses as *mut u8); return ir_fail(context, IRError.OutOfMemory);
    }
    if instruction_bytes != 0 and not fill(placements as *mut u8, 0, instruction_bytes) { deallocate(placements as *mut u8); deallocate(uses as *mut u8); return ir_fail(context, IRError.OutOfMemory); }
    if value_bytes != 0 and not fill(uses as *mut u8, 0, value_bytes) { deallocate(placements as *mut u8); deallocate(uses as *mut u8); return ir_fail(context, IRError.OutOfMemory); }
    let mut block_index: usize = 0;
    while block_index < (*context).block_count {
        let block = &(*context).blocks[block_index];
        let mut instruction_index: usize = 0;
        while instruction_index < (*block).instruction_count {
            let id: IRInstructionId = (*block).instructions[instruction_index];
            if id == 0 or id > (*context).instruction_count as u64 { deallocate(placements as *mut u8); deallocate(uses as *mut u8); return ir_fail(context, IRError.Corruption); }
            set placements[(id - 1) as usize] += 1;
            set instruction_index += 1;
        }
        set block_index += 1;
    }
    let mut instruction_index: usize = 0;
    while instruction_index < (*context).instruction_count {
        let instruction = &(*context).instructions[instruction_index];
        if placements[instruction_index] != 1 { deallocate(placements as *mut u8); deallocate(uses as *mut u8); return ir_fail(context, IRError.Corruption); }
        let mut operand_index: usize = 0;
        while operand_index < (*instruction).operand_count {
            let id: IRValueId = (*instruction).operands[operand_index];
            if id == 0 or id > (*context).value_count as u64 or uses[(id - 1) as usize] == IR_U64_MAX { deallocate(placements as *mut u8); deallocate(uses as *mut u8); return ir_fail(context, IRError.Corruption); }
            set uses[(id - 1) as usize] += 1;
            set operand_index += 1;
        }
        let mut phi_index: usize = 0;
        while phi_index < (*instruction).phi_count {
            let id: IRValueId = (*instruction).phi_incomings[phi_index].value;
            if id == 0 or id > (*context).value_count as u64 or uses[(id - 1) as usize] == IR_U64_MAX { deallocate(placements as *mut u8); deallocate(uses as *mut u8); return ir_fail(context, IRError.Corruption); }
            set uses[(id - 1) as usize] += 1;
            set phi_index += 1;
        }
        set instruction_index += 1;
    }
    let mut value_index: usize = 0;
    while value_index < (*context).value_count {
        if (*context).values[value_index].use_count != uses[value_index] {
            deallocate(placements as *mut u8); deallocate(uses as *mut u8); return ir_fail(context, IRError.Corruption);
        }
        set value_index += 1;
    }
    deallocate(placements as *mut u8); deallocate(uses as *mut u8);
    return true;
}

export proc vitte_ir_validate(context: *mut IRContext) -> bool {
    if not vitte_ir_is_valid(context) { return false; }
    ir_add_stat(&mut (*context).stats.validation_runs, 1);
    if (*context).string_count > (*context).string_capacity or (*context).type_count > (*context).type_capacity or
       (*context).value_count > (*context).value_capacity or (*context).instruction_count > (*context).instruction_capacity or
       (*context).block_count > (*context).block_capacity or (*context).function_count > (*context).function_capacity or
       (*context).global_count > (*context).global_capacity or (*context).type_count > (*context).max_types or
       (*context).value_count > (*context).max_values or (*context).instruction_count > (*context).max_instructions or
       (*context).block_count > (*context).max_blocks or (*context).function_count > (*context).max_functions or
       (*context).global_count > (*context).max_globals or (*context).string_count > (*context).max_values or
       ((*context).string_capacity != 0 and (*context).strings == null) or ((*context).string_capacity == 0 and (*context).strings != null) or
       ((*context).type_capacity != 0 and (*context).types == null) or ((*context).type_capacity == 0 and (*context).types != null) or
       ((*context).value_capacity != 0 and (*context).values == null) or ((*context).value_capacity == 0 and (*context).values != null) or
       ((*context).instruction_capacity != 0 and (*context).instructions == null) or ((*context).instruction_capacity == 0 and (*context).instructions != null) or
       ((*context).block_capacity != 0 and (*context).blocks == null) or ((*context).block_capacity == 0 and (*context).blocks != null) or
       ((*context).function_capacity != 0 and (*context).functions == null) or ((*context).function_capacity == 0 and (*context).functions != null) or
       ((*context).global_capacity != 0 and (*context).globals == null) or ((*context).global_capacity == 0 and (*context).globals != null) { return ir_fail(context, IRError.Corruption); }
    let mut index: usize = 0;
    while index < (*context).type_count {
        let value = &(*context).types[index];
        if (*value).parameter_count > (*context).max_types or ((*value).parameter_count != 0 and (*value).parameter_types == null) or
           ((*value).parameter_count == 0 and (*value).parameter_types != null) or (*value).field_count > (*context).max_types or
           ((*value).field_count != 0 and (*value).field_types == null) or ((*value).field_count == 0 and (*value).field_types != null) {
            ir_add_stat(&mut (*context).stats.validation_failures, 1); return ir_fail(context, IRError.Corruption);
        }
        set index += 1;
    }
    set index = 0;
    while index < (*context).function_count {
        let value = &(*context).functions[index];
        if (*value).parameter_count > (*value).parameter_capacity or (*value).block_count > (*value).block_capacity or
           (*value).parameter_count > (*context).max_values or (*value).block_count > (*context).max_blocks or
           ((*value).parameter_capacity != 0 and (*value).parameters == null) or ((*value).block_capacity != 0 and (*value).blocks == null) {
            ir_add_stat(&mut (*context).stats.validation_failures, 1); return ir_fail(context, IRError.Corruption);
        }
        set index += 1;
    }
    set index = 0;
    while index < (*context).block_count {
        let value = &(*context).blocks[index];
        if (*value).instruction_count > (*value).instruction_capacity or (*value).predecessor_count > (*value).predecessor_capacity or
           (*value).successor_count > (*value).successor_capacity or (*value).instruction_count > (*context).max_instructions or
           (*value).predecessor_count > (*context).max_blocks or (*value).successor_count > (*context).max_blocks or
           ((*value).instruction_capacity != 0 and (*value).instructions == null) or
           ((*value).predecessor_capacity != 0 and (*value).predecessors == null) or ((*value).successor_capacity != 0 and (*value).successors == null) {
            ir_add_stat(&mut (*context).stats.validation_failures, 1); return ir_fail(context, IRError.Corruption);
        }
        set index += 1;
    }
    set index = 0;
    while index < (*context).instruction_count {
        let value = &(*context).instructions[index];
        if (*value).operand_count > (*value).operand_capacity or (*value).operand_count > (*context).max_values or
           (*value).phi_count > (*value).phi_capacity or (*value).phi_count > (*context).max_instructions or
           ((*value).operand_capacity != 0 and (*value).operands == null) or ((*value).phi_capacity != 0 and (*value).phi_incomings == null) {
            ir_add_stat(&mut (*context).stats.validation_failures, 1); return ir_fail(context, IRError.Corruption);
        }
        set index += 1;
    }
    set index = 0;
    let mut string_bytes: usize = 0;
    while index < (*context).string_count {
        let value = &(*context).strings[index];
        let data: string = (*value).data;
        let bytes = data.as_bytes();
        let length: usize = bytes.len();
        let mut next_string_bytes: usize = 0;
        if (*value).id != index as u64 + 1 or (*value).length != length or
           (*value).hash != ir_hash_bytes(bytes.as_ptr() as *const u8, length) or not ir_size_add(string_bytes, length, &mut next_string_bytes) {
            ir_add_stat(&mut (*context).stats.validation_failures, 1);
            return ir_fail(context, IRError.Corruption);
        }
        set string_bytes = next_string_bytes;
        set index += 1;
    }
    if string_bytes != (*context).string_bytes or string_bytes > (*context).max_string_bytes {
        ir_add_stat(&mut (*context).stats.validation_failures, 1);
        return ir_fail(context, IRError.Corruption);
    }
    set index = 0;
    while index < (*context).type_count { if (*context).types[index].id != index as u64 + 1 or not ir_validate_type(context, &mut (*context).types[index]) { ir_add_stat(&mut (*context).stats.validation_failures, 1); return false; } set index += 1; }
    set index = 0;
    while index < (*context).value_count { if (*context).values[index].id != index as u64 + 1 or not ir_validate_value(context, &mut (*context).values[index]) { ir_add_stat(&mut (*context).stats.validation_failures, 1); return false; } set index += 1; }
    set index = 0;
    while index < (*context).global_count {
        let global = &(*context).globals[index];
        let global_type = vitte_ir_get_type(context, (*global).type_);
        let initial = vitte_ir_get_value(context, (*global).initializer);
        if (*global).id != index as u64 + 1 or global_type == null or (*global_type).kind == IRTypeKind.Void or
           (*global_type).kind == IRTypeKind.Function or initial == null or (*initial).type_ != (*global).type_ or
           ((*initial).kind != IRValueKind.ConstantBool and (*initial).kind != IRValueKind.ConstantInteger and
            (*initial).kind != IRValueKind.ConstantFloat and (*initial).kind != IRValueKind.ConstantString and (*initial).kind != IRValueKind.Null) or
           ((*global).name != 0 and vitte_ir_get_string(context, (*global).name) == null) or not ir_span_is_valid((*global).span) {
            ir_add_stat(&mut (*context).stats.validation_failures, 1);
            return ir_fail(context, IRError.InvalidValue);
        }
        set index += 1;
    }
    set index = 0;
    while index < (*context).instruction_count { if (*context).instructions[index].id != index as u64 + 1 or not ir_validate_instruction(context, &mut (*context).instructions[index]) { ir_add_stat(&mut (*context).stats.validation_failures, 1); return false; } set index += 1; }
    set index = 0;
    while index < (*context).block_count { if (*context).blocks[index].id != index as u64 + 1 or not ir_validate_block(context, &mut (*context).blocks[index]) { ir_add_stat(&mut (*context).stats.validation_failures, 1); return false; } set index += 1; }
    set index = 0;
    while index < (*context).function_count { if (*context).functions[index].id != index as u64 + 1 or not ir_validate_function(context, &mut (*context).functions[index]) { ir_add_stat(&mut (*context).stats.validation_failures, 1); return false; } set index += 1; }
    set index = 0;
    while index < (*context).block_count {
        let block = &(*context).blocks[index];
        let function = vitte_ir_get_function(context, (*block).function);
        if function == null or not ir_function_has_block(function, (*block).id) {
            ir_add_stat(&mut (*context).stats.validation_failures, 1);
            return ir_fail(context, IRError.InvalidCfg);
        }
        set index += 1;
    }
    if not ir_validate_instruction_ownership_and_uses(context) {
        ir_add_stat(&mut (*context).stats.validation_failures, 1);
        return false;
    }
    set index = 0;
    while index < (*context).function_count {
        if not ir_validate_function_ssa(context, &mut (*context).functions[index]) {
            ir_add_stat(&mut (*context).stats.validation_failures, 1);
            return false;
        }
        set index += 1;
    }
    set (*context).last_error = IRError.None;
    return true;
}

export proc vitte_ir_seal(context: *mut IRContext) -> bool {
    if not vitte_ir_is_valid(context) or (*context).state != IRState.Building { return ir_fail(context, IRError.InvalidState); }
    if not vitte_ir_validate(context) { set (*context).state = IRState.Failed; return false; }
    set (*context).state = IRState.Sealed; set (*context).last_error = IRError.None;
    return true;
}

export proc vitte_ir_fingerprint(context: *mut IRContext) -> u64 {
    if not vitte_ir_is_valid(context) { return 0; }
    let mut hash: u64 = IR_FNV_OFFSET;
    hash = ir_hash_u64(hash, (*context).string_count as u64);
    let mut index: usize = 0;
    while index < (*context).string_count {
        let value = &(*context).strings[index];
        let data: string = (*value).data;
        hash = ir_hash_u64(hash, (*value).length as u64);
        let mut byte: usize = 0;
        while byte < (*value).length { hash = ir_hash_byte(hash, data.as_bytes()[byte]); set byte += 1; }
        set index += 1;
    }
    hash = ir_hash_u64(hash, (*context).type_count as u64); set index = 0;
    while index < (*context).type_count {
        let value = &(*context).types[index];
        hash = ir_hash_u64(hash, (*value).kind as u64); hash = ir_hash_u64(hash, (*value).element_type);
        hash = ir_hash_u64(hash, (*value).array_length as u64); hash = ir_hash_u64(hash, (*value).return_type);
        hash = ir_hash_u64(hash, (*value).name); hash = ir_hash_u64(hash, if (*value).is_variadic { 1 as u64 } else { 0 as u64 });
        let mut p: usize = 0; while p < (*value).parameter_count { hash = ir_hash_u64(hash, (*value).parameter_types[p]); set p += 1; }
        hash = ir_hash_u64(hash, (*value).field_count as u64);
        set p = 0; while p < (*value).field_count { hash = ir_hash_u64(hash, (*value).field_types[p]); set p += 1; }
        set index += 1;
    }
    hash = ir_hash_u64(hash, (*context).value_count as u64); set index = 0;
    while index < (*context).value_count {
        let value = &(*context).values[index];
        hash = ir_hash_u64(hash, (*value).kind as u64); hash = ir_hash_u64(hash, (*value).type_); hash = ir_hash_u64(hash, (*value).name);
        hash = ir_hash_u64(hash, (*value).integer_value); hash = ir_hash_u64(hash, if (*value).bool_value { 1 as u64 } else { 0 as u64 });
        hash = ir_hash_u64(hash, (*value).string_value); hash = ir_hash_u64(hash, (*value).function); hash = ir_hash_u64(hash, (*value).instruction);
        let mut bits: u64 = 0; copy((&mut bits) as *mut u8, (&(*value).float_value) as *const u8, sizeof(f64)); hash = ir_hash_u64(hash, bits);
        set index += 1;
    }
    hash = ir_hash_u64(hash, (*context).instruction_count as u64); set index = 0;
    while index < (*context).instruction_count {
        let value = &(*context).instructions[index];
        hash = ir_hash_u64(hash, (*value).opcode as u64); hash = ir_hash_u64(hash, (*value).block); hash = ir_hash_u64(hash, (*value).result_type); hash = ir_hash_u64(hash, (*value).target_true); hash = ir_hash_u64(hash, (*value).target_false);
        let mut operand: usize = 0; while operand < (*value).operand_count { hash = ir_hash_u64(hash, (*value).operands[operand]); set operand += 1; }
        let mut phi: usize = 0; while phi < (*value).phi_count { hash = ir_hash_u64(hash, (*value).phi_incomings[phi].block); hash = ir_hash_u64(hash, (*value).phi_incomings[phi].value); set phi += 1; }
        set index += 1;
    }
    hash = ir_hash_u64(hash, (*context).block_count as u64); set index = 0;
    while index < (*context).block_count { let value = &(*context).blocks[index]; hash = ir_hash_u64(hash, (*value).function); hash = ir_hash_u64(hash, (*value).name); let mut edge: usize = 0; while edge < (*value).successor_count { hash = ir_hash_u64(hash, (*value).successors[edge]); set edge += 1; } set index += 1; }
    hash = ir_hash_u64(hash, (*context).function_count as u64); set index = 0;
    while index < (*context).function_count { let value = &(*context).functions[index]; hash = ir_hash_u64(hash, (*value).name); hash = ir_hash_u64(hash, (*value).type_); hash = ir_hash_u64(hash, (*value).linkage as u64); hash = ir_hash_u64(hash, (*value).calling_convention as u64); hash = ir_hash_u64(hash, if (*value).is_declaration { 1 as u64 } else { 0 as u64 }); set index += 1; }
    ir_add_stat(&mut (*context).stats.hash_runs, 1);
    return hash;
}

export proc vitte_ir_stats(context: *IRContext) -> IRStats {
    if not vitte_ir_is_valid(context) { return IRStats {}; }
    return (*context).stats;
}

export proc vitte_ir_set_limits(context: *mut IRContext, max_types: usize, max_values: usize, max_instructions: usize, max_blocks: usize, max_functions: usize, max_string_bytes: usize) -> bool {
    if not vitte_ir_is_valid(context) or (*context).state != IRState.Building {
        if context != null and (*context).magic == IR_MAGIC {
            set (*context).last_error = IRError.InvalidState;
        }
        return false;
    }
    if max_types == 0 or max_values == 0 or max_instructions == 0 or
       max_blocks == 0 or max_functions == 0 or max_string_bytes == 0 {
        set (*context).last_error = IRError.InvalidArgument;
        return false;
    }
    if max_types < (*context).type_count or max_values < (*context).value_count or
       max_instructions < (*context).instruction_count or max_blocks < (*context).block_count or
       max_functions < (*context).function_count or max_string_bytes < (*context).string_bytes {
        set (*context).last_error = IRError.Limit;
        return false;
    }
    set (*context).max_types = max_types;
    set (*context).max_values = max_values;
    set (*context).max_instructions = max_instructions;
    set (*context).max_blocks = max_blocks;
    set (*context).max_functions = max_functions;
    set (*context).max_string_bytes = max_string_bytes;
    set (*context).last_error = IRError.None;
    return true;
}

proc ir_lower_hir_ptr(context: *mut IRLowerContext) -> *HIR {
    if context == null or (*context).hir == null { return null; }
    return (*context).hir as *HIR;
}

proc ir_lower_span(span: *const HIRSpan) -> IRSpan {
    if span == null { return IRSpan {}; }
    return IRSpan { file_id: (*span).file_id, begin: (*span).begin, end: (*span).end, valid: (*span).valid };
}

proc ir_lower_node(context: *mut IRLowerContext, id: HIRNodeId) -> *HIRNode {
    return vitte_hir_get_node(ir_lower_hir_ptr(context), id);
}

proc ir_lower_string(context: *mut IRLowerContext, id: u64) -> *HIRString {
    return vitte_hir_get_string(ir_lower_hir_ptr(context), id);
}

proc ir_lower_symbol(context: *mut IRLowerContext, id: HIRSymbolId) -> *HIRSymbol {
    return vitte_hir_get_symbol(ir_lower_hir_ptr(context), id);
}

proc ir_lower_type_entry(context: *mut IRLowerContext, id: HIRTypeId) -> *HIRType {
    return vitte_hir_get_type(ir_lower_hir_ptr(context), id);
}

proc ir_lower_intern_hir_string(context: *mut IRLowerContext, id: u64) -> IRStringId {
    let source = ir_lower_string(context, id);
    if source == null { return 0; }
    let data: string = (*source).data;
    return vitte_ir_intern_string((*context).ir, data.as_bytes().as_ptr() as *const u8, (*source).length);
}

proc ir_lower_primitive(context: *mut IRLowerContext, kind: IRTypeKind) -> IRTypeId {
    let mut description: IRTypeDesc = IRTypeDesc {}; set description.kind = kind;
    return vitte_ir_intern_type((*context).ir, &description);
}

proc ir_lower_form_field_types(context: *mut IRLowerContext, form_symbol: HIRSymbolId, description: *mut IRTypeDesc) -> bool {
    if context == null or description == null or (*context).hir == null { return false; }
    let hir = (*context).hir;
    let mut declaration_index: usize = 0;
    while declaration_index < (*hir).node_count {
        let declaration = &(*hir).nodes[declaration_index];
        if (*declaration).kind == HIRNodeKind.FormDecl and (*declaration).payload[0] == form_symbol {
            let field_count = (*declaration).payload[2] as usize;
            if field_count == 0 { return true; }
            let mut bytes: usize = 0;
            if not ir_size_mul(field_count, sizeof(IRTypeId), &mut bytes) { return false; }
            set (*description).field_types = allocate(bytes) as *mut IRTypeId;
            if (*description).field_types == null { return ir_fail((*context).ir, IRError.OutOfMemory); }
            set (*description).field_count = field_count;
            let fields: *const HIRNodeId = (*declaration).payload[1] as usize as *const HIRNodeId;
            if fields == null { deallocate((*description).field_types as *mut u8); set (*description).field_types = null; set (*description).field_count = 0; return false; }
            let mut field_index: usize = 0;
            while field_index < field_count {
                let field = ir_lower_node(context, fields[field_index]);
                if field == null or (*field).kind != HIRNodeKind.FieldDecl { deallocate((*description).field_types as *mut u8); set (*description).field_types = null; set (*description).field_count = 0; return false; }
                let hir_field_type = vitte_hir_get_type(hir, (*field).payload[1]);
                if hir_field_type != null and (*hir_field_type).kind == HIRTypeKind.Named and (*hir_field_type).symbol == form_symbol {
                    deallocate((*description).field_types as *mut u8); set (*description).field_types = null; set (*description).field_count = 0; return false;
                }
                set (*description).field_types[field_index] = ir_lower_type(context, (*field).payload[1]);
                if (*description).field_types[field_index] == 0 { deallocate((*description).field_types as *mut u8); set (*description).field_types = null; set (*description).field_count = 0; return false; }
                set field_index += 1;
            }
            return true;
        }
        set declaration_index += 1;
    }
    return false;
}

proc ir_lower_type(context: *mut IRLowerContext, id: HIRTypeId) -> IRTypeId {
    if context == null or id == 0 or id > (*context).type_count as u64 { return 0; }
    let cache_index = (id - 1) as usize;
    if (*context).types[cache_index] != 0 { return (*context).types[cache_index]; }
    let source = ir_lower_type_entry(context, id);
    if source == null { return 0; }
    let mut description: IRTypeDesc = IRTypeDesc {};
    match (*source).kind {
        case HIRTypeKind::Unit | HIRTypeKind::Never => set description.kind = IRTypeKind.Void;
        case HIRTypeKind::Bool => set description.kind = IRTypeKind.Bool;
        case HIRTypeKind::Char => set description.kind = IRTypeKind.Char;
        case HIRTypeKind::I8 => set description.kind = IRTypeKind.I8;
        case HIRTypeKind::I16 => set description.kind = IRTypeKind.I16;
        case HIRTypeKind::I32 => set description.kind = IRTypeKind.I32;
        case HIRTypeKind::I64 => set description.kind = IRTypeKind.I64;
        case HIRTypeKind::U8 => set description.kind = IRTypeKind.U8;
        case HIRTypeKind::U16 => set description.kind = IRTypeKind.U16;
        case HIRTypeKind::U32 => set description.kind = IRTypeKind.U32;
        case HIRTypeKind::U64 => set description.kind = IRTypeKind.U64;
        case HIRTypeKind::F32 => set description.kind = IRTypeKind.F32;
        case HIRTypeKind::F64 => set description.kind = IRTypeKind.F64;
        case HIRTypeKind::String => {
            let byte_type = ir_lower_primitive(context, IRTypeKind.U8);
            if byte_type == 0 { return 0; }
            set description.kind = IRTypeKind.Pointer; set description.element_type = byte_type;
        }
        case HIRTypeKind::Pointer | HIRTypeKind::Reference => {
            set description.element_type = ir_lower_type(context, (*source).element_type);
            if description.element_type == 0 { return 0; }
            set description.kind = IRTypeKind.Pointer;
        }
        case HIRTypeKind::Array => {
            set description.element_type = ir_lower_type(context, (*source).element_type);
            if description.element_type == 0 { return 0; }
            set description.kind = IRTypeKind.Array; set description.array_length = (*source).array_length;
        }
        case HIRTypeKind::Slice => {
            set description.element_type = ir_lower_type(context, (*source).element_type);
            if description.element_type == 0 { return 0; }
            set description.kind = IRTypeKind.Slice;
        }
        case HIRTypeKind::Function => {
            set description.kind = IRTypeKind.Function;
            set description.return_type = ir_lower_type(context, (*source).return_type);
            if description.return_type == 0 { return 0; }
            set description.parameter_count = (*source).parameter_count;
            set description.is_variadic = (*source).variadic;
            if (*source).parameter_count != 0 {
                let mut bytes: usize = 0;
                if not ir_size_mul((*source).parameter_count, sizeof(IRTypeId), &mut bytes) { return ir_fail_id((*context).ir, IRError.Overflow); }
                set description.parameter_types = allocate(bytes) as *mut IRTypeId;
                if description.parameter_types == null { return ir_fail_id((*context).ir, IRError.OutOfMemory); }
                let mut index: usize = 0;
                while index < (*source).parameter_count {
                    set description.parameter_types[index] = ir_lower_type(context, (*source).parameters[index]);
                    if description.parameter_types[index] == 0 { deallocate(description.parameter_types as *mut u8); return 0; }
                    set index += 1;
                }
            }
        }
        case HIRTypeKind::Named => {
            set description.kind = IRTypeKind.Struct;
            if (*source).symbol != 0 {
                let symbol = ir_lower_symbol(context, (*source).symbol);
                if symbol != null {
                    set description.name = ir_lower_intern_hir_string(context, (*symbol).name);
                    if (*symbol).kind == HIRSymbolKind.Pick { set description.kind = IRTypeKind.Pick; }
                    elif (*symbol).kind == HIRSymbolKind.Opaque { set description.kind = IRTypeKind.ForwardOpaque; }
                    elif (*symbol).kind == HIRSymbolKind.Form and not ir_lower_form_field_types(context, (*symbol).id, &mut description) {
                        deallocate(description.field_types as *mut u8);
                        return 0;
                    }
                }
            }
        }
        case HIRTypeKind::Tuple => {
            set description.kind = IRTypeKind.Struct;
            set description.field_count = (*source).parameter_count;
            if (*source).parameter_count != 0 {
                let mut bytes: usize = 0;
                if not ir_size_mul((*source).parameter_count, sizeof(IRTypeId), &mut bytes) { return ir_fail_id((*context).ir, IRError.Overflow); }
                set description.field_types = allocate(bytes) as *mut IRTypeId;
                if description.field_types == null { return ir_fail_id((*context).ir, IRError.OutOfMemory); }
                let mut field_index: usize = 0;
                while field_index < (*source).parameter_count {
                    set description.field_types[field_index] = ir_lower_type(context, (*source).parameters[field_index]);
                    if description.field_types[field_index] == 0 { deallocate(description.field_types as *mut u8); return 0; }
                    set field_index += 1;
                }
            }
        }
        case HIRTypeKind::Optional => {
            set description.kind = IRTypeKind.Struct;
            let optional_name = vitte_ir_intern_string((*context).ir, "Optional".as_ptr() as *const u8, 8);
            let bool_type = ir_lower_primitive(context, IRTypeKind.Bool);
            let element_type = ir_lower_type(context, (*source).element_type);
            if optional_name == 0 or bool_type == 0 or element_type == 0 { return 0; }
            set description.name = optional_name;
            set description.field_count = 2;
            set description.field_types = allocate(2 * sizeof(IRTypeId)) as *mut IRTypeId;
            if description.field_types == null { return ir_fail_id((*context).ir, IRError.OutOfMemory); }
            set description.field_types[0] = bool_type;
            set description.field_types[1] = element_type;
        }
        case HIRTypeKind::GenericParameter | HIRTypeKind::DynTrait => {
            set description.kind = IRTypeKind.Opaque;
            if (*source).symbol != 0 {
                let symbol = ir_lower_symbol(context, (*source).symbol);
                if symbol != null { set description.name = ir_lower_intern_hir_string(context, (*symbol).name); }
            }
        }
        case _ => set description.kind = IRTypeKind.Opaque;
    }
    let result = vitte_ir_intern_type((*context).ir, &description);
    deallocate(description.parameter_types as *mut u8);
    deallocate(description.field_types as *mut u8);
    if result != 0 { set (*context).types[cache_index] = result; }
    return result;
}

proc ir_lower_default_type(context: *mut IRLowerContext) -> IRTypeId {
    let mut index: usize = 1;
    while index <= (*context).type_count {
        let source = ir_lower_type_entry(context, index as u64);
        if source != null and (*source).kind == HIRTypeKind.I64 { return ir_lower_type(context, index as u64); }
        set index += 1;
    }
    return 0;
}

proc ir_lower_find_hir_type(context: *mut IRLowerContext, ir_type: IRTypeId, kind: HIRTypeKind) -> HIRTypeId {
    if context == null or ir_type == 0 { return 0; }
    let mut index: usize = 0;
    while index < (*context).type_count {
        let candidate = ir_lower_type_entry(context, (index + 1) as u64);
        if candidate != null and (*candidate).kind == kind and (*context).types[index] == ir_type { return (index + 1) as u64; }
        set index += 1;
    }
    return 0;
}

proc ir_lower_optional_value(context: *mut IRLowerContext, block: IRBlockId, optional_type: HIRTypeId, value: IRValueId, has_value: bool, span: *const HIRSpan) -> IRValueId {
    let source = ir_lower_type_entry(context, optional_type);
    let lowered_optional = ir_lower_type(context, optional_type);
    let bool_type = ir_lower_primitive(context, IRTypeKind.Bool);
    let flag = if bool_type == 0 { 0 as IRValueId } else { vitte_ir_const_bool((*context).ir, bool_type, has_value) };
    let element_type = if source == null { 0 as IRTypeId } else { ir_lower_type(context, (*source).element_type) };
    let payload = if has_value { value } elif element_type != 0 { vitte_ir_undef((*context).ir, element_type) } else { 0 as IRValueId };
    let mut fields: [IRValueId; 2] = [flag, payload];
    if lowered_optional == 0 or flag == 0 or payload == 0 { return 0; }
    return ir_lower_emit_value(context, IROpcode.StructMake, block, lowered_optional, &mut fields[0], 2, span);
}

proc ir_lower_find_value(context: *mut IRLowerContext, symbol: HIRSymbolId) -> *IRLowerSymbolValue {
    let mut index = (*context).symbol_count;
    while index != 0 {
        set index -= 1;
        if (*context).symbols[index].symbol == symbol { return &(*context).symbols[index]; }
    }
    return null;
}

proc ir_lower_bind_value(context: *mut IRLowerContext, symbol: HIRSymbolId, value: IRValueId, is_address: bool) -> bool {
    if symbol == 0 or value == 0 { return ir_fail((*context).ir, IRError.InvalidValue); }
    let mut required: usize = 0;
    let hir = ir_lower_hir_ptr(context);
    if not ir_size_add((*context).symbol_count, 1, &mut required) { return false; }
    let raw_symbols = ir_reserve_array((*context).ir, (*context).symbols as usize as *mut u8,
        &mut (*context).symbol_capacity, (*context).symbol_count, required,
        sizeof(IRLowerSymbolValue), (*hir).max_symbols + (*hir).max_nodes + 16);
    if raw_symbols == null { return false; }
    set (*context).symbols = raw_symbols as usize as *mut IRLowerSymbolValue;
    set (*context).symbols[(*context).symbol_count] = IRLowerSymbolValue { symbol: symbol, value: value, is_address: is_address };
    set (*context).symbol_count = required;
    return true;
}

proc ir_lower_member_is(context: *mut IRLowerContext, symbol_id: HIRSymbolId, name: string) -> bool {
    let symbol = ir_lower_symbol(context, symbol_id);
    let text: *HIRString = if symbol == null { null } else { ir_lower_string(context, (*symbol).name) };
    if text == null or (*text).length != name.len() { return false; }
    let text_data: string = (*text).data;
    let left: *const u8 = text_data.as_bytes().as_ptr() as *const u8; let right: *const u8 = name as *const u8;
    let mut index: usize = 0;
    while index < name.len() { if left[index] != right[index] { return false; } set index += 1; }
    return true;
}

proc ir_lower_node_list(node: *HIRNode, offset: usize) -> *const HIRNodeId {
    if node == null or offset >= 6 { return null; }
    return (*node).payload[offset] as usize as *const HIRNodeId;
}

proc ir_lower_list_count(node: *HIRNode, offset: usize) -> usize {
    if node == null or offset + 1 >= 8 { return 0; }
    return (*node).payload[offset + 1] as usize;
}

proc ir_lower_type_is_float(context: *mut IRLowerContext, type_id: HIRTypeId) -> bool {
    let value = ir_lower_type_entry(context, type_id);
    return value != null and ((*value).kind == HIRTypeKind.F32 or (*value).kind == HIRTypeKind.F64);
}

proc ir_lower_node_is_string(context: *mut IRLowerContext, node: *HIRNode) -> bool {
    if node == null { return false; }
    let value = ir_lower_type_entry(context, (*node).type_);
    return value != null and (*value).kind == HIRTypeKind.String;
}

proc ir_lower_binary(op: HIRBinaryOperator, floating: bool, is_unsigned: bool) -> IROpcode {
    match op {
        case HIRBinaryOperator::Add => return if floating { IROpcode.Fadd } else { IROpcode.Add };
        case HIRBinaryOperator::Subtract => return if floating { IROpcode.Fsub } else { IROpcode.Sub };
        case HIRBinaryOperator::Multiply => return if floating { IROpcode.Fmul } else { IROpcode.Mul };
        case HIRBinaryOperator::Divide => return if floating { IROpcode.Fdiv } elif is_unsigned { IROpcode.Udiv } else { IROpcode.Sdiv };
        case HIRBinaryOperator::Remainder => return if floating { IROpcode.Frem } elif is_unsigned { IROpcode.Urem } else { IROpcode.Srem };
        case HIRBinaryOperator::BitAnd | HIRBinaryOperator::And => return IROpcode.And;
        case HIRBinaryOperator::BitOr | HIRBinaryOperator::Or => return IROpcode.Or;
        case HIRBinaryOperator::BitXor => return IROpcode.Xor;
        case HIRBinaryOperator::ShiftLeft => return IROpcode.Shl;
        case HIRBinaryOperator::ShiftRight => return if is_unsigned { IROpcode.Lshr } else { IROpcode.Ashr };
        case HIRBinaryOperator::Equal => return if floating { IROpcode.FcmpEq } else { IROpcode.IcmpEq };
        case HIRBinaryOperator::NotEqual => return if floating { IROpcode.FcmpNe } else { IROpcode.IcmpNe };
        case HIRBinaryOperator::Less => return if floating { IROpcode.FcmpLt } elif is_unsigned { IROpcode.IcmpUlt } else { IROpcode.IcmpSlt };
        case HIRBinaryOperator::LessEqual => return if floating { IROpcode.FcmpLe } elif is_unsigned { IROpcode.IcmpUle } else { IROpcode.IcmpSle };
        case HIRBinaryOperator::Greater => return if floating { IROpcode.FcmpGt } elif is_unsigned { IROpcode.IcmpUgt } else { IROpcode.IcmpSgt };
        case HIRBinaryOperator::GreaterEqual => return if floating { IROpcode.FcmpGe } elif is_unsigned { IROpcode.IcmpUge } else { IROpcode.IcmpSge };
        case _ => return IROpcode.Invalid;
    }
}

proc ir_lower_float_literal(node: *HIRNode) -> f64 {
    let mut value: f64 = 0.0;
    copy((&mut value) as *mut u8, (&(*node).payload[1]) as *const u8, sizeof(f64));
    return value;
}


proc ir_lower_emit(context: *mut IRLowerContext, opcode: IROpcode, block: IRBlockId, result_type: IRTypeId, operands: *IRValueId, operand_count: usize, span: *const HIRSpan) -> IRInstructionId {
    let mut description: IRInstructionDesc = IRInstructionDesc {};
    set description.opcode = opcode; set description.block = block; set description.result_type = result_type;
    set description.operands = operands; set description.operand_count = operand_count;
    set description.span = ir_lower_span(span);
    return vitte_ir_add_instruction((*context).ir, &description);
}

proc ir_lower_emit_value(context: *mut IRLowerContext, opcode: IROpcode, block: IRBlockId, result_type: IRTypeId, operands: *IRValueId, operand_count: usize, span: *const HIRSpan) -> IRValueId {
    let instruction = ir_lower_emit(context, opcode, block, result_type, operands, operand_count, span);
    if instruction == 0 { return 0; }
    return vitte_ir_instruction_result((*context).ir, instruction);
}

proc ir_lower_integer_width(kind: IRTypeKind) -> u32 {
    match kind {
        case IRTypeKind::I8 | IRTypeKind::U8 => return 8;
        case IRTypeKind::I16 | IRTypeKind::U16 => return 16;
        case IRTypeKind::I32 | IRTypeKind::U32 | IRTypeKind::Char => return 32;
        case IRTypeKind::I64 | IRTypeKind::U64 => return 64;
        case _ => return 0;
    }
}

proc ir_lower_integer_signed(kind: IRTypeKind) -> bool {
    return kind == IRTypeKind.I8 or kind == IRTypeKind.I16 or
        kind == IRTypeKind.I32 or kind == IRTypeKind.I64;
}

proc ir_lower_numeric_kind(kind: IRTypeKind) -> bool {
    return ir_is_integer(kind) or kind == IRTypeKind.Char or ir_is_float(kind);
}

proc ir_lower_common_numeric_type(
    context: *mut IRLowerContext,
    left_id: IRTypeId,
    right_id: IRTypeId
) -> IRTypeId {
    let left = vitte_ir_get_type((*context).ir, left_id);
    let right = vitte_ir_get_type((*context).ir, right_id);
    if left == null or right == null or
       not ir_lower_numeric_kind((*left).kind) or
       not ir_lower_numeric_kind((*right).kind) { return 0; }
    if left_id == right_id { return left_id; }
    if (*left).kind == IRTypeKind.F64 or (*right).kind == IRTypeKind.F64 {
        return ir_lower_primitive(context, IRTypeKind.F64);
    }
    if (*left).kind == IRTypeKind.F32 or (*right).kind == IRTypeKind.F32 {
        return ir_lower_primitive(context, IRTypeKind.F32);
    }
    if (*left).kind == IRTypeKind.U64 or (*right).kind == IRTypeKind.U64 {
        return ir_lower_primitive(context, IRTypeKind.U64);
    }
    return ir_lower_primitive(context, IRTypeKind.I64);
}

proc ir_lower_convert_numeric(
    context: *mut IRLowerContext,
    block: *mut IRBlockId,
    value_id: IRValueId,
    expected: IRTypeId,
    span: *const HIRSpan
) -> IRValueId {
    let value = vitte_ir_get_value((*context).ir, value_id);
    let source = if value == null { null } else { vitte_ir_get_type((*context).ir, (*value).type_) };
    let target = vitte_ir_get_type((*context).ir, expected);
    if value == null or source == null or target == null { return 0; }
    if (*value).type_ == expected { return value_id; }
    if not ir_lower_numeric_kind((*source).kind) or not ir_lower_numeric_kind((*target).kind) {
        return 0;
    }
    let source_width = ir_lower_integer_width((*source).kind);
    let target_width = ir_lower_integer_width((*target).kind);
    let opcode: IROpcode = if source_width != 0 and target_width != 0 {
        if source_width > target_width { IROpcode.Trunc }
        elif source_width < target_width {
            if ir_lower_integer_signed((*source).kind) { IROpcode.Sext } else { IROpcode.Zext }
        } else { IROpcode.Bitcast }
    } elif ir_is_float((*source).kind) and ir_is_float((*target).kind) {
        if (*source).kind == IRTypeKind.F64 { IROpcode.FpTrunc } else { IROpcode.FpExt }
    } elif source_width != 0 and ir_is_float((*target).kind) {
        if ir_lower_integer_signed((*source).kind) { IROpcode.SiToFp } else { IROpcode.UiToFp }
    } elif ir_is_float((*source).kind) and target_width != 0 {
        if ir_lower_integer_signed((*target).kind) { IROpcode.FpToSi } else { IROpcode.FpToUi }
    } else { IROpcode.Invalid };
    if opcode == IROpcode.Invalid { return 0; }
    let mut operand = value_id;
    return ir_lower_emit_value(context, opcode, *block, expected, &mut operand, 1, span);
}

proc ir_lower_array_expr_as(context: *mut IRLowerContext, function: IRFunctionId, block: *mut IRBlockId, node: *HIRNode, expected: IRTypeId) -> IRValueId {
    let expected_type = vitte_ir_get_type((*context).ir, expected);
    if node == null or expected_type == null or (*node).kind != HIRNodeKind.Array or
       ((*expected_type).kind != IRTypeKind.Array and (*expected_type).kind != IRTypeKind.Slice) { return 0; }
    let expected_kind = (*expected_type).kind;
    let expected_element_type = (*expected_type).element_type;
    let expected_array_length = (*expected_type).array_length;
    let count = ir_lower_list_count(node, 0);
    let is_slice: bool = expected_kind == IRTypeKind.Slice;
    if not is_slice and count != expected_array_length { return ir_fail_id((*context).ir, IRError.TypeMismatch); }
    let mut array_type: IRTypeId = expected;
    if is_slice {
        let mut description: IRTypeDesc = IRTypeDesc {};
        set description.kind = IRTypeKind.Array;
        set description.element_type = expected_element_type;
        set description.array_length = count;
        set array_type = vitte_ir_intern_type((*context).ir, &description);
    }
    if array_type == 0 { return 0; }
    let mut bytes: usize = 0;
    if not ir_size_mul(count, sizeof(IRValueId), &mut bytes) { return ir_fail_id((*context).ir, IRError.Overflow); }
    let operands: *mut IRValueId = if count == 0 { null } else { allocate(bytes) as *mut IRValueId };
    if count != 0 and operands == null { return ir_fail_id((*context).ir, IRError.OutOfMemory); }
    let elements = ir_lower_node_list(node, 0);
    let mut index: usize = 0;
    while index < count {
        let value = ir_lower_expr_as(context, function, block, elements[index], expected_element_type);
        if value == 0 { deallocate(operands as *mut u8); return 0; }
        set operands[index] = value;
        set index += 1;
    }
    let array = ir_lower_emit_value(context, IROpcode.ArrayMake, *block, array_type, operands, count, &(*node).span);
    deallocate(operands as *mut u8);
    if array == 0 or not is_slice { return array; }
    let length_type = ir_lower_primitive(context, IRTypeKind.U64);
    let length = vitte_ir_const_integer((*context).ir, length_type, count as u64);
    if length_type == 0 or length == 0 { return 0; }
    let mut slice_operands: [IRValueId; 2] = [array, length];
    return ir_lower_emit_value(context, IROpcode.SliceMake, *block, expected, &mut slice_operands[0], 2, &(*node).span);
}

proc ir_lower_expr_as(context: *mut IRLowerContext, function: IRFunctionId, block: *mut IRBlockId, node_id: HIRNodeId, expected: IRTypeId) -> IRValueId {
    let node = ir_lower_node(context, node_id);
    let expected_type = vitte_ir_get_type((*context).ir, expected);
    if node == null or expected_type == null { return 0; }
    let source_hir_type = ir_lower_type_entry(context, (*node).type_);
    if (*expected_type).kind != IRTypeKind.Void and source_hir_type != null and (*source_hir_type).kind == HIRTypeKind.Never {
        let value = ir_lower_expr(context, function, block, node_id);
        let lowered_block = vitte_ir_get_block((*context).ir, *block);
        if value != 0 and lowered_block != null and (*lowered_block).terminated {
            return vitte_ir_undef((*context).ir, expected);
        }
        return 0;
    }
    // Unit has no machine value. Lower it for its side effects and return the
    // void marker without routing it through numeric conversion.
    if (*expected_type).kind == IRTypeKind.Void {
        let value = ir_lower_expr(context, function, block, node_id);
        let lowered = vitte_ir_get_value((*context).ir, value);
        return if lowered != null and (*lowered).type_ == expected { value } else { 0 as IRValueId };
    }
    let expected_optional = ir_lower_find_hir_type(context, expected, HIRTypeKind.Optional);
    if expected_optional != 0 {
        if (*node).kind == HIRNodeKind.Literal and ((*node).payload[0] as HIRLiteralKind) == HIRLiteralKind.Null {
            return ir_lower_optional_value(context, *block, expected_optional, 0, false, &(*node).span);
        }
        let source_hir_type = ir_lower_type_entry(context, (*node).type_);
        if (*node).type_ != expected_optional and (source_hir_type == null or (*source_hir_type).kind != HIRTypeKind.Optional) {
            let optional_record = ir_lower_type_entry(context, expected_optional);
            if optional_record == null { return ir_fail_id((*context).ir, IRError.InvalidType); }
            let element_type = ir_lower_type(context, (*optional_record).element_type);
            let value = if element_type == 0 { 0 as IRValueId } else { ir_lower_expr_as(context, function, block, node_id, element_type) };
            if value == 0 { return 0; }
            return ir_lower_optional_value(context, *block, expected_optional, value, true, &(*node).span);
        }
    }
    if (*node).kind == HIRNodeKind.Array {
        return ir_lower_array_expr_as(context, function, block, node, expected);
    }
    if (*node).kind == HIRNodeKind.Tuple {
        let aggregate = vitte_ir_get_type((*context).ir, expected);
        let count = ir_lower_list_count(node, 0);
        if aggregate == null or (*aggregate).kind != IRTypeKind.Struct or (*aggregate).field_count != count {
            return ir_fail_id((*context).ir, IRError.TypeMismatch);
        }
        let mut bytes: usize = 0;
        if not ir_size_mul(count, sizeof(IRValueId), &mut bytes) { return ir_fail_id((*context).ir, IRError.Overflow); }
        let operands: *mut IRValueId = if count == 0 { null } else { allocate(bytes) as *mut IRValueId };
        if count != 0 and operands == null { return ir_fail_id((*context).ir, IRError.OutOfMemory); }
        let elements = ir_lower_node_list(node, 0);
        let mut index: usize = 0;
        while index < count {
            let current_aggregate = vitte_ir_get_type((*context).ir, expected);
            if current_aggregate == null or index >= (*current_aggregate).field_count {
                deallocate(operands as *mut u8);
                return 0;
            }
            let field_type = (*current_aggregate).field_types[index];
            set operands[index] = ir_lower_expr_as(context, function, block, elements[index], field_type);
            if operands[index] == 0 { deallocate(operands as *mut u8); return 0; }
            set index += 1;
        }
        let result = ir_lower_emit_value(context, IROpcode.StructMake, *block, expected, operands, count, &(*node).span);
        deallocate(operands as *mut u8);
        return result;
    }
    if (*node).kind == HIRNodeKind.FormInit {
        let aggregate = vitte_ir_get_type((*context).ir, expected);
        if aggregate == null or (*aggregate).kind != IRTypeKind.Struct { return 0; }
        let field_count = (*aggregate).field_count;
        if ir_lower_list_count(node, 1) != field_count { return 0; }
        let mut bytes: usize = 0;
        if not ir_size_mul(field_count, sizeof(IRValueId), &mut bytes) { return ir_fail_id((*context).ir, IRError.Overflow); }
        let fields: *mut IRValueId = if field_count == 0 { null } else { allocate(bytes) as *mut IRValueId };
        if field_count != 0 and fields == null { return ir_fail_id((*context).ir, IRError.OutOfMemory); }
        let mut initialized: *mut bool = null;
        if field_count != 0 {
            set initialized = allocate(field_count * sizeof(bool)) as *mut bool;
            if initialized == null { deallocate(fields as *mut u8); return ir_fail_id((*context).ir, IRError.OutOfMemory); }
            fill(initialized as *mut u8, 0, field_count * sizeof(bool));
        }
        let source_fields = ir_lower_node_list(node, 1);
        let mut source_index: usize = 0;
        while source_index < field_count {
            let field = ir_lower_node(context, source_fields[source_index]);
            if field == null or (*field).kind != HIRNodeKind.FieldInit or (*field).payload[2] >= field_count as u64 {
                deallocate(fields as *mut u8); deallocate(initialized as *mut u8); return 0;
            }
            let field_index = (*field).payload[2] as usize;
            if initialized[field_index] { deallocate(fields as *mut u8); deallocate(initialized as *mut u8); return 0; }
            let current_aggregate = vitte_ir_get_type((*context).ir, expected);
            if current_aggregate == null or field_index >= (*current_aggregate).field_count {
                deallocate(fields as *mut u8); deallocate(initialized as *mut u8); return 0;
            }
            let expected_field_type = (*current_aggregate).field_types[field_index];
            let value = ir_lower_expr_as(context, function, block, (*field).payload[1], expected_field_type);
            if value == 0 { deallocate(fields as *mut u8); deallocate(initialized as *mut u8); return 0; }
            set fields[field_index] = value;
            set initialized[field_index] = true;
            set source_index += 1;
        }
        let mut field_index: usize = 0;
        while field_index < field_count {
            if not initialized[field_index] { deallocate(fields as *mut u8); deallocate(initialized as *mut u8); return 0; }
            set field_index += 1;
        }
        let result = ir_lower_emit_value(context, IROpcode.StructMake, *block, expected, fields, field_count, &(*node).span);
        deallocate(fields as *mut u8); deallocate(initialized as *mut u8);
        return result;
    }
    if (*node).kind == HIRNodeKind.Literal {
        let kind = (*node).payload[0] as HIRLiteralKind;
        if kind == HIRLiteralKind.Null and (*expected_type).kind == IRTypeKind.Pointer { return vitte_ir_null((*context).ir, expected); }
        if (kind == HIRLiteralKind.SignedInteger or kind == HIRLiteralKind.UnsignedInteger or kind == HIRLiteralKind.Char) and ir_is_integer((*expected_type).kind) {
            return vitte_ir_const_integer((*context).ir, expected, (*node).payload[1]);
        }
        if (kind == HIRLiteralKind.F32 or kind == HIRLiteralKind.F64) and ir_is_float((*expected_type).kind) {
            return vitte_ir_const_float((*context).ir, expected, ir_lower_float_literal(node));
        }
    }
    let value = ir_lower_expr(context, function, block, node_id);
    if value == 0 { return 0; }
    return ir_lower_convert_numeric(context, block, value, expected, &(*node).span);
}

proc ir_lower_lvalue(context: *mut IRLowerContext, function: IRFunctionId, block: *mut IRBlockId, node_id: HIRNodeId) -> IRValueId {
    let node = ir_lower_node(context, node_id);
    if node == null { return 0; }
    if (*node).kind == HIRNodeKind.Symbol {
        let mapped = ir_lower_find_value(context, (*node).payload[0]);
        if mapped != null and (*mapped).is_address { return (*mapped).value; }
        return 0;
    }
    if (*node).kind == HIRNodeKind.Deref { return ir_lower_expr(context, function, block, (*node).payload[0]); }
    if (*node).kind == HIRNodeKind.Member {
        let object_node = ir_lower_node(context, (*node).payload[0]);
        if object_node == null { return 0; }
        let object_hir_type = ir_lower_type_entry(context, (*object_node).type_);
        let is_builtin_length = (ir_lower_member_is(context, (*node).payload[1], "length") or ir_lower_member_is(context, (*node).payload[1], "len")) and
            object_hir_type != null and ((*object_hir_type).kind == HIRTypeKind.String or (*object_hir_type).kind == HIRTypeKind.Slice or (*object_hir_type).kind == HIRTypeKind.Array);
        if is_builtin_length { return 0; }
        let object = if (*object_node).kind == HIRNodeKind.Symbol or (*object_node).kind == HIRNodeKind.Member or
                        (*object_node).kind == HIRNodeKind.Index or (*object_node).kind == HIRNodeKind.Deref
            { ir_lower_lvalue(context, function, block, (*node).payload[0]) }
            else { ir_lower_expr(context, function, block, (*node).payload[0]) };
        if object == 0 { return 0; }
        let field_type = ir_lower_type(context, (*node).type_);
        let mut pointer_desc: IRTypeDesc = IRTypeDesc {}; set pointer_desc.kind = IRTypeKind.Pointer; set pointer_desc.element_type = field_type;
        let pointer_type = vitte_ir_intern_type((*context).ir, &pointer_desc);
        let index_type = ir_lower_primitive(context, IRTypeKind.U64);
        let index_value = if index_type == 0 { 0 as IRValueId } else { vitte_ir_const_integer((*context).ir, index_type, (*node).payload[2]) };
        if field_type == 0 or pointer_type == 0 or index_value == 0 { return 0; }
        let mut operands: [IRValueId; 2] = [object, index_value];
        return ir_lower_emit_value(context, IROpcode.StructField, *block, pointer_type, &mut operands[0], 2, &(*node).span);
    }
    if (*node).kind != HIRNodeKind.Index { return 0; }
    let object_node = ir_lower_node(context, (*node).payload[0]);
    if object_node == null { return 0; }
    let object = ir_lower_expr(context, function, block, (*node).payload[0]);
    let index = ir_lower_expr(context, function, block, (*node).payload[1]);
    if object == 0 or index == 0 { return 0; }
    let object_value = vitte_ir_get_value((*context).ir, object);
    let object_type: *IRType = if object_value == null { null } else { vitte_ir_get_type((*context).ir, (*object_value).type_) };
    if object_type == null { return 0; }
    let object_kind = (*object_type).kind;
    let object_element_type = (*object_type).element_type;
    let mut base = object;
    let mut element_type: IRTypeId = object_element_type;
    if object_kind == IRTypeKind.Slice {
        let mut pointer: IRTypeDesc = IRTypeDesc {}; set pointer.kind = IRTypeKind.Pointer; set pointer.element_type = element_type;
        let pointer_type = vitte_ir_intern_type((*context).ir, &pointer); if pointer_type == 0 { return 0; }
        base = ir_lower_emit_value(context, IROpcode.SliceData, *block, pointer_type, &mut base, 1, &(*node).span);
        if base == 0 { return 0; }
    } elif object_kind == IRTypeKind.Array {
        // Fixed arrays use element pointers as their IR values and retain
        // their extent as metadata, so indexing points at the element type.
    } elif object_kind != IRTypeKind.Pointer { return 0; }
    let mut address_desc: IRTypeDesc = IRTypeDesc {}; set address_desc.kind = IRTypeKind.Pointer;
    set address_desc.element_type = if object_kind == IRTypeKind.Pointer { object_element_type } else { element_type };
    let address_type = vitte_ir_intern_type((*context).ir, &address_desc); if address_type == 0 { return 0; }
    let mut operands: [IRValueId; 2] = [base, index];
    return ir_lower_emit_value(context, IROpcode.Gep, *block, address_type, &mut operands[0], 2, &(*node).span);
}

proc ir_lower_struct_field_pointer(context: *mut IRLowerContext, block: IRBlockId, base: IRValueId, aggregate_id: IRTypeId, field_index: usize, span: *const HIRSpan) -> IRValueId {
    let aggregate = vitte_ir_get_type((*context).ir, aggregate_id);
    if aggregate == null or (*aggregate).kind != IRTypeKind.Struct or field_index >= (*aggregate).field_count { return ir_fail_id((*context).ir, IRError.TypeMismatch); }
    let field_type = (*aggregate).field_types[field_index];
    let index_type = ir_lower_primitive(context, IRTypeKind.U64);
    let field_index_value = if index_type == 0 { 0 as IRValueId } else { vitte_ir_const_integer((*context).ir, index_type, field_index as u64) };
    let mut pointer_description: IRTypeDesc = IRTypeDesc {};
    set pointer_description.kind = IRTypeKind.Pointer;
    set pointer_description.element_type = field_type;
    let pointer_type = vitte_ir_intern_type((*context).ir, &pointer_description);
    let mut operands: [IRValueId; 2] = [base, field_index_value];
    if index_type == 0 or field_index_value == 0 or pointer_type == 0 { return 0; }
    return ir_lower_emit_value(context, IROpcode.StructField, block, pointer_type, &mut operands[0], 2, span);
}

proc ir_lower_struct_field_value(context: *mut IRLowerContext, block: IRBlockId, base: IRValueId, aggregate_id: IRTypeId, field_index: usize, span: *const HIRSpan) -> IRValueId {
    let aggregate = vitte_ir_get_type((*context).ir, aggregate_id);
    if aggregate == null or field_index >= (*aggregate).field_count { return 0; }
    let field_type = (*aggregate).field_types[field_index];
    let address = ir_lower_struct_field_pointer(context, block, base, aggregate_id, field_index, span);
    let mut operand = address;
    if address == 0 { return 0; }
    return ir_lower_emit_value(context, IROpcode.Load, block, field_type, &mut operand, 1, span);
}

proc ir_lower_short_circuit(context: *mut IRLowerContext, function: IRFunctionId, block: *mut IRBlockId, node: *HIRNode, is_and: bool) -> IRValueId {
    let bool_type = ir_lower_primitive(context, IRTypeKind.Bool);
    if bool_type == 0 { return 0; }
    let left = ir_lower_expr(context, function, block, (*node).payload[1]);
    let mut pointer_description: IRTypeDesc = IRTypeDesc {};
    set pointer_description.kind = IRTypeKind.Pointer;
    set pointer_description.element_type = bool_type;
    let pointer_type = vitte_ir_intern_type((*context).ir, &pointer_description);
    let result_address = if pointer_type == 0 { 0 as IRValueId } else { ir_lower_emit_value(context, IROpcode.Alloca, *block, pointer_type, null, 0, &(*node).span) };
    let right_block = ir_lower_new_block(context, function, "logic.right");
    let short_block = ir_lower_new_block(context, function, "logic.short");
    let merge_block = ir_lower_new_block(context, function, "logic.merge");
    let short_value = vitte_ir_const_bool((*context).ir, bool_type, not is_and);
    if left == 0 or result_address == 0 or right_block == 0 or short_block == 0 or merge_block == 0 or short_value == 0 { return 0; }
    let true_target = if is_and { right_block } else { short_block };
    let false_target = if is_and { short_block } else { right_block };
    if vitte_ir_build_cond_br((*context).ir, *block, left, true_target, false_target, ir_lower_span(&(*node).span)) == 0 { return 0; }
    let mut short_store: [IRValueId; 2] = [result_address, short_value];
    if ir_lower_emit(context, IROpcode.Store, short_block, 0, &mut short_store[0], 2, &(*node).span) == 0 or
       vitte_ir_build_br((*context).ir, short_block, merge_block, ir_lower_span(&(*node).span)) == 0 { return 0; }
    let mut right_end = right_block;
    let right = ir_lower_expr(context, function, &mut right_end, (*node).payload[2]);
    let mut right_store: [IRValueId; 2] = [result_address, right];
    if right == 0 or ir_lower_emit(context, IROpcode.Store, right_end, 0, &mut right_store[0], 2, &(*node).span) == 0 or
       vitte_ir_build_br((*context).ir, right_end, merge_block, ir_lower_span(&(*node).span)) == 0 { return 0; }
    set *block = merge_block;
    let mut result_pointer = result_address;
    return ir_lower_emit_value(context, IROpcode.Load, *block, bool_type, &mut result_pointer, 1, &(*node).span);
}

proc ir_lower_optional_payload(context: *mut IRLowerContext, block: IRBlockId, optional_type_hir: HIRTypeId, optional_value: IRValueId, span: *const HIRSpan) -> IRValueId {
    let optional_type = ir_lower_type(context, optional_type_hir);
    return ir_lower_struct_field_value(context, block, optional_value, optional_type, 1, span);
}

proc ir_lower_pattern_literal(context: *mut IRLowerContext, pattern: *HIRNode, expected_type: IRTypeId) -> IRValueId {
    let kind = (*pattern).payload[0] as HIRLiteralKind;
    if kind == HIRLiteralKind.Bool { return vitte_ir_const_bool((*context).ir, expected_type, (*pattern).payload[1] != 0); }
    if kind == HIRLiteralKind.SignedInteger or kind == HIRLiteralKind.UnsignedInteger or kind == HIRLiteralKind.Char {
        return vitte_ir_const_integer((*context).ir, expected_type, (*pattern).payload[1]);
    }
    if kind == HIRLiteralKind.F32 or kind == HIRLiteralKind.F64 {
        let mut literal: HIRNode = HIRNode {};
        set literal.kind = HIRNodeKind.Literal; set literal.payload[0] = kind as u64; set literal.payload[1] = (*pattern).payload[1];
        return vitte_ir_const_float((*context).ir, expected_type, ir_lower_float_literal(&literal));
    }
    if kind == HIRLiteralKind.String {
        let text = ir_lower_string(context, (*pattern).payload[1]);
        if text == null { return 0; }
        let data: string = (*text).data;
        let string_id = vitte_ir_intern_string((*context).ir, data.as_bytes().as_ptr() as *const u8, (*text).length);
        if string_id == 0 { return 0; }
        return vitte_ir_const_string((*context).ir, expected_type, string_id);
    }
    if kind == HIRLiteralKind.Null { return vitte_ir_null((*context).ir, expected_type); }
    return 0;
}

proc ir_lower_pattern_condition(context: *mut IRLowerContext, function: IRFunctionId, block: *mut IRBlockId, pattern_id: HIRNodeId, subject: IRValueId) -> IRValueId {
    let pattern = ir_lower_node(context, pattern_id);
    let bool_type = ir_lower_primitive(context, IRTypeKind.Bool);
    if pattern == null or bool_type == 0 { return 0; }
    if (*pattern).kind == HIRNodeKind.PatternWildcard or (*pattern).kind == HIRNodeKind.PatternBinding {
        return vitte_ir_const_bool((*context).ir, bool_type, true);
    }
    if (*pattern).kind == HIRNodeKind.PatternLiteral {
        let pattern_type = ir_lower_type_entry(context, (*pattern).type_);
        if ((*pattern).payload[0] as HIRLiteralKind) == HIRLiteralKind.Null and pattern_type != null and (*pattern_type).kind == HIRTypeKind.Optional {
            let optional_type = ir_lower_type(context, (*pattern).type_);
            let tag = ir_lower_struct_field_value(context, *block, subject, optional_type, 0, &(*pattern).span);
            let absent = vitte_ir_const_bool((*context).ir, bool_type, false);
            let mut operands: [IRValueId; 2] = [tag, absent];
            if tag == 0 or absent == 0 { return 0; }
            return ir_lower_emit_value(context, IROpcode.IcmpEq, *block, bool_type, &mut operands[0], 2, &(*pattern).span);
        }
        let type_id = ir_lower_type(context, (*pattern).type_);
        let expected = ir_lower_pattern_literal(context, pattern, type_id);
        let type_record = vitte_ir_get_type((*context).ir, type_id);
        let opcode: IROpcode = if type_record != null and ir_is_float((*type_record).kind) { IROpcode.FcmpEq } else { IROpcode.IcmpEq };
        let mut operands: [IRValueId; 2] = [subject, expected];
        if type_id == 0 or expected == 0 { return 0; }
        return ir_lower_emit_value(context, opcode, *block, bool_type, &mut operands[0], 2, &(*pattern).span);
    }
    if (*pattern).kind == HIRNodeKind.Range {
        let range_type = ir_lower_type(context, (*pattern).type_);
        let range_record = vitte_ir_get_type((*context).ir, range_type);
        if range_record == null { return 0; }
        let range_kind = (*range_record).kind;
        let lower = ir_lower_expr_as(context, function, block, (*pattern).payload[0], range_type);
        let upper = ir_lower_expr_as(context, function, block, (*pattern).payload[1], range_type);
        let is_unsigned = range_kind == IRTypeKind.U8 or range_kind == IRTypeKind.U16 or
                       range_kind == IRTypeKind.U32 or range_kind == IRTypeKind.U64;
        let floating = ir_is_float(range_kind);
        let lower_opcode: IROpcode = if floating { IROpcode.FcmpLe } elif is_unsigned { IROpcode.IcmpUle } else { IROpcode.IcmpSle };
        let upper_opcode: IROpcode = if floating { if (*pattern).payload[2] != 0 { IROpcode.FcmpLe } else { IROpcode.FcmpLt } }
            elif is_unsigned { if (*pattern).payload[2] != 0 { IROpcode.IcmpUle } else { IROpcode.IcmpUlt } }
            else { if (*pattern).payload[2] != 0 { IROpcode.IcmpSle } else { IROpcode.IcmpSlt } };
        let mut lower_operands: [IRValueId; 2] = [lower, subject];
        let mut upper_operands: [IRValueId; 2] = [subject, upper];
        let lower_test = if lower == 0 { 0 as IRValueId } else { ir_lower_emit_value(context, lower_opcode, *block, bool_type, &mut lower_operands[0], 2, &(*pattern).span) };
        let upper_test = if upper == 0 { 0 as IRValueId } else { ir_lower_emit_value(context, upper_opcode, *block, bool_type, &mut upper_operands[0], 2, &(*pattern).span) };
        let mut both: [IRValueId; 2] = [lower_test, upper_test];
        if lower_test == 0 or upper_test == 0 { return 0; }
        return ir_lower_emit_value(context, IROpcode.And, *block, bool_type, &mut both[0], 2, &(*pattern).span);
    }
    if (*pattern).kind == HIRNodeKind.PatternOr {
        let count = ir_lower_list_count(pattern, 0); let alternatives = ir_lower_node_list(pattern, 0);
        if count == 0 or alternatives == null { return ir_fail_id((*context).ir, IRError.InvalidInstruction); }
        let condition = vitte_ir_const_bool((*context).ir, bool_type, false);
        if condition == 0 { return 0; }
        let mut combined = condition; let mut index: usize = 0;
        while index < count {
            let alternative = ir_lower_pattern_condition(context, function, block, alternatives[index], subject);
            let mut operands: [IRValueId; 2] = [combined, alternative];
            if alternative == 0 { return 0; }
            set combined = ir_lower_emit_value(context, IROpcode.Or, *block, bool_type, &mut operands[0], 2, &(*pattern).span);
            if combined == 0 { return 0; }
            set index += 1;
        }
        return combined;
    }
    if (*pattern).kind == HIRNodeKind.PatternPick {
        let pick_type = ir_lower_type(context, (*pattern).type_);
        let tag_type = ir_lower_primitive(context, IRTypeKind.U64);
        let mut source: [IRValueId; 1] = [subject];
        let tag = if tag_type == 0 { 0 as IRValueId } else { ir_lower_emit_value(context, IROpcode.PickTag, *block, tag_type, &mut source[0], 1, &(*pattern).span) };
        let expected_tag = if tag_type == 0 { 0 as IRValueId } else { vitte_ir_const_integer((*context).ir, tag_type, (*pattern).payload[4]) };
        let mut compare: [IRValueId; 2] = [tag, expected_tag];
        if pick_type == 0 or tag == 0 or expected_tag == 0 { return 0; }
        let mut result = ir_lower_emit_value(context, IROpcode.IcmpEq, *block, bool_type, &mut compare[0], 2, &(*pattern).span);
        let count = ir_lower_list_count(pattern, 1); let children = ir_lower_node_list(pattern, 1);
        if count != 0 and children == null { return ir_fail_id((*context).ir, IRError.InvalidInstruction); }
        let mut index: usize = 0;
        while index < count {
            let child = ir_lower_node(context, children[index]);
            let child_type = if child == null { 0 as IRTypeId } else { ir_lower_type(context, (*child).type_) };
            let index_type = ir_lower_primitive(context, IRTypeKind.U64);
            let index_value = if index_type == 0 { 0 as IRValueId } else { vitte_ir_const_integer((*context).ir, index_type, index as u64) };
            let mut payload_operands: [IRValueId; 2] = [subject, index_value];
            let payload = if index_value == 0 or child_type == 0 { 0 as IRValueId } else { ir_lower_emit_value(context, IROpcode.PickPayload, *block, child_type, &mut payload_operands[0], 2, &(*pattern).span) };
            let child_condition = if payload == 0 { 0 as IRValueId } else { ir_lower_pattern_condition(context, function, block, children[index], payload) };
            let mut both: [IRValueId; 2] = [result, child_condition];
            if result == 0 or child_condition == 0 { return 0; }
            set result = ir_lower_emit_value(context, IROpcode.And, *block, bool_type, &mut both[0], 2, &(*pattern).span);
            if result == 0 { return 0; }
            set index += 1;
        }
        return result;
    }
    if (*pattern).kind == HIRNodeKind.PatternTuple or (*pattern).kind == HIRNodeKind.PatternForm {
        let aggregate_type_hir = (*pattern).type_;
        let aggregate_type = ir_lower_type(context, aggregate_type_hir);
        let count = if (*pattern).kind == HIRNodeKind.PatternTuple { ir_lower_list_count(pattern, 0) } else { ir_lower_list_count(pattern, 1) };
        let children = if (*pattern).kind == HIRNodeKind.PatternTuple { ir_lower_node_list(pattern, 0) } else { ir_lower_node_list(pattern, 1) };
        if aggregate_type == 0 or (count != 0 and children == null) { return 0; }
        let mut result = vitte_ir_const_bool((*context).ir, bool_type, true);
        let mut index: usize = 0;
        while index < count {
            let child = ir_lower_node(context, children[index]);
            let field_index = if child == null or (*pattern).kind == HIRNodeKind.PatternTuple { index } else { (*child).payload[2] as usize };
            let child_id: HIRNodeId = if child == null { 0 as HIRNodeId } elif (*pattern).kind == HIRNodeKind.PatternTuple { children[index] } else { (*child).payload[1] as HIRNodeId };
            let child_record = ir_lower_node(context, child_id);
            if child == null or child_record == null { return 0; }
            let field = ir_lower_struct_field_value(context, *block, subject, aggregate_type, field_index, &(*pattern).span);
            let condition = if field == 0 { 0 as IRValueId } else { ir_lower_pattern_condition(context, function, block, child_id, field) };
            let mut both: [IRValueId; 2] = [result, condition];
            if result == 0 or condition == 0 { return 0; }
            set result = ir_lower_emit_value(context, IROpcode.And, *block, bool_type, &mut both[0], 2, &(*pattern).span);
            if result == 0 { return 0; }
            set index += 1;
        }
        return result;
    }
    return ir_fail_id((*context).ir, IRError.Unsupported);
}

proc ir_lower_bind_pattern(context: *mut IRLowerContext, function: IRFunctionId, block: *mut IRBlockId, pattern_id: HIRNodeId, subject: IRValueId) -> bool {
    let pattern = ir_lower_node(context, pattern_id);
    if pattern == null or block == null { return ir_fail((*context).ir, IRError.InvalidInstruction); }
    if (*pattern).kind == HIRNodeKind.PatternWildcard or (*pattern).kind == HIRNodeKind.PatternLiteral or (*pattern).kind == HIRNodeKind.Range { return true; }
    if (*pattern).kind == HIRNodeKind.PatternBinding {
        let symbol_id = (*pattern).payload[0] as HIRSymbolId;
        let symbol = ir_lower_symbol(context, symbol_id);
        let binding_type = if symbol == null { 0 as IRTypeId } else { ir_lower_type(context, (*symbol).type_) };
        let mut value = subject;
        if binding_type == 0 { return ir_fail((*context).ir, IRError.InvalidType); }
        let source_value = vitte_ir_get_value((*context).ir, value);
        if source_value == null { return ir_fail((*context).ir, IRError.InvalidValue); }
        if (*source_value).type_ != binding_type {
            set value = ir_lower_convert_numeric(context, block, value, binding_type, &(*pattern).span);
        }
        let mut pointer_description: IRTypeDesc = IRTypeDesc {};
        set pointer_description.kind = IRTypeKind.Pointer; set pointer_description.element_type = binding_type;
        let pointer_type = vitte_ir_intern_type((*context).ir, &pointer_description);
        let address = if pointer_type == 0 { 0 as IRValueId } else { ir_lower_emit_value(context, IROpcode.Alloca, *block, pointer_type, null, 0, &(*pattern).span) };
        let mut operands: [IRValueId; 2] = [address, value];
        if value == 0 or address == 0 or ir_lower_emit(context, IROpcode.Store, *block, 0, &mut operands[0], 2, &(*pattern).span) == 0 or
           not ir_lower_bind_value(context, symbol_id, address, true) { return false; }
        return true;
    }
    if (*pattern).kind == HIRNodeKind.PatternOr {
        let children = ir_lower_node_list(pattern, 0);
        if ir_lower_list_count(pattern, 0) == 0 or children == null { return ir_fail((*context).ir, IRError.InvalidInstruction); }
        return ir_lower_bind_pattern(context, function, block, children[0], subject);
    }
    if (*pattern).kind == HIRNodeKind.PatternTuple or (*pattern).kind == HIRNodeKind.PatternForm {
        let aggregate_type = ir_lower_type(context, (*pattern).type_);
        let count = if (*pattern).kind == HIRNodeKind.PatternTuple { ir_lower_list_count(pattern, 0) } else { ir_lower_list_count(pattern, 1) };
        let children = if (*pattern).kind == HIRNodeKind.PatternTuple { ir_lower_node_list(pattern, 0) } else { ir_lower_node_list(pattern, 1) };
        if aggregate_type == 0 or (count != 0 and children == null) { return ir_fail((*context).ir, IRError.InvalidType); }
        let mut index: usize = 0;
        while index < count {
            let child = ir_lower_node(context, children[index]);
            if child == null { return ir_fail((*context).ir, IRError.InvalidInstruction); }
            let field_index = if (*pattern).kind == HIRNodeKind.PatternTuple { index } else { (*child).payload[2] as usize };
            let child_id: HIRNodeId = if (*pattern).kind == HIRNodeKind.PatternTuple { children[index] } else { (*child).payload[1] as HIRNodeId };
            let field = ir_lower_struct_field_value(context, *block, subject, aggregate_type, field_index, &(*pattern).span);
            if field == 0 or not ir_lower_bind_pattern(context, function, block, child_id, field) { return false; }
            set index += 1;
        }
        return true;
    }
    if (*pattern).kind == HIRNodeKind.PatternPick {
        let count = ir_lower_list_count(pattern, 1); let children = ir_lower_node_list(pattern, 1);
        if count != 0 and children == null { return ir_fail((*context).ir, IRError.InvalidInstruction); }
        let mut index: usize = 0;
        while index < count {
            let child = ir_lower_node(context, children[index]);
            let child_type = if child == null { 0 as IRTypeId } else { ir_lower_type(context, (*child).type_) };
            let index_type = ir_lower_primitive(context, IRTypeKind.U64);
            let index_value = if index_type == 0 { 0 as IRValueId } else { vitte_ir_const_integer((*context).ir, index_type, index as u64) };
            let mut operands: [IRValueId; 2] = [subject, index_value];
            let payload = if child_type == 0 or index_value == 0 { 0 as IRValueId } else { ir_lower_emit_value(context, IROpcode.PickPayload, *block, child_type, &mut operands[0], 2, &(*pattern).span) };
            if child == null or payload == 0 or not ir_lower_bind_pattern(context, function, block, children[index], payload) { return false; }
            set index += 1;
        }
        return true;
    }
    return ir_fail((*context).ir, IRError.Unsupported);
}

proc ir_lower_coalesce(context: *mut IRLowerContext, function: IRFunctionId, block: *mut IRBlockId, node: *HIRNode) -> IRValueId {
    let optional_node = ir_lower_node(context, (*node).payload[1]);
    if optional_node == null { return ir_fail_id((*context).ir, IRError.InvalidValue); }
    if (*optional_node).kind == HIRNodeKind.Literal and ((*optional_node).payload[0] as HIRLiteralKind) == HIRLiteralKind.Null {
        let result_type = ir_lower_type(context, (*node).type_);
        if result_type == 0 { return ir_fail_id((*context).ir, IRError.InvalidType); }
        return ir_lower_expr_as(context, function, block, (*node).payload[2], result_type);
    }
    let optional_hir_type = (*optional_node).type_;
    let optional_type_source = ir_lower_type_entry(context, optional_hir_type);
    if optional_type_source == null or (*optional_type_source).kind != HIRTypeKind.Optional { return ir_fail_id((*context).ir, IRError.TypeMismatch); }
    let optional_type = ir_lower_type(context, optional_hir_type);
    let bool_type = ir_lower_primitive(context, IRTypeKind.Bool);
    let mut optional_end = *block;
    let optional_value = ir_lower_expr(context, function, &mut optional_end, (*node).payload[1]);
    let tag = if optional_value == 0 { 0 as IRValueId } else { ir_lower_struct_field_value(context, optional_end, optional_value, optional_type, 0, &(*node).span) };
    let result_type = ir_lower_type(context, (*node).type_);
    let mut result_pointer_description: IRTypeDesc = IRTypeDesc {};
    set result_pointer_description.kind = IRTypeKind.Pointer; set result_pointer_description.element_type = result_type;
    let result_pointer_type = vitte_ir_intern_type((*context).ir, &result_pointer_description);
    let result_address = if result_pointer_type == 0 { 0 as IRValueId } else { ir_lower_emit_value(context, IROpcode.Alloca, optional_end, result_pointer_type, null, 0, &(*node).span) };
    let mut has_value: IRValueId = 0;
    if tag != 0 and bool_type != 0 {
        let true_value = vitte_ir_const_bool((*context).ir, bool_type, true);
        if true_value != 0 {
            let mut operands: [IRValueId; 2] = [tag, true_value];
            set has_value = ir_lower_emit_value(context, IROpcode.IcmpEq, optional_end, bool_type, &mut operands[0], 2, &(*node).span);
        }
    }
    let some_block = ir_lower_new_block(context, function, "coalesce.some");
    let none_block = ir_lower_new_block(context, function, "coalesce.none");
    let merge_block = ir_lower_new_block(context, function, "coalesce.merge");
    if optional_type == 0 or optional_value == 0 or tag == 0 or has_value == 0 or result_type == 0 or result_address == 0 or
       some_block == 0 or none_block == 0 or merge_block == 0 or
       vitte_ir_build_cond_br((*context).ir, optional_end, has_value, some_block, none_block, ir_lower_span(&(*node).span)) == 0 { return 0; }
    let payload = ir_lower_optional_payload(context, some_block, optional_hir_type, optional_value, &(*node).span);
    let mut some_store: [IRValueId; 2] = [result_address, payload];
    if payload == 0 or ir_lower_emit(context, IROpcode.Store, some_block, 0, &mut some_store[0], 2, &(*node).span) == 0 or
       vitte_ir_build_br((*context).ir, some_block, merge_block, ir_lower_span(&(*node).span)) == 0 { return 0; }
    let mut none_end = none_block;
    let fallback = ir_lower_expr_as(context, function, &mut none_end, (*node).payload[2], result_type);
    let mut none_store: [IRValueId; 2] = [result_address, fallback];
    if fallback == 0 or ir_lower_emit(context, IROpcode.Store, none_end, 0, &mut none_store[0], 2, &(*node).span) == 0 or
       vitte_ir_build_br((*context).ir, none_end, merge_block, ir_lower_span(&(*node).span)) == 0 { return 0; }
    set *block = merge_block;
    let mut result_pointer = result_address;
    return ir_lower_emit_value(context, IROpcode.Load, *block, result_type, &mut result_pointer, 1, &(*node).span);
}

proc ir_lower_block_expression(context: *mut IRLowerContext, function: IRFunctionId, block: *mut IRBlockId, node: *HIRNode) -> IRValueId {
    if context == null or node == null or (*node).kind != HIRNodeKind.Block { return 0; }
    let type_id = ir_lower_type(context, (*node).type_);
    if type_id == 0 { return ir_fail_id((*context).ir, IRError.InvalidType); }
    let saved_symbol_count = (*context).symbol_count;
    let saved_defer_count = (*context).defer_count;
    let items = ir_lower_node_list(node, 0);
    let count = ir_lower_list_count(node, 0);
    let mut current = *block;
    let mut index: usize = 0;
    while index < count {
        let current_block = vitte_ir_get_block((*context).ir, current);
        if current_block == null { set (*context).symbol_count = saved_symbol_count; set (*context).defer_count = saved_defer_count; return ir_fail_id((*context).ir, IRError.InvalidBlock); }
        if (*current_block).terminated { break; }
        if not ir_lower_statement(context, function, current, items[index], &mut current) {
            set (*context).symbol_count = saved_symbol_count; set (*context).defer_count = saved_defer_count;
            return 0;
        }
        set index += 1;
    }
    let tail = (*node).payload[3] as HIRNodeId;
    let before_tail = vitte_ir_get_block((*context).ir, current);
    let tail_reachable = before_tail != null and not (*before_tail).terminated;
    let value = if tail == 0 or not tail_reachable { 0 as IRValueId } else { ir_lower_expr(context, function, &mut current, tail) };
    let final_block = vitte_ir_get_block((*context).ir, current);
    let final_is_live = final_block != null and not (*final_block).terminated;
    let defer_ok = final_block != null and (not final_is_live or ir_lower_run_defers(context, function, &mut current, saved_defer_count));
    let after_defers = vitte_ir_get_block((*context).ir, current);
    set (*context).symbol_count = saved_symbol_count;
    set (*context).defer_count = saved_defer_count;
    if tail != 0 and tail_reachable and value == 0 { return 0; }
    if final_block == null or after_defers == null or (final_is_live and (*after_defers).terminated) or not defer_ok { return ir_fail_id((*context).ir, IRError.InvalidCfg); }
    set *block = current;
    if tail == 0 or not tail_reachable { return vitte_ir_undef((*context).ir, type_id); }
    return value;
}

proc ir_lower_expr(context: *mut IRLowerContext, function: IRFunctionId, block: *mut IRBlockId, node_id: HIRNodeId) -> IRValueId {
    let node = ir_lower_node(context, node_id);
    if node == null { return 0; }
    let mut type_id = ir_lower_type(context, (*node).type_);
    if type_id == 0 { set type_id = ir_lower_default_type(context); }
    if type_id == 0 { return 0; }
    match (*node).kind {
        case HIRNodeKind::Literal => {
            let kind = (*node).payload[0] as HIRLiteralKind;
            match kind {
                case HIRLiteralKind::Bool => return vitte_ir_const_bool((*context).ir, type_id, (*node).payload[1] != 0);
                case HIRLiteralKind::SignedInteger | HIRLiteralKind::UnsignedInteger | HIRLiteralKind::Char => return vitte_ir_const_integer((*context).ir, type_id, (*node).payload[1]);
                case HIRLiteralKind::F32 | HIRLiteralKind::F64 => return vitte_ir_const_float((*context).ir, type_id, ir_lower_float_literal(node));
                case HIRLiteralKind::String => {
                    let text: *HIRString = ir_lower_string(context, (*node).payload[1]); if text == null { return 0; }
                    let text_data: string = (*text).data;
                    let string_id = vitte_ir_intern_string((*context).ir, text_data.as_bytes().as_ptr() as *const u8, (*text).length);
                    if string_id == 0 { return 0; }
                    return vitte_ir_const_string((*context).ir, type_id, string_id);
                }
                case HIRLiteralKind::Null => return vitte_ir_null((*context).ir, type_id);
                case _ => return 0;
            }
        }
        case HIRNodeKind::Symbol => {
            let mapped = ir_lower_find_value(context, (*node).payload[0]); if mapped == null { return 0; }
            if not (*mapped).is_address { return (*mapped).value; }
            let mut address = (*mapped).value;
            return ir_lower_emit_value(context, IROpcode.Load, *block, type_id, &mut address, 1, &(*node).span);
        }
        case HIRNodeKind::Block => return ir_lower_block_expression(context, function, block, node);
        case HIRNodeKind::Tuple => return ir_lower_expr_as(context, function, block, node_id, type_id);
        case HIRNodeKind::Array => return ir_lower_array_expr_as(context, function, block, node, type_id);
        case HIRNodeKind::FormInit => return ir_lower_expr_as(context, function, block, node_id, type_id);
        case HIRNodeKind::IfExpr => return ir_lower_if_expr(context, function, block, node);
        case HIRNodeKind::PickConstruct => {
            let payload_count = ir_lower_list_count(node, 1);
            let payloads = ir_lower_node_list(node, 1);
            if payload_count > 16 or (payload_count != 0 and payloads == null) { return ir_fail_id((*context).ir, IRError.Unsupported); }
            let tag_type = ir_lower_primitive(context, IRTypeKind.U64);
            let tag = vitte_ir_const_integer((*context).ir, tag_type, (*node).payload[4]);
            if tag_type == 0 or tag == 0 { return 0; }
            let operand_count = payload_count + 1;
            let mut operand_bytes: usize = 0;
            if not ir_size_mul(operand_count, sizeof(IRValueId), &mut operand_bytes) { return ir_fail_id((*context).ir, IRError.Overflow); }
            let operands: *mut IRValueId = allocate(operand_bytes) as *mut IRValueId;
            if operands == null { return ir_fail_id((*context).ir, IRError.OutOfMemory); }
            set operands[0] = tag;
            let mut payload_index: usize = 0;
            while payload_index < payload_count {
                let payload = ir_lower_expr(context, function, block, payloads[payload_index]);
                if payload == 0 { deallocate(operands as *mut u8); return 0; }
                set operands[payload_index + 1] = payload;
                set payload_index += 1;
            }
            let result = ir_lower_emit_value(context, IROpcode.PickMake, *block, type_id, operands, operand_count, &(*node).span);
            deallocate(operands as *mut u8);
            return result;
        }
        case HIRNodeKind::Unary => {
            let value = ir_lower_expr(context, function, block, (*node).payload[1]); if value == 0 { return 0; }
            let op = (*node).payload[0] as HIRUnaryOperator;
            if op == HIRUnaryOperator.Plus { return value; }
            if op == HIRUnaryOperator.BitNot {
                let mask = vitte_ir_const_integer((*context).ir, type_id, IR_U64_MAX); if mask == 0 { return 0; }
                let mut operands: [IRValueId; 2] = [value, mask];
                return ir_lower_emit_value(context, IROpcode.Xor, *block, type_id, &mut operands[0], 2, &(*node).span);
            }
            let source_type = ir_lower_type_entry(context, (*node).type_);
            let opcode: IROpcode = if op == HIRUnaryOperator.Not { IROpcode.Not }
                elif source_type != null and ((*source_type).kind == HIRTypeKind.F32 or (*source_type).kind == HIRTypeKind.F64) { IROpcode.Fneg }
                else { IROpcode.Neg };
            let mut operand = value;
            return ir_lower_emit_value(context, opcode, *block, type_id, &mut operand, 1, &(*node).span);
        }
        case HIRNodeKind::Binary => {
            let operator = (*node).payload[0] as HIRBinaryOperator;
            if operator == HIRBinaryOperator.And { return ir_lower_short_circuit(context, function, block, node, true); }
            if operator == HIRBinaryOperator.Or { return ir_lower_short_circuit(context, function, block, node, false); }
            if operator == HIRBinaryOperator.Coalesce { return ir_lower_coalesce(context, function, block, node); }
            let left_node = ir_lower_node(context, (*node).payload[1]); let right_node = ir_lower_node(context, (*node).payload[2]);
            if left_node == null or right_node == null { return 0; }
            if ((*node).payload[0] as HIRBinaryOperator) == HIRBinaryOperator.Add and
               ir_lower_node_is_string(context, left_node) and
               ir_lower_node_is_string(context, right_node) {
                let left = ir_lower_expr(context, function, block, (*node).payload[1]);
                let right = ir_lower_expr(context, function, block, (*node).payload[2]);
                if left == 0 or right == 0 { return 0; }
                let mut operands: [IRValueId; 2] = [left, right];
                return ir_lower_emit_value(context, IROpcode.StringConcat, *block, type_id, &mut operands[0], 2, &(*node).span);
            }
            let left_type_id = ir_lower_type(context, (*left_node).type_);
            let left_type: *IRType = vitte_ir_get_type((*context).ir, left_type_id); if left_type == null { return 0; }
            let left_type_kind = (*left_type).kind;
            let right_type_id = ir_lower_type(context, (*right_node).type_);
            let is_comparison = operator == HIRBinaryOperator.Equal or
                operator == HIRBinaryOperator.NotEqual or
                operator == HIRBinaryOperator.Less or
                operator == HIRBinaryOperator.LessEqual or
                operator == HIRBinaryOperator.Greater or
                operator == HIRBinaryOperator.GreaterEqual;
            let common_type = if is_comparison {
                ir_lower_common_numeric_type(context, left_type_id, right_type_id)
            } else {
                type_id
            };
            let operand_type = if common_type != 0 { common_type } else { left_type_id };
            let operand_type_record: *IRType = vitte_ir_get_type((*context).ir, operand_type);
            if operand_type_record == null { return 0; }
            // Lowering either operand can intern pointer types and grow the IR
            // type table, invalidating pointers into its backing storage.
            let operand_type_kind = (*operand_type_record).kind;
            let left = if common_type != 0 {
                ir_lower_expr_as(context, function, block, (*node).payload[1], operand_type)
            } else { ir_lower_expr(context, function, block, (*node).payload[1]) };
            if left == 0 { return 0; }
            let right_is_literal = (*right_node).kind == HIRNodeKind.Literal and
                (((*right_node).payload[0] as HIRLiteralKind) == HIRLiteralKind.SignedInteger or
                 ((*right_node).payload[0] as HIRLiteralKind) == HIRLiteralKind.UnsignedInteger or
                 ((*right_node).payload[0] as HIRLiteralKind) == HIRLiteralKind.F32 or
                 ((*right_node).payload[0] as HIRLiteralKind) == HIRLiteralKind.F64);
            let right = if common_type != 0 { ir_lower_expr_as(context, function, block, (*node).payload[2], operand_type) }
                elif right_is_literal { ir_lower_expr_as(context, function, block, (*node).payload[2], left_type_id) }
                else { ir_lower_expr(context, function, block, (*node).payload[2]) };
            if right == 0 { return 0; }
            let is_unsigned = not ir_lower_integer_signed(operand_type_kind);
            let opcode = ir_lower_binary((*node).payload[0] as HIRBinaryOperator, ir_is_float(operand_type_kind), is_unsigned);
            if opcode == IROpcode.Invalid { return 0; }
            let right_value = vitte_ir_get_value((*context).ir, right);
            let right_type: *IRType = if right_value == null { null } else { vitte_ir_get_type((*context).ir, (*right_value).type_) };
            if (opcode == IROpcode.IcmpEq or opcode == IROpcode.IcmpNe or
                opcode == IROpcode.IcmpSlt or opcode == IROpcode.IcmpSle or
                opcode == IROpcode.IcmpSgt or opcode == IROpcode.IcmpSge or
                opcode == IROpcode.IcmpUlt or opcode == IROpcode.IcmpUle or
                opcode == IROpcode.IcmpUgt or opcode == IROpcode.IcmpUge) and
               left_type_kind == IRTypeKind.Pick and right_type != null and
               (*right_type).kind == IRTypeKind.Pick {
                let tag_type = ir_lower_primitive(context, IRTypeKind.U64);
                let mut left_operand: [IRValueId; 1] = [left];
                let mut right_operand: [IRValueId; 1] = [right];
                let left_tag = ir_lower_emit_value(context, IROpcode.PickTag, *block, tag_type, &mut left_operand[0], 1, &(*node).span);
                let right_tag = ir_lower_emit_value(context, IROpcode.PickTag, *block, tag_type, &mut right_operand[0], 1, &(*node).span);
                if tag_type == 0 or left_tag == 0 or right_tag == 0 { return 0; }
                let mut tag_operands: [IRValueId; 2] = [left_tag, right_tag];
                return ir_lower_emit_value(context, opcode, *block, type_id, &mut tag_operands[0], 2, &(*node).span);
            }
            let mut operands: [IRValueId; 2] = [left, right];
            return ir_lower_emit_value(context, opcode, *block, type_id, &mut operands[0], 2, &(*node).span);
        }
        case HIRNodeKind::Call => {
            let callee_node = ir_lower_node(context, (*node).payload[0]);
            let length_receiver = if callee_node == null or (*callee_node).kind != HIRNodeKind.Member { null } else { ir_lower_node(context, (*callee_node).payload[0]) };
            let length_receiver_type: *HIRType = if length_receiver == null { null } else { ir_lower_type_entry(context, (*length_receiver).type_) };
            let length_method = callee_node != null and (*callee_node).kind == HIRNodeKind.Member and
                (ir_lower_member_is(context, (*callee_node).payload[1], "len") or ir_lower_member_is(context, (*callee_node).payload[1], "length")) and
                length_receiver_type != null and ((*length_receiver_type).kind == HIRTypeKind.String or (*length_receiver_type).kind == HIRTypeKind.Slice or (*length_receiver_type).kind == HIRTypeKind.Array);
            if length_method and ir_lower_list_count(node, 1) == 0 {
                let receiver = ir_lower_expr(context, function, block, (*callee_node).payload[0]); if receiver == 0 { return 0; }
                if (*length_receiver_type).kind == HIRTypeKind.Array {
                    return vitte_ir_const_integer((*context).ir, type_id, (*length_receiver_type).array_length as u64);
                }
                let mut operand = receiver;
                let opcode: IROpcode = if (*length_receiver_type).kind == HIRTypeKind.Slice { IROpcode.SliceLength } else { IROpcode.StringLength };
                return ir_lower_emit_value(context, opcode, *block, type_id, &mut operand, 1, &(*node).span);
            }
            let mut slice_receiver_type: *HIRType = null;
            if callee_node != null and (*callee_node).kind == HIRNodeKind.Member {
                let receiver: *HIRNode = ir_lower_node(context, (*callee_node).payload[0]);
                if receiver != null {
                    set slice_receiver_type = ir_lower_type_entry(context, (*receiver).type_);
                }
            }
            if callee_node != null and (*callee_node).kind == HIRNodeKind.Member and ir_lower_member_is(context, (*callee_node).payload[1], "slice") and
               slice_receiver_type != null and (*slice_receiver_type).kind == HIRTypeKind.String and ir_lower_list_count(node, 1) == 2 {
                let args = ir_lower_node_list(node, 1);
                let receiver = ir_lower_expr(context, function, block, (*callee_node).payload[0]);
                let first = ir_lower_expr(context, function, block, args[0]); let second = ir_lower_expr(context, function, block, args[1]);
                if receiver == 0 or first == 0 or second == 0 { return 0; }
                let mut operands: [IRValueId; 3] = [receiver, first, second];
                return ir_lower_emit_value(context, IROpcode.StringSlice, *block, type_id, &mut operands[0], 3, &(*node).span);
            }
            let callee = ir_lower_expr(context, function, block, (*node).payload[0]); if callee == 0 { return 0; }
            let callee_value = vitte_ir_get_value((*context).ir, callee);
            let signature_type_id: IRTypeId = if callee_value == null { 0 as IRTypeId } else { (*callee_value).type_ };
            let signature: *IRType = if signature_type_id == 0 { null } else { vitte_ir_get_type((*context).ir, signature_type_id) };
            let signature_is_function = signature != null and (*signature).kind == IRTypeKind.Function;
            let signature_parameter_count = if signature_is_function { (*signature).parameter_count } else { 0 as usize };
            let argument_count: usize = ir_lower_list_count(node, 1); let mut count: usize = 0;
            if not ir_size_add(argument_count, 1, &mut count) { return ir_fail_id((*context).ir, IRError.Overflow); }
            let mut bytes: usize = 0; if not ir_size_mul(count, sizeof(IRValueId), &mut bytes) { return ir_fail_id((*context).ir, IRError.Overflow); }
            let operands: *mut IRValueId = allocate(bytes) as *mut IRValueId; if operands == null { return ir_fail_id((*context).ir, IRError.OutOfMemory); }
            set operands[0] = callee; let arguments = ir_lower_node_list(node, 1); let mut index: usize = 0;
            while index < argument_count {
                let mut parameter_type: IRTypeId = 0;
                if signature_is_function and index < signature_parameter_count {
                    let current_signature = vitte_ir_get_type((*context).ir, signature_type_id);
                    if current_signature == null or (*current_signature).kind != IRTypeKind.Function or
                       index >= (*current_signature).parameter_count {
                        deallocate(operands as *mut u8);
                        return 0;
                    }
                    set parameter_type = (*current_signature).parameter_types[index];
                }
                let arg = if parameter_type != 0
                    { ir_lower_expr_as(context, function, block, arguments[index], parameter_type) }
                    else { ir_lower_expr(context, function, block, arguments[index]) };
                if arg == 0 { deallocate(operands as *mut u8); return 0; }
                set operands[index + 1] = arg; set index += 1;
            }
            let result = ir_lower_emit_value(context, IROpcode.Call, *block, type_id, operands, count, &(*node).span);
            deallocate(operands as *mut u8); return result;
        }
        case HIRNodeKind::Member => {
            let object_node = ir_lower_node(context, (*node).payload[0]); if object_node == null { return 0; }
            let object_hir_type = ir_lower_type_entry(context, (*object_node).type_);
            let builtin_length = (ir_lower_member_is(context, (*node).payload[1], "length") or ir_lower_member_is(context, (*node).payload[1], "len")) and
                object_hir_type != null and ((*object_hir_type).kind == HIRTypeKind.String or (*object_hir_type).kind == HIRTypeKind.Slice or (*object_hir_type).kind == HIRTypeKind.Array);
            if not builtin_length {
                let address = ir_lower_lvalue(context, function, block, node_id);
                if address == 0 { return 0; }
                let mut operand = address;
                return ir_lower_emit_value(context, IROpcode.Load, *block, type_id, &mut operand, 1, &(*node).span);
            }
            let object = ir_lower_expr(context, function, block, (*node).payload[0]); if object == 0 { return 0; }
            if (*object_hir_type).kind == HIRTypeKind.Array {
                return vitte_ir_const_integer((*context).ir, type_id, (*object_hir_type).array_length as u64);
            }
            let mut operand = object;
            let opcode: IROpcode = if (*object_hir_type).kind == HIRTypeKind.Slice { IROpcode.SliceLength } else { IROpcode.StringLength };
            return ir_lower_emit_value(context, opcode, *block, type_id, &mut operand, 1, &(*node).span);
        }
        case HIRNodeKind::Index => {
            let address = ir_lower_lvalue(context, function, block, node_id); if address == 0 { return 0; }
            let mut operand = address;
            return ir_lower_emit_value(context, IROpcode.Load, *block, type_id, &mut operand, 1, &(*node).span);
        }
        case HIRNodeKind::Deref => {
            let address = ir_lower_expr(context, function, block, (*node).payload[0]); if address == 0 { return 0; }
            let mut operand = address;
            return ir_lower_emit_value(context, IROpcode.Load, *block, type_id, &mut operand, 1, &(*node).span);
        }
        case HIRNodeKind::Ref => return ir_lower_lvalue(context, function, block, (*node).payload[0]);
        case HIRNodeKind::Move => return ir_lower_expr(context, function, block, (*node).payload[0]);
        case HIRNodeKind::Try => {
            let optional_node = ir_lower_node(context, (*node).payload[0]);
            let optional_type_hir = if optional_node == null { 0 as HIRTypeId } else { (*optional_node).type_ };
            let optional_source = ir_lower_type_entry(context, optional_type_hir);
            if optional_source == null or (*optional_source).kind != HIRTypeKind.Optional { return ir_fail_id((*context).ir, IRError.TypeMismatch); }
            let optional_type = ir_lower_type(context, optional_type_hir);
            let return_type = ir_lower_return_type(context, function);
            if optional_type == 0 or return_type != optional_type { return ir_fail_id((*context).ir, IRError.TypeMismatch); }
            let optional_value = ir_lower_expr(context, function, block, (*node).payload[0]);
            let bool_type = ir_lower_primitive(context, IRTypeKind.Bool);
            let tag = if optional_value == 0 { 0 as IRValueId } else { ir_lower_struct_field_value(context, *block, optional_value, optional_type, 0, &(*node).span) };
            let expected_tag = if bool_type == 0 { 0 as IRValueId } else { vitte_ir_const_bool((*context).ir, bool_type, true) };
            let mut compare_operands: [IRValueId; 2] = [tag, expected_tag];
            let has_value: IRValueId = if tag == 0 or expected_tag == 0 { 0 as IRValueId } else { ir_lower_emit_value(context, IROpcode.IcmpEq, *block, bool_type, &mut compare_operands[0], 2, &(*node).span) };
            let success_block = ir_lower_new_block(context, function, "try.some");
            let failure_block = ir_lower_new_block(context, function, "try.none");
            if optional_value == 0 or tag == 0 or has_value == 0 or success_block == 0 or failure_block == 0 or
               vitte_ir_build_cond_br((*context).ir, *block, has_value, success_block, failure_block, ir_lower_span(&(*node).span)) == 0 { return 0; }
            if vitte_ir_build_return((*context).ir, failure_block, optional_value, ir_lower_span(&(*node).span)) == 0 { return 0; }
            set *block = success_block;
            return ir_lower_optional_payload(context, *block, optional_type_hir, optional_value, &(*node).span);
        }
        case HIRNodeKind::Await => return ir_fail_id((*context).ir, IRError.Unsupported);
        case HIRNodeKind::Cast => {
            let source_node = ir_lower_node(context, (*node).payload[0]); if source_node == null { return 0; }
            let value = ir_lower_expr(context, function, block, (*node).payload[0]); if value == 0 { return 0; }
            let source_id = ir_lower_type(context, (*source_node).type_);
            let source = vitte_ir_get_type((*context).ir, source_id); let target = vitte_ir_get_type((*context).ir, type_id);
            if source == null or target == null { return 0; }
            if source_id == type_id { return value; }
            let source_width = ir_lower_integer_width((*source).kind);
            let target_width = ir_lower_integer_width((*target).kind);
            let opcode: IROpcode = if source_width != 0 and target_width != 0 {
                if source_width > target_width { IROpcode.Trunc }
                elif source_width < target_width { if ir_lower_integer_signed((*source).kind) { IROpcode.Sext } else { IROpcode.Zext } }
                else { IROpcode.Bitcast }
            } elif ir_is_float((*source).kind) and ir_is_float((*target).kind) {
                if (*source).kind == IRTypeKind.F64 { IROpcode.FpTrunc } else { IROpcode.FpExt }
            } elif source_width != 0 and ir_is_float((*target).kind) { if ir_lower_integer_signed((*source).kind) { IROpcode.SiToFp } else { IROpcode.UiToFp } }
            elif ir_is_float((*source).kind) and target_width != 0 { if ir_lower_integer_signed((*target).kind) { IROpcode.FpToSi } else { IROpcode.FpToUi } }
            elif (*source).kind == IRTypeKind.Pointer and ir_is_integer((*target).kind) { IROpcode.PtrToInt }
            elif ir_is_integer((*source).kind) and (*target).kind == IRTypeKind.Pointer { IROpcode.IntToPtr }
            else { IROpcode.Bitcast };
            let mut operand = value;
            return ir_lower_emit_value(context, opcode, *block, type_id, &mut operand, 1, &(*node).span);
        }
        case HIRNodeKind::Sizeof | HIRNodeKind::Alignof | HIRNodeKind::Typeof | HIRNodeKind::Offsetof => return ir_fail_id((*context).ir, IRError.Unsupported);
        case _ => return ir_fail_id((*context).ir, IRError.Unsupported);
    }
}

proc ir_lower_new_block(context: *mut IRLowerContext, function: IRFunctionId, name: string) -> IRBlockId {
    let name_id = vitte_ir_intern_string((*context).ir, name.as_ptr() as *const u8, name.len());
    if name_id == 0 { return 0; }
    return vitte_ir_add_block((*context).ir, function, name_id, IRSpan {});
}

proc ir_lower_push_loop(context: *mut IRLowerContext, break_target: IRBlockId, continue_target: IRBlockId) -> bool {
    let mut required: usize = 0;
    let hir = ir_lower_hir_ptr(context);
    if not ir_size_add((*context).loop_count, 1, &mut required) { return false; }
    let raw_loops = ir_reserve_array((*context).ir, (*context).loops as usize as *mut u8,
        &mut (*context).loop_capacity, (*context).loop_count, required,
        sizeof(IRLowerLoop), (*hir).max_nodes);
    if raw_loops == null { return false; }
    set (*context).loops = raw_loops as usize as *mut IRLowerLoop;
    set (*context).loops[(*context).loop_count] = IRLowerLoop { break_target: break_target, continue_target: continue_target, defer_depth: (*context).defer_count };
    set (*context).loop_count = required;
    return true;
}

proc ir_lower_push_defer(context: *mut IRLowerContext, node: HIRNodeId) -> bool {
    if context == null { return false; }
    if node == 0 { return ir_fail((*context).ir, IRError.InvalidInstruction); }
    let mut required: usize = 0;
    let hir = ir_lower_hir_ptr(context);
    if not ir_size_add((*context).defer_count, 1, &mut required) { return ir_fail((*context).ir, IRError.Overflow); }
    let raw_defers = ir_reserve_array((*context).ir, (*context).defers as usize as *mut u8,
        &mut (*context).defer_capacity, (*context).defer_count, required,
        sizeof(IRLowerDefer), (*hir).max_nodes);
    if raw_defers == null { return false; }
    set (*context).defers = raw_defers as usize as *mut IRLowerDefer;
    set (*context).defers[(*context).defer_count] = IRLowerDefer { node: node };
    set (*context).defer_count = required;
    return true;
}

proc ir_lower_run_defers(context: *mut IRLowerContext, function: IRFunctionId, block: *mut IRBlockId, target_depth: usize) -> bool {
    if context == null { return false; }
    if block == null or target_depth > (*context).defer_count { return ir_fail((*context).ir, IRError.InvalidInstruction); }
    let saved_defer_count = (*context).defer_count;
    let mut cursor = saved_defer_count;
    while cursor > target_depth {
        set cursor -= 1;
        let deferred = ir_lower_node(context, (*context).defers[cursor].node);
        if deferred == null or (*deferred).kind != HIRNodeKind.Defer { set (*context).defer_count = saved_defer_count; return ir_fail((*context).ir, IRError.InvalidInstruction); }
        let body = ir_lower_node(context, (*deferred).payload[0]);
        if body == null { set (*context).defer_count = saved_defer_count; return ir_fail((*context).ir, IRError.InvalidInstruction); }
        let saved_in_defer = (*context).in_defer;
        set (*context).in_defer = true;
        if (*body).kind == HIRNodeKind.Block {
            if not ir_lower_statement(context, function, *block, (*body).id, block) { set (*context).in_defer = saved_in_defer; set (*context).defer_count = saved_defer_count; return false; }
        } else if ir_lower_expr(context, function, block, (*body).id) == 0 {
            set (*context).in_defer = saved_in_defer;
            set (*context).defer_count = saved_defer_count;
            return false;
        }
        set (*context).in_defer = saved_in_defer;
        let current = vitte_ir_get_block((*context).ir, *block);
        if current == null or (*current).terminated { set (*context).defer_count = saved_defer_count; return ir_fail((*context).ir, IRError.InvalidCfg); }
    }
    set (*context).defer_count = saved_defer_count;
    return true;
}

proc ir_lower_return_type(context: *mut IRLowerContext, function: IRFunctionId) -> IRTypeId {
    let mut index: usize = 0;
    while index < (*context).function_count { if (*context).functions[index].function == function { return (*context).functions[index].return_type; } set index += 1; }
    return 0;
}

proc ir_lower_block(context: *mut IRLowerContext, function: IRFunctionId, start: IRBlockId, node: *HIRNode, fallthrough: *mut IRBlockId) -> bool {
    if node == null or (*node).kind != HIRNodeKind.Block or fallthrough == null { return ir_fail((*context).ir, IRError.InvalidBlock); }
    let items = ir_lower_node_list(node, 0); let count = ir_lower_list_count(node, 0);
    let mut current = start; let mut index: usize = 0;
    let saved_symbol_count = (*context).symbol_count;
    let saved_defer_count = (*context).defer_count;
    while index < count {
        if vitte_ir_get_block((*context).ir, current) == null { set (*context).symbol_count = saved_symbol_count; set (*context).defer_count = saved_defer_count; return ir_fail((*context).ir, IRError.InvalidBlock); }
        if (*vitte_ir_get_block((*context).ir, current)).terminated { break; }
        if not ir_lower_statement(context, function, current, items[index], &mut current) { set (*context).symbol_count = saved_symbol_count; set (*context).defer_count = saved_defer_count; return false; }
        set index += 1;
    }
    let tail = (*node).payload[3] as HIRNodeId;
    if tail != 0 and not (*vitte_ir_get_block((*context).ir, current)).terminated {
        if ir_lower_expr(context, function, &mut current, tail) == 0 { set (*context).symbol_count = saved_symbol_count; set (*context).defer_count = saved_defer_count; return false; }
    }
    let current_block = vitte_ir_get_block((*context).ir, current);
    if current_block != null and not (*current_block).terminated and not ir_lower_run_defers(context, function, &mut current, saved_defer_count) {
        set (*context).symbol_count = saved_symbol_count; set (*context).defer_count = saved_defer_count; return false;
    }
    set (*context).symbol_count = saved_symbol_count;
    set (*context).defer_count = saved_defer_count;
    set *fallthrough = current;
    return true;
}

proc ir_lower_if(context: *mut IRLowerContext, function: IRFunctionId, start: IRBlockId, node: *HIRNode, fallthrough: *mut IRBlockId) -> bool {
    let mut condition_block = start;
    let condition = ir_lower_expr(context, function, &mut condition_block, (*node).payload[0]);
    if condition == 0 { return false; }
    let then_block = ir_lower_new_block(context, function, "if.then");
    let else_block = ir_lower_new_block(context, function, "if.else");
    let merge_block = ir_lower_new_block(context, function, "if.merge");
    if then_block == 0 or else_block == 0 or merge_block == 0 or
       vitte_ir_build_cond_br((*context).ir, condition_block, condition, then_block, else_block, ir_lower_span(&(*node).span)) == 0 { return false; }
    let then_node = ir_lower_node(context, (*node).payload[1]); let mut then_end = then_block;
    if then_node == null or not ir_lower_statement(context, function, then_block, (*node).payload[1], &mut then_end) { return false; }
    let then_end_block = vitte_ir_get_block((*context).ir, then_end);
    if then_end_block != null and not (*then_end_block).terminated and vitte_ir_build_br((*context).ir, then_end, merge_block, ir_lower_span(&(*node).span)) == 0 { return false; }
    let mut else_end = else_block;
    if (*node).payload[2] == 0 {
        if vitte_ir_build_br((*context).ir, else_block, merge_block, ir_lower_span(&(*node).span)) == 0 { return false; }
    } else if not ir_lower_statement(context, function, else_block, (*node).payload[2], &mut else_end) { return false; }
    let else_end_block = vitte_ir_get_block((*context).ir, else_end);
    if else_end_block != null and not (*else_end_block).terminated and vitte_ir_build_br((*context).ir, else_end, merge_block, ir_lower_span(&(*node).span)) == 0 { return false; }
    set *fallthrough = merge_block;
    return true;
}

proc ir_lower_match(context: *mut IRLowerContext, function: IRFunctionId, start: IRBlockId, node: *HIRNode, fallthrough: *mut IRBlockId) -> bool {
    if context == null { return false; }
    if node == null or (*node).kind != HIRNodeKind.Match or fallthrough == null {
        return ir_fail((*context).ir, IRError.InvalidInstruction);
    }
    let subject_node = ir_lower_node(context, (*node).payload[0]);
    if subject_node == null { return ir_fail((*context).ir, IRError.InvalidValue); }
    let subject_type = ir_lower_type(context, (*subject_node).type_);
    let mut subject_block = start;
    let subject = ir_lower_expr(context, function, &mut subject_block, (*node).payload[0]);
    let bool_type = ir_lower_primitive(context, IRTypeKind.Bool);
    if subject == 0 or subject_type == 0 or bool_type == 0 { return false; }

    let count = (*node).payload[2] as usize;
    let arms = (*node).payload[1] as *const HIRMatchArm;
    if count == 0 or arms == null { return ir_fail((*context).ir, IRError.InvalidInstruction); }
    let merge = ir_lower_new_block(context, function, "match.merge");
    if merge == 0 { return false; }
    let mut test_block = subject_block;
    let mut index: usize = 0;
    while index < count {
        let arm = &arms[index];
        let pattern = ir_lower_node(context, arm.pattern);
        if pattern == null { return ir_fail((*context).ir, IRError.InvalidInstruction); }
        let mut body_block = ir_lower_new_block(context, function, "match.arm");
        let next_block: IRBlockId = if index + 1 == count { merge } else { ir_lower_new_block(context, function, "match.next") };
        if body_block == 0 or next_block == 0 { return false; }
        let condition = ir_lower_pattern_condition(context, function, &mut test_block, arm.pattern, subject);
        if condition == 0 or vitte_ir_build_cond_br((*context).ir, test_block, condition, body_block, next_block, ir_lower_span(&arm.span)) == 0 { return false; }

        let saved_symbol_count = (*context).symbol_count;
        if not ir_lower_bind_pattern(context, function, &mut body_block, arm.pattern, subject) { set (*context).symbol_count = saved_symbol_count; return false; }
        let mut active_body = body_block;
        if arm.guard != 0 {
            let guard_block = ir_lower_new_block(context, function, "match.guard");
            if guard_block == 0 or vitte_ir_build_br((*context).ir, body_block, guard_block, ir_lower_span(&arm.span)) == 0 { set (*context).symbol_count = saved_symbol_count; return false; }
            let mut guard_end = guard_block;
            let guard = ir_lower_expr(context, function, &mut guard_end, arm.guard);
            let guarded_body = ir_lower_new_block(context, function, "match.guarded");
            if guard == 0 or guarded_body == 0 or
               vitte_ir_build_cond_br((*context).ir, guard_end, guard, guarded_body, next_block, ir_lower_span(&arm.span)) == 0 { set (*context).symbol_count = saved_symbol_count; return false; }
            set active_body = guarded_body;
        }

        let mut body_end = active_body;
        if not ir_lower_statement(context, function, active_body, arm.body, &mut body_end) { set (*context).symbol_count = saved_symbol_count; return false; }
        let body_end_node = vitte_ir_get_block((*context).ir, body_end);
        if body_end_node != null and not (*body_end_node).terminated and
           vitte_ir_build_br((*context).ir, body_end, merge, ir_lower_span(&arm.span)) == 0 { set (*context).symbol_count = saved_symbol_count; return false; }
        set (*context).symbol_count = saved_symbol_count;
        set test_block = next_block;
        set index += 1;
    }
    set *fallthrough = merge;
    return true;
}

proc ir_lower_range_compare(type_id: IRTypeId, inclusive: bool, context: *mut IRLowerContext) -> IROpcode {
    let type_ = vitte_ir_get_type((*context).ir, type_id);
    if type_ == null { return IROpcode.Invalid; }
    let is_unsigned = (*type_).kind == IRTypeKind.U8 or (*type_).kind == IRTypeKind.U16 or
        (*type_).kind == IRTypeKind.U32 or (*type_).kind == IRTypeKind.U64;
    if inclusive { return if is_unsigned { IROpcode.IcmpUle } else { IROpcode.IcmpSle }; }
    return if is_unsigned { IROpcode.IcmpUlt } else { IROpcode.IcmpSlt };
}

proc ir_lower_if_expr(context: *mut IRLowerContext, function: IRFunctionId, block: *mut IRBlockId, node: *HIRNode) -> IRValueId {
    if context == null or node == null or (*node).kind != HIRNodeKind.IfExpr { return 0; }
    let result_type = ir_lower_type(context, (*node).type_);
    if result_type == 0 { return ir_fail_id((*context).ir, IRError.InvalidType); }
    let condition = ir_lower_expr(context, function, block, (*node).payload[0]);
    if condition == 0 { return 0; }
    let result_ir_type = vitte_ir_get_type((*context).ir, result_type);
    if result_ir_type == null { return ir_fail_id((*context).ir, IRError.InvalidType); }
    if (*result_ir_type).kind == IRTypeKind.Void {
        let then_block = ir_lower_new_block(context, function, "if.expr.then");
        let else_block = ir_lower_new_block(context, function, "if.expr.else");
        let merge_block = ir_lower_new_block(context, function, "if.expr.merge");
        if then_block == 0 or else_block == 0 or merge_block == 0 or
           vitte_ir_build_cond_br((*context).ir, *block, condition, then_block, else_block, ir_lower_span(&(*node).span)) == 0 { return 0; }
        let mut then_end = then_block;
        let then_value = ir_lower_expr_as(context, function, &mut then_end, (*node).payload[1], result_type);
        let then_end_block = vitte_ir_get_block((*context).ir, then_end);
        if then_value == 0 or then_end_block == null or
           (not (*then_end_block).terminated and vitte_ir_build_br((*context).ir, then_end, merge_block, ir_lower_span(&(*node).span)) == 0) { return 0; }
        let mut else_end = else_block;
        let else_value = ir_lower_expr_as(context, function, &mut else_end, (*node).payload[2], result_type);
        let else_end_block = vitte_ir_get_block((*context).ir, else_end);
        if else_value == 0 or else_end_block == null or
           (not (*else_end_block).terminated and vitte_ir_build_br((*context).ir, else_end, merge_block, ir_lower_span(&(*node).span)) == 0) { return 0; }
        let merge = vitte_ir_get_block((*context).ir, merge_block);
        if merge == null { return 0; }
        if (*merge).predecessor_count == 0 and vitte_ir_build_unreachable((*context).ir, merge_block, ir_lower_span(&(*node).span)) == 0 { return 0; }
        set *block = merge_block;
        return vitte_ir_undef((*context).ir, result_type);
    }
    let mut pointer_desc: IRTypeDesc = IRTypeDesc {};
    set pointer_desc.kind = IRTypeKind.Pointer;
    set pointer_desc.element_type = result_type;
    let pointer_type = vitte_ir_intern_type((*context).ir, &pointer_desc);
    if pointer_type == 0 { return 0; }
    let result_address = ir_lower_emit_value(context, IROpcode.Alloca, *block, pointer_type, null, 0, &(*node).span);
    let then_block = ir_lower_new_block(context, function, "if.expr.then");
    let else_block = ir_lower_new_block(context, function, "if.expr.else");
    let merge_block = ir_lower_new_block(context, function, "if.expr.merge");
    if result_address == 0 or then_block == 0 or else_block == 0 or merge_block == 0 or
       vitte_ir_build_cond_br((*context).ir, *block, condition, then_block, else_block, ir_lower_span(&(*node).span)) == 0 {
        return 0;
    }
    let mut then_end = then_block;
    let then_value = ir_lower_expr_as(context, function, &mut then_end, (*node).payload[1], result_type);
    let then_end_block = vitte_ir_get_block((*context).ir, then_end);
    if then_value == 0 or then_end_block == null { return 0; }
    if not (*then_end_block).terminated {
        let mut then_store: [IRValueId; 2] = [result_address, then_value];
        if ir_lower_emit(context, IROpcode.Store, then_end, 0, &mut then_store[0], 2, &(*node).span) == 0 or
           vitte_ir_build_br((*context).ir, then_end, merge_block, ir_lower_span(&(*node).span)) == 0 { return 0; }
    }
    let mut else_end = else_block;
    let else_value = ir_lower_expr_as(context, function, &mut else_end, (*node).payload[2], result_type);
    let else_end_block = vitte_ir_get_block((*context).ir, else_end);
    if else_value == 0 or else_end_block == null { return 0; }
    if not (*else_end_block).terminated {
        let mut else_store: [IRValueId; 2] = [result_address, else_value];
        if ir_lower_emit(context, IROpcode.Store, else_end, 0, &mut else_store[0], 2, &(*node).span) == 0 or
           vitte_ir_build_br((*context).ir, else_end, merge_block, ir_lower_span(&(*node).span)) == 0 { return 0; }
    }
    let merge = vitte_ir_get_block((*context).ir, merge_block);
    if merge == null { return 0; }
    if (*merge).predecessor_count == 0 {
        if vitte_ir_build_unreachable((*context).ir, merge_block, ir_lower_span(&(*node).span)) == 0 { return 0; }
        set *block = merge_block;
        return vitte_ir_undef((*context).ir, result_type);
    }
    set *block = merge_block;
    let mut result_pointer = result_address;
    return ir_lower_emit_value(context, IROpcode.Load, *block, result_type, &mut result_pointer, 1, &(*node).span);
}

// Evaluate the array expression once and copy each element into the loop binding.
// The induction variable has its own storage so a mutable binding cannot alter it.
proc ir_lower_for_array(context: *mut IRLowerContext, function: IRFunctionId, start: IRBlockId, node: *HIRNode, fallthrough: *mut IRBlockId) -> bool {
    let pattern = ir_lower_node(context, (*node).payload[0]);
    let iterable = ir_lower_node(context, (*node).payload[1]);
    if pattern == null or iterable == null { return ir_fail((*context).ir, IRError.InvalidInstruction); }
    let hir_iterable_type = ir_lower_type_entry(context, (*iterable).type_);
    let array_type: IRTypeId = ir_lower_type(context, (*iterable).type_);
    let array_record = vitte_ir_get_type((*context).ir, array_type);
    if hir_iterable_type == null or array_record == null or
       ((*hir_iterable_type).kind != HIRTypeKind.Array and (*hir_iterable_type).kind != HIRTypeKind.Slice) or
       ((*array_record).kind != IRTypeKind.Array and (*array_record).kind != IRTypeKind.Slice) {
        return ir_fail((*context).ir, IRError.Unsupported);
    }
    let array_kind = (*array_record).kind;
    let element_type: IRTypeId = (*array_record).element_type;
    let array_length = (*array_record).array_length;
    let mut expression_block = start;
    let iterable_value = ir_lower_expr(context, function, &mut expression_block, (*node).payload[1]);
    let index_type = ir_lower_primitive(context, IRTypeKind.U64);
    let bool_type = ir_lower_primitive(context, IRTypeKind.Bool);
    let zero = vitte_ir_const_integer((*context).ir, index_type, 0);
    let one = vitte_ir_const_integer((*context).ir, index_type, 1);
    let mut element_data = iterable_value;
    let mut upper: IRValueId = 0;
    if array_kind == IRTypeKind.Array {
        set upper = vitte_ir_const_integer((*context).ir, index_type, array_length as u64);
    } else {
        let mut slice_value = iterable_value;
        let length = ir_lower_emit_value(context, IROpcode.SliceLength, expression_block, index_type, &mut slice_value, 1, &(*node).span);
        let mut pointer_description: IRTypeDesc = IRTypeDesc {};
        set pointer_description.kind = IRTypeKind.Pointer; set pointer_description.element_type = element_type;
        let pointer_type = vitte_ir_intern_type((*context).ir, &pointer_description);
        let mut slice_data_operand = iterable_value;
        set element_data = if pointer_type == 0 { 0 as IRValueId } else { ir_lower_emit_value(context, IROpcode.SliceData, expression_block, pointer_type, &mut slice_data_operand, 1, &(*node).span) };
        set upper = length;
    }
    let mut pointer_desc: IRTypeDesc = IRTypeDesc {};
    set pointer_desc.kind = IRTypeKind.Pointer;
    set pointer_desc.element_type = index_type;
    let index_pointer_type = vitte_ir_intern_type((*context).ir, &pointer_desc);
    set pointer_desc.element_type = element_type;
    let element_pointer_type = vitte_ir_intern_type((*context).ir, &pointer_desc);
    if iterable_value == 0 or element_data == 0 or index_type == 0 or bool_type == 0 or zero == 0 or one == 0 or upper == 0 or
       index_pointer_type == 0 or element_pointer_type == 0 { return false; }
    let counter = ir_lower_emit_value(context, IROpcode.Alloca, expression_block, index_pointer_type, null, 0, &(*node).span);
    let mut initial_store: [IRValueId; 2] = [counter, zero];
    if counter == 0 or ir_lower_emit(context, IROpcode.Store, expression_block, 0, &mut initial_store[0], 2, &(*node).span) == 0 { return false; }
    let condition_block = ir_lower_new_block(context, function, "for.array.cond");
    let mut body_block = ir_lower_new_block(context, function, "for.array.body");
    let step_block = ir_lower_new_block(context, function, "for.array.step");
    let exit_block = ir_lower_new_block(context, function, "for.array.exit");
    if condition_block == 0 or body_block == 0 or step_block == 0 or exit_block == 0 or
       vitte_ir_build_br((*context).ir, expression_block, condition_block, ir_lower_span(&(*node).span)) == 0 { return false; }
    let mut counter_operand = counter;
    let current = ir_lower_emit_value(context, IROpcode.Load, condition_block, index_type, &mut counter_operand, 1, &(*node).span);
    let mut comparison: [IRValueId; 2] = [current, upper];
    let condition = ir_lower_emit_value(context, IROpcode.IcmpUlt, condition_block, bool_type, &mut comparison[0], 2, &(*node).span);
    if current == 0 or condition == 0 or
       vitte_ir_build_cond_br((*context).ir, condition_block, condition, body_block, exit_block, ir_lower_span(&(*node).span)) == 0 { return false; }

    let saved_symbol_count = (*context).symbol_count;
    let mut element_operands: [IRValueId; 2] = [element_data, current];
    let element_address = ir_lower_emit_value(context, IROpcode.Gep, body_block, element_pointer_type, &mut element_operands[0], 2, &(*node).span);
    let mut address_operand = element_address;
    let element_value = if element_address == 0 { 0 as IRValueId } else { ir_lower_emit_value(context, IROpcode.Load, body_block, element_type, &mut address_operand, 1, &(*node).span) };
    let pattern_condition = if element_value == 0 { 0 as IRValueId } else { ir_lower_pattern_condition(context, function, &mut body_block, (*node).payload[0], element_value) };
    let mut binding_block = ir_lower_new_block(context, function, "for.array.bind");
    let rejected_pattern = ir_lower_new_block(context, function, "for.array.reject");
    if element_value == 0 or pattern_condition == 0 or binding_block == 0 or rejected_pattern == 0 or
       vitte_ir_build_cond_br((*context).ir, body_block, pattern_condition, binding_block, rejected_pattern, ir_lower_span(&(*node).span)) == 0 or
       vitte_ir_build_unreachable((*context).ir, rejected_pattern, ir_lower_span(&(*node).span)) == 0 or
       not ir_lower_bind_pattern(context, function, &mut binding_block, (*node).payload[0], element_value) { return false; }
    if not ir_lower_push_loop(context, exit_block, step_block) { return false; }
    let mut body_end = binding_block;
    let body_ok = ir_lower_statement(context, function, binding_block, (*node).payload[2], &mut body_end);
    set (*context).loop_count -= 1;
    set (*context).symbol_count = saved_symbol_count;
    if not body_ok { return false; }
    let body_end_record = vitte_ir_get_block((*context).ir, body_end);
    if body_end_record != null and not (*body_end_record).terminated and
       vitte_ir_build_br((*context).ir, body_end, step_block, ir_lower_span(&(*node).span)) == 0 { return false; }
    let mut step_counter = counter;
    let step_value = ir_lower_emit_value(context, IROpcode.Load, step_block, index_type, &mut step_counter, 1, &(*node).span);
    let mut increment_operands: [IRValueId; 2] = [step_value, one];
    let increment = ir_lower_emit_value(context, IROpcode.Add, step_block, index_type, &mut increment_operands[0], 2, &(*node).span);
    let mut increment_store: [IRValueId; 2] = [counter, increment];
    if step_value == 0 or increment == 0 or
       ir_lower_emit(context, IROpcode.Store, step_block, 0, &mut increment_store[0], 2, &(*node).span) == 0 or
       vitte_ir_build_br((*context).ir, step_block, condition_block, ir_lower_span(&(*node).span)) == 0 { return false; }
    set *fallthrough = exit_block;
    return true;
}

proc ir_lower_for_range(context: *mut IRLowerContext, function: IRFunctionId, start: IRBlockId, node: *HIRNode, fallthrough: *mut IRBlockId) -> bool {
    if context == null { return false; }
    if node == null or (*node).kind != HIRNodeKind.For or fallthrough == null { return ir_fail((*context).ir, IRError.InvalidInstruction); }
    let pattern = ir_lower_node(context, (*node).payload[0]);
    let range = ir_lower_node(context, (*node).payload[1]);
    if pattern == null or range == null { return ir_fail((*context).ir, IRError.InvalidInstruction); }
    if (*range).kind != HIRNodeKind.Range {
        return ir_lower_for_array(context, function, start, node, fallthrough);
    }
    let range_type = ir_lower_type(context, (*range).type_);
    let range_type_record = vitte_ir_get_type((*context).ir, range_type);
    if range_type == 0 or range_type_record == null or
       ((*range_type_record).kind < IRTypeKind.I8 or (*range_type_record).kind > IRTypeKind.U64) {
        return ir_fail((*context).ir, IRError.InvalidType);
    }
    let mut expression_block = start;
    let lower = ir_lower_expr_as(context, function, &mut expression_block, (*range).payload[0], range_type);
    let upper = ir_lower_expr_as(context, function, &mut expression_block, (*range).payload[1], range_type);
    if lower == 0 or upper == 0 { return false; }
    let mut counter_pointer_desc: IRTypeDesc = IRTypeDesc {};
    set counter_pointer_desc.kind = IRTypeKind.Pointer;
    set counter_pointer_desc.element_type = range_type;
    let counter_pointer_type = vitte_ir_intern_type((*context).ir, &counter_pointer_desc);
    if counter_pointer_type == 0 { return false; }
    let counter_address = ir_lower_emit_value(context, IROpcode.Alloca, expression_block, counter_pointer_type, null, 0, &(*node).span);
    let mut counter_store: [IRValueId; 2] = [counter_address, lower];
    if counter_address == 0 or ir_lower_emit(context, IROpcode.Store, expression_block, 0, &mut counter_store[0], 2, &(*node).span) == 0 {
        return false;
    }
    let condition_block = ir_lower_new_block(context, function, "for.range.cond");
    let mut body_block = ir_lower_new_block(context, function, "for.range.body");
    let step_block = ir_lower_new_block(context, function, "for.range.step");
    let increment_block = ir_lower_new_block(context, function, "for.range.increment");
    let exit_block = ir_lower_new_block(context, function, "for.range.exit");
    if condition_block == 0 or body_block == 0 or step_block == 0 or increment_block == 0 or exit_block == 0 or
       vitte_ir_build_br((*context).ir, expression_block, condition_block, ir_lower_span(&(*node).span)) == 0 {
        return false;
    }
    let mut condition_pointer = counter_address;
    let current = ir_lower_emit_value(context, IROpcode.Load, condition_block, range_type, &mut condition_pointer, 1, &(*node).span);
    let compare_opcode = ir_lower_range_compare(range_type, (*range).payload[2] != 0, context);
    let bool_type = ir_lower_primitive(context, IRTypeKind.Bool);
    let mut compare_operands: [IRValueId; 2] = [current, upper];
    let condition = if current == 0 or compare_opcode == IROpcode.Invalid or bool_type == 0 { 0 as IRValueId } else {
        ir_lower_emit_value(context, compare_opcode, condition_block, bool_type, &mut compare_operands[0], 2, &(*node).span)
    };
    if condition == 0 or vitte_ir_build_cond_br((*context).ir, condition_block, condition, body_block, exit_block, ir_lower_span(&(*node).span)) == 0 {
        return false;
    }

    let saved_symbol_count = (*context).symbol_count;
    let mut body_entry = body_block;
    let mut binding_counter_address = counter_address;
    let binding_value = ir_lower_emit_value(context, IROpcode.Load, body_entry, range_type, &mut binding_counter_address, 1, &(*node).span);
    let pattern_condition = if binding_value == 0 { 0 as IRValueId } else { ir_lower_pattern_condition(context, function, &mut body_entry, (*node).payload[0], binding_value) };
    let mut bind_success = ir_lower_new_block(context, function, "for.range.bind");
    let bind_failure = ir_lower_new_block(context, function, "for.range.reject");
    if binding_value == 0 or pattern_condition == 0 or bind_success == 0 or bind_failure == 0 or
       vitte_ir_build_cond_br((*context).ir, body_entry, pattern_condition, bind_success, bind_failure, ir_lower_span(&(*node).span)) == 0 or
       vitte_ir_build_unreachable((*context).ir, bind_failure, ir_lower_span(&(*node).span)) == 0 or
       not ir_lower_bind_pattern(context, function, &mut bind_success, (*node).payload[0], binding_value) {
        return ir_fail((*context).ir, IRError.TypeMismatch);
    }
    if not ir_lower_push_loop(context, exit_block, step_block) { return false; }
    let mut body_end = bind_success;
    let body_ok = ir_lower_statement(context, function, bind_success, (*node).payload[2], &mut body_end);
    set (*context).loop_count -= 1;
    set (*context).symbol_count = saved_symbol_count;
    if not body_ok { return false; }
    let body_end_record = vitte_ir_get_block((*context).ir, body_end);
    if body_end_record != null and not (*body_end_record).terminated and
       vitte_ir_build_br((*context).ir, body_end, step_block, ir_lower_span(&(*node).span)) == 0 {
        return false;
    }

    let mut step_pointer = counter_address;
    let step_value = ir_lower_emit_value(context, IROpcode.Load, step_block, range_type, &mut step_pointer, 1, &(*node).span);
    if (*range).payload[2] != 0 {
        let mut end_compare_operands: [IRValueId; 2] = [step_value, upper];
        let at_end = if step_value == 0 { 0 as IRValueId } else {
            ir_lower_emit_value(context, IROpcode.IcmpEq, step_block, bool_type, &mut end_compare_operands[0], 2, &(*node).span)
        };
        if at_end == 0 or vitte_ir_build_cond_br((*context).ir, step_block, at_end, exit_block, increment_block, ir_lower_span(&(*node).span)) == 0 {
            return false;
        }
    } elif vitte_ir_build_br((*context).ir, step_block, increment_block, ir_lower_span(&(*node).span)) == 0 {
        return false;
    }
    let one = vitte_ir_const_integer((*context).ir, range_type, 1);
    let mut increment_operands: [IRValueId; 2] = [step_value, one];
    let increment = if step_value == 0 or one == 0 { 0 as IRValueId } else {
        ir_lower_emit_value(context, IROpcode.Add, increment_block, range_type, &mut increment_operands[0], 2, &(*node).span)
    };
    let mut increment_store: [IRValueId; 2] = [counter_address, increment];
    if increment == 0 or ir_lower_emit(context, IROpcode.Store, increment_block, 0, &mut increment_store[0], 2, &(*node).span) == 0 or
       vitte_ir_build_br((*context).ir, increment_block, condition_block, ir_lower_span(&(*node).span)) == 0 {
        return false;
    }
    set *fallthrough = exit_block;
    return true;
}

proc ir_lower_statement(context: *mut IRLowerContext, function: IRFunctionId, block: IRBlockId, node_id: HIRNodeId, fallthrough: *mut IRBlockId) -> bool {
    let node = ir_lower_node(context, node_id);
    if node == null or fallthrough == null { return ir_fail((*context).ir, IRError.InvalidInstruction); }
    set *fallthrough = block;
    match (*node).kind {
        case HIRNodeKind::Block => return ir_lower_block(context, function, block, node, fallthrough);
        case HIRNodeKind::Let => {
            let symbol_id = (*node).payload[0] as HIRSymbolId;
            let symbol = ir_lower_symbol(context, symbol_id);
            let initializer_id = (*node).payload[2] as HIRNodeId;
            let type_hir = if (*node).payload[1] != 0 { (*node).payload[1] as HIRTypeId } elif symbol != null { (*symbol).type_ } else { 0 as HIRTypeId };
            if type_hir == 0 and initializer_id == 0 { return ir_fail((*context).ir, IRError.InvalidType); }
            let inferred: *HIRNode = if type_hir == 0 { ir_lower_node(context, initializer_id) } else { null };
            let value_hir_type = if type_hir != 0 { type_hir } elif inferred != null { (*inferred).type_ } else { 0 as HIRTypeId };
            let value_type = ir_lower_type(context, value_hir_type); if value_type == 0 { return ir_fail((*context).ir, IRError.InvalidType); }
            let lowered_type = vitte_ir_get_type((*context).ir, value_type);
            if lowered_type == null { return ir_fail((*context).ir, IRError.InvalidType); }
            if (*lowered_type).kind == IRTypeKind.Void {
                let mut expression_block = block;
                let initial = if initializer_id == 0 { vitte_ir_undef((*context).ir, value_type) } else { ir_lower_expr_as(context, function, &mut expression_block, initializer_id, value_type) };
                if initial == 0 or symbol_id == 0 or not ir_lower_bind_value(context, symbol_id, initial, false) { return false; }
                set *fallthrough = expression_block;
                return true;
            }
            let mut pointer_desc: IRTypeDesc = IRTypeDesc {}; set pointer_desc.kind = IRTypeKind.Pointer; set pointer_desc.element_type = value_type;
            let pointer_type = vitte_ir_intern_type((*context).ir, &pointer_desc); if pointer_type == 0 { return false; }
            let mut expression_block = block;
            let address = ir_lower_emit_value(context, IROpcode.Alloca, expression_block, pointer_type, null, 0, &(*node).span); if address == 0 { return false; }
            if symbol_id == 0 or not ir_lower_bind_value(context, symbol_id, address, true) { return false; }
            let initial = if initializer_id == 0 { vitte_ir_undef((*context).ir, value_type) } else { ir_lower_expr_as(context, function, &mut expression_block, initializer_id, value_type) };
            if initial == 0 { return false; }
            let mut operands: [IRValueId; 2] = [address, initial];
            if ir_lower_emit(context, IROpcode.Store, expression_block, 0, &mut operands[0], 2, &(*node).span) == 0 { return false; }
            set *fallthrough = expression_block;
            return true;
        }
        case HIRNodeKind::LetPattern => {
            let pattern_id = (*node).payload[0] as HIRNodeId;
            let initializer_id = (*node).payload[2] as HIRNodeId;
            let type_hir = (*node).payload[1] as HIRTypeId;
            let type_id = ir_lower_type(context, type_hir);
            if pattern_id == 0 or type_id == 0 { return ir_fail((*context).ir, IRError.InvalidType); }
            let mut expression_block = block;
            let value = if initializer_id == 0 { vitte_ir_undef((*context).ir, type_id) } else { ir_lower_expr_as(context, function, &mut expression_block, initializer_id, type_id) };
            let condition = if value == 0 { 0 as IRValueId } else { ir_lower_pattern_condition(context, function, &mut expression_block, pattern_id, value) };
            let bind_block = ir_lower_new_block(context, function, "let.pattern.bind");
            let reject_block = ir_lower_new_block(context, function, "let.pattern.reject");
            if value == 0 or condition == 0 or bind_block == 0 or reject_block == 0 or
               vitte_ir_build_cond_br((*context).ir, expression_block, condition, bind_block, reject_block, ir_lower_span(&(*node).span)) == 0 or
               vitte_ir_build_unreachable((*context).ir, reject_block, ir_lower_span(&(*node).span)) == 0 { return false; }
            let mut binding_end = bind_block;
            if not ir_lower_bind_pattern(context, function, &mut binding_end, pattern_id, value) { return false; }
            set *fallthrough = binding_end;
            return true;
        }
        case HIRNodeKind::Assign => {
            let mut expression_block = block;
            let address = ir_lower_lvalue(context, function, &mut expression_block, (*node).payload[0]);
            let target = ir_lower_node(context, (*node).payload[0]);
            let target_type: IRTypeId = if target == null { 0 as IRTypeId } else { ir_lower_type(context, (*target).type_) };
            if address == 0 or target_type == 0 { return ir_fail((*context).ir, IRError.InvalidValue); }
            let value = ir_lower_expr_as(context, function, &mut expression_block, (*node).payload[1], target_type); if value == 0 { return false; }
            let mut operands: [IRValueId; 2] = [address, value];
            let stored = ir_lower_emit(context, IROpcode.Store, expression_block, 0, &mut operands[0], 2, &(*node).span) != 0;
            if stored { set *fallthrough = expression_block; }
            return stored;
        }
        case HIRNodeKind::ExprStmt => {
            let mut expression_block = block;
            if ir_lower_expr(context, function, &mut expression_block, (*node).payload[0]) == 0 { return false; }
            set *fallthrough = expression_block;
            return true;
        }
        case HIRNodeKind::Return => {
            if (*context).in_defer { return ir_fail((*context).ir, IRError.Unsupported); }
            let return_type = ir_lower_return_type(context, function);
            if return_type == 0 { return ir_fail((*context).ir, IRError.InvalidFunction); }
            let mut expression_block = block;
            let value = if (*node).payload[0] == 0 { 0 as IRValueId } else { ir_lower_expr_as(context, function, &mut expression_block, (*node).payload[0], return_type) };
            if (*node).payload[0] != 0 and value == 0 { return false; }
            if not ir_lower_run_defers(context, function, &mut expression_block, 0) { return false; }
            let returned: bool = vitte_ir_build_return((*context).ir, expression_block, value, ir_lower_span(&(*node).span)) != 0;
            if returned { set *fallthrough = expression_block; }
            return returned;
        }
        case HIRNodeKind::Defer => {
            if (*node).payload[0] == 0 or not ir_lower_push_defer(context, (*node).id) { return false; }
            return true;
        }
        case HIRNodeKind::Assert => {
            let mut condition_block = block;
            let condition = ir_lower_expr(context, function, &mut condition_block, (*node).payload[0]);
            let success = ir_lower_new_block(context, function, "assert.ok");
            let failure = ir_lower_new_block(context, function, "assert.fail");
            if condition == 0 or success == 0 or failure == 0 or
               vitte_ir_build_cond_br((*context).ir, condition_block, condition, success, failure, ir_lower_span(&(*node).span)) == 0 or
               vitte_ir_build_unreachable((*context).ir, failure, ir_lower_span(&(*node).span)) == 0 { return false; }
            set *fallthrough = success;
            return true;
        }
        case HIRNodeKind::If => return ir_lower_if(context, function, block, node, fallthrough);
        case HIRNodeKind::For => return ir_lower_for_range(context, function, block, node, fallthrough);
        case HIRNodeKind::Match => return ir_lower_match(context, function, block, node, fallthrough);
        case HIRNodeKind::While => {
            let condition_block = ir_lower_new_block(context, function, "while.cond");
            let body_block = ir_lower_new_block(context, function, "while.body");
            let exit_block = ir_lower_new_block(context, function, "while.exit");
            if condition_block == 0 or body_block == 0 or exit_block == 0 or vitte_ir_build_br((*context).ir, block, condition_block, ir_lower_span(&(*node).span)) == 0 { return false; }
            let mut condition_end = condition_block;
            let condition = ir_lower_expr(context, function, &mut condition_end, (*node).payload[0]);
            if condition == 0 or vitte_ir_build_cond_br((*context).ir, condition_end, condition, body_block, exit_block, ir_lower_span(&(*node).span)) == 0 or not ir_lower_push_loop(context, exit_block, condition_block) { return false; }
            let mut body_end = body_block;
            let body_ok = ir_lower_statement(context, function, body_block, (*node).payload[1], &mut body_end);
            set (*context).loop_count -= 1;
            if not body_ok { return false; }
            let body_end_value = vitte_ir_get_block((*context).ir, body_end);
            if body_end_value != null and not (*body_end_value).terminated and vitte_ir_build_br((*context).ir, body_end, condition_block, ir_lower_span(&(*node).span)) == 0 { return false; }
            set *fallthrough = exit_block; return true;
        }
        case HIRNodeKind::Loop => {
            let body_block = ir_lower_new_block(context, function, "loop.body");
            let exit_block = ir_lower_new_block(context, function, "loop.exit");
            if body_block == 0 or exit_block == 0 or vitte_ir_build_br((*context).ir, block, body_block, ir_lower_span(&(*node).span)) == 0 or not ir_lower_push_loop(context, exit_block, body_block) { return false; }
            let mut body_end = body_block;
            let body_ok = ir_lower_statement(context, function, body_block, (*node).payload[0], &mut body_end);
            set (*context).loop_count -= 1;
            if not body_ok { return false; }
            let body_end_value = vitte_ir_get_block((*context).ir, body_end);
            if body_end_value != null and not (*body_end_value).terminated and vitte_ir_build_br((*context).ir, body_end, body_block, ir_lower_span(&(*node).span)) == 0 { return false; }
            set *fallthrough = exit_block; return true;
        }
        case HIRNodeKind::Break | HIRNodeKind::Continue => {
            if (*context).in_defer { return ir_fail((*context).ir, IRError.Unsupported); }
            if (*context).loop_count == 0 { return ir_fail((*context).ir, IRError.InvalidCfg); }
            let active_loop = (*context).loops[(*context).loop_count - 1];
            let target = if (*node).kind == HIRNodeKind.Break { active_loop.break_target } else { active_loop.continue_target };
            if (*node).kind == HIRNodeKind.Break and (*node).payload[0] != 0 { return ir_fail((*context).ir, IRError.Unsupported); }
            let mut branch_block = block;
            if not ir_lower_run_defers(context, function, &mut branch_block, active_loop.defer_depth) { return false; }
            return vitte_ir_build_br((*context).ir, branch_block, target, ir_lower_span(&(*node).span)) != 0;
        }
        case HIRNodeKind::Unsafe => return ir_lower_statement(context, function, block, (*node).payload[0], fallthrough);
        case HIRNodeKind::Literal | HIRNodeKind::Symbol | HIRNodeKind::Unary | HIRNodeKind::Binary |
             HIRNodeKind::Call | HIRNodeKind::Member | HIRNodeKind::Index | HIRNodeKind::Cast |
             HIRNodeKind::Tuple | HIRNodeKind::Array | HIRNodeKind::FormInit | HIRNodeKind::Ref |
             HIRNodeKind::Deref | HIRNodeKind::Move | HIRNodeKind::Await | HIRNodeKind::Sizeof |
             HIRNodeKind::Alignof | HIRNodeKind::Typeof | HIRNodeKind::Offsetof => {
            let mut expression_block = block;
            if ir_lower_expr(context, function, &mut expression_block, node_id) == 0 { return false; }
            set *fallthrough = expression_block;
            return true;
        }
        case _ => return ir_fail((*context).ir, IRError.Unsupported);
    }
}

proc ir_lower_constant_as(context: *mut IRLowerContext, node_id: HIRNodeId, expected_type: IRTypeId) -> IRValueId {
    let node = ir_lower_node(context, node_id);
    if node == null { return 0; }
    if (*node).kind == HIRNodeKind.Symbol {
        let mapped = ir_lower_find_value(context, (*node).payload[0]);
        if mapped != null and not (*mapped).is_address {
            let value = vitte_ir_get_value((*context).ir, (*mapped).value);
            if value != null and (expected_type == 0 or (*value).type_ == expected_type) { return (*mapped).value; }
        }
        return 0;
    }
    if (*node).kind != HIRNodeKind.Literal { return 0; }
    let mut type_id = expected_type;
    if type_id == 0 { set type_id = ir_lower_type(context, (*node).type_); }
    if type_id == 0 { set type_id = ir_lower_default_type(context); }
    if type_id == 0 { return 0; }
    match (*node).payload[0] as HIRLiteralKind {
        case HIRLiteralKind::Bool => return vitte_ir_const_bool((*context).ir, type_id, (*node).payload[1] != 0);
        case HIRLiteralKind::SignedInteger | HIRLiteralKind::UnsignedInteger | HIRLiteralKind::Char => return vitte_ir_const_integer((*context).ir, type_id, (*node).payload[1]);
        case HIRLiteralKind::F32 | HIRLiteralKind::F64 => return vitte_ir_const_float((*context).ir, type_id, ir_lower_float_literal(node));
        case HIRLiteralKind::String => {
            let text: *HIRString = ir_lower_string(context, (*node).payload[1]); if text == null { return 0; }
            let text_data: string = (*text).data;
            let string_id = vitte_ir_intern_string((*context).ir, text_data.as_bytes().as_ptr() as *const u8, (*text).length); if string_id == 0 { return 0; }
            return vitte_ir_const_string((*context).ir, type_id, string_id);
        }
        case HIRLiteralKind::Null => return vitte_ir_null((*context).ir, type_id);
        case _ => return 0;
    }
}

proc ir_lower_constant(context: *mut IRLowerContext, node_id: HIRNodeId) -> IRValueId {
    return ir_lower_constant_as(context, node_id, 0);
}

proc ir_lower_cleanup(context: *mut IRLowerContext) {
    if context == null { return; }
    deallocate((*context).types as *mut u8); deallocate((*context).symbols as *mut u8);
    deallocate((*context).functions as *mut u8); deallocate((*context).loops as *mut u8); deallocate((*context).defers as *mut u8);
    set (*context).types = null; set (*context).symbols = null; set (*context).functions = null; set (*context).loops = null; set (*context).defers = null;
}

export proc vitte_ir_lower_hir(ir: *mut IRContext, hir: *const HIR) -> bool {
    if ir == null or hir == null or not vitte_ir_is_valid(ir) or (*ir).state != IRState.Building or
       not vitte_hir_is_valid(hir as *HIR) or (*hir).state != HIRState.Validated or (*hir).roots.count == 0 or (*hir).roots.items == null {
        return ir_fail(ir, IRError.InvalidArgument);
    }
    let module = vitte_hir_get_node(hir as *HIR, (*hir).roots.items[0]);
    if module == null or (*module).kind != HIRNodeKind.Module { return ir_fail(ir, IRError.InvalidArgument); }
    let module_items = ir_lower_node_list(module, 1);
    let module_item_count = ir_lower_list_count(module, 1);
    let mut item_index: usize = 0;
    while item_index < module_item_count {
        let item = vitte_hir_get_node(hir as *HIR, module_items[item_index]);
        if item == null { return ir_fail(ir, IRError.InvalidInstruction); }
        let kind = (*item).kind;
        if kind != HIRNodeKind.Use and kind != HIRNodeKind.ConstDecl and kind != HIRNodeKind.StaticDecl and
           kind != HIRNodeKind.TypeDecl and kind != HIRNodeKind.FormDecl and kind != HIRNodeKind.PickDecl and
           kind != HIRNodeKind.MacroDecl and kind != HIRNodeKind.ProcDecl and kind != HIRNodeKind.ExternProcDecl {
            return ir_fail(ir, IRError.Unsupported);
        }
        set item_index += 1;
    }
    let mut context: IRLowerContext = IRLowerContext {}; set context.ir = ir; set context.hir = hir; set context.type_count = (*hir).type_count;
    if context.type_count != 0 {
        let mut bytes: usize = 0;
        if not ir_size_mul(context.type_count, sizeof(IRTypeId), &mut bytes) { return ir_fail(ir, IRError.Overflow); }
        set context.types = allocate(bytes) as *mut IRTypeId;
        if context.types == null { return ir_fail(ir, IRError.OutOfMemory); }
        fill(context.types as *mut u8, 0, bytes); ir_add_stat(&mut (*ir).stats.allocations, 1);
    }
    let items = ir_lower_node_list(module, 1); let item_count = ir_lower_list_count(module, 1);
    let mut index: usize = 0; let mut procedure_count: usize = 0;
    while index < item_count {
        let item = ir_lower_node(&mut context, items[index]);
        if item != null and ((*item).kind == HIRNodeKind.ProcDecl or (*item).kind == HIRNodeKind.ExternProcDecl) { set procedure_count += 1; }
        set index += 1;
    }
    if procedure_count != 0 {
        let mut bytes: usize = 0;
        if not ir_size_mul(procedure_count, sizeof(IRLowerFunction), &mut bytes) { ir_lower_cleanup(&mut context); return ir_fail(ir, IRError.Overflow); }
        set context.functions = allocate(bytes) as *mut IRLowerFunction;
        if context.functions == null { ir_lower_cleanup(&mut context); return ir_fail(ir, IRError.OutOfMemory); }
        fill(context.functions as *mut u8, 0, bytes); set context.function_capacity = procedure_count;
        ir_add_stat(&mut (*ir).stats.allocations, 1);
    }
    // Bind all constants first so statics can refer to declarations that appear later.
    index = 0;
    while index < item_count {
        let item = ir_lower_node(&mut context, items[index]);
        if item != null and (*item).kind == HIRNodeKind.ConstDecl {
            let symbol = ir_lower_symbol(&mut context, (*item).payload[0]);
            let type_hir: HIRTypeId = if (*item).payload[3] != 0 { (*item).payload[3] as HIRTypeId } elif symbol != null { (*symbol).type_ } else { 0 as HIRTypeId };
            let type_id = ir_lower_type(&mut context, type_hir);
            let value = ir_lower_constant_as(&mut context, (*item).payload[1], type_id);
            if value == 0 or type_id == 0 or not ir_lower_bind_value(&mut context, (*item).payload[0], value, false) {
                ir_lower_cleanup(&mut context); if (*ir).last_error == IRError.None { ir_fail(ir, IRError.Unsupported); }
                set (*ir).state = IRState.Failed; return false;
            }
        }
        set index += 1;
    }
    index = 0;
    while index < item_count {
        let item = ir_lower_node(&mut context, items[index]);
        if item != null and (*item).kind == HIRNodeKind.StaticDecl {
            let symbol = ir_lower_symbol(&mut context, (*item).payload[0]);
            let type_hir: HIRTypeId = if (*item).payload[3] != 0 { (*item).payload[3] as HIRTypeId } elif symbol != null { (*symbol).type_ } else { 0 as HIRTypeId };
            let type_id = ir_lower_type(&mut context, type_hir);
            let initial = ir_lower_constant_as(&mut context, (*item).payload[1], type_id);
            let hir_symbol = ir_lower_symbol(&mut context, (*item).payload[0]);
            let symbol_name = if hir_symbol == null { 0 as IRStringId } else { ir_lower_intern_hir_string(&mut context, (*hir_symbol).name) };
            let mut global_description: IRGlobalDesc = IRGlobalDesc {};
            set global_description.name = symbol_name;
            set global_description.type_ = type_id;
            set global_description.initializer = initial;
            set global_description.mutable = (((*item).payload[2] >> 32) as HIRMutability) == HIRMutability.Mutable;
            set global_description.span = ir_lower_span(&(*item).span);
            let global_id = if initial == 0 or type_id == 0 or symbol_name == 0 { 0 as u64 } else { vitte_ir_add_global(ir, &mut global_description) };
            let mut pointer_description: IRTypeDesc = IRTypeDesc {};
            set pointer_description.kind = IRTypeKind.Pointer;
            set pointer_description.element_type = type_id;
            let pointer_type = if global_id == 0 { 0 as IRTypeId } else { vitte_ir_intern_type(ir, &pointer_description) };
            let mut address_description: IRValueDesc = IRValueDesc {};
            set address_description.kind = IRValueKind.Global;
            set address_description.type_ = pointer_type;
            set address_description.global = global_id;
            let address = if pointer_type == 0 { 0 as IRValueId } else { vitte_ir_add_value(ir, &mut address_description) };
            if address == 0 or not ir_lower_bind_value(&mut context, (*item).payload[0], address, true) {
                ir_lower_cleanup(&mut context); if (*ir).last_error == IRError.None { ir_fail(ir, IRError.Unsupported); }
                set (*ir).state = IRState.Failed; return false;
            }
        }
        set index += 1;
    }
    // Predeclare all procedures so calls can target later or recursive bodies.
    index = 0;
    while index < item_count {
        let item = ir_lower_node(&mut context, items[index]);
        if item == null or ((*item).kind != HIRNodeKind.ProcDecl and (*item).kind != HIRNodeKind.ExternProcDecl) { set index += 1; continue; }
        let symbol = ir_lower_symbol(&mut context, (*item).payload[0]);
        if symbol == null { ir_lower_cleanup(&mut context); return ir_fail(ir, IRError.InvalidFunction); }
        let parameter_count = ir_lower_list_count(item, 1); let mut parameter_types: *mut IRTypeId = null;
        if parameter_count != 0 {
            let mut bytes: usize = 0;
            if not ir_size_mul(parameter_count, sizeof(IRTypeId), &mut bytes) { ir_lower_cleanup(&mut context); return ir_fail(ir, IRError.Overflow); }
            set parameter_types = allocate(bytes) as *mut IRTypeId;
            if parameter_types == null { ir_lower_cleanup(&mut context); return ir_fail(ir, IRError.OutOfMemory); }
        }
        let params = ir_lower_node_list(item, 1); let mut parameter_index: usize = 0; let mut valid = true;
        while parameter_index < parameter_count {
            let parameter = ir_lower_node(&mut context, params[parameter_index]);
            let param_symbol: *HIRSymbol = if parameter == null { null } else { ir_lower_symbol(&mut context, (*parameter).payload[0]) };
            if param_symbol == null { set valid = false; break; }
            set parameter_types[parameter_index] = ir_lower_type(&mut context, (*param_symbol).type_);
            if parameter_types[parameter_index] == 0 { set valid = false; break; }
            set parameter_index += 1;
        }
        let return_type = ir_lower_type(&mut context, (*item).payload[4]);
        if not valid or return_type == 0 { deallocate(parameter_types as *mut u8); ir_lower_cleanup(&mut context); return ir_fail(ir, IRError.InvalidType); }
        let mut type_desc: IRTypeDesc = IRTypeDesc {}; set type_desc.kind = IRTypeKind.Function; set type_desc.parameter_types = parameter_types;
        set type_desc.parameter_count = parameter_count; set type_desc.return_type = return_type; set type_desc.is_variadic = ((*item).payload[7] & 65536) != 0;
        let function_type = vitte_ir_intern_type(ir, &type_desc); deallocate(parameter_types as *mut u8);
        if function_type == 0 { ir_lower_cleanup(&mut context); return false; }
        let mut function_desc: IRFunctionDesc = IRFunctionDesc {};
        set function_desc.name = ir_lower_intern_hir_string(&mut context, (*symbol).name);
        set function_desc.type_ = function_type;
        set function_desc.linkage = if (*item).kind == HIRNodeKind.ExternProcDecl { IRLinkage.External } else { IRLinkage.Internal };
        set function_desc.calling_convention = if (*item).kind == HIRNodeKind.ExternProcDecl { IRCallingConvention.C } else { IRCallingConvention.Default };
        set function_desc.is_declaration = (*item).kind == HIRNodeKind.ExternProcDecl or (*item).payload[5] == 0;
        set function_desc.is_variadic = type_desc.is_variadic; set function_desc.span = ir_lower_span(&(*item).span);
        let function_id = vitte_ir_add_function(ir, &function_desc);
        if function_id == 0 { ir_lower_cleanup(&mut context); return false; }
        let mut value_desc: IRValueDesc = IRValueDesc {}; set value_desc.kind = IRValueKind.Function; set value_desc.type_ = function_type; set value_desc.function = function_id;
        let function_value = vitte_ir_add_value(ir, &value_desc);
        if function_value == 0 { ir_lower_cleanup(&mut context); return false; }
        set context.functions[context.function_count] = IRLowerFunction { symbol: (*item).payload[0], node: (*item).id, function: function_id, function_value: function_value, return_type: return_type };
        set context.function_count += 1; set index += 1;
    }
    index = 0;
    while index < context.function_count {
        if not ir_lower_bind_value(&mut context, context.functions[index].symbol, context.functions[index].function_value, false) {
            ir_lower_cleanup(&mut context); set (*ir).state = IRState.Failed; return false;
        }
        set index += 1;
    }
    // Add parameters, then lower each body into its entry block.
    index = 0;
    while index < context.function_count {
        let lowered = &context.functions[index]; let procedure = ir_lower_node(&mut context, (*lowered).node);
        let function: *mut IRFunction = vitte_ir_get_function_mut(ir, (*lowered).function);
        if procedure == null or function == null { ir_lower_cleanup(&mut context); return ir_fail(ir, IRError.InvalidFunction); }
        let params = ir_lower_node_list(procedure, 1); let parameter_count = ir_lower_list_count(procedure, 1);
        let mut entry_block: IRBlockId = 0;
        if not (*function).is_declaration {
            let name = vitte_ir_intern_string(ir, "entry".as_ptr() as *const u8, 5);
            entry_block = vitte_ir_add_block(ir, (*lowered).function, name, ir_lower_span(&(*procedure).span));
            if entry_block == 0 { ir_lower_cleanup(&mut context); return false; }
        }
        let mut parameter_index: usize = 0;
        while parameter_index < parameter_count {
            let parameter = ir_lower_node(&mut context, params[parameter_index]);
            let symbol: *HIRSymbol = if parameter == null { null } else { ir_lower_symbol(&mut context, (*parameter).payload[0]) };
            if symbol == null { ir_lower_cleanup(&mut context); return ir_fail(ir, IRError.InvalidValue); }
            let parameter_type: IRTypeId = ir_lower_type(&mut context, (*symbol).type_);
            let parameter_name = ir_lower_intern_hir_string(&mut context, (*symbol).name);
            let parameter_value = vitte_ir_add_parameter(ir, (*lowered).function, parameter_type, parameter_name, ir_lower_span(&(*parameter).span));
            if parameter_value == 0 { ir_lower_cleanup(&mut context); return false; }
            if (*function).is_declaration {
                if not ir_lower_bind_value(&mut context, (*symbol).id, parameter_value, false) { ir_lower_cleanup(&mut context); return false; }
            } else {
                let mut pointer_desc: IRTypeDesc = IRTypeDesc {}; set pointer_desc.kind = IRTypeKind.Pointer; set pointer_desc.element_type = parameter_type;
                let pointer_type = vitte_ir_intern_type(ir, &pointer_desc);
                let address = ir_lower_emit_value(&mut context, IROpcode.Alloca, entry_block, pointer_type, null, 0, &(*parameter).span);
                if address == 0 { ir_lower_cleanup(&mut context); return false; }
                let mut operands: [IRValueId; 2] = [address, parameter_value];
                if ir_lower_emit(&mut context, IROpcode.Store, entry_block, 0, &mut operands[0], 2, &(*parameter).span) == 0 or
                   not ir_lower_bind_value(&mut context, (*symbol).id, address, true) { ir_lower_cleanup(&mut context); return false; }
            }
            set parameter_index += 1;
        }
        if not (*function).is_declaration {
            let mut fallthrough = entry_block;
            if not ir_lower_statement(&mut context, (*lowered).function, entry_block, (*procedure).payload[5], &mut fallthrough) {
                ir_lower_cleanup(&mut context); if (*ir).last_error == IRError.None { ir_fail(ir, IRError.Unsupported); }
                set (*ir).state = IRState.Failed; return false;
            }
            let end = vitte_ir_get_block(ir, fallthrough);
            if end != null and not (*end).terminated {
                let return_type = vitte_ir_get_type(ir, (*lowered).return_type);
                let value = if return_type == null or (*return_type).kind == IRTypeKind.Void { 0 as IRValueId } else { vitte_ir_undef(ir, (*lowered).return_type) };
                if value == 0 and return_type != null and (*return_type).kind != IRTypeKind.Void { ir_lower_cleanup(&mut context); return false; }
                if vitte_ir_build_return(ir, fallthrough, value, IRSpan {}) == 0 { ir_lower_cleanup(&mut context); return false; }
            }
        }
        set index += 1;
    }
    ir_lower_cleanup(&mut context);
    return vitte_ir_seal(ir);
}

export proc vitte_ir_translation_unit_anchor() {}
