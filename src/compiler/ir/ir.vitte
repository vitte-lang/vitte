    }
    if (*value).opcode == IROpcode.Sdiv or (*value).opcode == IROpcode.Srem or
       (*value).opcode == IROpcode.IcmpSlt or (*value).opcode == IROpcode.IcmpSle or (*value).opcode == IROpcode.IcmpSgt or (*value).opcode == IROpcode.IcmpSge {
        let left = vitte_ir_get_value(context, (*value).operands[0]);
        let left_type: *IRType = if left == null { null } else { vitte_ir_get_type(context, (*left).type_) };
        if left_type == null or not ir_is_signed_integer((*left_type).kind) { return ir_fail(context, IRError.TypeMismatch); }
    }
    if (*value).opcode == IROpcode.Udiv or (*value).opcode == IROpcode.Urem or
       (*value).opcode == IROpcode.IcmpUlt or (*value).opcode == IROpcode.IcmpUle or (*value).opcode == IROpcode.IcmpUgt or (*value).opcode == IROpcode.IcmpUge {
        let left = vitte_ir_get_value(context, (*value).operands[0]);
        let left_type: *IRType = if left == null { null } else { vitte_ir_get_type(context, (*left).type_) };
        if left_type == null or not ir_is_unsigned_ordered_integer((*left_type).kind) { return ir_fail(context, IRError.TypeMismatch); }
    }
    if (*value).opcode == IROpcode.Fadd or (*value).opcode == IROpcode.Fsub or (*value).opcode == IROpcode.Fmul or
       (*value).opcode == IROpcode.Fdiv or (*value).opcode == IROpcode.Frem {
        let left = vitte_ir_get_value(context, (*value).operands[0]); let right = vitte_ir_get_value(context, (*value).operands[1]);
        let kind = vitte_ir_get_type(context, (*value).result_type);
        if left == null or right == null or kind == null or not ir_is_float((*kind).kind) or
           (*left).type_ != (*value).result_type or (*right).type_ != (*value).result_type { return ir_fail(context, IRError.TypeMismatch); }
    }
    if (*value).opcode == IROpcode.Neg or (*value).opcode == IROpcode.Not or (*value).opcode == IROpcode.Fneg {
        let operand = vitte_ir_get_value(context, (*value).operands[0]);
        let operand_type: *IRType = if operand == null { null } else { vitte_ir_get_type(context, (*operand).type_) };
        let result_type = vitte_ir_get_type(context, (*value).result_type);
        if operand_type == null or result_type == null or (*operand).type_ != (*value).result_type or
           ((*value).opcode == IROpcode.Neg and not ir_is_integer((*result_type).kind)) or
           ((*value).opcode == IROpcode.Fneg and not ir_is_float((*result_type).kind)) or
           ((*value).opcode == IROpcode.Not and not ir_is_integer((*result_type).kind) and (*result_type).kind != IRTypeKind.Bool) {
            return ir_fail(context, IRError.TypeMismatch);
        }
    }
    if (*value).opcode == IROpcode.IcmpEq or (*value).opcode == IROpcode.IcmpNe or
       (*value).opcode == IROpcode.IcmpSlt or (*value).opcode == IROpcode.IcmpSle or (*value).opcode == IROpcode.IcmpSgt or (*value).opcode == IROpcode.IcmpSge or
       (*value).opcode == IROpcode.IcmpUlt or (*value).opcode == IROpcode.IcmpUle or (*value).opcode == IROpcode.IcmpUgt or (*value).opcode == IROpcode.IcmpUge {
        let left = vitte_ir_get_value(context, (*value).operands[0]); let right = vitte_ir_get_value(context, (*value).operands[1]);
        let left_type: *IRType = if left == null { null } else { vitte_ir_get_type(context, (*left).type_) };
        let result_type = vitte_ir_get_type(context, (*value).result_type);
        let equality = (*value).opcode == IROpcode.IcmpEq or (*value).opcode == IROpcode.IcmpNe;
        let is_signed = (*value).opcode == IROpcode.IcmpSlt or (*value).opcode == IROpcode.IcmpSle or (*value).opcode == IROpcode.IcmpSgt or (*value).opcode == IROpcode.IcmpSge;
        let is_unsigned = (*value).opcode == IROpcode.IcmpUlt or (*value).opcode == IROpcode.IcmpUle or (*value).opcode == IROpcode.IcmpUgt or (*value).opcode == IROpcode.IcmpUge;
        if left == null or right == null or left_type == null or result_type == null or (*result_type).kind != IRTypeKind.Bool or
           (*left).type_ != (*right).type_ or
           (equality and not ir_is_integer((*left_type).kind) and (*left_type).kind != IRTypeKind.Bool and (*left_type).kind != IRTypeKind.Char and (*left_type).kind != IRTypeKind.Pointer and (*left_type).kind != IRTypeKind.Pick) or
           (is_signed and not ir_is_signed_integer((*left_type).kind)) or (is_unsigned and not ir_is_unsigned_integer((*left_type).kind)) {
            return ir_fail(context, IRError.TypeMismatch);
        }
    }
    if (*value).opcode == IROpcode.FcmpEq or (*value).opcode == IROpcode.FcmpNe or (*value).opcode == IROpcode.FcmpLt or
       (*value).opcode == IROpcode.FcmpLe or (*value).opcode == IROpcode.FcmpGt or (*value).opcode == IROpcode.FcmpGe {
        let left = vitte_ir_get_value(context, (*value).operands[0]); let right = vitte_ir_get_value(context, (*value).operands[1]);
        let left_type: *IRType = if left == null { null } else { vitte_ir_get_type(context, (*left).type_) };
        let result_type = vitte_ir_get_type(context, (*value).result_type);
        if left == null or right == null or left_type == null or result_type == null or not ir_is_float((*left_type).kind) or
           (*left).type_ != (*right).type_ or (*result_type).kind != IRTypeKind.Bool { return ir_fail(context, IRError.TypeMismatch); }
    }
    if (*value).opcode == IROpcode.Trunc or (*value).opcode == IROpcode.Zext or (*value).opcode == IROpcode.Sext or
       (*value).opcode == IROpcode.FpTrunc or (*value).opcode == IROpcode.FpExt or (*value).opcode == IROpcode.SiToFp or
       (*value).opcode == IROpcode.UiToFp or (*value).opcode == IROpcode.FpToSi or (*value).opcode == IROpcode.FpToUi or
       (*value).opcode == IROpcode.PtrToInt or (*value).opcode == IROpcode.IntToPtr or (*value).opcode == IROpcode.Bitcast {
        let operand = vitte_ir_get_value(context, (*value).operands[0]);
        let source_type: *IRType = if operand == null { null } else { vitte_ir_get_type(context, (*operand).type_) };
        let target_type = vitte_ir_get_type(context, (*value).result_type);
        let mut valid = source_type != null and target_type != null;
        if valid {
            match (*value).opcode {
                case IROpcode::Trunc | IROpcode::Zext | IROpcode::Sext => set valid = ir_is_integer((*source_type).kind) and ir_is_integer((*target_type).kind);
                case IROpcode::FpTrunc | IROpcode::FpExt => set valid = ir_is_float((*source_type).kind) and ir_is_float((*target_type).kind);
                case IROpcode::SiToFp => set valid = ir_is_signed_integer((*source_type).kind) and ir_is_float((*target_type).kind);
                case IROpcode::UiToFp => set valid = ir_is_unsigned_integer((*source_type).kind) and ir_is_float((*target_type).kind);
                case IROpcode::FpToSi => set valid = ir_is_float((*source_type).kind) and ir_is_signed_integer((*target_type).kind);
                case IROpcode::FpToUi => set valid = ir_is_float((*source_type).kind) and ir_is_unsigned_integer((*target_type).kind);
                case IROpcode::PtrToInt => set valid = (*source_type).kind == IRTypeKind.Pointer and ir_is_integer((*target_type).kind);
                case IROpcode::IntToPtr => set valid = ir_is_integer((*source_type).kind) and (*target_type).kind == IRTypeKind.Pointer;
                case IROpcode::Bitcast => set valid = (*source_type).kind != IRTypeKind.Void and (*target_type).kind != IRTypeKind.Void;
