        let result_type = vitte_ir_get_type(context, (*value).result_type);
        if string == null or not ir_is_string_pointer_type(context, (*string).type_) or result_type == null or not ir_is_integer((*result_type).kind) { return ir_fail(context, IRError.TypeMismatch); }
    }
    if (*value).opcode == IROpcode.StringSlice {
        if operands != 3 { return ir_fail(context, IRError.InvalidInstruction); }
