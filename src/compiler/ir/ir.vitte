        if address_type == null or (*address_type).kind != IRTypeKind.Pointer or (*address_type).element_type != (*value).result_type { return ir_fail(context, IRError.TypeMismatch); }
    }
    if (*value).opcode == IROpcode.Store {
        let address = vitte_ir_get_value(context, (*value).operands[0]); let stored = vitte_ir_get_value(context, (*value).operands[1]);
        let address_type: *IRType = if address == null { null } else { vitte_ir_get_type(context, (*address).type_) };
        if address_type == null or (*address_type).kind != IRTypeKind.Pointer or stored == null or (*address_type).element_type != (*stored).type_ { return ir_fail(context, IRError.TypeMismatch); }
    }
    if (*value).opcode == IROpcode.Add or (*value).opcode == IROpcode.Sub or (*value).opcode == IROpcode.Mul or
       (*value).opcode == IROpcode.Sdiv or (*value).opcode == IROpcode.Udiv or (*value).opcode == IROpcode.Srem or (*value).opcode == IROpcode.Urem or
       (*value).opcode == IROpcode.Shl or (*value).opcode == IROpcode.Lshr or (*value).opcode == IROpcode.Ashr or
       (*value).opcode == IROpcode.And or (*value).opcode == IROpcode.Or or (*value).opcode == IROpcode.Xor {
        if operands != 2 { return ir_fail(context, IRError.InvalidInstruction); }
        let left = vitte_ir_get_value(context, (*value).operands[0]); let right = vitte_ir_get_value(context, (*value).operands[1]);
        let kind = vitte_ir_get_type(context, (*value).result_type);
        if left == null or right == null or kind == null or (*left).type_ != (*value).result_type or (*right).type_ != (*value).result_type or
           (not ir_is_integer((*kind).kind) and not ((*kind).kind == IRTypeKind.Bool and
