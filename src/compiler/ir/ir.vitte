        let start = vitte_ir_get_value(context, (*value).operands[1]);
        let length = vitte_ir_get_value(context, (*value).operands[2]);
        let start_type: *IRType = if start == null { null } else { vitte_ir_get_type(context, (*start).type_) };
        let length_type: *IRType = if length == null { null } else { vitte_ir_get_type(context, (*length).type_) };
        if source == null or (*source).type_ != (*value).result_type or not ir_is_string_pointer_type(context, (*source).type_) or
