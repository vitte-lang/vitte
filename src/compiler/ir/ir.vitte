export type IRId = u64;

export type IRStringId = u64;

export type IRTypeId = u64;

export type IRValueId = u64;

export type IRInstructionId = u64;

export type IRBlockId = u64;

export type IRFunctionId = u64;

proc ir_add_stat(value: *mut u64, increment: u64) {
    if value == null { return; }
    if *value > IR_U64_MAX - increment { set *value = IR_U64_MAX; }
    else { set *value += increment; }
}

proc ir_fail(context: *mut IRContext, error: IRError) -> bool {
    if context != null and (*context).magic == IR_MAGIC {
        set (*context).last_error = error;
    }
    return false;
}

proc ir_fail_id(context: *mut IRContext, error: IRError) -> u64 {
    ir_fail(context, error);
    return 0;
}

proc ir_size_add(left: usize, right: usize, result: *mut usize) -> bool {
    if result == null or left > usize.MAX - right { return false; }
    set *result = left + right;
    return true;
}

proc ir_size_mul(left: usize, right: usize, result: *mut usize) -> bool {
    if result == null or (right != 0 and left > usize.MAX / right) { return false; }
    set *result = left * right;
    return true;
}

proc ir_hash_byte(hash: u64, byte: u8) -> u64 {
    return (hash ^ byte as u64) * IR_FNV_PRIME;
}

proc ir_hash_u64(hash: u64, value: u64) -> u64 {
    let mut result = hash;
    let mut index: usize = 0;
    while index < 8 {
        set result = ir_hash_byte(result, ((value >> ((index * 8) as u32)) & 255) as u8);
        set index += 1;
    }
    return result;
}

proc ir_hash_bytes(data: *const u8, length: usize) -> u64 {
    let mut result = ir_hash_u64(IR_FNV_OFFSET, length as u64);
    if data == null and length != 0 { return result; }
    let mut index: usize = 0;
    while index < length {
        set result = ir_hash_byte(result, data[index]);
        set index += 1;
    }
    return result;
}

proc ir_reserve_array(
    context: *mut IRContext,
    memory: *mut u8,
    capacity: *mut usize,
    used_count: usize,
    required: usize,
    element_size: usize,
    maximum: usize
) -> *mut u8 {
    let mut storage = memory;
    if not ir_reserve(context, &mut storage, capacity, used_count, required, element_size, maximum) { return null; }
    return storage;
}

proc ir_reserve(
    context: *mut IRContext,
    memory: *mut *mut u8,
    capacity: *mut usize,
    used_count: usize,
    required: usize,
    element_size: usize,
    maximum: usize
) -> bool {
    if context == null or memory == null or capacity == null or element_size == 0 { return false; }
    if required <= *capacity { return true; }
    if required > maximum { return ir_fail(context, IRError.Limit); }
    let mut next_capacity: usize = if *capacity == 0 { IR_INITIAL_CAPACITY } else { *capacity };
    while next_capacity < required {
        if next_capacity > usize.MAX / 2 { set next_capacity = required; break; }
        let doubled = next_capacity * 2;
        if doubled > maximum { set next_capacity = maximum; break; }
        set next_capacity = doubled;
    }
    let mut allocation_size: usize = 0;
    let mut used_size: usize = 0;
    if next_capacity < required or not ir_size_mul(next_capacity, element_size, &mut allocation_size) or
       not ir_size_mul(used_count, element_size, &mut used_size) {
        return ir_fail(context, IRError.Overflow);
    }
    let replacement = allocate(allocation_size);
    if replacement == null {
        ir_add_stat(&mut (*context).stats.allocation_failures, 1);
        return ir_fail(context, IRError.OutOfMemory);
    }
    if used_size != 0 and (*memory == null or not copy(replacement, (*memory) as *const u8, used_size)) {
        deallocate(replacement);
        return ir_fail(context, IRError.OutOfMemory);
    }
    if *memory == null { ir_add_stat(&mut (*context).stats.allocations, 1); }
    else {
        ir_add_stat(&mut (*context).stats.reallocations, 1);
        deallocate(*memory);
    }
    set *memory = replacement;
    set *capacity = next_capacity;
    return true;
}

proc ir_id_exists(id: u64, count: usize) -> bool {
    return id != 0 and id <= count as u64;
}

proc ir_is_integer(kind: IRTypeKind) -> bool {
    return kind >= IRTypeKind.I8 and kind <= IRTypeKind.U64;
}

proc ir_is_float(kind: IRTypeKind) -> bool {
    return kind == IRTypeKind.F32 or kind == IRTypeKind.F64;
}

proc ir_free_storage(context: *mut IRContext) {
    if context == null { return; }
    let mut index: usize = 0;
    while index < (*context).string_count {
        let data: string = (*context).strings[index].data;
        deallocate(data.as_bytes().as_ptr() as *mut u8);
        set index += 1;
    }
    set index = 0;
    while index < (*context).type_count {
        deallocate((*context).types[index].parameter_types as *mut u8);
        deallocate((*context).types[index].field_types as *mut u8);
        set index += 1;
    }
    set index = 0;
    while index < (*context).instruction_count {
        deallocate((*context).instructions[index].operands as *mut u8);
        deallocate((*context).instructions[index].phi_incomings as *mut u8);
        set index += 1;
    }
    set index = 0;
    while index < (*context).block_count {
        deallocate((*context).blocks[index].instructions as *mut u8);
        deallocate((*context).blocks[index].predecessors as *mut u8);
        deallocate((*context).blocks[index].successors as *mut u8);
        set index += 1;
    }
    set index = 0;
    while index < (*context).function_count {
        deallocate((*context).functions[index].parameters as *mut u8);
        deallocate((*context).functions[index].blocks as *mut u8);
        set index += 1;
    }
    deallocate((*context).strings as *mut u8);
    deallocate((*context).types as *mut u8);
    deallocate((*context).values as *mut u8);
    deallocate((*context).instructions as *mut u8);
    deallocate((*context).blocks as *mut u8);
    deallocate((*context).functions as *mut u8);
    deallocate((*context).globals as *mut u8);
}

export proc vitte_ir_error_name(error: IRError) -> string {
    match error {
        case IRError.None => return "none";
        case IRError.InvalidArgument => return "invalid_argument";
        case IRError.InvalidContext => return "invalid_context";
        case IRError.InvalidState => return "invalid_state";
        case IRError.InvalidString => return "invalid_string";
        case IRError.InvalidType => return "invalid_type";
        case IRError.InvalidValue => return "invalid_value";
        case IRError.InvalidInstruction => return "invalid_instruction";
        case IRError.InvalidBlock => return "invalid_block";
        case IRError.InvalidFunction => return "invalid_function";
        case IRError.TypeMismatch => return "type_mismatch";
        case IRError.Duplicate => return "duplicate";
        case IRError.TerminatedBlock => return "terminated_block";
        case IRError.MissingTerminator => return "missing_terminator";
        case IRError.InvalidCfg => return "invalid_cfg";
        case IRError.InvalidPhi => return "invalid_phi";
        case IRError.Limit => return "limit";
        case IRError.Overflow => return "overflow";
        case IRError.OutOfMemory => return "out_of_memory";
        case IRError.Validation => return "validation";
        case IRError.Corruption => return "corruption";
        case IRError.Unsupported => return "unsupported";
        case IRError.Internal => return "internal";
        case IRError.Count => return "count";
    }
    return "unknown";
}

export proc vitte_ir_state_name(state: IRState) -> string {
    match state {
        case IRState.Invalid => return "invalid";
        case IRState.Building => return "building";
        case IRState.Sealed => return "sealed";
        case IRState.Failed => return "failed";
        case IRState.Destroyed => return "destroyed";
        case IRState.Count => return "count";
    }
    return "unknown";
}

export proc vitte_ir_type_kind_name(kind: IRTypeKind) -> string {
    match kind {
        case IRTypeKind.Invalid => return "invalid";
        case IRTypeKind.Void => return "void";
        case IRTypeKind.Bool => return "bool";
        case IRTypeKind.I8 => return "i8";
        case IRTypeKind.I16 => return "i16";
        case IRTypeKind.I32 => return "i32";
        case IRTypeKind.I64 => return "i64";
        case IRTypeKind.U8 => return "u8";
        case IRTypeKind.U16 => return "u16";
        case IRTypeKind.U32 => return "u32";
        case IRTypeKind.U64 => return "u64";
        case IRTypeKind.F32 => return "f32";
        case IRTypeKind.F64 => return "f64";
        case IRTypeKind.Char => return "char";
        case IRTypeKind.Pointer => return "pointer";
        case IRTypeKind.Array => return "array";
        case IRTypeKind.Slice => return "slice";
        case IRTypeKind.Function => return "function";
        case IRTypeKind.Struct => return "struct";
        case IRTypeKind.Opaque => return "opaque";
        case IRTypeKind.Pick => return "pick";
        case IRTypeKind.ForwardOpaque => return "forward_opaque";
        case IRTypeKind.Count => return "count";
    }
    return "unknown";
}

export proc vitte_ir_value_kind_name(kind: IRValueKind) -> string {
    match kind {
        case IRValueKind.Invalid => return "invalid";
        case IRValueKind.Undef => return "undef";
        case IRValueKind.Poison => return "poison";
        case IRValueKind.Null => return "null";
        case IRValueKind.ConstantBool => return "constant_bool";
        case IRValueKind.ConstantInteger => return "constant_integer";
        case IRValueKind.ConstantFloat => return "constant_float";
        case IRValueKind.ConstantString => return "constant_string";
        case IRValueKind.Parameter => return "parameter";
        case IRValueKind.Instruction => return "instruction";
        case IRValueKind.Function => return "function";
        case IRValueKind.Global => return "global";
        case IRValueKind.Count => return "count";
    }
    return "unknown";
}

