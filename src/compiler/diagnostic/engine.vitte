export proc diagnostic_engine_suggestion(
    engine: &mut DiagnosticEngine,
    message: string,
    replacement: *string,
    applicability:
        DiagnosticApplicability,
    span: *AstSpan
) -> bool {
    let maybe_index = diagnostic_engine_last_index(engine);
    if maybe_index == null {
        return false;
    }
    let index = maybe_index?;
    let mut diagnostic_value = engine.bag.storage[index];
    let result = diagnostic_add_suggestion(
        &mut diagnostic_value,
        message,
        span,
        replacement,
        applicability
    );
    set engine.bag.storage[index] = diagnostic_value;
    return result;
}

export proc diagnostic_engine_subject(
    engine: &mut DiagnosticEngine,
    symbol: string,
    expected_type: string,
    actual_type: string,
    context: string
) -> bool {
    let maybe_index = diagnostic_engine_last_index(engine);
    if maybe_index == null {
        return false;
    }
    let index = maybe_index?;
    let mut diagnostic_value = engine.bag.storage[index];
    diagnostic_set_subject(
        &mut diagnostic_value,
        symbol,
        expected_type,
        actual_type
    );

    diagnostic_set_context(
        &mut diagnostic_value,
        engine.package,
        engine.module,
        engine.procedure,
        context
    );

    set engine.bag.storage[index] = diagnostic_value;
    return true;
}

/// -------------------------------------------------------------------------
/// Contract
/// -------------------------------------------------------------------------

export proc diagnostic_engine_contract(
    engine: &mut DiagnosticEngine,
    kind: DiagnosticContractKind,
    expression: string,
    procedure: string,
    reason: string,
    contract_span: *AstSpan,
    call_span: *AstSpan,
    declaration_span: *AstSpan
) -> bool {
    let maybe_index = diagnostic_engine_last_index(engine);
    if maybe_index == null {
        return false;
    }
    let index = maybe_index?;
    let mut diagnostic_value = engine.bag.storage[index];
    let result = diagnostic_set_contract(
        &mut diagnostic_value,
        kind,
        expression,
        procedure,
        reason,
        contract_span,
        call_span,
        declaration_span
    );
    set engine.bag.storage[index] = diagnostic_value;
    return result;
}

/// -------------------------------------------------------------------------
/// Checkpoints
/// -------------------------------------------------------------------------

export proc diagnostic_engine_checkpoint(
    engine: &DiagnosticEngine
) -> DiagnosticCheckpoint {
    if not diagnostic_engine_valid(engine) {
        return DiagnosticCheckpoint {
            count: 0,
            counts: DiagnosticCounts {
                note_count: 0,
                help_count: 0,
                warning_count: 0,
                error_count: 0,
                fatal_count: 0,
                suppressed_count: 0,
                primary_count: 0,
                cascade_count: 0
            },

            emitted_count: 0,
            rejected_count: 0,

            cascade_count: 0,
            suppressed_count: 0,

            stopped: false,
            limit_reported: false,

            valid: false
        };
    }

    let bag: &DiagnosticBag =
        engine.bag;

    return DiagnosticCheckpoint {
        count: bag.storage.len(),

        counts: bag.counts,

        emitted_count:
            engine.emitted_count,

        rejected_count:
            engine.rejected_count,

        cascade_count:
            engine.cascade_count,

        suppressed_count:
            engine.suppressed_count,

        stopped:
            engine.stopped,

        limit_reported:
            engine.limit_reported,

        valid: true
    };
}

export proc diagnostic_engine_rollback(
    engine: &mut DiagnosticEngine,
    checkpoint: &DiagnosticCheckpoint
) -> bool {
    if not diagnostic_engine_valid(engine) or
       not checkpoint.valid {

        return false;
    }

    let bag: &mut DiagnosticBag =
        engine.bag;

    if checkpoint.count >
       bag.storage.len() {

        return false;
    }

    while bag.storage.len() >
          checkpoint.count {

        let mut truncated: [Diagnostic] = [];
        let mut index: usize = 0;

        while index < checkpoint.count {
            truncated.append(bag.storage[index]);
            set index = index + 1;
        }

        set bag.storage = truncated;
    }

    set bag.counts =
        checkpoint.counts;

    set engine.emitted_count =
        checkpoint.emitted_count;

    set engine.rejected_count =
        checkpoint.rejected_count;

    set engine.cascade_count =
        checkpoint.cascade_count;

    set engine.suppressed_count =
        checkpoint.suppressed_count;

    set engine.stopped =
        checkpoint.stopped;

    set engine.limit_reported =
        checkpoint.limit_reported;

    if engine.current_parent !=
           ENGINE_INDEX_NONE and
       engine.current_parent >=
           bag.storage.len() {

        set engine.current_parent =
            ENGINE_INDEX_NONE;
    }

    if engine.current_root !=
           ENGINE_INDEX_NONE and
       engine.current_root >=
           bag.storage.len() {

        set engine.current_root =
            ENGINE_INDEX_NONE;
    }

    if engine.current_parent ==
       ENGINE_INDEX_NONE {

        set engine.current_root =
            ENGINE_INDEX_NONE;
    }

    return diagnostic_bag_validate(bag);
}

export proc diagnostic_engine_changed_since(
    engine: &DiagnosticEngine,
    checkpoint: &DiagnosticCheckpoint
) -> bool {
    if not diagnostic_engine_valid(engine) or
       not checkpoint.valid {

        return false;
    }

    return engine.bag.storage.len() !=
         checkpoint.count;
}

export proc diagnostic_engine_has_errors_since(
    engine: &DiagnosticEngine,
    checkpoint: &DiagnosticCheckpoint
) -> bool {
    if not diagnostic_engine_valid(engine) or
       not checkpoint.valid {

        return false;
    }

    let bag: &DiagnosticBag =
        engine.bag;

    if checkpoint.count >
       bag.storage.len() {

        return false;
    }

    let mut index: usize =
        checkpoint.count;

    while index < bag.storage.len() {
        let diagnostic_value: &Diagnostic =
            &bag.storage[index];

        if not diagnostic_value.is_suppressed and
           diagnostic_engine_is_error_severity(
               diagnostic_value.severity
           ) {

            return true;
        }

        set index = index + 1;
    }

    return false;
}

/// -------------------------------------------------------------------------
/// Cascade classification
/// -------------------------------------------------------------------------

proc diagnostic_engine_classify_one(
    bag: &mut DiagnosticBag,
    index: usize,
    suppress: bool
) -> bool {
    if bag.storage.len() == 0 or
       index >= bag.storage.len() or
       index != bag.storage.len() - 1 {
        return false;
    }

    return cascade_classify_last(bag, suppress) == Status.Ok;
}

proc diagnostic_engine_classify_cascades(
    bag: &mut DiagnosticBag,
    suppress: bool
) -> bool {
    return cascade_classify_all(bag, suppress) == Status.Ok;
}

/// -------------------------------------------------------------------------
/// Relation validation
/// -------------------------------------------------------------------------

proc diagnostic_engine_relations_valid(
    bag: &DiagnosticBag
) -> bool {
    let count: usize =
        bag.storage.len();

    let mut index: usize = 0;

    while index < count {
        let diagnostic_value: &Diagnostic =
            &bag.storage[index];

        if diagnostic_value.is_primary and
           diagnostic_value.is_cascade {

            return false;
        }

        if diagnostic_value.is_primary {
            if diagnostic_value.parent_diagnostic !=
               ENGINE_INDEX_NONE {

                return false;
            }

            if diagnostic_value.root_diagnostic !=
                   ENGINE_INDEX_NONE and
               diagnostic_value.root_diagnostic !=
                   index {

                return false;
            }
        }

        if diagnostic_value.is_cascade {
            if not diagnostic_engine_index_valid(
                diagnostic_value.parent_diagnostic,
                count
            ) {
                return false;
            }

            if not diagnostic_engine_index_valid(
                diagnostic_value.root_diagnostic,
                count
            ) {
                return false;
            }

            if diagnostic_value.parent_diagnostic ==
                   index or
               diagnostic_value.root_diagnostic ==
                   index {

                return false;
            }
        }

        if diagnostic_value.parent_diagnostic !=
           ENGINE_INDEX_NONE {

            let mut current: usize =
                index;

            let mut steps: usize = 0;

            while steps <= count {
                if not diagnostic_engine_index_valid(
                    current,
                    count
                ) {
                    return false;
                }

                let node: &Diagnostic =
                    &bag.storage[current];

                if node.parent_diagnostic ==
                   ENGINE_INDEX_NONE {

                    break;
                }

                if not diagnostic_engine_index_valid(
                    node.parent_diagnostic,
                    count
                ) {
                    return false;
                }

                if node.parent_diagnostic ==
                   current {

                    return false;
                }

                set current =
                    node.parent_diagnostic;

                if current == index {
                    return false;
                }

                set steps = steps + 1;
            }

            if steps > count {
                return false;
            }
        }

        set index = index + 1;
    }

    return true;
}

/// -------------------------------------------------------------------------
/// Deterministic ordering
/// -------------------------------------------------------------------------

proc diagnostic_engine_severity_rank(
    severity: DiagnosticSeverity
) -> u64 {
    match severity {
        DiagnosticSeverity.Fatal => { return 0; },
        DiagnosticSeverity.Error => { return 1; },
        DiagnosticSeverity.Warning => { return 2; },
        DiagnosticSeverity.Note => { return 3; },
        DiagnosticSeverity.Help => { return 4; }
    }
}

proc diagnostic_engine_origin_rank(
    origin: DiagnosticOrigin
) -> u64 {
    match origin {
        DiagnosticOrigin.Io => { return 10; },

        DiagnosticOrigin.Lexer => { return 20; },
        DiagnosticOrigin.Parser => { return 30; },

        DiagnosticOrigin.Import => { return 40; },
        DiagnosticOrigin.NameResolution => { return 50; },
        DiagnosticOrigin.TypeCheck => { return 60; },

        DiagnosticOrigin.Contract => { return 63; },
        DiagnosticOrigin.ConstantEval => { return 65; },

        DiagnosticOrigin.Hir => { return 70; },
        DiagnosticOrigin.Ir => { return 80; },
        DiagnosticOrigin.C17Backend => { return 90; },
        DiagnosticOrigin.CCompiler => { return 100; },
        DiagnosticOrigin.Linker => { return 110; },

        DiagnosticOrigin.Runtime => { return 120; },
        DiagnosticOrigin.Driver => { return 130; },
        DiagnosticOrigin.Internal => { return 140; },

        DiagnosticOrigin.Scanner => { return 150; },
        DiagnosticOrigin.Codegen => { return 150; },
        DiagnosticOrigin.Unknown => { return 150; }
    }
}

proc diagnostic_engine_compare(
    left: &Diagnostic,
    right: &Diagnostic
) -> i64 {
    if left.source_name !=
       right.source_name {

        if diagnostic_engine_string_compare(
               left.source_name,
               right.source_name
           ) < 0 {
            return -1;
        } else {
            return 1;
        }
    }

    if left.source_id !=
       right.source_id {

        if left.source_id == 0 {
            return 1;
        }

        if right.source_id == 0 {
            return -1;
        }

        if left.source_id <
             right.source_id {
            return -1;
        } else {
            return 1;
        }
    }

    if left.start_offset !=
       right.start_offset {

        if left.start_offset <
             right.start_offset {
            return -1;
        } else {
            return 1;
        }
    }

    if left.end_offset !=
       right.end_offset {

        if left.end_offset <
             right.end_offset {
            return -1;
        } else {
            return 1;
        }
    }

    let left_severity: u64 =
        diagnostic_engine_severity_rank(
            left.severity
        );

    let right_severity: u64 =
        diagnostic_engine_severity_rank(
            right.severity
        );

    if left_severity != right_severity {
        if left_severity <
             right_severity {
            return -1;
        } else {
            return 1;
        }
    }

    let left_origin: u64 =
        diagnostic_engine_origin_rank(
            left.origin
        );

    let right_origin: u64 =
        diagnostic_engine_origin_rank(
            right.origin
        );

    if left_origin != right_origin {
        if left_origin <
             right_origin {
            return -1;
        } else {
            return 1;
        }
    }

    if left.short_code != right.short_code {
        if diagnostic_engine_string_compare(
               left.short_code,
               right.short_code
           ) < 0 {
            return -1;
        } else {
            return 1;
        }
    }

    if left.code != right.code {
        if diagnostic_engine_string_compare(
               left.code,
               right.code
           ) < 0 {
            return -1;
        } else {
            return 1;
        }
    }

    if left.symbol != right.symbol {
        if diagnostic_engine_string_compare(
               left.symbol,
               right.symbol
           ) < 0 {
            return -1;
        } else {
            return 1;
        }
    }

    if left.expected_type !=
       right.expected_type {

        if diagnostic_engine_string_compare(
               left.expected_type,
               right.expected_type
           ) < 0 {
            return -1;
        } else {
            return 1;
        }
    }

    if left.actual_type !=
       right.actual_type {

        if diagnostic_engine_string_compare(
               left.actual_type,
               right.actual_type
           ) < 0 {
            return -1;
        } else {
            return 1;
        }
    }

    if left.message != right.message {
        if diagnostic_engine_string_compare(
               left.message,
               right.message
           ) < 0 {
            return -1;
        } else {
            return 1;
        }
    }

    if left.fingerprint !=
       right.fingerprint {

        if left.fingerprint <
             right.fingerprint {
            return -1;
        } else {
            return 1;
        }
    }

    return 0;
}

proc diagnostic_engine_sort_entry_less(
    left: &DiagnosticEngineSortEntry,
    right: &DiagnosticEngineSortEntry
) -> bool {
    let comparison: i64 =
        diagnostic_engine_compare(
            &left.diagnostic_value,
            &right.diagnostic_value
        );

    if comparison < 0 {
        return true;
    }

    if comparison > 0 {
        return false;
    }

    return left.old_index <
         right.old_index;
}

proc diagnostic_engine_sort_entries(
    entries: &mut [DiagnosticEngineSortEntry]
) {
    let count: usize = entries.len();

    if count < 2 {
        return;
    }

    let mut width: usize = 1;
    let mut scratch: [DiagnosticEngineSortEntry] =
        *entries;

    while width < count {
        let mut base: usize = 0;

        while base < count {
            let left_begin: usize =
                base;

            let left_end: usize =
            diagnostic_engine_min_usize(
                base + width,
                count
            );

            let right_begin: usize =
                left_end;

            let right_end: usize =
            diagnostic_engine_min_usize(
                left_end + width,
                count
            );

            let mut left: usize =
                left_begin;

            let mut right: usize =
                right_begin;

            let mut output: usize =
                base;

            while left < left_end and
                  right < right_end {

                if diagnostic_engine_sort_entry_less(
                    &entries[right],
                    &entries[left]
                ) {
                    set scratch[output] =
                        entries[right];

                    set right = right + 1;
                } else {
                    set scratch[output] =
                        entries[left];

                    set left = left + 1;
                }

                set output = output + 1;
            }

            while left < left_end {
                set scratch[output] =
                    entries[left];

                set left = left + 1;
                set output = output + 1;
            }

            while right < right_end {
                set scratch[output] =
                    entries[right];

                set right = right + 1;
                set output = output + 1;
            }

            set base =
                base + width + width;
        }

        let mut index: usize = 0;

        while index < count {
            set entries[index] =
                scratch[index];

            set index = index + 1;
        }

        if width > count / 2 {
            set width = count;
        } else {
            set width = width * 2;
        }
    }
}

export proc diagnostic_engine_sort(
    engine: &mut DiagnosticEngine
) -> bool {
    if not diagnostic_engine_valid(engine) {
        return false;
    }

    let bag: &mut DiagnosticBag =
        engine.bag;

    let count: usize =
        bag.storage.len();

    if count < 2 {
        return true;
    }

    if not diagnostic_engine_relations_valid(
        bag
    ) {
        return false;
    }

    let old_current_parent: usize =
        engine.current_parent;

    let old_current_root: usize =
        engine.current_root;

    let mut entries:
        [DiagnosticEngineSortEntry] = [];

    let mut old_to_new: [usize] = [];

    let mut index: usize = 0;

    while index < count {
        entries.append(
            DiagnosticEngineSortEntry {
                diagnostic_value: bag.storage[index],
                old_index: index
            }
        );

        old_to_new.append(ENGINE_INDEX_NONE);

        set index = index + 1;
    }

    diagnostic_engine_sort_entries(
        &mut entries
    );

    set index = 0;

    while index < count {
        let old_index: usize =
            entries[index].old_index;

        if old_index >= count {
            return false;
        }

        if old_to_new[old_index] !=
           ENGINE_INDEX_NONE {

            return false;
        }

        set old_to_new[old_index] =
            index;

        set index = index + 1;
    }

    set index = 0;

    while index < count {
        set bag.storage[index] =
            entries[index].diagnostic_value;

        set index = index + 1;
    }

    set index = 0;

    while index < count {
        let old_parent: usize =
            entries[index]
                .diagnostic_value
                .parent_diagnostic;

        let old_root: usize =
            entries[index]
                .diagnostic_value
                .root_diagnostic;

        if old_parent !=
           ENGINE_INDEX_NONE {

            if old_parent >= count or
               old_to_new[old_parent] ==
                   ENGINE_INDEX_NONE {

                return false;
            }

            set bag.storage[index]
                .parent_diagnostic =
                    old_to_new[old_parent];
        } else {
            set bag.storage[index]
                .parent_diagnostic =
                    ENGINE_INDEX_NONE;
        }

        if old_root !=
           ENGINE_INDEX_NONE {

            if old_root >= count or
               old_to_new[old_root] ==
                   ENGINE_INDEX_NONE {

                return false;
            }

            set bag.storage[index]
                .root_diagnostic =
                    old_to_new[old_root];
        } else if
            bag.storage[index].is_primary {

            set bag.storage[index]
                .root_diagnostic =
                    index;
        } else {
            set bag.storage[index]
                .root_diagnostic =
                    ENGINE_INDEX_NONE;
        }

        if bag.storage[index].is_primary {
            set bag.storage[index]
                .parent_diagnostic =
                    ENGINE_INDEX_NONE;

            set bag.storage[index]
                .root_diagnostic =
                    index;

            set bag.storage[index]
                .is_cascade =
                    false;
        }

        if bag.storage[index].is_cascade {
            set bag.storage[index]
                .is_primary =
                    false;
        }

        set index = index + 1;
    }

    if old_current_parent !=
       ENGINE_INDEX_NONE {

        if old_current_parent < count {
            set engine.current_parent =
                old_to_new[
                    old_current_parent
                ];
        } else {
            set engine.current_parent =
                ENGINE_INDEX_NONE;
        }
    } else {
        set engine.current_parent =
            ENGINE_INDEX_NONE;
    }

    if old_current_root !=
       ENGINE_INDEX_NONE {

        if old_current_root < count {
            set engine.current_root =
                old_to_new[
                    old_current_root
                ];
        } else {
            set engine.current_root =
                ENGINE_INDEX_NONE;
        }
    } else {
        set engine.current_root =
            ENGINE_INDEX_NONE;
    }

    if engine.current_parent ==
       ENGINE_INDEX_NONE {

        set engine.current_root =
            ENGINE_INDEX_NONE;
    }

    if not diagnostic_engine_relations_valid(
        bag
    ) {
        return false;
    }

    diagnostic_engine_refresh_relation_statistics(
        engine
    );

    return true;
}

/// -------------------------------------------------------------------------
/// Finalization
/// -------------------------------------------------------------------------

export proc diagnostic_engine_finalize(
    engine: &mut DiagnosticEngine
) -> Status {
    if not diagnostic_engine_valid(engine) {
        return Status.ErrorInvalidState;
    }

    let bag: &mut DiagnosticBag =
        engine.bag;

    if engine.policy.classify_cascades {
        if not diagnostic_engine_classify_cascades(
            bag,
            engine.policy.suppress_cascades
        ) {
            return Status.ErrorInvalidState;
        }

        diagnostic_engine_refresh_relation_statistics(
            engine
        );
    }

    if not diagnostic_engine_relations_valid(
        bag
    ) {
        return Status.ErrorInvalidState;
    }

    if engine.policy.sort_before_render {
        if not diagnostic_engine_sort(
            engine
        ) {
            return Status.ErrorInvalidState;
        }
    }

    diagnostic_engine_refresh_relation_statistics(
        engine
    );

    return diagnostic_engine_status(engine);
}

/// -------------------------------------------------------------------------
/// Statistics
/// -------------------------------------------------------------------------

export proc diagnostic_engine_statistics(
    engine: &DiagnosticEngine
) -> DiagnosticEngineStatistics {
    if not diagnostic_engine_valid(engine) {
        return DiagnosticEngineStatistics {
            stored: 0,

            emitted: 0,
            rejected: 0,

            cascade: 0,
            primary: 0,

            suppressed: 0,

            visible_errors: 0,
            visible_warnings: 0,

            stopped: false
        };
    }

    let bag: &DiagnosticBag =
        engine.bag;

    return DiagnosticEngineStatistics {
        stored:
            bag.storage.len(),

        emitted:
            engine.emitted_count,

        rejected:
            engine.rejected_count,

        cascade:
            diagnostic_cascade_count(bag),

        primary:
            diagnostic_primary_count(bag),

        suppressed:
            diagnostic_suppressed_count(bag),

        visible_errors:
            diagnostic_engine_visible_errors(
                bag
            ),

        visible_warnings:
            diagnostic_engine_visible_warnings(
                bag
            ),

        stopped:
            engine.stopped
    };
}

/// -------------------------------------------------------------------------
/// Status
/// -------------------------------------------------------------------------

export proc diagnostic_engine_status(
    engine: &DiagnosticEngine
) -> Status {
    if not diagnostic_engine_valid(engine) {
        return Status.ErrorInvalidState;
    }

    let bag: &DiagnosticBag =
        engine.bag;

    if diagnostic_has_errors(bag) {
        return Status.ErrorInvalidState;
    }

    return Status.Ok;
}

/// -------------------------------------------------------------------------
/// Component metadata
/// -------------------------------------------------------------------------

export proc diagnostic_engine_component_name() -> string {
    return "diagnostic-engine";
}

export proc diagnostic_engine_component_version() -> u64 {
    return 1;
}
