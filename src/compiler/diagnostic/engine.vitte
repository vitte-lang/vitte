space compiler::diagnostic::engine;

use compiler::diagnostic::diagnostic::{    Diagnostic,
    DiagnosticBag,
    DiagnosticCounts,
    DiagnosticSeverity,
    DiagnosticOrigin,
    DiagnosticLabelStyle,
    DiagnosticApplicability,
    DiagnosticContractKind,
    diagnostic_default,
    diagnostic_add,
    diagnostic_set_span,
    diagnostic_set_context,
    diagnostic_set_subject,
    diagnostic_add_label,
    diagnostic_add_note,
    diagnostic_add_help,
    diagnostic_add_cause,
    diagnostic_add_suggestion,
    diagnostic_set_contract,
    diagnostic_root,
    diagnostic_at_mut,
    diagnostic_has_errors,
    diagnostic_error_count,
    diagnostic_warning_count,
    diagnostic_primary_count,
    diagnostic_cascade_count,
    diagnostic_suppressed_count,
    diagnostic_bag_count,
    diagnostic_bag_validate
};

use compiler::diagnostic::cascade::{
    cascade_set_last_parent,
    cascade_mark_last_suppressed,
    cascade_classify_last,
    cascade_classify_all,
    cascade_root_index
};

use compiler::ast::ast::{    AstSpan
};

use compiler::api::error::{    Status
};

const ENGINE_DEFAULT_ERROR_LIMIT: usize = 100;
const ENGINE_DEFAULT_WARNING_LIMIT: usize = 100;

const ENGINE_INDEX_NONE: usize = 18446744073709551615 as usize;

/// -------------------------------------------------------------------------
/// Policy
/// -------------------------------------------------------------------------

export form DiagnosticEnginePolicy {
    error_limit: usize,
    warning_limit: usize,

    warnings_as_errors: bool,

    deduplicate: bool,

    classify_cascades: bool,
    suppress_cascades: bool,

    stop_after_fatal: bool,
    stop_after_error_limit: bool,

    emit_limit_diagnostic: bool,

    sort_before_render: bool,

    preserve_suppressed: bool
}

export proc diagnostic_engine_policy_default()
    -> DiagnosticEnginePolicy {

    return DiagnosticEnginePolicy {
        error_limit:
            ENGINE_DEFAULT_ERROR_LIMIT,

        warning_limit:
            ENGINE_DEFAULT_WARNING_LIMIT,

        warnings_as_errors: false,

        deduplicate: true,

        classify_cascades: true,
        suppress_cascades: true,

        stop_after_fatal: true,
        stop_after_error_limit: true,

        emit_limit_diagnostic: true,

        sort_before_render: true,

        preserve_suppressed: true
    };
}

/// -------------------------------------------------------------------------
/// Checkpoint
/// -------------------------------------------------------------------------

export form DiagnosticCheckpoint {
    count: usize,

    counts: DiagnosticCounts,

    emitted_count: usize,
    rejected_count: usize,

    cascade_count: usize,
    suppressed_count: usize,
    stopped: bool,
    limit_reported: bool,

    valid: bool
}

/// -------------------------------------------------------------------------
/// Statistics
/// -------------------------------------------------------------------------

export form DiagnosticEngineStatistics {
    stored: usize,

    emitted: usize,
    rejected: usize,

    cascade: usize,
    primary: usize,

    suppressed: usize,

    visible_errors: usize,
    visible_warnings: usize,

    stopped: bool
}

/// -------------------------------------------------------------------------
/// Sort support
/// -------------------------------------------------------------------------

form DiagnosticEngineSortEntry {
    diagnostic_value: Diagnostic,
    old_index: usize
}

/// -------------------------------------------------------------------------
/// Engine
/// -------------------------------------------------------------------------

export form DiagnosticEngine {
    initialized: bool,

    bag: &mut DiagnosticBag,

    policy: DiagnosticEnginePolicy,

    current_origin: DiagnosticOrigin,

    package: string,
    module: string,
    procedure: string,

    current_parent: usize,
    current_root: usize,

    stopped: bool,
    limit_reported: bool,

    emitted_count: usize,
    rejected_count: usize,

    cascade_count: usize,
    suppressed_count: usize

}

/// -------------------------------------------------------------------------
/// Internal helpers
/// -------------------------------------------------------------------------

proc diagnostic_engine_valid(
    engine: &DiagnosticEngine
) -> bool {
    if not engine.initialized {
        return false;
    }

    return diagnostic_bag_validate(
        engine.bag
    );
}

proc diagnostic_engine_text_valid(
    text: string
) -> bool {
    return text != "";
}

proc diagnostic_engine_is_error_severity(
    severity: DiagnosticSeverity
) -> bool {
    return severity == DiagnosticSeverity.Error or
         severity == DiagnosticSeverity.Fatal;
}

proc diagnostic_engine_is_warning_severity(
    severity: DiagnosticSeverity
) -> bool {
    return severity ==
         DiagnosticSeverity.Warning;
}

proc diagnostic_engine_index_valid(
    index: usize,
    count: usize
) -> bool {
    return index != ENGINE_INDEX_NONE and
         index < count;
}

proc diagnostic_engine_min_usize(left: usize, right: usize) -> usize {
    if left < right {
        return left;
    }

    return right;
}

proc diagnostic_engine_string_compare(
    left: string,
    right: string
) -> i64 {
    // Empty Vitte strings represent absent nullable C strings here, which
    // sort after present strings in the bootstrap comparator.
    if left == "" and right != "" {
        return 1;
    }

    if left != "" and right == "" {
        return -1;
    }

    let left_bytes: [u8] = left.bytes();
    let right_bytes: [u8] = right.bytes();
    let common_length: usize =
        diagnostic_engine_min_usize(
            left_bytes.len(),
            right_bytes.len()
        );
    let mut index: usize = 0;

    while index < common_length {
        if left_bytes[index] < right_bytes[index] {
            return -1;
        }

        if left_bytes[index] > right_bytes[index] {
            return 1;
        }

        set index = index + 1;
    }

    if left_bytes.len() < right_bytes.len() {
        return -1;
    }

    if left_bytes.len() > right_bytes.len() {
        return 1;
    }

    return 0;
}

/// -------------------------------------------------------------------------
/// Visible counters
/// -------------------------------------------------------------------------

proc diagnostic_engine_visible_errors(
    bag: &DiagnosticBag
) -> usize {
    let mut count: usize = 0;
    let mut index: usize = 0;

    while index < bag.storage.len() {
        let diagnostic_value: &Diagnostic =
            &bag.storage[index];

        if not diagnostic_value.is_suppressed and
           diagnostic_engine_is_error_severity(
               diagnostic_value.severity
           ) {

            set count = count + 1;
        }

        set index = index + 1;
    }

    return count;
}

proc diagnostic_engine_visible_warnings(
    bag: &DiagnosticBag
) -> usize {
    let mut count: usize = 0;
    let mut index: usize = 0;

    while index < bag.storage.len() {
        let diagnostic_value: &Diagnostic =
            &bag.storage[index];

        if not diagnostic_value.is_suppressed and
           diagnostic_engine_is_warning_severity(
               diagnostic_value.severity
           ) {

            set count = count + 1;
        }

        set index = index + 1;
    }

    return count;
}

proc diagnostic_engine_refresh_relation_statistics(
    engine: &mut DiagnosticEngine
) {
    if not diagnostic_engine_valid(engine) {
        return;
    }

    let bag: &DiagnosticBag =
        engine.bag;

    set engine.cascade_count =
        diagnostic_cascade_count(bag);

    set engine.suppressed_count =
        diagnostic_suppressed_count(bag);
}

/// -------------------------------------------------------------------------
/// Lifecycle
/// -------------------------------------------------------------------------

export proc diagnostic_engine(
    bag: &mut DiagnosticBag,
    policy: *DiagnosticEnginePolicy
) -> DiagnosticEngine {
    let mut selected_policy: DiagnosticEnginePolicy =
        diagnostic_engine_policy_default();

    if policy != null {
        set selected_policy = *policy;
    }

    if selected_policy.error_limit == 0 {
        set selected_policy.error_limit =
            ENGINE_DEFAULT_ERROR_LIMIT;
    }

    if selected_policy.warning_limit == 0 {
        set selected_policy.warning_limit =
            ENGINE_DEFAULT_WARNING_LIMIT;
    }

    return DiagnosticEngine {
        initialized: diagnostic_bag_validate(bag),

        bag: bag,

        policy: selected_policy,

        current_origin:
            DiagnosticOrigin.Unknown,

        package: "",
        module: "",
        procedure: "",

        current_parent:
            ENGINE_INDEX_NONE,

        current_root:
            ENGINE_INDEX_NONE,

        stopped: false,
        limit_reported: false,

        emitted_count: 0,
        rejected_count: 0,

        cascade_count:
            diagnostic_cascade_count(bag),

        suppressed_count:
            diagnostic_suppressed_count(bag)

    };
}

export proc diagnostic_engine_reset(
    engine: &mut DiagnosticEngine
) {
    set engine.current_origin =
        DiagnosticOrigin.Unknown;

    set engine.package = "";
    set engine.module = "";
    set engine.procedure = "";

    set engine.current_parent =
        ENGINE_INDEX_NONE;

    set engine.current_root =
        ENGINE_INDEX_NONE;

    set engine.stopped = false;
    set engine.limit_reported = false;

    set engine.emitted_count = 0;
    set engine.rejected_count = 0;

    set engine.cascade_count =
        diagnostic_cascade_count(engine.bag);

    set engine.suppressed_count =
        diagnostic_suppressed_count(engine.bag);
}

export proc diagnostic_engine_is_initialized(
    engine: &DiagnosticEngine
) -> bool {
    return diagnostic_engine_valid(engine);
}

/// -------------------------------------------------------------------------
/// Origin
/// -------------------------------------------------------------------------

export proc diagnostic_engine_set_origin(
    engine: &mut DiagnosticEngine,
    origin: DiagnosticOrigin
) -> bool {
    if not diagnostic_engine_valid(engine) {
        return false;
    }

    set engine.current_origin = origin;

    return true;
}

export proc diagnostic_engine_origin(
    engine: &DiagnosticEngine
) -> DiagnosticOrigin {
    if not diagnostic_engine_valid(engine) {
        return DiagnosticOrigin.Unknown;
    }

    return engine.current_origin;
}

/// -------------------------------------------------------------------------
/// Compilation context
/// -------------------------------------------------------------------------

export proc diagnostic_engine_set_context(
    engine: &mut DiagnosticEngine,
    package: string,
    module: string,
    procedure: string
) -> bool {
    if not diagnostic_engine_valid(engine) {
        return false;
    }

    set engine.package = package;
    set engine.module = module;
    set engine.procedure = procedure;

    return true;
}

export proc diagnostic_engine_clear_context(
    engine: &mut DiagnosticEngine
) {
    set engine.package = "";
    set engine.module = "";
    set engine.procedure = "";
}

/// -------------------------------------------------------------------------
/// Causal context
/// -------------------------------------------------------------------------

export proc diagnostic_engine_set_parent(
    engine: &mut DiagnosticEngine,
    parent_index: usize
) -> bool {
    if not diagnostic_engine_valid(engine) {
        return false;
    }

    let bag: &DiagnosticBag =
        engine.bag;

    if parent_index >= bag.storage.len() {
        return false;
    }

    let root: usize =
        cascade_root_index(
            bag,
            parent_index
        );

    if root == ENGINE_INDEX_NONE {
        return false;
    }

    set engine.current_parent =
        parent_index;

    set engine.current_root =
        root;

    return true;
}

export proc diagnostic_engine_clear_parent(
    engine: &mut DiagnosticEngine
) {
    set engine.current_parent =
        ENGINE_INDEX_NONE;

    set engine.current_root =
        ENGINE_INDEX_NONE;
}

/// -------------------------------------------------------------------------
/// Stop policy
/// -------------------------------------------------------------------------

export proc diagnostic_engine_should_stop(
    engine: &DiagnosticEngine
) -> bool {
    if not diagnostic_engine_valid(engine) {
        return true;
    }

    if engine.stopped {
        return true;
    }

    if engine.policy.stop_after_error_limit {
        let errors: usize =
            diagnostic_engine_visible_errors(
                engine.bag
            );

        if errors >=
           engine.policy.error_limit {

            return true;
        }
    }

    return false;
}

/// -------------------------------------------------------------------------
/// Limit diagnostic
/// -------------------------------------------------------------------------

proc diagnostic_engine_report_limit(
    engine: &mut DiagnosticEngine
) -> bool {
    if not diagnostic_engine_valid(engine) {
        return false;
    }

    if engine.limit_reported or
       not engine.policy.emit_limit_diagnostic {

        return true;
    }

    let mut diagnostic_value: Diagnostic =
        diagnostic_default();

    set diagnostic_value.severity =
        DiagnosticSeverity.Fatal;

    set diagnostic_value.origin =
        DiagnosticOrigin.Driver;

    set diagnostic_value.code =
        "VITTE_INFRA_E_LIMIT";

    set diagnostic_value.short_code =
        "E0009";

    set diagnostic_value.category =
        "limit";

    set diagnostic_value.message =
        "diagnostic limit reached";

    set diagnostic_value.details =
        "compilation stopped after reaching the configured error limit";

    set diagnostic_value.is_primary = true;
    set diagnostic_value.is_cascade = false;

    if not diagnostic_add(
        engine.bag,
        diagnostic_value
    ) {
        return false;
    }

    set engine.limit_reported = true;

    diagnostic_engine_refresh_relation_statistics(
        engine
    );

    return true;
}

/// -------------------------------------------------------------------------
/// Last diagnostic
/// -------------------------------------------------------------------------

export proc diagnostic_engine_last(
    engine: &mut DiagnosticEngine
) -> *mut Diagnostic {
    if not diagnostic_engine_valid(engine) {
        return null;
    }

    let bag: &mut DiagnosticBag =
        engine.bag;

    if bag.storage.len() == 0 {
        return null;
    }

    return diagnostic_at_mut(
        bag,
        bag.storage.len() - 1
    );
}

export proc diagnostic_engine_last_const(
    engine: &DiagnosticEngine
) -> *const Diagnostic {
    if not diagnostic_engine_valid(engine) {
        return null;
    }

    let bag: &DiagnosticBag =
        engine.bag;

    if bag.storage.len() == 0 {
        return null;
    }

    return &bag.storage[bag.storage.len() - 1] as *const Diagnostic;
}

export proc diagnostic_engine_last_index(
    engine: &DiagnosticEngine
) -> ?usize {
    if not diagnostic_engine_valid(engine) {
        return null;
    }

    let bag: &DiagnosticBag =
        engine.bag;

    if bag.storage.len() == 0 {
        return null;
    }

    return bag.storage.len() - 1;
}

/// -------------------------------------------------------------------------
/// Emission
/// -------------------------------------------------------------------------

export proc diagnostic_engine_emit(
    engine: &mut DiagnosticEngine,
    severity: DiagnosticSeverity,
    code: string,
    message: string,
    details: string,
    span: *AstSpan
) -> bool {
    if not diagnostic_engine_valid(engine) {
        return false;
    }

    if not diagnostic_engine_text_valid(code) or
       not diagnostic_engine_text_valid(message) {

        return false;
    }

    if engine.stopped {
        set engine.rejected_count =
            engine.rejected_count + 1;

        return false;
    }

    let mut effective_severity:
        DiagnosticSeverity = severity;

    if effective_severity ==
           DiagnosticSeverity.Warning and
       engine.policy.warnings_as_errors {

        set effective_severity =
            DiagnosticSeverity.Error;
    }

    let bag: &mut DiagnosticBag =
        engine.bag;

    if diagnostic_engine_is_error_severity(
           effective_severity
       ) and
       engine.policy.stop_after_error_limit and
       diagnostic_engine_visible_errors(bag) >=
           engine.policy.error_limit {

        diagnostic_engine_report_limit(engine);

        set engine.stopped = true;

        set engine.rejected_count =
            engine.rejected_count + 1;

        return false;
    }

    if effective_severity ==
           DiagnosticSeverity.Warning and
       diagnostic_engine_visible_warnings(bag) >=
           engine.policy.warning_limit {

        set engine.rejected_count =
            engine.rejected_count + 1;

        return true;
    }

    let mut pending: Diagnostic =
        diagnostic_default();

    set pending.severity =
        effective_severity;

    set pending.origin =
        engine.current_origin;

    set pending.code = code;
    set pending.message = message;
    set pending.details = details;

    if span != null {
        if not diagnostic_set_span(
            &mut pending,
            &*span
        ) {
            return false;
        }
    }

    diagnostic_set_context(
        &mut pending,
        engine.package,
        engine.module,
        engine.procedure,
        ""
    );

    let count_before: usize =
        bag.storage.len();

    if not diagnostic_add(
        bag,
        pending
    ) {
        return false;
    }

    if bag.storage.len() == count_before {
        set engine.rejected_count =
            engine.rejected_count + 1;

        return true;
    }

    let index: usize = count_before;

    if engine.current_parent !=
       ENGINE_INDEX_NONE {

        if engine.current_parent >= index {
            return false;
        }

        if cascade_set_last_parent(
            bag,
            engine.current_parent
        ) != Status.Ok {
            return false;
        }

        if engine.policy.suppress_cascades {
            if cascade_mark_last_suppressed(bag) != Status.Ok {
                return false;
            }
        }

    } else if
        engine.policy.classify_cascades and
        diagnostic_engine_is_error_severity(
            bag.storage[index].severity
        ) {

        if not diagnostic_engine_classify_one(
            bag,
            index,
            engine.policy.suppress_cascades
        ) {
            return false;
        }
    }

    set engine.emitted_count =
        engine.emitted_count + 1;

    diagnostic_engine_refresh_relation_statistics(
        engine
    );

    if bag.storage[index].severity ==
           DiagnosticSeverity.Fatal and
       engine.policy.stop_after_fatal {

        set engine.stopped = true;
    }

    if engine.policy.stop_after_error_limit and
       diagnostic_engine_visible_errors(bag) >=
           engine.policy.error_limit {

        diagnostic_engine_report_limit(engine);

        set engine.stopped = true;
    }

    return true;
}

/// -------------------------------------------------------------------------
/// Convenience emission
/// -------------------------------------------------------------------------

export proc diagnostic_engine_note(
    engine: &mut DiagnosticEngine,
    code: string,
    message: string,
    span: *AstSpan
) -> bool {
    return diagnostic_engine_emit(
        engine,
        DiagnosticSeverity.Note,
        code,
        message,
        "",
        span
    );
}

export proc diagnostic_engine_help(
    engine: &mut DiagnosticEngine,
    code: string,
    message: string,
    span: *AstSpan
) -> bool {
    return diagnostic_engine_emit(
        engine,
        DiagnosticSeverity.Help,
        code,
        message,
        "",
        span
    );
}

export proc diagnostic_engine_warning(
    engine: &mut DiagnosticEngine,
    code: string,
    message: string,
    details: string,
    span: *AstSpan
) -> bool {
    return diagnostic_engine_emit(
        engine,
        DiagnosticSeverity.Warning,
        code,
        message,
        details,
        span
    );
}

export proc diagnostic_engine_error(
    engine: &mut DiagnosticEngine,
    code: string,
    message: string,
    details: string,
    span: *AstSpan
) -> bool {
    return diagnostic_engine_emit(
        engine,
        DiagnosticSeverity.Error,
        code,
        message,
        details,
        span
    );
}

export proc diagnostic_engine_fatal(
    engine: &mut DiagnosticEngine,
    code: string,
    message: string,
    details: string,
    span: *AstSpan
) -> bool {
    return diagnostic_engine_emit(
        engine,
        DiagnosticSeverity.Fatal,
        code,
        message,
        details,
        span
    );
}

/// -------------------------------------------------------------------------
/// Decoration
/// -------------------------------------------------------------------------

export proc diagnostic_engine_primary_label(
    engine: &mut DiagnosticEngine,
    message: string,
    span: AstSpan
) -> bool {
    let maybe_index = diagnostic_engine_last_index(engine);
    if maybe_index == null {
        return false;
    }
    let index = maybe_index?;
    let mut diagnostic_value = engine.bag.storage[index];
    let result = diagnostic_add_label(
        &mut diagnostic_value,
        DiagnosticLabelStyle.Primary,
        span,
        message
    );
    set engine.bag.storage[index] = diagnostic_value;
    return result;
}

export proc diagnostic_engine_secondary_label(
    engine: &mut DiagnosticEngine,
    message: string,
    span: AstSpan
) -> bool {
    let maybe_index = diagnostic_engine_last_index(engine);
    if maybe_index == null {
        return false;
    }
    let index = maybe_index?;
    let mut diagnostic_value = engine.bag.storage[index];
    let result = diagnostic_add_label(
        &mut diagnostic_value,
        DiagnosticLabelStyle.Secondary,
        span,
        message
    );
    set engine.bag.storage[index] = diagnostic_value;
    return result;
}

