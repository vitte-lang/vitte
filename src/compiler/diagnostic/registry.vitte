/// Native Vitte implementation of the stable diagnostic registry.
space compiler::diagnostic::registry;

use compiler::api::error::{Status};
use compiler::diagnostic::diagnostic::{Diagnostic, DiagnosticOrigin, DiagnosticSeverity};

export const VITTE_DIAGNOSTIC_PUBLIC_CODE_LENGTH: usize = 5;
export const VITTE_DIAGNOSTIC_ERROR_CODE_MIN: u32 = 0;
export const VITTE_DIAGNOSTIC_ERROR_CODE_MAX: u32 = 1999;
export const VITTE_DIAGNOSTIC_RANGE_WIDTH: u32 = 100;

export pick DiagnosticRegistryRange {
    Unknown,
    Infrastructure,
    Lexer,
    Parser,
    Module,
    Name,
    Type,
    Call,
    Contract,
    Generic,
    Backend,
    Ir,
    ControlFlow,
    Memory,
    Unsafe,
    Ffi,
    ConstEval,
    Pattern,
    Concurrency,
    Macro,
    Target,
    Warning,
    Note,
    Help
}

export form DiagnosticRegistryEntry {
    internal_code: string,
    public_code: string,
    default_severity: DiagnosticSeverity,
    origin: DiagnosticOrigin,
    category: string,
    title: string,
    explanation: string,
    deprecated: bool
}

export form DiagnosticRegistryValidation {
    valid: bool,
    entry_count: usize,
    invalid_entry_count: usize,
    duplicate_internal_count: usize,
    duplicate_public_count: usize,
    first_invalid_index: usize
}

const DIAGNOSTIC_REGISTRY: [DiagnosticRegistryEntry] = [
    DiagnosticRegistryEntry { internal_code: "VITTE_INFRA_E_FALLBACK", public_code: "E0000", default_severity: DiagnosticSeverity.Fatal, origin: DiagnosticOrigin.Internal, category: "compiler", title: "compiler failure", explanation: "The compiler failed without a more specific diagnostic.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_INFRA_E_INTERNAL", public_code: "E0001", default_severity: DiagnosticSeverity.Fatal, origin: DiagnosticOrigin.Internal, category: "compiler", title: "internal compiler error", explanation: "An internal compiler invariant or implementation assumption failed.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_INFRA_E_INVARIANT", public_code: "E0002", default_severity: DiagnosticSeverity.Fatal, origin: DiagnosticOrigin.Internal, category: "compiler", title: "compiler invariant violated", explanation: "A compiler data structure or phase invariant was violated.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_INFRA_E_IMPOSSIBLE", public_code: "E0003", default_severity: DiagnosticSeverity.Fatal, origin: DiagnosticOrigin.Internal, category: "compiler", title: "unreachable compiler state", explanation: "The compiler reached a state that should be impossible.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_INFRA_E_RESOURCE", public_code: "E0004", default_severity: DiagnosticSeverity.Fatal, origin: DiagnosticOrigin.Internal, category: "resource", title: "compiler resource failure", explanation: "A required compiler resource could not be allocated or acquired.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_INFRA_E_SOURCE_READ", public_code: "E0005", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Io, category: "source", title: "source file could not be read", explanation: "The compiler could not load the requested source file.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_INFRA_E_ENCODING", public_code: "E0006", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Lexer, category: "encoding", title: "invalid source encoding", explanation: "The source contains an invalid or unsupported text encoding sequence.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_INFRA_E_SOURCE_MAP", public_code: "E0007", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Internal, category: "source-map", title: "source mapping failure", explanation: "A generated diagnostic could not be mapped back to its Vitte source.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_INFRA_E_DIAGNOSTIC", public_code: "E0008", default_severity: DiagnosticSeverity.Fatal, origin: DiagnosticOrigin.Internal, category: "diagnostic", title: "diagnostic subsystem failure", explanation: "The compiler diagnostic subsystem encountered an internal failure.", deprecated: false },
