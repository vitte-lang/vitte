    DiagnosticRegistryEntry { internal_code: "VITTE_INFRA_E_COMPONENT", public_code: "E0013", default_severity: DiagnosticSeverity.Fatal, origin: DiagnosticOrigin.Internal, category: "component", title: "compiler component failure", explanation: "A required compiler component failed or was unavailable.", deprecated: false },
