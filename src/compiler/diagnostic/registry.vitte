/// Native Vitte implementation of the stable diagnostic registry.
space compiler::diagnostic::registry;

use compiler::api::error::{Status};
use compiler::diagnostic::diagnostic::{Diagnostic, DiagnosticOrigin, DiagnosticSeverity};

export const VITTE_DIAGNOSTIC_PUBLIC_CODE_LENGTH: usize = 5;
export const VITTE_DIAGNOSTIC_ERROR_CODE_MIN: u32 = 0;
export const VITTE_DIAGNOSTIC_ERROR_CODE_MAX: u32 = 1999;
export const VITTE_DIAGNOSTIC_RANGE_WIDTH: u32 = 100;

export pick DiagnosticRegistryRange {
    Unknown,
    Infrastructure,
    Lexer,
    Parser,
    Module,
    Name,
    Type,
    Call,
    Contract,
    Generic,
    Backend,
    Ir,
    ControlFlow,
    Memory,
    Unsafe,
    Ffi,
    ConstEval,
    Pattern,
    Concurrency,
    Macro,
    Target,
    Warning,
    Note,
    Help
}

export form DiagnosticRegistryEntry {
    internal_code: string,
    public_code: string,
    default_severity: DiagnosticSeverity,
    origin: DiagnosticOrigin,
    category: string,
    title: string,
    explanation: string,
    deprecated: bool
}

export form DiagnosticRegistryValidation {
    valid: bool,
    entry_count: usize,
    invalid_entry_count: usize,
    duplicate_internal_count: usize,
    duplicate_public_count: usize,
    first_invalid_index: usize
}

const DIAGNOSTIC_REGISTRY: [DiagnosticRegistryEntry] = [
    DiagnosticRegistryEntry { internal_code: "VITTE_INFRA_E_FALLBACK", public_code: "E0000", default_severity: DiagnosticSeverity.Fatal, origin: DiagnosticOrigin.Internal, category: "compiler", title: "compiler failure", explanation: "The compiler failed without a more specific diagnostic.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_INFRA_E_INTERNAL", public_code: "E0001", default_severity: DiagnosticSeverity.Fatal, origin: DiagnosticOrigin.Internal, category: "compiler", title: "internal compiler error", explanation: "An internal compiler invariant or implementation assumption failed.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_INFRA_E_INVARIANT", public_code: "E0002", default_severity: DiagnosticSeverity.Fatal, origin: DiagnosticOrigin.Internal, category: "compiler", title: "compiler invariant violated", explanation: "A compiler data structure or phase invariant was violated.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_INFRA_E_IMPOSSIBLE", public_code: "E0003", default_severity: DiagnosticSeverity.Fatal, origin: DiagnosticOrigin.Internal, category: "compiler", title: "unreachable compiler state", explanation: "The compiler reached a state that should be impossible.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_INFRA_E_RESOURCE", public_code: "E0004", default_severity: DiagnosticSeverity.Fatal, origin: DiagnosticOrigin.Internal, category: "resource", title: "compiler resource failure", explanation: "A required compiler resource could not be allocated or acquired.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_INFRA_E_SOURCE_READ", public_code: "E0005", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Io, category: "source", title: "source file could not be read", explanation: "The compiler could not load the requested source file.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_INFRA_E_ENCODING", public_code: "E0006", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Lexer, category: "encoding", title: "invalid source encoding", explanation: "The source contains an invalid or unsupported text encoding sequence.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_INFRA_E_SOURCE_MAP", public_code: "E0007", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Internal, category: "source-map", title: "source mapping failure", explanation: "A generated diagnostic could not be mapped back to its Vitte source.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_INFRA_E_DIAGNOSTIC", public_code: "E0008", default_severity: DiagnosticSeverity.Fatal, origin: DiagnosticOrigin.Internal, category: "diagnostic", title: "diagnostic subsystem failure", explanation: "The compiler diagnostic subsystem encountered an internal failure.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_INFRA_E_LIMIT", public_code: "E0009", default_severity: DiagnosticSeverity.Fatal, origin: DiagnosticOrigin.Driver, category: "limit", title: "diagnostic limit reached", explanation: "Compilation stopped because the configured diagnostic limit was reached.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_INFRA_E_FORMAT", public_code: "E0010", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Internal, category: "format", title: "diagnostic formatting failure", explanation: "A diagnostic could not be formatted for the selected output format.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_INFRA_E_CONFIG", public_code: "E0011", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Driver, category: "configuration", title: "invalid compiler configuration", explanation: "The compiler configuration contains an invalid or incompatible option.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_INFRA_E_PHASE", public_code: "E0012", default_severity: DiagnosticSeverity.Fatal, origin: DiagnosticOrigin.Internal, category: "phase", title: "compiler phase failure", explanation: "A compiler phase terminated unexpectedly.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_INFRA_E_COMPONENT", public_code: "E0013", default_severity: DiagnosticSeverity.Fatal, origin: DiagnosticOrigin.Internal, category: "component", title: "compiler component failure", explanation: "A required compiler component failed or was unavailable.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_FRONTEND_E_SOURCE", public_code: "E0014", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Driver, category: "source", title: "native frontend rejected source", explanation: "The native frontend rejected the source, but this API call did not provide the detailed parser or semantic diagnostics.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_LEXER_E_INVALID_CHARACTER", public_code: "E0101", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Lexer, category: "lexer", title: "invalid character", explanation: "The source contains a character that is not valid in this lexical context.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_LEXER_E_UNTERMINATED_STRING", public_code: "E0102", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Lexer, category: "lexer", title: "unterminated string literal", explanation: "A string literal reaches the end of its permitted region without a closing delimiter.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_LEXER_E_INVALID_ESCAPE", public_code: "E0103", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Lexer, category: "lexer", title: "invalid escape sequence", explanation: "The string or character literal contains an invalid escape sequence.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_LEXER_E_INVALID_NUMBER", public_code: "E0104", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Lexer, category: "lexer", title: "invalid numeric literal", explanation: "The numeric literal does not conform to Vitte lexical rules.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_LEXER_E_NUMBER_OVERFLOW", public_code: "E0105", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Lexer, category: "lexer", title: "numeric literal overflow", explanation: "The integer magnitude must fit the supported unsigned 64-bit literal range [0, 18446744073709551615]; an annotated target type may impose a narrower range.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_LEXER_E_UNTERMINATED_COMMENT", public_code: "E0106", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Lexer, category: "lexer", title: "unterminated comment", explanation: "A block comment was opened but not terminated.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_LEXER_E_INVALID_IDENTIFIER", public_code: "E0107", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Lexer, category: "lexer", title: "invalid identifier", explanation: "The token cannot form a valid Vitte identifier.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_LEXER_E_INVALID_UNICODE", public_code: "E0108", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Lexer, category: "unicode", title: "invalid Unicode sequence", explanation: "The source contains malformed or unsupported Unicode data.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_LEXER_E_INVALID_INTEGER", public_code: "E0109", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Lexer, category: "lexer", title: "malformed integer literal", explanation: "An integer literal does not conform to the Vitte grammar for digits, bases, separators, or suffixes.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_LEXER_E_INVALID_FLOAT", public_code: "E0110", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Lexer, category: "lexer", title: "malformed floating-point literal", explanation: "A floating-point literal does not conform to the Vitte grammar for mantissas, separators, or exponents.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_LEXER_E_INVALID_CHARACTER_LITERAL", public_code: "E0111", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Lexer, category: "lexer", title: "malformed character literal", explanation: "A character literal must contain exactly one Unicode scalar value or one valid escape sequence.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_LEXER_E_INVALID_NUMERIC_SEPARATOR", public_code: "E0112", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Lexer, category: "lexer", title: "invalid numeric separator", explanation: "Digit separators must be single underscores placed between digits.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_LEXER_E_INVALID_NUMERIC_BASE", public_code: "E0113", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Lexer, category: "lexer", title: "invalid integer base or digit", explanation: "A based integer is missing digits or contains a digit that is not valid in its base.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_LEXER_E_INVALID_NUMERIC_SUFFIX", public_code: "E0114", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Lexer, category: "lexer", title: "unsupported numeric suffix", explanation: "Vitte numeric literal forms do not define suffixes.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_LEXER_E_INVALID_EXPONENT", public_code: "E0115", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Lexer, category: "lexer", title: "malformed exponent", explanation: "A decimal exponent uses e or E and a hexadecimal exponent uses p or P; both require decimal digits.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_LEXER_E_INVALID_OPERATOR", public_code: "E0116", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Lexer, category: "lexer", title: "invalid or incomplete operator", explanation: "The punctuation sequence is not a supported Vitte operator; a multi-character operator may be incomplete or misspelled.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_EXPECTED_TOKEN", public_code: "E0201", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "expected token", explanation: "The parser expected a token required by the Vitte grammar.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_UNEXPECTED_TOKEN", public_code: "E0202", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "unexpected token", explanation: "The current token is not valid in this syntactic position.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_EXPECTED_EXPRESSION", public_code: "E0203", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "expected expression", explanation: "The grammar requires an expression at this location.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_EXPECTED_DECLARATION", public_code: "E0204", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "expected declaration", explanation: "The grammar requires a declaration at this location.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_EXPECTED_TYPE", public_code: "E0205", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "expected type", explanation: "The grammar requires a type expression at this location.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_EXPECTED_PATTERN", public_code: "E0206", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "expected pattern", explanation: "The grammar requires a pattern at this location.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_UNCLOSED_DELIMITER", public_code: "E0207", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "unclosed delimiter", explanation: "An opening delimiter has no corresponding closing delimiter.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_MISMATCHED_DELIMITER", public_code: "E0208", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "mismatched delimiter", explanation: "A closing delimiter does not match the corresponding opening delimiter.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_MODIFIER", public_code: "E0209", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "invalid declaration modifier", explanation: "A declaration modifier is not permitted in this syntactic context.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_UNSUPPORTED_SYNTAX", public_code: "E0210", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "unsupported syntax", explanation: "The parser recognized a syntactic position but does not support this source form.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_RESERVED_WORD_AS_NAME", public_code: "E0211", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "reserved word used as a name", explanation: "A reserved word cannot be used where the grammar requires an identifier.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_MODULE_PATH", public_code: "E0212", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed module path", explanation: "A module path must contain nonempty identifier segments separated by `::` or `/`; a separator cannot be first, repeated or final.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_DUPLICATE_MODULE_HEADER", public_code: "E0213", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "duplicate module header", explanation: "A source file may declare at most one top-level module header with `space path`.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_MISPLACED_MODULE_HEADER", public_code: "E0214", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "misplaced module header", explanation: "A top-level module header must appear before imports and other declarations.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_USE_DECLARATION", public_code: "E0215", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed use declaration", explanation: "A `use` declaration requires a module path followed by an optional alias, terminal glob, or nonempty grouped import, and must end with `;`.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_USE_ALIAS", public_code: "E0216", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "invalid import alias", explanation: "The `as` clause in a use declaration must be followed by an identifier.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_IMPORT_GROUP", public_code: "E0217", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed import group", explanation: "A grouped import must contain comma-separated paths, may nest groups after a path, and must close every opening brace.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_GLOB_IMPORT", public_code: "E0218", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "invalid glob import", explanation: "A glob import uses terminal `::*`; it cannot appear inside a group or be followed by an alias or another path segment.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_EXPORT_CLAUSE", public_code: "E0219", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed export clause", explanation: "An export clause must be `export path [as name];`, `export { paths };`, or `export *;`.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_EMPTY_EXPORT_GROUP", public_code: "E0220", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "empty export group", explanation: "An export group must contain at least one path to re-export.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_EXPORT_ALIAS", public_code: "E0221", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "invalid export alias", explanation: "The `as` clause in an export must be followed by an identifier.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_TRAILING_TOKENS", public_code: "E0222", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "unexpected trailing tokens", explanation: "The declaration is complete, but extra tokens appear before its required terminator.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_MISSING_MODULE_HEADER", public_code: "E0223", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "missing module header", explanation: "A source file with a module import or export must begin with one top-level `space path;` header.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_VALUE_DECLARATION", public_code: "E0224", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed const or static declaration", explanation: "A `const` or `static` declaration requires a name, an optional type annotation, an initializer, and a terminating semicolon.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_MISSING_VALUE_INITIALIZER", public_code: "E0225", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "missing const or static initializer", explanation: "A `const` or `static` declaration must provide `= expression` after its name and optional type.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_TYPE_DECLARATION", public_code: "E0226", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed type declaration", explanation: "A type declaration requires a name, complete bounds and aliases, and a terminating semicolon.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_OPAQUE_DECLARATION", public_code: "E0227", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed opaque declaration", explanation: "An opaque declaration requires a name; an optional aliased type must follow `=`, and bounds are not allowed.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_FORM_DECLARATION", public_code: "E0228", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed form declaration", explanation: "A form declaration requires a name, braces, and fields written as `name: Type`.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_DUPLICATE_FORM_FIELD", public_code: "E0229", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "duplicate form field", explanation: "Field names must be unique within a form declaration.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_FORM_FIELD_SEPARATOR", public_code: "E0230", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "missing form field separator", explanation: "Adjacent form fields must be separated by a comma or semicolon.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_PICK_DECLARATION", public_code: "E0231", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed pick declaration", explanation: "A `pick` declaration needs a name, optional generic parameters and constraints, and a braced list of variants separated by commas.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_DUPLICATE_PICK_VARIANT", public_code: "E0232", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "duplicate pick variant", explanation: "Variant names must be unique within one pick declaration.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_PICK_VARIANT_PAYLOAD", public_code: "E0233", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "invalid pick variant payload", explanation: "A variant payload is an optional parenthesized, comma-separated list of types; an empty list is allowed.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_TRAIT_DECLARATION", public_code: "E0234", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed trait declaration", explanation: "A trait declaration needs a name, optional generic parameters and constraints, and a declaration block.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_IMPL_DECLARATION", public_code: "E0235", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed implementation declaration", explanation: "An implementation needs a target type or a trait type followed by `for` and a target type, then a declaration block.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_MISSING_IMPL_TARGET_TYPE", public_code: "E0236", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "missing implementation target type", explanation: "A trait implementation must provide a target type after `for`.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_IMPL_FOR_CLAUSE", public_code: "E0237", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "invalid implementation `for` clause", explanation: "A trait implementation clause must contain one trait type, `for`, and one target type before its optional constraints and block.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_PROCEDURE_DECLARATION", public_code: "E0238", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed procedure declaration", explanation: "A procedure declaration needs a name, a parameter list, optional return type and constraints, and a valid body or terminator.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_PROCEDURE_PARAMETERS", public_code: "E0239", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed procedure parameter list", explanation: "Procedure parameters must be enclosed in parentheses and use comma-separated `pattern: Type` entries.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_PROCEDURE_RETURN_TYPE", public_code: "E0240", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "invalid procedure return type", explanation: "A return arrow must be followed by a valid type expression.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_PROCEDURE_MODIFIER", public_code: "E0241", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "invalid procedure modifier", explanation: "The `async`, `unsafe`, and `comptime` modifiers may appear once and apply only to procedure declarations.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_PROCEDURE_BODY_FORM", public_code: "E0242", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "invalid procedure body form", explanation: "A normal procedure ends with a block or semicolon; an external or intrinsic procedure must end with a semicolon and cannot have a body.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_EXTERNAL_PROCEDURE", public_code: "E0243", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed external procedure declaration", explanation: "An external procedure uses `extern`, an optional nonempty ABI string literal, a complete procedure signature, optional constraints, and a terminating semicolon.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_INTRINSIC_DECLARATION", public_code: "E0244", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed intrinsic declaration", explanation: "An intrinsic declaration requires a name, a complete signature and constraints, and a terminating semicolon; it has no ABI string or body.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_ABI_STRING_LITERAL", public_code: "E0245", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "invalid ABI string literal", explanation: "An ABI literal after `extern` must be a nonempty string literal naming the calling convention.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_GENERIC_PARAMETER_LIST", public_code: "E0246", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed generic parameter list", explanation: "A generic parameter list uses angle brackets and comma-separated parameters, with an optional trailing comma.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_CONST_GENERIC_PARAMETER", public_code: "E0247", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed const generic parameter", explanation: "A const generic parameter requires an identifier and may have one or more type bounds.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_GENERIC_BOUND", public_code: "E0248", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed generic bound", explanation: "A generic bound after `:` or `+` must be a valid type expression.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_WHERE_CLAUSE", public_code: "E0249", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed where clause", explanation: "A where clause requires one or more valid comma-separated bounds or relational predicates.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_REQUIRES_CLAUSE", public_code: "E0250", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed requires clause", explanation: "A requires clause needs an expression followed by a semicolon.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_ENSURES_CLAUSE", public_code: "E0251", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed ensures clause", explanation: "An ensures clause needs an expression followed by a semicolon.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_MACRO_DECLARATION", public_code: "E0252", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed macro declaration", explanation: "A macro declaration requires a name, an optional typed parameter list, and a body.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_MACRO_PARAMETERS", public_code: "E0253", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed macro parameter list", explanation: "Macro parameters must be enclosed in parentheses and use comma-separated `pattern: Type` entries.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_TEST_DECLARATION", public_code: "E0254", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed test declaration", explanation: "A test declaration accepts an optional identifier or string name followed by a body.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_DECLARATION_MODIFIER_ORDER", public_code: "E0255", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "invalid declaration modifier order or combination", explanation: "At most one visibility modifier (`pub` or prefix `export`) may precede a declaration and must come before procedure modifiers; visibility modifiers cannot be applied to export clauses.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_ATTRIBUTE", public_code: "E0256", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed attribute", explanation: "An attribute requires a bracketed name and balanced delimiters around any arguments.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_ATTRIBUTE_NAME", public_code: "E0257", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "missing or invalid attribute name", explanation: "An attribute name requires an identifier or keyword after `#[` or `#![` and after each `::`.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_ATTRIBUTE_ARGUMENTS", public_code: "E0258", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed attribute arguments", explanation: "Attribute arguments are comma-separated names or literals; a named argument uses `name = literal`.", deprecated: false },
