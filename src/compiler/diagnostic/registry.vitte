    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_ARRAY_TYPE", public_code: "E0267", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed array type", explanation: "An array type is `[Type; length]` or `[length] Type`, with a valid length expression, closing bracket and element type.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_SLICE_TYPE", public_code: "E0268", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed slice type", explanation: "A slice type is `[ElementType]` and requires a complete element type and closing bracket.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_OPTIONAL_TYPE", public_code: "E0269", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed optional type", explanation: "An optional type is `?Type` and requires a complete type after `?`.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_TYPE_PATH", public_code: "E0270", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed type path", explanation: "A type path uses nonempty identifier or permitted keyword segments separated by `::` or `/`; every separator must have a segment on both sides and a single `:` is not a path separator.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_GENERIC_ARGUMENTS", public_code: "E0271", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed generic arguments", explanation: "Generic argument lists use matching angle or square delimiters around zero or more comma-separated types; trailing commas are allowed.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_LET_STATEMENT", public_code: "E0272", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed let binding statement", explanation: "A `let` statement requires a binding pattern and `;`; its optional type and initializer must each be complete. If the initializer is omitted, semantic analysis requires a type to be inferable or explicitly annotated.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_SET_STATEMENT", public_code: "E0273", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed set statement", explanation: "A `set` statement requires an assignment target, a valid assignment operator, a complete value expression and a terminating `;`.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_ASSIGNMENT_OPERATOR", public_code: "E0274", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "invalid assignment operator", explanation: "Use one of `=`, `+=`, `-=`, `*=`, `/=`, `%=`, `&=`, `|=`, `^=`, `<<=` or `>>=` after the assignment target; comparison and arithmetic operators do not assign.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_RETURN_STATEMENT", public_code: "E0275", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed return statement", explanation: "A return statement may contain an expression and may omit its semicolon only when the expression is immediately followed by `}` or end of file; procedure placement is validated by semantic analysis.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_JUMP_STATEMENT", public_code: "E0276", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed jump statement", explanation: "`break` and `continue` statements require a terminating `;`; their placement inside a loop is validated by semantic analysis.", deprecated: false },
