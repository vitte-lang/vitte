    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_ASSERT_STATEMENT", public_code: "E0278", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed assert statement", explanation: "An assert statement accepts `assert(expression);` or `assert expression;` and requires a complete condition and final semicolon.", deprecated: false },
