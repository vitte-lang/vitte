    DiagnosticRegistryEntry { internal_code: "VITTE_BACKEND_E_UNSUPPORTED", public_code: "E0903", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.C17Backend, category: "backend", title: "unsupported backend construct", explanation: "The selected C17 backend does not support this lowered construct.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_BACKEND_E_EXTERNAL_COMPILER", public_code: "E0904", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.CCompiler, category: "backend", title: "external C compiler failure", explanation: "The generated C source was rejected by the external C compiler.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_BACKEND_E_SOURCE_MAP", public_code: "E0905", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.C17Backend, category: "source-map", title: "backend source mapping failure", explanation: "Generated C could not be mapped accurately to the originating Vitte source.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_BACKEND_E_OUTPUT", public_code: "E0906", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Io, category: "backend", title: "C17 output failure", explanation: "The C17 backend could not create, write, or close an output file.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_BACKEND_E_LINK", public_code: "E0907", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Linker, category: "linker", title: "native linking failure", explanation: "The generated object could not be linked into the requested executable.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_BACKEND_E_EXECUTION", public_code: "E0908", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Runtime, category: "runtime", title: "compiled program execution failure", explanation: "The generated program was compiled and linked, but exited unsuccessfully.", deprecated: false },
