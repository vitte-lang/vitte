    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_COALESCING_EXPRESSION", public_code: "E0287", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed coalescing expression", explanation: "A coalescing expression uses `left ?? fallback` and requires a complete expression on both sides.", deprecated: false },
