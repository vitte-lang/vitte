    DiagnosticRegistryEntry { internal_code: "VITTE_WARNING_INFRASTRUCTURE", public_code: "W0090", default_severity: DiagnosticSeverity.Warning, origin: DiagnosticOrigin.Driver, category: "compiler", title: "compiler infrastructure warning", explanation: "A non-fatal compiler or source I/O operation did not complete cleanly.", deprecated: false },
];

export type DiagnosticRegistryVisitor = proc(
    registry_entry: *const DiagnosticRegistryEntry,
    index: usize,
    user_data: *mut u8
) -> bool;

const REGISTRY_FNV_OFFSET: u64 = 14695981039346656037;
const REGISTRY_FNV_PRIME: u64 = 1099511628211;
const REGISTRY_INDEX_NONE: usize = usize.MAX;

proc registry_text_hash(hash: u64, text: string) -> u64 {
    let mut result = hash;
    let bytes: [u8] = text.bytes();
    let mut index: usize = 0;
    while index < bytes.len() {
        set result = (result ^ (bytes[index] as u64)) * REGISTRY_FNV_PRIME;
        set index += 1;
    }
    return (result ^ 0) * REGISTRY_FNV_PRIME;
}

proc registry_origin_is_valid(origin: DiagnosticOrigin) -> bool {
    return origin >= DiagnosticOrigin.Unknown and origin <= DiagnosticOrigin.Internal;
}

proc registry_severity_is_valid(severity: DiagnosticSeverity) -> bool {
    return severity >= DiagnosticSeverity.Note and severity <= DiagnosticSeverity.Fatal;
}

proc registry_parse_public_code(
    public_code: string,
    prefix: *mut i8,
    number: *mut u32
) -> bool {
    let bytes: [u8] = public_code.bytes();
    if bytes.len() != VITTE_DIAGNOSTIC_PUBLIC_CODE_LENGTH { return false; }
    let first = bytes[0];
    if first != ('E' as u8) and first != ('W' as u8) and
       first != ('N' as u8) and first != ('H' as u8) { return false; }
    let mut value: u32 = 0;
    let mut index: usize = 1;
    while index < bytes.len() {
        let digit = bytes[index];
        if digit < ('0' as u8) or digit > ('9' as u8) { return false; }
        value = value * 10 + ((digit - ('0' as u8)) as u32);
        set index += 1;
    }
    if prefix != null { set *prefix = first as i8; }
    if number != null { set *number = value; }
    return true;
}

proc registry_origin_matches_range(entry_value: *const DiagnosticRegistryEntry) -> bool {
    if entry_value == null { return false; }
    let range = vitte_diagnostic_registry_range((*entry_value).public_code);
    if range == DiagnosticRegistryRange.Lexer { return (*entry_value).origin == DiagnosticOrigin.Lexer; }
    if range == DiagnosticRegistryRange.Parser { return (*entry_value).origin == DiagnosticOrigin.Parser; }
    if range == DiagnosticRegistryRange.Module { return (*entry_value).origin == DiagnosticOrigin.Import; }
    if range == DiagnosticRegistryRange.Backend {
        return (*entry_value).origin == DiagnosticOrigin.C17Backend or
            (*entry_value).origin == DiagnosticOrigin.CCompiler or
            (*entry_value).origin == DiagnosticOrigin.Io or
            (*entry_value).origin == DiagnosticOrigin.Linker or
            (*entry_value).origin == DiagnosticOrigin.Runtime;
    }
    if range == DiagnosticRegistryRange.Ir {
        return (*entry_value).origin == DiagnosticOrigin.Ir or
            (*entry_value).origin == DiagnosticOrigin.Hir;
    }
    return true;
}

export proc vitte_diagnostic_registry_count() -> usize {
    return DIAGNOSTIC_REGISTRY.len();
}

export proc vitte_diagnostic_registry_at(index: usize) -> *const DiagnosticRegistryEntry {
    if index >= DIAGNOSTIC_REGISTRY.len() { return null; }
    return &DIAGNOSTIC_REGISTRY[index];
}

export proc vitte_diagnostic_registry_entries(count: *mut usize) -> *const DiagnosticRegistryEntry {
    if count != null { set *count = DIAGNOSTIC_REGISTRY.len(); }
    return &DIAGNOSTIC_REGISTRY[0];
}

export proc vitte_diagnostic_registry_find_internal(internal_code: string) -> *const DiagnosticRegistryEntry {
    if internal_code.len() == 0 { return null; }
    let mut index: usize = 0;
    while index < DIAGNOSTIC_REGISTRY.len() {
        if DIAGNOSTIC_REGISTRY[index].internal_code == internal_code {
            return &DIAGNOSTIC_REGISTRY[index];
        }
        set index += 1;
    }
    return null;
}

export proc vitte_diagnostic_registry_find_public(public_code: string) -> *const DiagnosticRegistryEntry {
    if public_code.len() == 0 { return null; }
    let mut index: usize = 0;
    while index < DIAGNOSTIC_REGISTRY.len() {
        if DIAGNOSTIC_REGISTRY[index].public_code == public_code {
            return &DIAGNOSTIC_REGISTRY[index];
        }
        set index += 1;
    }
    return null;
}

export proc vitte_diagnostic_registry_find(code: string) -> *const DiagnosticRegistryEntry {
    let internal = vitte_diagnostic_registry_find_internal(code);
    if internal != null { return internal; }
    return vitte_diagnostic_registry_find_public(code);
}

export proc vitte_diagnostic_registry_contains(code: string) -> bool {
    return vitte_diagnostic_registry_find(code) != null;
}

export proc vitte_diagnostic_registry_public_code_is_valid(public_code: string) -> bool {
    return registry_parse_public_code(public_code, null, null);
}

export proc vitte_diagnostic_registry_public_number(public_code: string, number: *mut u32) -> bool {
    return registry_parse_public_code(public_code, null, number);
}

export proc vitte_diagnostic_registry_public_prefix(public_code: string) -> i8 {
    let mut prefix: i8 = 0;
    if not registry_parse_public_code(public_code, &mut prefix, null) { return 0; }
    return prefix;
}

export proc vitte_diagnostic_registry_range(public_code: string) -> DiagnosticRegistryRange {
    let mut prefix: i8 = 0;
    let mut number: u32 = 0;
    if not registry_parse_public_code(public_code, &mut prefix, &mut number) {
        return DiagnosticRegistryRange.Unknown;
    }
    if prefix == ('W' as i8) { return DiagnosticRegistryRange.Warning; }
    if prefix == ('N' as i8) { return DiagnosticRegistryRange.Note; }
    if prefix == ('H' as i8) { return DiagnosticRegistryRange.Help; }
    if prefix != ('E' as i8) { return DiagnosticRegistryRange.Unknown; }
    if number <= 99 { return DiagnosticRegistryRange.Infrastructure; }
    if number <= 199 { return DiagnosticRegistryRange.Lexer; }
    if number <= 299 { return DiagnosticRegistryRange.Parser; }
    if number <= 399 { return DiagnosticRegistryRange.Module; }
    if number <= 499 { return DiagnosticRegistryRange.Name; }
    if number <= 599 { return DiagnosticRegistryRange.Type; }
    if number <= 699 { return DiagnosticRegistryRange.Call; }
    if number <= 799 { return DiagnosticRegistryRange.Contract; }
    if number <= 899 { return DiagnosticRegistryRange.Generic; }
    if number <= 999 { return DiagnosticRegistryRange.Backend; }
    if number <= 1099 { return DiagnosticRegistryRange.Ir; }
    if number <= 1199 { return DiagnosticRegistryRange.ControlFlow; }
    if number <= 1299 { return DiagnosticRegistryRange.Memory; }
    if number <= 1399 { return DiagnosticRegistryRange.Unsafe; }
    if number <= 1499 { return DiagnosticRegistryRange.Ffi; }
    if number <= 1599 { return DiagnosticRegistryRange.ConstEval; }
    if number <= 1699 { return DiagnosticRegistryRange.Pattern; }
    if number <= 1799 { return DiagnosticRegistryRange.Concurrency; }
    if number <= 1899 { return DiagnosticRegistryRange.Macro; }
    if number <= 1999 { return DiagnosticRegistryRange.Target; }
    return DiagnosticRegistryRange.Unknown;
}

export proc vitte_diagnostic_registry_range_name(range: DiagnosticRegistryRange) -> string {
    match range {
        case DiagnosticRegistryRange.Unknown => "unknown";
        case DiagnosticRegistryRange.Infrastructure => "infrastructure";
        case DiagnosticRegistryRange.Lexer => "lexer";
        case DiagnosticRegistryRange.Parser => "parser";
        case DiagnosticRegistryRange.Module => "module";
        case DiagnosticRegistryRange.Name => "name-resolution";
        case DiagnosticRegistryRange.Type => "type";
        case DiagnosticRegistryRange.Call => "call";
        case DiagnosticRegistryRange.Contract => "contract";
        case DiagnosticRegistryRange.Generic => "generic";
        case DiagnosticRegistryRange.Backend => "backend";
        case DiagnosticRegistryRange.Ir => "ir";
        case DiagnosticRegistryRange.ControlFlow => "control-flow";
        case DiagnosticRegistryRange.Memory => "memory";
        case DiagnosticRegistryRange.Unsafe => "unsafe";
        case DiagnosticRegistryRange.Ffi => "ffi";
        case DiagnosticRegistryRange.ConstEval => "const-eval";
        case DiagnosticRegistryRange.Pattern => "pattern";
        case DiagnosticRegistryRange.Concurrency => "concurrency";
        case DiagnosticRegistryRange.Macro => "macro";
        case DiagnosticRegistryRange.Target => "target";
        case DiagnosticRegistryRange.Warning => "warning";
        case DiagnosticRegistryRange.Note => "note";
        case DiagnosticRegistryRange.Help => "help"
    }
}

export proc vitte_diagnostic_registry_range_is_valid(range: DiagnosticRegistryRange) -> bool {
    return range > DiagnosticRegistryRange.Unknown and range <= DiagnosticRegistryRange.Help;
}

proc registry_range_boundary(range: DiagnosticRegistryRange, number: *mut u32, is_end: bool) -> bool {
    if range <= DiagnosticRegistryRange.Unknown or range > DiagnosticRegistryRange.Target or number == null {
        return false;
    }
    let begin = ((range as u32) - 1) * VITTE_DIAGNOSTIC_RANGE_WIDTH;
    set *number = if is_end { begin + VITTE_DIAGNOSTIC_RANGE_WIDTH - 1 } else { begin };
    return true;
}

export proc vitte_diagnostic_registry_range_begin(range: DiagnosticRegistryRange, number: *mut u32) -> bool {
    return registry_range_boundary(range, number, false);
}

export proc vitte_diagnostic_registry_range_end(range: DiagnosticRegistryRange, number: *mut u32) -> bool {
    return registry_range_boundary(range, number, true);
}

export proc vitte_diagnostic_registry_public_severity(
    public_code: string,
    severity: *mut DiagnosticSeverity
) -> bool {
    let prefix = vitte_diagnostic_registry_public_prefix(public_code);
    if prefix == 0 { return false; }
    if severity != null {
        if prefix == ('E' as i8) { set *severity = DiagnosticSeverity.Error; }
        elif prefix == ('W' as i8) { set *severity = DiagnosticSeverity.Warning; }
        elif prefix == ('N' as i8) { set *severity = DiagnosticSeverity.Note; }
        else { set *severity = DiagnosticSeverity.Help; }
    }
    return true;
}

export proc vitte_diagnostic_registry_count_severity(severity: DiagnosticSeverity) -> usize {
    if not registry_severity_is_valid(severity) { return 0; }
    let mut count: usize = 0;
    let mut index: usize = 0;
    while index < DIAGNOSTIC_REGISTRY.len() {
        if DIAGNOSTIC_REGISTRY[index].default_severity == severity { set count += 1; }
        set index += 1;
    }
    return count;
}

export proc vitte_diagnostic_registry_count_origin(origin: DiagnosticOrigin) -> usize {
    if not registry_origin_is_valid(origin) { return 0; }
    let mut count: usize = 0;
    let mut index: usize = 0;
    while index < DIAGNOSTIC_REGISTRY.len() {
        if DIAGNOSTIC_REGISTRY[index].origin == origin { set count += 1; }
        set index += 1;
    }
    return count;
}

export proc vitte_diagnostic_registry_count_category(category: string) -> usize {
    if category.len() == 0 { return 0; }
    let mut count: usize = 0;
    let mut index: usize = 0;
    while index < DIAGNOSTIC_REGISTRY.len() {
        if DIAGNOSTIC_REGISTRY[index].category == category { set count += 1; }
        set index += 1;
    }
    return count;
}

export proc vitte_diagnostic_registry_entry_is_valid(entry_value: *const DiagnosticRegistryEntry) -> bool {
    if entry_value == null { return false; }
    let registry_entry = *entry_value;
    if registry_entry.internal_code.len() == 0 or registry_entry.category.len() == 0 or
       registry_entry.title.len() == 0 or registry_entry.explanation.len() == 0 or
       not registry_severity_is_valid(registry_entry.default_severity) or
       not registry_origin_is_valid(registry_entry.origin) { return false; }
    let mut prefix: i8 = 0;
    if not registry_parse_public_code(registry_entry.public_code, &mut prefix, null) { return false; }
    if prefix == ('E' as i8) and registry_entry.default_severity != DiagnosticSeverity.Error and
       registry_entry.default_severity != DiagnosticSeverity.Fatal { return false; }
    if prefix == ('W' as i8) and registry_entry.default_severity != DiagnosticSeverity.Warning { return false; }
    if prefix == ('N' as i8) and registry_entry.default_severity != DiagnosticSeverity.Note { return false; }
    if prefix == ('H' as i8) and registry_entry.default_severity != DiagnosticSeverity.Help { return false; }
    return registry_origin_matches_range(entry_value);
}

export proc vitte_diagnostic_registry_validate(result: *mut DiagnosticRegistryValidation) -> Status {
    let mut local = DiagnosticRegistryValidation {
        valid: true,
        entry_count: DIAGNOSTIC_REGISTRY.len(),
        invalid_entry_count: 0,
        duplicate_internal_count: 0,
        duplicate_public_count: 0,
        first_invalid_index: REGISTRY_INDEX_NONE
    };
    let mut index: usize = 0;
    while index < DIAGNOSTIC_REGISTRY.len() {
        let registry_entry = &DIAGNOSTIC_REGISTRY[index];
        if not vitte_diagnostic_registry_entry_is_valid(registry_entry) {
            set local.invalid_entry_count += 1;
            if local.first_invalid_index == REGISTRY_INDEX_NONE { set local.first_invalid_index = index; }
            set local.valid = false;
        }
        let mut other: usize = 0;
        while other < index {
            if DIAGNOSTIC_REGISTRY[other].internal_code == (*registry_entry).internal_code {
                set local.duplicate_internal_count += 1;
                set local.valid = false;
                break;
            }
            set other += 1;
        }
        set other = 0;
        while other < index {
            if DIAGNOSTIC_REGISTRY[other].public_code == (*registry_entry).public_code {
                set local.duplicate_public_count += 1;
                set local.valid = false;
                break;
            }
            set other += 1;
        }
        set index += 1;
    }
    if result != null { set *result = local; }
    return if local.valid { Status.Ok } else { Status.ErrorInvalidState };
}

export proc vitte_diagnostic_registry_apply_entry(
    diagnostic_value: *mut Diagnostic,
    entry_value: *const DiagnosticRegistryEntry
) -> Status {
    if diagnostic_value == null or not vitte_diagnostic_registry_entry_is_valid(entry_value) {
        return Status.ErrorInvalidArgument;
    }
    set (*diagnostic_value).code = (*entry_value).internal_code;
    set (*diagnostic_value).short_code = (*entry_value).public_code;
    set (*diagnostic_value).severity = (*entry_value).default_severity;
    set (*diagnostic_value).origin = (*entry_value).origin;
    set (*diagnostic_value).category = (*entry_value).category;
    return Status.Ok;
}

export proc vitte_diagnostic_registry_apply(diagnostic_value: *mut Diagnostic) -> Status {
    if diagnostic_value == null { return Status.ErrorInvalidArgument; }
    let mut registry_entry = vitte_diagnostic_registry_find((*diagnostic_value).code);
    if registry_entry == null { registry_entry = vitte_diagnostic_registry_find((*diagnostic_value).short_code); }
    if registry_entry == null { return Status.ErrorInvalidArgument; }
    return vitte_diagnostic_registry_apply_entry(diagnostic_value, registry_entry);
}

export proc vitte_diagnostic_registry_entry_fingerprint(entry_value: *const DiagnosticRegistryEntry) -> u64 {
    if entry_value == null { return 0; }
    let registry_entry = *entry_value;
    let mut hash = REGISTRY_FNV_OFFSET;
    set hash = registry_text_hash(hash, registry_entry.internal_code);
    set hash = registry_text_hash(hash, registry_entry.public_code);
    set hash = registry_text_hash(hash, registry_entry.category);
    set hash = registry_text_hash(hash, registry_entry.title);
    set hash = registry_text_hash(hash, registry_entry.explanation);
    set hash = (hash ^ (registry_entry.default_severity as u64)) * REGISTRY_FNV_PRIME;
    set hash = (hash ^ (registry_entry.origin as u64)) * REGISTRY_FNV_PRIME;
    set hash = (hash ^ (if registry_entry.deprecated { 1 as u64 } else { 0 as u64 })) * REGISTRY_FNV_PRIME;
    return hash;
}

export proc vitte_diagnostic_registry_fingerprint() -> u64 {
    let mut hash = REGISTRY_FNV_OFFSET;
    let mut index: usize = 0;
    while index < DIAGNOSTIC_REGISTRY.len() {
        let registry_entry = &DIAGNOSTIC_REGISTRY[index];
        set hash = registry_text_hash(hash, (*registry_entry).internal_code);
        set hash = registry_text_hash(hash, (*registry_entry).public_code);
        set hash = registry_text_hash(hash, (*registry_entry).category);
        set hash = registry_text_hash(hash, (*registry_entry).title);
        set hash = registry_text_hash(hash, (*registry_entry).explanation);
        set hash = (hash ^ ((*registry_entry).default_severity as u64)) * REGISTRY_FNV_PRIME;
        set hash = (hash ^ ((*registry_entry).origin as u64)) * REGISTRY_FNV_PRIME;
        set hash = (hash ^ (if (*registry_entry).deprecated { 1 as u64 } else { 0 as u64 })) * REGISTRY_FNV_PRIME;
        set index += 1;
    }
    return hash;
}

export proc vitte_diagnostic_registry_visit(visitor: DiagnosticRegistryVisitor, user_data: *mut u8) -> usize {
    let mut visited: usize = 0;
    let mut index: usize = 0;
    while index < DIAGNOSTIC_REGISTRY.len() {
        set visited += 1;
        if not visitor(&DIAGNOSTIC_REGISTRY[index], index, user_data) { return visited; }
        set index += 1;
    }
    return visited;
}

/// Convenience classifiers matching the inline helpers in `registry.h`.
export proc vitte_diagnostic_registry_is_error_code(public_code: string) -> bool {
    return vitte_diagnostic_registry_public_prefix(public_code) == ('E' as i8);
}

export proc vitte_diagnostic_registry_is_warning_code(public_code: string) -> bool {
    return vitte_diagnostic_registry_public_prefix(public_code) == ('W' as i8);
}

export proc vitte_diagnostic_registry_is_note_code(public_code: string) -> bool {
    return vitte_diagnostic_registry_public_prefix(public_code) == ('N' as i8);
}

export proc vitte_diagnostic_registry_is_help_code(public_code: string) -> bool {
    return vitte_diagnostic_registry_public_prefix(public_code) == ('H' as i8);
}

/// Look up the registry registry_entry for a diagnostic's current code.
export proc vitte_diagnostic_registry_for_diagnostic(
    diagnostic_value: *const Diagnostic
) -> *const DiagnosticRegistryEntry {
    if diagnostic_value == null {
        return null;
    }

    if (*diagnostic_value).code != "" {
        let registry_entry = vitte_diagnostic_registry_find((*diagnostic_value).code);
        if registry_entry != null {
            return registry_entry;
        }
    }

    if (*diagnostic_value).short_code != "" {
        return vitte_diagnostic_registry_find((*diagnostic_value).short_code);
    }

    return null;
}

/// Compatibility names used by the Vitte explanation layer.
export proc diagnostic_registry_count() -> usize {
    return vitte_diagnostic_registry_count();
}

export proc diagnostic_registry_at(index: usize) -> *const DiagnosticRegistryEntry {
    return vitte_diagnostic_registry_at(index);
}

export proc diagnostic_registry_find(code: string) -> *const DiagnosticRegistryEntry {
    return vitte_diagnostic_registry_find(code);
}

export proc diagnostic_registry_range(code: string) -> DiagnosticRegistryRange {
    return vitte_diagnostic_registry_range(code);
}

export proc diagnostic_registry_range_name(range: DiagnosticRegistryRange) -> string {
    return vitte_diagnostic_registry_range_name(range);
}

export proc diagnostic_registry_count_severity(severity: DiagnosticSeverity) -> usize {
    return vitte_diagnostic_registry_count_severity(severity);
}

export proc diagnostic_registry_validate(
    result: *mut DiagnosticRegistryValidation
) -> Status {
    return vitte_diagnostic_registry_validate(result);
}

export proc diagnostic_registry_fingerprint() -> u64 {
    return vitte_diagnostic_registry_fingerprint();
}
