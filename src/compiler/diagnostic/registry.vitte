    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_PROCEDURE_TYPE", public_code: "E0264", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed procedure type", explanation: "A procedure type uses `proc(Type, Type)`, may name its parameters, and may add `-> ReturnType`; parameter types need commas and the list needs a closing `)`.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_REFERENCE_TYPE", public_code: "E0265", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed reference type", explanation: "A reference type is `&Type`, `&mut Type`, `ref Type` or `ref mut Type` and requires a complete pointee type.", deprecated: false },
