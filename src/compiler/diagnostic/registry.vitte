    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_ASM_STATEMENT", public_code: "E0280", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed assembly statement", explanation: "An assembly statement uses `asm(expression, ...);` or `asm(\"template\");`, with balanced delimiters and a terminating semicolon.", deprecated: false },
    DiagnosticRegistryEntry { internal_code: "VITTE_PARSER_E_INVALID_CONTROL_FLOW_STATEMENT", public_code: "E0281", default_severity: DiagnosticSeverity.Error, origin: DiagnosticOrigin.Parser, category: "syntax", title: "malformed control-flow statement", explanation: "If and elif require a condition and block; else must follow an if/elif chain and requires a block or chained conditional; while requires a condition and block; loop requires a block; for requires a pattern, `in`, an iterable and a block.", deprecated: false },
