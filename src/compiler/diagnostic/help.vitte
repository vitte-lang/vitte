const HELP_RULE_TEXTS: [string] = [
    "Capture the failing command and compiler version; this failure has no identified cause and needs a compiler bug report.",
    "Rerun with VITTE_BACKTRACE=1 and report the failing input, command and compiler version.",
    "Capture the violated invariant with VITTE_BACKTRACE=1; report the input that triggers this compiler defect.",
    "Capture the impossible state with VITTE_BACKTRACE=1 and include the smallest reproducing input in a compiler bug report.",
    "Check available memory and process resource limits; retry with fewer compilation jobs if the system is under memory pressure.",
    "Resolve the source path relative to the working directory and ensure that it names an existing, readable regular file.",
    "Save the source as UTF-8 and replace the invalid byte sequence at the reported offset.",
    "Register the original source before mapping its spans; preserve the generated file and source mapping in a compiler bug report.",
    "Report the diagnostic construction failure with its original message, source span and compiler version.",
    "Fix the first reported error before rerunning; later diagnostics were suppressed after the configured diagnostic limit was reached.",
    "Select terminal diagnostic output to inspect the formatting failure; report the failing output format and reproducing input.",
    "Correct the option named in the diagnostic and use `vitte --help` to verify its accepted values and combinations.",
    "Resolve the first diagnostic emitted by the failed compiler phase; if none was emitted, report the phase and reproducing command.",
    "Identify the unavailable compiler component or external tool from the reported cause and install, configure or report that component.",
    "The frontend API rejected this source without returning parser or semantic details. Run `vitte check FILE --diagnostic=terminal` to locate the source-level cause; if the CLI accepts the same file, reduce the input and report the API and compiler versions.",
    "Remove the invalid character or place it inside a quoted string when it is intended to be text.",
    "Close the string opened with `\"` before the line ends; escape a quote that belongs inside the string.",
    "Use `\\\\`, `\\'`, `\\\"`, `\\0`, `\\a`, `\\b`, `\\f`, `\\n`, `\\r`, `\\t`, `\\v`, `\\xNN` (2 hex digits), `\\uNNNN` (4), or `\\UNNNNNNNN` (8); escape the backslash when it is literal.",
    "Use digits valid for the literal's base and place separators only where the numeric grammar permits them; verify the prefix and suffix.",
    "Keep the integer magnitude within the supported u64 range [0, 18446744073709551615]; an explicitly annotated target type may impose a narrower range.",
    "Close the block comment opened with `/*` using `*/`, including each nested comment that remains open.",
    "Start the identifier with a permitted identifier-start character and remove characters that cannot occur in an identifier.",
    "Replace the malformed Unicode sequence with valid UTF-8 source text before compiling again.",
    "Use decimal digits or a `0b`, `0o` or `0x` prefix with valid digits; place underscores singly between digits and omit suffixes.",
    "Use a decimal mantissa with optional `e`/`E` exponent, or a hexadecimal mantissa with required `p`/`P` exponent.",
    "Put exactly one Unicode scalar value or one supported escape sequence between the single quotes.",
    "Place a single underscore between two digits; do not start, end, or repeat a separator.",
    "Use only `0`-`1` after `0b`, `0`-`7` after `0o`, and hexadecimal digits after `0x`; include at least one digit.",
    "Remove the suffix; Vitte numeric literals do not define integer or floating-point suffixes.",
    "After `e`/`E` or `p`/`P` and an optional sign, provide one or more decimal digits.",
    "Check the reported punctuation run against Vitte's operators; use the complete spelling such as `->`, `=>`, `==`, `!=`, `<=`, `>=`, `&&`, `||`, `??`, `::`, `..`, or the supported compound assignments.",
    "Insert the expected delimiter, keyword or syntactic element before the token reported as found.",
    "Remove the unexpected token or finish the preceding construct before beginning this one.",
    "Provide a valid expression at this position, such as a literal, visible name, call or other expression accepted by the grammar.",
    "Introduce a declaration at this position; move executable statements into a procedure or another context that accepts statements.",
    "Provide a valid type at this position, such as a primitive type or a visible declared type.",
    "Provide a pattern compatible with the matched value before the branch body.",
    "Close the opening delimiter with its matching closing delimiter before the enclosing construct ends.",
    "Replace the closing delimiter with the delimiter matching the relevant unclosed opener.",
    "Remove this modifier or apply it only to a declaration kind that accepts it.",
    "This token is recognized, but it has no supported grammar form here. Replace it with a construct valid in this position, or use a supported declaration such as `proc`, `form`, `pick`, `const`, or `type`.",
    "Rename this item; Vitte reserved words cannot be used as identifiers.",
    "Write each module path segment as an identifier and separate segments with `::` or `/`; remove leading, repeated or trailing separators.",
    "Keep one top-level `space path` header in this file and remove the duplicate declaration.",
    "Move `space path;` before the first import or other top-level declaration.",
    "Use `use path;`, `use path as alias;`, `use path::*;` or `use path::{item, nested::{item}};`, then terminate the declaration with `;`.",
    "Add an identifier after `as`, for example `use math::vector as vectors;`.",
    "Add comma-separated import paths, close every brace, and put nested groups after a path such as `ops::{arithmetic::{add, sub}}`.",
    "Place `::*` at the end of the import, for example `use math::*;`; remove any alias, group placement or following path segment.",
    "Use `export path [as alias];`, `export {path, other};` or `export *;` and remove extra tokens.",
    "Add at least one path inside the braces, for example `export {math::add};`.",
    "Add an identifier after `as`, for example `export math::add as add;`.",
    "Remove the extra token before the required semicolon or finish the clause in the form shown by the diagnostic.",
    "Add one top-level `space path;` declaration before the first module import or export clause.",
    "Give the declaration a name, put an optional type after `:`, add `= expression`, and finish with `;`.",
    "Add `= expression` after the name and optional type, for example `const LIMIT: int = 10;`.",
    "Complete the type name, each bound or aliased type, and the final `;`.",
    "Give the opaque type a name, use `= Type` for an optional alias, and omit bounds.",
    "Write a named form with `{}` and fields in the form `name: Type`.",
    "Rename this field; every field in one form must have a unique name.",
    "Separate fields with `,` or `;`, for example `form Point { x: int, y: int }`.",
    "Write a named pick with braces and comma-separated variants, for example `pick Option { None, Some(int) }`.",
    "Rename this variant; each variant name must be unique within its pick.",
    "Put valid comma-separated types inside the variant parentheses, for example `Some(int, string)`; `()` is also valid.",
    "Write `trait Name { ... }`, with optional generic parameters and a `where` clause before the block.",
    "Write an inherent implementation as `impl Type { ... }` or a trait implementation as `impl Trait for Type { ... }`.",
    "Add the type after `for`, for example `impl Display for Point { ... }`.",
    "Use one trait type, `for`, one target type, then an optional `where` clause and the implementation block.",
    "Write `proc name(parameters)`, then an optional `-> Type`, optional constraints, and a body or `;`.",
    "Enclose parameters in `(...)`; each parameter needs a pattern, `:`, a type, commas between entries, and a closing `)`.",
    "Put a valid type after `->`, for example `proc size() -> int;`.",
    "Use `async`, `unsafe` or `comptime` at most once and only before a procedure declaration.",
    "A normal procedure needs a block or `;`; an `extern` or `intrinsic` procedure must end with `;` and has no body.",
    "Write `extern [\"ABI\"] proc name(parameters) [-> Type] [where ...] [requires ...;] [ensures ...;];`, for example `extern \"C\" proc write(fd: i32, data: *const u8) -> isize;`.",
    "Write `intrinsic name(parameters) [-> Type] [where ...] [requires ...;] [ensures ...;];` without an ABI literal or body.",
    "Use a nonempty quoted ABI name after `extern`, for example `extern \"C\" proc write();`.",
    "Write `<T, U>` with comma-separated parameters and a closing `>`; a trailing comma is allowed.",
    "Write a const parameter as `const NAME`, optionally followed by a type bound, for example `const N: usize`.",
    "Add a valid type after `:` or `+`, for example `T: Display + Debug`.",
    "Write comma-separated predicates after `where`, for example `proc bounded<const N: usize>() where N > 0 { ... }`; give each predicate a valid relation and complete right-hand expression.",
    "Add a boolean expression and its semicolon, for example `proc positive(value: int) -> int requires value > 0; { return value; }`; `requires` checks callers before the body runs.",
    "Add a boolean expression and its semicolon, for example `proc positive(value: int) -> int ensures result >= 0; { return value; }`; `ensures` checks the result after return.",
    "Write `macro name` with an optional parameter list and a body, for example `macro log(value: string) { ... }`.",
    "Use `(...)` with comma-separated `pattern: Type` parameters and a closing `)`.",
    "Write `test { ... }`, `test test_name { ... }`, or `test \"description\" { ... }`.",
    "Use at most one visibility modifier (`pub` or prefix `export`) before procedure modifiers; write export clauses without declaration modifiers.",
    "Write an attribute as `#[name]` or `#![name]`; include the opening `[` and closing `]` and close any argument parentheses.",
    "Provide an identifier or keyword after `#[` or `#![` and after each `::` in a qualified attribute name.",
    "Use comma-separated names or literals in parentheses; write named arguments as `name = literal`.",
    "Add a literal after `=`, for example `#[cfg(enabled = true)]`.",
    "Use an integer, float, string, character, boolean, or `null` literal as the attribute value.",
    "Move this declaration to a declaration position, such as the top level or a trait/implementation declaration block.",
    "Move this statement into a block that accepts statements, such as a procedure body.",
    "Move this expression into a statement or expression context; declarations require a declaration position.",
    "Write `proc(Type, Type)`, optionally followed by `-> ReturnType`; separate parameters with commas and close the list with `)`.",
    "Write `&Type`, `&mut Type`, `ref Type` or `ref mut Type`, with a complete type after the reference marker.",
    "Write `*Type`, `*mut Type`, `*const Type`, `*volatile Type` or `*const volatile Type`; provide one complete pointee type.",
    "Write `[Type; length]` or `[length] Type`, with a valid length expression, closing `]` and element type.",
    "Write a slice as `[ElementType]` and include a complete element type before the closing `]`.",
    "Write `?Type` and put a complete type after `?`.",
    "Use nonempty path segments separated by `::` or `/`; use `::` instead of `:`, add a segment after every separator and remove repeated separators.",
    "Provide at least one comma-separated type in `<Type, Type>` or `[Type, Type]`; close the list with the matching `>` or `]`.",
    "Write `let [mut] pattern [: Type] [= expression];`. Add a type annotation when there is no initializer and the binding type cannot be inferred.",
    "Write `set target assignment_operator expression;` and provide a complete target, value and terminating semicolon.",
    "Use one of `=`, `+=`, `-=`, `*=`, `/=`, `%=`, `&=`, `|=`, `^=`, `<<=` or `>>=` after the assignment target.",
    "Write `return;` or `return expression;`. The final return in a block may omit `;` before `}` or end of file; procedure placement and return type are checked semantically.",
    "Write `break;` or `continue;` with a semicolon. A jump must appear inside a loop within a procedure.",
    "Write `defer { ... }` or `defer expression;`; the expression form requires its terminating semicolon.",
    "Write `assert(condition);` with a complete expression between matching parentheses and a final semicolon.",
    "Write `unsafe { ... }` and close the block with `}`.",
    "Write `asm(operand, ...);` or `asm(\"template\");`; close the operand list and terminate the statement with `;`.",
    "Use `if condition { ... } [elif condition { ... }]* [else { ... }]`, `while condition { ... }`, `loop { ... }`, or `for pattern in values { ... }`; put `else` after an if/elif chain and use it only before a block or chained conditional.",
    "Write a match statement with a subject and block bodies, for example `proc choose(option: Maybe) -> int { match option { case Maybe::Some(item) => { return item; }, case Maybe::None => { return 0; } } }`. Separate complete arms with commas.",
    "Write `[case] pattern [if guard] => body`, separate adjacent arms with commas, and use a complete expression, statement or block as the body.",
    "Use a path or binding, literal, `Path::Variant`, `Variant(pattern, ...)`, `Path { field: pattern, .. }`, `(pattern, ...)`, or `[pattern, ...]`; separate pattern items with commas.",
    "Write `lower..upper` or `lower..=upper`; both endpoints must be integer, float or character literals of the same kind.",
    "Write `target = value` or use a supported compound assignment operator; provide both a complete target and right-hand expression.",
    "Write `value ?? fallback` and provide a complete expression on both sides of `??`.",
    "Write both operands around `and`, `or`, `&&` or `||`; parenthesize nested conditions when needed.",
    "Write both operands around `&`, `|` or `^`; use a complete expression on each side.",
    "Write a complete left and right expression around `==`, `!=`, `<`, `<=`, `>` or `>=`.",
    "Write a value and shift count around `<<` or `>>`.",
    "Write complete operands around `+`, `-`, `*`, `/` or `%`; add parentheses to make grouping clear.",
    "Write `start..end` for an exclusive range or `start..=end` for an inclusive range, with a complete expression at each endpoint.",
    "Put one complete operand after the unary operator, for example `-value`, `not ready`, `&value` or `*pointer`.",
    "Write `value as Type` and provide a complete type after `as`.",
    "Complete the suffix: use `callee(arguments)`, `value[index]`, `value.field`, `value?`, or `Type { field: value }`; generic form and variant suffixes need nonempty, well-formed type arguments.",
    "Write `if condition { value } else { fallback }`; an if expression needs an else branch, and `elif` may continue the chain.",
    "Close the block with `}`; place complete statements before the optional final expression.",
    "Write `[]` or `[expression, ...]`; provide complete elements separated by commas and close the array with `]`.",
    "Change the import to match the resolved file's `space` declaration, or change that declaration to match the imported path.",
    "Check the exact module path and the search roots listed in the diagnostic; add the source file under one of those roots or correct the import.",
    "Import an exported symbol or change the declaration's visibility when external access is intentionally part of the module API.",
    "Break the reported import cycle by moving shared declarations into a module that does not depend back on either side of the cycle.",
    "Remove the repeated import. If two imports would bind different declarations to the same local name, give the imported items distinct aliases.",
    "Install the declared package into the project or user module directory, or add its package directory to `VITTE_MODULE_PATH`.",
    "Select a package version satisfying the declared constraint, or update the constraint after checking API compatibility.",
    "Preserve the import graph, failing validation detail and compiler version; this structural failure should be reported as a compiler defect.",
    "Write `sizeof(Type)` or `sizeof(expression)` with one complete operand and matching parentheses.",
    "Write `alignof(Type)` with a complete type and matching parentheses.",
    "Write `null()` or `null(expression, ...)` and close the argument list with `)`.",
    "Provide complete expressions separated by commas. A trailing comma is allowed, but empty items are invalid; a missing-comma insertion is suggested only when the next token clearly starts another item.",
    "Declare or import the unresolved name in this scope and verify its spelling against visible declarations.",
    "Rename this declaration or remove the earlier declaration with the same name in this scope.",
    "Use the candidate locations to identify the intended declaration. Replace conflicting glob imports with explicit grouped imports and distinct aliases, or qualify each use through its module.",
    "Add `pub` to the declaration in its defining module, or add `export name;` there if the symbol belongs in that module's API.",
    "Move the export clause to root or module scope. Inside a trait or impl, use `pub` on an individual declaration.",
    "Give every binding introduced by this pattern or declaration a distinct name.",
    "Export a declaration defined in this module. Re-exports are unsupported; add `pub` to the declaration in its defining module, then import it with `use module::{name};`.",
    "Make the expression and its consumer agree on a type. If the consumer's type is intended, produce or validate a value of that type; if the expression's type is intended, correct the declaration or operation that requires the other type. Convert only when the value and precision remain valid.",
    "Choose the intended type explicitly, for example `let count: i32 = 0;` for a signed count or `let count: usize = 0;` for an index, or provide an initializer with a uniquely known type.",
    "Use a conversion supported by both types; parse or format textual representations explicitly instead of relying on an unrelated cast.",
    "Call a procedure or callable value and check whether another declaration shadows the intended procedure.",
    "Use a value supporting indexed access or access this value through operations provided by its declared type.",
    "Use a member declared by the receiver's type and verify both the receiver type and member spelling.",
    "Change the type argument or implementation so that it satisfies the constraint named by the diagnostic.",
    "Provide the complete type definition before performing an operation that requires its size, layout or members.",
    "Break the recursive by-value type cycle with a supported indirection or redesign the recursive representation.",
    "Declare or import the type in this scope and verify the spelling and visibility of its declaration.",
    "Use a type name at this position instead of a value, variable or procedure name.",
    "Choose an operator defined for these operand types or explicitly convert the operands to compatible types.",
    "Assign only to a writable mutable location such as a mutable binding, field or index.",
    "Use an index of the type required by this collection and verify that the index expression represents an element position.",
    "Use a boolean condition, normally by writing an explicit comparison; Vitte does not infer truthiness from unrelated value types.",
    "Use this name in a type position, or construct a value with the type's supported constructor syntax.",
    "Compare this call with the procedure signature: add or remove arguments if the call is wrong, or change the parameter list if the declared API is wrong.",
    "Pass an expression satisfying the declared parameter type at this argument position.",
    "Compare the argument count and types with the available signatures and select a callable candidate that accepts them.",
    "Qualify the procedure or make argument types explicit so that exactly one callable candidate matches.",
    "Return an expression satisfying the procedure's declared result type or correct the result declaration when the API is wrong.",
    "Remove the incompatible call modifier or select a procedure supporting the required calling context.",
    "Place `return` inside a procedure body so it has a result to return.",
    "Use an irrefutable parameter binding such as `value: Type`; move refutable matching into the procedure body and use only a parameter mode documented by Vitte.",
    "Use a well-typed boolean expression that is valid in this contract's declaration context.",
    "Adjust the call arguments or caller state so the requires condition holds before entering the procedure.",
    "Correct the returned value or resulting state so every successful return satisfies the ensures condition.",
    "Restore the invariant before this program point and preserve it on every control-flow path reaching the check.",
    "Make the requires clause a boolean expression referring only to values available before the call.",
    "Make the ensures clause a boolean expression valid after the procedure has produced its result.",
    "`old(...)` needs a value captured at procedure entry. Entry-state snapshots are not available for this reference; remove it or express the condition using values supported by the contract.",
    "Use `result` only in a contract context where a procedure result exists.",
    "Provide the missing precondition or simplify the assertion so the checker has enough information to prove the required relationship.",
    "Remove or correct contradictory contract clauses so at least one valid program state can satisfy the contract.",
    "Move state changes and I/O out of the contract and compute the condition only from permitted side-effect-free values.",
    "Replace the call inside the contract with an operation permitted during contract evaluation.",
    "Align the implementation contract with the declared API: do not strengthen caller requirements or weaken promised results.",
    "Inspect the values reported by the failed runtime contract check and correct the caller or implementation violating the condition.",
    "Report the contract expression, reproducing input and compiler version because contract analysis failed internally.",
    "Choose a generic argument satisfying the named bound or provide the implementation required by that bound.",
    "Supply one type or value argument for every required generic parameter in declaration order.",
    "Match each supplied argument to the declared parameter kind and position; a type argument cannot fill a const parameter.",
    "Make the arguments agree on one concrete type for each generic parameter, or split the call into separately typed values.",
    "Implement the required trait for this type or use a type that already provides the required implementation.",
    "Disambiguate the trait relation so exactly one implementation matches the type and generic arguments.",
    "Remove or specialize the overlapping implementation so a trait/type relation resolves to exactly one implementation.",
    "Add the required method or associated member to this implementation, or provide a default in the trait.",
    "Match the trait member's name, parameter types, return type and allowed declaration form.",
    "Use `impl Trait for Type` for a trait implementation, or `impl Type` for an inherent implementation.",
    "Use a declared generic parameter on the left of `:` and one or more visible trait bounds on the right.",
    "Qualify the call through the intended trait or remove the competing visible method implementation.",
    "Preserve the generated C and the external compiler's first error, then report the Vitte construct that produced invalid C17.",
    "Reduce the failing construct to a reproducer and report the C17 lowering failure together with its backend detail.",
    "Rewrite the construct using features supported by the selected backend or select a backend that implements the required feature.",
    "Check the reported phase and command, identify the selected compiler (`CC` in native host-tools or `cc` on PATH in the bootstrap fallback), and confirm it accepts C17. Inspect its first output: errors in generated C may indicate a backend defect, while missing headers or SDK files are toolchain configuration issues.",
    "Preserve the generated C and original Vitte source together and report the incorrect source mapping.",
    "Choose a writable output path, check the parent directory permissions and available storage, then retry the output operation.",
    "Use the reported link command and first linker error to check the selected compiler driver (`CC` in native host-tools or `cc` on PATH in the bootstrap fallback), target format, SDK/sysroot, library search paths and required symbols. Keep link failures separate from C compilation errors.",
    "Inspect the generated program's exit status and runtime output; compilation and linking completed before this failure.",
    "Verify the selected C17 backend and its configuration values, then report the invalid option and reproducing command.",
    "Report the invalid IR instruction and its originating source because compiler-generated IR must satisfy the verifier.",
    "Report the source construct that failed IR lowering together with the failing phase and compiler version.",
    "Preserve the verifier's first invariant failure and the corresponding IR dump in a compiler bug report.",
    "Use a source construct supported by the IR lowerer or select a compilation path that implements this valid construct.",
    "Report the invalid HIR construct and its originating source so frontend lowering can be corrected.",
    "Report the source construct and compiler version; the native frontend failed while building or validating its high-level representation.",
    "Use a source construct supported by the HIR lowerer or select a compilation path that implements this valid construct.",
    "Add `return` with a value satisfying the declared result type on every reachable path, including fallthrough.",
    "Place `break` inside a loop body to exit that loop.",
    "Place `continue` inside a loop body to start its next iteration.",
    "Correct the preceding branch, termination or control-flow condition so this operation is reachable when it is intended to execute.",
    "Keep deferred work within its enclosing scope: remove `return`, `break`, `continue`, early-exit `?`, and nested `defer` from the deferred action.",
    "Verify that the referenced allocation remains alive and that the accessed range lies inside the allocation.",
    "Handle the null case before dereferencing or provide a valid initialized reference.",
    "Use a pointer to the required pointee type and verify the pointee representation before performing an explicit conversion.",
    "Allocate or offset the storage so the accessed value satisfies the required alignment.",
    "Keep the referenced value alive for at least as long as the reference, and use a direct local or parameter borrow whose origin the bootstrap can track.",
    "End the existing borrow before creating an overlapping exclusive reference; use shared references only when no mutation is required.",
    "Wait until the incompatible reference is no longer used, or access the value through the active reference with its permitted mutability.",
    "End every reference to the value before moving it, or move a different local value that is not currently borrowed.",
    "Initialize the binding again before using it, or remove the move if the original value is still needed.",
    "Review the operation's documented safety requirements and prove each invariant at this call site. Prefer a safe API when it provides the needed behavior; mark a context unsafe only when the caller can uphold those requirements.",
    "Match assembly instructions, operands and constraints to the selected target architecture.",
    "Use the intrinsic's required argument types and compile-time values on a target that supports the intrinsic.",
    "Choose an ABI supported by this target and match the foreign declaration's calling convention.",
    "Use a foreign-compatible representation and explicitly marshal values whose Vitte representation cannot cross the foreign interface.",
    "Match the foreign variadic signature and apply the ABI-required argument promotions to every trailing argument.",
    "Match the link name to the actual exported foreign symbol and remove conflicting foreign declarations.",
    "Replace runtime-dependent values with compile-time constants or move this computation out of the constant-evaluation context.",
    "This compile-time arithmetic operation overflows `i64` in the underlined expression. Reduce the operands or use a wider representable type.",
    "The divisor of this compile-time division evaluates to zero in the underlined expression. Change the divisor or guard the operation.",
    "Break the constant dependency cycle by giving at least one value an independent initializer.",
    "Reduce compile-time recursion or work and verify termination before increasing an evaluation limit.",
    "The divisor of this compile-time remainder evaluates to zero in the underlined expression. Change the divisor or guard the operation.",
    "Add an arm for each listed missing variant or representative uncovered pattern, or use an unguarded `_` arm when all remaining values should be handled uniformly.",
    "Remove the already covered pattern or place a more specific pattern before the branch that subsumes it.",
    "Use a pattern compatible with the scrutinee type and correct incompatible variants or literals.",
    "Make every alternative introduce the same binding names with compatible binding types.",
    "Move the asynchronous operation into a compatible async procedure or use the supported synchronous operation.",
    "Await a task-compatible result instead of an already computed ordinary value.",
    "Transfer an owned send-compatible value or use a supported synchronization mechanism between concurrent tasks.",
    "Move the forbidden blocking or suspending operation outside the critical section.",
    "Correct the macro arguments or expansion so it produces syntax valid at this invocation site.",
    "Break recursive macro expansion or reduce its nesting before increasing any expansion limit.",
    "Capture the failing compiler pass, its input and compiler version in a compiler bug report.",
    "Preserve the representation immediately before and after the failing pass together with the verifier's first error.",
    "Compare the requested triple with the reported host architecture, platform and pointer width. Check the selected compiler's default target (for example with `-dumpmachine`) and its SDK/sysroot; this C17 path does not forward `--target`.",
    "Compare the requested architecture with the target triple and the compiler's default target. Select a compiler configured for that architecture only when the backend can pass or otherwise honor the target.",
    "Check the requested CPU feature against the selected architecture and compiler version; remove only a feature confirmed unavailable or choose a toolchain that supports it.",
    "Compare the requested pointer width with the width supported by this compilation mode and with FFI declarations. Use a target-aware backend when the requested width differs from the host build.",
    "Check the target byte order reported by the toolchain and the operation's documented support. Preserve the source representation and inspect target-specific behavior before changing code.",
    "Remove the unused local binding or use its value in the computation that requires it.",
    "Use the parameter in the procedure body or remove it and update callers when it is not part of the required API.",
    "Remove the import when no declaration from it is required.",
    "Handle the returned value, including any error result, before discarding it intentionally.",
    "Replace the deprecated declaration with its documented successor.",
    "Remove statements after the unconditional exit or correct the control flow that makes them unreachable.",
    "Rename the inner binding when hiding the outer declaration is unintended.",
    "Verify that the implicit conversion preserves the intended value; use compatible types or a deliberate checked conversion.",
    "Verify the source value's range before conversion and use a wider representation when significant information would be lost.",
    "Check for negative or out-of-range values before changing signedness.",
    "Remove the cast because the expression already has the requested type.",
    "Remove the redundant condition or correct the expression that makes its result constant.",
    "Review the earlier arm or narrow this pattern so the same value is not handled by both arms.",
    "Check both operands and the comparison operator for a copied name, incompatible range or unintended comparison.",
    "Use a stable foreign representation and verify field offsets, size and alignment against the foreign declaration.",
    "Keep the runtime contract check or provide enough constraints for the compiler to prove the condition statically.",
    "Inspect the reported I/O or compiler operation and restore the required resource before relying on its output.",
];

form HelpExpectedTokens {
    valid: bool,
    expected: string,
    found: string
}

proc help_text_present(text: string) -> bool {
    return text.len() != 0;
}

proc help_ascii_lower(value: u8) -> u8 {
    if value >= 65 as u8 and value <= 90 as u8 {
        return value + 32 as u8;
    }
    return value;
}

proc help_ascii_equal(left: string, right: string) -> bool {
    let left_bytes: [u8] = left.bytes();
    let right_bytes: [u8] = right.bytes();
    if left_bytes.len() != right_bytes.len() {
        return false;
    }
    let mut index: usize = 0;
    while index < left_bytes.len() {
        if help_ascii_lower(left_bytes[index]) !=
           help_ascii_lower(right_bytes[index]) {
            return false;
        }
        set index += 1;
    }
    return true;
}

proc help_rule_index(code: string) -> usize {
    let mut index: usize = 0;
    while index < HELP_RULE_CODES.len() {
        if help_ascii_equal(HELP_RULE_CODES[index], code) {
            return index;
        }
        set index += 1;
    }
    return HELP_RULE_CODES.len();
}

proc help_explicit_annotation(
    diagnostic_value: *const Diagnostic
) -> string {
    if diagnostic_value == null {
        return "";
    }
    let mut index: usize = 0;
    while index < diagnostic_value.annotations.len() {
        let annotation: &DiagnosticAnnotation = &diagnostic_value.annotations[index];
        if annotation.kind == DiagnosticAnnotationKind.Help and
           help_text_present(annotation.message) {
            return annotation.message;
        }
        set index += 1;
    }
    return "";
}

proc help_copy_to_buffer(
    buffer: *mut u8,
    capacity: usize,
    text: string
) -> bool {
    if buffer == null or capacity == 0 {
        return false;
    }

    let bytes: [u8] = text.bytes();
    let mut length: usize = bytes.len();
    if length >= capacity {
        set length = capacity - 1;
        while length > 0 and length < bytes.len() and
              bytes[length] >= 128 as u8 and
              bytes[length] <= 191 as u8 {
            set length -= 1;
        }
    }

    let mut index: usize = 0;
    while index < length {
        set buffer[index as i64] = bytes[index];
        set index += 1;
    }
    set buffer[length as i64] = 0 as u8;
    return length != 0;
}

proc help_quote_fragment(text: string, maximum: usize) -> string {
    if not help_text_present(text) {
        return "";
    }

    let bytes: [u8] = text.bytes();
    let mut output = "`";
    let mut index: usize = 0;
    let mut written: usize = 0;

    while index < bytes.len() and written < maximum {
        let byte: u8 = bytes[index];

        if byte < 32 as u8 or byte == 127 as u8 {
            set index += 1;
            continue;
        }

        if byte == 96 as u8 {
            set output += "\\`";
            set written += 1;
            set index += 1;
            continue;
        }

        let mut width: usize = 1;
        if byte >= 194 as u8 and byte <= 223 as u8 and
           index + 1 < bytes.len() {
            set width = 2;
        } else if byte >= 224 as u8 and byte <= 239 as u8 and
                  index + 2 < bytes.len() {
            set width = 3;
        } else if byte >= 240 as u8 and byte <= 244 as u8 and
                  index + 3 < bytes.len() {
            set width = 4;
        }

        if written + width > maximum {
            break;
        }

        set output += text.slice(index, index + width);
        set written += width;
        set index += width;
    }

    if index < bytes.len() {
        set output += "…";
    }

    set output += "`";
    return output;
}

proc help_utf8_valid(text: string) -> bool {
    let bytes: [u8] = text.bytes();
    let mut index: usize = 0;

    while index < bytes.len() {
        let first = bytes[index];
        let mut width: usize = 0;

        if first <= 127 as u8 {
            set width = 1;
        } else if first >= 194 as u8 and first <= 223 as u8 {
            if index + 1 >= bytes.len() or
               bytes[index + 1] < 128 as u8 or
               bytes[index + 1] > 191 as u8 {
                return false;
            }
            set width = 2;
        } else if first == 224 as u8 {
            if index + 2 >= bytes.len() or
               bytes[index + 1] < 160 as u8 or
               bytes[index + 1] > 191 as u8 or
               bytes[index + 2] < 128 as u8 or
               bytes[index + 2] > 191 as u8 {
                return false;
            }
            set width = 3;
        } else if (first >= 225 as u8 and first <= 236 as u8) or
                  (first >= 238 as u8 and first <= 239 as u8) {
            if index + 2 >= bytes.len() or
               bytes[index + 1] < 128 as u8 or
               bytes[index + 1] > 191 as u8 or
               bytes[index + 2] < 128 as u8 or
               bytes[index + 2] > 191 as u8 {
                return false;
            }
            set width = 3;
        } else if first == 237 as u8 {
            if index + 2 >= bytes.len() or
               bytes[index + 1] < 128 as u8 or
               bytes[index + 1] > 159 as u8 or
               bytes[index + 2] < 128 as u8 or
               bytes[index + 2] > 191 as u8 {
                return false;
            }
            set width = 3;
        } else if first == 240 as u8 {
            if index + 3 >= bytes.len() or
               bytes[index + 1] < 144 as u8 or
               bytes[index + 1] > 191 as u8 or
               bytes[index + 2] < 128 as u8 or
               bytes[index + 2] > 191 as u8 or
               bytes[index + 3] < 128 as u8 or
               bytes[index + 3] > 191 as u8 {
                return false;
            }
            set width = 4;
        } else if first >= 241 as u8 and first <= 243 as u8 {
            if index + 3 >= bytes.len() or
               bytes[index + 1] < 128 as u8 or
               bytes[index + 1] > 191 as u8 or
               bytes[index + 2] < 128 as u8 or
               bytes[index + 2] > 191 as u8 or
               bytes[index + 3] < 128 as u8 or
               bytes[index + 3] > 191 as u8 {
                return false;
            }
            set width = 4;
        } else if first == 244 as u8 {
            if index + 3 >= bytes.len() or
               bytes[index + 1] < 128 as u8 or
               bytes[index + 1] > 143 as u8 or
               bytes[index + 2] < 128 as u8 or
               bytes[index + 2] > 191 as u8 or
               bytes[index + 3] < 128 as u8 or
               bytes[index + 3] > 191 as u8 {
                return false;
            }
            set width = 4;
        } else {
            return false;
        }

        set index += width;
    }

    return true;
}

proc help_source_excerpt(
    diagnostic_value: *const Diagnostic,
    sources: *const SourceContext
) -> string {
    if diagnostic_value == null or sources == null or
       not diagnostic_value.has_span or
       diagnostic_value.source_id == 0 or
       diagnostic_value.end_offset <= diagnostic_value.start_offset {
        return "";
    }

    let length = diagnostic_value.end_offset -
        diagnostic_value.start_offset;
    if length == 0 or length >= HELP_EXCERPT_CAPACITY {
        return "";
    }

    let mut source_slice: SourceSlice = SourceSlice {
        data: "",
        length: 0,
        source_id: diagnostic_value.source_id,
        begin: diagnostic_value.start_offset,
        end: diagnostic_value.end_offset,
        valid: false,
    };

    if not vitte_source_slice(
            &*sources,
            diagnostic_value.source_id,
            diagnostic_value.start_offset,
            diagnostic_value.end_offset,
            &mut source_slice
        ) or not source_slice.valid or
       source_slice.length != length {
        return "";
    }

    let bytes: [u8] = source_slice.data.bytes();
    let mut index: usize = 0;
    while index < bytes.len() {
        if bytes[index] < 32 as u8 or
           bytes[index] == 127 as u8 or
           bytes[index] == 96 as u8 {
            return "";
        }
        set index += 1;
    }

    if not help_utf8_valid(source_slice.data) {
        return "";
    }

    return source_slice.data;
}

proc help_primary_label(
    diagnostic_value: *const Diagnostic
) -> string {
    if diagnostic_value == null {
        return "";
    }
    let mut index: usize = 0;
    while index < diagnostic_value.labels.len() and index < MAX_LABELS {
        let label = &diagnostic_value.labels[index];
        if label.style == DiagnosticLabelStyle.Primary and
           help_text_present(label.message) {
            return label.message;
        }
        set index += 1;
    }
    return "";
}

proc help_first_cause(
    diagnostic_value: *const Diagnostic
) -> string {
    if diagnostic_value == null {
        return "";
    }
    let mut index: usize = 0;
    while index < diagnostic_value.causes.len() and index < MAX_CAUSES {
        if help_text_present(diagnostic_value.causes[index].message) {
            return diagnostic_value.causes[index].message;
        }
        set index += 1;
    }
    return "";
}

proc help_detail(diagnostic_value: *const Diagnostic) -> string {
    if diagnostic_value == null {
        return "";
    }
    if help_text_present(diagnostic_value.details) {
        return diagnostic_value.details;
    }
    let label = help_primary_label(diagnostic_value);
    if help_text_present(label) {
        return label;
    }
    return help_first_cause(diagnostic_value);
}

proc help_byte_is_space(value: u8) -> bool {
    return value == 32 as u8 or value == 9 as u8 or
           value == 10 as u8 or value == 13 as u8;
}

proc help_trim(text: string) -> string {
    let mut begin: usize = 0;
    let mut end: usize = text.len();
    while begin < end and help_byte_is_space(text[begin] as u8) {
        set begin += 1;
    }
    while end > begin and help_byte_is_space(text[end - 1] as u8) {
        set end -= 1;
    }
    if begin == end {
        return "";
    }
    return text.slice(begin, end);
}

proc help_prefix_bytes(text: string, maximum: usize) -> string {
    let bytes: [u8] = text.bytes();
    if bytes.len() <= maximum {
        return text;
    }
    let mut length = maximum;
    while length > 0 and bytes[length] >= 128 as u8 and
          bytes[length] <= 191 as u8 {
        set length -= 1;
    }
    return text.slice(0, length);
}

proc help_find_bytes(text: string, needle: string) -> usize {
    let text_bytes: [u8] = text.bytes();
    let needle_bytes: [u8] = needle.bytes();
    if needle_bytes.len() == 0 {
        return 0;
    }
    if needle_bytes.len() > text_bytes.len() {
        return 18446744073709551615 as usize;
    }
    let mut start: usize = 0;
    while start + needle_bytes.len() <= text_bytes.len() {
        let mut offset: usize = 0;
        let mut matched: bool = true;
        while offset < needle_bytes.len() {
            if text_bytes[start + offset] != needle_bytes[offset] {
                set matched = false;
                break;
            }
            set offset += 1;
        }
        if matched {
            return start;
        }
        set start += 1;
    }
    return 18446744073709551615 as usize;
}

proc help_extract_expected_token(reason: string) -> HelpExpectedTokens {
    let trimmed = help_trim(reason);
    let bytes: [u8] = trimmed.bytes();
    let prefix = "expected ";
    if bytes.len() < 9 or
       trimmed.slice(0, 9) != prefix {
        return HelpExpectedTokens { valid: false, expected: "", found: "" };
    }

    let suffix_position = help_find_bytes(trimmed, ", found ");
    let expected_end: usize = if suffix_position ==
        18446744073709551615 as usize {
        bytes.len()
    } else {
        suffix_position
    };
    let expected = help_prefix_bytes(
        help_trim(trimmed.slice(9, expected_end)),
        HELP_EXPECTED_TOKEN_LIMIT - 1
    );
    if expected == "" {
        return HelpExpectedTokens { valid: false, expected: "", found: "" };
    }

    let mut found = "";
    if suffix_position != 18446744073709551615 as usize {
        found = help_prefix_bytes(
            help_trim(trimmed.slice(
                suffix_position + 8,
                bytes.len()
            )),
            HELP_EXPECTED_TOKEN_LIMIT - 1
        );
    }

    return HelpExpectedTokens {
        valid: true,
        expected: expected,
        found: found,
    };
}

proc help_type_is_integer(name: string) -> bool {
    return name == "int" or name == "uint" or
        name == "i8" or name == "i16" or name == "i32" or
        name == "i64" or name == "i128" or name == "u8" or
        name == "u16" or name == "u32" or name == "u64" or
        name == "u128" or name == "isize" or name == "usize";
}

proc help_type_is_float(name: string) -> bool {
    return name == "float" or name == "f32" or name == "f64";
}

proc help_type_is_numeric(name: string) -> bool {
    return help_type_is_integer(name) or help_type_is_float(name);
}

proc help_type_is_string(name: string) -> bool {
    return name == "string" or name == "str";
}

proc help_format_type_mismatch(
    diagnostic_value: *const Diagnostic,
    source_text: string
) -> ?string {
    if diagnostic_value == null or
       not help_text_present(diagnostic_value.expected_type) or
       not help_text_present(diagnostic_value.actual_type) {
        return null;
    }

    let mut output = "Provide a value of type ";
    set output += help_quote_fragment(
        diagnostic_value.expected_type,
        HELP_TYPE_LIMIT
    );
    set output += " instead of ";
    set output += help_quote_fragment(
        diagnostic_value.actual_type,
        HELP_TYPE_LIMIT
    );
    if help_text_present(source_text) {
        set output += " for ";
        set output += help_quote_fragment(source_text, HELP_SUBJECT_LIMIT);
    }
    set output += ". ";

    if help_type_is_string(diagnostic_value.actual_type) and
       help_type_is_numeric(diagnostic_value.expected_type) {
        set output += "If the value is text input, parse it and handle failure before using it; if text is intended, change the consumer or its declared type instead.";
    } else if help_type_is_numeric(diagnostic_value.actual_type) and
              help_type_is_string(diagnostic_value.expected_type) {
        set output += "If text is intended, format the number explicitly; if the consumer needs a number, correct its declared type instead of converting the value to text.";
    } else if help_type_is_integer(diagnostic_value.actual_type) and
              help_type_is_integer(diagnostic_value.expected_type) {
        set output += "If the destination type is intended, check range and signedness before an explicit conversion; otherwise widen or correct the destination type to preserve the value.";
    } else if help_type_is_float(diagnostic_value.actual_type) and
              help_type_is_integer(diagnostic_value.expected_type) {
        set output += "If an integer is intended, verify the value is integral and in range before converting; if the fraction matters, use a floating-point destination instead.";
    } else if help_type_is_integer(diagnostic_value.actual_type) and
              help_type_is_float(diagnostic_value.expected_type) {
        set output += "If the floating-point destination is intended, convert explicitly after checking precision; if exact integer precision matters, keep an integer destination instead.";
    } else if diagnostic_value.expected_type == "bool" {
        set output += "Produce a boolean expression explicitly, normally with a comparison or another operation whose result type is `bool`.";
    } else {
        set output += "If the required type is intentional, produce a value of that type; if the actual type is intentional, correct the declaration or operation that requires a different type. Convert only when the conversion preserves the intended value.";
    }
    return output;
}

proc help_format_arity_mismatch(
    diagnostic_value: *const Diagnostic
) -> ?string {
    if diagnostic_value == null or
       not help_text_present(diagnostic_value.expected) or
       not help_text_present(diagnostic_value.found) {
        return null;
    }

    let mut output = "This call supplies ";
    set output += help_quote_fragment(diagnostic_value.found, HELP_EXPECTED_TOKEN_LIMIT);
    set output += ", while the selected signature requires ";
    set output += help_quote_fragment(diagnostic_value.expected, HELP_EXPECTED_TOKEN_LIMIT);
    set output += ". If the call is wrong, add or remove arguments to match the declaration; if the API is wrong, change its parameter list instead.";
    return output;
}

proc help_format_parser_expectation(reason: string) -> ?string {
    let tokens = help_extract_expected_token(reason);
    if not tokens.valid {
        return null;
    }
    let mut output = "Insert or restore ";
    set output += help_quote_fragment(tokens.expected, HELP_EXPECTED_TOKEN_LIMIT);
    if help_text_present(tokens.found) {
        set output += " before ";
        set output += help_quote_fragment(tokens.found, HELP_EXPECTED_TOKEN_LIMIT);
    }
    set output += ". Match the expected element to the surrounding grammar and the nearest corresponding opening construct.";
    return output;
}

proc help_format_subject(prefix: string, subject: string, suffix: string) -> ?string {
    if not help_text_present(subject) {
        return null;
    }
    return prefix + help_quote_fragment(subject, HELP_SUBJECT_LIMIT) + suffix;
}

proc help_format_boolean_condition(diagnostic_value: *const Diagnostic) -> ?string {
    if diagnostic_value == null or
       not help_text_present(diagnostic_value.actual_type) {
        return null;
    }
    return "Convert the condition into an explicit boolean expression instead of using a value of type " +
        help_quote_fragment(diagnostic_value.actual_type, HELP_TYPE_LIMIT) +
        ". Choose a comparison or predicate that expresses the intended condition.";
}

proc help_format_contract(
    diagnostic_value: *const Diagnostic,
    policy: string
) -> ?string {
    if diagnostic_value == null or
       diagnostic_value.contract.kind == DiagnosticContractKind.None or
       not help_text_present(diagnostic_value.contract.expression) {
        return null;
    }
    let mut output = "";
    if help_text_present(policy) {
        set output += policy;
        set output += " ";
    }
    set output += "Contract condition: ";
    set output += help_quote_fragment(
        diagnostic_value.contract.expression,
        HELP_CONTRACT_LIMIT
    );
    set output += ".";
    if help_text_present(diagnostic_value.contract.reason) {
        set output += " Reported reason: ";
        set output += help_quote_fragment(
            diagnostic_value.contract.reason,
            HELP_REASON_LIMIT
        );
        set output += ".";
    }
    return output;
}

proc help_registry_entry(
    diagnostic_value: *const Diagnostic
) -> *const DiagnosticRegistryEntry {
    if diagnostic_value == null {
        return null;
    }
    let mut registry_value: *const DiagnosticRegistryEntry = null;
    if help_text_present(diagnostic_value.code) {
        registry_value = vitte_diagnostic_registry_find_internal(diagnostic_value.code);
        if registry_value == null {
            registry_value = vitte_diagnostic_registry_find_public(diagnostic_value.code);
        }
    }
    if registry_value == null and help_text_present(diagnostic_value.short_code) {
        registry_value = vitte_diagnostic_registry_find_public(diagnostic_value.short_code);
        if registry_value == null {
            registry_value = vitte_diagnostic_registry_find_internal(diagnostic_value.short_code);
        }
    }
    return registry_value;
}

proc help_public_code(
    diagnostic_value: *const Diagnostic,
    registry_value: *const DiagnosticRegistryEntry
) -> string {
    if registry_value != null and help_text_present(registry_value.public_code) {
        return registry_value.public_code;
    }
    if diagnostic_value != null and help_text_present(diagnostic_value.short_code) {
        return diagnostic_value.short_code;
    }
    return "";
}

proc help_code_has_prefix(code: string, prefix: string) -> bool {
    return code.len() >= prefix.len() and code.slice(0, prefix.len()) == prefix;
}

proc help_wants_context(code: string) -> bool {
    return code == "E0300" or code == "E0301" or
        code == "E0302" or code == "E0303" or
        code == "E0304" or code == "E0305" or
        code == "E0306" or code == "E0307" or
        help_code_has_prefix(code, "E04") or
        help_code_has_prefix(code, "E05") or
        help_code_has_prefix(code, "E06") or
        help_code_has_prefix(code, "E07") or
        help_code_has_prefix(code, "E08") or
        help_code_has_prefix(code, "E09") or
        help_code_has_prefix(code, "E10") or
        help_code_has_prefix(code, "E12") or
        help_code_has_prefix(code, "E19");
}

proc help_wants_semantic_context(code: string) -> bool {
    return help_code_has_prefix(code, "E04") or
        help_code_has_prefix(code, "E05") or
        help_code_has_prefix(code, "E06") or
        help_code_has_prefix(code, "E07") or
        help_code_has_prefix(code, "E08") or
        help_code_has_prefix(code, "E12");
}

proc help_wants_related_context(code: string) -> bool {
    return code == "E0300" or code == "E0301" or
        code == "E0302" or code == "E0303" or
        code == "E0304" or code == "E0305" or
        code == "E0306" or code == "E0307" or
        help_code_has_prefix(code, "E04") or
        help_code_has_prefix(code, "E05") or
        help_code_has_prefix(code, "E06") or
        help_code_has_prefix(code, "E07") or
        help_code_has_prefix(code, "E08") or
        help_code_has_prefix(code, "E09") or
        help_code_has_prefix(code, "E10") or
        help_code_has_prefix(code, "E12") or
        help_code_has_prefix(code, "E19");
}

proc help_output_contains(output: string, text: string) -> bool {
    return help_text_present(text) and
        help_find_bytes(output, text) != 18446744073709551615 as usize;
}

proc help_subject_from_message(message: string, marker: string) -> string {
    let marker_start = help_find_bytes(message, marker);
    if marker_start == 18446744073709551615 as usize {
        return "";
    }
    let bytes: [u8] = message.bytes();
    let begin = marker_start + marker.bytes().len();
    if begin >= bytes.len() {
        return "";
    }
    let suffix = message.slice(begin, bytes.len());
    let end = help_find_bytes(suffix, "`");
    if end == 18446744073709551615 as usize or end == 0 {
        return "";
    }
    return suffix.slice(0, end);
}

proc help_append_semantic_context(
    output: string,
    diagnostic_value: *const Diagnostic,
    include_types: bool,
    include_symbol: bool,
    include_expected_found: bool
) -> string {
    let mut result = output;
    if diagnostic_value == null {
        return result;
    }
    if include_symbol and help_text_present(diagnostic_value.symbol) and
       not help_output_contains(result, diagnostic_value.symbol) {
        set result += " Concerned symbol: ";
        set result += help_quote_fragment(diagnostic_value.symbol, HELP_SUBJECT_LIMIT);
        set result += ".";
    }
    if include_types and help_text_present(diagnostic_value.expected_type) and
       not help_output_contains(result, diagnostic_value.expected_type) {
        set result += " Required type: ";
        set result += help_quote_fragment(diagnostic_value.expected_type, HELP_TYPE_LIMIT);
        set result += ".";
    }
    if include_types and help_text_present(diagnostic_value.actual_type) and
       not help_output_contains(result, diagnostic_value.actual_type) {
        set result += " Actual type: ";
        set result += help_quote_fragment(diagnostic_value.actual_type, HELP_TYPE_LIMIT);
        set result += ".";
    }
    if include_expected_found and
       help_text_present(diagnostic_value.expected) and
       (not help_text_present(diagnostic_value.expected_type) or
        diagnostic_value.expected != diagnostic_value.expected_type) and
       not help_output_contains(result, diagnostic_value.expected) {
        set result += " Expected: ";
        set result += help_quote_fragment(diagnostic_value.expected, HELP_REASON_LIMIT);
        set result += ".";
    }
    if include_expected_found and
       help_text_present(diagnostic_value.found) and
       (not help_text_present(diagnostic_value.actual_type) or
        diagnostic_value.found != diagnostic_value.actual_type) and
       not help_output_contains(result, diagnostic_value.found) {
        set result += " Found: ";
        set result += help_quote_fragment(diagnostic_value.found, HELP_REASON_LIMIT);
        set result += ".";
    }
    return result;
}

proc help_append_context_details(
    output: string,
    diagnostic_value: *const Diagnostic,
    source_text: string,
    reason: string,
    include_source: bool,
    public_code: string
) -> string {
    let mut result = output;
    let mut cause_appended: bool = false;
    if diagnostic_value == null or not help_wants_context(public_code) {
        return result;
    }

    if include_source and help_text_present(source_text) and
       not help_output_contains(result, source_text) {
        set result += " Source excerpt: ";
        set result += help_quote_fragment(source_text, HELP_SUBJECT_LIMIT);
        set result += ".";
    }

    let primary_label = help_primary_label(diagnostic_value);
    if help_text_present(primary_label) and
       (not help_text_present(reason) or primary_label != reason) and
       not help_output_contains(result, primary_label) {
        set result += " Offending construct: ";
        set result += help_quote_fragment(primary_label, HELP_REASON_LIMIT);
        set result += ".";
    }

    if help_text_present(diagnostic_value.probable_cause) and
       (not help_text_present(reason) or
        diagnostic_value.probable_cause != reason) and
       not help_output_contains(result, diagnostic_value.probable_cause) {
        set result += " Likely cause: ";
        set result += help_quote_fragment(diagnostic_value.probable_cause, HELP_REASON_LIMIT);
        set result += ".";
        set cause_appended = true;
    }

    if help_text_present(diagnostic_value.context) and
       diagnostic_value.context != "use declaration" and
       not help_output_contains(result, diagnostic_value.context) {
        set result += " Diagnostic context: ";
        set result += help_quote_fragment(diagnostic_value.context, HELP_REASON_LIMIT);
        set result += ".";
    }

    let first_cause = help_first_cause(diagnostic_value);
    if help_text_present(first_cause) and
       not cause_appended and
       (not help_text_present(reason) or first_cause != reason) and
       (not help_text_present(diagnostic_value.probable_cause) or
        first_cause != diagnostic_value.probable_cause) and
       not help_output_contains(result, first_cause) {
        set result += " Failure cause: ";
        set result += help_quote_fragment(first_cause, HELP_REASON_LIMIT);
        set result += ".";
    }

    if not help_wants_related_context(public_code) {
        return result;
    }

    let mut index: usize = 0;
    let mut shown: usize = 0;
    while index < diagnostic_value.related.len() and
          index < MAX_RELATED and shown < 2 {
        let related = &diagnostic_value.related[index];
        if help_text_present(related.label) and
           not help_output_contains(result, related.label) {
            set result += " Related location: ";
            set result += help_quote_fragment(related.label, HELP_REASON_LIMIT);
            set result += ".";
            set shown += 1;
        }
        set index += 1;
    }
    return result;
}

proc help_append_compilation_context(
    output: string,
    diagnostic_value: *const Diagnostic,
    public_code: string
) -> string {
    let mut result = output;
    if diagnostic_value == null or not help_wants_context(public_code) {
        return result;
    }

    let show_module = not diagnostic_value.has_span and
        (public_code == "E0300" or public_code == "E0301" or
        public_code == "E0302" or public_code == "E0303" or
        public_code == "E0304" or public_code == "E0305" or
        public_code == "E0306" or public_code == "E0307" or
        help_code_has_prefix(public_code, "E04") or
        help_code_has_prefix(public_code, "E05"));
    let show_procedure = not diagnostic_value.has_span and
        (help_code_has_prefix(public_code, "E06") or
        help_code_has_prefix(public_code, "E07") or
        help_code_has_prefix(public_code, "E08") or
        help_code_has_prefix(public_code, "E12"));

    if show_module and help_text_present(diagnostic_value.package) and
       not help_output_contains(result, diagnostic_value.package) {
        set result += " Module context: package ";
        set result += help_quote_fragment(diagnostic_value.package, 128);
        set result += ".";
    }
    if show_module and help_text_present(diagnostic_value.module) and
       not help_output_contains(result, diagnostic_value.module) {
        set result += " Module context: module ";
        set result += help_quote_fragment(diagnostic_value.module, 256);
        set result += ".";
    }
    if show_procedure and help_text_present(diagnostic_value.procedure) and
       not help_output_contains(result, diagnostic_value.procedure) {
        set result += " Procedure context: ";
        set result += help_quote_fragment(diagnostic_value.procedure, 256);
        set result += ".";
    } else if show_procedure and
              help_text_present(diagnostic_value.contract.procedure) and
              not help_output_contains(result, diagnostic_value.contract.procedure) {
        set result += " Procedure context: ";
        set result += help_quote_fragment(diagnostic_value.contract.procedure, 256);
        set result += ".";
    }
    return result;
}

proc help_append_next_action(
    output: string,
    diagnostic_value: *const Diagnostic,
    public_code: string
) -> string {
    let mut result = output;
    if diagnostic_value == null {
        return result;
    }

    if help_output_contains(result, "vitte ") or
       help_output_contains(result, "VITTE_BACKTRACE=1") or
       help_output_contains(result, "cc -dumpmachine") {
        return result;
    }

    if not help_text_present(public_code) or
       vitte_diagnostic_registry_find_public(public_code) == null {
        if not help_output_contains(result, "Preserve the original command") {
            set result += " Preserve the original command, compiler version, source and phase for manual investigation.";
        }
        return result;
    }

    let internal = diagnostic_value.is_internal or
        diagnostic_value.origin == DiagnosticOrigin.Internal;
    let backend_code = public_code.len() >= 3 and
        (public_code.slice(0, 3) == "E09" or
         public_code.slice(0, 3) == "E10" or
         public_code.slice(0, 3) == "E19");
    let backend = backend_code or
        diagnostic_value.origin == DiagnosticOrigin.C17Backend or
        diagnostic_value.origin == DiagnosticOrigin.CCompiler or
        diagnostic_value.origin == DiagnosticOrigin.Linker or
        diagnostic_value.origin == DiagnosticOrigin.Codegen or
        diagnostic_value.origin == DiagnosticOrigin.Ir;

    if public_code == "E0004" {
        set result += " Next: check memory and process limits, then retry with `vitte compile <file> --jobs=1` if parallel compilation may be exhausting resources.";
    } else if public_code == "E0013" {
        set result += " Next: identify the unavailable component in the reported cause and install or configure it; preserve the reproducer if it is compiler-owned.";
    } else if internal {
        set result += " Next: rerun the original command with `VITTE_BACKTRACE=1` and preserve the smallest reproducing input.";
    } else if public_code == "E0011" {
        set result += " Next: run `vitte --help` to check the supported options and their combinations.";
    } else if public_code.len() >= 3 and public_code.slice(0, 3) == "E19" {
        set result += " Next: inspect the selected compiler's target with `cc -dumpmachine` when supported (or use the executable named by `CC`), then reproduce with `vitte compile <file>`.";
    } else if backend {
        set result += " Next: reproduce with `vitte compile <file>`; for C17 backend output, inspect `vitte compile <file> --emit-c`.";
    } else if diagnostic_value.origin == DiagnosticOrigin.Runtime {
        set result += " Next: rerun `vitte run <file>` with the same input and compare the reported procedure and values.";
    } else {
        // Registered source diagnostics already carry family-specific advice.
        return result;
    }
    return result;
}

proc help_format_fallback(
    diagnostic_value: *const Diagnostic,
    reason: string
) -> string {
    if diagnostic_value == null {
        return "";
    }
    let identifier = if help_text_present(diagnostic_value.short_code) {
        diagnostic_value.short_code
    } else {
        diagnostic_value.code
    };
    let phase = origin_name(diagnostic_value.origin);
    let mut output = "No verified correction is registered for ";
    if help_text_present(identifier) {
        set output += help_quote_fragment(identifier, 128);
    } else {
        set output += "this unclassified diagnostic";
    }
    if help_text_present(phase) {
        set output += " from compiler phase ";
        set output += help_quote_fragment(phase, 64);
    }
    set output += ".";
    if help_text_present(diagnostic_value.message) {
        set output += " Failure: ";
        set output += help_quote_fragment(diagnostic_value.message, HELP_REASON_LIMIT);
        set output += ".";
    }
    if help_text_present(reason) {
        set output += " Detail: ";
        set output += help_quote_fragment(reason, HELP_REASON_LIMIT);
        set output += ".";
    }
    let cause = help_first_cause(diagnostic_value);
    if help_text_present(cause) and cause != reason {
        set output += " Investigate the reported cause: ";
        set output += help_quote_fragment(cause, HELP_REASON_LIMIT);
        set output += ".";
    }
    if diagnostic_value.origin == DiagnosticOrigin.Internal or
       diagnostic_value.severity == DiagnosticSeverity.Fatal {
        set output += " Preserve the failing command, compiler version and smallest reproducing input for a compiler report.";
    }
    return output;
}

proc help_format_text(
    diagnostic_value: *const Diagnostic,
    sources: *const SourceContext
) -> string {
    if diagnostic_value == null {
        return "";
    }

    let explicit = help_explicit_annotation(diagnostic_value);
    if help_text_present(explicit) {
        if diagnostic_value.severity != DiagnosticSeverity.Warning and
           diagnostic_value.severity != DiagnosticSeverity.Error and
           diagnostic_value.severity != DiagnosticSeverity.Fatal {
            return explicit;
        }
        let explicit_registry = help_registry_entry(diagnostic_value);
        let explicit_code = help_public_code(diagnostic_value, explicit_registry);
        let explicit_source = help_source_excerpt(diagnostic_value, sources);
        let mut enriched = explicit;
        if help_wants_semantic_context(explicit_code) {
            set enriched = help_append_semantic_context(
                enriched, diagnostic_value, true, true, true
            );
        }
        set enriched = help_append_context_details(
            enriched,
            diagnostic_value,
            explicit_source,
            help_detail(diagnostic_value),
            true,
            explicit_code
        );
        set enriched = help_append_compilation_context(
            enriched, diagnostic_value, explicit_code
        );
        return enriched;
    }

    if diagnostic_value.severity != DiagnosticSeverity.Warning and
       diagnostic_value.severity != DiagnosticSeverity.Error and
       diagnostic_value.severity != DiagnosticSeverity.Fatal {
        return "";
    }

    let registry_value = help_registry_entry(diagnostic_value);
    let public_code = help_public_code(diagnostic_value, registry_value);
    let policy = vitte_diagnostic_help_for_code(public_code);
    let reason = help_detail(diagnostic_value);
    let source_text = help_source_excerpt(diagnostic_value, sources);
    let mut subject = if help_text_present(diagnostic_value.symbol) {
        diagnostic_value.symbol
    } else {
        source_text
    };
    if subject == "" and public_code == "E0401" {
        set subject = help_subject_from_message(
            diagnostic_value.message, "unknown symbol `"
        );
    } else if subject == "" and public_code == "E0510" {
        set subject = help_subject_from_message(
            diagnostic_value.message, "unknown type `"
        );
    }

    let mut output = "";
    let mut specialized: bool = false;
    let mut include_types: bool = true;
    let mut include_symbol: bool = true;
    let mut include_expected_found: bool = true;
    let mut include_source: bool = true;

    if public_code == "E0501" or public_code == "E0602" or
       public_code == "E0605" {
        let type_help = help_format_type_mismatch(diagnostic_value, source_text);
        if type_help != null {
            set output = type_help?;
            set specialized = true;
            set include_types = false;
            set include_source = false;
        }
    }

    if not specialized and public_code == "E0601" {
        let arity_help = help_format_arity_mismatch(diagnostic_value);
        if arity_help != null {
            set output = arity_help?;
            set specialized = true;
            set include_expected_found = false;
        }
    }

    if not specialized and
       (public_code == "E0201" or public_code == "E0207" or
        public_code == "E0208") {
        let mut parser_reason = reason;
        if help_text_present(diagnostic_value.expected) {
            set parser_reason = "expected " + diagnostic_value.expected;
            if help_text_present(diagnostic_value.found) {
                set parser_reason += ", found " + diagnostic_value.found;
            }
        }
        let parser_help = help_format_parser_expectation(parser_reason);
        if parser_help != null {
            set output = parser_help?;
            set specialized = true;
            set include_expected_found = false;
        }
    }

    if not specialized and public_code == "E0401" {
        if help_text_present(reason) and
           (registry_value == null or reason != (*registry_value).explanation) {
            set output = reason;
            set specialized = true;
            set include_symbol =
                not help_text_present(diagnostic_value.symbol) or
                help_find_bytes(reason, diagnostic_value.symbol) ==
                    18446744073709551615 as usize;
        } else {
            let name_help = help_format_subject(
                "Declare or import ",
                subject,
                " in this scope, or correct its spelling to match a visible declaration."
            );
            if name_help != null {
                set output = name_help?;
                set specialized = true;
                set include_symbol = false;
                if subject != "" and subject == source_text {
                    set include_source = false;
                }
            }
        }
    }

    if not specialized and public_code == "E0510" {
        let type_help = help_format_subject(
            "Declare or import the type ",
            subject,
            " before using it here; verify the type's spelling, module and visibility."
        );
        if type_help != null {
            set output = type_help?;
            set specialized = true;
            set include_symbol = false;
            if subject != "" and subject == source_text {
                set include_source = false;
            }
        }
    }

    if not specialized and public_code == "E0515" {
        let bool_help = help_format_boolean_condition(diagnostic_value);
        if bool_help != null {
            set output = bool_help?;
            set specialized = true;
            set include_types = false;
        }
    }

    if not specialized {
        let contract_help = help_format_contract(diagnostic_value, policy);
        if contract_help != null {
            set output = contract_help?;
            set specialized = true;
        }
    }

    if not specialized and help_text_present(policy) {
        set output = policy;
        set specialized = true;
    }

    if not specialized {
        if registry_value != null and
           (*registry_value).origin != DiagnosticOrigin.Internal {
            // Keep registered user-facing failures tied to their own explanation
            // if the contextual-help table is incomplete.
            set output = (*registry_value).explanation;
        } else {
            set output = help_format_fallback(diagnostic_value, reason);
        }
    } else {
        if (public_code == "E0005" or public_code == "E0011" or
            public_code == "E0013") and help_text_present(reason) {
            set output += " Reported failure: ";
            set output += help_quote_fragment(reason, HELP_REASON_LIMIT);
            set output += ".";
        }
    }

    if help_wants_semantic_context(public_code) {
        set output = help_append_semantic_context(
            output,
            diagnostic_value,
            include_types,
            include_symbol,
            include_expected_found
        );
    }
    set output = help_append_context_details(
        output,
        diagnostic_value,
        source_text,
        reason,
        include_source,
        public_code
    );

    set output = help_append_compilation_context(output, diagnostic_value, public_code);
    set output = help_append_next_action(output, diagnostic_value, public_code);
    return output;
}

export proc vitte_diagnostic_help_for_code(code: string) -> string {
    let index = help_rule_index(code);
    if index >= HELP_RULE_CODES.len() or index >= HELP_RULE_TEXTS.len() {
        return "";
    }
    return HELP_RULE_TEXTS[index];
}

export proc vitte_diagnostic_help_has_policy(public_code: string) -> bool {
    return help_text_present(vitte_diagnostic_help_for_code(public_code));
}

export proc vitte_diagnostic_has_help(
    diagnostic_value: *const Diagnostic
) -> bool {
    return help_text_present(help_explicit_annotation(diagnostic_value));
}

export proc vitte_diagnostic_help_available(
    diagnostic_value: *const Diagnostic
) -> bool {
    if diagnostic_value == null {
        return false;
    }
    if vitte_diagnostic_has_help(diagnostic_value) {
        return true;
    }
    return vitte_diagnostic_help_has_policy(diagnostic_value.short_code) or
        vitte_diagnostic_help_has_policy(diagnostic_value.code);
}

export proc vitte_diagnostic_format_help(
    diagnostic_value: *const Diagnostic,
    sources: *const SourceContext,
    buffer: *mut u8,
    capacity: usize
) -> bool {
    if buffer == null or capacity == 0 {
        return false;
    }
    set buffer[0 as i64] = 0 as u8;
    if diagnostic_value == null {
        return false;
    }
    return help_copy_to_buffer(
        buffer,
        capacity,
        help_format_text(diagnostic_value, sources)
    );
}

export proc vitte_diagnostic_help_rule_count() -> usize {
    return HELP_RULE_CODES.len();
}

export proc vitte_diagnostic_help_rule_code(index: usize) -> string {
    if index >= HELP_RULE_CODES.len() {
        return "";
    }
    return HELP_RULE_CODES[index];
}

export proc vitte_diagnostic_help_rule_text(index: usize) -> string {
    if index >= HELP_RULE_TEXTS.len() {
        return "";
    }
    return HELP_RULE_TEXTS[index];
}

export proc vitte_diagnostic_help_validate_rules(
    missing_count: *mut usize,
    orphan_count: *mut usize,
    duplicate_count: *mut usize
) -> bool {
    let mut missing: usize = 0;
    let mut orphan: usize = 0;
    let mut duplicate: usize = 0;
    let registry_count = diagnostic_registry_count();
    let mut registry_index: usize = 0;

    if HELP_RULE_CODES.len() != HELP_RULE_TEXTS.len() {
        set missing += 1;
    }

    while registry_index < registry_count {
        let registry_entry = diagnostic_registry_at(registry_index);
        if registry_entry != null and help_text_present(registry_entry.public_code) and
           registry_entry.default_severity != DiagnosticSeverity.Note and
           registry_entry.default_severity != DiagnosticSeverity.Help {
            let help_index = help_rule_index(registry_entry.public_code);
            if help_index >= HELP_RULE_CODES.len() or
               help_index >= HELP_RULE_TEXTS.len() {
                set missing += 1;
            } else if not help_text_present(HELP_RULE_TEXTS[help_index]) {
                set missing += 1;
            }
        }
        set registry_index += 1;
    }

    let mut rule_index: usize = 0;
    while rule_index < HELP_RULE_CODES.len() {
        if rule_index >= HELP_RULE_TEXTS.len() {
            set missing += 1;
        } else if not help_text_present(HELP_RULE_TEXTS[rule_index]) {
            set missing += 1;
        }
        if vitte_diagnostic_registry_find_public(HELP_RULE_CODES[rule_index]) == null {
            set orphan += 1;
        }
        let mut other: usize = rule_index + 1;
        while other < HELP_RULE_CODES.len() {
            if HELP_RULE_CODES[rule_index] == HELP_RULE_CODES[other] {
                set duplicate += 1;
            }
            set other += 1;
        }
        set rule_index += 1;
    }

    if missing_count != null {
        set missing_count[0] = missing;
    }
    if orphan_count != null {
        set orphan_count[0] = orphan;
    }
    if duplicate_count != null {
        set duplicate_count[0] = duplicate;
    }

    return missing == 0 and orphan == 0 and duplicate == 0;
}

/// Compatibility name used by the Vitte explanation layer.
export proc diagnostic_help_for_code(code: string) -> string {
    return vitte_diagnostic_help_for_code(code);
}
