form HelpExpectedTokens {
    valid: bool,
    expected: string,
    found: string
}

proc help_text_present(text: string) -> bool {
    return text.length() != 0;
}

proc help_ascii_lower(value: u8) -> u8 {
    if value >= 65 as u8 and value <= 90 as u8 {
        return value + 32 as u8;
    }
    return value;
}

proc help_ascii_equal(left: string, right: string) -> bool {
    let left_bytes: [u8] = left.bytes();
    let right_bytes: [u8] = right.bytes();
    if left_bytes.len() != right_bytes.len() {
        return false;
    }
    let mut index: usize = 0;
    while index < left_bytes.len() {
        if help_ascii_lower(left_bytes[index]) !=
           help_ascii_lower(right_bytes[index]) {
            return false;
        }
        set index += 1;
    }
    return true;
}

proc help_rule_index(code: string) -> usize {
    let mut index: usize = 0;
    while index < HELP_RULE_CODES.len() {
        if help_ascii_equal(HELP_RULE_CODES[index], code) {
            return index;
        }
        set index += 1;
    }
    return HELP_RULE_CODES.len();
}

proc help_explicit_annotation(
    diagnostic_value: *const Diagnostic
) -> string {
    if diagnostic_value == null {
        return "";
    }
    let mut index: usize = 0;
    while index < diagnostic_value.annotations.len() {
        let annotation = &diagnostic_value.annotations[index];
        if annotation.kind == DiagnosticAnnotationKind.Help and
           help_text_present(annotation.message) {
            return annotation.message;
        }
        set index += 1;
    }
    return "";
}

proc help_copy_to_buffer(
    buffer: *mut u8,
    capacity: usize,
    text: string
) -> bool {
    if buffer == null or capacity == 0 {
        return false;
    }

    let bytes: [u8] = text.bytes();
    let mut length: usize = bytes.len();
    if length >= capacity {
        set length = capacity - 1;
        while length > 0 and length < bytes.len() and
              bytes[length] >= 128 as u8 and
              bytes[length] <= 191 as u8 {
            set length -= 1;
        }
    }

    let mut index: usize = 0;
    while index < length {
        set buffer[index as i64] = bytes[index];
        set index += 1;
    }
    set buffer[length as i64] = 0 as u8;
    return length != 0;
}

proc help_quote_fragment(text: string, maximum: usize) -> string {
    if not help_text_present(text) {
        return "";
    }

    let bytes: [u8] = text.bytes();
    let mut output = "`";
    let mut index: usize = 0;
    let mut written: usize = 0;

    while index < bytes.len() and written < maximum {
        let byte = bytes[index];

        if byte < 32 as u8 or byte == 127 as u8 {
            set index += 1;
            continue;
        }

        if byte == 96 as u8 {
            set output += "\\`";
            set written += 1;
            set index += 1;
            continue;
        }

        let mut width: usize = 1;
        if byte >= 194 as u8 and byte <= 223 as u8 and
           index + 1 < bytes.len() {
            set width = 2;
        } else if byte >= 224 as u8 and byte <= 239 as u8 and
                  index + 2 < bytes.len() {
            set width = 3;
        } else if byte >= 240 as u8 and byte <= 244 as u8 and
                  index + 3 < bytes.len() {
            set width = 4;
        }

        if written + width > maximum {
            break;
        }

        set output += text.slice(index, index + width);
        set written += width;
        set index += width;
    }

    if index < bytes.len() {
        set output += "…";
    }

    set output += "`";
    return output;
}

proc help_utf8_valid(text: string) -> bool {
    let bytes: [u8] = text.bytes();
    let mut index: usize = 0;

    while index < bytes.len() {
        let first = bytes[index];
        let mut width: usize = 0;

        if first <= 127 as u8 {
            set width = 1;
        } else if first >= 194 as u8 and first <= 223 as u8 {
            if index + 1 >= bytes.len() or
               bytes[index + 1] < 128 as u8 or
               bytes[index + 1] > 191 as u8 {
                return false;
            }
            set width = 2;
        } else if first == 224 as u8 {
            if index + 2 >= bytes.len() or
               bytes[index + 1] < 160 as u8 or
               bytes[index + 1] > 191 as u8 or
               bytes[index + 2] < 128 as u8 or
               bytes[index + 2] > 191 as u8 {
                return false;
            }
            set width = 3;
        } else if (first >= 225 as u8 and first <= 236 as u8) or
                  (first >= 238 as u8 and first <= 239 as u8) {
            if index + 2 >= bytes.len() or
               bytes[index + 1] < 128 as u8 or
               bytes[index + 1] > 191 as u8 or
               bytes[index + 2] < 128 as u8 or
               bytes[index + 2] > 191 as u8 {
                return false;
            }
            set width = 3;
        } else if first == 237 as u8 {
            if index + 2 >= bytes.len() or
               bytes[index + 1] < 128 as u8 or
               bytes[index + 1] > 159 as u8 or
               bytes[index + 2] < 128 as u8 or
               bytes[index + 2] > 191 as u8 {
                return false;
            }
            set width = 3;
        } else if first == 240 as u8 {
            if index + 3 >= bytes.len() or
               bytes[index + 1] < 144 as u8 or
               bytes[index + 1] > 191 as u8 or
               bytes[index + 2] < 128 as u8 or
               bytes[index + 2] > 191 as u8 or
               bytes[index + 3] < 128 as u8 or
               bytes[index + 3] > 191 as u8 {
                return false;
            }
            set width = 4;
        } else if first >= 241 as u8 and first <= 243 as u8 {
            if index + 3 >= bytes.len() or
               bytes[index + 1] < 128 as u8 or
               bytes[index + 1] > 191 as u8 or
               bytes[index + 2] < 128 as u8 or
               bytes[index + 2] > 191 as u8 or
               bytes[index + 3] < 128 as u8 or
               bytes[index + 3] > 191 as u8 {
                return false;
            }
            set width = 4;
        } else if first == 244 as u8 {
            if index + 3 >= bytes.len() or
               bytes[index + 1] < 128 as u8 or
               bytes[index + 1] > 143 as u8 or
               bytes[index + 2] < 128 as u8 or
               bytes[index + 2] > 191 as u8 or
               bytes[index + 3] < 128 as u8 or
               bytes[index + 3] > 191 as u8 {
                return false;
            }
            set width = 4;
        } else {
            return false;
        }

        set index += width;
    }

    return true;
}

proc help_source_excerpt(
    diagnostic_value: *const Diagnostic,
    sources: *const SourceContext
) -> string {
    if diagnostic_value == null or sources == null or
       not diagnostic_value.has_span or
       diagnostic_value.source_id == 0 or
       diagnostic_value.end_offset <= diagnostic_value.start_offset {
        return "";
    }

    let length = diagnostic_value.end_offset -
        diagnostic_value.start_offset;
    if length == 0 or length >= HELP_EXCERPT_CAPACITY {
        return "";
    }

    let mut source_slice = SourceSlice {
        data: "",
        length: 0,
        source_id: diagnostic_value.source_id,
        begin: diagnostic_value.start_offset,
        end: diagnostic_value.end_offset,
        valid: false,
    };

    if not vitte_source_slice(
            &*sources,
            diagnostic_value.source_id,
            diagnostic_value.start_offset,
            diagnostic_value.end_offset,
            &mut source_slice
        ) or not source_slice.valid or
       source_slice.length != length {
        return "";
    }

    let bytes: [u8] = source_slice.data.bytes();
    let mut index: usize = 0;
    while index < bytes.len() {
        if bytes[index] < 32 as u8 or
           bytes[index] == 127 as u8 or
           bytes[index] == 96 as u8 {
            return "";
        }
        set index += 1;
    }

    if not help_utf8_valid(source_slice.data) {
        return "";
    }

    return source_slice.data;
}

proc help_primary_label(
    diagnostic_value: *const Diagnostic
) -> string {
    if diagnostic_value == null {
        return "";
    }
    let mut index: usize = 0;
    while index < diagnostic_value.labels.len() {
        let label = &diagnostic_value.labels[index];
        if label.style == DiagnosticLabelStyle.Primary and
           help_text_present(label.message) {
            return label.message;
        }
        set index += 1;
    }
    return "";
}

proc help_first_cause(
    diagnostic_value: *const Diagnostic
) -> string {
    if diagnostic_value == null {
        return "";
    }
    let mut index: usize = 0;
    while index < diagnostic_value.causes.len() {
        if help_text_present(diagnostic_value.causes[index].message) {
            return diagnostic_value.causes[index].message;
        }
        set index += 1;
    }
    return "";
}

proc help_detail(diagnostic_value: *const Diagnostic) -> string {
    if diagnostic_value == null {
        return "";
    }
    if help_text_present(diagnostic_value.details) {
        return diagnostic_value.details;
    }
    let label = help_primary_label(diagnostic_value);
    if help_text_present(label) {
        return label;
    }
    return help_first_cause(diagnostic_value);
}

proc help_trim(text: string) -> string {
    let mut begin: usize = 0;
    let mut end: usize = text.length();
    while begin < end and text[begin].is_space() {
        set begin += 1;
    }
    while end > begin and text[end - 1].is_space() {
        set end -= 1;
    }
    if begin == end {
        return "";
    }
    return text.slice(begin, end);
}

proc help_prefix_bytes(text: string, maximum: usize) -> string {
    let bytes: [u8] = text.bytes();
    if bytes.len() <= maximum {
        return text;
    }
    let mut length = maximum;
    while length > 0 and bytes[length] >= 128 as u8 and
          bytes[length] <= 191 as u8 {
        set length -= 1;
    }
    return text.slice(0, length);
}

proc help_find_bytes(text: string, needle: string) -> usize {
    let text_bytes: [u8] = text.bytes();
    let needle_bytes: [u8] = needle.bytes();
    if needle_bytes.len() == 0 {
        return 0;
    }
    if needle_bytes.len() > text_bytes.len() {
        return 18446744073709551615 as usize;
    }
    let mut start: usize = 0;
    while start + needle_bytes.len() <= text_bytes.len() {
        let mut offset: usize = 0;
        let mut matched: bool = true;
        while offset < needle_bytes.len() {
            if text_bytes[start + offset] != needle_bytes[offset] {
                set matched = false;
                break;
            }
            set offset += 1;
        }
        if matched {
            return start;
        }
        set start += 1;
    }
    return 18446744073709551615 as usize;
}

proc help_extract_expected_token(reason: string) -> HelpExpectedTokens {
    let trimmed = help_trim(reason);
    let bytes: [u8] = trimmed.bytes();
    let prefix = "expected ";
    if bytes.len() < prefix.bytes().len() or
       trimmed.slice(0, prefix.bytes().len()) != prefix {
        return HelpExpectedTokens { valid: false, expected: "", found: "" };
    }

    let suffix_position = help_find_bytes(trimmed, ", found ");
    let expected_end = if suffix_position ==
        18446744073709551615 as usize {
        bytes.len()
    } else {
        suffix_position
    };
    let expected = help_prefix_bytes(
        help_trim(trimmed.slice(prefix.bytes().len(), expected_end)),
        HELP_EXPECTED_TOKEN_LIMIT - 1
    );
    if expected == "" {
        return HelpExpectedTokens { valid: false, expected: "", found: "" };
    }

    let mut found = "";
    if suffix_position != 18446744073709551615 as usize {
        found = help_prefix_bytes(
            help_trim(trimmed.slice(
                suffix_position + ", found ".bytes().len(),
                bytes.len()
            )),
            HELP_EXPECTED_TOKEN_LIMIT - 1
        );
    }

    return HelpExpectedTokens {
        valid: true,
        expected: expected,
        found: found,
    };
}

proc help_type_is_integer(name: string) -> bool {
    return name == "int" or name == "uint" or
        name == "i8" or name == "i16" or name == "i32" or
        name == "i64" or name == "i128" or name == "u8" or
        name == "u16" or name == "u32" or name == "u64" or
        name == "u128" or name == "isize" or name == "usize";
}

proc help_type_is_float(name: string) -> bool {
    return name == "float" or name == "f32" or name == "f64";
}

proc help_type_is_numeric(name: string) -> bool {
    return help_type_is_integer(name) or help_type_is_float(name);
}

proc help_type_is_string(name: string) -> bool {
    return name == "string" or name == "str";
}

proc help_format_type_mismatch(
    diagnostic_value: *const Diagnostic,
    source_text: string
) -> ?string {
    if diagnostic_value == null or
       not help_text_present(diagnostic_value.expected_type) or
       not help_text_present(diagnostic_value.actual_type) {
        return null;
    }

    let mut output = "Provide a value of type ";
    set output += help_quote_fragment(
        diagnostic_value.expected_type,
        HELP_TYPE_LIMIT
    );
    set output += " instead of ";
    set output += help_quote_fragment(
        diagnostic_value.actual_type,
        HELP_TYPE_LIMIT
    );
    if help_text_present(source_text) {
        set output += " for ";
        set output += help_quote_fragment(source_text, HELP_SUBJECT_LIMIT);
    }
    set output += ". ";

    if help_type_is_string(diagnostic_value.actual_type) and
       help_type_is_numeric(diagnostic_value.expected_type) {
        set output += "If the text represents user or file input, parse it as a numeric value and handle invalid input before using the result.";
    } else if help_type_is_numeric(diagnostic_value.actual_type) and
              help_type_is_string(diagnostic_value.expected_type) {
        set output += "Format the numeric value explicitly when textual representation is intended instead of relying on an unrelated cast.";
    } else if help_type_is_integer(diagnostic_value.actual_type) and
              help_type_is_integer(diagnostic_value.expected_type) {
        set output += "Check the value range and signedness before applying an explicit integer conversion.";
    } else if help_type_is_float(diagnostic_value.actual_type) and
              help_type_is_integer(diagnostic_value.expected_type) {
        set output += "An integer conversion can discard a fractional component or exceed the destination range; make that behavior explicit only when it is intended.";
    } else if help_type_is_integer(diagnostic_value.actual_type) and
              help_type_is_float(diagnostic_value.expected_type) {
        set output += "Use an explicit numeric conversion when the destination representation is intentional and its precision is acceptable.";
    } else if diagnostic_value.expected_type == "bool" {
        set output += "Produce a boolean expression explicitly, normally with a comparison or another operation whose result type is `bool`.";
    } else {
        set output += "Check the declaration establishing the required type and convert explicitly only when the conversion preserves the intended semantics.";
    }
    return output;
}

proc help_format_parser_expectation(reason: string) -> ?string {
    let tokens = help_extract_expected_token(reason);
    if not tokens.valid {
        return null;
    }
    let mut output = "Insert or restore ";
    set output += help_quote_fragment(tokens.expected, HELP_EXPECTED_TOKEN_LIMIT);
    if help_text_present(tokens.found) {
        set output += " before ";
        set output += help_quote_fragment(tokens.found, HELP_EXPECTED_TOKEN_LIMIT);
    }
    set output += ". Match the expected element to the surrounding grammar and the nearest corresponding opening construct.";
    return output;
}

proc help_format_subject(prefix: string, subject: string, suffix: string) -> ?string {
    if not help_text_present(subject) {
        return null;
    }
    return prefix + help_quote_fragment(subject, HELP_SUBJECT_LIMIT) + suffix;
}

proc help_format_boolean_condition(diagnostic_value: *const Diagnostic) -> ?string {
    if diagnostic_value == null or
       not help_text_present(diagnostic_value.actual_type) {
        return null;
    }
    return "Convert the condition into an explicit boolean expression instead of using a value of type " +
        help_quote_fragment(diagnostic_value.actual_type, HELP_TYPE_LIMIT) +
        ". Choose a comparison or predicate that expresses the intended condition.";
}

proc help_format_contract(
    diagnostic_value: *const Diagnostic,
    policy: string
) -> ?string {
    if diagnostic_value == null or
       diagnostic_value.contract.kind == DiagnosticContractKind.None or
       not help_text_present(diagnostic_value.contract.expression) {
        return null;
    }
    let mut output = "";
    if help_text_present(policy) {
        set output += policy;
        set output += " ";
    }
    set output += "Contract condition: ";
    set output += help_quote_fragment(
        diagnostic_value.contract.expression,
        HELP_CONTRACT_LIMIT
    );
    set output += ".";
    if help_text_present(diagnostic_value.contract.reason) {
        set output += " Reported reason: ";
        set output += help_quote_fragment(
            diagnostic_value.contract.reason,
            HELP_REASON_LIMIT
        );
        set output += ".";
    }
    return output;
}

proc help_registry_entry(
    diagnostic_value: *const Diagnostic
) -> *const DiagnosticRegistryEntry {
    if diagnostic_value == null {
        return null;
    }
    let mut entry: *const DiagnosticRegistryEntry = null;
    if help_text_present(diagnostic_value.code) {
        entry = vitte_diagnostic_registry_find_internal(diagnostic_value.code);
        if entry == null {
            entry = vitte_diagnostic_registry_find_public(diagnostic_value.code);
        }
    }
    if entry == null and help_text_present(diagnostic_value.short_code) {
        entry = vitte_diagnostic_registry_find_public(diagnostic_value.short_code);
        if entry == null {
            entry = vitte_diagnostic_registry_find_internal(diagnostic_value.short_code);
        }
    }
    return entry;
}

proc help_public_code(
    diagnostic_value: *const Diagnostic,
    entry: *const DiagnosticRegistryEntry
) -> string {
    if entry != null and help_text_present(entry.public_code) {
        return entry.public_code;
    }
    if diagnostic_value != null and help_text_present(diagnostic_value.short_code) {
        return diagnostic_value.short_code;
    }
    return "";
}

proc help_append_semantic_context(
    output: string,
    diagnostic_value: *const Diagnostic,
    include_types: bool
) -> string {
    let mut result = output;
    if diagnostic_value == null {
        return result;
    }
    if help_text_present(diagnostic_value.symbol) {
        set result += " Concerned symbol: ";
        set result += help_quote_fragment(diagnostic_value.symbol, HELP_SUBJECT_LIMIT);
        set result += ".";
    }
    if include_types and help_text_present(diagnostic_value.expected_type) {
        set result += " Required type: ";
        set result += help_quote_fragment(diagnostic_value.expected_type, HELP_TYPE_LIMIT);
        set result += ".";
    }
    if include_types and help_text_present(diagnostic_value.actual_type) {
        set result += " Actual type: ";
        set result += help_quote_fragment(diagnostic_value.actual_type, HELP_TYPE_LIMIT);
        set result += ".";
    }
    return result;
}

proc help_append_compilation_context(
    output: string,
    diagnostic_value: *const Diagnostic
) -> string {
    let mut result = output;
    if diagnostic_value == null {
        return result;
    }
    if help_text_present(diagnostic_value.procedure) {
        set result += " In procedure ";
        set result += help_quote_fragment(diagnostic_value.procedure, 256);
        set result += ".";
    } else if help_text_present(diagnostic_value.module) {
        set result += " In module ";
        set result += help_quote_fragment(diagnostic_value.module, 256);
        set result += ".";
    }
    return result;
}

proc help_append_reference(output: string, public_code: string) -> string {
    if not help_text_present(public_code) {
        return output;
    }
    return output + " See `vitte explain " + public_code + "`.";
}

proc help_format_fallback(
    diagnostic_value: *const Diagnostic,
    reason: string
) -> string {
    if diagnostic_value == null {
        return "";
    }
    let identifier = if help_text_present(diagnostic_value.short_code) {
        diagnostic_value.short_code
    } else {
        diagnostic_value.code
    };
    let phase = origin_name(diagnostic_value.origin);
    let mut output = "No verified correction is registered for ";
    if help_text_present(identifier) {
        set output += help_quote_fragment(identifier, 128);
    } else {
        set output += "this unclassified diagnostic";
    }
    if help_text_present(phase) {
        set output += " from compiler phase ";
        set output += help_quote_fragment(phase, 64);
    }
    set output += ".";
    if help_text_present(diagnostic_value.message) {
        set output += " Failure: ";
        set output += help_quote_fragment(diagnostic_value.message, HELP_REASON_LIMIT);
        set output += ".";
    }
    if help_text_present(reason) {
        set output += " Detail: ";
        set output += help_quote_fragment(reason, HELP_REASON_LIMIT);
        set output += ".";
    }
    let cause = help_first_cause(diagnostic_value);
    if help_text_present(cause) and cause != reason {
        set output += " Investigate the reported cause: ";
        set output += help_quote_fragment(cause, HELP_REASON_LIMIT);
        set output += ".";
    }
    if diagnostic_value.origin == DiagnosticOrigin.Internal or
       diagnostic_value.severity == DiagnosticSeverity.Fatal {
        set output += " Preserve the failing command, compiler version and smallest reproducing input for a compiler report.";
    }
    return output;
}

proc help_format_text(
    diagnostic_value: *const Diagnostic,
    sources: *const SourceContext
) -> string {
    if diagnostic_value == null {
        return "";
    }

    let explicit = help_explicit_annotation(diagnostic_value);
    if help_text_present(explicit) {
        return explicit;
    }

    if diagnostic_value.severity != DiagnosticSeverity.Warning and
       diagnostic_value.severity != DiagnosticSeverity.Error and
       diagnostic_value.severity != DiagnosticSeverity.Fatal {
        return "";
    }

    let entry = help_registry_entry(diagnostic_value);
    let public_code = help_public_code(diagnostic_value, entry);
    let policy = vitte_diagnostic_help_for_code(public_code);
    let reason = help_detail(diagnostic_value);
    let source_text = help_source_excerpt(diagnostic_value, sources);
    let subject = if help_text_present(diagnostic_value.symbol) {
        diagnostic_value.symbol
    } else {
        source_text
    };

    let mut output = "";
    let mut specialized: bool = false;
    let mut include_types: bool = true;

    if public_code == "E0501" or public_code == "E0602" or
       public_code == "E0605" {
        let type_help = help_format_type_mismatch(diagnostic_value, source_text);
        if type_help != null {
            set output = type_help?;
            set specialized = true;
            set include_types = false;
        }
    }

    if not specialized and
       (public_code == "E0201" or public_code == "E0207" or
        public_code == "E0208") {
        let mut parser_reason = reason;
        if not help_text_present(parser_reason) and
           help_text_present(diagnostic_value.expected) {
            set parser_reason = "expected " + diagnostic_value.expected;
            if help_text_present(diagnostic_value.found) {
                set parser_reason += ", found " + diagnostic_value.found;
            }
        }
        let parser_help = help_format_parser_expectation(parser_reason);
        if parser_help != null {
            set output = parser_help?;
            set specialized = true;
        }
    }

    if not specialized and public_code == "E0401" {
        let name_help = help_format_subject(
            "Declare or import ",
            subject,
            " in this scope, or correct its spelling to match a visible declaration."
        );
        if name_help != null {
            set output = name_help?;
            set specialized = true;
        }
    }

    if not specialized and public_code == "E0510" {
        let type_help = help_format_subject(
            "Declare or import the type ",
            subject,
            " before using it here; verify the type's spelling, module and visibility."
        );
        if type_help != null {
            set output = type_help?;
            set specialized = true;
        }
    }

    if not specialized and public_code == "E0515" {
        let bool_help = help_format_boolean_condition(diagnostic_value);
        if bool_help != null {
            set output = bool_help?;
            set specialized = true;
            set include_types = false;
        }
    }

    if not specialized {
        let contract_help = help_format_contract(diagnostic_value, policy);
        if contract_help != null {
            set output = contract_help?;
            set specialized = true;
        }
    }

    if not specialized and help_text_present(policy) {
        set output = policy;
        set specialized = true;
    }

    if not specialized {
        set output = help_format_fallback(diagnostic_value, reason);
    } else {
        if (public_code == "E0005" or public_code == "E0011" or
            public_code == "E0013") and help_text_present(reason) {
            set output += " Reported failure: ";
            set output += help_quote_fragment(reason, HELP_REASON_LIMIT);
            set output += ".";
        }
        if public_code != "E0401" and public_code != "E0510" {
            set output = help_append_semantic_context(
                output,
                diagnostic_value,
                include_types
            );
        }
    }

    set output = help_append_compilation_context(output, diagnostic_value);
    set output = help_append_reference(output, public_code);
    return output;
}

export proc vitte_diagnostic_help_for_code(code: string) -> string {
    let index = help_rule_index(code);
    if index >= HELP_RULE_CODES.len() or index >= HELP_RULE_TEXTS.len() {
        return "";
    }
    return HELP_RULE_TEXTS[index];
}

export proc vitte_diagnostic_help_has_policy(public_code: string) -> bool {
    return help_text_present(vitte_diagnostic_help_for_code(public_code));
}

export proc vitte_diagnostic_has_help(
    diagnostic_value: *const Diagnostic
) -> bool {
    return help_text_present(help_explicit_annotation(diagnostic_value));
}

export proc vitte_diagnostic_help_available(
    diagnostic_value: *const Diagnostic
) -> bool {
    if diagnostic_value == null {
        return false;
    }
    if vitte_diagnostic_has_help(diagnostic_value) {
        return true;
    }
    return vitte_diagnostic_help_has_policy(diagnostic_value.short_code) or
        vitte_diagnostic_help_has_policy(diagnostic_value.code);
}

export proc vitte_diagnostic_format_help(
    diagnostic_value: *const Diagnostic,
    sources: *const SourceContext,
    buffer: *mut u8,
    capacity: usize
) -> bool {
    if buffer == null or capacity == 0 {
        return false;
    }
    set buffer[0 as i64] = 0 as u8;
    if diagnostic_value == null {
        return false;
    }
    return help_copy_to_buffer(
        buffer,
        capacity,
        help_format_text(diagnostic_value, sources)
    );
}

export proc vitte_diagnostic_help_rule_count() -> usize {
    return HELP_RULE_CODES.len();
}

export proc vitte_diagnostic_help_rule_code(index: usize) -> string {
    if index >= HELP_RULE_CODES.len() {
        return "";
    }
    return HELP_RULE_CODES[index];
}

export proc vitte_diagnostic_help_rule_text(index: usize) -> string {
    if index >= HELP_RULE_TEXTS.len() {
        return "";
    }
    return HELP_RULE_TEXTS[index];
}

export proc vitte_diagnostic_help_validate_rules(
    missing_count: *mut usize,
    orphan_count: *mut usize,
    duplicate_count: *mut usize
) -> bool {
    let mut missing: usize = 0;
    let mut orphan: usize = 0;
    let mut duplicate: usize = 0;
    let registry_count = diagnostic_registry_count();
    let mut registry_index: usize = 0;

    while registry_index < registry_count {
        let registry_entry = diagnostic_registry_at(registry_index);
        if registry_entry != null and help_text_present(registry_entry.public_code) and
           registry_entry.default_severity != DiagnosticSeverity.Note and
           registry_entry.default_severity != DiagnosticSeverity.Help and
           help_rule_index(registry_entry.public_code) >= HELP_RULE_CODES.len() {
            set missing += 1;
        }
        set registry_index += 1;
    }

    let mut rule_index: usize = 0;
    while rule_index < HELP_RULE_CODES.len() {
        if vitte_diagnostic_registry_find_public(HELP_RULE_CODES[rule_index]) == null {
            set orphan += 1;
        }
        let mut other: usize = rule_index + 1;
        while other < HELP_RULE_CODES.len() {
            if HELP_RULE_CODES[rule_index] == HELP_RULE_CODES[other] {
                set duplicate += 1;
            }
            set other += 1;
        }
        set rule_index += 1;
    }

    if missing_count != null {
        set missing_count[0] = missing;
    }
    if orphan_count != null {
        set orphan_count[0] = orphan;
    }
    if duplicate_count != null {
        set duplicate_count[0] = duplicate;
    }

    return missing == 0 and orphan == 0 and duplicate == 0;
}

/// Compatibility name used by the Vitte explanation layer.
export proc diagnostic_help_for_code(code: string) -> string {
    return vitte_diagnostic_help_for_code(code);
}
