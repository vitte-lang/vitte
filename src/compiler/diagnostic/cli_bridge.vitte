    replacement: *const char
}

export form CliDiagnosticSuggestion {
    message: *const char,
    applicability: CliDiagnosticApplicability,
    confidence: CliDiagnosticConfidence,
    preferred: bool,
    suggestion_id: u64,
    has_span: bool,
    span: CliDiagnosticSpan,
    has_replacement: bool,
    replacement: *const char,
    parts: *const CliDiagnosticFixPart,
    part_count: usize
}

export form CliDiagnosticTrace {
    kind: CliDiagnosticTraceKind,
    message: *const char,
    has_span: bool,
    span: CliDiagnosticSpan
}

export form CliDiagnosticContract {
    kind: CliDiagnosticContractKind,
    expression: *const char,
    procedure: *const char,
