}

export form CliDiagnosticStatistics {
    total: usize,
    note_count: usize,
    help_count: usize,
    warning_count: usize,
    error_count: usize,
    fatal_count: usize,
    primary_count: usize,
    cascade_count: usize,
    suppressed_count: usize,
    machine_fix_count: usize
}

const CLI_TRANSPORT_MAGIC: u64 = 0x5649545445444941;
const CLI_TRANSPORT_TEXT_SLOTS: usize = 11;

form CliDiagnosticTransportHeader {
    magic: u64,
    count: usize,
    owned_text: *mut *const char,
    suggestions: *mut CliDiagnosticSuggestion,
    related: *mut CliDiagnosticLocation
}

proc cli_transport_header(batch: *mut u8) -> *mut CliDiagnosticTransportHeader {
    if batch == null or (batch as usize) < sizeof(CliDiagnosticTransportHeader) { return null; }
    let header = ((batch as usize) - sizeof(CliDiagnosticTransportHeader)) as *mut CliDiagnosticTransportHeader;
    if (*header).magic != CLI_TRANSPORT_MAGIC { return null; }
    return header;
}

proc cli_transport_copy_text(
    header: *mut CliDiagnosticTransportHeader,
    index: usize,
    slot: usize,
    source: *const char,
    output: *mut *const char
) -> bool {
    if header == null or output == null or index >= (*header).count or slot >= CLI_TRANSPORT_TEXT_SLOTS {
        return false;
    }
    set *output = null;
    if source == null { return true; }
    let slot_index: usize = index * CLI_TRANSPORT_TEXT_SLOTS + slot;
    let old_text = (*header).owned_text[slot_index];
    set (*header).owned_text[slot_index] = null;
    if old_text != null { deallocate(old_text as *mut u8); }
    let source_length: usize = cstring_length(source as *const u8);
    if source_length == usize.MAX { return false; }
    let copied = allocate(source_length + 1);
    if copied == null { return false; }
    let source_bytes = source as *const u8;
    let mut byte_index: usize = 0;
    while byte_index < source_length {
        set copied[byte_index] = source_bytes[byte_index];
        set byte_index += 1;
    }
    set copied[source_length] = 0;
    set (*header).owned_text[slot_index] = copied as *const char;
    set *output = copied as *const char;
    return true;
}

proc cli_transport_cstr_equals(source: *const char, expected: string) -> bool {
    if source == null { return false; }
    let source_bytes = source as *const u8;
    let expected_bytes = expected.as_bytes();
    let mut index: usize = 0;
    while index < expected_bytes.len() {
        if source_bytes[index] != expected_bytes[index] { return false; }
        set index += 1;
    }
    return source_bytes[index] == 0;
}

proc cli_transport_cstr_starts_with(source: *const char, expected: string) -> bool {
    if source == null { return false; }
    let source_bytes = source as *const u8;
    let expected_bytes = expected.as_bytes();
    let mut index: usize = 0;
    while index < expected_bytes.len() {
        if source_bytes[index] != expected_bytes[index] { return false; }
        set index += 1;
    }
    return true;
}

export proc vitte_cli_diagnostic_transport_create(count: usize) -> *mut u8 {
    if count == 0 or count > (usize.MAX - sizeof(CliDiagnosticTransportHeader)) / sizeof(CliDiagnostic) {
        return null;
    }
    if count > usize.MAX / CLI_TRANSPORT_TEXT_SLOTS / sizeof(*const char) or
       count > usize.MAX / sizeof(CliDiagnosticSuggestion) or
       count > usize.MAX / sizeof(CliDiagnosticLocation) {
        return null;
    }
    let block_size: usize = sizeof(CliDiagnosticTransportHeader) + count * sizeof(CliDiagnostic);
    let block = allocate(block_size);
    if block == null { return null; }
    let header = block as *mut CliDiagnosticTransportHeader;
    let diagnostics = add_bytes(block, sizeof(CliDiagnosticTransportHeader)) as *mut CliDiagnostic;
    let text_slot_count: usize = count * CLI_TRANSPORT_TEXT_SLOTS;
    let owned_text = allocate(text_slot_count * sizeof(*const char)) as *mut *const char;
    let suggestions = allocate(count * sizeof(CliDiagnosticSuggestion)) as *mut CliDiagnosticSuggestion;
    let related = allocate(count * sizeof(CliDiagnosticLocation)) as *mut CliDiagnosticLocation;
    if owned_text == null or suggestions == null or related == null {
        if owned_text != null { deallocate(owned_text as *mut u8); }
        if suggestions != null { deallocate(suggestions as *mut u8); }
        if related != null { deallocate(related as *mut u8); }
        deallocate(block);
        return null;
    }
    fill(block, 0, block_size);
    fill(owned_text as *mut u8, 0, text_slot_count * sizeof(*const char));
    fill(suggestions as *mut u8, 0, count * sizeof(CliDiagnosticSuggestion));
    fill(related as *mut u8, 0, count * sizeof(CliDiagnosticLocation));
    set (*header).magic = CLI_TRANSPORT_MAGIC;
    set (*header).count = count;
    set (*header).owned_text = owned_text;
    set (*header).suggestions = suggestions;
    set (*header).related = related;
    let mut index: usize = 0;
    while index < count {
        vitte_cli_diagnostic_init(&mut diagnostics[index]);
        set index += 1;
    }
    return diagnostics as *mut u8;
}

export proc vitte_cli_diagnostic_transport_set(
    batch: *mut u8,
    count: usize,
    index: usize,
    diagnostic_id: u64,
    code: *const char,
    severity: u32,
    origin: u32,
    message: *const char,
    details: *const char,
    help: *const char,
    has_span: bool,
    file_id: u32,
    source_id: u64,
    source_name: *const char,
    start_offset: usize,
    end_offset: usize,
    start_line: usize,
    start_column: usize,
    end_line: usize,
    end_column: usize,
    expected: *const char,
    found: *const char
) -> bool {
    let header = cli_transport_header(batch);
    if header == null or count != (*header).count or index >= count or code == null or message == null or
       severity > CliDiagnosticSeverity.Fatal as u32 or origin > CliDiagnosticOrigin.Internal as u32 or
       (has_span and end_offset < start_offset) {
        return false;
    }
    let mut owned_code: *const char = null;
    let mut owned_message: *const char = null;
    let mut owned_help: *const char = null;
    let mut owned_expected: *const char = null;
    let mut owned_found: *const char = null;
    let mut owned_source_name: *const char = null;
    if not cli_transport_copy_text(header, index, 0, code, &mut owned_code) or
       not cli_transport_copy_text(header, index, 1, message, &mut owned_message) or
       not cli_transport_copy_text(header, index, 2, help, &mut owned_help) or
       not cli_transport_copy_text(header, index, 3, expected, &mut owned_expected) or
       not cli_transport_copy_text(header, index, 4, found, &mut owned_found) or
       not cli_transport_copy_text(header, index, 5, source_name, &mut owned_source_name) {
        return false;
    }

    let diagnostics = add_bytes(batch, 0) as *mut CliDiagnostic;
    let diag_entry = &mut diagnostics[index];
    vitte_cli_diagnostic_init(diag_entry);
    set (*diag_entry).diagnostic_id = diagnostic_id;
    set (*diag_entry).code = owned_code;
    set (*diag_entry).severity = severity as CliDiagnosticSeverity;
    set (*diag_entry).origin = origin as CliDiagnosticOrigin;
    set (*diag_entry).message = owned_message;
    set (*diag_entry).help = owned_help;
    set (*diag_entry).expected = owned_expected;
    set (*diag_entry).found = owned_found;
    set (*diag_entry).is_primary = true;
    set (*diag_entry).poisons_analysis = severity == CliDiagnosticSeverity.Error as u32 or
        severity == CliDiagnosticSeverity.Fatal as u32;
    if details != null {
        let details_length = cstring_length(details as *const u8);
        let details_bytes = details as *const u8;
        let mut copy_length = details_length;
        if copy_length >= sizeof((*diag_entry).details_storage) { set copy_length = sizeof((*diag_entry).details_storage) - 1; }
        let mut detail_index: usize = 0;
        while detail_index < copy_length {
            set (*diag_entry).details_storage[detail_index] = details_bytes[detail_index];
            set detail_index += 1;
        }
        set (*diag_entry).details_storage[copy_length] = 0;
        if copy_length != 0 { set (*diag_entry).details = (&mut (*diag_entry).details_storage[0]) as *mut u8 as *const char; }
    }
    if has_span {
        set (*diag_entry).has_span = true;
        set (*diag_entry).file_id = file_id;
        set (*diag_entry).source_id = source_id;
        set (*diag_entry).source_name = owned_source_name;
        set (*diag_entry).start_offset = start_offset;
        set (*diag_entry).end_offset = end_offset;
        set (*diag_entry).start_line = start_line;
        set (*diag_entry).start_column = start_column;
        set (*diag_entry).end_line = end_line;
        set (*diag_entry).end_column = end_column;
    }

    if has_span and owned_source_name != null and origin == CliDiagnosticOrigin.Lexer as u32 and
       cli_transport_cstr_equals(code, "VITTE_LEXER_E_INVALID_CHARACTER") and
       cli_transport_cstr_starts_with(details, "invalid character `'" ) {
        let suggestion = &mut (*header).suggestions[index];
        set (*suggestion).message = "Insert the missing closing `'` here.".as_ptr() as *const char;
        set (*suggestion).applicability = CliDiagnosticApplicability.Machine;
        set (*suggestion).confidence = CliDiagnosticConfidence.High;
        set (*suggestion).preferred = true;
        set (*suggestion).suggestion_id = diagnostic_id;
        set (*suggestion).has_span = true;
        set (*suggestion).span = CliDiagnosticSpan {
            valid: true, file_id: file_id, source_id: source_id, source_name: owned_source_name,
            start_offset: start_offset, end_offset: end_offset, start_line: start_line,
            start_column: start_column, end_line: end_line, end_column: end_column
        };
        set (*diag_entry).suggestions = suggestion as *const CliDiagnosticSuggestion;
        set (*diag_entry).suggestion_count = 1;
    }
    return true;
}

export proc vitte_cli_diagnostic_transport_set_semantic(
    batch: *mut u8,
    count: usize,
    index: usize,
    symbol: *const char,
    probable_cause: *const char,
    context: *const char,
    has_related: bool,
    related_file_id: u32,
    related_source_id: u64,
    related_source_name: *const char,
    related_start_offset: usize,
    related_end_offset: usize,
    related_start_line: usize,
    related_start_column: usize,
    related_end_line: usize,
    related_end_column: usize,
    related_label: *const char
) -> bool {
    let header = cli_transport_header(batch);
    if header == null or count != (*header).count or index >= count or
       (has_related and (related_end_offset < related_start_offset or related_source_name == null or related_label == null)) {
        return false;
    }
    let mut owned_symbol: *const char = null;
    let mut owned_cause: *const char = null;
    let mut owned_context: *const char = null;
    let mut owned_related_source: *const char = null;
    let mut owned_related_label: *const char = null;
    if not cli_transport_copy_text(header, index, 6, symbol, &mut owned_symbol) or
       not cli_transport_copy_text(header, index, 7, probable_cause, &mut owned_cause) or
       not cli_transport_copy_text(header, index, 8, context, &mut owned_context) or
       not cli_transport_copy_text(header, index, 9, related_source_name, &mut owned_related_source) or
       not cli_transport_copy_text(header, index, 10, related_label, &mut owned_related_label) {
        return false;
    }
    let diagnostics = add_bytes(batch, 0) as *mut CliDiagnostic;
    set diagnostics[index].symbol = owned_symbol;
    set diagnostics[index].probable_cause = owned_cause;
    set diagnostics[index].context = owned_context;
    if not has_related { return true; }
    let location = &mut (*header).related[index];
    set (*location).kind = CliDiagnosticLocationKind.Related;
    set (*location).label = owned_related_label;
    set (*location).span = CliDiagnosticSpan {
        valid: true, file_id: related_file_id, source_id: related_source_id,
        source_name: owned_related_source, start_offset: related_start_offset,
        end_offset: related_end_offset, start_line: related_start_line,
        start_column: related_start_column, end_line: related_end_line,
        end_column: related_end_column
    };
    set diagnostics[index].related = location as *const CliDiagnosticLocation;
    set diagnostics[index].related_count = 1;
    return true;
}

export proc vitte_cli_diagnostic_transport_destroy(batch: *mut u8) {
    let header = cli_transport_header(batch);
    if header == null { return; }
    let mut index: usize = 0;
    while index < (*header).count {
        let mut slot: usize = 0;
        while slot < CLI_TRANSPORT_TEXT_SLOTS {
            let text_index: usize = index * CLI_TRANSPORT_TEXT_SLOTS + slot;
            let text = (*header).owned_text[text_index];
            if text != null { deallocate(text as *mut u8); }
            set slot += 1;
        }
        set index += 1;
    }
    let owned_text = (*header).owned_text;
    let suggestions = (*header).suggestions;
    let related = (*header).related;
    set (*header).magic = 0;
    deallocate(owned_text as *mut u8);
    deallocate(suggestions as *mut u8);
    deallocate(related as *mut u8);
    deallocate(header as *mut u8);
}

export proc vitte_cli_diagnostic_init(diagnostic_value: *mut CliDiagnostic) {
    if diagnostic_value == null {
        return;
    }

    fill(diagnostic_value as *mut u8, 0, sizeof(CliDiagnostic));
    set (*diagnostic_value).severity = CliDiagnosticSeverity.Error;
    set (*diagnostic_value).origin = CliDiagnosticOrigin.Unknown;
    set (*diagnostic_value).source_id = 0;
    set (*diagnostic_value).parent_diagnostic = VITTE_CLI_DIAGNOSTIC_INDEX_NONE;
    set (*diagnostic_value).root_diagnostic = VITTE_CLI_DIAGNOSTIC_INDEX_NONE;
    set (*diagnostic_value).is_primary = true;
}

export proc vitte_cli_diagnostic_span_init(span: *mut CliDiagnosticSpan) {
    if span == null {
        return;
    }

    fill(span as *mut u8, 0, sizeof(CliDiagnosticSpan));
    set (*span).source_id = 0;
}

export proc vitte_cli_diagnostic_render_options_init(options: *mut CliDiagnosticRenderOptions) {
    if options == null {
        return;
    }

    fill(options as *mut u8, 0, sizeof(CliDiagnosticRenderOptions));
    set (*options).format = CliDiagnosticFormat.Terminal;
    set (*options).show_source = true;
    set (*options).show_source_line = true;
    set (*options).show_codes = true;
    set (*options).show_details = true;
    set (*options).show_origin = true;
    set (*options).show_category = true;
    set (*options).show_labels = true;
    set (*options).show_expected_found = true;
    set (*options).show_causes = true;
    set (*options).show_notes = true;
    set (*options).show_help = true;
    set (*options).show_related = true;
    set (*options).show_suggestions = true;
    set (*options).show_trace = true;
    set (*options).show_cascades = true;
    set (*options).show_summary = true;
    set (*options).context_lines_before = 1;
    set (*options).context_lines_after = 1;
    set (*options).position_encoding = 1;
    set (*options).pretty = true;
    set (*options).trailing_newline = true;
}

export proc vitte_cli_diagnostic_statistics_init(statistics: *mut CliDiagnosticStatistics) {
    if statistics == null {
        return;
    }

    fill(statistics as *mut u8, 0, sizeof(CliDiagnosticStatistics));
}

proc cli_bridge_cstring(text: *const char) -> string {
    if text == null { return ""; }
    let text_bytes = text as *const u8;
    let mut length: usize = 0;
    while text_bytes[length] != 0 { set length += 1; }
    return string.from_bytes(text_bytes as *mut u8, length);
}

proc cli_bridge_array_is_valid(items: *const char, count: usize, maximum: usize) -> bool {
    if count > maximum { return false; }
    return count == 0 or items != null;
}

export proc vitte_cli_diagnostic_severity_is_valid(severity: CliDiagnosticSeverity) -> bool {
    return severity >= CliDiagnosticSeverity.Note and severity <= CliDiagnosticSeverity.Fatal;
}

export proc vitte_cli_diagnostic_format_is_valid(format: CliDiagnosticFormat) -> bool {
    return format >= CliDiagnosticFormat.Terminal and
           format <= CliDiagnosticFormat.Lsp;
}

export proc vitte_cli_diagnostic_origin_is_valid(origin: CliDiagnosticOrigin) -> bool {
    return origin >= CliDiagnosticOrigin.Unknown and origin <= CliDiagnosticOrigin.Internal;
}

export proc vitte_cli_diagnostic_span_is_valid(span: *const CliDiagnosticSpan) -> bool {
    if span == null or not (*span).valid or (*span).end_offset < (*span).start_offset { return false; }
    return (*span).source_id != 0 or (*span).source_name != null;
}

export proc vitte_cli_diagnostic_validate(diagnostic_value: *const CliDiagnostic) -> bool {
    if diagnostic_value == null or
       not vitte_cli_diagnostic_severity_is_valid((*diagnostic_value).severity) or
       not vitte_cli_diagnostic_origin_is_valid((*diagnostic_value).origin) or
       (*diagnostic_value).message == null or
       cli_bridge_cstring((*diagnostic_value).message).len() == 0 { return false; }
    if (*diagnostic_value).has_span {
        let span: CliDiagnosticSpan = CliDiagnosticSpan {
            valid: true,
            file_id: (*diagnostic_value).file_id,
            source_id: (*diagnostic_value).source_id,
            source_name: (*diagnostic_value).source_name,
            start_offset: (*diagnostic_value).start_offset,
            end_offset: (*diagnostic_value).end_offset,
            start_line: (*diagnostic_value).start_line,
            start_column: (*diagnostic_value).start_column,
            end_line: (*diagnostic_value).end_line,
            end_column: (*diagnostic_value).end_column
        };
        if not vitte_cli_diagnostic_span_is_valid(&span) { return false; }
    }
    return cli_bridge_array_is_valid((*diagnostic_value).labels as *const char, (*diagnostic_value).label_count, VITTE_CLI_DIAGNOSTIC_MAX_LABELS) and
        cli_bridge_array_is_valid((*diagnostic_value).related as *const char, (*diagnostic_value).related_count, VITTE_CLI_DIAGNOSTIC_MAX_RELATED) and
        cli_bridge_array_is_valid((*diagnostic_value).causes as *const char, (*diagnostic_value).cause_count, VITTE_CLI_DIAGNOSTIC_MAX_CAUSES) and
        cli_bridge_array_is_valid((*diagnostic_value).annotations as *const char, (*diagnostic_value).annotation_count, VITTE_CLI_DIAGNOSTIC_MAX_ANNOTATIONS) and
        cli_bridge_array_is_valid((*diagnostic_value).suggestions as *const char, (*diagnostic_value).suggestion_count, VITTE_CLI_DIAGNOSTIC_MAX_SUGGESTIONS) and
        cli_bridge_array_is_valid((*diagnostic_value).trace as *const char, (*diagnostic_value).trace_count, VITTE_CLI_DIAGNOSTIC_MAX_TRACE);
}

export proc vitte_cli_diagnostic_validate_batch(diagnostics: *const CliDiagnostic, diagnostic_count: usize) -> bool {
    if diagnostic_count != 0 and diagnostics == null { return false; }
    let mut index: usize = 0;
    while index < diagnostic_count {
        if not vitte_cli_diagnostic_validate(&diagnostics[index]) { return false; }
        set index += 1;
    }
    return true;
}

export proc vitte_cli_diagnostic_severity_name(severity: CliDiagnosticSeverity) -> string {
    match severity {
        case CliDiagnosticSeverity.Note => return "note";
        case CliDiagnosticSeverity.Help => return "help";
        case CliDiagnosticSeverity.Warning => return "warning";
        case CliDiagnosticSeverity.Error => return "error";
        case CliDiagnosticSeverity.Fatal => return "fatal";
        else => return "unknown"
    }
}

export proc vitte_cli_diagnostic_format_name(format: CliDiagnosticFormat) -> string {
    match format {
        case CliDiagnosticFormat.Terminal => return "terminal";
        case CliDiagnosticFormat.Json => return "json";
        case CliDiagnosticFormat.Sarif => return "sarif";
        case CliDiagnosticFormat.Lsp => return "lsp";
        else => return "unknown"
    }
}

export proc vitte_cli_diagnostic_origin_name(origin: CliDiagnosticOrigin) -> string {
    match origin {
        case CliDiagnosticOrigin.Unknown => return "unknown";
        case CliDiagnosticOrigin.Io => return "io";
        case CliDiagnosticOrigin.Lexer => return "lexer";
        case CliDiagnosticOrigin.Scanner => return "scanner";
        case CliDiagnosticOrigin.Parser => return "parser";
        case CliDiagnosticOrigin.Import => return "import";
        case CliDiagnosticOrigin.NameResolution => return "name-resolution";
        case CliDiagnosticOrigin.TypeCheck => return "type-check";
        case CliDiagnosticOrigin.Contract => return "contract";
        case CliDiagnosticOrigin.ConstantEval => return "constant-eval";
        case CliDiagnosticOrigin.Hir => return "hir";
        case CliDiagnosticOrigin.Ir => return "ir";
        case CliDiagnosticOrigin.Codegen => return "codegen";
        case CliDiagnosticOrigin.C17Backend => return "c17-backend";
        case CliDiagnosticOrigin.CCompiler => return "c-compiler";
        case CliDiagnosticOrigin.Linker => return "linker";
        case CliDiagnosticOrigin.Runtime => return "runtime";
        case CliDiagnosticOrigin.Driver => return "driver";
        case CliDiagnosticOrigin.Internal => return "internal";
        else => return "unknown"
    }
}

export proc vitte_cli_diagnostic_applicability_name(applicability: CliDiagnosticApplicability) -> string {
    match applicability {
        case CliDiagnosticApplicability.Machine => return "machine-applicable";
        case CliDiagnosticApplicability.Maybe => return "maybe-incorrect";
        case CliDiagnosticApplicability.Placeholders => return "has-placeholders";
        case CliDiagnosticApplicability.Manual => return "manual";
        else => return "unknown"
    }
}

export proc vitte_cli_diagnostic_confidence_name(confidence: CliDiagnosticConfidence) -> string {
    match confidence {
        case CliDiagnosticConfidence.None => return "none";
        case CliDiagnosticConfidence.Low => return "low";
        case CliDiagnosticConfidence.Medium => return "medium";
        case CliDiagnosticConfidence.High => return "high";
        case CliDiagnosticConfidence.Certain => return "certain";
        else => return "unknown"
    }
}

export proc vitte_cli_diagnostic_cause_kind_name(kind: CliDiagnosticCauseKind) -> string {
    match kind {
        case CliDiagnosticCauseKind.Unknown => return "unknown";
        case CliDiagnosticCauseKind.Syntax => return "syntax";
        case CliDiagnosticCauseKind.MissingToken => return "missing-token";
        case CliDiagnosticCauseKind.UnexpectedToken => return "unexpected-token";
        case CliDiagnosticCauseKind.UnresolvedName => return "unresolved-name";
        case CliDiagnosticCauseKind.TypeMismatch => return "type-mismatch";
        case CliDiagnosticCauseKind.ArityMismatch => return "arity-mismatch";
        case CliDiagnosticCauseKind.Constraint => return "constraint";
        case CliDiagnosticCauseKind.Import => return "import";
        case CliDiagnosticCauseKind.Contract => return "contract";
        case CliDiagnosticCauseKind.ConstantEval => return "constant-evaluation";
        case CliDiagnosticCauseKind.UnsafeOperation => return "unsafe-operation";
        case CliDiagnosticCauseKind.Lowering => return "lowering";
        case CliDiagnosticCauseKind.ExternalTool => return "external-tool";
        case CliDiagnosticCauseKind.Link => return "link";
        case CliDiagnosticCauseKind.Runtime => return "runtime";
        case CliDiagnosticCauseKind.Internal => return "internal";
        else => return "unknown"
    }
}

export proc vitte_cli_diagnostic_trace_kind_name(kind: CliDiagnosticTraceKind) -> string {
    match kind {
        case CliDiagnosticTraceKind.Call => return "call";
        case CliDiagnosticTraceKind.Instantiation => return "instantiation";
        case CliDiagnosticTraceKind.Constraint => return "constraint";
        case CliDiagnosticTraceKind.Import => return "import";
        case CliDiagnosticTraceKind.Expansion => return "expansion";
        case CliDiagnosticTraceKind.Lowering => return "lowering";
        case CliDiagnosticTraceKind.GeneratedCode => return "generated-code";
        case CliDiagnosticTraceKind.Related => return "related";
        else => return "unknown"
    }
}

export proc vitte_diagnostic_cli_code_exists(code: *const char) -> bool {
    if code == null { return false; }
    return vitte_diagnostic_registry_contains(cli_bridge_cstring(code));
}

export extern proc vitte_diagnostic_explain_cli(stream: *mut u8, code: *const char, json: bool) -> bool;

export proc vitte_diagnostic_cli_collect_statistics(diagnostics: *const CliDiagnostic, diagnostic_count: usize, statistics: *mut CliDiagnosticStatistics) -> bool {
    if statistics == null or (diagnostic_count != 0 and diagnostics == null) { return false; }
    vitte_cli_diagnostic_statistics_init(statistics);
    let mut index: usize = 0;
    while index < diagnostic_count {
        let diagnostic_value = &diagnostics[index];
        if not vitte_cli_diagnostic_validate(diagnostic_value) { return false; }
        set (*statistics).total += 1;
        match (*diagnostic_value).severity {
            case CliDiagnosticSeverity.Note => { set (*statistics).note_count += 1; },
            case CliDiagnosticSeverity.Help => { set (*statistics).help_count += 1; },
            case CliDiagnosticSeverity.Warning => { set (*statistics).warning_count += 1; },
            case CliDiagnosticSeverity.Error => { set (*statistics).error_count += 1; },
            case CliDiagnosticSeverity.Fatal => { set (*statistics).fatal_count += 1; }
        }
        if (*diagnostic_value).is_primary { set (*statistics).primary_count += 1; }
        if (*diagnostic_value).is_cascade { set (*statistics).cascade_count += 1; }
        if (*diagnostic_value).is_suppressed { set (*statistics).suppressed_count += 1; }
        if (*diagnostic_value).has_machine_fix { set (*statistics).machine_fix_count += 1; }
        set index += 1;
    }
    return true;
}

export extern proc vitte_diagnostic_render_cli_batch_ex(stream: *mut u8, sources: *const SourceContext, source_id: SourceId, source_name: *const char, diagnostics: *const CliDiagnostic, diagnostic_count: usize, options: *const CliDiagnosticRenderOptions) -> bool;

export extern proc vitte_diagnostic_render_cli_batch(stream: *mut u8, sources: *const SourceContext, source_id: SourceId, source_name: *const char, diagnostics: *const CliDiagnostic, diagnostic_count: usize, color: bool, format: CliDiagnosticFormat) -> bool;

export extern proc vitte_diagnostic_render_cli_diagnostic(stream: *mut u8, sources: *const SourceContext, source_id: SourceId, source_name: *const char, diagnostic_value: *const CliDiagnostic, options: *const CliDiagnosticRenderOptions) -> bool;

export extern proc vitte_diagnostic_render_cli(stream: *mut u8, sources: *const SourceContext, source_id: SourceId, source_name: *const char, severity: CliDiagnosticSeverity, code: *const char, message: *const char, details: *const char, has_span: bool, file_id: u32, start_offset: usize, end_offset: usize, start_line: usize, start_column: usize, end_line: usize, end_column: usize, procedure: *const char, context: *const char, color: bool, format: CliDiagnosticFormat) -> bool;
