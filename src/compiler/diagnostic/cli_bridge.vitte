/// Native validation and metadata for the CLI diagnostic transport contract.
space compiler::diagnostic::cli_bridge;

use compiler::source::source::{SourceContext, SourceId};
use compiler::diagnostic::registry::{vitte_diagnostic_registry_contains};
use vitte::core::memory::{allocate, cstring_length, deallocate, fill};
use vitte::core::pointer::{add_bytes};

export const VITTE_CLI_DIAGNOSTIC_CODE_CAPACITY: usize = 128;
export const VITTE_CLI_DIAGNOSTIC_SHORT_CODE_CAPACITY: usize = 16;
export const VITTE_CLI_DIAGNOSTIC_CATEGORY_CAPACITY: usize = 128;
export const VITTE_CLI_DIAGNOSTIC_MESSAGE_CAPACITY: usize = 1024;
export const VITTE_CLI_DIAGNOSTIC_DETAILS_CAPACITY: usize = 4096;
export const VITTE_CLI_DIAGNOSTIC_SOURCE_NAME_CAPACITY: usize = 4096;
export const VITTE_CLI_DIAGNOSTIC_LABEL_CAPACITY: usize = 4096;
export const VITTE_CLI_DIAGNOSTIC_TEXT_CAPACITY: usize = 1024;
export const VITTE_CLI_DIAGNOSTIC_REPLACEMENT_CAPACITY: usize = 1024;
export const VITTE_CLI_DIAGNOSTIC_SYMBOL_CAPACITY: usize = 256;
export const VITTE_CLI_DIAGNOSTIC_TYPE_CAPACITY: usize = 512;
export const VITTE_CLI_DIAGNOSTIC_CONTEXT_CAPACITY: usize = 1024;
export const VITTE_CLI_DIAGNOSTIC_PACKAGE_CAPACITY: usize = 256;
export const VITTE_CLI_DIAGNOSTIC_MODULE_CAPACITY: usize = 512;
export const VITTE_CLI_DIAGNOSTIC_PROCEDURE_CAPACITY: usize = 512;
export const VITTE_CLI_DIAGNOSTIC_TOOL_CAPACITY: usize = 256;
export const VITTE_CLI_DIAGNOSTIC_RULE_CAPACITY: usize = 256;
export const VITTE_CLI_DIAGNOSTIC_EXPRESSION_CAPACITY: usize = 1024;

export const VITTE_CLI_DIAGNOSTIC_MAX_LABELS: usize = 16;
export const VITTE_CLI_DIAGNOSTIC_MAX_RELATED: usize = 16;
export const VITTE_CLI_DIAGNOSTIC_MAX_CAUSES: usize = 16;
export const VITTE_CLI_DIAGNOSTIC_MAX_ANNOTATIONS: usize = 16;
export const VITTE_CLI_DIAGNOSTIC_MAX_SUGGESTIONS: usize = 16;
export const VITTE_CLI_DIAGNOSTIC_MAX_TRACE: usize = 32;
export const VITTE_CLI_DIAGNOSTIC_MAX_FIX_PARTS: usize = 16;

export const VITTE_CLI_DIAGNOSTIC_INDEX_NONE: usize = 18446744073709551615 as usize;

export pick CliDiagnosticSeverity {
    Note,
    Help,
    Warning,
    Error,
    Fatal
}

export pick CliDiagnosticFormat {
    Terminal,
    Json,
    Sarif,
    Lsp
}

export pick CliDiagnosticOrigin {
    Unknown,
    Io,
    Lexer,
    Scanner,
    Parser,
    Import,
    NameResolution,
    TypeCheck,
    Contract,
    ConstantEval,
    Hir,
    Ir,
    Codegen,
    C17Backend,
    CCompiler,
    Linker,
    Runtime,
    Driver,
    Internal
}

export pick CliDiagnosticLabelStyle {
    Primary,
    Secondary
}

export pick CliDiagnosticLocationKind {
    Primary,
    Declaration,
    Definition,
    Origin,
    Use,
    CallSite,
    Instantiation,
    Related
}

export pick CliDiagnosticAnnotationKind {
    Note,
    Help
}

export pick CliDiagnosticApplicability {
    Machine,
    Maybe,
    Placeholders,
    Manual
}

export pick CliDiagnosticConfidence {
    None,
    Low,
    Medium,
    High,
    Certain
}

export pick CliDiagnosticCauseKind {
    Unknown,
    Syntax,
    MissingToken,
    UnexpectedToken,
    UnresolvedName,
    TypeMismatch,
    ArityMismatch,
    Constraint,
    Import,
    Contract,
    ConstantEval,
    UnsafeOperation,
    Lowering,
    ExternalTool,
    Link,
    Runtime,
    Internal
}

export pick CliDiagnosticTraceKind {
    Call,
    Instantiation,
    Constraint,
    Import,
    Expansion,
    Lowering,
    GeneratedCode,
    Related
}

export pick CliDiagnosticContractKind {
    None,
    Requires,
    Ensures,
    Invariant,
    Assertion
}

export form CliDiagnosticSpan {
    valid: bool,
    file_id: u32,
    source_id: SourceId,
    source_name: *const char,
    start_offset: usize,
    end_offset: usize,
    start_line: usize,
    start_column: usize,
    end_line: usize,
    end_column: usize
}

export form CliDiagnosticLabel {
    style: CliDiagnosticLabelStyle,
    span: CliDiagnosticSpan,
    message: *const char
}

export form CliDiagnosticLocation {
    kind: CliDiagnosticLocationKind,
    span: CliDiagnosticSpan,
    label: *const char
}

export form CliDiagnosticCause {
    kind: CliDiagnosticCauseKind,
    message: *const char,
    has_span: bool,
    span: CliDiagnosticSpan,
    confidence: CliDiagnosticConfidence
}

export form CliDiagnosticAnnotation {
    kind: CliDiagnosticAnnotationKind,
    message: *const char,
    has_span: bool,
    span: CliDiagnosticSpan
}

export form CliDiagnosticFixPart {
