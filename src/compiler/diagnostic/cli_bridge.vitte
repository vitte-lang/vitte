export const VITTE_CLI_DIAGNOSTIC_INDEX_NONE: usize = 18446744073709551615 as usize;

export pick CliDiagnosticSeverity {
    Note,
    Help,
    Warning,
    Error,
    Fatal
}

export pick CliDiagnosticFormat {
    Terminal,
    Json,
    Sarif,
    Lsp
}

export pick CliDiagnosticOrigin {
    Unknown,
    Io,
    Lexer,
    Scanner,
    Parser,
    Import,
    NameResolution,
    TypeCheck,
    Contract,
    ConstantEval,
    Hir,
    Ir,
    Codegen,
    C17Backend,
    CCompiler,
    Linker,
    Runtime,
    Driver,
    Internal
}

export pick CliDiagnosticLabelStyle {
    Primary,
    Secondary
}

export pick CliDiagnosticLocationKind {
    Primary,
    Declaration,
    Definition,
    Origin,
    Use,
    CallSite,
    Instantiation,
    Related
}

export pick CliDiagnosticAnnotationKind {
    Note,
    Help
}

export pick CliDiagnosticApplicability {
    Machine,
    Maybe,
    Placeholders,
    Manual
}

export pick CliDiagnosticConfidence {
    None,
    Low,
    Medium,
    High,
    Certain
}

export pick CliDiagnosticCauseKind {
    Unknown,
    Syntax,
    MissingToken,
    UnexpectedToken,
    UnresolvedName,
    TypeMismatch,
    ArityMismatch,
    Constraint,
    Import,
    Contract,
    ConstantEval,
    UnsafeOperation,
    Lowering,
    ExternalTool,
    Link,
    Runtime,
    Internal
}

export pick CliDiagnosticTraceKind {
    Call,
    Instantiation,
    Constraint,
    Import,
    Expansion,
    Lowering,
    GeneratedCode,
    Related
}

export pick CliDiagnosticContractKind {
    None,
    Requires,
    Ensures,
    Invariant,
    Assertion
}

export form CliDiagnosticSpan {
    valid: bool,
    file_id: u32,
    source_id: SourceId,
    source_name: *const char,
    start_offset: usize,
    end_offset: usize,
    start_line: usize,
    start_column: usize,
    end_line: usize,
    end_column: usize
}

export form CliDiagnosticLabel {
    style: CliDiagnosticLabelStyle,
    span: CliDiagnosticSpan,
    message: *const char
}

export form CliDiagnosticLocation {
    kind: CliDiagnosticLocationKind,
    span: CliDiagnosticSpan,
    label: *const char
}

export form CliDiagnosticCause {
    kind: CliDiagnosticCauseKind,
    message: *const char,
    has_span: bool,
    span: CliDiagnosticSpan,
    confidence: CliDiagnosticConfidence
}

export form CliDiagnosticAnnotation {
    kind: CliDiagnosticAnnotationKind,
    message: *const char,
    has_span: bool,
    span: CliDiagnosticSpan
}

export form CliDiagnosticFixPart {
    span: CliDiagnosticSpan,
    replacement: *const char
}

export form CliDiagnosticSuggestion {
    message: *const char,
    applicability: CliDiagnosticApplicability,
    confidence: CliDiagnosticConfidence,
    preferred: bool,
    suggestion_id: u64,
    has_span: bool,
    span: CliDiagnosticSpan,
    has_replacement: bool,
    replacement: *const char,
    parts: *const CliDiagnosticFixPart,
    part_count: usize
}

export form CliDiagnosticTrace {
    kind: CliDiagnosticTraceKind,
    message: *const char,
    has_span: bool,
    span: CliDiagnosticSpan
}

export form CliDiagnosticContract {
    kind: CliDiagnosticContractKind,
    expression: *const char,
    procedure: *const char,
    reason: *const char,
    has_contract_span: bool,
    contract_span: CliDiagnosticSpan,
    has_call_span: bool,
    call_span: CliDiagnosticSpan,
    has_declaration_span: bool,
    declaration_span: CliDiagnosticSpan
}

export form CliDiagnosticExternalTool {
    present: bool,
    tool: *const char,
    rule: *const char,
    external_code: *const char,
    original_message: *const char
}

export form CliDiagnostic {
    diagnostic_id: u64,
    fingerprint: u64,
