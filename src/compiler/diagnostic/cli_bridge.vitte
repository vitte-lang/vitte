export type CliLspPositionConverter = proc(
    source_id: SourceId,
    source_name: *const char,
    byte_offset: usize,
    encoding: i32,
    position: *mut u8,
    user_data: *mut u8
) -> bool;

export type CliLspUriConverter = proc(
    source_id: SourceId,
    source_name: *const char,
    buffer: *mut u8,
    capacity: usize,
    user_data: *mut u8
) -> bool;

export form CliDiagnosticRenderOptions {
    format: CliDiagnosticFormat,
    color: bool,
    show_source: bool,
    show_source_line: bool,
    show_codes: bool,
    show_details: bool,
    show_origin: bool,
    show_category: bool,
    show_labels: bool,
    show_expected_found: bool,
    show_causes: bool,
    show_notes: bool,
    show_help: bool,
    show_related: bool,
    show_suggestions: bool,
    show_trace: bool,
    show_suppressed: bool,
    show_cascades: bool,
    show_internal: bool,
    show_summary: bool,
    context_lines_before: usize,
    context_lines_after: usize,
    position_encoding: i32,
    position_converter: ?CliLspPositionConverter,
    position_user_data: *mut u8,
    uri_converter: ?CliLspUriConverter,
    uri_user_data: *mut u8,
    pretty: bool,
    trailing_newline: bool
}

export form CliDiagnosticStatistics {
    total: usize,
    note_count: usize,
    help_count: usize,
    warning_count: usize,
    error_count: usize,
    fatal_count: usize,
    primary_count: usize,
    cascade_count: usize,
    suppressed_count: usize,
    machine_fix_count: usize
}

export proc vitte_cli_diagnostic_init(diagnostic_value: *mut CliDiagnostic) {
    if diagnostic_value == null {
        return;
    }

    fill(diagnostic_value as *mut u8, 0, sizeof(CliDiagnostic));
    set (*diagnostic_value).severity = CliDiagnosticSeverity.Error;
    set (*diagnostic_value).origin = CliDiagnosticOrigin.Unknown;
    set (*diagnostic_value).source_id = 0;
    set (*diagnostic_value).parent_diagnostic = VITTE_CLI_DIAGNOSTIC_INDEX_NONE;
    set (*diagnostic_value).root_diagnostic = VITTE_CLI_DIAGNOSTIC_INDEX_NONE;
    set (*diagnostic_value).is_primary = true;
}

export proc vitte_cli_diagnostic_span_init(span: *mut CliDiagnosticSpan) {
    if span == null {
        return;
    }

    fill(span as *mut u8, 0, sizeof(CliDiagnosticSpan));
    set (*span).source_id = 0;
}

export proc vitte_cli_diagnostic_render_options_init(options: *mut CliDiagnosticRenderOptions) {
    if options == null {
        return;
    }

    fill(options as *mut u8, 0, sizeof(CliDiagnosticRenderOptions));
    set (*options).format = CliDiagnosticFormat.Terminal;
    set (*options).show_source = true;
    set (*options).show_source_line = true;
    set (*options).show_codes = true;
    set (*options).show_details = true;
    set (*options).show_origin = true;
    set (*options).show_category = true;
    set (*options).show_labels = true;
    set (*options).show_expected_found = true;
    set (*options).show_causes = true;
    set (*options).show_notes = true;
    set (*options).show_help = true;
    set (*options).show_related = true;
    set (*options).show_suggestions = true;
    set (*options).show_trace = true;
    set (*options).show_cascades = true;
    set (*options).show_summary = true;
    set (*options).context_lines_before = 1;
    set (*options).context_lines_after = 1;
    set (*options).position_encoding = 1;
    set (*options).pretty = true;
    set (*options).trailing_newline = true;
}

export proc vitte_cli_diagnostic_statistics_init(statistics: *mut CliDiagnosticStatistics) {
    if statistics == null {
        return;
    }

    fill(statistics as *mut u8, 0, sizeof(CliDiagnosticStatistics));
}

proc cli_bridge_cstring(text: *const char) -> string {
    if text == null { return ""; }
    let mut length: usize = 0;
    while text[length] != 0 { set length += 1; }
    return string.from_bytes(text as *mut u8, length);
}

proc cli_bridge_array_is_valid(items: *const char, count: usize, maximum: usize) -> bool {
    if count > maximum { return false; }
    return count == 0 or items != null;
}

export proc vitte_cli_diagnostic_severity_is_valid(severity: CliDiagnosticSeverity) -> bool {
    return severity >= CliDiagnosticSeverity.Note and severity <= CliDiagnosticSeverity.Fatal;
}

export proc vitte_cli_diagnostic_format_is_valid(format: CliDiagnosticFormat) -> bool {
    return format >= CliDiagnosticFormat.Terminal and
           format <= CliDiagnosticFormat.Lsp;
}

export proc vitte_cli_diagnostic_origin_is_valid(origin: CliDiagnosticOrigin) -> bool {
    return origin >= CliDiagnosticOrigin.Unknown and origin <= CliDiagnosticOrigin.Internal;
}

export proc vitte_cli_diagnostic_span_is_valid(span: *const CliDiagnosticSpan) -> bool {
    if span == null or not (*span).valid or (*span).end_offset < (*span).start_offset { return false; }
    return (*span).source_id != 0 or (*span).source_name != null;
}

export proc vitte_cli_diagnostic_validate(diagnostic_value: *const CliDiagnostic) -> bool {
    if diagnostic_value == null or
       not vitte_cli_diagnostic_severity_is_valid((*diagnostic_value).severity) or
       not vitte_cli_diagnostic_origin_is_valid((*diagnostic_value).origin) or
       (*diagnostic_value).message == null or
       cli_bridge_cstring((*diagnostic_value).message).len() == 0 { return false; }
    if (*diagnostic_value).has_span {
        let span = CliDiagnosticSpan {
            valid: true,
            file_id: (*diagnostic_value).file_id,
            source_id: (*diagnostic_value).source_id,
            source_name: (*diagnostic_value).source_name,
            start_offset: (*diagnostic_value).start_offset,
            end_offset: (*diagnostic_value).end_offset,
            start_line: (*diagnostic_value).start_line,
            start_column: (*diagnostic_value).start_column,
            end_line: (*diagnostic_value).end_line,
            end_column: (*diagnostic_value).end_column
        };
        if not vitte_cli_diagnostic_span_is_valid(&span) { return false; }
    }
    return cli_bridge_array_is_valid((*diagnostic_value).labels as *const char, (*diagnostic_value).label_count, VITTE_CLI_DIAGNOSTIC_MAX_LABELS) and
        cli_bridge_array_is_valid((*diagnostic_value).related as *const char, (*diagnostic_value).related_count, VITTE_CLI_DIAGNOSTIC_MAX_RELATED) and
        cli_bridge_array_is_valid((*diagnostic_value).causes as *const char, (*diagnostic_value).cause_count, VITTE_CLI_DIAGNOSTIC_MAX_CAUSES) and
        cli_bridge_array_is_valid((*diagnostic_value).annotations as *const char, (*diagnostic_value).annotation_count, VITTE_CLI_DIAGNOSTIC_MAX_ANNOTATIONS) and
        cli_bridge_array_is_valid((*diagnostic_value).suggestions as *const char, (*diagnostic_value).suggestion_count, VITTE_CLI_DIAGNOSTIC_MAX_SUGGESTIONS) and
        cli_bridge_array_is_valid((*diagnostic_value).trace as *const char, (*diagnostic_value).trace_count, VITTE_CLI_DIAGNOSTIC_MAX_TRACE);
}

export proc vitte_cli_diagnostic_validate_batch(diagnostics: *const CliDiagnostic, diagnostic_count: usize) -> bool {
    if diagnostic_count != 0 and diagnostics == null { return false; }
    let mut index: usize = 0;
    while index < diagnostic_count {
        if not vitte_cli_diagnostic_validate(&diagnostics[index]) { return false; }
        set index += 1;
    }
    return true;
}

export proc vitte_cli_diagnostic_severity_name(severity: CliDiagnosticSeverity) -> string {
    match severity {
        case CliDiagnosticSeverity.Note => return "note";
        case CliDiagnosticSeverity.Help => return "help";
        case CliDiagnosticSeverity.Warning => return "warning";
        case CliDiagnosticSeverity.Error => return "error";
        case CliDiagnosticSeverity.Fatal => return "fatal";
        else => return "unknown"
    }
}

export proc vitte_cli_diagnostic_format_name(format: CliDiagnosticFormat) -> string {
    match format {
        case CliDiagnosticFormat.Terminal => return "terminal";
        case CliDiagnosticFormat.Json => return "json";
        case CliDiagnosticFormat.Sarif => return "sarif";
        case CliDiagnosticFormat.Lsp => return "lsp";
        else => return "unknown"
    }
}

export proc vitte_cli_diagnostic_origin_name(origin: CliDiagnosticOrigin) -> string {
    match origin {
        case CliDiagnosticOrigin.Unknown => return "unknown";
        case CliDiagnosticOrigin.Io => return "io";
        case CliDiagnosticOrigin.Lexer => return "lexer";
        case CliDiagnosticOrigin.Scanner => return "scanner";
        case CliDiagnosticOrigin.Parser => return "parser";
        case CliDiagnosticOrigin.Import => return "import";
        case CliDiagnosticOrigin.NameResolution => return "name-resolution";
        case CliDiagnosticOrigin.TypeCheck => return "type-check";
        case CliDiagnosticOrigin.Contract => return "contract";
        case CliDiagnosticOrigin.ConstantEval => return "constant-eval";
        case CliDiagnosticOrigin.Hir => return "hir";
        case CliDiagnosticOrigin.Ir => return "ir";
        case CliDiagnosticOrigin.Codegen => return "codegen";
        case CliDiagnosticOrigin.C17Backend => return "c17-backend";
        case CliDiagnosticOrigin.CCompiler => return "c-compiler";
        case CliDiagnosticOrigin.Linker => return "linker";
        case CliDiagnosticOrigin.Runtime => return "runtime";
        case CliDiagnosticOrigin.Driver => return "driver";
        case CliDiagnosticOrigin.Internal => return "internal";
        else => return "unknown"
    }
}

export proc vitte_cli_diagnostic_applicability_name(applicability: CliDiagnosticApplicability) -> string {
    match applicability {
        case CliDiagnosticApplicability.Machine => return "machine-applicable";
        case CliDiagnosticApplicability.Maybe => return "maybe-incorrect";
        case CliDiagnosticApplicability.Placeholders => return "has-placeholders";
        case CliDiagnosticApplicability.Manual => return "manual";
        else => return "unknown"
