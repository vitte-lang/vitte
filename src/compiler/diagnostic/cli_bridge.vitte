    details: *const char,
    details_storage: [u8; 4096],
    has_span: bool,
    file_id: u32,
    source_id: SourceId,
    source_name: *const char,
    start_offset: usize,
    end_offset: usize,
    start_line: usize,
    start_column: usize,
    end_line: usize,
    end_column: usize,
    symbol: *const char,
    expected_type: *const char,
    actual_type: *const char,
    expected: *const char,
    found: *const char,
    probable_cause: *const char,
    package: *const char,
    module: *const char,
    procedure: *const char,
    context: *const char,
    labels: *const CliDiagnosticLabel,
    label_count: usize,
    related: *const CliDiagnosticLocation,
    related_count: usize,
    causes: *const CliDiagnosticCause,
    cause_count: usize,
    annotations: *const CliDiagnosticAnnotation,
    annotation_count: usize,
    help: *const char,
    suggestions: *const CliDiagnosticSuggestion,
    suggestion_count: usize,
    has_machine_fix: bool,
    trace: *const CliDiagnosticTrace,
    trace_count: usize,
    parent_diagnostic: usize,
    root_diagnostic: usize,
    parent_id: u64,
    root_id: u64,
    is_primary: bool,
    is_cascade: bool,
    is_suppressed: bool,
    poisons_analysis: bool,
    is_internal: bool,
    provenance_id: u64,
