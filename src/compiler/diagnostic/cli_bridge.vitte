}

export type CliLspPositionConverter = proc(
    source_id: SourceId,
    source_name: *const char,
    byte_offset: usize,
    encoding: i32,
    position: *mut u8,
    user_data: *mut u8
) -> bool;

export type CliLspUriConverter = proc(
    source_id: SourceId,
    source_name: *const char,
    buffer: *mut u8,
    capacity: usize,
    user_data: *mut u8
) -> bool;

