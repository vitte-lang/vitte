/* ================================================================ */
/* Synthetic symbols                                                */
/* ================================================================ */

pub proc naming_temporary(
    naming: &mut Naming,
    module_id: u64,
) -> ?&NameEntry {
    if not naming_is_valid(naming) {
        return null;
    }

    let id: u64 = naming.next_temporary_id;

    if id == 18446744073709551615 {
        naming_fail(naming, NamingError.Overflow);
        return null;
    }

    set naming.next_temporary_id += 1;

    return naming_mangle(
        naming,
        NameKind.Temporary,
        module_id,
        id,
        "tmp",
    );
}

pub proc naming_label(
    naming: &mut Naming,
    module_id: u64,
) -> ?&NameEntry {
    if not naming_is_valid(naming) {
        return null;
    }

    let id: u64 = naming.next_label_id;

    if id == 18446744073709551615 {
        naming_fail(naming, NamingError.Overflow);
        return null;
    }

    set naming.next_label_id += 1;

    return naming_mangle(
        naming,
        NameKind.Label,
        module_id,
        id,
        "label",
    );
}

pub proc naming_internal(
    naming: &mut Naming,
    module_id: u64,
    purpose: str,
) -> ?&NameEntry {
    if not naming_is_valid(naming) {
        return null;
    }

    let mut effective_purpose: str = purpose;

    if effective_purpose.len() == 0 {
        set effective_purpose = "internal";
    }

    let id: u64 = naming.next_internal_id;

    if id == 18446744073709551615 {
        naming_fail(naming, NamingError.Overflow);
        return null;
    }

    set naming.next_internal_id += 1;

    return naming_mangle(
        naming,
        NameKind.Internal,
        module_id,
        id,
        effective_purpose,
    );
}

/* ================================================================ */
/* Registry access                                                  */
/* ================================================================ */

pub proc naming_count(naming: &Naming) -> usize {
    if not naming_is_valid(naming) {
        return 0;
    }

    return naming.entry_count;
}

pub proc naming_at(
    naming: &Naming,
    index: usize,
) -> ?&NameEntry {
    if not naming_is_valid(naming) {
        return null;
    }

    if index >= naming.entry_count {
        return null;
    }

    return &naming.entries[index];
}

/* ================================================================ */
/* Statistics                                                       */
/* ================================================================ */

pub proc naming_stats(naming: &Naming) -> NamingStats {
    let mut stats = NamingStats {
        entry_count: 0,
        entry_capacity: 0,

        generated_count: 0,
        collision_count: 0,

        source_bytes: 0,
        generated_bytes: 0,

        maximum_generated_length: 0,

        by_kind: [0 as usize, 0 as usize, 0 as usize, 0 as usize, 0 as usize, 0 as usize, 0 as usize, 0 as usize, 0 as usize, 0 as usize, 0 as usize, 0 as usize, 0 as usize],
    };

    if not naming_is_valid(naming) {
        return stats;
    }

    set stats.entry_count = naming.entry_count;
    set stats.entry_capacity = naming.entry_capacity;

    set stats.generated_count = naming.generated_count;
    set stats.collision_count = naming.collision_count;

    let mut index: usize = 0;

    while index < naming.entry_count {
        let name_entry = &naming.entries[index];

        set stats.source_bytes = naming_saturating_add(
            stats.source_bytes,
            name_entry.source_length,
        );

        set stats.generated_bytes = naming_saturating_add(
            stats.generated_bytes,
            name_entry.generated_length,
        );

        if name_entry.generated_length >
           stats.maximum_generated_length {
            set stats.maximum_generated_length =
                name_entry.generated_length;
        }

        let kind_index: usize =
            naming_kind_index(name_entry.kind);

        if kind_index > 0  and  kind_index < NAME_KIND_COUNT {
            set stats.by_kind[kind_index] =
                naming_saturating_add(
                    stats.by_kind[kind_index],
                    1,
                );
        }

        set index += 1;
    }

    return stats;
}

/* ================================================================ */
/* Deep validation                                                  */
/* ================================================================ */

pub proc naming_validate(naming: &Naming) -> bool {
    if not naming_is_valid(naming) {
        return false;
    }

    if not naming_config_validate(&naming.config) {
        return false;
    }

    let mut index: usize = 0;

    while index < naming.entry_count {
        let name_entry = &naming.entries[index];

        if name_entry.kind <= NameKind.Invalid or name_entry.kind >= NameKind.Count {
            return false;
        }

        if
           name_entry.source_length == 0  or 
           name_entry.generated_length == 0 {
            return false;
        }

        if name_entry.source_length != name_entry.source.len()  or 
           name_entry.generated_length != name_entry.generated.len() {
            return false;
        }

        if name_entry.source_length >
           naming.config.max_identifier_bytes {
            return false;
        }

        if name_entry.generated_length >
           naming.config.max_generated_bytes {
            return false;
        }

        if not naming_is_safe_c_identifier(name_entry.generated) {
            return false;
        }

        if name_entry.hash != naming_hash_string(name_entry.generated) {
            return false;
        }

        let mut other: usize = index + 1;

        while other < naming.entry_count {
            let candidate = &naming.entries[other];

            /*
             * Generated-name collision.
             */
            if name_entry.generated == candidate.generated {
                return false;
            }

            /*
             * Duplicate semantic key.
             */
            if name_entry.kind == candidate.kind  and 
               name_entry.module_id == candidate.module_id  and 
               name_entry.source_id == candidate.source_id  and 
               name_entry.source == candidate.source {
                return false;
            }

            set other += 1;
        }

        set index += 1;
    }

    return true;
}

/* ================================================================ */
/* Bootstrap-compatible native API                                  */
/* ================================================================ */

pub proc vitte_c17_naming_error_name(error: NamingError) -> str { return naming_error_name(error); }
pub proc vitte_c17_name_kind_name(kind: NameKind) -> str { return name_kind_name(kind); }
pub proc vitte_c17_naming_config_default() -> NamingConfig { return naming_config_default(); }

pub proc vitte_c17_naming_init(naming: ?&mut Naming, config: ?&NamingConfig) -> bool {
    if naming == null { return false; }
    let mut effective = naming_config_default();
    if config != null {
        set effective = *config?;
        if not naming_config_validate(&effective) { return false; }
    }
    set *naming? = naming_init(effective);
    return true;
}

pub proc vitte_c17_naming_reset(naming: ?&mut Naming) {
    if naming != null { naming_reset(&mut *naming?); }
}

pub proc vitte_c17_naming_destroy(naming: ?&mut Naming) {
    if naming != null { naming_destroy(&mut *naming?); }
}

pub proc vitte_c17_naming_is_valid(naming: ?&Naming) -> bool {
    if naming == null { return false; }
    return naming_is_valid(naming?);
}

pub proc vitte_c17_naming_validate(naming: ?&Naming) -> bool {
    if naming == null { return false; }
    return naming_validate(naming?);
}

pub proc vitte_c17_naming_is_c_identifier(identifier: string, length: usize) -> bool {
    if length == 0 or length > identifier.len() { return false; }
    return naming_is_c_identifier(identifier.slice(0, length));
}

pub proc vitte_c17_naming_is_keyword(identifier: string, length: usize) -> bool {
    if length == 0 or length > identifier.len() { return false; }
    return naming_is_keyword(identifier.slice(0, length));
}

pub proc vitte_c17_naming_is_reserved_identifier(identifier: string, length: usize) -> bool {
    if length == 0 or length > identifier.len() { return false; }
    return naming_is_reserved_identifier(identifier.slice(0, length));
}

pub proc vitte_c17_naming_is_safe_c_identifier(identifier: string, length: usize) -> bool {
    if length == 0 or length > identifier.len() { return false; }
    return naming_is_safe_c_identifier(identifier.slice(0, length));
}

pub proc vitte_c17_naming_hash_bytes(data: *const u8, length: usize) -> u64 {
    if data == null { return FNV_OFFSET; }
    let mut hash: u64 = FNV_OFFSET;
    let mut index: usize = 0;
    while index < length {
        set hash = fnv_step(hash, data[index]);
        set index += 1;
    }
    return hash;
}

pub proc vitte_c17_naming_hash_string(text: string, length: usize) -> u64 {
    if length > text.len() { return FNV_OFFSET; }
    return naming_hash_bytes(text.slice(0, length).as_bytes());
}

pub proc vitte_c17_naming_mangle(
    naming: ?&mut Naming,
    kind: NameKind,
    module_id: u64,
    source_id: u64,
    source: string,
    source_length: usize,
) -> ?&NameEntry {
    if naming == null { return null; }
    let context = &mut *naming?;
    if kind <= NameKind.Invalid or kind >= NameKind.Count {
        return naming_mangle(context, kind, module_id, source_id, "");
    }
    if source_length == 0 {
        return naming_mangle(context, kind, module_id, source_id, "");
    }
    if source_length > source.len() {
        naming_fail(context, NamingError.InvalidArgument);
        return null;
    }
    return naming_mangle(context, kind, module_id, source_id, source.slice(0, source_length));
}

pub proc vitte_c17_naming_module(naming: ?&mut Naming, module_id: u64, name: string, length: usize) -> ?&NameEntry {
    return vitte_c17_naming_mangle(naming, NameKind.Module, module_id, module_id, name, length);
}
pub proc vitte_c17_naming_type(naming: ?&mut Naming, module_id: u64, source_id: u64, name: string, length: usize) -> ?&NameEntry {
    return vitte_c17_naming_mangle(naming, NameKind.Type, module_id, source_id, name, length);
}
pub proc vitte_c17_naming_global(naming: ?&mut Naming, module_id: u64, source_id: u64, name: string, length: usize) -> ?&NameEntry {
    return vitte_c17_naming_mangle(naming, NameKind.Global, module_id, source_id, name, length);
}
pub proc vitte_c17_naming_function(naming: ?&mut Naming, module_id: u64, source_id: u64, name: string, length: usize) -> ?&NameEntry {
    return vitte_c17_naming_mangle(naming, NameKind.Function, module_id, source_id, name, length);
}
pub proc vitte_c17_naming_parameter(naming: ?&mut Naming, module_id: u64, source_id: u64, name: string, length: usize) -> ?&NameEntry {
    return vitte_c17_naming_mangle(naming, NameKind.Parameter, module_id, source_id, name, length);
}
pub proc vitte_c17_naming_local(naming: ?&mut Naming, module_id: u64, source_id: u64, name: string, length: usize) -> ?&NameEntry {
    return vitte_c17_naming_mangle(naming, NameKind.Local, module_id, source_id, name, length);
}
pub proc vitte_c17_naming_field(naming: ?&mut Naming, module_id: u64, source_id: u64, name: string, length: usize) -> ?&NameEntry {
    return vitte_c17_naming_mangle(naming, NameKind.Field, module_id, source_id, name, length);
}
pub proc vitte_c17_naming_enumerator(naming: ?&mut Naming, module_id: u64, source_id: u64, name: string, length: usize) -> ?&NameEntry {
    return vitte_c17_naming_mangle(naming, NameKind.Enumerator, module_id, source_id, name, length);
}
pub proc vitte_c17_naming_runtime(naming: ?&mut Naming, name: string, length: usize) -> ?&NameEntry {
    return vitte_c17_naming_mangle(naming, NameKind.Runtime, 0, 0, name, length);
}

pub proc vitte_c17_naming_temporary(naming: ?&mut Naming, module_id: u64) -> ?&NameEntry {
    if naming == null { return null; }
    return naming_temporary(&mut *naming?, module_id);
}
pub proc vitte_c17_naming_label(naming: ?&mut Naming, module_id: u64) -> ?&NameEntry {
    if naming == null { return null; }
    return naming_label(&mut *naming?, module_id);
}
pub proc vitte_c17_naming_internal(naming: ?&mut Naming, module_id: u64, purpose: string, purpose_length: usize) -> ?&NameEntry {
    if naming == null { return null; }
    if purpose_length == 0 {
        return naming_internal(&mut *naming?, module_id, "internal");
    }
    if purpose_length > purpose.len() {
        naming_fail(&mut *naming?, NamingError.InvalidArgument);
        return null;
    }
    return naming_internal(&mut *naming?, module_id, purpose.slice(0, purpose_length));
}

pub proc vitte_c17_naming_find_generated(naming: ?&Naming, generated: string, length: usize) -> ?&NameEntry {
    if naming == null or length > generated.len() { return null; }
    return naming_find_generated(naming?, generated.slice(0, length));
}
pub proc vitte_c17_naming_find_source(
    naming: ?&Naming,
    kind: NameKind,
    module_id: u64,
    source_id: u64,
    source: string,
    source_length: usize,
) -> ?&NameEntry {
    if naming == null or source_length > source.len() { return null; }
    return naming_find_source(naming?, kind, module_id, source_id, source.slice(0, source_length));
}

pub proc vitte_c17_naming_count(naming: ?&Naming) -> usize {
    if naming == null { return 0; }
    return naming_count(naming?);
}
pub proc vitte_c17_naming_at(naming: ?&Naming, index: usize) -> ?&NameEntry {
    if naming == null { return null; }
    return naming_at(naming?, index);
}
pub proc vitte_c17_naming_last_error(naming: ?&Naming) -> NamingError {
    if naming == null { return NamingError.InvalidNaming; }
    return naming_last_error(naming?);
}
pub proc vitte_c17_naming_clear_error(naming: ?&mut Naming) {
    if naming != null { naming_clear_error(&mut *naming?); }
}
pub proc vitte_c17_naming_stats(naming: ?&Naming) -> NamingStats {
    if naming != null { return naming_stats(naming?); }
    return NamingStats {
        entry_count: 0, entry_capacity: 0, generated_count: 0, collision_count: 0,
        source_bytes: 0, generated_bytes: 0, maximum_generated_length: 0,
        by_kind: [0 as usize, 0 as usize, 0 as usize, 0 as usize, 0 as usize, 0 as usize, 0 as usize, 0 as usize, 0 as usize, 0 as usize, 0 as usize, 0 as usize, 0 as usize],
    };
}

pub proc vitte_c17_name_entry_source(name_entry: ?&NameEntry) -> ?string {
    if name_entry == null { return null; }
    return name_entry?.source;
}
pub proc vitte_c17_name_entry_source_length(name_entry: ?&NameEntry) -> usize {
    if name_entry == null { return 0; }
    return name_entry?.source_length;
}
pub proc vitte_c17_name_entry_generated(name_entry: ?&NameEntry) -> ?string {
    if name_entry == null { return null; }
    return name_entry?.generated;
}
pub proc vitte_c17_name_entry_generated_length(name_entry: ?&NameEntry) -> usize {
    if name_entry == null { return 0; }
    return name_entry?.generated_length;
}
pub proc vitte_c17_name_entry_hash(name_entry: ?&NameEntry) -> u64 {
    if name_entry == null { return 0; }
    return name_entry?.hash;
}

pub proc vitte_c17_naming_has_error(naming: ?&Naming) -> bool {
    if naming == null { return false; }
    return naming?.last_error != NamingError.None;
}
pub proc vitte_c17_naming_is_empty(naming: ?&Naming) -> bool {
    if naming == null { return true; }
    return naming?.entry_count == 0;
}
pub proc vitte_c17_naming_collision_count(naming: ?&Naming) -> usize {
    if naming == null { return 0; }
    return naming?.collision_count;
}

