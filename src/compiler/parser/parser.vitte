/// Parser data model matching the bootstrap parser ABI.
space compiler::parser::parser;

use compiler::lexer::lexer::{
    TokenKind,
    vitte_token_kind_is_contextual_keyword,
    vitte_token_kind_is_keyword
};
use compiler::ast::ast::{
    AST_NODE_FLAG_ASYNC,
    AST_NODE_FLAG_COMPTIME,
    AST_NODE_FLAG_CONTRACT_ENSURES,
    AST_NODE_FLAG_CONTRACT_REQUIRES,
    AST_NODE_FLAG_EXTERN,
    AST_NODE_FLAG_EXPORT,
    AST_NODE_FLAG_FUNCTION_TYPE_HAS_RETURN,
    AST_NODE_FLAG_GLOB_IMPORT,
    AST_NODE_FLAG_HAS_ATTRIBUTES,
    AST_NODE_FLAG_MUTABLE,
    AST_NODE_FLAG_PUBLIC,
    AST_NODE_FLAG_TYPE_ALIAS,
    AST_NODE_FLAG_TYPE_QUERY_TYPE_OPERAND,
    AST_NODE_FLAG_PATTERN_MUTABLE,
    AST_NODE_FLAG_PATTERN_REFERENCE,
    AST_NODE_FLAG_PATTERN_HEAD,
    AST_NODE_FLAG_PATTERN_OR,
    AST_NODE_FLAG_PATTERN_RANGE,
    AST_NODE_FLAG_PATTERN_STRUCT,
    AST_NODE_FLAG_UNSAFE,
    Ast,
    AstBinaryOperator,
    AstKind,
    AstNode,
    AstSpan,
    AstUnaryOperator,
    ast_arena,
    ast_is_empty,
    ast_is_valid,
    ast_node_add_child,
    ast_node_add_attribute_ex,
    ast_node_create,
    ast_node_create_named,
    ast_node_set_binary_operator,
    ast_node_set_flag,
    ast_node_set_unary_operator,
    ast_reset,
    ast_set_root,
    ast_span_make,
    ast_validate
};
use compiler::arena::arena::{
    ArenaCheckpoint,
    arena_context_checkpoint,
    arena_context_rollback
};
use vitte::core::memory::{allocate, copy, deallocate, fill};
use vitte::core::pointer;

const PARSER_MAGIC: u64 = 0x5649545450415253;
const PARSER_DEAD_MAGIC: u64 = 0x4445414450415253;
const PARSER_DEFAULT_MAX_NODES: usize = 16777216;
const PARSER_DEFAULT_MAX_DIAGNOSTICS: usize = 4096;
const PARSER_DEFAULT_MAX_RECURSION_DEPTH: usize = 1024;
const PARSER_DEFAULT_MAX_RECOVERY_TOKENS: usize = 4096;
const PARSER_DEFAULT_INITIAL_CAPACITY: usize = 64;
const PARSER_SIZE_MAX: usize = (0 as usize) - 1;
const PARSER_FNV_OFFSET: u64 = 14695981039346656037;
const PARSER_FNV_PRIME: u64 = 1099511628211;
const PARSER_AST_FLAG_GLOB_IMPORT: u32 = 256;
const PARSER_AST_FLAG_HAS_ATTRIBUTES: u32 = 512;
export const PARSER_AST_FLAG_PUBLIC: u32 = 1;
export const PARSER_AST_FLAG_MUTABLE: u32 = 2;
export const PARSER_AST_FLAG_EXTERN: u32 = 4;
export const PARSER_AST_FLAG_ASYNC: u32 = 8;
export const PARSER_AST_FLAG_UNSAFE: u32 = 16;
export const PARSER_AST_FLAG_COMPTIME: u32 = 32;
const PARSER_AST_FLAG_CONTRACT_REQUIRES: u32 = 64;
const PARSER_AST_FLAG_CONTRACT_ENSURES: u32 = 128;
const PARSER_AST_FLAG_FUNCTION_TYPE_HAS_RETURN: u32 = 32768;
const PARSER_AST_FLAG_TYPE_ALIAS: u32 = 65536;
const PARSER_AST_FLAG_TYPE_QUERY_TYPE_OPERAND: u32 = 131072;
export const PARSER_AST_FLAG_PATTERN_MUTABLE: u32 = 262144;
export const PARSER_AST_FLAG_PATTERN_REFERENCE: u32 = 524288;
export const PARSER_AST_FLAG_PATTERN_HEAD: u32 = 1048576;
export const PARSER_AST_FLAG_PATTERN_OR: u32 = 2097152;
export const PARSER_AST_FLAG_PATTERN_RANGE: u32 = 4194304;
export const PARSER_AST_FLAG_PATTERN_STRUCT: u32 = 8388608;
const PARSER_AST_CONVERSION_MAX_DEPTH: usize = 1024;
export pick ParserError {
    None,
    InvalidArgument,
    InvalidContext,
    InvalidState,
    InvalidToken,
    InvalidNode,
    ExpectedToken,
    ExpectedIdentifier,
    ExpectedExpression,
    ExpectedType,
    ExpectedStatement,
    ExpectedDeclaration,
    UnexpectedToken,
    NodeLimit,
    DiagnosticLimit,
    RecursionLimit,
    Overflow,
    OutOfMemory,
    Validation,
    Corruption,
    Unsupported,
    Internal,
    Count
}

export pick ParserState {
    Invalid,
    Ready,
    Parsing,
    Done,
    Failed,
    Destroyed,
    Count
}

export pick ParserDiagnosticKind {
    Invalid,
    Note,
    Help,
    Warning,
    Error,
    Count
}

export form ParserSpan {
    file_id: u32,
    begin: usize,
    end: usize,
    line: usize,
    column: usize,
    valid: bool
}

export pick ASTNodeKind {
    Invalid,
    TranslationUnit,
    Identifier,
    Path,
    SpaceDecl,
    UseDecl,
    ConstDecl,
    StaticDecl,
    TypeDecl,
    OpaqueDecl,
    FormDecl,
    FieldDecl,
    PickDecl,
    VariantDecl,
    TraitDecl,
    ImplDecl,
    ProcDecl,
    ExternProcDecl,
    Parameter,
    GenericParam,
    WhereClause,
    WherePredicate,
    Pattern,
    MacroDecl,
    TestDecl,
    Block,
    LetStmt,
    ReturnStmt,
    DeferStmt,
    IfStmt,
    IfExpr,
    BlockExpr,
    WhileStmt,
    LoopStmt,
    ForStmt,
    BreakStmt,
    ContinueStmt,
    MatchStmt,
    MatchArm,
    UnsafeBlock,
    AsmStmt,
    AssertStmt,
    ExprStmt,
    TypeExpr,
    PointerType,
    ReferenceType,
    ArrayType,
    IntegerLiteral,
    FloatLiteral,
    StringLiteral,
    CharacterLiteral,
    BoolLiteral,
    NullLiteral,
    SelfExpr,
    GroupExpr,
    ArrayExpr,
    FormExpr,
    FieldInit,
    UnaryExpr,
    BinaryExpr,
    CastExpr,
    AssignExpr,
    CallExpr,
    IndexExpr,
    MemberExpr,
    AwaitExpr,
    TryExpr,
    SizeofExpr,
    AlignofExpr,
    OptionalType,
    Count
}

/// C-compatible token record consumed by the bootstrap parser.
/// The native lexer owns a distinct `Token` representation; the pipeline
/// converts each token before calling the parser.
export form ParserTokenSpan {
    file_id: u32,
    begin: usize,
    end: usize,
    valid: bool
}

export form ParserToken {
    kind: TokenKind,
    span: ParserTokenSpan,
    line: usize,
    column: usize,
    lexeme: string,
    length: usize
}

/// Token ranges for one parsed attribute, including its qualified name and
/// raw positional or named argument tokens.
export form ParserAttribute {
    token_start: usize,
    token_count: usize,
    name_start: usize,
    name_count: usize,
    argument_start: usize,
    argument_count: usize,
    inner: bool
}

export form ASTNode {
    id: ASTNodeId,
    kind: ASTNodeKind,
    node_flags: u32,
    operator_kind: TokenKind,
    token_index: usize,
    span: ParserSpan,
    children: *ASTNodeId,
    child_count: usize,
    child_capacity: usize,
    attribute_start: usize,
    attribute_count: usize
}

export form ParserDiagnostic {
    kind: ParserDiagnosticKind,
    error: ParserError,
    span: ParserSpan,
    expected: TokenKind,
    found: TokenKind
}

export form ParserStats {
    runs: u64,
    failed_runs: u64,
    tokens_consumed: u64,
    nodes_created: u64,
    declarations: u64,
    diagnostics: u64,
    errors: u64,
    recoveries: u64,
    max_recursion_depth: u64,
    validation_runs: u64,
    validation_failures: u64,
    hash_runs: u64,
    allocations: u64,
    reallocations: u64,
    allocation_failures: u64
}

export form Parser {
    magic: u64,
    state: ParserState,
    last_error: ParserError,
    tokens: *const ParserToken,
    token_count: usize,
    position: usize,
    nodes: *ASTNode,
    node_count: usize,
    node_capacity: usize,
    attributes: *ParserAttribute,
    attribute_count: usize,
    attribute_capacity: usize,
    diagnostics: *ParserDiagnostic,
    diagnostic_count: usize,
    diagnostic_capacity: usize,
    root: ASTNodeId,
    max_nodes: usize,
    max_diagnostics: usize,
    max_recursion_depth: usize,
    max_recovery_tokens: usize,
    recursion_depth: usize,
    recovering: bool,
    stats: ParserStats,
    generation: u64
}

form ParserValidationFrame {
    node_id: ASTNodeId,
    next_child: usize
}

export type ASTNodeId = u64;

pick ParserRecoveryMode {
    Declaration,
    Statement,
    MatchArm
}

pick ParserListRecovery {
    Next,
    End,
    Escape
}

form ParserRecoveryDepth {
    parentheses: usize,
    brackets: usize,
    braces: usize,
    angles: usize
}

const PARSER_INVALID_NODE_ID: ASTNodeId = 0;

proc parser_context_valid(parser: *const Parser) -> bool {
    if parser == null or (*parser).magic != PARSER_MAGIC {
        return false;
    }

    if (*parser).state <= ParserState.Invalid or
       (*parser).state >= ParserState.Destroyed {
        return false;
    }

    if ((*parser).tokens == null and (*parser).token_count != 0) or
       (*parser).position > (*parser).token_count or
       (*parser).node_count > (*parser).node_capacity or
       ((*parser).node_count != 0 and (*parser).nodes == null) or
       (*parser).attribute_count > (*parser).attribute_capacity or
       ((*parser).attribute_count != 0 and (*parser).attributes == null) or
       (*parser).diagnostic_count > (*parser).diagnostic_capacity or
       ((*parser).diagnostic_count != 0 and (*parser).diagnostics == null) {
        return false;
    }

    return true;
}

proc parser_token_at_private(parser: *const Parser, position: usize) -> *const ParserToken {
    if parser == null or (*parser).tokens == null or position >= (*parser).token_count {
        return null;
    }
    return &(*parser).tokens[position];
}

proc parser_current(parser: *const Parser) -> *const ParserToken {
    if parser == null {
        return null;
    }
    return parser_token_at_private(parser, (*parser).position);
}

proc parser_previous(parser: *const Parser) -> *const ParserToken {
    if parser == null or (*parser).position == 0 {
        return null;
    }
    return parser_token_at_private(parser, (*parser).position - 1);
}

proc parser_peek(parser: *const Parser, distance: usize) -> *const ParserToken {
    if parser == null or distance > PARSER_SIZE_MAX - (*parser).position {
        return null;
    }
    return parser_token_at_private(parser, (*parser).position + distance);
}

proc parser_at_end(parser: *const Parser) -> bool {
    let token = parser_current(parser);
    return token == null or (*token).kind == TokenKind.Eof;
}

proc parser_check(parser: *const Parser, kind: TokenKind) -> bool {
    let token = parser_current(parser);
    return token != null and (*token).kind == kind;
}

proc parser_check_next(parser: *const Parser, kind: TokenKind) -> bool {
    let token = parser_peek(parser, 1);
    return token != null and (*token).kind == kind;
}

proc parser_u64_add_sat(left: u64, right: u64) -> u64 {
    if left > 18446744073709551615 - right {
        return 18446744073709551615;
    }
    return left + right;
}

proc parser_mutable(parser: *const Parser) -> bool {
    return parser_context_valid(parser) and
        ((*parser).state == ParserState.Ready or (*parser).state == ParserState.Parsing);
}

proc parser_size_add(left: usize, right: usize, result: &mut usize) -> bool {
    if left > PARSER_SIZE_MAX - right {
        return false;
    }
    set *result = left + right;
    return true;
}

proc parser_size_mul(left: usize, right: usize, result: &mut usize) -> bool {
    if left != 0 and right > PARSER_SIZE_MAX / left {
        return false;
    }
    set *result = left * right;
    return true;
}

proc parser_next_capacity(current: usize, required: usize, result: &mut usize) -> bool {
    let mut capacity = current;
    if capacity == 0 {
        set capacity = PARSER_DEFAULT_INITIAL_CAPACITY;
    }
    while capacity < required {
        if capacity > PARSER_SIZE_MAX / 2 {
            set capacity = required;
            break;
        }
        set capacity *= 2;
    }
    set *result = capacity;
    return true;
}

proc parser_reserve_nodes(parser: *mut Parser, required: usize) -> bool {
    if parser == null {
        return false;
    }
    if required <= (*parser).node_capacity {
        return true;
    }

    let mut capacity: usize = 0;
    let mut bytes: usize = 0;
    if not parser_next_capacity((*parser).node_capacity, required, &mut capacity) or
       not parser_size_mul(capacity, sizeof(ASTNode), &mut bytes) {
        parser_fail(parser, ParserError.Overflow);
        return false;
    }

    let replacement = allocate(bytes);
    if replacement == null {
        set (*parser).stats.allocation_failures = parser_u64_add_sat((*parser).stats.allocation_failures, 1);
        parser_fail(parser, ParserError.OutOfMemory);
        return false;
    }

    if (*parser).nodes != null {
        if (*parser).node_count != 0 {
            copy(
                replacement,
                (*parser).nodes as *const u8,
                (*parser).node_count * sizeof(ASTNode)
            );
        }
        set (*parser).stats.reallocations = parser_u64_add_sat((*parser).stats.reallocations, 1);
    } else {
        set (*parser).stats.allocations = parser_u64_add_sat((*parser).stats.allocations, 1);
    }

    deallocate((*parser).nodes as *mut u8);
    set (*parser).nodes = replacement as usize as *ASTNode;
    set (*parser).node_capacity = capacity;
    return true;
}

proc parser_reserve_attributes(parser: *mut Parser, required: usize) -> bool {
    if parser == null {
        return false;
    }
    if required <= (*parser).attribute_capacity {
        return true;
    }

    let mut capacity: usize = 0;
    let mut bytes: usize = 0;
    if not parser_next_capacity((*parser).attribute_capacity, required, &mut capacity) or
       not parser_size_mul(capacity, sizeof(ParserAttribute), &mut bytes) {
        parser_fail(parser, ParserError.Overflow);
        return false;
    }

    let replacement = allocate(bytes);
    if replacement == null {
        set (*parser).stats.allocation_failures = parser_u64_add_sat((*parser).stats.allocation_failures, 1);
        parser_fail(parser, ParserError.OutOfMemory);
        return false;
    }

    if (*parser).attributes != null {
        if (*parser).attribute_count != 0 {
            copy(
                replacement,
                (*parser).attributes as *const u8,
                (*parser).attribute_count * sizeof(ParserAttribute)
            );
        }
        set (*parser).stats.reallocations = parser_u64_add_sat((*parser).stats.reallocations, 1);
    } else {
        set (*parser).stats.allocations = parser_u64_add_sat((*parser).stats.allocations, 1);
    }

    deallocate((*parser).attributes as *mut u8);
    set (*parser).attributes = replacement as usize as *ParserAttribute;
    set (*parser).attribute_capacity = capacity;
    return true;
}

proc parser_add_attribute(parser: *mut Parser, attribute: &ParserAttribute) -> bool {
    if parser == null {
        return false;
    }

    let mut required: usize = 0;
    if not parser_size_add((*parser).attribute_count, 1, &mut required) {
        return parser_fail(parser, ParserError.Overflow);
    }
    if not parser_reserve_attributes(parser, required) {
        return false;
    }

    let destination = (&((*parser).attributes[(*parser).attribute_count])) as *mut ParserAttribute;
    copy(destination as *mut u8, attribute as *const u8, sizeof(ParserAttribute));
    set (*parser).attribute_count = required;
    return true;
}

proc parser_reserve_diagnostics(parser: *mut Parser, required: usize) -> bool {
    if parser == null {
        return false;
    }
    if required <= (*parser).diagnostic_capacity {
        return true;
    }

    let mut capacity: usize = 0;
    let mut bytes: usize = 0;
    if not parser_next_capacity((*parser).diagnostic_capacity, required, &mut capacity) or
       not parser_size_mul(capacity, sizeof(ParserDiagnostic), &mut bytes) {
        parser_fail(parser, ParserError.Overflow);
        return false;
    }

    let replacement = allocate(bytes);
    if replacement == null {
        set (*parser).stats.allocation_failures = parser_u64_add_sat((*parser).stats.allocation_failures, 1);
        parser_fail(parser, ParserError.OutOfMemory);
        return false;
    }

    if (*parser).diagnostics != null {
        if (*parser).diagnostic_count != 0 {
            copy(
                replacement,
                (*parser).diagnostics as *const u8,
                (*parser).diagnostic_count * sizeof(ParserDiagnostic)
            );
        }
        set (*parser).stats.reallocations = parser_u64_add_sat((*parser).stats.reallocations, 1);
    } else {
        set (*parser).stats.allocations = parser_u64_add_sat((*parser).stats.allocations, 1);
    }

    deallocate((*parser).diagnostics as *mut u8);
    set (*parser).diagnostics = replacement as usize as *ParserDiagnostic;
    set (*parser).diagnostic_capacity = capacity;
    return true;
}

proc parser_reserve_node_ids(parser: *mut Parser, node: *mut ASTNode, required: usize) -> bool {
    if parser == null or node == null {
        return false;
    }
    if required <= (*node).child_capacity {
        return true;
    }

    let mut capacity: usize = 0;
    let mut bytes: usize = 0;
    if not parser_next_capacity((*node).child_capacity, required, &mut capacity) or
       not parser_size_mul(capacity, sizeof(ASTNodeId), &mut bytes) {
        parser_fail(parser, ParserError.Overflow);
        return false;
    }

    let replacement = allocate(bytes);
    if replacement == null {
        set (*parser).stats.allocation_failures = parser_u64_add_sat((*parser).stats.allocation_failures, 1);
        parser_fail(parser, ParserError.OutOfMemory);
        return false;
    }

    if (*node).children != null {
        if (*node).child_count != 0 {
            copy(
                replacement,
                (*node).children as *const u8,
                (*node).child_count * sizeof(ASTNodeId)
            );
        }
        set (*parser).stats.reallocations = parser_u64_add_sat((*parser).stats.reallocations, 1);
    } else {
        set (*parser).stats.allocations = parser_u64_add_sat((*parser).stats.allocations, 1);
    }

    deallocate((*node).children as *mut u8);
    set (*node).children = replacement as usize as *ASTNodeId;
    set (*node).child_capacity = capacity;
    return true;
}

proc parser_fail_node(parser: *mut Parser, error: ParserError) -> ASTNodeId {
    parser_fail(parser, error);
    return PARSER_INVALID_NODE_ID;
}

proc parser_add_node(parser: *mut Parser, kind: ASTNodeKind, span: ParserSpan) -> ASTNodeId {
    if not parser_mutable(parser) {
        return parser_fail_node(parser, ParserError.InvalidState);
    }
    if kind <= ASTNodeKind.Invalid or kind >= ASTNodeKind.Count {
        return parser_fail_node(parser, ParserError.InvalidNode);
    }
    if (*parser).node_count >= (*parser).max_nodes {
        return parser_fail_node(parser, ParserError.NodeLimit);
    }

    let mut required: usize = 0;
    if not parser_size_add((*parser).node_count, 1, &mut required) {
        return parser_fail_node(parser, ParserError.Overflow);
    }
    if not parser_reserve_nodes(parser, required) {
        return PARSER_INVALID_NODE_ID;
    }

    let node = (&((*parser).nodes[(*parser).node_count])) as *mut ASTNode;
    fill(node as *mut u8, 0, sizeof(ASTNode));
    set (*node).id = required as ASTNodeId;
    set (*node).kind = kind;
    set (*node).span = span;
    set (*node).token_index = PARSER_SIZE_MAX;
    set (*parser).node_count = required;
    set (*parser).stats.nodes_created = parser_u64_add_sat((*parser).stats.nodes_created, 1);
    return (*node).id;
}

proc parser_node_append_child(parser: *mut Parser, parent_id: ASTNodeId, child_id: ASTNodeId) -> bool {
    if child_id == PARSER_INVALID_NODE_ID {
        return false;
    }

    let parent = vitte_parser_get_node_mut(parser, parent_id);
    if parent == null {
        return false;
    }

    let mut required: usize = 0;
    if not parser_size_add((*parent).child_count, 1, &mut required) {
        return parser_fail(parser, ParserError.Overflow);
    }
    if not parser_reserve_node_ids(parser, parent, required) {
        return false;
    }

    set (*parent).children[(*parent).child_count] = child_id;
    set (*parent).child_count = required;
    return true;
}

proc parser_span_invalid() -> ParserSpan {
    return ParserSpan {
        file_id: 0,
        begin: 0,
        end: 0,
        line: 0,
        column: 0,
        valid: false
    };
}

proc parser_span_from_token(token: *const ParserToken) -> ParserSpan {
    if token == null or not (*token).span.valid {
        return parser_span_invalid();
    }
    return ParserSpan {
        file_id: (*token).span.file_id,
        begin: (*token).span.begin,
        end: (*token).span.end,
        line: (*token).line,
        column: (*token).column,
        valid: true
    };
}

proc parser_emit_diagnostic(
    parser: *mut Parser,
    kind: ParserDiagnosticKind,
    error: ParserError,
    span: ParserSpan,
    expected: TokenKind,
    found: TokenKind
) -> bool {
    if parser == null or (*parser).magic != PARSER_MAGIC {
        return false;
    }
    if kind == ParserDiagnosticKind.Error and (*parser).recovering {
        return true;
    }
    if (*parser).diagnostic_count >= (*parser).max_diagnostics {
        set (*parser).last_error = ParserError.DiagnosticLimit;
        return false;
    }

    let mut required: usize = 0;
    if not parser_size_add((*parser).diagnostic_count, 1, &mut required) {
        return parser_fail(parser, ParserError.Overflow);
    }
    if not parser_reserve_diagnostics(parser, required) {
        return false;
    }

    let diag_entry = (&((*parser).diagnostics[(*parser).diagnostic_count])) as *mut ParserDiagnostic;
    fill(diag_entry as *mut u8, 0, sizeof(ParserDiagnostic));
    set (*diag_entry).kind = kind;
    set (*diag_entry).error = error;
    set (*diag_entry).span = span;
    set (*diag_entry).expected = expected;
    set (*diag_entry).found = found;
    set (*parser).diagnostic_count = required;
    set (*parser).stats.diagnostics = parser_u64_add_sat((*parser).stats.diagnostics, 1);
    if kind == ParserDiagnosticKind.Error {
        set (*parser).stats.errors = parser_u64_add_sat((*parser).stats.errors, 1);
    }
    set (*parser).last_error = error;
    if kind == ParserDiagnosticKind.Error {
        set (*parser).recovering = true;
    }
    return true;
}

proc parser_error_here(parser: *mut Parser, error: ParserError, expected: TokenKind) -> bool {
    let token = parser_current(parser);
    if token != null {
        parser_emit_diagnostic(
            parser,
            ParserDiagnosticKind.Error,
            error,
            parser_span_from_token(token),
            expected,
            (*token).kind
        );
    } else {
        parser_emit_diagnostic(
            parser,
            ParserDiagnosticKind.Error,
            error,
            parser_span_invalid(),
            expected,
            TokenKind.Invalid
        );
    }
    return false;
}

proc parser_span_from_range(parser: *const Parser, first: usize, last_exclusive: usize) -> ParserSpan {
    if parser == null or first >= (*parser).token_count or last_exclusive <= first {
        return parser_span_invalid();
    }

    let first_token = parser_token_at_private(parser, first);
    let last_token = parser_token_at_private(parser, last_exclusive - 1);
    let mut span = parser_span_from_token(first_token);
    let last_span = parser_span_from_token(last_token);
    if not span.valid {
        return last_span;
    }
    if not last_span.valid {
        return span;
    }
    if last_span.begin < span.begin {
        set span.begin = last_span.begin;
        set span.line = last_span.line;
        set span.column = last_span.column;
    }
    if last_span.end > span.end {
        set span.end = last_span.end;
    }
    return span;
}

proc parser_span_join(left: ParserSpan, right: ParserSpan) -> ParserSpan {
    if not left.valid {
        return right;
    }
    if not right.valid {
        return left;
    }
    let mut joined = left;
    if right.begin < joined.begin {
        set joined.begin = right.begin;
        set joined.line = right.line;
        set joined.column = right.column;
    }
    if right.end > joined.end {
        set joined.end = right.end;
    }
    return joined;
}

proc parser_token_index(parser: *const Parser, token: *const ParserToken) -> usize {
    if parser == null or token == null or (*parser).tokens == null {
        return 0;
    }
    let mut index: usize = 0;
    while index < (*parser).token_count {
        if &(*parser).tokens[index] == token {
            return index;
        }
        set index += 1;
    }
    return 0;
}

proc parser_enter_recursion(parser: *mut Parser) -> bool {
    if parser == null {
        return false;
    }
    if (*parser).recursion_depth >= (*parser).max_recursion_depth {
        parser_error_here(parser, ParserError.RecursionLimit, TokenKind.Invalid);
        return false;
    }
    set (*parser).recursion_depth += 1;
    let current_depth = (*parser).recursion_depth as u64;
    if current_depth > (*parser).stats.max_recursion_depth {
        set (*parser).stats.max_recursion_depth = current_depth;
    }
    return true;
}

proc parser_leave_recursion(parser: *mut Parser) {
    if parser != null and (*parser).recursion_depth != 0 {
        set (*parser).recursion_depth -= 1;
    }
}

proc parser_token_is_identifier(token: *const ParserToken) -> bool {
    return token != null and
        ((*token).kind == TokenKind.Identifier or
         vitte_token_kind_is_contextual_keyword((*token).kind));
}

proc parser_token_is_path_segment(token: *const ParserToken) -> bool {
    return parser_token_is_identifier(token) or
        (token != null and (*token).kind == TokenKind.KwReserved and
         ((*token).lexeme == "compiler" or (*token).lexeme == "diagnostic"));
}

proc parser_parse_identifier_node(parser: *mut Parser) -> ASTNodeId {
    let token = parser_current(parser);
    if token == null {
        parser_error_here(parser, ParserError.ExpectedIdentifier, TokenKind.Identifier);
        return PARSER_INVALID_NODE_ID;
    }

    if (*token).kind == TokenKind.KwNull and parser_check_next(parser, TokenKind.LeftParen) {
        parser_advance(parser);
    } else if parser_token_is_identifier(token) {
        parser_advance(parser);
    } else {
        parser_error_here(parser, ParserError.ExpectedIdentifier, TokenKind.Identifier);
        return PARSER_INVALID_NODE_ID;
    }

    let id = parser_add_node(
        parser,
        ASTNodeKind.Identifier,
        parser_span_from_token(token)
    );
    if id == PARSER_INVALID_NODE_ID {
        return id;
    }
    let node = vitte_parser_get_node_mut(parser, id);
    if node == null {
        return PARSER_INVALID_NODE_ID;
    }
    set (*node).token_index = (*parser).position - 1;
    return id;
}

proc parser_parse_path_segment_node(parser: *mut Parser) -> ASTNodeId {
    let token = parser_current(parser);
    if token == null or (*token).kind != TokenKind.KwReserved or
       ((*token).lexeme != "compiler" and (*token).lexeme != "diagnostic") {
        return parser_parse_identifier_node(parser);
    }

    parser_advance(parser);
    let id = parser_add_node(
        parser,
        ASTNodeKind.Identifier,
        parser_span_from_token(token)
    );
    if id == PARSER_INVALID_NODE_ID {
        return id;
    }
    let node = vitte_parser_get_node_mut(parser, id);
    if node == null {
        return PARSER_INVALID_NODE_ID;
    }
    set (*node).token_index = (*parser).position - 1;
    return id;
}

proc parser_path_has_next_segment(parser: *const Parser, allow_slash_separator: bool) -> bool {
    return (parser_check(parser, TokenKind.ColonColon) and
            parser_token_is_path_segment(parser_peek(parser, 1))) or
           (allow_slash_separator and parser_check(parser, TokenKind.Slash) and
            parser_token_is_path_segment(parser_peek(parser, 1)));
}

proc parser_parse_path_mode(parser: *mut Parser, allow_slash_separator: bool) -> ASTNodeId {
    let first_segment = parser_parse_path_segment_node(parser);
    if first_segment == PARSER_INVALID_NODE_ID {
        return first_segment;
    }

    let path_span = parser_span_from_range(parser, (*parser).position - 1, (*parser).position);
    let path_id = parser_add_node(parser, ASTNodeKind.Path, path_span);
    if path_id == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, path_id, first_segment) {
        return PARSER_INVALID_NODE_ID;
    }

    let path = vitte_parser_get_node_mut(parser, path_id);
    let first_node = vitte_parser_get_node(parser, first_segment);
    if path != null {
        if first_node != null {
            set (*path).token_index = (*first_node).token_index;
        }
    }

    while parser_path_has_next_segment(parser, allow_slash_separator) {
        parser_advance(parser);
        let segment_id = parser_parse_path_segment_node(parser);
        if segment_id == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, path_id, segment_id) {
            return PARSER_INVALID_NODE_ID;
        }
        let completed_path = vitte_parser_get_node_mut(parser, path_id);
        if completed_path != null {
            set (*completed_path).span = parser_span_from_range(
                parser,
                (*completed_path).token_index,
                (*parser).position
            );
        }
    }

    return path_id;
}

proc parser_parse_path(parser: *mut Parser) -> ASTNodeId {
    return parser_parse_path_mode(parser, true);
}

proc parser_expect(parser: *mut Parser, kind: TokenKind) -> *const ParserToken {
    if parser_check(parser, kind) {
        return parser_advance(parser);
    }
    parser_error_here(parser, ParserError.ExpectedToken, kind);
    return null;
}

proc parser_is_as_keyword(parser: *const Parser) -> bool {
    let token = parser_current(parser);
    return token != null and
        ((*token).kind == TokenKind.KwAs or
         ((*token).kind == TokenKind.Identifier and (*token).lexeme == "as"));
}

proc parser_parse_use_declaration(parser: *mut Parser, incoming_node_flags: u32) -> ASTNodeId {
    let begin: usize = (*parser).position;
    parser_advance(parser);
    let path = parser_parse_path(parser);
    if path == PARSER_INVALID_NODE_ID {
        return path;
    }
    let path_node = vitte_parser_get_node(parser, path);
    if path_node == null {
        return PARSER_INVALID_NODE_ID;
    }

    let declaration = parser_add_node(
        parser,
        ASTNodeKind.UseDecl,
        parser_span_from_range(parser, begin, (*parser).position)
    );
    if declaration == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, declaration, path) {
        return PARSER_INVALID_NODE_ID;
    }

    let mut use_node_flags = incoming_node_flags;
    if parser_check(parser, TokenKind.ColonColon) {
        parser_advance(parser);
        if parser_check(parser, TokenKind.Star) {
            parser_advance(parser);
            set use_node_flags = use_node_flags | PARSER_AST_FLAG_GLOB_IMPORT;
        } else if parser_check(parser, TokenKind.LeftBrace) {
            parser_advance(parser);
            while not parser_at_end(parser) and not parser_check(parser, TokenKind.RightBrace) {
                let item = parser_parse_path(parser);
                if item == PARSER_INVALID_NODE_ID {
                    if not (*parser).recovering {
                        return PARSER_INVALID_NODE_ID;
                    }
                    let recovery = parser_synchronize_list(
                        parser,
                        TokenKind.RightBrace,
                        false,
                        (*parser).position
                    );
                    if recovery == ParserListRecovery.Next {
                        continue;
                    }
                    if recovery == ParserListRecovery.End {
                        break;
                    }
                    return PARSER_INVALID_NODE_ID;
                }
                let mut alias = PARSER_INVALID_NODE_ID;
                if parser_is_as_keyword(parser) {
                    parser_advance(parser);
                    set alias = parser_parse_identifier_node(parser);
                    if alias == PARSER_INVALID_NODE_ID {
                        if not (*parser).recovering {
                            return PARSER_INVALID_NODE_ID;
                        }
                        let recovery = parser_synchronize_list(
                            parser,
                            TokenKind.RightBrace,
                            false,
                            (*parser).position
                        );
                        if recovery == ParserListRecovery.Next {
                            continue;
                        }
                        if recovery == ParserListRecovery.End {
                            break;
                        }
                        return PARSER_INVALID_NODE_ID;
                    }
                }
                if not parser_node_append_child(parser, declaration, item) or
                   (alias != PARSER_INVALID_NODE_ID and
                    not parser_node_append_child(parser, declaration, alias)) {
                    return PARSER_INVALID_NODE_ID;
                }
                if parser_check(parser, TokenKind.Comma) {
                    parser_advance(parser);
                    continue;
                }
                if not parser_check(parser, TokenKind.RightBrace) {
                    parser_error_here(parser, ParserError.ExpectedToken, TokenKind.Comma);
                    if parser_token_is_identifier(parser_current(parser)) {
                        set (*parser).recovering = false;
                        continue;
                    }
                    let recovery = parser_synchronize_list(
                        parser,
                        TokenKind.RightBrace,
                        false,
                        (*parser).position
                    );
                    if recovery == ParserListRecovery.Next {
                        continue;
                    }
                    if recovery == ParserListRecovery.End {
                        break;
                    }
                    return PARSER_INVALID_NODE_ID;
                }
                break;
            }

            if parser_expect(parser, TokenKind.RightBrace) == null {
                return PARSER_INVALID_NODE_ID;
            }
        } else {
            parser_error_here(parser, ParserError.ExpectedToken, TokenKind.Identifier);
            return PARSER_INVALID_NODE_ID;
        }
    } else if parser_is_as_keyword(parser) {
        parser_advance(parser);
        let alias = parser_parse_identifier_node(parser);
        if alias == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, declaration, alias) {
            return PARSER_INVALID_NODE_ID;
        }
    }

    let declaration_node = vitte_parser_get_node_mut(parser, declaration);
    if declaration_node != null {
        set (*declaration_node).node_flags = use_node_flags;
    }
    if parser_expect(parser, TokenKind.Semicolon) == null {
        return PARSER_INVALID_NODE_ID;
    }

    let completed_declaration = vitte_parser_get_node_mut(parser, declaration);
    let completed_path = vitte_parser_get_node(parser, path);
    if completed_declaration != null and completed_path != null {
        set (*completed_declaration).span = parser_span_from_range(
            parser,
            begin,
            (*parser).position
        );
        set (*completed_declaration).token_index = begin;
    }
    return declaration;
}

proc parser_parse_export_clause(parser: *mut Parser) -> ASTNodeId {
    let begin: usize = (*parser).position;
    parser_advance(parser);
    let export_node = parser_add_node(
        parser,
        ASTNodeKind.UseDecl,
        parser_span_from_range(parser, (*parser).position - 1, (*parser).position)
    );
    if export_node == PARSER_INVALID_NODE_ID {
        return export_node;
    }

    let export_ast_node = vitte_parser_get_node_mut(parser, export_node);
    if export_ast_node != null {
        set (*export_ast_node).node_flags = PARSER_AST_FLAG_PUBLIC;
        set (*export_ast_node).token_index = begin;
    }

    if parser_check(parser, TokenKind.Star) {
        parser_advance(parser);
    } else {
        let grouped = parser_check(parser, TokenKind.LeftBrace);
        if grouped {
            parser_advance(parser);
        }

        let mut first_export_item = true;
        while not parser_at_end(parser) and
              (first_export_item or not grouped or
               not parser_check(parser, TokenKind.RightBrace)) {
            set first_export_item = false;
            let item = parser_parse_path(parser);
            if item == PARSER_INVALID_NODE_ID {
                if not grouped or not (*parser).recovering {
                    return PARSER_INVALID_NODE_ID;
                }
                let recovery = parser_synchronize_list(
                    parser,
                    TokenKind.RightBrace,
                    false,
                    (*parser).position
                );
                if recovery == ParserListRecovery.Next {
                    continue;
                }
                if recovery == ParserListRecovery.End {
                    break;
                }
                return PARSER_INVALID_NODE_ID;
            }

            let mut alias = PARSER_INVALID_NODE_ID;
            if parser_is_as_keyword(parser) {
                parser_advance(parser);
                set alias = parser_parse_identifier_node(parser);
                if alias == PARSER_INVALID_NODE_ID {
                    if not grouped or not (*parser).recovering {
                        return PARSER_INVALID_NODE_ID;
                    }
                    let recovery = parser_synchronize_list(
                        parser,
                        TokenKind.RightBrace,
                        false,
                        (*parser).position
                    );
                    if recovery == ParserListRecovery.Next {
                        continue;
                    }
                    if recovery == ParserListRecovery.End {
                        break;
                    }
                    return PARSER_INVALID_NODE_ID;
                }
            }

            if not parser_node_append_child(parser, export_node, item) or
               (alias != PARSER_INVALID_NODE_ID and
                not parser_node_append_child(parser, export_node, alias)) {
                return PARSER_INVALID_NODE_ID;
            }

            if not grouped {
                break;
            }
            if parser_check(parser, TokenKind.Comma) {
                parser_advance(parser);
                if parser_check(parser, TokenKind.RightBrace) {
                    break;
                }
                continue;
            }
            if parser_check(parser, TokenKind.RightBrace) {
                break;
            }

            parser_error_here(parser, ParserError.ExpectedToken, TokenKind.Comma);
            if parser_token_is_identifier(parser_current(parser)) {
                set (*parser).recovering = false;
                continue;
            }
            let recovery = parser_synchronize_list(
                parser,
                TokenKind.RightBrace,
                false,
                (*parser).position
            );
            if recovery == ParserListRecovery.Next {
                continue;
            }
            if recovery == ParserListRecovery.End {
                break;
            }
            return PARSER_INVALID_NODE_ID;
        }

        if grouped and parser_expect(parser, TokenKind.RightBrace) == null {
            return PARSER_INVALID_NODE_ID;
        }
    }

    if parser_expect(parser, TokenKind.Semicolon) == null {
        return PARSER_INVALID_NODE_ID;
    }
    let completed_export_node = vitte_parser_get_node_mut(parser, export_node);
    if completed_export_node != null {
        set (*completed_export_node).span = parser_span_from_range(
            parser,
            begin,
            (*parser).position
        );
    }
    return export_node;
}

proc parser_has_generic_closer(parser: *const Parser) -> bool {
    if parser == null or not parser_check(parser, TokenKind.Less) {
        return false;
    }

    let mut distance: usize = 0;
    let mut depth: usize = 0;
    while true {
        let token = parser_peek(parser, distance);
        if token == null {
            return false;
        }
        if (*token).kind == TokenKind.Less {
            if depth == PARSER_SIZE_MAX {
                return false;
            }
            set depth += 1;
        } else if (*token).kind == TokenKind.Greater {
            if depth == 0 {
                return false;
            }
            set depth -= 1;
            if depth == 0 {
                return true;
            }
        } else if (*token).kind == TokenKind.LeftBrace or
                  (*token).kind == TokenKind.RightBrace or
                  (*token).kind == TokenKind.Semicolon or
                  (depth == 0 and
                   ((*token).kind == TokenKind.Comma or
                    (*token).kind == TokenKind.RightParen or
                    (*token).kind == TokenKind.RightBracket)) {
            return false;
        }
        if distance == PARSER_SIZE_MAX {
            return false;
        }
        set distance += 1;
    }
    return false;
}

proc parser_has_generic_form_suffix(parser: *const Parser) -> bool {
    if parser == null or not parser_check(parser, TokenKind.Less) {
        return false;
    }

    let mut distance: usize = 0;
    let mut depth: usize = 0;
    while true {
        let token = parser_peek(parser, distance);
        if token == null {
            return false;
        }
        if (*token).kind == TokenKind.Less {
            if depth == PARSER_SIZE_MAX {
                return false;
            }
            set depth += 1;
        } else if (*token).kind == TokenKind.Greater {
            if depth == 0 {
                return false;
            }
            set depth -= 1;
            if depth == 0 {
                if distance == PARSER_SIZE_MAX {
                    return false;
                }
                let after_closer = parser_peek(parser, distance + 1);
                return after_closer != null and
                    (*after_closer).kind == TokenKind.LeftBrace;
            }
        }
        if distance == PARSER_SIZE_MAX {
            return false;
        }
        set distance += 1;
    }
    return false;
}

proc parser_recover_type_argument(
    parser: *mut Parser,
    closing_kind: TokenKind,
    start_position: usize
) -> bool {
    return parser_synchronize_list(
        parser,
        closing_kind,
        false,
        start_position
    ) == ParserListRecovery.Next;
}

proc parser_parse_type_arguments(
    parser: *mut Parser,
    owner: ASTNodeId,
    closing_kind: TokenKind
) -> bool {
    if not parser_check(parser, closing_kind) {
        while not parser_at_end(parser) {
            let argument_start = parser_current(parser);
            let argument = parser_parse_type_expression(parser);
            if argument == PARSER_INVALID_NODE_ID {
                if not (*parser).recovering {
                    return false;
                }
                if parser_recover_type_argument(
                    parser,
                    closing_kind,
                    parser_token_index(parser, argument_start)
                ) {
                    continue;
                }
                if parser_check(parser, closing_kind) {
                    break;
                }
                return false;
            }
            if not parser_node_append_child(parser, owner, argument) {
                return false;
            }
            if parser_check(parser, TokenKind.Comma) {
                parser_advance(parser);
                if parser_check(parser, closing_kind) {
                    break;
                }
                continue;
            }
            if parser_check(parser, closing_kind) {
                break;
            }

            parser_error_here(parser, ParserError.ExpectedToken, TokenKind.Comma);
            let recovery_start = parser_current(parser);
            if parser_recover_type_argument(
                parser,
                closing_kind,
                parser_token_index(parser, recovery_start)
            ) {
                continue;
            }
            if parser_check(parser, closing_kind) {
                break;
            }
            return false;
        }
    }

    return parser_expect(parser, closing_kind) != null;
}

proc parser_parse_generic_parameter(parser: *mut Parser) -> ASTNodeId {
    let begin: usize = (*parser).position;
    let name = parser_parse_identifier_node(parser);
    if name == PARSER_INVALID_NODE_ID {
        return name;
    }

    let parameter = parser_add_node(
        parser,
        ASTNodeKind.GenericParam,
        parser_span_from_range(parser, begin, (*parser).position)
    );
    if parameter == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, parameter, name) {
        return PARSER_INVALID_NODE_ID;
    }

    if parser_check(parser, TokenKind.Colon) {
        parser_advance(parser);
        let mut bound = parser_parse_type_expression(parser);
        if bound == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, parameter, bound) {
            return PARSER_INVALID_NODE_ID;
        }
        while parser_check(parser, TokenKind.Plus) {
            parser_advance(parser);
            set bound = parser_parse_type_expression(parser);
            if bound == PARSER_INVALID_NODE_ID or
               not parser_node_append_child(parser, parameter, bound) {
                return PARSER_INVALID_NODE_ID;
            }
        }
    }

    let parameter_node = vitte_parser_get_node_mut(parser, parameter);
    if parameter_node != null {
        set (*parameter_node).span = parser_span_from_range(parser, begin, (*parser).position);
        set (*parameter_node).token_index = begin;
    }
    return parameter;
}

proc parser_parse_generic_parameters(parser: *mut Parser, owner: ASTNodeId) -> bool {
    if not parser_check(parser, TokenKind.Less) {
        return true;
    }
    parser_advance(parser);
    if parser_check(parser, TokenKind.Greater) {
        parser_advance(parser);
        return true;
    }

    while not parser_at_end(parser) {
        let parameter_begin: usize = (*parser).position;
        let parameter = parser_parse_generic_parameter(parser);
        if parameter == PARSER_INVALID_NODE_ID {
            if not (*parser).recovering {
                return false;
            }
            let recovery = parser_synchronize_list(
                parser,
                TokenKind.Greater,
                false,
                parameter_begin
            );
            if recovery == ParserListRecovery.Next {
                continue;
            }
            if recovery == ParserListRecovery.End {
                break;
            }
            return false;
        }
        if not parser_node_append_child(parser, owner, parameter) {
            return false;
        }

        if parser_check(parser, TokenKind.Comma) {
            parser_advance(parser);
            if parser_check(parser, TokenKind.Greater) {
                break;
            }
            continue;
        }
        if parser_check(parser, TokenKind.Greater) {
            break;
        }

        parser_error_here(parser, ParserError.ExpectedToken, TokenKind.Comma);
        let recovery = parser_synchronize_list(
            parser,
            TokenKind.Greater,
            false,
            (*parser).position
        );
        if recovery == ParserListRecovery.Next {
            continue;
        }
        if recovery == ParserListRecovery.End {
            break;
        }
        return false;
    }

    return parser_expect(parser, TokenKind.Greater) != null;
}

proc parser_parse_where_clause(parser: *mut Parser, owner: ASTNodeId) -> bool {
    if not parser_check(parser, TokenKind.KwWhere) {
        return true;
    }

    let begin: usize = (*parser).position;
    parser_advance(parser);
    let where_clause = parser_add_node(
        parser,
        ASTNodeKind.WhereClause,
        parser_span_from_range(parser, begin, (*parser).position)
    );
    if where_clause == PARSER_INVALID_NODE_ID {
        return false;
    }
    let where_node = vitte_parser_get_node_mut(parser, where_clause);
    if where_node == null {
        return false;
    }
    set (*where_node).token_index = begin;

    while not parser_at_end(parser) {
        let predicate_begin: usize = (*parser).position;
        let subject = parser_parse_type_expression(parser);
        if subject == PARSER_INVALID_NODE_ID {
            if not (*parser).recovering {
                return false;
            }
            let recovery = parser_synchronize_list(
                parser,
                TokenKind.Invalid,
                false,
                predicate_begin
            );
            if recovery == ParserListRecovery.Next {
                continue;
            }
            if recovery == ParserListRecovery.End {
                break;
            }
            return false;
        }

        let mut relation: TokenKind = TokenKind.Colon;
        let mut trait_bound = false;
        let mut bound = PARSER_INVALID_NODE_ID;
        if parser_check(parser, TokenKind.Colon) {
            parser_advance(parser);
            set trait_bound = true;
            set bound = parser_parse_type_expression(parser);
        } else if parser_check(parser, TokenKind.EqualEqual) or
                  parser_check(parser, TokenKind.BangEqual) or
                  parser_check(parser, TokenKind.Less) or
                  parser_check(parser, TokenKind.LessEqual) or
                  parser_check(parser, TokenKind.Greater) or
                  parser_check(parser, TokenKind.GreaterEqual) {
            let relation_token = parser_advance(parser);
            if relation_token != null {
                set relation = (*relation_token).kind;
            }
            set bound = parser_parse_expression(parser);
        } else {
            parser_error_here(parser, ParserError.ExpectedToken, TokenKind.Colon);
        }

        if bound == PARSER_INVALID_NODE_ID {
            if not (*parser).recovering {
                return false;
            }
            let recovery = parser_synchronize_list(
                parser,
                TokenKind.Invalid,
                false,
                predicate_begin
            );
            if recovery == ParserListRecovery.Next {
                continue;
            }
            if recovery == ParserListRecovery.End {
                break;
            }
            return false;
        }

        let predicate = parser_add_node(
            parser,
            ASTNodeKind.WherePredicate,
            parser_span_from_range(parser, predicate_begin, (*parser).position)
        );
        if predicate == PARSER_INVALID_NODE_ID {
            return false;
        }
        let predicate_node = vitte_parser_get_node_mut(parser, predicate);
        if predicate_node == null {
            return false;
        }
        set (*predicate_node).operator_kind = relation;
        set (*predicate_node).token_index = predicate_begin;
        if not parser_node_append_child(parser, predicate, subject) or
           not parser_node_append_child(parser, predicate, bound) {
            return false;
        }

        if trait_bound {
            while parser_check(parser, TokenKind.Plus) {
                parser_advance(parser);
                let extra_bound = parser_parse_type_expression(parser);
                if extra_bound == PARSER_INVALID_NODE_ID or
                   not parser_node_append_child(parser, predicate, extra_bound) {
                    return false;
                }
                let completed_predicate = vitte_parser_get_node_mut(parser, predicate);
                if completed_predicate != null {
                    set (*completed_predicate).span = parser_span_from_range(
                        parser,
                        predicate_begin,
                        (*parser).position
                    );
                }
            }
        }
        if not parser_node_append_child(parser, where_clause, predicate) {
            return false;
        }

        if parser_check(parser, TokenKind.Comma) {
            parser_advance(parser);
            continue;
        }
        if parser_check(parser, TokenKind.LeftBrace) or
           parser_check(parser, TokenKind.Equal) or
           parser_check(parser, TokenKind.Semicolon) {
            break;
        }

        parser_error_here(parser, ParserError.ExpectedToken, TokenKind.Comma);
        let recovery = parser_synchronize_list(
            parser,
            TokenKind.Invalid,
            false,
            (*parser).position
        );
        if recovery == ParserListRecovery.Next {
            continue;
        }
        if recovery == ParserListRecovery.End {
            break;
        }
        return false;
    }

    let completed_where = vitte_parser_get_node_mut(parser, where_clause);
    if completed_where != null {
        set (*completed_where).span = parser_span_from_range(parser, begin, (*parser).position);
    }
    return parser_node_append_child(parser, owner, where_clause);
}

proc parser_type_span(parser: *const Parser, begin_token: *const ParserToken) -> ParserSpan {
    return parser_span_from_range(
        parser,
        parser_token_index(parser, begin_token),
        (*parser).position
    );
}

proc parser_parse_type_expression(parser: *mut Parser) -> ASTNodeId {
    if not parser_enter_recursion(parser) {
        return PARSER_INVALID_NODE_ID;
    }
    let begin_token = parser_current(parser);
    let parsed_type = parser_parse_type_expression_inner(parser, begin_token);
    parser_leave_recursion(parser);
    return parsed_type;
}

proc parser_parse_type_expression_inner(
    parser: *mut Parser,
    begin_token: *const ParserToken
) -> ASTNodeId {
    if parser_check(parser, TokenKind.KwProc) {
        parser_advance(parser);
        let procedure_type = parser_add_node(
            parser,
            ASTNodeKind.TypeExpr,
            parser_type_span(parser, begin_token)
        );
        if procedure_type == PARSER_INVALID_NODE_ID {
            return procedure_type;
        }
        let procedure_type_node = vitte_parser_get_node_mut(parser, procedure_type);
        if procedure_type_node != null {
            set (*procedure_type_node).operator_kind = TokenKind.KwProc;
        }
        if parser_expect(parser, TokenKind.LeftParen) == null {
            return PARSER_INVALID_NODE_ID;
        }

        while not parser_at_end(parser) and not parser_check(parser, TokenKind.RightParen) {
            if parser_check(parser, TokenKind.Identifier) and
               parser_check_next(parser, TokenKind.Colon) {
                parser_advance(parser);
                parser_advance(parser);
            }
            let parameter_type = parser_parse_type_expression(parser);
            if parameter_type == PARSER_INVALID_NODE_ID or
               not parser_node_append_child(parser, procedure_type, parameter_type) {
                return PARSER_INVALID_NODE_ID;
            }
            if parser_check(parser, TokenKind.Comma) {
                parser_advance(parser);
                if parser_check(parser, TokenKind.RightParen) {
                    break;
                }
                continue;
            }
            if not parser_check(parser, TokenKind.RightParen) {
                parser_error_here(parser, ParserError.ExpectedToken, TokenKind.Comma);
                return PARSER_INVALID_NODE_ID;
            }
        }
        if parser_expect(parser, TokenKind.RightParen) == null {
            return PARSER_INVALID_NODE_ID;
        }

        let has_return_type = parser_check(parser, TokenKind.Arrow);
        if has_return_type {
            parser_advance(parser);
            let return_type = parser_parse_type_expression(parser);
            if return_type == PARSER_INVALID_NODE_ID or
               not parser_node_append_child(parser, procedure_type, return_type) {
                return PARSER_INVALID_NODE_ID;
            }
        }
        let completed_procedure_type = vitte_parser_get_node_mut(parser, procedure_type);
        if completed_procedure_type != null {
            set (*completed_procedure_type).span = parser_type_span(parser, begin_token);
            if has_return_type {
                set (*completed_procedure_type).node_flags =
                    (*completed_procedure_type).node_flags |
                    PARSER_AST_FLAG_FUNCTION_TYPE_HAS_RETURN;
            }
        }
        return procedure_type;
    }

    if parser_check(parser, TokenKind.Question) {
        parser_advance(parser);
        let inner_type = parser_parse_type_expression(parser);
        if inner_type == PARSER_INVALID_NODE_ID {
            return inner_type;
        }
        let optional_type = parser_add_node(
            parser,
            ASTNodeKind.OptionalType,
            parser_type_span(parser, begin_token)
        );
        if optional_type == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, optional_type, inner_type) {
            return PARSER_INVALID_NODE_ID;
        }
        return optional_type;
    }

    if parser_check(parser, TokenKind.Amp) or parser_check(parser, TokenKind.KwRef) {
        parser_advance(parser);
        let mutable_reference = parser_check(parser, TokenKind.KwMut);
        if mutable_reference {
            parser_advance(parser);
        }
        let pointee_type = parser_parse_type_expression(parser);
        if pointee_type == PARSER_INVALID_NODE_ID {
            return pointee_type;
        }
        let reference_type = parser_add_node(
            parser,
            ASTNodeKind.ReferenceType,
            parser_type_span(parser, begin_token)
        );
        if reference_type == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, reference_type, pointee_type) {
            return PARSER_INVALID_NODE_ID;
        }
        if mutable_reference {
            let reference_type_node = vitte_parser_get_node_mut(parser, reference_type);
            if reference_type_node != null {
                set (*reference_type_node).node_flags =
                    (*reference_type_node).node_flags | PARSER_AST_FLAG_MUTABLE;
            }
        }
        return reference_type;
    }

    if parser_check(parser, TokenKind.Star) {
        parser_advance(parser);
        let mut mutable_pointer = false;
        if parser_check(parser, TokenKind.KwMut) {
            parser_advance(parser);
            set mutable_pointer = true;
        } else {
            if parser_check(parser, TokenKind.KwConst) {
                parser_advance(parser);
            }
            let qualifier = parser_current(parser);
            if qualifier != null and (*qualifier).kind == TokenKind.KwReserved and
               (*qualifier).lexeme == "volatile" {
                parser_advance(parser);
            }
        }
        let pointee_type = parser_parse_type_expression(parser);
        if pointee_type == PARSER_INVALID_NODE_ID {
            return pointee_type;
        }
        let pointer_type = parser_add_node(
            parser,
            ASTNodeKind.PointerType,
            parser_type_span(parser, begin_token)
        );
        if pointer_type == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, pointer_type, pointee_type) {
            return PARSER_INVALID_NODE_ID;
        }
        if mutable_pointer {
            let pointer_type_node = vitte_parser_get_node_mut(parser, pointer_type);
            if pointer_type_node != null {
                set (*pointer_type_node).node_flags =
                    (*pointer_type_node).node_flags | PARSER_AST_FLAG_MUTABLE;
            }
        }
        return pointer_type;
    }

    if parser_check(parser, TokenKind.LeftBracket) {
        parser_advance(parser);
        let first_item = parser_current(parser);
        if first_item != null and (*first_item).kind != TokenKind.IntegerLiteral {
            let element_type = parser_parse_type_expression(parser);
            if element_type == PARSER_INVALID_NODE_ID {
                return element_type;
            }
            if parser_check(parser, TokenKind.Semicolon) {
                parser_advance(parser);
                let length_expression = parser_parse_expression(parser);
                if length_expression == PARSER_INVALID_NODE_ID or
                   parser_expect(parser, TokenKind.RightBracket) == null {
                    return PARSER_INVALID_NODE_ID;
                }
                let array_type = parser_add_node(
                    parser,
                    ASTNodeKind.ArrayType,
                    parser_type_span(parser, begin_token)
                );
                if array_type == PARSER_INVALID_NODE_ID or
                   not parser_node_append_child(parser, array_type, length_expression) or
                   not parser_node_append_child(parser, array_type, element_type) {
                    return PARSER_INVALID_NODE_ID;
                }
                return array_type;
            }
            if parser_expect(parser, TokenKind.RightBracket) == null {
                return PARSER_INVALID_NODE_ID;
            }
            let slice_type = parser_add_node(
                parser,
                ASTNodeKind.ArrayType,
                parser_type_span(parser, begin_token)
            );
            if slice_type == PARSER_INVALID_NODE_ID or
               not parser_node_append_child(parser, slice_type, element_type) {
                return PARSER_INVALID_NODE_ID;
            }
            return slice_type;
        }

        let length_expression = parser_parse_expression(parser);
        if length_expression == PARSER_INVALID_NODE_ID or
           parser_expect(parser, TokenKind.RightBracket) == null {
            return PARSER_INVALID_NODE_ID;
        }
        let element_type = parser_parse_type_expression(parser);
        if element_type == PARSER_INVALID_NODE_ID {
            return element_type;
        }
        let fixed_array_type = parser_add_node(
            parser,
            ASTNodeKind.ArrayType,
            parser_type_span(parser, begin_token)
        );
        if fixed_array_type == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, fixed_array_type, length_expression) or
           not parser_node_append_child(parser, fixed_array_type, element_type) {
            return PARSER_INVALID_NODE_ID;
        }
        return fixed_array_type;
    }

    let base_path = parser_parse_path(parser);
    if base_path == PARSER_INVALID_NODE_ID {
        return base_path;
    }
    let named_type = parser_add_node(
        parser,
        ASTNodeKind.TypeExpr,
        parser_type_span(parser, begin_token)
    );
    if named_type == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, named_type, base_path) {
        return PARSER_INVALID_NODE_ID;
    }

    if parser_check(parser, TokenKind.Less) and parser_has_generic_closer(parser) {
        parser_advance(parser);
        if not parser_parse_type_arguments(parser, named_type, TokenKind.Greater) {
            return PARSER_INVALID_NODE_ID;
        }
    } else if parser_check(parser, TokenKind.LeftBracket) {
        parser_advance(parser);
        if not parser_parse_type_arguments(parser, named_type, TokenKind.RightBracket) {
            return PARSER_INVALID_NODE_ID;
        }
    }

    let completed_named_type = vitte_parser_get_node_mut(parser, named_type);
    if completed_named_type != null {
        set (*completed_named_type).span = parser_type_span(parser, begin_token);
    }
    return named_type;
}

proc parser_parse_value_literal(parser: *mut Parser, kind: ASTNodeKind) -> ASTNodeId {
    let token = parser_current(parser);
    if token == null {
        return PARSER_INVALID_NODE_ID;
    }
    parser_advance(parser);
    let literal = parser_add_node(parser, kind, parser_span_from_token(token));
    if literal == PARSER_INVALID_NODE_ID {
        return literal;
    }
    let literal_node = vitte_parser_get_node_mut(parser, literal);
    if literal_node != null {
        set (*literal_node).token_index = (*parser).position - 1;
    }
    return literal;
}

proc parser_parse_value_initializer_atom(parser: *mut Parser) -> ASTNodeId {
    if parser_check(parser, TokenKind.KwNull) and parser_check_next(parser, TokenKind.LeftParen) {
        return parser_parse_path_mode(parser, false);
    }
    if parser_check(parser, TokenKind.IntegerLiteral) {
        return parser_parse_value_literal(parser, ASTNodeKind.IntegerLiteral);
    }
    if parser_check(parser, TokenKind.FloatLiteral) {
        return parser_parse_value_literal(parser, ASTNodeKind.FloatLiteral);
    }
    if parser_check(parser, TokenKind.StringLiteral) {
        return parser_parse_value_literal(parser, ASTNodeKind.StringLiteral);
    }
    if parser_check(parser, TokenKind.CharacterLiteral) {
        return parser_parse_value_literal(parser, ASTNodeKind.CharacterLiteral);
    }
    if parser_check(parser, TokenKind.KwTrue) or parser_check(parser, TokenKind.KwFalse) {
        return parser_parse_value_literal(parser, ASTNodeKind.BoolLiteral);
    }
    if parser_check(parser, TokenKind.KwNull) {
        return parser_parse_value_literal(parser, ASTNodeKind.NullLiteral);
    }

    let token = parser_current(parser);
    if parser_token_is_path_segment(token) {
        return parser_parse_path_mode(parser, false);
    }
    parser_error_here(parser, ParserError.ExpectedExpression, TokenKind.Invalid);
    return PARSER_INVALID_NODE_ID;
}

proc parser_is_unary_operator(kind: TokenKind) -> bool {
    return kind == TokenKind.Plus or kind == TokenKind.Minus or
        kind == TokenKind.Tilde or kind == TokenKind.Star or
        kind == TokenKind.Amp or kind == TokenKind.KwNot or
        kind == TokenKind.KwMove or kind == TokenKind.KwRef or
        kind == TokenKind.KwAwait;
}

proc parser_binary_precedence(kind: TokenKind) -> u32 {
    if kind == TokenKind.Equal or kind == TokenKind.PlusEqual or
       kind == TokenKind.MinusEqual or kind == TokenKind.StarEqual or
       kind == TokenKind.SlashEqual or kind == TokenKind.PercentEqual or
       kind == TokenKind.AmpEqual or kind == TokenKind.PipeEqual or
       kind == TokenKind.CaretEqual or kind == TokenKind.ShiftLeftEqual or
       kind == TokenKind.ShiftRightEqual {
        return 1;
    }
    if kind == TokenKind.QuestionQuestion { return 2; }
    if kind == TokenKind.KwOr { return 3; }
    if kind == TokenKind.KwAnd { return 4; }
    if kind == TokenKind.Pipe { return 5; }
    if kind == TokenKind.Caret { return 6; }
    if kind == TokenKind.Amp { return 7; }
    if kind == TokenKind.EqualEqual or kind == TokenKind.BangEqual { return 8; }
    if kind == TokenKind.Less or kind == TokenKind.LessEqual or
       kind == TokenKind.Greater or kind == TokenKind.GreaterEqual {
        return 9;
    }
    if kind == TokenKind.ShiftLeft or kind == TokenKind.ShiftRight { return 10; }
    if kind == TokenKind.Plus or kind == TokenKind.Minus { return 11; }
    if kind == TokenKind.Star or kind == TokenKind.Slash or kind == TokenKind.Percent { return 12; }
    if kind == TokenKind.DotDot or kind == TokenKind.DotDotEqual { return 13; }
    return 0;
}

proc parser_binary_right_associative(kind: TokenKind) -> bool {
    return kind == TokenKind.Equal or kind == TokenKind.PlusEqual or
        kind == TokenKind.MinusEqual or kind == TokenKind.StarEqual or
        kind == TokenKind.SlashEqual or kind == TokenKind.PercentEqual or
        kind == TokenKind.AmpEqual or kind == TokenKind.PipeEqual or
        kind == TokenKind.CaretEqual or kind == TokenKind.ShiftLeftEqual or
        kind == TokenKind.ShiftRightEqual or kind == TokenKind.QuestionQuestion;
}

proc parser_make_unary_expression(
    parser: *mut Parser,
    node_kind: ASTNodeKind,
    operator_kind: TokenKind,
    operator_token: *const ParserToken,
    operand: ASTNodeId,
    mutable_reference: bool
) -> ASTNodeId {
    let operand_node = vitte_parser_get_node(parser, operand);
    if operand_node == null {
        return PARSER_INVALID_NODE_ID;
    }
    let unary_span = parser_span_join(parser_span_from_token(operator_token), (*operand_node).span);
    let unary = parser_add_node(parser, node_kind, unary_span);
    if unary == PARSER_INVALID_NODE_ID {
        return unary;
    }
    let unary_node = vitte_parser_get_node_mut(parser, unary);
    if unary_node != null {
        set (*unary_node).operator_kind = operator_kind;
        set (*unary_node).token_index = parser_token_index(parser, operator_token);
        if mutable_reference {
            set (*unary_node).node_flags = (*unary_node).node_flags | PARSER_AST_FLAG_MUTABLE;
        }
    }
    if not parser_node_append_child(parser, unary, operand) {
        return PARSER_INVALID_NODE_ID;
    }
    return unary;
}

proc parser_make_binary_expression(
    parser: *mut Parser,
    node_kind: ASTNodeKind,
    operator_kind: TokenKind,
    operator_token: *const ParserToken,
    left: ASTNodeId,
    right: ASTNodeId
) -> ASTNodeId {
    let left_node = vitte_parser_get_node(parser, left);
    let right_node = vitte_parser_get_node(parser, right);
    if left_node == null or right_node == null {
        return PARSER_INVALID_NODE_ID;
    }
    let binary_span = parser_span_join((*left_node).span, (*right_node).span);
    let binary = parser_add_node(parser, node_kind, binary_span);
    if binary == PARSER_INVALID_NODE_ID {
        return binary;
    }
    let binary_node = vitte_parser_get_node_mut(parser, binary);
    if binary_node != null {
        set (*binary_node).operator_kind = operator_kind;
        set (*binary_node).token_index = parser_token_index(parser, operator_token);
    }
    if not parser_node_append_child(parser, binary, left) or
       not parser_node_append_child(parser, binary, right) {
        return PARSER_INVALID_NODE_ID;
    }
    return binary;
}

proc parser_parse_group_expression(parser: *mut Parser) -> ASTNodeId {
    let open_token = parser_advance(parser);
    let expression = parser_parse_expression(parser);
    if expression == PARSER_INVALID_NODE_ID or
       parser_expect(parser, TokenKind.RightParen) == null {
        return PARSER_INVALID_NODE_ID;
    }
    let group = parser_add_node(
        parser,
        ASTNodeKind.GroupExpr,
        parser_span_from_range(parser, parser_token_index(parser, open_token), (*parser).position)
    );
    if group == PARSER_INVALID_NODE_ID {
        return group;
    }
    let group_node = vitte_parser_get_node_mut(parser, group);
    if group_node != null {
        set (*group_node).token_index = parser_token_index(parser, open_token);
    }
    if not parser_node_append_child(parser, group, expression) {
        return PARSER_INVALID_NODE_ID;
    }
    return group;
}

proc parser_parse_print_primary(parser: *mut Parser) -> ASTNodeId {
    let token = parser_advance(parser);
    if token == null {
        return PARSER_INVALID_NODE_ID;
    }
    let identifier = parser_add_node(
        parser,
        ASTNodeKind.Identifier,
        parser_span_from_token(token)
    );
    if identifier == PARSER_INVALID_NODE_ID {
        return identifier;
    }
    let identifier_node = vitte_parser_get_node_mut(parser, identifier);
    if identifier_node != null {
        set (*identifier_node).token_index = parser_token_index(parser, token);
    }
    let path = parser_add_node(
        parser,
        ASTNodeKind.Path,
        parser_span_from_token(token)
    );
    if path == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, path, identifier) {
        return PARSER_INVALID_NODE_ID;
    }
    return path;
}

proc parser_sizeof_operand_is_type(parser: *const Parser) -> bool {
    let token = parser_current(parser);
    if token == null {
        return false;
    }
    let next = parser_peek(parser, 1);

    if (*token).kind == TokenKind.KwProc or
       (*token).kind == TokenKind.KwRef or
       (*token).kind == TokenKind.Question {
        return true;
    }
    if (*token).kind == TokenKind.Star or (*token).kind == TokenKind.Amp {
        if next != null and
           ((*next).kind == TokenKind.KwConst or
            (*next).kind == TokenKind.KwMut or
            ((*next).kind == TokenKind.KwReserved and
             (*next).lexeme == "volatile")) {
            return true;
        }
        if (*token).kind == TokenKind.Star and next != null and
           ((*next).lexeme == "u8" or (*next).lexeme == "u32" or
            (*next).lexeme == "u64" or (*next).lexeme == "usize" or
            (*next).lexeme == "i64" or (*next).lexeme == "bool" or
            (*next).lexeme == "char") {
            return true;
        }
        return false;
    }

    if (*token).lexeme == "u8" or (*token).lexeme == "u32" or
       (*token).lexeme == "u64" or (*token).lexeme == "usize" or
       (*token).lexeme == "i64" or (*token).lexeme == "f32" or
       (*token).lexeme == "f64" or (*token).lexeme == "bool" or
       (*token).lexeme == "char" or (*token).lexeme == "str" or
       (*token).lexeme == "string" {
        return true;
    }
    if (*token).kind != TokenKind.LeftBracket {
        return false;
    }

    let mut distance: usize = 0;
    let mut bracket_depth: usize = 0;
    while true {
        let current = parser_peek(parser, distance);
        if current == null {
            return false;
        }
        if (*current).kind == TokenKind.LeftBracket {
            if bracket_depth == PARSER_SIZE_MAX {
                return false;
            }
            set bracket_depth += 1;
        } else if (*current).kind == TokenKind.RightBracket {
            if bracket_depth == 0 {
                return false;
            }
            set bracket_depth -= 1;
            if bracket_depth == 0 {
                return false;
            }
        } else if (*current).kind == TokenKind.Semicolon {
            return true;
        }
        if distance == PARSER_SIZE_MAX {
            return false;
        }
        set distance += 1;
    }
    return false;
}

proc parser_parse_sizeof_expression(parser: *mut Parser) -> ASTNodeId {
    let operator_token = parser_current(parser);
    if operator_token == null or
       parser_expect(parser, TokenKind.KwSizeof) == null or
       parser_expect(parser, TokenKind.LeftParen) == null {
        return PARSER_INVALID_NODE_ID;
    }
    let type_operand = parser_sizeof_operand_is_type(parser);
    let mut operand: ASTNodeId = PARSER_INVALID_NODE_ID;
    if type_operand {
        set operand = parser_parse_type_expression(parser);
    } else {
        set operand = parser_parse_expression(parser);
    }
    if operand == PARSER_INVALID_NODE_ID or
       parser_expect(parser, TokenKind.RightParen) == null {
        return PARSER_INVALID_NODE_ID;
    }
    let expression_span: ParserSpan = parser_span_join(
        parser_span_from_token(operator_token),
        parser_span_from_token(parser_previous(parser))
    );
    let expression = parser_add_node(parser, ASTNodeKind.SizeofExpr, expression_span);
    if expression == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, expression, operand) {
        return PARSER_INVALID_NODE_ID;
    }
    let expression_node = vitte_parser_get_node_mut(parser, expression);
    if expression_node != null {
        set (*expression_node).token_index = parser_token_index(parser, operator_token);
        if type_operand {
            set (*expression_node).node_flags =
                (*expression_node).node_flags | PARSER_AST_FLAG_TYPE_QUERY_TYPE_OPERAND;
        }
    }
    return expression;
}

proc parser_parse_alignof_expression(parser: *mut Parser) -> ASTNodeId {
    let operator_token = parser_current(parser);
    if operator_token == null or
       parser_expect(parser, TokenKind.KwAlignof) == null or
       parser_expect(parser, TokenKind.LeftParen) == null {
        return PARSER_INVALID_NODE_ID;
    }
    let operand = parser_parse_type_expression(parser);
    if operand == PARSER_INVALID_NODE_ID or
       parser_expect(parser, TokenKind.RightParen) == null {
        return PARSER_INVALID_NODE_ID;
    }
    let expression_span: ParserSpan = parser_span_join(
        parser_span_from_token(operator_token),
        parser_span_from_token(parser_previous(parser))
    );
    let expression = parser_add_node(parser, ASTNodeKind.AlignofExpr, expression_span);
    if expression == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, expression, operand) {
        return PARSER_INVALID_NODE_ID;
    }
    let expression_node = vitte_parser_get_node_mut(parser, expression);
    if expression_node != null {
        set (*expression_node).token_index = parser_token_index(parser, operator_token);
        set (*expression_node).node_flags =
            (*expression_node).node_flags | PARSER_AST_FLAG_TYPE_QUERY_TYPE_OPERAND;
    }
    return expression;
}

proc parser_parse_array_expression(parser: *mut Parser) -> ASTNodeId {
    let open_token = parser_expect(parser, TokenKind.LeftBracket);
    if open_token == null {
        return PARSER_INVALID_NODE_ID;
    }
    let array = parser_add_node(
        parser,
        ASTNodeKind.ArrayExpr,
        parser_span_from_token(open_token)
    );
    if array == PARSER_INVALID_NODE_ID {
        return array;
    }

    while not parser_at_end(parser) and not parser_check(parser, TokenKind.RightBracket) {
        let item_start = parser_current(parser);
        let item = parser_parse_expression(parser);
        if item == PARSER_INVALID_NODE_ID {
            if not (*parser).recovering {
                return PARSER_INVALID_NODE_ID;
            }
            if parser_recover_type_argument(
                parser,
                TokenKind.RightBracket,
                parser_token_index(parser, item_start)
            ) {
                continue;
            }
            if parser_check(parser, TokenKind.RightBracket) {
                break;
            }
            return PARSER_INVALID_NODE_ID;
        }
        if not parser_node_append_child(parser, array, item) {
            return PARSER_INVALID_NODE_ID;
        }
        if parser_check(parser, TokenKind.Comma) {
            parser_advance(parser);
            continue;
        }
        if parser_check(parser, TokenKind.RightBracket) {
            break;
        }
        parser_error_here(parser, ParserError.ExpectedToken, TokenKind.Comma);
        let recovery_start = parser_current(parser);
        if parser_recover_type_argument(
            parser,
            TokenKind.RightBracket,
            parser_token_index(parser, recovery_start)
        ) {
            continue;
        }
        if parser_check(parser, TokenKind.RightBracket) {
            break;
        }
        return PARSER_INVALID_NODE_ID;
    }

    if parser_expect(parser, TokenKind.RightBracket) == null {
        return PARSER_INVALID_NODE_ID;
    }
    let array_node = vitte_parser_get_node_mut(parser, array);
    if array_node != null {
        set (*array_node).span = parser_span_join(
            parser_span_from_token(open_token),
            parser_span_from_token(parser_previous(parser))
        );
    }
    return array;
}

proc parser_parse_let_statement(parser: *mut Parser) -> ASTNodeId {
    let start_token = parser_current(parser);
    if start_token == null or parser_expect(parser, TokenKind.KwLet) == null {
        return PARSER_INVALID_NODE_ID;
    }
    let statement = parser_add_node(
        parser,
        ASTNodeKind.LetStmt,
        parser_span_from_token(start_token)
    );
    if statement == PARSER_INVALID_NODE_ID {
        return statement;
    }
    let statement_node = vitte_parser_get_node_mut(parser, statement);
    if statement_node != null {
        set (*statement_node).token_index = parser_token_index(parser, start_token);
    }
    if parser_check(parser, TokenKind.KwMut) {
        parser_advance(parser);
        if statement_node != null {
            set (*statement_node).node_flags =
                (*statement_node).node_flags | PARSER_AST_FLAG_MUTABLE;
        }
    }

    let binding = parser_parse_pattern(parser);
    if binding == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, statement, binding) {
        return PARSER_INVALID_NODE_ID;
    }
    if parser_check(parser, TokenKind.Colon) {
        parser_advance(parser);
        let binding_type = parser_parse_type_expression(parser);
        if binding_type == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, statement, binding_type) {
            return PARSER_INVALID_NODE_ID;
        }
    }
    if parser_check(parser, TokenKind.Equal) {
        parser_advance(parser);
        let initializer = parser_parse_expression(parser);
        if initializer == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, statement, initializer) {
            return PARSER_INVALID_NODE_ID;
        }
    }
    if parser_expect(parser, TokenKind.Semicolon) == null {
        return PARSER_INVALID_NODE_ID;
    }

    let completed_statement = vitte_parser_get_node_mut(parser, statement);
    if completed_statement != null {
        set (*completed_statement).span = parser_span_from_range(
            parser,
            parser_token_index(parser, start_token),
            (*parser).position
        );
    }
    return statement;
}

proc parser_parse_expression_statement(parser: *mut Parser) -> ASTNodeId {
    let start_token = parser_current(parser);
    if start_token == null {
        return PARSER_INVALID_NODE_ID;
    }
    let expression = parser_parse_expression(parser);
    if expression == PARSER_INVALID_NODE_ID {
        return expression;
    }
    let statement = parser_add_node(
        parser,
        ASTNodeKind.ExprStmt,
        parser_span_from_range(
            parser,
            parser_token_index(parser, start_token),
            (*parser).position
        )
    );
    if statement == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, statement, expression) {
        return PARSER_INVALID_NODE_ID;
    }
    if parser_check(parser, TokenKind.Semicolon) {
        parser_advance(parser);
        let completed_statement = vitte_parser_get_node_mut(parser, statement);
        if completed_statement != null {
            set (*completed_statement).span = parser_span_from_range(
                parser,
                parser_token_index(parser, start_token),
                (*parser).position
            );
        }
    }
    return statement;
}

proc parser_parse_return_statement(parser: *mut Parser) -> ASTNodeId {
    let start_token = parser_current(parser);
    if start_token == null or parser_expect(parser, TokenKind.KwReturn) == null {
        return PARSER_INVALID_NODE_ID;
    }
    let statement = parser_add_node(
        parser,
        ASTNodeKind.ReturnStmt,
        parser_span_from_token(start_token)
    );
    if statement == PARSER_INVALID_NODE_ID {
        return statement;
    }
    if not parser_check(parser, TokenKind.Semicolon) {
        let value = parser_parse_expression(parser);
        if value == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, statement, value) {
            return PARSER_INVALID_NODE_ID;
        }
    }
    if parser_expect(parser, TokenKind.Semicolon) == null {
        return PARSER_INVALID_NODE_ID;
    }
    let completed_statement = vitte_parser_get_node_mut(parser, statement);
    if completed_statement != null {
        set (*completed_statement).span = parser_span_from_range(
            parser,
            parser_token_index(parser, start_token),
            (*parser).position
        );
    }
    return statement;
}

proc parser_parse_jump_statement(
    parser: *mut Parser,
    kind: ASTNodeKind
) -> ASTNodeId {
    let start_token = parser_current(parser);
    if start_token == null {
        return PARSER_INVALID_NODE_ID;
    }
    parser_advance(parser);
    let statement = parser_add_node(
        parser,
        kind,
        parser_span_from_token(start_token)
    );
    if statement == PARSER_INVALID_NODE_ID or
       parser_expect(parser, TokenKind.Semicolon) == null {
        return PARSER_INVALID_NODE_ID;
    }
    let completed_statement = vitte_parser_get_node_mut(parser, statement);
    if completed_statement != null {
        set (*completed_statement).span = parser_span_from_range(
            parser,
            parser_token_index(parser, start_token),
            (*parser).position
        );
    }
    return statement;
}

proc parser_parse_if_statement(parser: *mut Parser) -> ASTNodeId {
    let start_token = parser_current(parser);
    if start_token == null or
       (not parser_check(parser, TokenKind.KwIf) and
        not parser_check(parser, TokenKind.KwElif)) {
        parser_error_here(parser, ParserError.ExpectedToken, TokenKind.KwIf);
        return PARSER_INVALID_NODE_ID;
    }
    parser_advance(parser);

    let condition = parser_parse_expression(parser);
    if condition == PARSER_INVALID_NODE_ID {
        return condition;
    }
    let then_branch = parser_parse_block(parser);
    if then_branch == PARSER_INVALID_NODE_ID {
        return then_branch;
    }

    let statement = parser_add_node(
        parser,
        ASTNodeKind.IfStmt,
        parser_span_from_range(
            parser,
            parser_token_index(parser, start_token),
            (*parser).position
        )
    );
    if statement == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, statement, condition) or
       not parser_node_append_child(parser, statement, then_branch) {
        return PARSER_INVALID_NODE_ID;
    }

    if parser_check(parser, TokenKind.KwElif) {
        let else_branch = parser_parse_if_statement(parser);
        if else_branch == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, statement, else_branch) {
            return PARSER_INVALID_NODE_ID;
        }
    } else if parser_check(parser, TokenKind.KwElse) {
        parser_advance(parser);
        let mut else_branch: ASTNodeId = PARSER_INVALID_NODE_ID;
        if parser_check(parser, TokenKind.KwIf) or
           parser_check(parser, TokenKind.KwElif) {
            set else_branch = parser_parse_if_statement(parser);
        } else {
            set else_branch = parser_parse_block(parser);
        }
        if else_branch == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, statement, else_branch) {
            return PARSER_INVALID_NODE_ID;
        }
    }

    let completed_statement = vitte_parser_get_node_mut(parser, statement);
    if completed_statement != null {
        set (*completed_statement).span = parser_span_from_range(
            parser,
            parser_token_index(parser, start_token),
            (*parser).position
        );
    }
    return statement;
}

proc parser_parse_while_statement(parser: *mut Parser) -> ASTNodeId {
    let start_token = parser_current(parser);
    if start_token == null or parser_expect(parser, TokenKind.KwWhile) == null {
        return PARSER_INVALID_NODE_ID;
    }
    let condition = parser_parse_expression(parser);
    if condition == PARSER_INVALID_NODE_ID {
        return condition;
    }
    let body = parser_parse_block(parser);
    if body == PARSER_INVALID_NODE_ID {
        return body;
    }

    let statement = parser_add_node(
        parser,
        ASTNodeKind.WhileStmt,
        parser_span_from_range(
            parser,
            parser_token_index(parser, start_token),
            (*parser).position
        )
    );
    if statement == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, statement, condition) or
       not parser_node_append_child(parser, statement, body) {
        return PARSER_INVALID_NODE_ID;
    }
    return statement;
}

proc parser_parse_loop_statement(parser: *mut Parser) -> ASTNodeId {
    let start_token = parser_current(parser);
    if start_token == null or parser_expect(parser, TokenKind.KwLoop) == null {
        return PARSER_INVALID_NODE_ID;
    }
    let body = parser_parse_block(parser);
    if body == PARSER_INVALID_NODE_ID {
        return body;
    }

    let statement = parser_add_node(
        parser,
        ASTNodeKind.LoopStmt,
        parser_span_from_range(
            parser,
            parser_token_index(parser, start_token),
            (*parser).position
        )
    );
    if statement == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, statement, body) {
        return PARSER_INVALID_NODE_ID;
    }
    return statement;
}

proc parser_parse_for_statement(parser: *mut Parser) -> ASTNodeId {
    let start_token = parser_current(parser);
    if start_token == null or parser_expect(parser, TokenKind.KwFor) == null {
        return PARSER_INVALID_NODE_ID;
    }
    let binding = parser_parse_pattern(parser);
    if binding == PARSER_INVALID_NODE_ID or
       parser_expect(parser, TokenKind.KwIn) == null {
        return PARSER_INVALID_NODE_ID;
    }
    let iterable = parser_parse_expression(parser);
    if iterable == PARSER_INVALID_NODE_ID {
        return iterable;
    }
    let body = parser_parse_block(parser);
    if body == PARSER_INVALID_NODE_ID {
        return body;
    }

    let statement = parser_add_node(
        parser,
        ASTNodeKind.ForStmt,
        parser_span_from_range(
            parser,
            parser_token_index(parser, start_token),
            (*parser).position
        )
    );
    if statement == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, statement, binding) or
       not parser_node_append_child(parser, statement, iterable) or
       not parser_node_append_child(parser, statement, body) {
        return PARSER_INVALID_NODE_ID;
    }
    return statement;
}

proc parser_parse_pattern_sequence(
    parser: *mut Parser,
    closing: TokenKind,
    begin: usize
) -> ASTNodeId {
    let wrapper = parser_add_node(
        parser,
        ASTNodeKind.Pattern,
        parser_span_from_range(parser, begin, (*parser).position)
    );
    if wrapper == PARSER_INVALID_NODE_ID { return wrapper; }

    while not parser_at_end(parser) and not parser_check(parser, closing) {
        let item_begin: usize = (*parser).position;
        let item = parser_parse_pattern(parser);
        if item == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, wrapper, item) {
            if not (*parser).recovering { return PARSER_INVALID_NODE_ID; }
            let recovery = parser_synchronize_list(parser, closing, false, item_begin);
            if recovery == ParserListRecovery.Next { continue; }
            if recovery == ParserListRecovery.End { break; }
            return PARSER_INVALID_NODE_ID;
        }
        if parser_check(parser, TokenKind.Comma) {
            parser_advance(parser);
            if parser_check(parser, closing) { break; }
            continue;
        }
        if not parser_check(parser, closing) {
            parser_error_here(parser, ParserError.ExpectedToken, TokenKind.Comma);
            let recovery = parser_synchronize_list(parser, closing, false, item_begin);
            if recovery == ParserListRecovery.Escape { return PARSER_INVALID_NODE_ID; }
            if recovery == ParserListRecovery.Next { continue; }
        }
        break;
    }
    if parser_expect(parser, closing) == null { return PARSER_INVALID_NODE_ID; }
    let node = vitte_parser_get_node_mut(parser, wrapper);
    if node != null { set (*node).span = parser_span_from_range(parser, begin, (*parser).position); }
    return wrapper;
}

proc parser_parse_pattern_struct_fields(parser: *mut Parser, begin: usize) -> ASTNodeId {
    let fields = parser_add_node(
        parser,
        ASTNodeKind.Pattern,
        parser_span_from_range(parser, begin, (*parser).position)
    );
    if fields == PARSER_INVALID_NODE_ID { return fields; }
    while not parser_at_end(parser) and not parser_check(parser, TokenKind.RightBrace) {
        let field_begin: usize = (*parser).position;
        if parser_check(parser, TokenKind.DotDot) {
            parser_advance(parser);
            if parser_check(parser, TokenKind.Comma) { parser_advance(parser); continue; }
            break;
        }
        let field_name = parser_parse_identifier_node(parser);
        if field_name == PARSER_INVALID_NODE_ID { return field_name; }
        let mut field: ASTNodeId = field_name;
        if parser_check(parser, TokenKind.Colon) {
            parser_advance(parser);
            let value = parser_parse_pattern(parser);
            if value == PARSER_INVALID_NODE_ID { return value; }
            let name_node = vitte_parser_get_node(parser, field_name);
            let value_node = vitte_parser_get_node(parser, value);
            if name_node == null or value_node == null { return PARSER_INVALID_NODE_ID; }
            set field = parser_add_node(
                parser,
                ASTNodeKind.Pattern,
                parser_span_join((*name_node).span, (*value_node).span)
            );
            if field == PARSER_INVALID_NODE_ID or
               not parser_node_append_child(parser, field, field_name) or
               not parser_node_append_child(parser, field, value) {
                return PARSER_INVALID_NODE_ID;
            }
            let field_node = vitte_parser_get_node_mut(parser, field);
            if field_node != null { set (*field_node).node_flags = PARSER_AST_FLAG_PATTERN_HEAD; }
        }
        if not parser_node_append_child(parser, fields, field) { return PARSER_INVALID_NODE_ID; }
        if parser_check(parser, TokenKind.Comma) {
            parser_advance(parser);
            continue;
        }
        if not parser_check(parser, TokenKind.RightBrace) {
            parser_error_here(parser, ParserError.ExpectedToken, TokenKind.Comma);
            let recovery = parser_synchronize_list(parser, TokenKind.RightBrace, false, field_begin);
            if recovery == ParserListRecovery.Next { continue; }
            if recovery == ParserListRecovery.Escape { return PARSER_INVALID_NODE_ID; }
        }
        break;
    }
    if parser_expect(parser, TokenKind.RightBrace) == null { return PARSER_INVALID_NODE_ID; }
    let node = vitte_parser_get_node_mut(parser, fields);
    if node != null { set (*node).span = parser_span_from_range(parser, begin, (*parser).position); }
    return fields;
}

proc parser_parse_pattern_atom(parser: *mut Parser) -> ASTNodeId {
    let token = parser_current(parser);
    if token == null or parser_at_end(parser) { return PARSER_INVALID_NODE_ID; }
    let begin: usize = (*parser).position;

    if parser_check(parser, TokenKind.KwMut) or parser_check(parser, TokenKind.KwRef) {
        let modifier = parser_advance(parser);
        let inner = parser_parse_pattern_atom(parser);
        if inner == PARSER_INVALID_NODE_ID { return inner; }
        let inner_node = vitte_parser_get_node(parser, inner);
        if inner_node == null { return PARSER_INVALID_NODE_ID; }
        let wrapper = parser_add_node(
            parser,
            ASTNodeKind.Pattern,
            parser_span_join(parser_span_from_token(modifier), (*inner_node).span)
        );
        if wrapper == PARSER_INVALID_NODE_ID or not parser_node_append_child(parser, wrapper, inner) {
            return PARSER_INVALID_NODE_ID;
        }
        let wrapper_node = vitte_parser_get_node_mut(parser, wrapper);
        if wrapper_node != null {
            set (*wrapper_node).node_flags = if (*modifier).kind == TokenKind.KwMut {
                PARSER_AST_FLAG_PATTERN_MUTABLE
            } else {
                PARSER_AST_FLAG_PATTERN_REFERENCE
            };
        }
        return wrapper;
    }

    if parser_check(parser, TokenKind.LeftParen) or parser_check(parser, TokenKind.LeftBracket) {
        let opener = parser_advance(parser);
        let closing: TokenKind = if (*opener).kind == TokenKind.LeftParen {
            TokenKind.RightParen
        } else {
            TokenKind.RightBracket
        };
        return parser_parse_pattern_sequence(parser, closing, begin);
    }

    if parser_check(parser, TokenKind.KwElse) {
        parser_advance(parser);
        let wildcard = parser_add_node(
            parser,
            ASTNodeKind.Pattern,
            parser_span_from_range(parser, begin, (*parser).position)
        );
        let wildcard_node = vitte_parser_get_node_mut(parser, wildcard);
        if wildcard_node == null { return PARSER_INVALID_NODE_ID; }
        set (*wildcard_node).node_flags = PARSER_AST_FLAG_PATTERN_HEAD;
        return wildcard;
    }

    let mut literal_kind: ASTNodeKind = ASTNodeKind.Invalid;
    if parser_check(parser, TokenKind.IntegerLiteral) { set literal_kind = ASTNodeKind.IntegerLiteral; }
    else if parser_check(parser, TokenKind.FloatLiteral) { set literal_kind = ASTNodeKind.FloatLiteral; }
    else if parser_check(parser, TokenKind.StringLiteral) { set literal_kind = ASTNodeKind.StringLiteral; }
    else if parser_check(parser, TokenKind.CharacterLiteral) { set literal_kind = ASTNodeKind.CharacterLiteral; }
    else if parser_check(parser, TokenKind.KwTrue) or parser_check(parser, TokenKind.KwFalse) { set literal_kind = ASTNodeKind.BoolLiteral; }
    else if parser_check(parser, TokenKind.KwNull) { set literal_kind = ASTNodeKind.NullLiteral; }
    if literal_kind != ASTNodeKind.Invalid {
        let lower = parser_parse_value_literal(parser, literal_kind);
        if lower == PARSER_INVALID_NODE_ID { return lower; }
        if parser_check(parser, TokenKind.DotDot) or parser_check(parser, TokenKind.DotDotEqual) {
            let operator = parser_advance(parser);
            let mut upper_kind: ASTNodeKind = ASTNodeKind.Invalid;
            if parser_check(parser, TokenKind.IntegerLiteral) { set upper_kind = ASTNodeKind.IntegerLiteral; }
            else if parser_check(parser, TokenKind.FloatLiteral) { set upper_kind = ASTNodeKind.FloatLiteral; }
            else if parser_check(parser, TokenKind.CharacterLiteral) { set upper_kind = ASTNodeKind.CharacterLiteral; }
            if upper_kind == ASTNodeKind.Invalid {
                parser_error_here(parser, ParserError.ExpectedExpression, TokenKind.Invalid);
                return PARSER_INVALID_NODE_ID;
            }
            let upper = parser_parse_value_literal(parser, upper_kind);
            let range = parser_add_node(
                parser,
                ASTNodeKind.Pattern,
                parser_span_from_range(parser, begin, (*parser).position)
            );
            if range == PARSER_INVALID_NODE_ID or
               not parser_node_append_child(parser, range, lower) or
               not parser_node_append_child(parser, range, upper) {
                return PARSER_INVALID_NODE_ID;
            }
            let range_node = vitte_parser_get_node_mut(parser, range);
            if range_node != null {
                set (*range_node).operator_kind = (*operator).kind;
                set (*range_node).node_flags = PARSER_AST_FLAG_PATTERN_RANGE;
            }
            return range;
        }
        return lower;
    }

    if parser_token_is_path_segment(token) or (*token).kind == TokenKind.KwSelf {
        let head = parser_parse_path_mode(parser, false);
        if head == PARSER_INVALID_NODE_ID { return head; }
        while parser_check(parser, TokenKind.Dot) {
            parser_advance(parser);
            let segment = parser_parse_identifier_node(parser);
            if segment == PARSER_INVALID_NODE_ID or not parser_node_append_child(parser, head, segment) {
                return PARSER_INVALID_NODE_ID;
            }
            let path_node = vitte_parser_get_node_mut(parser, head);
            if path_node != null { set (*path_node).span = parser_span_from_range(parser, begin, (*parser).position); }
        }
        if parser_check(parser, TokenKind.LeftParen) {
            parser_advance(parser);
            let arguments = parser_parse_pattern_sequence(parser, TokenKind.RightParen, begin);
            if arguments == PARSER_INVALID_NODE_ID { return arguments; }
            let constructor = parser_add_node(
                parser,
                ASTNodeKind.Pattern,
                parser_span_from_range(parser, begin, (*parser).position)
            );
            if constructor == PARSER_INVALID_NODE_ID or
               not parser_node_append_child(parser, constructor, head) {
                return PARSER_INVALID_NODE_ID;
            }
            let arguments_node = vitte_parser_get_node(parser, arguments);
            if arguments_node == null { return PARSER_INVALID_NODE_ID; }
            let mut index: usize = 0;
            while index < (*arguments_node).child_count {
                if not parser_node_append_child(parser, constructor, (*arguments_node).children[index]) {
                    return PARSER_INVALID_NODE_ID;
                }
                set index += 1;
            }
            let constructor_node = vitte_parser_get_node_mut(parser, constructor);
            if constructor_node != null { set (*constructor_node).node_flags = PARSER_AST_FLAG_PATTERN_HEAD; }
            return constructor;
        }
        if parser_check(parser, TokenKind.LeftBrace) {
            parser_advance(parser);
            let fields = parser_parse_pattern_struct_fields(parser, begin);
            if fields == PARSER_INVALID_NODE_ID { return fields; }
            let structure = parser_add_node(
                parser,
                ASTNodeKind.Pattern,
                parser_span_from_range(parser, begin, (*parser).position)
            );
            if structure == PARSER_INVALID_NODE_ID or
               not parser_node_append_child(parser, structure, head) {
                return PARSER_INVALID_NODE_ID;
            }
            let fields_node = vitte_parser_get_node(parser, fields);
            if fields_node == null { return PARSER_INVALID_NODE_ID; }
            let mut index: usize = 0;
            while index < (*fields_node).child_count {
                if not parser_node_append_child(parser, structure, (*fields_node).children[index]) { return PARSER_INVALID_NODE_ID; }
                set index += 1;
            }
            let structure_node = vitte_parser_get_node_mut(parser, structure);
            if structure_node != null { set (*structure_node).node_flags = PARSER_AST_FLAG_PATTERN_HEAD | PARSER_AST_FLAG_PATTERN_STRUCT; }
            return structure;
        }
        return head;
    }

    parser_error_here(parser, ParserError.ExpectedIdentifier, TokenKind.Identifier);
    return PARSER_INVALID_NODE_ID;
}

proc parser_parse_pattern(parser: *mut Parser) -> ASTNodeId {
    let begin: usize = (*parser).position;
    let first = parser_parse_pattern_atom(parser);
    if first == PARSER_INVALID_NODE_ID { return first; }
    if not parser_check(parser, TokenKind.Pipe) { return first; }

    let alternatives = parser_add_node(
        parser,
        ASTNodeKind.Pattern,
        parser_span_from_range(parser, begin, (*parser).position)
    );
    if alternatives == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, alternatives, first) {
        return PARSER_INVALID_NODE_ID;
    }
    while parser_check(parser, TokenKind.Pipe) {
        parser_advance(parser);
        let alternative = parser_parse_pattern_atom(parser);
        if alternative == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, alternatives, alternative) {
            return PARSER_INVALID_NODE_ID;
        }
    }
    let node = vitte_parser_get_node_mut(parser, alternatives);
    if node != null {
        set (*node).node_flags = PARSER_AST_FLAG_PATTERN_OR;
        set (*node).span = parser_span_from_range(parser, begin, (*parser).position);
    }
    return alternatives;
}

proc parser_parse_match_statement(parser: *mut Parser) -> ASTNodeId {
    let start = parser_current(parser);
    if start == null or parser_expect(parser, TokenKind.KwMatch) == null {
        return PARSER_INVALID_NODE_ID;
    }
    let subject = parser_parse_expression(parser);
    if subject == PARSER_INVALID_NODE_ID { return subject; }
    let match_node = parser_add_node(
        parser,
        ASTNodeKind.MatchStmt,
        parser_span_from_range(parser, parser_token_index(parser, start), (*parser).position)
    );
    if match_node == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, match_node, subject) or
       parser_expect(parser, TokenKind.LeftBrace) == null {
        return PARSER_INVALID_NODE_ID;
    }

    while not parser_at_end(parser) and not parser_check(parser, TokenKind.RightBrace) {
        let arm_begin: usize = (*parser).position;
        let current = parser_current(parser);
        if current != null and (*current).length == 4 and (*current).lexeme == "case" {
            parser_advance(parser);
        }
        let pattern = parser_parse_pattern(parser);
        if pattern == PARSER_INVALID_NODE_ID {
            parser_synchronize(parser, ParserRecoveryMode.MatchArm, arm_begin);
            continue;
        }
        let mut guard: ASTNodeId = PARSER_INVALID_NODE_ID;
        if parser_check(parser, TokenKind.KwIf) {
            parser_advance(parser);
            set guard = parser_parse_expression(parser);
            if guard == PARSER_INVALID_NODE_ID {
                parser_synchronize(parser, ParserRecoveryMode.MatchArm, arm_begin);
                continue;
            }
        }
        if parser_expect(parser, TokenKind.FatArrow) == null {
            parser_synchronize(parser, ParserRecoveryMode.MatchArm, arm_begin);
            continue;
        }
        let mut body: ASTNodeId = PARSER_INVALID_NODE_ID;
        if parser_check(parser, TokenKind.LeftBrace) {
            set body = parser_parse_block(parser);
        } else if parser_is_statement_start((if parser_current(parser) == null { TokenKind.Invalid } else { (*parser_current(parser)).kind })) {
            set body = parser_parse_statement(parser);
        } else {
            set body = parser_parse_expression(parser);
            if body != PARSER_INVALID_NODE_ID { let _ = parser_check(parser, TokenKind.Semicolon) and parser_advance(parser) != null; }
        }
        if body == PARSER_INVALID_NODE_ID {
            if not (*parser).recovering { return body; }
            parser_synchronize(parser, ParserRecoveryMode.MatchArm, arm_begin);
            continue;
        }
        let arm = parser_add_node(
            parser,
            ASTNodeKind.MatchArm,
            parser_span_from_range(parser, arm_begin, (*parser).position)
        );
        if arm == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, arm, pattern) or
           (guard != PARSER_INVALID_NODE_ID and not parser_node_append_child(parser, arm, guard)) or
           not parser_node_append_child(parser, arm, body) or
           not parser_node_append_child(parser, match_node, arm) {
            return PARSER_INVALID_NODE_ID;
        }
        if parser_check(parser, TokenKind.Comma) {
            parser_advance(parser);
        } else if not parser_check(parser, TokenKind.RightBrace) {
            parser_error_here(parser, ParserError.ExpectedToken, TokenKind.Comma);
            parser_synchronize(parser, ParserRecoveryMode.MatchArm, arm_begin);
        }
    }

    if parser_expect(parser, TokenKind.RightBrace) == null { return PARSER_INVALID_NODE_ID; }
    let node = vitte_parser_get_node_mut(parser, match_node);
    if node != null { set (*node).span = parser_span_from_range(parser, parser_token_index(parser, start), (*parser).position); }
    return match_node;
}

proc parser_parse_statement(parser: *mut Parser) -> ASTNodeId {
    if parser_check(parser, TokenKind.KwLet) {
        return parser_parse_let_statement(parser);
    }
    if parser_check(parser, TokenKind.KwWhile) {
        return parser_parse_while_statement(parser);
    }
    if parser_check(parser, TokenKind.KwLoop) {
        return parser_parse_loop_statement(parser);
    }
    if parser_check(parser, TokenKind.KwFor) {
        return parser_parse_for_statement(parser);
    }
    if parser_check(parser, TokenKind.KwMatch) {
        return parser_parse_match_statement(parser);
    }
    if parser_check(parser, TokenKind.KwIf) or
       parser_check(parser, TokenKind.KwElif) {
        return parser_parse_if_statement(parser);
    }
    if parser_check(parser, TokenKind.KwReturn) {
        return parser_parse_return_statement(parser);
    }
    if parser_check(parser, TokenKind.KwBreak) {
        return parser_parse_jump_statement(parser, ASTNodeKind.BreakStmt);
    }
    if parser_check(parser, TokenKind.KwContinue) {
        return parser_parse_jump_statement(parser, ASTNodeKind.ContinueStmt);
    }
    if parser_check(parser, TokenKind.LeftBrace) {
        return parser_parse_block(parser);
    }
    if parser_check(parser, TokenKind.KwSet) {
        return parser_parse_set_statement(parser);
    }
    if parser_check(parser, TokenKind.KwAssert) {
        return parser_parse_assert_statement(parser);
    }
    return parser_parse_expression_statement(parser);
}

proc parser_parse_assert_statement(parser: *mut Parser) -> ASTNodeId {
    let start = parser_current(parser);
    if start == null or parser_expect(parser, TokenKind.KwAssert) == null or
       parser_expect(parser, TokenKind.LeftParen) == null {
        return PARSER_INVALID_NODE_ID;
    }
    let condition = parser_parse_expression(parser);
    if condition == PARSER_INVALID_NODE_ID or
       parser_expect(parser, TokenKind.RightParen) == null or
       parser_expect(parser, TokenKind.Semicolon) == null {
        return PARSER_INVALID_NODE_ID;
    }
    let statement = parser_add_node(parser, ASTNodeKind.AssertStmt, parser_span_from_range(
        parser,
        parser_token_index(parser, start),
        (*parser).position
    ));
    if statement == PARSER_INVALID_NODE_ID or not parser_node_append_child(parser, statement, condition) {
        return PARSER_INVALID_NODE_ID;
    }
    let statement_node = vitte_parser_get_node_mut(parser, statement);
    if statement_node != null { set (*statement_node).token_index = parser_token_index(parser, start); }
    return statement;
}

proc parser_parse_set_statement(parser: *mut Parser) -> ASTNodeId {
    let start_token = parser_current(parser);
    if start_token == null or parser_expect(parser, TokenKind.KwSet) == null {
        return PARSER_INVALID_NODE_ID;
    }

    let assignment = parser_parse_expression(parser);
    if assignment == PARSER_INVALID_NODE_ID {
        return assignment;
    }
    let assignment_node = vitte_parser_get_node(parser, assignment);
    if assignment_node == null or (*assignment_node).kind != ASTNodeKind.AssignExpr {
        parser_emit_diagnostic(
            parser,
            ParserDiagnosticKind.Error,
            ParserError.ExpectedStatement,
            parser_span_from_token(start_token),
            TokenKind.Invalid,
            TokenKind.Invalid
        );
        return PARSER_INVALID_NODE_ID;
    }

    if parser_expect(parser, TokenKind.Semicolon) == null {
        return PARSER_INVALID_NODE_ID;
    }

    let statement = parser_add_node(
        parser,
        ASTNodeKind.ExprStmt,
        parser_span_from_range(
            parser,
            parser_token_index(parser, start_token),
            (*parser).position
        )
    );
    if statement == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, statement, assignment) {
        return PARSER_INVALID_NODE_ID;
    }
    let statement_node = vitte_parser_get_node_mut(parser, statement);
    if statement_node != null {
        set (*statement_node).token_index = parser_token_index(parser, start_token);
    }
    return statement;
}

proc parser_parse_block(parser: *mut Parser) -> ASTNodeId {
    if not parser_enter_recursion(parser) {
        return PARSER_INVALID_NODE_ID;
    }
    let open_token = parser_expect(parser, TokenKind.LeftBrace);
    if open_token == null {
        parser_leave_recursion(parser);
        return PARSER_INVALID_NODE_ID;
    }
    let block = parser_add_node(parser, ASTNodeKind.Block, parser_span_from_token(open_token));
    if block == PARSER_INVALID_NODE_ID {
        parser_leave_recursion(parser);
        return block;
    }
    while not parser_at_end(parser) and not parser_check(parser, TokenKind.RightBrace) {
        let statement_start = parser_current(parser);
        let statement = parser_parse_statement(parser);
        if statement != PARSER_INVALID_NODE_ID {
            if not parser_node_append_child(parser, block, statement) {
                parser_leave_recursion(parser);
                return PARSER_INVALID_NODE_ID;
            }
        } else {
            parser_synchronize(
                parser,
                ParserRecoveryMode.Statement,
                parser_token_index(parser, statement_start)
            );
        }
        if statement_start == parser_current(parser) and
           not parser_at_end(parser) and
           not parser_check(parser, TokenKind.RightBrace) {
            parser_advance(parser);
        }
    }
    if parser_expect(parser, TokenKind.RightBrace) == null {
        parser_leave_recursion(parser);
        return PARSER_INVALID_NODE_ID;
    }
    let block_node = vitte_parser_get_node_mut(parser, block);
    if block_node != null {
        set (*block_node).span = parser_span_join(
            parser_span_from_token(open_token),
            parser_span_from_token(parser_previous(parser))
        );
    }
    parser_leave_recursion(parser);
    return block;
}

proc parser_parse_block_expression(parser: *mut Parser) -> ASTNodeId {
    if not parser_enter_recursion(parser) {
        return PARSER_INVALID_NODE_ID;
    }
    let open_token = parser_expect(parser, TokenKind.LeftBrace);
    if open_token == null {
        parser_leave_recursion(parser);
        return PARSER_INVALID_NODE_ID;
    }
    let block = parser_add_node(
        parser,
        ASTNodeKind.BlockExpr,
        parser_span_from_token(open_token)
    );
    if block == PARSER_INVALID_NODE_ID {
        parser_leave_recursion(parser);
        return block;
    }

    if parser_check(parser, TokenKind.RightBrace) {
        parser_error_here(parser, ParserError.ExpectedExpression, TokenKind.Invalid);
        parser_leave_recursion(parser);
        return PARSER_INVALID_NODE_ID;
    }
    let value = parser_parse_expression(parser);
    if value == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, block, value) or
       parser_expect(parser, TokenKind.RightBrace) == null {
        parser_leave_recursion(parser);
        return PARSER_INVALID_NODE_ID;
    }

    let block_node = vitte_parser_get_node_mut(parser, block);
    if block_node != null {
        set (*block_node).span = parser_span_join(
            parser_span_from_token(open_token),
            parser_span_from_token(parser_previous(parser))
        );
    }
    parser_leave_recursion(parser);
    return block;
}

proc parser_parse_if_expression(parser: *mut Parser) -> ASTNodeId {
    let start_token = parser_current(parser);
    if start_token == null or
       (not parser_check(parser, TokenKind.KwIf) and
        not parser_check(parser, TokenKind.KwElif)) {
        parser_error_here(parser, ParserError.ExpectedToken, TokenKind.KwIf);
        return PARSER_INVALID_NODE_ID;
    }
    parser_advance(parser);

    let condition = parser_parse_expression(parser);
    if condition == PARSER_INVALID_NODE_ID {
        return condition;
    }
    let then_branch = parser_parse_block_expression(parser);
    if then_branch == PARSER_INVALID_NODE_ID {
        return then_branch;
    }

    let mut else_branch: ASTNodeId = PARSER_INVALID_NODE_ID;
    if parser_check(parser, TokenKind.KwElif) {
        set else_branch = parser_parse_if_expression(parser);
    } else if parser_check(parser, TokenKind.KwElse) {
        parser_advance(parser);
        if parser_check(parser, TokenKind.KwIf) or
           parser_check(parser, TokenKind.KwElif) {
            set else_branch = parser_parse_if_expression(parser);
        } else {
            set else_branch = parser_parse_block_expression(parser);
        }
    } else {
        parser_error_here(parser, ParserError.ExpectedToken, TokenKind.KwElse);
        return PARSER_INVALID_NODE_ID;
    }
    if else_branch == PARSER_INVALID_NODE_ID {
        return else_branch;
    }

    let expression = parser_add_node(
        parser,
        ASTNodeKind.IfExpr,
        parser_span_from_range(
            parser,
            parser_token_index(parser, start_token),
            (*parser).position
        )
    );
    if expression == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, expression, condition) or
       not parser_node_append_child(parser, expression, then_branch) or
       not parser_node_append_child(parser, expression, else_branch) {
        return PARSER_INVALID_NODE_ID;
    }
    return expression;
}

proc parser_parse_primary_expression(parser: *mut Parser) -> ASTNodeId {
    if parser_check(parser, TokenKind.KwIf) or
       parser_check(parser, TokenKind.KwElif) {
        return parser_parse_if_expression(parser);
    }
    if parser_check(parser, TokenKind.KwPrint) {
        return parser_parse_print_primary(parser);
    }
    if parser_check(parser, TokenKind.KwSizeof) {
        return parser_parse_sizeof_expression(parser);
    }
    if parser_check(parser, TokenKind.KwAlignof) {
        return parser_parse_alignof_expression(parser);
    }
    if parser_check(parser, TokenKind.KwSelf) {
        let token = parser_advance(parser);
        let self_expression = parser_add_node(
            parser,
            ASTNodeKind.SelfExpr,
            parser_span_from_token(token)
        );
        if self_expression == PARSER_INVALID_NODE_ID {
            return self_expression;
        }
        let self_node = vitte_parser_get_node_mut(parser, self_expression);
        if self_node != null {
            set (*self_node).token_index = parser_token_index(parser, token);
        }
        return self_expression;
    }
    if parser_check(parser, TokenKind.LeftBracket) {
        return parser_parse_array_expression(parser);
    }
    if parser_check(parser, TokenKind.LeftParen) {
        return parser_parse_group_expression(parser);
    }
    if parser_check(parser, TokenKind.LeftBrace) {
        return parser_parse_block_expression(parser);
    }
    return parser_parse_value_initializer_atom(parser);
}

proc parser_recover_call_argument(parser: *mut Parser, start_position: usize) -> bool {
    return parser_synchronize_list(
        parser,
        TokenKind.RightParen,
        false,
        start_position
    ) == ParserListRecovery.Next;
}

proc parser_parse_postfix_expression(parser: *mut Parser) -> ASTNodeId {
    let mut expression = parser_parse_primary_expression(parser);
    if expression == PARSER_INVALID_NODE_ID {
        return expression;
    }

    while not parser_at_end(parser) {
        if parser_check(parser, TokenKind.Less) and
           parser_has_generic_form_suffix(parser) {
            let base_node = vitte_parser_get_node(parser, expression);
            if base_node == null {
                return PARSER_INVALID_NODE_ID;
            }
            let base_span: ParserSpan = (*base_node).span;
            let generic_type = parser_add_node(
                parser,
                ASTNodeKind.TypeExpr,
                base_span
            );
            if generic_type == PARSER_INVALID_NODE_ID or
               not parser_node_append_child(parser, generic_type, expression) or
               parser_expect(parser, TokenKind.Less) == null or
               not parser_parse_type_arguments(parser, generic_type, TokenKind.Greater) {
                return PARSER_INVALID_NODE_ID;
            }
            let generic_type_node = vitte_parser_get_node_mut(parser, generic_type);
            if generic_type_node != null {
                set (*generic_type_node).span = parser_span_join(
                    base_span,
                    parser_span_from_token(parser_previous(parser))
                );
            }
            set expression = generic_type;
            continue;
        }

        if parser_check(parser, TokenKind.LeftBrace) {
            let type_path = vitte_parser_get_node(parser, expression);
            if type_path == null or
               ((*type_path).kind != ASTNodeKind.Path and
                (*type_path).kind != ASTNodeKind.Identifier and
                (*type_path).kind != ASTNodeKind.TypeExpr) or
               (not parser_check_next(parser, TokenKind.RightBrace) and
                (not parser_token_is_identifier(parser_peek(parser, 1)) or
                 parser_peek(parser, 2) == null or
                 (*parser_peek(parser, 2)).kind != TokenKind.Colon)) {
                break;
            }

            let type_span: ParserSpan = (*type_path).span;
            parser_advance(parser);
            let form_expression = parser_add_node(parser, ASTNodeKind.FormExpr, type_span);
            if form_expression == PARSER_INVALID_NODE_ID or
               not parser_node_append_child(parser, form_expression, expression) {
                return PARSER_INVALID_NODE_ID;
            }

            while not parser_at_end(parser) and
                  not parser_check(parser, TokenKind.RightBrace) {
                let field_start = parser_current(parser);
                let field_name = parser_parse_identifier_node(parser);
                let mut field_value = PARSER_INVALID_NODE_ID;
                if field_name != PARSER_INVALID_NODE_ID and
                   parser_expect(parser, TokenKind.Colon) != null {
                    set field_value = parser_parse_expression(parser);
                }
                if field_value == PARSER_INVALID_NODE_ID {
                    if not (*parser).recovering {
                        return PARSER_INVALID_NODE_ID;
                    }
                    if parser_recover_type_argument(
                        parser,
                        TokenKind.RightBrace,
                        parser_token_index(parser, field_start)
                    ) {
                        continue;
                    }
                    if parser_check(parser, TokenKind.RightBrace) {
                        break;
                    }
                    return PARSER_INVALID_NODE_ID;
                }

                let field_name_node = vitte_parser_get_node(parser, field_name);
                if field_name_node == null {
                    return PARSER_INVALID_NODE_ID;
                }
                let field_span: ParserSpan = (*field_name_node).span;
                let field = parser_add_node(parser, ASTNodeKind.FieldInit, field_span);
                if field == PARSER_INVALID_NODE_ID or
                   not parser_node_append_child(parser, field, field_name) or
                   not parser_node_append_child(parser, field, field_value) or
                   not parser_node_append_child(parser, form_expression, field) {
                    return PARSER_INVALID_NODE_ID;
                }

                if parser_check(parser, TokenKind.RightBrace) {
                    break;
                }
                if parser_check(parser, TokenKind.Comma) {
                    parser_advance(parser);
                    continue;
                }
                parser_error_here(parser, ParserError.ExpectedToken, TokenKind.Comma);
                if parser_token_is_identifier(parser_current(parser)) and
                   parser_check_next(parser, TokenKind.Colon) {
                    set (*parser).recovering = false;
                    continue;
                }
                let recovery_start = parser_current(parser);
                if parser_recover_type_argument(
                    parser,
                    TokenKind.RightBrace,
                    parser_token_index(parser, recovery_start)
                ) {
                    continue;
                }
                if parser_check(parser, TokenKind.RightBrace) {
                    break;
                }
                return PARSER_INVALID_NODE_ID;
            }

            if parser_expect(parser, TokenKind.RightBrace) == null {
                return PARSER_INVALID_NODE_ID;
            }
            let form_expression_node = vitte_parser_get_node_mut(parser, form_expression);
            if form_expression_node != null {
                set (*form_expression_node).span = parser_span_join(
                    type_span,
                    parser_span_from_token(parser_previous(parser))
                );
            }
            set expression = form_expression;
            continue;
        }

        if parser_check(parser, TokenKind.LeftParen) {
            parser_advance(parser);
            let callee_node = vitte_parser_get_node(parser, expression);
            if callee_node == null {
                return PARSER_INVALID_NODE_ID;
            }
            let call = parser_add_node(parser, ASTNodeKind.CallExpr, (*callee_node).span);
            if call == PARSER_INVALID_NODE_ID or
               not parser_node_append_child(parser, call, expression) {
                return PARSER_INVALID_NODE_ID;
            }

            if not parser_check(parser, TokenKind.RightParen) {
                while true {
                    let argument_start = parser_current(parser);
                    let argument = parser_parse_expression(parser);
                    if argument == PARSER_INVALID_NODE_ID {
                        if not (*parser).recovering {
                            return argument;
                        }
                        if parser_recover_call_argument(
                            parser,
                            parser_token_index(parser, argument_start)
                        ) {
                            continue;
                        }
                        if parser_check(parser, TokenKind.RightParen) {
                            break;
                        }
                        return PARSER_INVALID_NODE_ID;
                    }

                    if not parser_node_append_child(parser, call, argument) {
                        return PARSER_INVALID_NODE_ID;
                    }

                    if parser_check(parser, TokenKind.Comma) {
                        parser_advance(parser);
                        if parser_check(parser, TokenKind.RightParen) {
                            break;
                        }
                        continue;
                    }
                    if parser_check(parser, TokenKind.RightParen) {
                        break;
                    }

                    parser_error_here(parser, ParserError.ExpectedToken, TokenKind.Comma);
                    let recovery_start = parser_current(parser);
                    if parser_recover_call_argument(
                        parser,
                        parser_token_index(parser, recovery_start)
                    ) {
                        continue;
                    }
                    if parser_check(parser, TokenKind.RightParen) {
                        break;
                    }
                    return PARSER_INVALID_NODE_ID;
                }
            }

            if parser_expect(parser, TokenKind.RightParen) == null {
                return PARSER_INVALID_NODE_ID;
            }
            let call_node = vitte_parser_get_node_mut(parser, call);
            if call_node != null {
                set (*call_node).span = parser_span_join(
                    (*call_node).span,
                    parser_span_from_token(parser_previous(parser))
                );
            }
            set expression = call;
            continue;
        }

        if parser_check(parser, TokenKind.LeftBracket) {
            parser_advance(parser);
            let object_node = vitte_parser_get_node(parser, expression);
            if object_node == null {
                return PARSER_INVALID_NODE_ID;
            }
            let object_span: ParserSpan = (*object_node).span;
            let index_expression = parser_parse_expression(parser);
            if index_expression == PARSER_INVALID_NODE_ID or
               parser_expect(parser, TokenKind.RightBracket) == null {
                return PARSER_INVALID_NODE_ID;
            }

            let index = parser_add_node(parser, ASTNodeKind.IndexExpr, object_span);
            if index == PARSER_INVALID_NODE_ID or
               not parser_node_append_child(parser, index, expression) or
               not parser_node_append_child(parser, index, index_expression) {
                return PARSER_INVALID_NODE_ID;
            }
            let index_node = vitte_parser_get_node_mut(parser, index);
            if index_node != null {
                set (*index_node).span = parser_span_join(
                    object_span,
                    parser_span_from_token(parser_previous(parser))
                );
            }
            set expression = index;
            continue;
        }

        if parser_check(parser, TokenKind.Dot) {
            parser_advance(parser);
            let object_node = vitte_parser_get_node(parser, expression);
            if object_node == null {
                return PARSER_INVALID_NODE_ID;
            }
            let object_span: ParserSpan = (*object_node).span;
            let member_name = parser_parse_identifier_node(parser);
            if member_name == PARSER_INVALID_NODE_ID {
                return member_name;
            }
            let name_node = vitte_parser_get_node(parser, member_name);
            if name_node == null {
                return PARSER_INVALID_NODE_ID;
            }
            let member_span: ParserSpan = parser_span_join(object_span, (*name_node).span);
            let member = parser_add_node(parser, ASTNodeKind.MemberExpr, member_span);
            if member == PARSER_INVALID_NODE_ID or
               not parser_node_append_child(parser, member, expression) or
               not parser_node_append_child(parser, member, member_name) {
                return PARSER_INVALID_NODE_ID;
            }
            set expression = member;
            continue;
        }

        if parser_check(parser, TokenKind.Question) {
            let postfix_token = parser_advance(parser);
            let expression_node = vitte_parser_get_node(parser, expression);
            if expression_node == null {
                return PARSER_INVALID_NODE_ID;
            }
            let expression_span: ParserSpan = (*expression_node).span;
            let postfix_span: ParserSpan = parser_span_join(
                expression_span,
                parser_span_from_token(postfix_token)
            );
            let postfix = parser_add_node(parser, ASTNodeKind.TryExpr, postfix_span);
            if postfix == PARSER_INVALID_NODE_ID or
               not parser_node_append_child(parser, postfix, expression) {
                return PARSER_INVALID_NODE_ID;
            }
            set expression = postfix;
            continue;
        }

        break;
    }

    return expression;
}

proc parser_parse_cast_expression(parser: *mut Parser) -> ASTNodeId {
    let mut expression = parser_parse_postfix_expression(parser);
    if expression == PARSER_INVALID_NODE_ID {
        return expression;
    }

    while parser_check(parser, TokenKind.KwAs) {
        parser_advance(parser);
        let expression_node = vitte_parser_get_node(parser, expression);
        if expression_node == null {
            return PARSER_INVALID_NODE_ID;
        }
        let expression_span: ParserSpan = (*expression_node).span;
        let target_type = parser_parse_type_expression(parser);
        if target_type == PARSER_INVALID_NODE_ID {
            return target_type;
        }
        let target_node = vitte_parser_get_node(parser, target_type);
        if target_node == null {
            return PARSER_INVALID_NODE_ID;
        }
        let cast_span: ParserSpan = parser_span_join(expression_span, (*target_node).span);
        let cast = parser_add_node(parser, ASTNodeKind.CastExpr, cast_span);
        if cast == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, cast, expression) or
           not parser_node_append_child(parser, cast, target_type) {
            return PARSER_INVALID_NODE_ID;
        }
        set expression = cast;
    }

    return expression;
}

proc parser_parse_unary_expression(parser: *mut Parser) -> ASTNodeId {
    let operator_token = parser_current(parser);
    if operator_token == null or not parser_is_unary_operator((*operator_token).kind) {
        return parser_parse_cast_expression(parser);
    }

    parser_advance(parser);
    let mutable_reference =
        ((*operator_token).kind == TokenKind.Amp or
         (*operator_token).kind == TokenKind.KwRef) and
        parser_check(parser, TokenKind.KwMut);
    if mutable_reference {
        parser_advance(parser);
    }
    let operand = parser_parse_unary_expression(parser);
    if operand == PARSER_INVALID_NODE_ID {
        return operand;
    }
    if (*operator_token).kind == TokenKind.KwAwait {
        return parser_make_unary_expression(
            parser,
            ASTNodeKind.AwaitExpr,
            (*operator_token).kind,
            operator_token,
            operand,
            mutable_reference
        );
    }
    return parser_make_unary_expression(
        parser,
        ASTNodeKind.UnaryExpr,
        (*operator_token).kind,
        operator_token,
        operand,
        mutable_reference
    );
}

proc parser_parse_binary_precedence(parser: *mut Parser, minimum_precedence: u32) -> ASTNodeId {
    let mut left = parser_parse_unary_expression(parser);
    if left == PARSER_INVALID_NODE_ID {
        return left;
    }

    while not parser_at_end(parser) {
        let operator_token = parser_current(parser);
        if operator_token == null {
            break;
        }
        let precedence = parser_binary_precedence((*operator_token).kind);
        if precedence == 0 or precedence < minimum_precedence {
            break;
        }
        parser_advance(parser);
        let mut next_precedence = precedence + 1;
        if parser_binary_right_associative((*operator_token).kind) {
            set next_precedence = precedence;
        }
        let right = parser_parse_binary_precedence(parser, next_precedence);
        if right == PARSER_INVALID_NODE_ID {
            return right;
        }

        if parser_binary_right_associative((*operator_token).kind) and precedence == 1 {
            set left = parser_make_binary_expression(
                parser,
                ASTNodeKind.AssignExpr,
                (*operator_token).kind,
                operator_token,
                left,
                right
            );
        } else {
            set left = parser_make_binary_expression(
                parser,
                ASTNodeKind.BinaryExpr,
                (*operator_token).kind,
                operator_token,
                left,
                right
            );
        }
        if left == PARSER_INVALID_NODE_ID {
            return left;
        }
    }
    return left;
}

proc parser_parse_expression(parser: *mut Parser) -> ASTNodeId {
    if not parser_enter_recursion(parser) {
        return PARSER_INVALID_NODE_ID;
    }
    let expression = parser_parse_binary_precedence(parser, 1);
    parser_leave_recursion(parser);
    return expression;
}

proc parser_parse_value_declaration(
    parser: *mut Parser,
    incoming_node_flags: u32,
    is_static: bool
) -> ASTNodeId {
    parser_advance(parser);

    let mut declaration_node_flags = incoming_node_flags;
    let mut has_mutable_static_modifier = false;
    if is_static and parser_check(parser, TokenKind.KwMut) {
        parser_advance(parser);
        set declaration_node_flags = declaration_node_flags | PARSER_AST_FLAG_MUTABLE;
        set has_mutable_static_modifier = true;
    }

    let value_name = parser_parse_identifier_node(parser);
    if value_name == PARSER_INVALID_NODE_ID {
        return value_name;
    }

    if is_static {
        if has_mutable_static_modifier {
            let declaration = parser_add_node(
                parser,
                ASTNodeKind.StaticDecl,
                parser_span_from_range(parser, (*parser).position - 3, (*parser).position)
            );
            if declaration == PARSER_INVALID_NODE_ID or
               not parser_node_append_child(parser, declaration, value_name) {
                return PARSER_INVALID_NODE_ID;
            }
            let declaration_node = vitte_parser_get_node_mut(parser, declaration);
            if declaration_node != null {
                set (*declaration_node).node_flags = declaration_node_flags;
                set (*declaration_node).token_index = (*parser).position - 3;
            }
            return parser_finish_value_declaration(parser, declaration);
        }

        let declaration = parser_add_node(
            parser,
            ASTNodeKind.StaticDecl,
            parser_span_from_range(parser, (*parser).position - 2, (*parser).position)
        );
        if declaration == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, declaration, value_name) {
            return PARSER_INVALID_NODE_ID;
        }
        let declaration_node = vitte_parser_get_node_mut(parser, declaration);
        if declaration_node != null {
            set (*declaration_node).node_flags = declaration_node_flags;
            set (*declaration_node).token_index = (*parser).position - 2;
        }
        return parser_finish_value_declaration(parser, declaration);
    } else {
        let declaration = parser_add_node(
            parser,
            ASTNodeKind.ConstDecl,
            parser_span_from_range(parser, (*parser).position - 2, (*parser).position)
        );
        if declaration == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, declaration, value_name) {
            return PARSER_INVALID_NODE_ID;
        }
        let declaration_node = vitte_parser_get_node_mut(parser, declaration);
        if declaration_node != null {
            set (*declaration_node).node_flags = declaration_node_flags;
            set (*declaration_node).token_index = (*parser).position - 2;
        }
        return parser_finish_value_declaration(parser, declaration);
    }
    return PARSER_INVALID_NODE_ID;
}

proc parser_finish_value_declaration(parser: *mut Parser, declaration: ASTNodeId) -> ASTNodeId {
    if parser_check(parser, TokenKind.Colon) {
        parser_advance(parser);
        let value_type = parser_parse_type_expression(parser);
        if value_type == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, declaration, value_type) {
            return PARSER_INVALID_NODE_ID;
        }
    }

    if parser_expect(parser, TokenKind.Equal) == null {
        return PARSER_INVALID_NODE_ID;
    }
    let initializer = parser_parse_expression(parser);
    if initializer == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, declaration, initializer) {
        return PARSER_INVALID_NODE_ID;
    }

    if parser_expect(parser, TokenKind.Semicolon) == null {
        return PARSER_INVALID_NODE_ID;
    }

    let completed_declaration = vitte_parser_get_node_mut(parser, declaration);
    if completed_declaration != null {
        set (*completed_declaration).span = parser_span_from_range(
            parser,
            (*completed_declaration).token_index,
            (*parser).position
        );
    }
    return declaration;
}

proc parser_parse_type_declaration(
    parser: *mut Parser,
    incoming_node_flags: u32,
    is_opaque: bool
) -> ASTNodeId {
    let begin: usize = (*parser).position;
    parser_advance(parser);
    if is_opaque and parser_check(parser, TokenKind.KwType) {
        parser_advance(parser);
    }

    let name = parser_parse_identifier_node(parser);
    if name == PARSER_INVALID_NODE_ID {
        return name;
    }

    let kind: ASTNodeKind = if is_opaque { ASTNodeKind.OpaqueDecl } else { ASTNodeKind.TypeDecl };
    let declaration = parser_add_node(
        parser,
        kind,
        parser_span_from_range(parser, begin, (*parser).position)
    );
    if declaration == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, declaration, name) {
        return PARSER_INVALID_NODE_ID;
    }

    let declaration_node = vitte_parser_get_node_mut(parser, declaration);
    if declaration_node == null {
        return PARSER_INVALID_NODE_ID;
    }
    set (*declaration_node).node_flags = incoming_node_flags;
    set (*declaration_node).token_index = begin;

    if not parser_parse_generic_parameters(parser, declaration) or
       not parser_parse_where_clause(parser, declaration) {
        return PARSER_INVALID_NODE_ID;
    }

    if not is_opaque and parser_check(parser, TokenKind.Colon) {
        parser_advance(parser);
        let mut bound = parser_parse_type_expression(parser);
        if bound == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, declaration, bound) {
            return PARSER_INVALID_NODE_ID;
        }
        while parser_check(parser, TokenKind.Plus) {
            parser_advance(parser);
            set bound = parser_parse_type_expression(parser);
            if bound == PARSER_INVALID_NODE_ID or
               not parser_node_append_child(parser, declaration, bound) {
                return PARSER_INVALID_NODE_ID;
            }
        }
    }

    if parser_check(parser, TokenKind.Equal) {
        parser_advance(parser);
        let target = parser_parse_type_expression(parser);
        if target == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, declaration, target) {
            return PARSER_INVALID_NODE_ID;
        }
        let completed_alias = vitte_parser_get_node_mut(parser, declaration);
        if completed_alias == null {
            return PARSER_INVALID_NODE_ID;
        }
        set (*completed_alias).node_flags =
            (*completed_alias).node_flags | PARSER_AST_FLAG_TYPE_ALIAS;
    }

    if parser_expect(parser, TokenKind.Semicolon) == null {
        return PARSER_INVALID_NODE_ID;
    }
    let completed_declaration = vitte_parser_get_node_mut(parser, declaration);
    if completed_declaration == null {
        return PARSER_INVALID_NODE_ID;
    }
    set (*completed_declaration).span = parser_span_from_range(
        parser,
        begin,
        (*parser).position
    );
    return declaration;
}

proc parser_parse_form_declaration(
    parser: *mut Parser,
    incoming_node_flags: u32
) -> ASTNodeId {
    let begin: usize = (*parser).position;
    parser_advance(parser);

    let name = parser_parse_identifier_node(parser);
    if name == PARSER_INVALID_NODE_ID {
        return name;
    }

    let declaration = parser_add_node(
        parser,
        ASTNodeKind.FormDecl,
        parser_span_from_range(parser, begin, (*parser).position)
    );
    if declaration == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, declaration, name) {
        return PARSER_INVALID_NODE_ID;
    }

    let declaration_node = vitte_parser_get_node_mut(parser, declaration);
    if declaration_node == null {
        return PARSER_INVALID_NODE_ID;
    }
    set (*declaration_node).node_flags = incoming_node_flags;
    set (*declaration_node).token_index = begin;

    if not parser_parse_generic_parameters(parser, declaration) or
       not parser_parse_where_clause(parser, declaration) {
        return PARSER_INVALID_NODE_ID;
    }
    if parser_expect(parser, TokenKind.LeftBrace) == null {
        return PARSER_INVALID_NODE_ID;
    }

    while not parser_at_end(parser) and not parser_check(parser, TokenKind.RightBrace) {
        let field_begin: usize = (*parser).position;
        let field_name = parser_parse_identifier_node(parser);
        let mut field_type = PARSER_INVALID_NODE_ID;
        if field_name != PARSER_INVALID_NODE_ID and
           parser_expect(parser, TokenKind.Colon) != null {
            set field_type = parser_parse_type_expression(parser);
        }

        if field_type == PARSER_INVALID_NODE_ID {
            if not (*parser).recovering {
                return PARSER_INVALID_NODE_ID;
            }
            let recovery = parser_synchronize_list(
                parser,
                TokenKind.RightBrace,
                true,
                field_begin
            );
            if recovery == ParserListRecovery.Next {
                continue;
            }
            if recovery == ParserListRecovery.End {
                break;
            }
            return PARSER_INVALID_NODE_ID;
        }

        let field = parser_add_node(
            parser,
            ASTNodeKind.FieldDecl,
            parser_span_from_range(parser, field_begin, (*parser).position)
        );
        if field == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, field, field_name) or
           not parser_node_append_child(parser, field, field_type) or
           not parser_node_append_child(parser, declaration, field) {
            return PARSER_INVALID_NODE_ID;
        }

        if parser_check(parser, TokenKind.RightBrace) {
            continue;
        }
        if parser_check(parser, TokenKind.Comma) or parser_check(parser, TokenKind.Semicolon) {
            parser_advance(parser);
            continue;
        }

        parser_error_here(parser, ParserError.ExpectedToken, TokenKind.Comma);
        if parser_token_is_identifier(parser_current(parser)) and
           parser_check_next(parser, TokenKind.Colon) {
            set (*parser).recovering = false;
            continue;
        }
        let recovery = parser_synchronize_list(
            parser,
            TokenKind.RightBrace,
            true,
            (*parser).position
        );
        if recovery == ParserListRecovery.Next {
            continue;
        }
        if recovery == ParserListRecovery.End {
            break;
        }
        return PARSER_INVALID_NODE_ID;
    }

    if parser_expect(parser, TokenKind.RightBrace) == null {
        return PARSER_INVALID_NODE_ID;
    }
    let completed = vitte_parser_get_node_mut(parser, declaration);
    if completed != null {
        set (*completed).span = parser_span_from_range(parser, begin, (*parser).position);
    }
    return declaration;
}

proc parser_parse_pick_declaration(
    parser: *mut Parser,
    incoming_node_flags: u32
) -> ASTNodeId {
    let begin: usize = (*parser).position;
    parser_advance(parser);

    let name = parser_parse_identifier_node(parser);
    if name == PARSER_INVALID_NODE_ID {
        return name;
    }

    let declaration = parser_add_node(
        parser,
        ASTNodeKind.PickDecl,
        parser_span_from_range(parser, begin, (*parser).position)
    );
    if declaration == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, declaration, name) {
        return PARSER_INVALID_NODE_ID;
    }

    let declaration_node = vitte_parser_get_node_mut(parser, declaration);
    if declaration_node == null {
        return PARSER_INVALID_NODE_ID;
    }
    set (*declaration_node).node_flags = incoming_node_flags;
    set (*declaration_node).token_index = begin;

    if not parser_parse_generic_parameters(parser, declaration) or
       not parser_parse_where_clause(parser, declaration) {
        return PARSER_INVALID_NODE_ID;
    }
    if parser_expect(parser, TokenKind.LeftBrace) == null {
        return PARSER_INVALID_NODE_ID;
    }

    while not parser_at_end(parser) and not parser_check(parser, TokenKind.RightBrace) {
        let variant_begin: usize = (*parser).position;
        let variant_name = parser_parse_identifier_node(parser);
        if variant_name == PARSER_INVALID_NODE_ID {
            if not (*parser).recovering {
                return PARSER_INVALID_NODE_ID;
            }
            let recovery = parser_synchronize_list(
                parser,
                TokenKind.RightBrace,
                false,
                variant_begin
            );
            if recovery == ParserListRecovery.Next {
                continue;
            }
            if recovery == ParserListRecovery.End {
                break;
            }
            return PARSER_INVALID_NODE_ID;
        }

        let variant = parser_add_node(
            parser,
            ASTNodeKind.VariantDecl,
            parser_span_from_range(parser, variant_begin, (*parser).position)
        );
        if variant == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, variant, variant_name) {
            return PARSER_INVALID_NODE_ID;
        }

        if parser_check(parser, TokenKind.LeftParen) {
            parser_advance(parser);
            while not parser_at_end(parser) and not parser_check(parser, TokenKind.RightParen) {
                let payload_begin: usize = (*parser).position;
                let payload_type = parser_parse_type_expression(parser);
                if payload_type == PARSER_INVALID_NODE_ID {
                    if not (*parser).recovering {
                        return PARSER_INVALID_NODE_ID;
                    }
                    let recovery = parser_synchronize_list(
                        parser,
                        TokenKind.RightParen,
                        false,
                        payload_begin
                    );
                    if recovery == ParserListRecovery.Next {
                        continue;
                    }
                    if recovery == ParserListRecovery.End {
                        break;
                    }
                    return PARSER_INVALID_NODE_ID;
                }
                if not parser_node_append_child(parser, variant, payload_type) {
                    return PARSER_INVALID_NODE_ID;
                }

                if parser_check(parser, TokenKind.Comma) {
                    parser_advance(parser);
                    if parser_check(parser, TokenKind.RightParen) {
                        break;
                    }
                    continue;
                }
                if parser_check(parser, TokenKind.RightParen) {
                    break;
                }

                parser_error_here(parser, ParserError.ExpectedToken, TokenKind.Comma);
                let recovery = parser_synchronize_list(
                    parser,
                    TokenKind.RightParen,
                    false,
                    (*parser).position
                );
                if recovery == ParserListRecovery.Next {
                    continue;
                }
                if recovery == ParserListRecovery.End {
                    break;
                }
                return PARSER_INVALID_NODE_ID;
            }
            if parser_expect(parser, TokenKind.RightParen) == null {
                return PARSER_INVALID_NODE_ID;
            }
        }

        let completed_variant = vitte_parser_get_node_mut(parser, variant);
        if completed_variant != null {
            set (*completed_variant).span = parser_span_from_range(
                parser,
                variant_begin,
                (*parser).position
            );
        }
        if not parser_node_append_child(parser, declaration, variant) {
            return PARSER_INVALID_NODE_ID;
        }

        if parser_check(parser, TokenKind.Comma) or parser_check(parser, TokenKind.RightBrace) {
            if parser_check(parser, TokenKind.Comma) {
                parser_advance(parser);
            }
            continue;
        }
        parser_error_here(parser, ParserError.ExpectedToken, TokenKind.Comma);
        if parser_token_is_identifier(parser_current(parser)) {
            set (*parser).recovering = false;
            continue;
        }
        let recovery = parser_synchronize_list(
            parser,
            TokenKind.RightBrace,
            false,
            variant_begin
        );
        if recovery == ParserListRecovery.Next {
            continue;
        }
        if recovery == ParserListRecovery.End {
            break;
        }
        return PARSER_INVALID_NODE_ID;
    }

    if parser_expect(parser, TokenKind.RightBrace) == null {
        return PARSER_INVALID_NODE_ID;
    }
    let completed = vitte_parser_get_node_mut(parser, declaration);
    if completed != null {
        set (*completed).span = parser_span_from_range(parser, begin, (*parser).position);
    }
    return declaration;
}

proc parser_token_is_intrinsic(token: *const ParserToken) -> bool {
    return token != null and (*token).kind == TokenKind.KwExtern and
        (*token).lexeme == "intrinsic";
}

proc parser_extern_starts_procedure(parser: *const Parser) -> bool {
    let token = parser_current(parser);
    let next = parser_peek(parser, 1);
    let next_next = parser_peek(parser, 2);
    if token == null or next == null or (*token).kind != TokenKind.KwExtern {
        return false;
    }
    if parser_token_is_intrinsic(token) {
        return parser_token_is_identifier(next);
    }
    if (*next).kind == TokenKind.KwProc {
        return true;
    }
    return (*next).kind == TokenKind.StringLiteral and
        next_next != null and (*next_next).kind == TokenKind.KwProc;
}

proc parser_parse_procedure_parameters(
    parser: *mut Parser,
    declaration: ASTNodeId
) -> bool {
    if parser_expect(parser, TokenKind.LeftParen) == null {
        return false;
    }

    while not parser_at_end(parser) and not parser_check(parser, TokenKind.RightParen) {
        let parameter_begin: usize = (*parser).position;
        let mut parameter_flags: u32 = 0;
        if parser_check(parser, TokenKind.KwMut) {
            parser_advance(parser);
            set parameter_flags = parameter_flags | PARSER_AST_FLAG_MUTABLE;
        } else if parser_check(parser, TokenKind.KwMove) {
            parser_advance(parser);
        } else {
            let modifier = parser_current(parser);
            if modifier != null and (*modifier).kind == TokenKind.KwReserved and
               ((*modifier).lexeme == "owned" or (*modifier).lexeme == "borrow") {
                parser_advance(parser);
            }
        }

        let parameter_name = parser_parse_pattern(parser);
        let mut parameter_type = PARSER_INVALID_NODE_ID;
        if parameter_name != PARSER_INVALID_NODE_ID and
           parser_expect(parser, TokenKind.Colon) != null {
            set parameter_type = parser_parse_type_expression(parser);
        }
        if parameter_type == PARSER_INVALID_NODE_ID {
            if not (*parser).recovering {
                return false;
            }
            let recovery = parser_synchronize_list(
                parser,
                TokenKind.RightParen,
                false,
                parameter_begin
            );
            if recovery == ParserListRecovery.Next {
                continue;
            }
            if recovery == ParserListRecovery.End {
                break;
            }
            return false;
        }

        let parameter = parser_add_node(
            parser,
            ASTNodeKind.Parameter,
            parser_span_from_range(parser, parameter_begin, (*parser).position)
        );
        if parameter == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, parameter, parameter_name) or
           not parser_node_append_child(parser, parameter, parameter_type) {
            return false;
        }
        let parameter_node = vitte_parser_get_node_mut(parser, parameter);
        if parameter_node == null {
            return false;
        }
        set (*parameter_node).node_flags = parameter_flags;
        set (*parameter_node).token_index = parameter_begin;
        if not parser_node_append_child(parser, declaration, parameter) {
            return false;
        }

        if parser_check(parser, TokenKind.Comma) {
            parser_advance(parser);
            if parser_check(parser, TokenKind.RightParen) {
                break;
            }
            continue;
        }
        if parser_check(parser, TokenKind.RightParen) {
            break;
        }

        parser_error_here(parser, ParserError.ExpectedToken, TokenKind.Comma);
        let recovery = parser_synchronize_list(
            parser,
            TokenKind.RightParen,
            false,
            (*parser).position
        );
        if recovery == ParserListRecovery.Next {
            continue;
        }
        if recovery == ParserListRecovery.End {
            break;
        }
        return false;
    }

    return parser_expect(parser, TokenKind.RightParen) != null;
}

proc parser_parse_proc_declaration(
    parser: *mut Parser,
    incoming_node_flags: u32,
    external: bool
) -> ASTNodeId {
    let begin: usize = (*parser).position;
    let external_token = parser_current(parser);
    let is_intrinsic = external and parser_token_is_intrinsic(external_token);

    if external {
        if parser_expect(parser, TokenKind.KwExtern) == null {
            return PARSER_INVALID_NODE_ID;
        }
        if not is_intrinsic and parser_check(parser, TokenKind.StringLiteral) {
            parser_advance(parser);
        }
    }
    if not is_intrinsic and parser_expect(parser, TokenKind.KwProc) == null {
        return PARSER_INVALID_NODE_ID;
    }

    let name = parser_parse_identifier_node(parser);
    if name == PARSER_INVALID_NODE_ID {
        return name;
    }

    let declaration_kind: ASTNodeKind = if external {
        ASTNodeKind.ExternProcDecl
    } else {
        ASTNodeKind.ProcDecl
    };
    let declaration = parser_add_node(
        parser,
        declaration_kind,
        parser_span_from_range(parser, begin, (*parser).position)
    );
    if declaration == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, declaration, name) {
        return PARSER_INVALID_NODE_ID;
    }

    let declaration_node = vitte_parser_get_node_mut(parser, declaration);
    if declaration_node == null {
        return PARSER_INVALID_NODE_ID;
    }
    set (*declaration_node).node_flags = incoming_node_flags;
    if external {
        set (*declaration_node).node_flags =
            (*declaration_node).node_flags | PARSER_AST_FLAG_EXTERN;
    }
    set (*declaration_node).token_index = begin;

    if not parser_parse_generic_parameters(parser, declaration) {
        return PARSER_INVALID_NODE_ID;
    }
    if not parser_parse_procedure_parameters(parser, declaration) {
        return PARSER_INVALID_NODE_ID;
    }

    if parser_check(parser, TokenKind.Arrow) {
        parser_advance(parser);
        let return_type = parser_parse_type_expression(parser);
        if return_type == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, declaration, return_type) {
            return PARSER_INVALID_NODE_ID;
        }
    }

    if not parser_parse_where_clause(parser, declaration) {
        return PARSER_INVALID_NODE_ID;
    }
    while parser_check(parser, TokenKind.KwRequires) or
          parser_check(parser, TokenKind.KwEnsures) {
        let contract_flag: u32 = if parser_check(parser, TokenKind.KwRequires) {
            PARSER_AST_FLAG_CONTRACT_REQUIRES
        } else {
            PARSER_AST_FLAG_CONTRACT_ENSURES
        };
        parser_advance(parser);

        let condition = parser_parse_expression(parser);
        if condition == PARSER_INVALID_NODE_ID {
            return PARSER_INVALID_NODE_ID;
        }
        let condition_node = vitte_parser_get_node_mut(parser, condition);
        if condition_node == null {
            return PARSER_INVALID_NODE_ID;
        }
        set (*condition_node).node_flags =
            (*condition_node).node_flags | contract_flag;

        if not parser_node_append_child(parser, declaration, condition) or
           parser_expect(parser, TokenKind.Semicolon) == null {
            return PARSER_INVALID_NODE_ID;
        }
    }

    if external {
        if parser_expect(parser, TokenKind.Semicolon) == null {
            return PARSER_INVALID_NODE_ID;
        }
    } else if parser_check(parser, TokenKind.Semicolon) {
        parser_advance(parser);
    } else {
        let body = parser_parse_block(parser);
        if body == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, declaration, body) {
            return PARSER_INVALID_NODE_ID;
        }
    }

    let completed = vitte_parser_get_node_mut(parser, declaration);
    if completed != null {
        set (*completed).span = parser_span_from_range(parser, begin, (*parser).position);
    }
    return declaration;
}

proc parser_parse_declaration_members(
    parser: *mut Parser,
    declaration: ASTNodeId
) -> bool {
    while not parser_at_end(parser) and not parser_check(parser, TokenKind.RightBrace) {
        let before: usize = (*parser).position;
        let member = parser_parse_declaration(parser);
        if member != PARSER_INVALID_NODE_ID {
            if not parser_node_append_child(parser, declaration, member) {
                return false;
            }
        } else {
            parser_synchronize(parser, ParserRecoveryMode.Declaration, before);
        }

        if (*parser).position == before and not parser_at_end(parser) and
           not parser_check(parser, TokenKind.RightBrace) {
            parser_advance(parser);
        }
    }
    return parser_expect(parser, TokenKind.RightBrace) != null;
}

proc parser_parse_trait_declaration_inner(
    parser: *mut Parser,
    incoming_node_flags: u32
) -> ASTNodeId {
    let begin: usize = (*parser).position;
    parser_advance(parser);

    let name = parser_parse_identifier_node(parser);
    if name == PARSER_INVALID_NODE_ID {
        return name;
    }

    let declaration = parser_add_node(
        parser,
        ASTNodeKind.TraitDecl,
        parser_span_from_range(parser, begin, (*parser).position)
    );
    if declaration == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, declaration, name) {
        return PARSER_INVALID_NODE_ID;
    }
    let declaration_node = vitte_parser_get_node_mut(parser, declaration);
    if declaration_node == null {
        return PARSER_INVALID_NODE_ID;
    }
    set (*declaration_node).node_flags = incoming_node_flags;
    set (*declaration_node).token_index = begin;

    if not parser_parse_generic_parameters(parser, declaration) or
       not parser_parse_where_clause(parser, declaration) {
        return PARSER_INVALID_NODE_ID;
    }
    if parser_expect(parser, TokenKind.LeftBrace) == null or
       not parser_parse_declaration_members(parser, declaration) {
        return PARSER_INVALID_NODE_ID;
    }

    let completed = vitte_parser_get_node_mut(parser, declaration);
    if completed != null {
        set (*completed).span = parser_span_from_range(parser, begin, (*parser).position);
    }
    return declaration;
}

proc parser_parse_trait_declaration(
    parser: *mut Parser,
    incoming_node_flags: u32
) -> ASTNodeId {
    if not parser_enter_recursion(parser) {
        return PARSER_INVALID_NODE_ID;
    }
    let declaration = parser_parse_trait_declaration_inner(parser, incoming_node_flags);
    parser_leave_recursion(parser);
    return declaration;
}

proc parser_parse_impl_declaration_inner(
    parser: *mut Parser,
    incoming_node_flags: u32
) -> ASTNodeId {
    let begin: usize = (*parser).position;
    parser_advance(parser);

    let declaration = parser_add_node(
        parser,
        ASTNodeKind.ImplDecl,
        parser_span_from_range(parser, begin, (*parser).position)
    );
    if declaration == PARSER_INVALID_NODE_ID {
        return declaration;
    }
    let declaration_node = vitte_parser_get_node_mut(parser, declaration);
    if declaration_node == null {
        return PARSER_INVALID_NODE_ID;
    }
    set (*declaration_node).node_flags = incoming_node_flags;
    set (*declaration_node).token_index = begin;

    if not parser_parse_generic_parameters(parser, declaration) {
        return PARSER_INVALID_NODE_ID;
    }

    let first_type = parser_parse_type_expression(parser);
    if first_type == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, declaration, first_type) {
        return PARSER_INVALID_NODE_ID;
    }

    if parser_check(parser, TokenKind.KwFor) {
        parser_advance(parser);
        let target_type = parser_parse_type_expression(parser);
        if target_type == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, declaration, target_type) {
            return PARSER_INVALID_NODE_ID;
        }
    }
    if not parser_parse_where_clause(parser, declaration) {
        return PARSER_INVALID_NODE_ID;
    }
    if parser_expect(parser, TokenKind.LeftBrace) == null or
       not parser_parse_declaration_members(parser, declaration) {
        return PARSER_INVALID_NODE_ID;
    }

    let completed = vitte_parser_get_node_mut(parser, declaration);
    if completed != null {
        set (*completed).span = parser_span_from_range(parser, begin, (*parser).position);
    }
    return declaration;
}

proc parser_parse_impl_declaration(
    parser: *mut Parser,
    incoming_node_flags: u32
) -> ASTNodeId {
    if not parser_enter_recursion(parser) {
        return PARSER_INVALID_NODE_ID;
    }
    let declaration = parser_parse_impl_declaration_inner(parser, incoming_node_flags);
    parser_leave_recursion(parser);
    return declaration;
}

proc parser_parse_macro_declaration(
    parser: *mut Parser,
    incoming_node_flags: u32
) -> ASTNodeId {
    let begin: usize = (*parser).position;
    parser_advance(parser);

    let name = parser_parse_identifier_node(parser);
    if name == PARSER_INVALID_NODE_ID {
        return name;
    }
    let declaration = parser_add_node(
        parser,
        ASTNodeKind.MacroDecl,
        parser_span_from_range(parser, begin, (*parser).position)
    );
    if declaration == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, declaration, name) {
        return PARSER_INVALID_NODE_ID;
    }
    let declaration_node = vitte_parser_get_node_mut(parser, declaration);
    if declaration_node == null {
        return PARSER_INVALID_NODE_ID;
    }
    set (*declaration_node).node_flags = incoming_node_flags;
    set (*declaration_node).token_index = begin;

    if parser_check(parser, TokenKind.LeftParen) and
       not parser_parse_procedure_parameters(parser, declaration) {
        return PARSER_INVALID_NODE_ID;
    }
    let body = parser_parse_block(parser);
    if body == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, declaration, body) {
        return PARSER_INVALID_NODE_ID;
    }

    let completed = vitte_parser_get_node_mut(parser, declaration);
    if completed != null {
        set (*completed).span = parser_span_from_range(parser, begin, (*parser).position);
    }
    return declaration;
}

proc parser_parse_test_declaration(
    parser: *mut Parser,
    incoming_node_flags: u32
) -> ASTNodeId {
    let begin: usize = (*parser).position;
    parser_advance(parser);

    let declaration = parser_add_node(
        parser,
        ASTNodeKind.TestDecl,
        parser_span_from_range(parser, begin, (*parser).position)
    );
    if declaration == PARSER_INVALID_NODE_ID {
        return declaration;
    }
    let declaration_node = vitte_parser_get_node_mut(parser, declaration);
    if declaration_node == null {
        return PARSER_INVALID_NODE_ID;
    }
    set (*declaration_node).node_flags = incoming_node_flags;
    set (*declaration_node).token_index = begin;

    if parser_check(parser, TokenKind.StringLiteral) {
        let name = parser_parse_value_literal(parser, ASTNodeKind.StringLiteral);
        if name == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, declaration, name) {
            return PARSER_INVALID_NODE_ID;
        }
    } else if parser_token_is_identifier(parser_current(parser)) {
        let name = parser_parse_identifier_node(parser);
        if name == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, declaration, name) {
            return PARSER_INVALID_NODE_ID;
        }
    }

    let body = parser_parse_block(parser);
    if body == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, declaration, body) {
        return PARSER_INVALID_NODE_ID;
    }

    let completed = vitte_parser_get_node_mut(parser, declaration);
    if completed != null {
        set (*completed).span = parser_span_from_range(parser, begin, (*parser).position);
    }
    return declaration;
}

proc parser_recovery_at_top(depth: *const ParserRecoveryDepth) -> bool {
    return depth != null and (*depth).parentheses == 0 and
        (*depth).brackets == 0 and (*depth).braces == 0 and (*depth).angles == 0;
}

proc parser_recovery_track(depth: &mut ParserRecoveryDepth, kind: TokenKind, track_angles: bool) {
    if kind == TokenKind.LeftParen {
        set depth.parentheses += 1;
    } else if kind == TokenKind.RightParen {
        if depth.parentheses != 0 { set depth.parentheses -= 1; }
    } else if kind == TokenKind.LeftBracket {
        set depth.brackets += 1;
    } else if kind == TokenKind.RightBracket {
        if depth.brackets != 0 { set depth.brackets -= 1; }
    } else if kind == TokenKind.LeftBrace {
        set depth.braces += 1;
    } else if kind == TokenKind.RightBrace {
        if depth.braces != 0 { set depth.braces -= 1; }
    } else if kind == TokenKind.Less and track_angles {
        set depth.angles += 1;
    } else if kind == TokenKind.Greater and track_angles and depth.angles != 0 {
        set depth.angles -= 1;
    }
}

proc parser_recovery_depth_since(
    parser: *const Parser,
    start_position: usize,
    track_angles: bool,
    depth: &mut ParserRecoveryDepth
) {
    set depth.parentheses = 0;
    set depth.brackets = 0;
    set depth.braces = 0;
    set depth.angles = 0;
    if parser == null {
        return;
    }

    let mut index = start_position;
    while index < (*parser).position and index < (*parser).token_count {
        let token = parser_token_at_private(parser, index);
        if token != null {
            parser_recovery_track(depth, (*token).kind, track_angles);
            if (*token).kind == TokenKind.RightBrace and depth.braces == 0 and not track_angles {
                set depth.parentheses = 0;
                set depth.brackets = 0;
            }
        }
        set index += 1;
    }
}

proc parser_is_declaration_start(kind: TokenKind) -> bool {
    return kind == TokenKind.Hash or kind == TokenKind.KwExport or
        kind == TokenKind.KwPub or kind == TokenKind.KwSpace or
        kind == TokenKind.KwUse or kind == TokenKind.KwConst or
        kind == TokenKind.KwStatic or kind == TokenKind.KwType or
        kind == TokenKind.KwOpaque or kind == TokenKind.KwForm or
        kind == TokenKind.KwPick or kind == TokenKind.KwTrait or
        kind == TokenKind.KwImpl or kind == TokenKind.KwExtern or
        kind == TokenKind.KwProc or kind == TokenKind.KwMacro or
        kind == TokenKind.KwTest or kind == TokenKind.KwAsync or
        kind == TokenKind.KwUnsafe or kind == TokenKind.KwComptime;
}

proc parser_is_statement_start(kind: TokenKind) -> bool {
    return kind == TokenKind.KwLet or kind == TokenKind.KwSet or
        kind == TokenKind.KwReturn or kind == TokenKind.KwDefer or
        kind == TokenKind.KwIf or kind == TokenKind.KwWhile or
        kind == TokenKind.KwLoop or kind == TokenKind.KwFor or
        kind == TokenKind.KwBreak or kind == TokenKind.KwContinue or
        kind == TokenKind.KwMatch or kind == TokenKind.KwUnsafe or
        kind == TokenKind.KwAsm or kind == TokenKind.KwAssert or
        kind == TokenKind.LeftBrace;
}

proc parser_synchronize(parser: *mut Parser, mode: ParserRecoveryMode, start_position: usize) {
    if parser == null {
        return;
    }

    let mut consumed: usize = 0;
    let mut depth: ParserRecoveryDepth;
    parser_recovery_depth_since(parser, start_position, false, &mut depth);
    set (*parser).stats.recoveries = parser_u64_add_sat((*parser).stats.recoveries, 1);

    while not parser_at_end(parser) and consumed < (*parser).max_recovery_tokens {
        let previous = parser_previous(parser);
        let current = parser_current(parser);
        if previous != null and (*previous).kind == TokenKind.Semicolon and parser_recovery_at_top(&depth) {
            break;
        }

        if current != null {
            if ((*current).kind == TokenKind.Semicolon and parser_recovery_at_top(&depth)) or
               (mode == ParserRecoveryMode.MatchArm and (*current).kind == TokenKind.Comma and parser_recovery_at_top(&depth)) {
                parser_advance(parser);
                set consumed += 1;
                break;
            }
            if (*current).kind == TokenKind.RightBrace and depth.braces == 0 {
                break;
            }
            if ((*current).kind == TokenKind.RightParen and depth.parentheses == 0) or
               ((*current).kind == TokenKind.RightBracket and depth.brackets == 0) {
                break;
            }
            if (*parser).position > start_position and parser_recovery_at_top(&depth) and
               (parser_is_declaration_start((*current).kind) or
                (mode == ParserRecoveryMode.Statement and parser_is_statement_start((*current).kind))) {
                break;
            }

            parser_recovery_track(&mut depth, (*current).kind, false);
            if (*current).kind == TokenKind.RightBrace and depth.braces == 0 {
                set depth.parentheses = 0;
                set depth.brackets = 0;
            }
        }

        parser_advance(parser);
        set consumed += 1;
    }

    set (*parser).recovering = false;
}

proc parser_synchronize_list(
    parser: *mut Parser,
    closing_kind: TokenKind,
    semicolon_separator: bool,
    start_position: usize
) -> ParserListRecovery {
    let track_angles = closing_kind == TokenKind.Greater;
    let mut depth: ParserRecoveryDepth;
    parser_recovery_depth_since(parser, start_position, track_angles, &mut depth);
    let mut consumed: usize = 0;
    set (*parser).stats.recoveries = parser_u64_add_sat((*parser).stats.recoveries, 1);

    while not parser_at_end(parser) and consumed < (*parser).max_recovery_tokens {
        let current = parser_current(parser);
        if current == null {
            break;
        }
        let at_top = parser_recovery_at_top(&depth);

        if at_top and (*current).kind == TokenKind.Comma {
            parser_advance(parser);
            set (*parser).recovering = false;
            return ParserListRecovery.Next;
        }
        if at_top and closing_kind != TokenKind.Invalid and (*current).kind == closing_kind {
            set (*parser).recovering = false;
            return ParserListRecovery.End;
        }
        if at_top and closing_kind == TokenKind.Invalid and
           ((*current).kind == TokenKind.LeftBrace or (*current).kind == TokenKind.Equal or (*current).kind == TokenKind.Semicolon) {
            set (*parser).recovering = false;
            return ParserListRecovery.End;
        }
        if at_top and semicolon_separator and (*current).kind == TokenKind.Semicolon {
            parser_advance(parser);
            set (*parser).recovering = false;
            return ParserListRecovery.Next;
        }
        if (at_top and (*current).kind == TokenKind.Semicolon) or
           ((*current).kind == TokenKind.RightBrace and depth.braces == 0) or
           ((*current).kind == TokenKind.RightParen and depth.parentheses == 0) or
           ((*current).kind == TokenKind.RightBracket and depth.brackets == 0) or
           (at_top and parser_is_declaration_start((*current).kind)) {
            return ParserListRecovery.Escape;
        }

        parser_recovery_track(&mut depth, (*current).kind, track_angles);
        parser_advance(parser);
        set consumed += 1;
    }
    return ParserListRecovery.Escape;
}

proc parser_export_starts_clause(parser: *const Parser) -> bool {
    let next = parser_peek(parser, 1);
    if next == null {
        return false;
    }

    return (*next).kind == TokenKind.Star or
           (*next).kind == TokenKind.LeftBrace or
           parser_token_is_path_segment(next);
}

proc parser_parse_space_body(parser: *mut Parser) -> ASTNodeId {
    let begin: usize = (*parser).position;
    if not parser_check(parser, TokenKind.LeftBrace) {
        parser_error_here(parser, ParserError.ExpectedToken, TokenKind.LeftBrace);
        return PARSER_INVALID_NODE_ID;
    }

    parser_advance(parser);
    let body = parser_add_node(
        parser,
        ASTNodeKind.Block,
        parser_span_invalid()
    );
    if body == PARSER_INVALID_NODE_ID {
        return body;
    }

    while not parser_at_end(parser) and not parser_check(parser, TokenKind.RightBrace) {
        let before: usize = (*parser).position;
        let declaration = parser_parse_declaration(parser);
        if declaration != PARSER_INVALID_NODE_ID {
            if not parser_node_append_child(parser, body, declaration) {
                return PARSER_INVALID_NODE_ID;
            }
        } else {
            parser_synchronize(parser, ParserRecoveryMode.Declaration, before);
        }

        if (*parser).position == before and not parser_at_end(parser) {
            parser_advance(parser);
        }
    }

    if parser_expect(parser, TokenKind.RightBrace) == null {
        return PARSER_INVALID_NODE_ID;
    }

    let body_node = vitte_parser_get_node_mut(parser, body);
    if body_node != null {
        set (*body_node).span = parser_span_from_range(parser, begin, (*parser).position);
    }
    return body;
}

proc parser_parse_space_declaration_inner(
    parser: *mut Parser,
    incoming_node_flags: u32
) -> ASTNodeId {
    let begin: usize = (*parser).position;
    parser_advance(parser);

    let path = parser_parse_path(parser);
    if path == PARSER_INVALID_NODE_ID {
        return path;
    }

    let declaration = parser_add_node(
        parser,
        ASTNodeKind.SpaceDecl,
        parser_span_from_range(parser, begin, (*parser).position)
    );
    if declaration == PARSER_INVALID_NODE_ID or
       not parser_node_append_child(parser, declaration, path) {
        return PARSER_INVALID_NODE_ID;
    }

    let declaration_node = vitte_parser_get_node_mut(parser, declaration);
    if declaration_node != null {
        set (*declaration_node).node_flags = incoming_node_flags;
        set (*declaration_node).token_index = begin;
    }

    if parser_check(parser, TokenKind.Semicolon) {
        parser_advance(parser);
    } else if parser_check(parser, TokenKind.LeftBrace) {
        let body = parser_parse_space_body(parser);
        if body == PARSER_INVALID_NODE_ID or
           not parser_node_append_child(parser, declaration, body) {
            return PARSER_INVALID_NODE_ID;
        }
    }

    let completed = vitte_parser_get_node_mut(parser, declaration);
    if completed != null {
        set (*completed).span = parser_span_from_range(parser, begin, (*parser).position);
    }
    return declaration;
}

proc parser_parse_space_declaration(
    parser: *mut Parser,
    incoming_node_flags: u32
) -> ASTNodeId {
    if not parser_enter_recursion(parser) {
        return PARSER_INVALID_NODE_ID;
    }
    let declaration = parser_parse_space_declaration_inner(parser, incoming_node_flags);
    parser_leave_recursion(parser);
    return declaration;
}

proc parser_token_is_attribute_name(token: *const ParserToken) -> bool {
    return parser_token_is_identifier(token) or
        (token != null and vitte_token_kind_is_keyword((*token).kind));
}

proc parser_token_is_attribute_literal(token: *const ParserToken) -> bool {
    if token == null {
        return false;
    }
    return (*token).kind == TokenKind.IntegerLiteral or
        (*token).kind == TokenKind.FloatLiteral or
        (*token).kind == TokenKind.StringLiteral or
        (*token).kind == TokenKind.CharacterLiteral or
        (*token).kind == TokenKind.KwTrue or
        (*token).kind == TokenKind.KwFalse or
        (*token).kind == TokenKind.KwNull;
}

proc parser_token_is_attribute_argument(token: *const ParserToken) -> bool {
    return parser_token_is_attribute_name(token) or
        parser_token_is_attribute_literal(token);
}

/// Parse an attribute prefix and retain its qualified name and argument token ranges.
proc parser_parse_attribute_prefix(parser: *mut Parser, node_flags: &mut u32) -> bool {
    if parser == null or not parser_check(parser, TokenKind.Hash) {
        return false;
    }

    let token_start: usize = (*parser).position;
    parser_advance(parser);
    let inner: bool = parser_check(parser, TokenKind.Bang);
    if parser_check(parser, TokenKind.Bang) {
        parser_advance(parser);
    }
    if parser_expect(parser, TokenKind.LeftBracket) == null {
        parser_synchronize(parser, ParserRecoveryMode.Declaration, token_start);
        return false;
    }

    let name_start: usize = (*parser).position;
    if not parser_token_is_attribute_name(parser_current(parser)) {
        parser_error_here(parser, ParserError.ExpectedIdentifier, TokenKind.Identifier);
        parser_synchronize_list(parser, TokenKind.RightBracket, false, token_start);
        parser_expect(parser, TokenKind.RightBracket);
        return false;
    }
    parser_advance(parser);

    while parser_check(parser, TokenKind.ColonColon) {
        parser_advance(parser);
        if not parser_token_is_attribute_name(parser_current(parser)) {
            parser_error_here(parser, ParserError.ExpectedIdentifier, TokenKind.Identifier);
            parser_synchronize_list(parser, TokenKind.RightBracket, false, token_start);
            parser_expect(parser, TokenKind.RightBracket);
            return false;
        }
        parser_advance(parser);
    }
    let name_end: usize = (*parser).position;
    let mut argument_start: usize = PARSER_SIZE_MAX;
    let mut argument_end: usize = PARSER_SIZE_MAX;

    if parser_check(parser, TokenKind.LeftParen) {
        parser_advance(parser);
        set argument_start = (*parser).position;
        if not parser_check(parser, TokenKind.RightParen) {
            while true {
                if not parser_token_is_attribute_argument(parser_current(parser)) {
                    parser_error_here(parser, ParserError.ExpectedIdentifier, TokenKind.Identifier);
                    parser_synchronize_list(parser, TokenKind.RightParen, false, token_start);
                    break;
                }
                parser_advance(parser);

                if parser_check(parser, TokenKind.Equal) {
                    parser_advance(parser);
                    if not parser_token_is_attribute_literal(parser_current(parser)) {
                        parser_error_here(parser, ParserError.ExpectedExpression, TokenKind.StringLiteral);
                        parser_synchronize_list(parser, TokenKind.RightParen, false, token_start);
                        break;
                    }
                    parser_advance(parser);
                }

                if parser_check(parser, TokenKind.Comma) {
                    parser_advance(parser);
                    if parser_check(parser, TokenKind.RightParen) {
                        break;
                    }
                    continue;
                }
                if not parser_check(parser, TokenKind.RightParen) {
                    parser_error_here(parser, ParserError.ExpectedToken, TokenKind.Comma);
                    parser_synchronize_list(parser, TokenKind.RightParen, false, token_start);
                }
                break;
            }
        }
        set argument_end = (*parser).position;
        if parser_expect(parser, TokenKind.RightParen) == null {
            return false;
        }
    }

    if parser_expect(parser, TokenKind.RightBracket) == null {
        return false;
    }

    let mut argument_count: usize = 0;
    if argument_start != PARSER_SIZE_MAX {
        set argument_count = argument_end - argument_start;
    }
    let attribute: ParserAttribute = ParserAttribute {
        token_start: token_start,
        token_count: (*parser).position - token_start,
        name_start: name_start,
        name_count: name_end - name_start,
        argument_start: argument_start,
        argument_count: argument_count,
        inner: inner
    };
    if not parser_add_attribute(parser, &attribute) {
        return false;
    }
    set *node_flags = *node_flags | PARSER_AST_FLAG_HAS_ATTRIBUTES;
    return true;
}

proc parser_finish_declaration(
    parser: *mut Parser,
    declaration: ASTNodeId,
    attribute_start: usize,
    attribute_count: usize
) -> ASTNodeId {
    if declaration == PARSER_INVALID_NODE_ID {
        return declaration;
    }
    let node = vitte_parser_get_node_mut(parser, declaration);
    if node == null {
        return PARSER_INVALID_NODE_ID;
    }
    if attribute_count == 0 {
        set (*node).attribute_start = 0;
    } else {
        set (*node).attribute_start = attribute_start;
    }
    set (*node).attribute_count = attribute_count;
    if attribute_count != 0 {
        set (*node).node_flags = (*node).node_flags | PARSER_AST_FLAG_HAS_ATTRIBUTES;
    }
    return declaration;
}

proc parser_parse_declaration(parser: *mut Parser) -> ASTNodeId {
    let mut node_flags: u32 = 0;
    let attribute_start: usize = (*parser).attribute_count;
    let mut attribute_count: usize = 0;

    while not parser_at_end(parser) {
        if parser_check(parser, TokenKind.Hash) {
            if not parser_parse_attribute_prefix(parser, &mut node_flags) {
                return PARSER_INVALID_NODE_ID;
            }
            set attribute_count += 1;
            continue;
        }
        if parser_check(parser, TokenKind.KwExport) {
            if parser_export_starts_clause(parser) {
                return parser_finish_declaration(
                    parser,
                    parser_parse_export_clause(parser),
                    attribute_start,
                    attribute_count
                );
            }
            parser_advance(parser);
            set node_flags = node_flags | PARSER_AST_FLAG_PUBLIC;
            continue;
        }
        if parser_check(parser, TokenKind.KwPub) {
            parser_advance(parser);
            set node_flags = node_flags | PARSER_AST_FLAG_PUBLIC;
            continue;
        }
        if parser_check(parser, TokenKind.KwAsync) {
            parser_advance(parser);
            set node_flags = node_flags | PARSER_AST_FLAG_ASYNC;
            continue;
        }
        if parser_check(parser, TokenKind.KwUnsafe) {
            parser_advance(parser);
            set node_flags = node_flags | PARSER_AST_FLAG_UNSAFE;
            continue;
        }
        if parser_check(parser, TokenKind.KwComptime) {
            parser_advance(parser);
            set node_flags = node_flags | PARSER_AST_FLAG_COMPTIME;
            continue;
        }
        break;
    }

    if parser_check(parser, TokenKind.KwSpace) {
        return parser_finish_declaration(parser,
            parser_parse_space_declaration(parser, node_flags), attribute_start, attribute_count);
    }
    if parser_check(parser, TokenKind.KwUse) {
        return parser_finish_declaration(parser,
            parser_parse_use_declaration(parser, node_flags), attribute_start, attribute_count);
    }
    if parser_check(parser, TokenKind.KwConst) {
        return parser_finish_declaration(parser,
            parser_parse_value_declaration(parser, node_flags, false), attribute_start, attribute_count);
    }
    if parser_check(parser, TokenKind.KwStatic) {
        return parser_finish_declaration(parser,
            parser_parse_value_declaration(parser, node_flags, true), attribute_start, attribute_count);
    }
    if parser_check(parser, TokenKind.KwType) {
        return parser_finish_declaration(parser,
            parser_parse_type_declaration(parser, node_flags, false), attribute_start, attribute_count);
    }
    if parser_check(parser, TokenKind.KwOpaque) {
        return parser_finish_declaration(parser,
            parser_parse_type_declaration(parser, node_flags, true), attribute_start, attribute_count);
    }
    if parser_check(parser, TokenKind.KwExtern) {
        if parser_extern_starts_procedure(parser) {
            return parser_finish_declaration(parser,
                parser_parse_proc_declaration(parser, node_flags, true), attribute_start, attribute_count);
        }
        parser_error_here(parser, ParserError.ExpectedDeclaration, TokenKind.KwProc);
        return parser_finish_declaration(parser, PARSER_INVALID_NODE_ID, attribute_start, attribute_count);
    }
    if parser_check(parser, TokenKind.KwProc) {
        return parser_finish_declaration(parser,
            parser_parse_proc_declaration(parser, node_flags, false), attribute_start, attribute_count);
    }
    if parser_check(parser, TokenKind.KwForm) {
        return parser_finish_declaration(parser,
            parser_parse_form_declaration(parser, node_flags), attribute_start, attribute_count);
    }
    if parser_check(parser, TokenKind.KwPick) {
        return parser_finish_declaration(parser,
            parser_parse_pick_declaration(parser, node_flags), attribute_start, attribute_count);
    }
    if parser_check(parser, TokenKind.KwTrait) {
        return parser_finish_declaration(parser,
            parser_parse_trait_declaration(parser, node_flags), attribute_start, attribute_count);
    }
    if parser_check(parser, TokenKind.KwImpl) {
        return parser_finish_declaration(parser,
            parser_parse_impl_declaration(parser, node_flags), attribute_start, attribute_count);
    }
    if parser_check(parser, TokenKind.KwMacro) {
        return parser_finish_declaration(parser,
            parser_parse_macro_declaration(parser, node_flags), attribute_start, attribute_count);
    }
    if parser_check(parser, TokenKind.KwTest) {
        return parser_finish_declaration(parser,
            parser_parse_test_declaration(parser, node_flags), attribute_start, attribute_count);
    }

    parser_error_here(parser, ParserError.Unsupported, TokenKind.Invalid);
    return parser_finish_declaration(parser, PARSER_INVALID_NODE_ID, attribute_start, attribute_count);
}

proc parser_parse_translation_unit(parser: *mut Parser) -> ASTNodeId {
    let root = parser_add_node(
        parser,
        ASTNodeKind.TranslationUnit,
        parser_span_invalid()
    );
    if root == PARSER_INVALID_NODE_ID {
        return root;
    }

    while not parser_at_end(parser) {
        let before: usize = (*parser).position;
        let declaration = parser_parse_declaration(parser);
        if declaration != PARSER_INVALID_NODE_ID {
            if not parser_node_append_child(parser, root, declaration) {
                return PARSER_INVALID_NODE_ID;
            }
            set (*parser).stats.declarations =
                parser_u64_add_sat((*parser).stats.declarations, 1);
        } else {
            parser_synchronize(parser, ParserRecoveryMode.Declaration, before);
        }

        if (*parser).position == before and not parser_at_end(parser) {
            parser_advance(parser);
        }
    }

    let root_node = vitte_parser_get_node_mut(parser, root);
    if root_node != null and (*parser).token_count != 0 {
        set (*root_node).span = parser_span_from_range(
            parser,
            0,
            (*parser).token_count
        );
    }
    return root;
}

/// Parse the declarations currently implemented by the native parser.
///
/// This entry point is deliberately separate from the bootstrap ABI entry
/// `vitte_parser_run` until the remaining declaration productions are ported.
export proc vitte_parser_run_native(parser: *mut Parser) -> bool {
    if not parser_context_valid(parser) {
        return false;
    }
    if (*parser).state != ParserState.Ready {
        return parser_fail(parser, ParserError.InvalidState);
    }

    set (*parser).stats.runs = parser_u64_add_sat((*parser).stats.runs, 1);
    set (*parser).state = ParserState.Parsing;
    set (*parser).last_error = ParserError.None;
    set (*parser).position = 0;
    set (*parser).recursion_depth = 0;
    set (*parser).recovering = false;
    set (*parser).root = PARSER_INVALID_NODE_ID;

    let root = parser_parse_translation_unit(parser);
    if root == PARSER_INVALID_NODE_ID {
        set (*parser).state = ParserState.Failed;
        set (*parser).stats.failed_runs =
            parser_u64_add_sat((*parser).stats.failed_runs, 1);
        if (*parser).last_error == ParserError.None {
            set (*parser).last_error = ParserError.Internal;
        }
        return false;
    }

    set (*parser).root = root;
    if (*parser).stats.errors != 0 {
        set (*parser).state = ParserState.Failed;
        set (*parser).stats.failed_runs =
            parser_u64_add_sat((*parser).stats.failed_runs, 1);
        return false;
    }

    set (*parser).state = ParserState.Done;
    return true;
}

proc parser_ast_kind(kind: ASTNodeKind, operator_kind: TokenKind) -> AstKind {
    if kind == ASTNodeKind.TranslationUnit { return AstKind.Module; }
    if kind == ASTNodeKind.Identifier or kind == ASTNodeKind.Path or
       kind == ASTNodeKind.SelfExpr { return AstKind.NameExpr; }
    if kind == ASTNodeKind.SpaceDecl { return AstKind.SpaceDecl; }
    if kind == ASTNodeKind.UseDecl { return AstKind.UseDecl; }
    if kind == ASTNodeKind.ConstDecl { return AstKind.ConstDecl; }
    if kind == ASTNodeKind.StaticDecl { return AstKind.StaticDecl; }
    if kind == ASTNodeKind.TypeDecl { return AstKind.TypeDecl; }
    if kind == ASTNodeKind.OpaqueDecl { return AstKind.OpaqueDecl; }
    if kind == ASTNodeKind.FormDecl { return AstKind.FormDecl; }
    if kind == ASTNodeKind.FieldDecl { return AstKind.Field; }
    if kind == ASTNodeKind.PickDecl { return AstKind.PickDecl; }
    if kind == ASTNodeKind.VariantDecl { return AstKind.Variant; }
    if kind == ASTNodeKind.TraitDecl { return AstKind.TraitDecl; }
    if kind == ASTNodeKind.ImplDecl { return AstKind.ImplDecl; }
    if kind == ASTNodeKind.ProcDecl { return AstKind.ProcDecl; }
    if kind == ASTNodeKind.ExternProcDecl { return AstKind.ExternDecl; }
    if kind == ASTNodeKind.Parameter { return AstKind.Parameter; }
    if kind == ASTNodeKind.GenericParam { return AstKind.GenericParam; }
    if kind == ASTNodeKind.WhereClause { return AstKind.WhereClause; }
    if kind == ASTNodeKind.WherePredicate { return AstKind.WherePredicate; }
    if kind == ASTNodeKind.Pattern { return AstKind.Pattern; }
    if kind == ASTNodeKind.MacroDecl { return AstKind.MacroDecl; }
    if kind == ASTNodeKind.TestDecl { return AstKind.TestDecl; }
    if kind == ASTNodeKind.Block { return AstKind.BlockStmt; }
    if kind == ASTNodeKind.LetStmt { return AstKind.LetStmt; }
    if kind == ASTNodeKind.ReturnStmt { return AstKind.ReturnStmt; }
    if kind == ASTNodeKind.DeferStmt { return AstKind.DeferStmt; }
    if kind == ASTNodeKind.IfStmt { return AstKind.IfStmt; }
    if kind == ASTNodeKind.IfExpr { return AstKind.IfExpr; }
    if kind == ASTNodeKind.BlockExpr { return AstKind.BlockExpr; }
    if kind == ASTNodeKind.WhileStmt { return AstKind.WhileStmt; }
    if kind == ASTNodeKind.LoopStmt { return AstKind.LoopStmt; }
    if kind == ASTNodeKind.ForStmt { return AstKind.ForStmt; }
    if kind == ASTNodeKind.BreakStmt { return AstKind.BreakStmt; }
    if kind == ASTNodeKind.ContinueStmt { return AstKind.ContinueStmt; }
    if kind == ASTNodeKind.MatchStmt { return AstKind.MatchStmt; }
    if kind == ASTNodeKind.MatchArm { return AstKind.MatchArm; }
    if kind == ASTNodeKind.UnsafeBlock { return AstKind.UnsafeStmt; }
    if kind == ASTNodeKind.AsmStmt { return AstKind.AsmStmt; }
    if kind == ASTNodeKind.AssertStmt { return AstKind.AssertStmt; }
    if kind == ASTNodeKind.ExprStmt { return AstKind.ExprStmt; }
    if kind == ASTNodeKind.TypeExpr {
        if operator_kind == TokenKind.KwProc { return AstKind.FunctionType; }
        return AstKind.NamedType;
    }
    if kind == ASTNodeKind.PointerType { return AstKind.PointerType; }
    if kind == ASTNodeKind.ReferenceType { return AstKind.ReferenceType; }
    if kind == ASTNodeKind.ArrayType { return AstKind.ArrayType; }
    if kind == ASTNodeKind.OptionalType { return AstKind.OptionalType; }
    if kind == ASTNodeKind.IntegerLiteral { return AstKind.IntegerExpr; }
    if kind == ASTNodeKind.FloatLiteral { return AstKind.FloatExpr; }
    if kind == ASTNodeKind.StringLiteral { return AstKind.StringExpr; }
    if kind == ASTNodeKind.CharacterLiteral { return AstKind.CharExpr; }
    if kind == ASTNodeKind.BoolLiteral { return AstKind.BoolExpr; }
    if kind == ASTNodeKind.NullLiteral { return AstKind.NullExpr; }
    if kind == ASTNodeKind.GroupExpr { return AstKind.GroupExpr; }
    if kind == ASTNodeKind.ArrayExpr { return AstKind.ArrayExpr; }
    if kind == ASTNodeKind.FormExpr { return AstKind.FormExpr; }
    if kind == ASTNodeKind.FieldInit { return AstKind.FieldInit; }
    if kind == ASTNodeKind.UnaryExpr { return AstKind.UnaryExpr; }
    if kind == ASTNodeKind.BinaryExpr { return AstKind.BinaryExpr; }
    if kind == ASTNodeKind.CastExpr { return AstKind.CastExpr; }
    if kind == ASTNodeKind.AssignExpr { return AstKind.AssignExpr; }
    if kind == ASTNodeKind.CallExpr { return AstKind.CallExpr; }
    if kind == ASTNodeKind.IndexExpr { return AstKind.IndexExpr; }
    if kind == ASTNodeKind.MemberExpr { return AstKind.MemberExpr; }
    if kind == ASTNodeKind.AwaitExpr { return AstKind.AwaitExpr; }
    if kind == ASTNodeKind.TryExpr { return AstKind.TryExpr; }
    if kind == ASTNodeKind.SizeofExpr { return AstKind.SizeofExpr; }
    if kind == ASTNodeKind.AlignofExpr { return AstKind.AlignofExpr; }
    return AstKind.Invalid;
}

proc parser_ast_span(parser: *const Parser, source_span: ParserSpan) -> AstSpan {
    if not source_span.valid or source_span.end < source_span.begin {
        return ast_span_make(0, 0, 0);
    }

    let mut span = ast_span_make(
        source_span.file_id,
        source_span.begin,
        source_span.end
    );
    set span.start_line = source_span.line as u32;
    set span.start_column = source_span.column as u32;
    set span.end_line = span.start_line;
    set span.end_column = span.start_column;

    if parser == null or (*parser).tokens == null {
        return span;
    }

    let mut index: usize = 0;
    while index < (*parser).token_count {
        let token = vitte_parser_token_at(parser, index);
        if token != null and (*token).span.valid and
           (*token).span.begin >= source_span.begin and
           (*token).span.end <= source_span.end {
            set span.end_line = (*token).line as u32;
            let mut end_column: usize = (*token).column;
            if (*token).length <= usize.MAX - end_column {
                set end_column = end_column + (*token).length;
            }
            set span.end_column = end_column as u32;
        }
        set index = index + 1;
    }
    return span;
}

proc parser_ast_unary_operator(kind: TokenKind) -> AstUnaryOperator {
    if kind == TokenKind.Plus { return AstUnaryOperator.Plus; }
    if kind == TokenKind.Minus { return AstUnaryOperator.Minus; }
    if kind == TokenKind.KwNot {
        return AstUnaryOperator.Not;
    }
    if kind == TokenKind.Tilde { return AstUnaryOperator.BitNot; }
    if kind == TokenKind.Star { return AstUnaryOperator.Deref; }
    if kind == TokenKind.Amp or kind == TokenKind.KwRef {
        return AstUnaryOperator.Ref;
    }
    return AstUnaryOperator.Invalid;
}

proc parser_ast_binary_operator(kind: TokenKind) -> AstBinaryOperator {
    if kind == TokenKind.Plus { return AstBinaryOperator.Add; }
    if kind == TokenKind.Minus { return AstBinaryOperator.Sub; }
    if kind == TokenKind.Star { return AstBinaryOperator.Mul; }
    if kind == TokenKind.Slash { return AstBinaryOperator.Div; }
    if kind == TokenKind.Percent { return AstBinaryOperator.Mod; }
    if kind == TokenKind.Amp { return AstBinaryOperator.BitAnd; }
    if kind == TokenKind.Pipe { return AstBinaryOperator.BitOr; }
    if kind == TokenKind.Caret { return AstBinaryOperator.BitXor; }
    if kind == TokenKind.ShiftLeft { return AstBinaryOperator.Shl; }
    if kind == TokenKind.ShiftRight { return AstBinaryOperator.Shr; }
    if kind == TokenKind.EqualEqual { return AstBinaryOperator.Eq; }
    if kind == TokenKind.BangEqual { return AstBinaryOperator.Ne; }
    if kind == TokenKind.Less { return AstBinaryOperator.Lt; }
    if kind == TokenKind.LessEqual { return AstBinaryOperator.Le; }
    if kind == TokenKind.Greater { return AstBinaryOperator.Gt; }
    if kind == TokenKind.GreaterEqual { return AstBinaryOperator.Ge; }
    if kind == TokenKind.AmpAmp or kind == TokenKind.KwAnd {
        return AstBinaryOperator.And;
    }
    if kind == TokenKind.PipePipe or kind == TokenKind.KwOr or
       kind == TokenKind.QuestionQuestion {
        return AstBinaryOperator.Or;
    }
    return AstBinaryOperator.Invalid;
}

proc parser_copy_token_range(
    parser: *const Parser,
    start: usize,
    count: usize,
    output_length: *mut usize
) -> *mut u8 {
    if output_length == null { return null; }
    set *output_length = 0;
    if count == 0 { return null; }
    if parser == null or start > (*parser).token_count or count > (*parser).token_count - start {
        return null;
    }
    let mut total: usize = 0;
    let mut index: usize = 0;
    while index < count {
        let token = parser_token_at_private(parser, start + index);
        if token == null or (*token).length > usize.MAX - total { return null; }
        set total += (*token).length;
        set index += 1;
    }
    if total == 0 { return null; }
    let buffer = allocate(total);
    if buffer == null { return null; }
    let mut offset: usize = 0;
    set index = 0;
    while index < count {
        let token = parser_token_at_private(parser, start + index);
        if token == null {
            deallocate(buffer);
            return null;
        }
        if (*token).length != 0 {
            copy(pointer.add_bytes(buffer, offset), (*token).lexeme.as_ptr() as *const u8, (*token).length);
            set offset += (*token).length;
        }
        set index += 1;
    }
    set *output_length = total;
    return buffer as *mut u8;
}

proc parser_ast_copy_flags(
    target: *mut AstNode,
    source: *const ASTNode,
    token: *const ParserToken
) {
    if ((*source).node_flags & PARSER_AST_FLAG_PUBLIC) != 0 {
        ast_node_set_flag(target, AST_NODE_FLAG_PUBLIC);
    }
    if ((*source).node_flags & PARSER_AST_FLAG_MUTABLE) != 0 {
        ast_node_set_flag(target, AST_NODE_FLAG_MUTABLE);
    }
    if ((*source).node_flags & PARSER_AST_FLAG_EXTERN) != 0 {
        ast_node_set_flag(target, AST_NODE_FLAG_EXTERN);
    }
    if ((*source).node_flags & PARSER_AST_FLAG_ASYNC) != 0 {
        ast_node_set_flag(target, AST_NODE_FLAG_ASYNC);
    }
    if ((*source).node_flags & PARSER_AST_FLAG_UNSAFE) != 0 {
        ast_node_set_flag(target, AST_NODE_FLAG_UNSAFE);
    }
    if ((*source).node_flags & PARSER_AST_FLAG_COMPTIME) != 0 {
        ast_node_set_flag(target, AST_NODE_FLAG_COMPTIME);
    }
    if ((*source).node_flags & PARSER_AST_FLAG_GLOB_IMPORT) != 0 {
        ast_node_set_flag(target, AST_NODE_FLAG_GLOB_IMPORT);
    }
    if ((*source).node_flags & PARSER_AST_FLAG_TYPE_ALIAS) != 0 {
        ast_node_set_flag(target, AST_NODE_FLAG_TYPE_ALIAS);
    }
    if ((*source).node_flags & PARSER_AST_FLAG_FUNCTION_TYPE_HAS_RETURN) != 0 {
        ast_node_set_flag(target, AST_NODE_FLAG_FUNCTION_TYPE_HAS_RETURN);
    }
    if ((*source).node_flags & PARSER_AST_FLAG_TYPE_QUERY_TYPE_OPERAND) != 0 {
        ast_node_set_flag(target, AST_NODE_FLAG_TYPE_QUERY_TYPE_OPERAND);
    }
    if ((*source).node_flags & PARSER_AST_FLAG_HAS_ATTRIBUTES) != 0 {
        ast_node_set_flag(target, AST_NODE_FLAG_HAS_ATTRIBUTES);
    }
    if ((*source).node_flags & PARSER_AST_FLAG_CONTRACT_REQUIRES) != 0 {
        ast_node_set_flag(target, AST_NODE_FLAG_CONTRACT_REQUIRES);
    }
    if ((*source).node_flags & PARSER_AST_FLAG_CONTRACT_ENSURES) != 0 {
        ast_node_set_flag(target, AST_NODE_FLAG_CONTRACT_ENSURES);
    }
    if ((*source).node_flags & PARSER_AST_FLAG_PATTERN_MUTABLE) != 0 {
        ast_node_set_flag(target, AST_NODE_FLAG_PATTERN_MUTABLE);
    }
    if ((*source).node_flags & PARSER_AST_FLAG_PATTERN_REFERENCE) != 0 {
        ast_node_set_flag(target, AST_NODE_FLAG_PATTERN_REFERENCE);
    }
    if ((*source).node_flags & PARSER_AST_FLAG_PATTERN_HEAD) != 0 {
        ast_node_set_flag(target, AST_NODE_FLAG_PATTERN_HEAD);
    }
    if ((*source).node_flags & PARSER_AST_FLAG_PATTERN_OR) != 0 {
        ast_node_set_flag(target, AST_NODE_FLAG_PATTERN_OR);
    }
    if ((*source).node_flags & PARSER_AST_FLAG_PATTERN_RANGE) != 0 {
        ast_node_set_flag(target, AST_NODE_FLAG_PATTERN_RANGE);
    }
    if ((*source).node_flags & PARSER_AST_FLAG_PATTERN_STRUCT) != 0 {
        ast_node_set_flag(target, AST_NODE_FLAG_PATTERN_STRUCT);
    }
    if (*source).kind == ASTNodeKind.UseDecl and token != null and
       (*token).kind == TokenKind.KwExport {
        ast_node_set_flag(target, AST_NODE_FLAG_PUBLIC);
        ast_node_set_flag(target, AST_NODE_FLAG_EXPORT);
    }
}

proc parser_ast_lower_node(
    parser: *const Parser,
    ast: *mut Ast,
    node_id: ASTNodeId,
    converted_nodes: *mut *mut AstNode,
    depth: usize
) -> *mut AstNode {
    if depth > PARSER_AST_CONVERSION_MAX_DEPTH or
       node_id == PARSER_INVALID_NODE_ID or
       node_id > PARSER_SIZE_MAX as ASTNodeId {
        return null;
    }

    let node_index = (node_id - 1) as usize;
    if node_index >= (*parser).node_count {
        return null;
    }
    if converted_nodes[node_index] != null {
        return converted_nodes[node_index];
    }

    let source = vitte_parser_get_node(parser, node_id);
    if source == null or (*source).child_count > (*source).child_capacity or
       ((*source).child_count != 0 and (*source).children == null) {
        return null;
    }

    let target_kind = parser_ast_kind((*source).kind, (*source).operator_kind);
    if target_kind == AstKind.Invalid {
        return null;
    }

    let token = vitte_parser_node_token(parser, source);
    let span = parser_ast_span(parser, (*source).span);
    let mut target: *mut AstNode = null;
    if token != null and
       ((*source).kind == ASTNodeKind.Identifier or
        (*source).kind == ASTNodeKind.SelfExpr or
        (*source).kind == ASTNodeKind.IntegerLiteral or
        (*source).kind == ASTNodeKind.FloatLiteral or
        (*source).kind == ASTNodeKind.StringLiteral or
        (*source).kind == ASTNodeKind.CharacterLiteral or
        (*source).kind == ASTNodeKind.BoolLiteral or
        (*source).kind == ASTNodeKind.NullLiteral) {
        set target = ast_node_create_named(
            ast,
            target_kind,
            span,
            (*token).lexeme.as_ptr() as *const u8,
            (*token).length
        );
    } else {
        set target = ast_node_create(ast, target_kind, span);
    }
    if target == null {
        return null;
    }
    set converted_nodes[node_index] = target;

    parser_ast_copy_flags(target, source, token);
    if target_kind == AstKind.UnaryExpr {
        let unary_operator = parser_ast_unary_operator((*source).operator_kind);
        if unary_operator != AstUnaryOperator.Invalid {
            ast_node_set_unary_operator(target, unary_operator);
        }
    }
    if target_kind == AstKind.BinaryExpr or target_kind == AstKind.AssignExpr or
       target_kind == AstKind.WherePredicate {
        let binary_operator = parser_ast_binary_operator((*source).operator_kind);
        if binary_operator != AstBinaryOperator.Invalid {
            ast_node_set_binary_operator(target, binary_operator);
        }
    }

    let mut child_index: usize = 0;
    while child_index < (*source).child_count {
        let child_id: ASTNodeId = (*source).children[child_index];
        let child = parser_ast_lower_node(
            parser,
            ast,
            child_id,
            converted_nodes,
            depth + 1
        );
        if child == null or not ast_node_add_child(target, child) {
            return null;
        }
        set child_index = child_index + 1;
    }

    let mut attribute_index: usize = 0;
    while attribute_index < (*source).attribute_count {
        let attribute = vitte_parser_get_attribute(parser, node_id, attribute_index);
        if attribute == null { return null; }
        let mut name_length: usize = 0;
        let mut value_length: usize = 0;
        let name = parser_copy_token_range(parser, (*attribute).name_start, (*attribute).name_count, &mut name_length);
        if name == null or name_length == 0 {
            deallocate(name as *mut u8);
            return null;
        }
        let mut value: *mut u8 = null;
        if (*attribute).argument_start != PARSER_SIZE_MAX and (*attribute).argument_count != 0 {
            set value = parser_copy_token_range(parser, (*attribute).argument_start, (*attribute).argument_count, &mut value_length);
        }
        if (*attribute).argument_count != 0 and value == null {
            deallocate(name);
            return null;
        }
        let attribute_span = parser_ast_span(
            parser,
            parser_span_from_range(parser, (*attribute).token_start, (*attribute).token_start + (*attribute).token_count)
        );
        let added = ast_node_add_attribute_ex(
            target,
            name as *const u8,
            name_length,
            value as *const u8,
            value_length,
            (*attribute).inner,
            attribute_span
        );
        deallocate(name);
        deallocate(value);
        if not added { return null; }
        set attribute_index += 1;
    }
    return target;
}

/// Translate a completed native parser tree into the arena-backed AST.
/// The destination must be empty; failed conversions rewind its arena.
export proc vitte_parser_lower_to_ast(
    parser: *const Parser,
    ast: *mut Ast
) -> bool {
    if not parser_context_valid(parser) or (*parser).state != ParserState.Done or
       (*parser).root == PARSER_INVALID_NODE_ID or not ast_is_valid(ast) or
       not ast_is_empty(ast) or (*ast).root != null {
        return false;
    }

    let node_count: usize = (*parser).node_count;
    if node_count == 0 {
        return false;
    }
    let mut mapping_bytes: usize = 0;
    if not parser_size_mul(node_count, sizeof(*mut AstNode), &mut mapping_bytes) {
        return false;
    }
    let mapping_storage = allocate(mapping_bytes);
    if mapping_storage == null {
        return false;
    }
    let mapping = mapping_storage as *mut *mut AstNode;
    fill(mapping_storage, 0, mapping_bytes);

    let arena = ast_arena(ast);
    if arena == null {
        deallocate(mapping_storage);
        return false;
    }
    let checkpoint = arena_context_checkpoint(&*arena);
    if checkpoint.context == null {
        deallocate(mapping_storage);
        return false;
    }

    let root = parser_ast_lower_node(parser, ast, (*parser).root, mapping, 0);
    let mut succeeded = root != null and ast_set_root(ast, root);
    if succeeded {
        set succeeded = ast_validate(ast);
    }

    if not succeeded {
        ast_reset(ast);
        arena_context_rollback(&mut *arena, checkpoint);
    }
    deallocate(mapping_storage);
    return succeeded;
}

proc parser_advance(parser: *mut Parser) -> *const ParserToken {
    if parser == null {
        return null;
    }

    let token = parser_current(parser);
    if token != null and (*token).kind != TokenKind.Eof and
       (*parser).position < (*parser).token_count {
        set (*parser).position += 1;
    }
    if token != null {
        set (*parser).stats.tokens_consumed = parser_u64_add_sat((*parser).stats.tokens_consumed, 1);
    }
    return token;
}

proc parser_fail(parser: *mut Parser, error: ParserError) -> bool {
    if parser != null and (*parser).magic == PARSER_MAGIC {
        set (*parser).last_error = error;
    }
    return false;
}

proc parser_release_contents(parser: *mut Parser) {
    if parser == null {
        return;
    }

    if (*parser).nodes != null {
        let mut index: usize = 0;
        while index < (*parser).node_count {
            deallocate((*parser).nodes[index].children as *mut u8);
            set (*parser).nodes[index].children = null;
            set (*parser).nodes[index].child_count = 0;
            set (*parser).nodes[index].child_capacity = 0;
            set index += 1;
        }
    }

    deallocate((*parser).nodes as *mut u8);
    deallocate((*parser).attributes as *mut u8);
    deallocate((*parser).diagnostics as *mut u8);
    set (*parser).nodes = null;
    set (*parser).node_count = 0;
    set (*parser).node_capacity = 0;
    set (*parser).attributes = null;
    set (*parser).attribute_count = 0;
    set (*parser).attribute_capacity = 0;
    set (*parser).diagnostics = null;
    set (*parser).diagnostic_count = 0;
    set (*parser).diagnostic_capacity = 0;
    set (*parser).root = PARSER_INVALID_NODE_ID;
}

proc parser_next_generation(generation: u64) -> u64 {
    if generation == 18446744073709551615 {
        return generation;
    }
    return generation + 1;
}

export proc vitte_parser_error_name(error: ParserError) -> string {
    let names: [string] = [
        "none", "invalid_argument", "invalid_context", "invalid_state",
        "invalid_token", "invalid_node", "expected_token", "expected_identifier",
        "expected_expression", "expected_type", "expected_statement", "expected_declaration",
        "unexpected_token", "node_limit", "diagnostic_limit", "recursion_limit",
        "overflow", "out_of_memory", "validation", "corruption", "unsupported", "internal", "count"
    ];
    let index = error as usize;
    if index >= names.len() { return "unknown"; }
    return names[index];
}

export proc vitte_parser_state_name(state: ParserState) -> string {
    let names: [string] = ["invalid", "ready", "parsing", "done", "failed", "destroyed", "count"];
    let index = state as usize;
    if index >= names.len() { return "unknown"; }
    return names[index];
}

export proc vitte_ast_node_kind_name(kind: ASTNodeKind) -> string {
    let names: [string] = [
        "invalid", "translation_unit", "identifier", "path", "space_decl", "use_decl",
        "const_decl", "static_decl", "type_decl", "opaque_decl", "form_decl", "field_decl",
        "pick_decl", "variant_decl", "trait_decl", "impl_decl", "proc_decl", "extern_proc_decl",
        "parameter", "generic_param", "where_clause", "where_predicate", "pattern", "macro_decl",
        "test_decl", "block", "let_stmt", "return_stmt", "defer_stmt", "if_stmt", "if_expr",
        "block_expr", "while_stmt", "loop_stmt", "for_stmt", "break_stmt", "continue_stmt",
        "match_stmt", "match_arm", "unsafe_block", "asm_stmt", "assert_stmt", "expr_stmt",
        "type_expr", "pointer_type", "reference_type", "array_type", "integer_literal", "float_literal",
        "string_literal", "character_literal", "bool_literal", "null_literal", "self_expr", "group_expr",
        "array_expr", "form_expr", "field_init", "unary_expr", "binary_expr", "cast_expr", "assign_expr",
        "call_expr", "index_expr", "member_expr", "await_expr", "try_expr", "sizeof_expr", "alignof_expr",
        "optional_type", "count"
    ];
    let index = kind as usize;
    if index >= names.len() { return "unknown"; }
    return names[index];
}

export proc vitte_parser_init(parser: *mut Parser, tokens: *const ParserToken, token_count: usize) -> bool {
    if parser == null or (tokens == null and token_count != 0) {
        return false;
    }

    fill(parser as *mut u8, 0, sizeof(Parser));
    set (*parser).magic = PARSER_MAGIC;
    set (*parser).state = ParserState.Ready;
    set (*parser).last_error = ParserError.None;
    set (*parser).tokens = tokens;
    set (*parser).token_count = token_count;
    set (*parser).root = PARSER_INVALID_NODE_ID;
    set (*parser).max_nodes = PARSER_DEFAULT_MAX_NODES;
    set (*parser).max_diagnostics = PARSER_DEFAULT_MAX_DIAGNOSTICS;
    set (*parser).max_recursion_depth = PARSER_DEFAULT_MAX_RECURSION_DEPTH;
    set (*parser).max_recovery_tokens = PARSER_DEFAULT_MAX_RECOVERY_TOKENS;
    set (*parser).generation = 1;
    return true;
}

export proc vitte_parser_reset(parser: *mut Parser, tokens: *const ParserToken, token_count: usize) -> bool {
    if not parser_context_valid(parser) {
        return false;
    }
    if tokens == null and token_count != 0 {
        return parser_fail(parser, ParserError.InvalidArgument);
    }

    let generation = parser_next_generation((*parser).generation);
    parser_release_contents(parser);
    set (*parser).stats.runs = 0;
    set (*parser).stats.failed_runs = 0;
    set (*parser).stats.tokens_consumed = 0;
    set (*parser).stats.nodes_created = 0;
    set (*parser).stats.declarations = 0;
    set (*parser).stats.diagnostics = 0;
    set (*parser).stats.errors = 0;
    set (*parser).stats.recoveries = 0;
    set (*parser).stats.max_recursion_depth = 0;
    set (*parser).stats.validation_runs = 0;
    set (*parser).stats.validation_failures = 0;
    set (*parser).stats.hash_runs = 0;
    set (*parser).stats.allocations = 0;
    set (*parser).stats.reallocations = 0;
    set (*parser).stats.allocation_failures = 0;
    set (*parser).tokens = tokens;
    set (*parser).token_count = token_count;
    set (*parser).position = 0;
    set (*parser).state = ParserState.Ready;
    set (*parser).last_error = ParserError.None;
    set (*parser).recursion_depth = 0;
    set (*parser).recovering = false;
    set (*parser).generation = generation;
    return true;
}

export proc vitte_parser_destroy(parser: *mut Parser) {
    if parser == null {
        return;
    }
    if (*parser).magic == PARSER_MAGIC {
        parser_release_contents(parser);
    }
    fill(parser as *mut u8, 0, sizeof(Parser));
    set (*parser).magic = PARSER_DEAD_MAGIC;
    set (*parser).state = ParserState.Destroyed;
}

export proc vitte_parser_is_valid(parser: *const Parser) -> bool {
    return parser_context_valid(parser);
}

export proc vitte_parser_position(parser: *const Parser) -> usize {
    if parser == null or (*parser).magic != PARSER_MAGIC {
        return 0;
    }
    return (*parser).position;
}

export proc vitte_parser_token_count(parser: *const Parser) -> usize {
    if parser == null or (*parser).magic != PARSER_MAGIC {
        return 0;
    }
    return (*parser).token_count;
}

export proc vitte_parser_token_at(parser: *const Parser, index: usize) -> *const ParserToken {
    if parser == null or (*parser).magic != PARSER_MAGIC or (*parser).tokens == null {
        return null;
    }
    return parser_token_at_private(parser, index);
}

export proc vitte_parser_node_token(parser: *const Parser, node: *const ASTNode) -> *const ParserToken {
    if parser == null or node == null or (*parser).magic != PARSER_MAGIC or
       (*node).token_index == PARSER_SIZE_MAX or
       (*node).token_index >= (*parser).token_count or (*parser).tokens == null {
        return null;
    }
    return &(*parser).tokens[(*node).token_index];
}

export proc vitte_parser_node_is_async(node: *const ASTNode) -> bool {
    return node != null and
        ((*node).node_flags & PARSER_AST_FLAG_ASYNC) != 0;
}

export proc vitte_parser_get_node(parser: *const Parser, id: ASTNodeId) -> *const ASTNode {
    if not parser_context_valid(parser) or id == PARSER_INVALID_NODE_ID or
       id > PARSER_SIZE_MAX as ASTNodeId {
        return null;
    }

    let index = (id - 1) as usize;
    if index >= (*parser).node_count or (*parser).nodes[index].id != id {
        return null;
    }
    return &(*parser).nodes[index];
}

export proc vitte_parser_node_attribute_count(parser: *const Parser, node_id: ASTNodeId) -> usize {
    let node = vitte_parser_get_node(parser, node_id);
    if node == null {
        return 0;
    }
    return (*node).attribute_count;
}

export proc vitte_parser_get_attribute(
    parser: *const Parser,
    node_id: ASTNodeId,
    index: usize
) -> *const ParserAttribute {
    let node = vitte_parser_get_node(parser, node_id);
    if node == null or index >= (*node).attribute_count or
       (*parser).attributes == null or
       (*node).attribute_start > (*parser).attribute_count or
       index >= (*parser).attribute_count - (*node).attribute_start {
        return null;
    }
    return &(*parser).attributes[(*node).attribute_start + index];
}

export proc vitte_parser_get_node_mut(parser: *mut Parser, id: ASTNodeId) -> *mut ASTNode {
    if not parser_mutable(parser) or id == PARSER_INVALID_NODE_ID or
       id > PARSER_SIZE_MAX as ASTNodeId {
        return null;
    }

    let index = (id - 1) as usize;
    if index >= (*parser).node_count or (*parser).nodes[index].id != id {
        return null;
    }
    return (&((*parser).nodes[index])) as *mut ASTNode;
}

export proc vitte_parser_node_count(parser: *const Parser) -> usize {
    if parser == null or (*parser).magic != PARSER_MAGIC {
        return 0;
    }
    return (*parser).node_count;
}

export proc vitte_parser_root(parser: *const Parser) -> ASTNodeId {
    if not parser_context_valid(parser) {
        return PARSER_INVALID_NODE_ID;
    }
    return (*parser).root;
}

export proc vitte_parser_has_root(parser: *const Parser) -> bool {
    return parser != null and (*parser).magic == PARSER_MAGIC and
        (*parser).root != PARSER_INVALID_NODE_ID;
}

export proc vitte_parser_run(parser: *mut Parser) -> bool {
    return vitte_parser_run_native(parser);
}

export proc vitte_parser_diagnostic_at(parser: *const Parser, index: usize) -> *const ParserDiagnostic {
    if not parser_context_valid(parser) or index >= (*parser).diagnostic_count {
        return null;
    }
    return &(*parser).diagnostics[index];
}

export proc vitte_parser_diagnostic_count(parser: *const Parser) -> usize {
    if not parser_context_valid(parser) {
        return 0;
    }
    return (*parser).diagnostic_count;
}

export proc vitte_parser_has_diagnostics(parser: *const Parser) -> bool {
    return parser != null and (*parser).magic == PARSER_MAGIC and (*parser).diagnostic_count != 0;
}

proc parser_validate_attribute(parser: &Parser, attribute: &ParserAttribute) -> bool {
    if attribute.token_count == 0 or
       attribute.token_start > parser.token_count or
       attribute.token_count > parser.token_count - attribute.token_start or
       attribute.name_count == 0 or
       attribute.name_start < attribute.token_start or
       attribute.name_start > attribute.token_start + attribute.token_count or
       attribute.name_count > attribute.token_start + attribute.token_count - attribute.name_start {
        return false;
    }
    let end = attribute.token_start + attribute.token_count;
    if attribute.argument_start == PARSER_SIZE_MAX {
        return attribute.argument_count == 0;
    }
    return attribute.argument_start >= attribute.token_start and
        attribute.argument_start <= end and
        attribute.argument_count <= end - attribute.argument_start;
}

proc parser_validate_node(parser: &Parser, node: &ASTNode) -> bool {
    if node.kind <= ASTNodeKind.Invalid or node.kind >= ASTNodeKind.Count or
       node.id == PARSER_INVALID_NODE_ID or node.id > parser.node_count as ASTNodeId or
       node.child_count > node.child_capacity or
       (node.child_count != 0 and node.children == null) {
        return false;
    }
    if node.attribute_count == 0 {
        if node.attribute_start != 0 or (node.node_flags & PARSER_AST_FLAG_HAS_ATTRIBUTES) != 0 {
            return false;
        }
    } elif (node.node_flags & PARSER_AST_FLAG_HAS_ATTRIBUTES) == 0 or
           node.attribute_start > parser.attribute_count or
           node.attribute_count > parser.attribute_count - node.attribute_start {
        return false;
    }
    let mut child_index: usize = 0;
    while child_index < node.child_count {
        let child_id: ASTNodeId = node.children[child_index];
        if child_id == PARSER_INVALID_NODE_ID or child_id > parser.node_count as ASTNodeId {
            return false;
        }
        set child_index += 1;
    }
    if node.token_index != PARSER_SIZE_MAX and node.token_index >= parser.token_count {
        return false;
    }
    return not node.span.valid or node.span.end >= node.span.begin;
}

export proc vitte_parser_validate(parser: *mut Parser) -> bool {
    if not parser_context_valid(parser) { return false; }
    set (*parser).stats.validation_runs = parser_u64_add_sat((*parser).stats.validation_runs, 1);

    let mut valid: bool = (*parser).node_count <= (*parser).max_nodes and
        (*parser).diagnostic_count <= (*parser).max_diagnostics and
        (*parser).attribute_count <= (*parser).attribute_capacity and
        ((*parser).attribute_count == 0 or (*parser).attributes != null);
    let mut index: usize = 0;
    while valid and index < (*parser).node_count {
        valid = (*parser).nodes[index].id == (index + 1) as ASTNodeId and
            parser_validate_node(parser as &Parser, &(*parser).nodes[index]);
        set index += 1;
    }
    index = 0;
    while valid and index < (*parser).attribute_count {
        valid = parser_validate_attribute(parser as &Parser, &(*parser).attributes[index]);
        set index += 1;
    }
    if valid and (*parser).root != PARSER_INVALID_NODE_ID {
        valid = (*parser).root <= (*parser).node_count as ASTNodeId and
            (*parser).nodes[((*parser).root - 1) as usize].id == (*parser).root;
    }

    if valid and (*parser).node_count != 0 {
        if (*parser).node_count > PARSER_SIZE_MAX / sizeof(ParserValidationFrame) {
            set valid = false;
        } else {
            let color = allocate((*parser).node_count);
            let stack = allocate((*parser).node_count * sizeof(ParserValidationFrame)) as *mut ParserValidationFrame;
            if color == null or stack == null {
                deallocate(color);
                deallocate(stack as *mut u8);
                set (*parser).stats.allocation_failures = parser_u64_add_sat((*parser).stats.allocation_failures, 1);
                set (*parser).last_error = ParserError.OutOfMemory;
                return false;
            }
            fill(color, 0, (*parser).node_count);
            index = 0;
            while valid and index < (*parser).node_count {
                if color[index] == 0 {
                    let mut top: usize = 1;
                    set color[index] = 1;
                    set stack[0] = ParserValidationFrame { node_id: (*parser).nodes[index].id, next_child: 0 };
                    while valid and top != 0 {
                        let frame_index = top - 1;
                        let node_id: ASTNodeId = stack[frame_index].node_id;
                        let child_number: usize = stack[frame_index].next_child;
                        let node: &ASTNode = &(*parser).nodes[(node_id - 1) as usize];
                        if child_number >= node.child_count {
                            set color[(node_id - 1) as usize] = 2;
                            set top -= 1;
                        } else {
                            set stack[frame_index].next_child += 1;
                            let child_id: ASTNodeId = node.children[child_number];
                            let child_index: usize = (child_id - 1) as usize;
                            if color[child_index] == 1 {
                                set valid = false;
                            } elif color[child_index] == 0 {
                                set color[child_index] = 1;
                                set stack[top] = ParserValidationFrame { node_id: child_id, next_child: 0 };
                                set top += 1;
                            }
                        }
                    }
                }
                set index += 1;
            }
            deallocate(color);
            deallocate(stack as *mut u8);
            set (*parser).stats.allocations = parser_u64_add_sat((*parser).stats.allocations, 2);
        }
    }

    if not valid {
        set (*parser).stats.validation_failures = parser_u64_add_sat((*parser).stats.validation_failures, 1);
        set (*parser).last_error = ParserError.Validation;
        return false;
    }
    set (*parser).last_error = ParserError.None;
    return true;
}

proc parser_hash_u64(hash: u64, input: u64) -> u64 {
    let mut value = hash;
    let mut shift: u32 = 0;
    while shift < 64 {
        set value = (value ^ ((input >> shift) & 255)) * PARSER_FNV_PRIME;
        set shift += 8;
    }
    return value;
}

proc parser_hash_text(hash: u64, text: string) -> u64 {
    let mut value = hash;
    let mut index: usize = 0;
    while index < text.length {
        set value = (value ^ (text[index] as u8 as u64)) * PARSER_FNV_PRIME;
        set index += 1;
    }
    return value;
}

export proc vitte_parser_fingerprint(parser: *mut Parser) -> u64 {
    if not parser_context_valid(parser) { return 0; }
    set (*parser).stats.hash_runs = parser_u64_add_sat((*parser).stats.hash_runs, 1);
    let mut hash = PARSER_FNV_OFFSET;
    hash = parser_hash_u64(hash, 2);
    hash = parser_hash_u64(hash, 0);
    hash = parser_hash_u64(hash, 0);
    hash = parser_hash_u64(hash, (*parser).node_count as u64);
    hash = parser_hash_u64(hash, (*parser).root);
    let mut index: usize = 0;
    while index < (*parser).node_count {
        let node: &ASTNode = &(*parser).nodes[index];
        hash = parser_hash_u64(hash, node.id);
        hash = parser_hash_u64(hash, node.kind as u64);
        hash = parser_hash_u64(hash, node.node_flags as u64);
        hash = parser_hash_u64(hash, node.operator_kind as u64);
        hash = parser_hash_u64(hash, if node.token_index == PARSER_SIZE_MAX { PARSER_SIZE_MAX as u64 } else { node.token_index as u64 });
        hash = parser_hash_u64(hash, if node.span.valid { 1 as u64 } else { 0 as u64 });
        if node.span.valid {
            hash = parser_hash_u64(hash, node.span.file_id as u64);
            hash = parser_hash_u64(hash, node.span.begin as u64);
            hash = parser_hash_u64(hash, node.span.end as u64);
            hash = parser_hash_u64(hash, node.span.line as u64);
            hash = parser_hash_u64(hash, node.span.column as u64);
        }
        hash = parser_hash_u64(hash, node.child_count as u64);
        let mut child_index: usize = 0;
        while child_index < node.child_count {
            hash = parser_hash_u64(hash, node.children[child_index]);
            set child_index += 1;
        }
        hash = parser_hash_u64(hash, node.attribute_count as u64);
        let mut attribute_index: usize = 0;
        while attribute_index < node.attribute_count and
              node.attribute_start <= (*parser).attribute_count and
              attribute_index < (*parser).attribute_count - node.attribute_start {
            let attribute: &ParserAttribute = &(*parser).attributes[node.attribute_start + attribute_index];
            hash = parser_hash_u64(hash, attribute.token_start as u64);
            hash = parser_hash_u64(hash, attribute.token_count as u64);
            hash = parser_hash_u64(hash, attribute.name_start as u64);
            hash = parser_hash_u64(hash, attribute.name_count as u64);
            hash = parser_hash_u64(hash, if attribute.argument_start == PARSER_SIZE_MAX { PARSER_SIZE_MAX as u64 } else { attribute.argument_start as u64 });
            hash = parser_hash_u64(hash, attribute.argument_count as u64);
            hash = parser_hash_u64(hash, if attribute.inner { 1 as u64 } else { 0 as u64 });
            if attribute.token_start <= (*parser).token_count and
               attribute.token_count <= (*parser).token_count - attribute.token_start {
                let mut token_index: usize = attribute.token_start;
                while token_index < attribute.token_start + attribute.token_count {
                    let token: &ParserToken = &(*parser).tokens[token_index];
                    hash = parser_hash_u64(hash, token.kind as u64);
                    hash = parser_hash_u64(hash, token.length as u64);
                    hash = parser_hash_text(hash, token.lexeme);
                    set token_index += 1;
                }
            }
            set attribute_index += 1;
        }
        if node.token_index != PARSER_SIZE_MAX and node.token_index < (*parser).token_count {
            let token: &ParserToken = &(*parser).tokens[node.token_index];
            hash = parser_hash_u64(hash, token.kind as u64);
            hash = parser_hash_u64(hash, token.length as u64);
            hash = parser_hash_text(hash, token.lexeme);
        }
        set index += 1;
    }
    return hash;
}

export proc vitte_parser_stats(parser: *const Parser) -> ParserStats {
    if not parser_context_valid(parser) { return ParserStats {}; }
    return (*parser).stats;
}

export proc vitte_parser_set_limits(
    parser: *mut Parser,
    max_nodes: usize,
    max_diagnostics: usize,
    max_recursion_depth: usize,
    max_recovery_tokens: usize
) -> bool {
    if not parser_context_valid(parser) or (*parser).state != ParserState.Ready {
        return parser_fail(parser, ParserError.InvalidState);
    }
    if max_nodes == 0 or max_diagnostics == 0 or
       max_recursion_depth == 0 or max_recovery_tokens == 0 {
        return parser_fail(parser, ParserError.InvalidArgument);
    }
    if max_nodes < (*parser).node_count or
       max_diagnostics < (*parser).diagnostic_count {
        return parser_fail(parser, ParserError.InvalidArgument);
    }

    set (*parser).max_nodes = max_nodes;
    set (*parser).max_diagnostics = max_diagnostics;
    set (*parser).max_recursion_depth = max_recursion_depth;
    set (*parser).max_recovery_tokens = max_recovery_tokens;
    set (*parser).last_error = ParserError.None;
    return true;
}

export proc vitte_parser_translation_unit_anchor() {}
