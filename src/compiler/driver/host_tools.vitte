/// Vitte-owned orchestration for compiling generated C with host C/LLVM tools.
/// The C boundary is limited to OS temporary-path creation and process launch.
space compiler::driver::host_tools;

use vitte::core::memory::{allocate, deallocate, cstring_length};

export pick DriverHostToolStage {
    None,
    Prepare,
    CCompile,
    Link,
    Execute,
    LLVMEmit,
    Count
}

export pick DriverHostToolStatus {
    Success,
    InvalidArgument,
    IoFailure,
    ProcessFailure,
    UnsupportedHost,
    OutOfMemory,
    InvocationFailure,
    Count
}

extern proc vitte_native_host_temp_path(
    kind: u32,
    buffer: *mut u8,
    capacity: usize
) -> usize;

extern proc vitte_native_host_process_run(
    program: *const u8,
    arguments: *const *const u8,
    argument_count: usize
) -> i32;
extern proc vitte_native_environment_value_raw(name: string) -> *const u8;

proc host_tools_environment_value(name: string) -> ?str {
    let value = vitte_native_environment_value_raw(name);
    if value == null { return null; }
    return string.from_bytes(value as *mut u8, cstring_length(value));
}

extern proc vitte_native_fs_file_open(path: *const u8, mode: *const u8) -> *mut u8;
extern proc vitte_native_fs_file_write(data: *const u8, length: usize, file: *mut u8) -> usize;
extern proc vitte_native_fs_file_close(file: *mut u8) -> i32;
extern proc vitte_native_fs_remove(path: *const u8) -> i32;
extern proc vitte_native_fs_rename_replace(source: *const u8, destination: *const u8) -> i32;

const HOST_TEMP_PATH_CAPACITY: usize = 4096;

proc host_tools_cleanup(
    source_buffer: *mut u8,
    object_buffer: *mut u8,
    executable_buffer: *mut u8,
    source_created: bool,
    object_created: bool,
    executable_created: bool
) {
    if source_created { vitte_native_fs_remove(source_buffer as *const u8); }
    if object_created { vitte_native_fs_remove(object_buffer as *const u8); }
    if executable_created { vitte_native_fs_remove(executable_buffer as *const u8); }
    if source_buffer != null { deallocate(source_buffer); }
    if object_buffer != null { deallocate(object_buffer); }
    if executable_buffer != null { deallocate(executable_buffer); }
}

proc host_tools_write_source(
    path: *const u8,
    source: *const u8,
    source_length: usize
) -> bool {
    let file = vitte_native_fs_file_open(path, "wb".as_ptr() as *const u8);
    if file == null { return false; }
    let wrote_all = source_length == 0 or
        vitte_native_fs_file_write(source, source_length, file) == source_length;
    let close_status = vitte_native_fs_file_close(file);
    return wrote_all and close_status == 0;
}

proc host_tools_run_arguments(
    program: *const u8,
    arguments: *mut *mut u8,
    argument_count: usize
) -> i32 {
    return vitte_native_host_process_run(
        program,
        arguments as *const *const u8,
        argument_count
    );
}

/// Compile, link, and optionally execute one generated C17 translation unit.
/// Return values are DriverHostToolStatus; `failed_stage` identifies the
/// operation that produced the failure.
proc host_tools_run_toolchain(
    source: *const u8,
    source_length: usize,
    output_path: *const u8,
    emit_object: bool,
    emit_llvm_ir: bool,
    run_program: bool,
    debug_info: bool,
    debug_runtime: bool,
    run_argc: i32,
    run_argv: *mut *mut u8,
    failed_stage: *mut u32
) -> u32 {
    if failed_stage == null {
        return DriverHostToolStatus::InvalidArgument as u32;
    }
    set *failed_stage = DriverHostToolStage::None as u32;
    if source == null or (emit_object and run_program) or
       (emit_llvm_ir and (emit_object or run_program)) or run_argc < 0 or
       (run_argc > 0 and run_argv == null) {
        set *failed_stage = DriverHostToolStage::Prepare as u32;
        return DriverHostToolStatus::InvalidArgument as u32;
    }
    if (emit_object or emit_llvm_ir) and (output_path == null or output_path[0] == 0) {
        set *failed_stage = DriverHostToolStage::Prepare as u32;
        return DriverHostToolStatus::InvalidArgument as u32;
    }

    let source_buffer = allocate(HOST_TEMP_PATH_CAPACITY);
    let mut object_buffer: *mut u8 = null;
    let mut executable_buffer: *mut u8 = null;
    if not emit_object and not emit_llvm_ir {
        set object_buffer = allocate(HOST_TEMP_PATH_CAPACITY);
    }
    if run_program or emit_llvm_ir {
        set executable_buffer = allocate(HOST_TEMP_PATH_CAPACITY);
    }
    if source_buffer == null or
       (not emit_object and not emit_llvm_ir and object_buffer == null) or
       ((run_program or emit_llvm_ir) and executable_buffer == null) {
        if source_buffer != null { deallocate(source_buffer); }
        if object_buffer != null { deallocate(object_buffer); }
        if executable_buffer != null { deallocate(executable_buffer); }
        set *failed_stage = DriverHostToolStage::Prepare as u32;
        return DriverHostToolStatus::OutOfMemory as u32;
    }

    let mut source_created = false;
    let mut object_created = false;
    let mut executable_created = false;
    let mut compiler_program: string = if emit_llvm_ir { "clang" } else { "cc" };
    let mut configured_compiler: ?string = host_tools_environment_value("CC");
    if emit_llvm_ir {
        set configured_compiler = host_tools_environment_value("VITTE_LLVM_CC");
        if configured_compiler == null or configured_compiler? == "" {
            set configured_compiler = host_tools_environment_value("CLANG");
        }
    }
    if configured_compiler != null {
        let selected_compiler = configured_compiler?;
        if selected_compiler != "" {
            set compiler_program = selected_compiler;
        }
    }
    let llvm_target: ?string = if emit_llvm_ir { host_tools_environment_value("VITTE_LLVM_TARGET") } else { null };
    let mut llvm_target_argument: ?string = null;
    if llvm_target != null and llvm_target? != "" {
        set llvm_target_argument = "--target=" + llvm_target?;
    }

    if vitte_native_host_temp_path(0, source_buffer, HOST_TEMP_PATH_CAPACITY) == 0 {
        host_tools_cleanup(
            source_buffer, object_buffer, executable_buffer,
            source_created, object_created, executable_created
        );
        set *failed_stage = DriverHostToolStage::Prepare as u32;
        return DriverHostToolStatus::IoFailure as u32;
    }
    set source_created = true;

    if run_program or emit_llvm_ir {
        let temporary_kind: u32 = if emit_llvm_ir { 1 as u32 } else { 2 as u32 };
        if vitte_native_host_temp_path(temporary_kind, executable_buffer, HOST_TEMP_PATH_CAPACITY) == 0 {
            host_tools_cleanup(
                source_buffer, object_buffer, executable_buffer,
                source_created, object_created, executable_created
            );
            set *failed_stage = DriverHostToolStage::Prepare as u32;
            return DriverHostToolStatus::IoFailure as u32;
        }
        set executable_created = true;
        if run_program {
            // The OS primitive reserves a unique name. Remove its placeholder
            // so linkers that require a new output file can use the path.
            if vitte_native_fs_remove(executable_buffer as *const u8) != 0 {
                host_tools_cleanup(
                    source_buffer, object_buffer, executable_buffer,
                    source_created, object_created, executable_created
                );
                set *failed_stage = DriverHostToolStage::Prepare as u32;
                return DriverHostToolStatus::IoFailure as u32;
            }
        }
    }

    if object_buffer != null {
        if vitte_native_host_temp_path(1, object_buffer, HOST_TEMP_PATH_CAPACITY) == 0 {
            host_tools_cleanup(
                source_buffer, object_buffer, executable_buffer,
                source_created, object_created, executable_created
            );
            set *failed_stage = DriverHostToolStage::Prepare as u32;
            return DriverHostToolStatus::IoFailure as u32;
        }
        set object_created = true;
    }

    if not host_tools_write_source(source_buffer as *const u8, source, source_length) {
        host_tools_cleanup(
            source_buffer, object_buffer, executable_buffer,
            source_created, object_created, executable_created
        );
        set *failed_stage = DriverHostToolStage::Prepare as u32;
        return DriverHostToolStatus::IoFailure as u32;
    }

    let compile_output = if emit_llvm_ir {
        executable_buffer as *const u8
    } else if object_buffer != null {
        object_buffer as *const u8
    } else if output_path == null or output_path[0] == 0 {
        "a.out".as_ptr() as *const u8
    } else {
        output_path
    };
    let compile_arguments = allocate(16 * sizeof(*mut u8)) as *mut *mut u8;
    if compile_arguments == null {
        host_tools_cleanup(
            source_buffer, object_buffer, executable_buffer,
            source_created, object_created, executable_created
        );
        set *failed_stage = DriverHostToolStage::Prepare as u32;
        return DriverHostToolStatus::OutOfMemory as u32;
    }
    let mut compile_argument_count: usize = 0;
    if debug_info {
        set compile_arguments[compile_argument_count] = "-g".as_ptr() as *mut u8;
        set compile_argument_count += 1;
        set compile_arguments[compile_argument_count] = "-O0".as_ptr() as *mut u8;
        set compile_argument_count += 1;
        set compile_arguments[compile_argument_count] = "-fno-omit-frame-pointer".as_ptr() as *mut u8;
        set compile_argument_count += 1;
        set compile_arguments[compile_argument_count] = "-fno-inline".as_ptr() as *mut u8;
        set compile_argument_count += 1;
        if debug_runtime {
            set compile_arguments[compile_argument_count] = "-DVITTE_DEBUG_RUNTIME".as_ptr() as *mut u8;
            set compile_argument_count += 1;
        }
    }
    set compile_arguments[compile_argument_count] = "-std=c17".as_ptr() as *mut u8;
    set compile_argument_count += 1;
    set compile_arguments[compile_argument_count] = "-x".as_ptr() as *mut u8;
    set compile_argument_count += 1;
    set compile_arguments[compile_argument_count] = "c".as_ptr() as *mut u8;
    set compile_argument_count += 1;
    if emit_object or not emit_llvm_ir {
        set compile_arguments[compile_argument_count] = "-c".as_ptr() as *mut u8;
        set compile_argument_count += 1;
    }
    if emit_llvm_ir {
        set compile_arguments[compile_argument_count] = "-S".as_ptr() as *mut u8;
        set compile_argument_count += 1;
        set compile_arguments[compile_argument_count] = "-emit-llvm".as_ptr() as *mut u8;
        set compile_argument_count += 1;
        if llvm_target_argument != null {
            set compile_arguments[compile_argument_count] = llvm_target_argument?.as_ptr() as *mut u8;
            set compile_argument_count += 1;
        }
    }
    set compile_arguments[compile_argument_count] = source_buffer;
    set compile_argument_count += 1;
    set compile_arguments[compile_argument_count] = "-o".as_ptr() as *mut u8;
    set compile_argument_count += 1;
    set compile_arguments[compile_argument_count] = compile_output as *mut u8;
    set compile_argument_count += 1;

    let compile_status = host_tools_run_arguments(
        compiler_program.as_ptr() as *const u8,
        compile_arguments,
        compile_argument_count
    );
    deallocate(compile_arguments as *mut u8);
    if compile_status != 1 {
        if emit_object { vitte_native_fs_remove(output_path); }
        host_tools_cleanup(
            source_buffer, object_buffer, executable_buffer,
            source_created, object_created, executable_created
        );
        set *failed_stage = if emit_llvm_ir {
            DriverHostToolStage::LLVMEmit as u32
        } else {
            DriverHostToolStage::CCompile as u32
        };
        return if compile_status == -2 {
            DriverHostToolStatus::OutOfMemory as u32
        } else if compile_status < 0 {
            DriverHostToolStatus::InvocationFailure as u32
        } else {
            DriverHostToolStatus::ProcessFailure as u32
        };
    }

    if emit_llvm_ir {
        if vitte_native_fs_rename_replace(
            executable_buffer as *const u8,
            output_path
        ) != 0 {
            host_tools_cleanup(
                source_buffer, object_buffer, executable_buffer,
                source_created, object_created, executable_created
            );
            set *failed_stage = DriverHostToolStage::LLVMEmit as u32;
            return DriverHostToolStatus::IoFailure as u32;
        }
        set executable_created = false;
    }

    if not emit_object and not emit_llvm_ir {
        let link_output = if run_program {
            executable_buffer as *const u8
        } else if output_path == null or output_path[0] == 0 {
            "a.out".as_ptr() as *const u8
        } else {
            output_path
        };
        let link_arguments = allocate(4 * sizeof(*mut u8)) as *mut *mut u8;
        if link_arguments == null {
            host_tools_cleanup(
                source_buffer, object_buffer, executable_buffer,
                source_created, object_created, executable_created
            );
            set *failed_stage = DriverHostToolStage::Prepare as u32;
            return DriverHostToolStatus::OutOfMemory as u32;
        }
        set link_arguments[0] = object_buffer;
        set link_arguments[1] = "-o".as_ptr() as *mut u8;
        set link_arguments[2] = link_output as *mut u8;
        let link_status = host_tools_run_arguments(
            compiler_program.as_ptr() as *const u8,
            link_arguments,
            3
        );
        deallocate(link_arguments as *mut u8);
        if link_status != 1 {
            host_tools_cleanup(
                source_buffer, object_buffer, executable_buffer,
                source_created, object_created, executable_created
            );
            set *failed_stage = DriverHostToolStage::Link as u32;
            return if link_status == -2 {
                DriverHostToolStatus::OutOfMemory as u32
            } else if link_status < 0 {
                DriverHostToolStatus::InvocationFailure as u32
            } else {
                DriverHostToolStatus::ProcessFailure as u32
            };
        }
    }

    if run_program {
        let execute_status = host_tools_run_arguments(
            executable_buffer as *const u8,
            run_argv,
            run_argc as usize
        );
        if execute_status != 1 {
            host_tools_cleanup(
                source_buffer, object_buffer, executable_buffer,
                source_created, object_created, executable_created
            );
            set *failed_stage = DriverHostToolStage::Execute as u32;
            return if execute_status == -2 {
                DriverHostToolStatus::OutOfMemory as u32
            } else if execute_status < 0 {
                DriverHostToolStatus::InvocationFailure as u32
            } else {
                DriverHostToolStatus::ProcessFailure as u32
            };
        }
    }

    host_tools_cleanup(
        source_buffer, object_buffer, executable_buffer,
        source_created, object_created, executable_created
    );
    return DriverHostToolStatus::Success as u32;
}

/// Compile generated C17 to an LLVM textual IR module through Clang.
///
/// This bridge intentionally lowers the same supported C17 subset as the
/// normal emitter; it is not a native Vitte-IR-to-LLVM lowering pass. Set
/// `VITTE_LLVM_CC` (or `CLANG`) to select Clang and `VITTE_LLVM_TARGET` to pass
/// one target triple to Clang's `--target` option.
export proc vitte_driver_emit_llvm_ir(
    source: *const u8,
    source_length: usize,
    output_path: *const u8,
    debug_info: bool,
    failed_stage: *mut u32
) -> u32 {
    return host_tools_run_toolchain(
        source, source_length, output_path, false, true, false,
        debug_info, false, 0, null, failed_stage
    );
}

export proc vitte_driver_run_host_toolchain(
    source: *const u8,
    source_length: usize,
    output_path: *const u8,
    emit_object: bool,
    run_program: bool,
    debug_info: bool,
    debug_runtime: bool,
    run_argc: i32,
    run_argv: *mut *mut u8,
    failed_stage: *mut u32
) -> u32 {
    return host_tools_run_toolchain(
        source, source_length, output_path, emit_object, false, run_program,
        debug_info, debug_runtime, run_argc, run_argv, failed_stage
    );
}
