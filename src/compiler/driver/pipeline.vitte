        case ParserError.InvalidPickDeclaration => return "malformed pick declaration";
        case ParserError.DuplicatePickVariant => return "duplicate pick variant";
        case ParserError.InvalidPickVariantPayload => return "invalid pick variant payload";
        case ParserError.InvalidTraitDeclaration => return "malformed trait declaration";
        case ParserError.InvalidImplDeclaration => return "malformed implementation declaration";
        case ParserError.MissingImplTargetType => return "missing implementation target type";
        case ParserError.InvalidImplForClause => return "invalid implementation `for` clause";
        case ParserError.InvalidProcedureDeclaration => return "malformed procedure declaration";
        case ParserError.InvalidProcedureParameters => return "malformed procedure parameter list";
        case ParserError.InvalidProcedureReturnType => return "invalid procedure return type";
        case ParserError.InvalidProcedureModifier => return "invalid procedure modifier";
        case ParserError.InvalidProcedureBodyForm => return "invalid procedure body form";
        case ParserError.InvalidExternalProcedure => return "malformed external procedure declaration";
        case ParserError.InvalidIntrinsicDeclaration => return "malformed intrinsic declaration";
        case ParserError.InvalidAbiStringLiteral => return "invalid ABI string literal";
        case ParserError.InvalidGenericParameterList => return "malformed generic parameter list";
        case ParserError.InvalidConstGenericParameter => return "malformed const generic parameter";
        case ParserError.InvalidGenericBound => return "malformed generic bound";
        case ParserError.InvalidWhereClause => return "malformed where clause";
        case ParserError.InvalidRequiresClause => return "malformed requires clause";
        case ParserError.InvalidEnsuresClause => return "malformed ensures clause";
        case ParserError.InvalidMacroDeclaration => return "malformed macro declaration";
        case ParserError.InvalidMacroParameters => return "malformed macro parameter list";
        case ParserError.InvalidTestDeclaration => return "malformed test declaration";
        case ParserError.InvalidDeclarationModifierOrder => return "invalid declaration modifier order or combination";
        case ParserError.InvalidAttribute => return "malformed attribute";
        case ParserError.InvalidAttributeName => return "missing or invalid attribute name";
        case ParserError.InvalidAttributeArguments => return "malformed attribute arguments";
        case ParserError.MissingAttributeValue => return "missing attribute value";
        case ParserError.InvalidAttributeLiteral => return "invalid attribute literal";
        case ParserError.UnexpectedDeclaration => return "unexpected declaration";
        case ParserError.UnexpectedStatement => return "unexpected statement";
        case ParserError.UnexpectedExpression => return "unexpected expression";
        case ParserError.InvalidProcedureType => return "malformed procedure type";
        case ParserError.InvalidReferenceType => return "malformed reference type";
        case ParserError.InvalidPointerType => return "malformed pointer type";
        case ParserError.InvalidArrayType => return "malformed array type";
        case ParserError.InvalidSliceType => return "malformed slice type";
        case ParserError.InvalidOptionalType => return "malformed optional type";
        case ParserError.InvalidTypePath => return "malformed type path";
        case ParserError.InvalidGenericArguments => return "malformed generic arguments";
        case ParserError.InvalidLetStatement => return "malformed let binding statement";
        case ParserError.InvalidSetStatement => return "malformed set statement";
        case ParserError.InvalidAssignmentOperator => return "invalid assignment operator";
        case ParserError.InvalidReturnStatement => return "malformed return statement";
        case ParserError.InvalidJumpStatement => return "malformed jump statement";
        case ParserError.InvalidDeferStatement => return "malformed defer statement";
        case ParserError.InvalidAssertStatement => return "malformed assert statement";
        case ParserError.InvalidUnsafeStatement => return "malformed unsafe statement";
        case ParserError.InvalidAsmStatement => return "malformed assembly statement";
        case ParserError.InvalidControlFlowStatement => return "malformed control-flow statement";
        case ParserError.InvalidMatchStatement => return "malformed match statement";
        case ParserError.InvalidMatchArm => return "malformed match arm";
        case ParserError.InvalidPattern => return "malformed pattern";
        case ParserError.InvalidRangePattern => return "malformed range pattern";
        case ParserError.InvalidAssignmentExpression => return "malformed assignment expression";
        case ParserError.InvalidCoalescingExpression => return "malformed coalescing expression";
        case ParserError.InvalidLogicalExpression => return "malformed logical expression";
        case ParserError.InvalidBitwiseExpression => return "malformed bitwise expression";
        case ParserError.InvalidComparisonExpression => return "malformed comparison expression";
        case ParserError.InvalidShiftExpression => return "malformed shift expression";
        case ParserError.InvalidArithmeticExpression => return "malformed arithmetic expression";
        case ParserError.InvalidRangeExpression => return "malformed range expression";
        case ParserError.InvalidUnaryExpression => return "malformed unary expression";
        case ParserError.InvalidCastExpression => return "malformed cast expression";
        case ParserError.InvalidPostfixExpression => return "malformed postfix expression";
        case ParserError.InvalidIfExpression => return "malformed if expression";
        case ParserError.InvalidBlockExpression => return "malformed block expression";
        case ParserError.InvalidArrayExpression => return "malformed array expression";
        case ParserError.InvalidSizeofExpression => return "malformed sizeof expression";
        case ParserError.InvalidAlignofExpression => return "malformed alignof expression";
        case ParserError.InvalidNullConstruction => return "malformed null construction";
        case ParserError.InvalidExpressionList => return "malformed expression list";
        else => return "parser error";
    }
}

proc native_pipeline_parser_token_index(
    parser: *const Parser,
    parser_diagnostic: *const ParserDiagnostic
) -> usize {
    if parser == null or parser_diagnostic == null or not (*parser_diagnostic).span.valid {
        return usize.MAX;
    }
    let mut index: usize = 0;
    while index < (*parser).token_count {
        let token = &(*parser).tokens[index];
        if (*token).span.begin == (*parser_diagnostic).span.begin and
           (*token).span.end == (*parser_diagnostic).span.end and
           (*token).kind == (*parser_diagnostic).found {
            return index;
        }
        set index += 1;
    }
    return usize.MAX;
}

proc native_pipeline_parser_delimiter_related(
    parser: *const Parser,
    parser_diagnostic: *const ParserDiagnostic,
    file_id: u64,
    source: string,
    related_begin: *mut usize,
    related_end: *mut usize,
    related_start_line: *mut usize,
    related_start_column: *mut usize,
    related_end_line: *mut usize,
    related_end_column: *mut usize,
    related_label: *mut string
) -> bool {
    if parser == null or parser_diagnostic == null or
       related_begin == null or related_end == null or
       related_start_line == null or related_start_column == null or
       related_end_line == null or related_end_column == null or
       related_label == null {
        return false;
    }

    let expected = (*parser_diagnostic).expected;
    let mut opener_kind: TokenKind = TokenKind.Invalid;
    let token_index = native_pipeline_parser_token_index(parser, parser_diagnostic);
    if token_index == usize.MAX { return false; }

    let mut opener: *const ParserToken = null;
    let expected_is_closer = expected == TokenKind.RightParen or
        expected == TokenKind.RightBracket or expected == TokenKind.RightBrace or
        expected == TokenKind.Greater;
    if expected_is_closer {
        match expected {
            case TokenKind.RightParen => set opener_kind = TokenKind.LeftParen,
            case TokenKind.RightBracket => set opener_kind = TokenKind.LeftBracket,
            case TokenKind.RightBrace => set opener_kind = TokenKind.LeftBrace,
            case TokenKind.Greater => set opener_kind = TokenKind.Less,
            else => return false
        }
        let mut nesting: usize = 0;
        let mut scan_index = token_index;
        while scan_index != 0 {
            set scan_index -= 1;
            let token = &(*parser).tokens[scan_index];
            if expected == TokenKind.Greater and
               (*token).kind == TokenKind.ShiftRight {
                set nesting += 2;
            } elif (*token).kind == expected {
                set nesting += 1;
            } elif (*token).kind == opener_kind {
                if nesting == 0 {
                    set opener = token;
                    break;
                }
                set nesting -= 1;
            }
        }
    } elif (*parser_diagnostic).found == TokenKind.RightParen or
           (*parser_diagnostic).found == TokenKind.RightBracket or
           (*parser_diagnostic).found == TokenKind.RightBrace or
           (*parser_diagnostic).found == TokenKind.Greater or
           (*parser_diagnostic).found == TokenKind.ShiftRight {
        let mut paren_nesting: usize = 0;
        let mut bracket_nesting: usize = 0;
        let mut brace_nesting: usize = 0;
        let mut scan_index = token_index;
        while scan_index != 0 {
            set scan_index -= 1;
            let token = &(*parser).tokens[scan_index];
            match (*token).kind {
                case TokenKind.RightParen => set paren_nesting += 1,
                case TokenKind.LeftParen => {
                    if paren_nesting != 0 {
                        set paren_nesting -= 1;
                    } else {
                        set opener = token;
                        set opener_kind = TokenKind.LeftParen;
                        break;
                    }
                },
                case TokenKind.RightBracket => set bracket_nesting += 1,
                case TokenKind.LeftBracket => {
                    if bracket_nesting != 0 {
                        set bracket_nesting -= 1;
                    } else {
                        set opener = token;
                        set opener_kind = TokenKind.LeftBracket;
                        break;
                    }
                },
                case TokenKind.RightBrace => set brace_nesting += 1,
                case TokenKind.LeftBrace => {
                    if brace_nesting != 0 {
                        set brace_nesting -= 1;
                    } else {
                        set opener = token;
                        set opener_kind = TokenKind.LeftBrace;
                        break;
                    }
                },
                else => {}
            }
        }
    } else {
        return false;
    }
    if opener == null or not (*opener).span.valid { return false; }

    let opener_name = vitte_token_kind_name(opener_kind);
    let expected_name = vitte_token_kind_name(expected);
    if not expected_is_closer {
        let found_name = vitte_token_kind_name((*parser_diagnostic).found);
        set *related_label = "opening `" + opener_name +
            "` does not match closing `" + found_name + "`";
    } elif (*parser_diagnostic).found == TokenKind.RightParen or
          (*parser_diagnostic).found == TokenKind.RightBracket or
          (*parser_diagnostic).found == TokenKind.RightBrace or
          (*parser_diagnostic).found == TokenKind.Greater or
          (*parser_diagnostic).found == TokenKind.ShiftRight {
        if (*parser_diagnostic).found != expected {
            let found_name = vitte_token_kind_name((*parser_diagnostic).found);
            set *related_label = "opening `" + opener_name +
                "` does not match closing `" + found_name +
                "`; expected `" + expected_name + "`";
        } else {
            set *related_label = "opening `" + opener_name +
                "` here; closing `" + expected_name + "` expected";
        }
    } else {
        set *related_label = "opening `" + opener_name +
            "` here; closing `" + expected_name + "` expected";
    }

    let mut scanner: Scanner;
    if (*opener).span.begin > (*opener).span.end or
       (*opener).span.end > source.length or
       not vitte_scanner_init(&mut scanner, source, source.length, file_id as u32) {
        return false;
    }
    let mut start: ScannerPosition;
    let mut end: ScannerPosition;
    let positions_valid =
        vitte_scanner_position_at(&mut scanner, (*opener).span.begin, &mut start) and
        vitte_scanner_position_at(&mut scanner, (*opener).span.end, &mut end);
    vitte_scanner_destroy(&mut scanner);
    if not positions_valid { return false; }

    set *related_begin = (*opener).span.begin;
    set *related_end = (*opener).span.end;
    set *related_start_line = start.line - 1;
    set *related_start_column = start.column - 1;
    set *related_end_line = end.line - 1;
    set *related_end_column = end.column - 1;
    return true;
}

proc native_pipeline_parser_duplicate_form_field_related(
    parser: *const Parser,
    parser_diagnostic: *const ParserDiagnostic,
    file_id: u64,
    source: str,
    related_begin: *mut usize,
    related_end: *mut usize,
    related_start_line: *mut usize,
    related_start_column: *mut usize,
    related_end_line: *mut usize,
    related_end_column: *mut usize
) -> bool {
    if parser == null or parser_diagnostic == null or
       (*parser_diagnostic).error != ParserError.DuplicateFormField or
       not (*parser_diagnostic).span.valid or related_begin == null or
       related_end == null or related_start_line == null or
       related_start_column == null or related_end_line == null or
       related_end_column == null {
        return false;
    }
    let root = vitte_parser_get_node(parser, vitte_parser_root(parser));
    if root == null or (*root).kind != ASTNodeKind.TranslationUnit {
        return false;
    }
    let mut declaration_index: usize = 0;
    while declaration_index < (*root).child_count {
        let declaration = vitte_parser_get_node(parser, (*root).children[declaration_index]);
        if declaration != null and (*declaration).kind == ASTNodeKind.FormDecl {
            let mut field_index: usize = 1;
            while field_index < (*declaration).child_count {
                let field = vitte_parser_get_node(parser, (*declaration).children[field_index]);
                if field != null and (*field).kind == ASTNodeKind.FieldDecl and
                   (*field).child_count != 0 {
                    let field_name = vitte_parser_get_node(parser, (*field).children[0]);
                    if field_name != null and (*field_name).span.valid and
                       (*field_name).span.begin == (*parser_diagnostic).span.begin and
                       (*field_name).span.end == (*parser_diagnostic).span.end {
                        let field_token = if (*field_name).token_index < (*parser).token_count {
                            &(*parser).tokens[(*field_name).token_index]
                        } else { null };
                        if field_token == null {
                            return false;
                        }
                        let mut previous_index: usize = 1;
                        while previous_index < field_index {
                            let previous_field = vitte_parser_get_node(
                                parser, (*declaration).children[previous_index]
                            );
                            if previous_field != null and
                               (*previous_field).kind == ASTNodeKind.FieldDecl and
                               (*previous_field).child_count != 0 {
                                let previous_name = vitte_parser_get_node(
                                    parser, (*previous_field).children[0]
                                );
                                if previous_name != null and
                                   (*previous_name).token_index < (*parser).token_count {
                                    let previous_token = &(*parser).tokens[(*previous_name).token_index];
                                    if (*previous_token).length == (*field_token).length and
                                       (*previous_token).lexeme == (*field_token).lexeme and
                                       (*previous_name).span.valid {
                                        let mut scanner: Scanner;
                                        if (*previous_name).span.begin > (*previous_name).span.end or
                                           (*previous_name).span.end > source.length or
                                           not vitte_scanner_init(
                                               &mut scanner, source, source.length, file_id as u32
                                           ) {
                                            return false;
                                        }
                                        let mut start: ScannerPosition;
                                        let mut end: ScannerPosition;
                                        let positions_valid =
                                            vitte_scanner_position_at(
                                                &mut scanner, (*previous_name).span.begin, &mut start
                                            ) and
                                            vitte_scanner_position_at(
                                                &mut scanner, (*previous_name).span.end, &mut end
                                            );
                                        vitte_scanner_destroy(&mut scanner);
                                        if not positions_valid {
                                            return false;
                                        }
                                        set *related_begin = (*previous_name).span.begin;
                                        set *related_end = (*previous_name).span.end;
                                        set *related_start_line = start.line - 1;
                                        set *related_start_column = start.column - 1;
                                        set *related_end_line = end.line - 1;
                                        set *related_end_column = end.column - 1;
                                        return true;
                                    }
                                }
                            }
                            set previous_index += 1;
                        }
                        return false;
                    }
                }
                set field_index += 1;
            }
        }
        set declaration_index += 1;
    }
    return false;
}

proc native_pipeline_parser_duplicate_pick_variant_related(
    parser: *const Parser,
    parser_diagnostic: *const ParserDiagnostic,
    file_id: u64,
    source: str,
    related_begin: *mut usize,
    related_end: *mut usize,
    related_start_line: *mut usize,
    related_start_column: *mut usize,
    related_end_line: *mut usize,
    related_end_column: *mut usize
) -> bool {
    if parser == null or parser_diagnostic == null or
       (*parser_diagnostic).error != ParserError.DuplicatePickVariant or
       not (*parser_diagnostic).span.valid or related_begin == null or
       related_end == null or related_start_line == null or
       related_start_column == null or related_end_line == null or
       related_end_column == null {
        return false;
    }
    let root = vitte_parser_get_node(parser, vitte_parser_root(parser));
    if root == null or (*root).kind != ASTNodeKind.TranslationUnit {
        return false;
    }
    let mut declaration_index: usize = 0;
    while declaration_index < (*root).child_count {
        let declaration = vitte_parser_get_node(parser, (*root).children[declaration_index]);
        if declaration != null and (*declaration).kind == ASTNodeKind.PickDecl {
            let mut variant_index: usize = 1;
            while variant_index < (*declaration).child_count {
                let variant = vitte_parser_get_node(parser, (*declaration).children[variant_index]);
                if variant != null and (*variant).kind == ASTNodeKind.VariantDecl and
                   (*variant).child_count != 0 {
                    let variant_name = vitte_parser_get_node(parser, (*variant).children[0]);
                    if variant_name != null and (*variant_name).span.valid and
                       (*variant_name).span.begin == (*parser_diagnostic).span.begin and
                       (*variant_name).span.end == (*parser_diagnostic).span.end {
                        let variant_token = if (*variant_name).token_index < (*parser).token_count {
                            &(*parser).tokens[(*variant_name).token_index]
                        } else { null };
                        if variant_token == null {
                            return false;
                        }
                        let mut previous_index: usize = 1;
                        while previous_index < variant_index {
                            let previous_variant = vitte_parser_get_node(
                                parser, (*declaration).children[previous_index]
                            );
                            if previous_variant != null and
                               (*previous_variant).kind == ASTNodeKind.VariantDecl and
                               (*previous_variant).child_count != 0 {
                                let previous_name = vitte_parser_get_node(
                                    parser, (*previous_variant).children[0]
                                );
                                if previous_name != null and
                                   (*previous_name).token_index < (*parser).token_count {
                                    let previous_token = &(*parser).tokens[(*previous_name).token_index];
                                    if (*previous_token).length == (*variant_token).length and
                                       (*previous_token).lexeme == (*variant_token).lexeme and
                                       (*previous_name).span.valid {
                                        let mut scanner: Scanner;
                                        if (*previous_name).span.begin > (*previous_name).span.end or
                                           (*previous_name).span.end > source.length or
                                           not vitte_scanner_init(
                                               &mut scanner, source, source.length, file_id as u32
                                           ) {
                                            return false;
                                        }
                                        let mut start: ScannerPosition;
                                        let mut end: ScannerPosition;
                                        let positions_valid =
                                            vitte_scanner_position_at(
                                                &mut scanner, (*previous_name).span.begin, &mut start
                                            ) and
                                            vitte_scanner_position_at(
                                                &mut scanner, (*previous_name).span.end, &mut end
                                            );
                                        vitte_scanner_destroy(&mut scanner);
                                        if not positions_valid {
                                            return false;
                                        }
                                        set *related_begin = (*previous_name).span.begin;
                                        set *related_end = (*previous_name).span.end;
                                        set *related_start_line = start.line - 1;
                                        set *related_start_column = start.column - 1;
                                        set *related_end_line = end.line - 1;
                                        set *related_end_column = end.column - 1;
                                        return true;
                                    }
                                }
                            }
                            set previous_index += 1;
                        }
                        return false;
                    }
                }
                set variant_index += 1;
            }
        }
        set declaration_index += 1;
    }
    return false;
}


proc native_pipeline_parser_inside_import(
    parser: *const Parser,
    token_index: usize
) -> bool {
    let mut index = token_index;
    while index != 0 {
        set index -= 1;
        let kind = (*parser).tokens[index].kind;
        if kind == TokenKind.Semicolon { return false; }
        if kind == TokenKind.KwUse or kind == TokenKind.KwExport { return true; }
    }
    return false;
}

proc native_pipeline_parser_declaration_expects_block(
    parser: *const Parser,
    token_index: usize
) -> bool {
    let mut index = token_index;
    while index != 0 {
        set index -= 1;
        let kind = (*parser).tokens[index].kind;
        if kind == TokenKind.KwSpace or kind == TokenKind.KwForm or
           kind == TokenKind.KwPick or kind == TokenKind.KwTrait or
           kind == TokenKind.KwImpl or kind == TokenKind.KwProc or
           kind == TokenKind.KwMacro or kind == TokenKind.KwTest {
            return true;
        }
        if kind == TokenKind.Semicolon or kind == TokenKind.LeftBrace or
           kind == TokenKind.RightBrace or kind == TokenKind.KwIf or
           kind == TokenKind.KwElse or kind == TokenKind.KwWhile or
           kind == TokenKind.KwLoop or kind == TokenKind.KwMatch or
           kind == TokenKind.KwUse {
            return false;
        }
    }
    return false;
}

proc native_pipeline_parser_advice(
    parser: *const Parser,
    parser_diagnostic: *const ParserDiagnostic,
    message: &mut string,
    help: &mut string
) {
    if parser == null or parser_diagnostic == null or message == null or help == null or
       (*parser_diagnostic).kind != ParserDiagnosticKind.Error {
        return;
    }
    if (*parser_diagnostic).expected == TokenKind.Identifier and
       vitte_token_kind_is_keyword((*parser_diagnostic).found) {
        set *message = "reserved word cannot be used as a name";
        set *help = "Rename this item; Vitte reserved words cannot be used as identifiers.";
        return;
    }
    if (*parser_diagnostic).error == ParserError.Unsupported {
        set *message = "unsupported syntax in declaration position";
        set *help = "Use a declaration form supported by Vitte, such as `proc`, `form`, `pick`, `const`, or `type`.";
        return;
    }
    match (*parser_diagnostic).error {
        case ParserError.InvalidModulePath => {
            set *message = "malformed module path";
            let token_index = native_pipeline_parser_token_index(parser, parser_diagnostic);
            if token_index != usize.MAX and token_index + 1 < (*parser).token_count and
               native_pipeline_parser_inside_import(parser, token_index) and
               (*parser).tokens[token_index].kind == TokenKind.ColonColon and
               (*parser).tokens[token_index + 1].kind == TokenKind.Identifier {
                set *help = "A `use` path names modules. If the final segment is an exported symbol, import it through a group, for example `use sample::math::{add};`; use `as local_name` inside the group to avoid a name conflict.";
                return;
            }
            set *help = "Write each path segment as an identifier separated by `::` or `/`; remove leading, repeated or trailing separators.";
            return;
        },
        case ParserError.InvalidProcedureType => {
            set *message = "malformed procedure type";
            set *help = "Write `proc(Type, Type)`, optionally followed by `-> ReturnType`; separate parameters with commas and close the list with `)`.";
            return;
        },
        case ParserError.InvalidReferenceType => {
            set *message = "malformed reference type";
            set *help = "Write `&Type`, `&mut Type`, `ref Type` or `ref mut Type`, with a complete type after the reference marker.";
            return;
        },
        case ParserError.InvalidPointerType => {
            set *message = "malformed pointer type";
            set *help = "Write `*Type`, `*mut Type`, `*const Type`, `*volatile Type` or `*const volatile Type`; provide one complete pointee type.";
            return;
        },
        case ParserError.InvalidArrayType => {
            set *message = "malformed array type";
            set *help = "Write `[Type; length]` or `[length] Type`, with a valid length expression, closing `]` and element type.";
            return;
        },
        case ParserError.InvalidSliceType => {
            set *message = "malformed slice type";
            set *help = "Write a slice as `[ElementType]` and include a complete element type before the closing `]`.";
            return;
        },
        case ParserError.InvalidOptionalType => {
            set *message = "malformed optional type";
            set *help = "Write `?Type` and put a complete type after `?`.";
            return;
        },
        case ParserError.InvalidTypePath => {
            set *message = "malformed type path";
            set *help = "Use nonempty path segments separated by `::` or `/`; use `::` instead of `:`, add a segment after every separator and remove repeated separators.";
            return;
        },
        case ParserError.InvalidGenericArguments => {
            set *message = "malformed generic arguments";
            set *help = "Use comma-separated types in `<Type, Type>` or `[Type, Type]`; close the list with the matching `>` or `]`.";
            return;
        },
        case ParserError.InvalidLetStatement => {
            set *message = "malformed let binding statement";
            set *help = "Write `let [mut] pattern [: Type] [= expression];`. Add a type annotation when there is no initializer and the binding type cannot be inferred.";
            return;
        },
        case ParserError.InvalidSetStatement => {
            set *message = "malformed set statement";
            set *help = "Write `set target assignment_operator expression;` and provide a complete target, value and terminating semicolon.";
            return;
        },
        case ParserError.InvalidAssignmentOperator => {
            set *message = "invalid assignment operator";
            set *help = "Use one of `=`, `+=`, `-=`, `*=`, `/=`, `%=`, `&=`, `|=`, `^=`, `<<=` or `>>=` after the assignment target.";
            return;
        },
        case ParserError.InvalidReturnStatement => {
            set *message = "malformed return statement";
            set *help = "Write `return;` or `return expression;`. The final return in a block may omit `;` before `}` or end of file; procedure placement and return type are checked semantically.";
            return;
        },
        case ParserError.InvalidJumpStatement => {
            set *message = "malformed jump statement";
            set *help = "Write `break;` or `continue;` with a semicolon. A jump must appear inside a loop within a procedure.";
            return;
        },
        case ParserError.InvalidDeferStatement => {
            set *message = "malformed defer statement";
            set *help = "Write `defer { ... }` or `defer expression;`; the expression form requires its terminating semicolon.";
            return;
        },
        case ParserError.InvalidAssertStatement => {
            set *message = "malformed assert statement";
            set *help = "Write `assert(condition);` with a complete expression between matching parentheses and a final semicolon.";
            return;
        },
        case ParserError.InvalidUnsafeStatement => {
            set *message = "malformed unsafe statement";
            set *help = "Write `unsafe { ... }` and close the block with `}`.";
            return;
        },
        case ParserError.InvalidAsmStatement => {
            set *message = "malformed assembly statement";
            set *help = "Write `asm(operand, ...);` or `asm(\"template\");`; close the operand list and terminate the statement with `;`.";
            return;
        },
        case ParserError.InvalidControlFlowStatement => {
            set *message = "malformed control-flow statement";
            set *help = "Use `if condition { ... } [elif condition { ... }]* [else { ... }]`, `while condition { ... }`, `loop { ... }`, or `for pattern in values { ... }`; put `else` after an if/elif chain and use it only before a block or chained conditional.";
            return;
        },
        case ParserError.InvalidMatchStatement => {
            set *message = "malformed match statement";
            set *help = "Write `match value { pattern => body, ... }`; provide a subject and braces, and use complete comma-separated arms when the arm list is nonempty.";
            return;
        },
        case ParserError.InvalidMatchArm => {
            set *message = "malformed match arm";
            set *help = "Write `[case] pattern [if guard] => body`, separate adjacent arms with commas, and use a complete expression, statement or block as the body.";
            return;
        },
        case ParserError.InvalidPattern => {
            set *message = "malformed pattern";
            set *help = "Use a path or binding, literal, `Path::Variant`, `Variant(pattern, ...)`, `Path { field: pattern, .. }`, `(pattern, ...)`, or `[pattern, ...]`; separate pattern items with commas.";
            return;
        },
        case ParserError.InvalidRangePattern => {
            set *message = "malformed range pattern";
            set *help = "Write `lower..upper` or `lower..=upper`; both endpoints must be integer, float or character literals of the same kind.";
            return;
        },
        case ParserError.InvalidAssignmentExpression => {
            set *message = "malformed assignment expression";
            set *help = "Write `target = value` or use a supported compound assignment operator; provide both a complete target and right-hand expression.";
            return;
        },
        case ParserError.InvalidCoalescingExpression => {
            set *message = "malformed coalescing expression";
            set *help = "Write `value ?? fallback` and provide a complete expression on both sides of `??`.";
            return;
        },
        case ParserError.InvalidLogicalExpression => {
            set *message = "malformed logical expression";
            set *help = "Write both operands around `and`, `or`, `&&` or `||`; parenthesize nested conditions when needed.";
            return;
        },
        case ParserError.InvalidBitwiseExpression => {
            set *message = "malformed bitwise expression";
            set *help = "Write both operands around `&`, `|` or `^`; use a complete expression on each side.";
            return;
        },
        case ParserError.InvalidComparisonExpression => {
            set *message = "malformed comparison expression";
            set *help = "Write a complete left and right expression around `==`, `!=`, `<`, `<=`, `>` or `>=`.";
            return;
        },
        case ParserError.InvalidShiftExpression => {
            set *message = "malformed shift expression";
            set *help = "Write a value and shift count around `<<` or `>>`.";
            return;
        },
        case ParserError.InvalidArithmeticExpression => {
            set *message = "malformed arithmetic expression";
            set *help = "Write complete operands around `+`, `-`, `*`, `/` or `%`; add parentheses to make grouping clear.";
            return;
        },
        case ParserError.InvalidRangeExpression => {
            set *message = "malformed range expression";
            set *help = "Write `start..end` for an exclusive range or `start..=end` for an inclusive range, with a complete expression at each endpoint.";
            return;
        },
        case ParserError.InvalidUnaryExpression => {
            set *message = "malformed unary expression";
            set *help = "Put one complete operand after the unary operator, for example `-value`, `not ready`, `&value` or `*pointer`.";
            return;
        },
        case ParserError.InvalidCastExpression => {
            set *message = "malformed cast expression";
            set *help = "Write `value as Type` and provide a complete type after `as`.";
            return;
        },
        case ParserError.InvalidPostfixExpression => {
            set *message = "malformed postfix expression";
            set *help = "Complete the suffix: use `callee(arguments)`, `value[index]`, `value.field`, `value?`, or `Type { field: value }`; generic form and variant suffixes need nonempty, well-formed type arguments.";
            return;
        },
        case ParserError.InvalidIfExpression => {
            set *message = "malformed if expression";
            set *help = "Write `if condition { value } else { fallback }`; an if expression needs an else branch, and `elif` may continue the chain.";
            return;
        },
        case ParserError.InvalidBlockExpression => {
            set *message = "malformed block expression";
            set *help = "Close the block with `}`; place complete statements before the optional final expression.";
            return;
        },
        case ParserError.InvalidArrayExpression => {
            set *message = "malformed array expression";
            set *help = "Write `[]` or `[expression, ...]`; separate elements with commas and close the array with `]`.";
            return;
        },
        case ParserError.InvalidSizeofExpression => {
            set *message = "malformed sizeof expression";
            set *help = "Write `sizeof(Type)` or `sizeof(expression)` with a complete operand and matching parentheses.";
            return;
        },
        case ParserError.InvalidAlignofExpression => {
            set *message = "malformed alignof expression";
            set *help = "Write `alignof(Type)` with a complete type and matching parentheses.";
            return;
        },
        case ParserError.InvalidNullConstruction => {
            set *message = "malformed null construction";
            set *help = "Write `null()` or `null(expression, ...)` and close the argument list with `)`.";
            return;
        },
        case ParserError.InvalidExpressionList => {
            set *message = "malformed expression list";
            set *help = "Provide complete expressions separated by commas. A trailing comma is allowed, but empty items are invalid; a missing-comma insertion is suggested only when the next token clearly starts another item.";
            return;
        },
        case ParserError.DuplicateModuleHeader => {
            set *message = "duplicate module header";
            set *help = "Keep one top-level `space path` header in this file and remove the duplicate declaration.";
            return;
        },
        case ParserError.MisplacedModuleHeader => {
            set *message = "misplaced module header";
            set *help = "Move `space path;` before the first import or other top-level declaration.";
            return;
        },
        case ParserError.InvalidUseDeclaration => {
            set *message = "malformed use declaration";
            set *help = "Use `use path;`, `use path as alias;`, `use path::*;` or `use path::{item, nested::{item}};`, then end it with `;`.";
            return;
        },
        case ParserError.InvalidUseAlias => {
            set *message = "invalid import alias";
            set *help = "Add an identifier after `as`, for example `use math::vector as vectors;`.";
            return;
        },
        case ParserError.InvalidImportGroup => {
            set *message = "malformed import group";
            set *help = "Add comma-separated import paths, close every brace, and place nested groups after a path.";
            return;
        },
        case ParserError.InvalidGlobImport => {
            set *message = "invalid glob import";
            set *help = "Place `::*` at the end of the import, for example `use math::*;`; remove aliases or following path segments.";
            return;
        },
        case ParserError.InvalidExportClause => {
            set *message = "malformed export clause";
            set *help = "Use `export path [as alias];`, `export {path, other};` or `export *;`.";
            return;
        },
        case ParserError.EmptyExportGroup => {
            set *message = "empty export group";
            set *help = "Add at least one path inside the braces, for example `export {math::add};`.";
            return;
        },
        case ParserError.InvalidExportAlias => {
            set *message = "invalid export alias";
            set *help = "Add an identifier after `as`, for example `export math::add as add;`.";
            return;
        },
        case ParserError.TrailingTokens => {
            set *message = "unexpected trailing tokens";
            set *help = "Remove the extra token before the required semicolon or finish the clause in the form shown by the diagnostic.";
            return;
        },
        case ParserError.MissingModuleHeader => {
            set *message = "missing module header";
            set *help = "Add one top-level `space path;` declaration before the first module import or export clause.";
            return;
        },
        case ParserError.InvalidValueDeclaration => {
            set *message = "malformed const or static declaration";
            set *help = "Give the declaration a name, put an optional type after `:`, add `= expression`, and finish with `;`.";
            return;
        },
        case ParserError.MissingValueInitializer => {
            set *message = "missing const or static initializer";
            set *help = "Add `= expression` after the name and optional type, for example `const LIMIT: int = 10;`.";
            return;
        },
        case ParserError.InvalidTypeDeclaration => {
            set *message = "malformed type declaration";
            set *help = "Complete the type name, each bound or aliased type, and the final `;`.";
            return;
        },
        case ParserError.InvalidOpaqueDeclaration => {
            set *message = "malformed opaque declaration";
            set *help = "Give the opaque type a name, use `= Type` for an optional alias, and omit bounds.";
            return;
        },
        case ParserError.InvalidFormDeclaration => {
            set *message = "malformed form declaration";
            set *help = "Write a named form with `{}` and fields in the form `name: Type`.";
            return;
        },
        case ParserError.DuplicateFormField => {
            set *message = "duplicate form field";
            set *help = "Rename this field; every field in one form must have a unique name.";
            return;
        },
        case ParserError.InvalidFormFieldSeparator => {
            set *message = "missing form field separator";
            set *help = "Separate adjacent fields with `,` or `;`, for example `form Point { x: int, y: int }`.";
            return;
        },
        case ParserError.InvalidPickDeclaration => {
            set *message = "malformed pick declaration";
            set *help = "Write a named pick with braces and comma-separated variants, for example `pick Option { None, Some(int) }`.";
            return;
        },
        case ParserError.DuplicatePickVariant => {
            set *message = "duplicate pick variant";
            set *help = "Rename this variant; each variant name must be unique within its pick.";
            return;
        },
        case ParserError.InvalidPickVariantPayload => {
            set *message = "invalid pick variant payload";
            set *help = "Put valid comma-separated types inside the variant parentheses, for example `Some(int, string)`; `()` is also valid.";
            return;
        },
        case ParserError.InvalidTraitDeclaration => {
            set *message = "malformed trait declaration";
            set *help = "Write `trait Name { ... }`, with optional generic parameters and a `where` clause before the block.";
            return;
        },
        case ParserError.InvalidImplDeclaration => {
            set *message = "malformed implementation declaration";
            set *help = "Write an inherent implementation as `impl Type { ... }` or a trait implementation as `impl Trait for Type { ... }`.";
            return;
        },
        case ParserError.MissingImplTargetType => {
            set *message = "missing implementation target type";
            set *help = "Add the type after `for`, for example `impl Display for Point { ... }`.";
            return;
        },
        case ParserError.InvalidImplForClause => {
            set *message = "invalid implementation `for` clause";
            set *help = "Use one trait type, `for`, one target type, then an optional `where` clause and the implementation block.";
            return;
        },
        case ParserError.InvalidProcedureDeclaration => {
            set *message = "malformed procedure declaration";
            set *help = "Write `proc name(parameters)`, then an optional `-> Type`, optional constraints, and a body or `;`.";
            return;
        },
        case ParserError.InvalidProcedureParameters => {
            set *message = "malformed procedure parameter list";
            set *help = "Enclose parameters in `(...)`; each parameter needs a pattern, `:`, a type, commas between entries, and a closing `)`.";
            return;
        },
        case ParserError.InvalidProcedureReturnType => {
            set *message = "invalid procedure return type";
            set *help = "Put a valid type after `->`, for example `proc size() -> int;`.";
            return;
        },
        case ParserError.InvalidProcedureModifier => {
            set *message = "invalid procedure modifier";
            set *help = "Use `async`, `unsafe` or `comptime` at most once and only before a procedure declaration.";
            return;
        },
        case ParserError.InvalidProcedureBodyForm => {
            set *message = "invalid procedure body form";
            set *help = "A normal procedure needs a block or `;`; an `extern` or `intrinsic` procedure must end with `;` and has no body.";
            return;
        },
        case ParserError.InvalidExternalProcedure => {
            set *message = "malformed external procedure declaration";
            set *help = "Write `extern [\"ABI\"] proc name(parameters) [-> Type] [where ...] [requires ...;] [ensures ...;];`.";
            return;
        },
        case ParserError.InvalidIntrinsicDeclaration => {
            set *message = "malformed intrinsic declaration";
            set *help = "Write `intrinsic name(parameters) [-> Type] [where ...] [requires ...;] [ensures ...;];` without an ABI literal or body.";
            return;
        },
        case ParserError.InvalidAbiStringLiteral => {
            set *message = "invalid ABI string literal";
            set *help = "Use a nonempty quoted ABI name after `extern`, for example `extern \"C\" proc write();`.";
            return;
        },
        case ParserError.InvalidGenericParameterList => {
            set *message = "malformed generic parameter list";
            set *help = "Write `<T, U>` with comma-separated parameters and a closing `>`; a trailing comma is allowed.";
            return;
        },
        case ParserError.InvalidConstGenericParameter => {
            set *message = "malformed const generic parameter";
            set *help = "Write a const parameter as `const NAME`, optionally followed by a type bound, for example `const N: usize`.";
            return;
        },
        case ParserError.InvalidGenericBound => {
            set *message = "malformed generic bound";
            set *help = "Add a valid type after `:` or `+`, for example `T: Display + Debug`.";
            return;
        },
        case ParserError.InvalidWhereClause => {
            set *message = "malformed where clause";
            set *help = "Write one or more comma-separated predicates after `where`, such as `where T: Display, N > 0`.";
            return;
        },
        case ParserError.InvalidRequiresClause => {
            set *message = "malformed requires clause";
            set *help = "Add a boolean expression and its semicolon, for example `requires count > 0;`.";
            return;
        },
        case ParserError.InvalidEnsuresClause => {
            set *message = "malformed ensures clause";
            set *help = "Add a boolean expression and its semicolon, for example `ensures result >= 0;`.";
            return;
        },
        case ParserError.InvalidMacroDeclaration => {
            set *message = "malformed macro declaration";
            set *help = "Write `macro name` with an optional parameter list and a body, for example `macro log(value: string) { ... }`.";
            return;
        },
        case ParserError.InvalidMacroParameters => {
            set *message = "malformed macro parameter list";
            set *help = "Use `(...)` with comma-separated `pattern: Type` parameters and a closing `)`.";
            return;
        },
        case ParserError.InvalidTestDeclaration => {
            set *message = "malformed test declaration";
            set *help = "Write `test { ... }`, `test test_name { ... }`, or `test \"description\" { ... }`.";
            return;
        },
        case ParserError.InvalidDeclarationModifierOrder => {
            set *message = "invalid declaration modifier order or combination";
            set *help = "Use at most one visibility modifier (`pub` or prefix `export`) before procedure modifiers; write export clauses without declaration modifiers.";
            return;
        },
        case ParserError.InvalidAttribute => {
            set *message = "malformed attribute";
            set *help = "Write an attribute as `#[name]` or `#![name]`; include the opening `[` and closing `]` and close any argument parentheses.";
            return;
        },
        case ParserError.InvalidAttributeName => {
            set *message = "missing or invalid attribute name";
            set *help = "Provide an identifier or keyword after `#[` or `#![` and after each `::` in a qualified attribute name.";
            return;
        },
        case ParserError.InvalidAttributeArguments => {
            set *message = "malformed attribute arguments";
            set *help = "Use comma-separated names or literals in parentheses; write named arguments as `name = literal`.";
            return;
        },
        case ParserError.MissingAttributeValue => {
            set *message = "missing attribute value";
            set *help = "Add a literal after `=`, for example `#[cfg(enabled = true)]`.";
            return;
        },
        case ParserError.InvalidAttributeLiteral => {
            set *message = "invalid attribute literal";
            set *help = "Use an integer, float, string, character, boolean, or `null` literal as the attribute value.";
            return;
        },
        case ParserError.UnexpectedDeclaration => {
            set *message = "unexpected declaration";
            set *help = "Move this declaration to a declaration position, such as the top level or a trait/implementation declaration block.";
            return;
        },
        case ParserError.UnexpectedStatement => {
            set *message = "unexpected statement";
            set *help = "Move this statement into a block that accepts statements, such as a procedure body.";
            return;
        },
        case ParserError.UnexpectedExpression => {
            set *message = "unexpected expression";
            set *help = "Move this expression into a statement or expression context; declarations require a declaration position.";
            return;
        },
        else => {}
    }
    let token_index = native_pipeline_parser_token_index(parser, parser_diagnostic);
    if token_index != usize.MAX and token_index != 0 {
        let previous = (*parser).tokens[token_index - 1].kind;
        if previous == TokenKind.KwReturn and
           (*parser_diagnostic).error == ParserError.ExpectedExpression {
            set *message = "expected an expression after `return`";
            set *help = "Write the return value after `return`, before the statement terminator.";
            return;
        }
        if previous == TokenKind.Colon and
           ((*parser_diagnostic).error == ParserError.ExpectedType or
            (*parser_diagnostic).error == ParserError.ExpectedToken or
            (*parser_diagnostic).error == ParserError.ExpectedIdentifier) {
            set *message = "expected a type after `:`";
            set *help = "Write a type expression after the colon, such as a built-in or visible declared type.";
            return;
        }
        if previous == TokenKind.KwAs and
           (*parser_diagnostic).error == ParserError.ExpectedIdentifier and
           native_pipeline_parser_inside_import(parser, token_index) {
            set *message = "expected a local name after `as`";
            set *help = "Provide the local name that should refer to the imported item.";
            return;
        }
        if (*parser_diagnostic).expected == TokenKind.LeftBrace and
           native_pipeline_parser_declaration_expects_block(parser, token_index) {
            set *message = "expected a block after this declaration";
            set *help = "Start the declaration body with `{` and close it with `}`.";
            return;
        }
    }

    match (*parser_diagnostic).expected {
        case TokenKind.RightParen => {
            set *help = "Close the parenthesized expression or argument list with `)` before continuing.";
        },
        case TokenKind.RightBracket => {
            set *help = "Close the indexed expression or array type with `]` before continuing.";
        },
        case TokenKind.RightBrace => {
            set *help = "Close the block or aggregate body with `}` before continuing.";
        },
        case TokenKind.Semicolon => {
            set *help = "End this statement with `;` before starting the next one.";
        },
        case TokenKind.Comma => {
            set *help = "Separate adjacent parameters, arguments, fields, or items with `,`.";
        },
        case TokenKind.Identifier => {
            set *help = "Provide a valid identifier at this position.";
        },
        case TokenKind.LeftBrace => {
            set *help = "Start the required block with `{` and close it with `}`.";
        },
        else => {}
    }
}

proc native_pipeline_sema_message(code: SemaDiagnosticCode) -> string {
    match code {
        case SemaDiagnosticCode.UnresolvedName => return "unknown symbol";
        case SemaDiagnosticCode.AmbiguousName => return "ambiguous symbol";
        case SemaDiagnosticCode.DuplicateImport => return "duplicate import";
        case SemaDiagnosticCode.PrivateSymbol => return "symbol is not visible";
        case SemaDiagnosticCode.DuplicateDeclaration => return "duplicate declaration";
        case SemaDiagnosticCode.InvalidScope => return "invalid scope";
        case SemaDiagnosticCode.DuplicateBinding => return "duplicate binding";
        case SemaDiagnosticCode.InvalidExport => return "invalid export target";
        case SemaDiagnosticCode.ShadowedDeclaration => return "declaration shadows an existing name";
        case SemaDiagnosticCode.NotCallable => return "this value is not callable";
        case SemaDiagnosticCode.InvalidArgumentCount => return "invalid number of arguments";
        case SemaDiagnosticCode.InvalidArgumentType => return "invalid argument type";
        case SemaDiagnosticCode.UnknownType => return "unknown type";
        case SemaDiagnosticCode.NotAType => return "name is not a type";
        case SemaDiagnosticCode.InvalidCast => return "invalid cast";
        case SemaDiagnosticCode.NotAValue => return "type name used as a value";
        case SemaDiagnosticCode.IncompleteType => return "incomplete type";
        case SemaDiagnosticCode.RecursiveType => return "invalid recursive type";
        case SemaDiagnosticCode.GenericBoundUnsatisfied => return "generic bound not satisfied";
        case SemaDiagnosticCode.GenericArgumentCount => return "incorrect generic argument count";
        case SemaDiagnosticCode.GenericArgumentKind => return "incorrect generic argument kind or order";
        case SemaDiagnosticCode.GenericInferenceConflict => return "conflicting generic inference";
        case SemaDiagnosticCode.TraitNotImplemented => return "trait not implemented";
        case SemaDiagnosticCode.AmbiguousImpl => return "ambiguous trait implementation";
        case SemaDiagnosticCode.ConflictingImpl => return "conflicting trait implementation";
        case SemaDiagnosticCode.MissingTraitMember => return "missing trait member";
        case SemaDiagnosticCode.InvalidTraitMember => return "invalid trait member";
        case SemaDiagnosticCode.InvalidImplTarget => return "invalid implementation target";
        case SemaDiagnosticCode.InvalidWherePredicate => return "invalid where predicate";
        case SemaDiagnosticCode.AmbiguousMethod => return "ambiguous method";
        case SemaDiagnosticCode.InvalidUnaryOperand => return "invalid unary operand";
        case SemaDiagnosticCode.InvalidBinaryOperands => return "invalid binary operands";
        case SemaDiagnosticCode.NotAssignable => return "this expression is not assignable";
        case SemaDiagnosticCode.NotIndexable => return "this value cannot be indexed";
        case SemaDiagnosticCode.InvalidIndexType => return "invalid index type";
        case SemaDiagnosticCode.UnknownMember => return "unknown member";
        case SemaDiagnosticCode.ConditionNotBool => return "condition must be a boolean";
        case SemaDiagnosticCode.ReturnTypeMismatch => return "returned value has an incompatible type";
        case SemaDiagnosticCode.ReturnOutsideProc => return "return used outside a procedure";
        case SemaDiagnosticCode.BreakOutsideLoop => return "break used outside a loop";
        case SemaDiagnosticCode.ContinueOutsideLoop => return "continue used outside a loop";
        case SemaDiagnosticCode.UnreachableCode => return "unreachable code";
        case SemaDiagnosticCode.MissingReturn => return "procedure may fall through without returning a value";
        case SemaDiagnosticCode.MatchNonExhaustive => return "match does not cover every possible value";
        case SemaDiagnosticCode.MatchUnreachable => return "match arm is unreachable";
        case SemaDiagnosticCode.MatchType => return "pattern does not match the subject type or shape";
        case SemaDiagnosticCode.InvalidDeferredControlFlow => return "deferred work cannot exit its enclosing control flow";
        case SemaDiagnosticCode.OverlappingPattern => return "match arm overlaps an earlier pattern";
        case SemaDiagnosticCode.InvalidRequiresClause => return "requires clause must evaluate to bool";
        case SemaDiagnosticCode.InvalidEnsuresClause => return "ensures clause must evaluate to bool";
        case SemaDiagnosticCode.OldValueUnavailable => return "old value is unavailable in this contract";
        case SemaDiagnosticCode.ResultUnavailable => return "result is unavailable in this contract";
        case SemaDiagnosticCode.ConstantNotConstant => return "expression is not constant";
        case SemaDiagnosticCode.ConstantOverflow => return "constant arithmetic overflows its supported range";
        case SemaDiagnosticCode.ConstantDivideByZero => return "division by zero during constant evaluation";
        case SemaDiagnosticCode.ConstantRemainderByZero => return "remainder by zero during constant evaluation";
        case SemaDiagnosticCode.RecursionLimit => return "semantic analysis recursion limit reached";
        case SemaDiagnosticCode.TypeMismatch => return "type mismatch";
        case SemaDiagnosticCode.InvalidType => return "invalid type";
        case SemaDiagnosticCode.InvalidPatternBindings => return "alternative patterns introduce incompatible bindings";
        case SemaDiagnosticCode.ReferenceEscape => return "reference lifetime cannot be verified";
        case SemaDiagnosticCode.BorrowConflict => return "conflicting reference borrow";
        case SemaDiagnosticCode.BorrowedMutation => return "access conflicts with a live reference";
        case SemaDiagnosticCode.MoveBorrowed => return "cannot move a borrowed or unsupported value";
        case SemaDiagnosticCode.UseAfterMove => return "use of moved value";
        case SemaDiagnosticCode.CannotInfer => return "type cannot be inferred";
        case SemaDiagnosticCode.UnsafeRequired => return "unsafe context required";
        case SemaDiagnosticCode.InvalidAsm => return "invalid assembly block";
        case SemaDiagnosticCode.FfiAbi => return "unsupported foreign ABI or calling convention";
        case SemaDiagnosticCode.FfiType => return "type is unsupported in this foreign signature";
        else => return "semantic analysis error";
    }
}

proc native_pipeline_sema_type_name_depth(
    sema: *const Sema,
    type_id: SemaTypeId,
    depth: usize
) -> string {
    if sema == null or type_id == 0 or type_id > (*sema).type_count as SemaTypeId {
        return "unknown";
    }
    let type_ = &(*sema).types[(type_id - 1) as usize];
    if depth >= 16 {
        return vitte_sema_type_kind_name((*type_).kind);
    }
    if (*type_).kind == SemaTypeKind.Reference {
        let element_name = native_pipeline_sema_type_name_depth(
            sema,
            (*type_).element_type,
            depth + 1
        );
        if (*type_).is_mutable { return "&mut " + element_name; }
        return "&" + element_name;
    }
    if (*type_).kind == SemaTypeKind.Pointer {
        let element_name = native_pipeline_sema_type_name_depth(
            sema,
            (*type_).element_type,
            depth + 1
        );
        if (*type_).is_mutable { return "*mut " + element_name; }
        return "*const " + element_name;
    }
    if (*type_).kind == SemaTypeKind.Optional {
        return "?" + native_pipeline_sema_type_name_depth(sema, (*type_).element_type, depth + 1);
    }
    if (*type_).kind == SemaTypeKind.Array {
        return "[" + native_pipeline_sema_type_name_depth(sema, (*type_).element_type, depth + 1) +
            "; " + native_pipeline_size_to_string((*type_).array_length) + "]";
    }
    if (*type_).kind == SemaTypeKind.Slice {
        return "slice[" + native_pipeline_sema_type_name_depth(sema, (*type_).element_type, depth + 1) + "]";
    }
    if (*type_).kind == SemaTypeKind.Range {
        return "Range[" + native_pipeline_sema_type_name_depth(sema, (*type_).element_type, depth + 1) + "]";
    }
    if (*type_).kind == SemaTypeKind.Task {
        return "Task[" + native_pipeline_sema_type_name_depth(sema, (*type_).element_type, depth + 1) + "]";
    }
    if (*type_).kind == SemaTypeKind.Function {
        let mut result: string = "proc(";
        let mut index: usize = 0;
        while index < (*type_).function_parameter_count {
            if index != 0 { set result += ", "; }
            if (*type_).function_parameter_types != null {
                set result += native_pipeline_sema_type_name_depth(
                    sema, (*type_).function_parameter_types[index], depth + 1);
            } else {
                set result += "unknown";
            }
            set index += 1;
        }
        set result += ") -> " + native_pipeline_sema_type_name_depth(
            sema, (*type_).return_type, depth + 1);
        return result;
    }
    if (*type_).kind == SemaTypeKind.Named or
       (*type_).kind == SemaTypeKind.GenericParameter or
       (*type_).kind == SemaTypeKind.Dyn {
        let symbol = if (*type_).symbol_id == 0 { null } else {
            vitte_scope_get_symbol((&((*sema).scopes)) as *const Scope, (*type_).symbol_id)
        };
        let mut result: string = if symbol != null and (*symbol).name != null {
            string.from_bytes((*symbol).name as *mut u8, (*symbol).name_length)
        } else {
            vitte_sema_type_kind_name((*type_).kind)
        };
        if (*type_).kind == SemaTypeKind.Dyn { set result = "dyn " + result; }
        if (*type_).generic_argument_count != 0 and (*type_).generic_arguments != null {
            set result += "[";
            let mut index: usize = 0;
            while index < (*type_).generic_argument_count {
                if index != 0 { set result += ", "; }
                set result += native_pipeline_sema_type_name_depth(
                    sema, (*type_).generic_arguments[index], depth + 1);
                set index += 1;
            }
            set result += "]";
        }
        return result;
    }
    return vitte_sema_type_kind_name((*type_).kind);
}

proc native_pipeline_sema_type_name(sema: *const Sema, type_id: SemaTypeId) -> string {
    return native_pipeline_sema_type_name_depth(sema, type_id, 0);
}

proc native_pipeline_sema_has_type_context(code: SemaDiagnosticCode) -> bool {
    return code == SemaDiagnosticCode.TypeMismatch or
        code == SemaDiagnosticCode.InvalidRequiresClause or
        code == SemaDiagnosticCode.InvalidEnsuresClause or
        code == SemaDiagnosticCode.InvalidCast or
        code == SemaDiagnosticCode.NotAType or
        code == SemaDiagnosticCode.NotAValue or
        code == SemaDiagnosticCode.IncompleteType or
        code == SemaDiagnosticCode.RecursiveType or
        code == SemaDiagnosticCode.GenericBoundUnsatisfied or
        code == SemaDiagnosticCode.GenericArgumentCount or
        code == SemaDiagnosticCode.GenericArgumentKind or
        code == SemaDiagnosticCode.GenericInferenceConflict or
        code == SemaDiagnosticCode.TraitNotImplemented or
        code == SemaDiagnosticCode.AmbiguousImpl or
        code == SemaDiagnosticCode.ConflictingImpl or
        code == SemaDiagnosticCode.MissingTraitMember or
        code == SemaDiagnosticCode.InvalidTraitMember or
        code == SemaDiagnosticCode.InvalidImplTarget or
        code == SemaDiagnosticCode.InvalidWherePredicate or
        code == SemaDiagnosticCode.AmbiguousMethod or
        code == SemaDiagnosticCode.CannotInfer or
        code == SemaDiagnosticCode.InvalidArgumentType or
        code == SemaDiagnosticCode.ReturnTypeMismatch or
        code == SemaDiagnosticCode.InvalidUnaryOperand or
        code == SemaDiagnosticCode.InvalidBinaryOperands or
        code == SemaDiagnosticCode.InvalidIndexType or
        code == SemaDiagnosticCode.ConditionNotBool or
        code == SemaDiagnosticCode.NotCallable or
        code == SemaDiagnosticCode.NotIndexable or
        code == SemaDiagnosticCode.UnknownMember;
}

proc native_pipeline_sema_subject(source: str, span: ParserSpan) -> string {
    if not span.valid or span.begin > span.end or span.end > source.length or
       span.end - span.begin == 0 or span.end - span.begin > 128 {
        return "";
    }
    return source.slice(span.begin, span.end);
}

/// Join diagnostic fragments into one owned string. Chained `+` expressions
/// allocate an intermediate string for every operator, so diagnostic paths
/// use a single buffer and leave its ownership with the caller.
proc native_pipeline_message3(first: string, second: string, third: string) -> string {
    let length: usize = first.length + second.length + third.length;
    let output: *mut u8 = allocate(length + 1);
    if output == null { return ""; }
    let mut offset: usize = 0;
    copy(native_pipeline_add_bytes(output, offset), first.as_ptr() as *const u8, first.length);
    set offset = offset + first.length;
    copy(native_pipeline_add_bytes(output, offset), second.as_ptr() as *const u8, second.length);
    set offset = offset + second.length;
    copy(native_pipeline_add_bytes(output, offset), third.as_ptr() as *const u8, third.length);
    set offset = offset + third.length;
    set output[offset] = 0;
    let rendered: string = string.from_bytes(output, length);
    deallocate(output);
    return rendered;
}

proc native_pipeline_message5(
    first: string,
    second: string,
    third: string,
    fourth: string,
    fifth: string
) -> string {
    let length: usize = first.length + second.length + third.length + fourth.length + fifth.length;
    let output: *mut u8 = allocate(length + 1);
    if output == null { return ""; }
    let mut offset: usize = 0;
    copy(native_pipeline_add_bytes(output, offset), first.as_ptr() as *const u8, first.length);
    set offset = offset + first.length;
    copy(native_pipeline_add_bytes(output, offset), second.as_ptr() as *const u8, second.length);
    set offset = offset + second.length;
    copy(native_pipeline_add_bytes(output, offset), third.as_ptr() as *const u8, third.length);
    set offset = offset + third.length;
    copy(native_pipeline_add_bytes(output, offset), fourth.as_ptr() as *const u8, fourth.length);
    set offset = offset + fourth.length;
    copy(native_pipeline_add_bytes(output, offset), fifth.as_ptr() as *const u8, fifth.length);
    set offset = offset + fifth.length;
    set output[offset] = 0;
    let rendered: string = string.from_bytes(output, length);
    deallocate(output);
    return rendered;
}

proc native_pipeline_cstring(value: *const char) -> string {
    if value == null { return ""; }
    let value_bytes = value as *const u8;
    let mut length: usize = 0;
    while value_bytes[length] != 0 { set length += 1; }
    return string.from_bytes(value_bytes as *mut u8, length);
}

proc native_pipeline_c_string(value: string) -> *const char {
    return value.as_ptr() as *const char;
}

proc native_pipeline_size_to_string(value: usize) -> string {
    if value < 10 { return string.from_byte((48 + value) as u8); }
    return native_pipeline_size_to_string(value / 10) +
        string.from_byte((48 + (value % 10)) as u8);
}

proc native_pipeline_type_details(expected: string, found: string) -> string {
    if expected.length == 0 and found.length == 0 { return ""; }
    let both: bool = expected.length != 0 and found.length != 0;
    let prefix: string = if expected.length != 0 { "expected " } else { "found " };
    let suffix: string = if both { ", found " } else { "" };
    let first: string = if expected.length != 0 { expected } else { found };
    let length: usize = prefix.length + first.length +
        if both { suffix.length + found.length } else { 0 as usize };
    let output: *mut u8 = allocate(length + 1);
    if output == null { return ""; }

    let mut offset: usize = 0;
    copy(native_pipeline_add_bytes(output, offset), prefix.as_ptr() as *const u8, prefix.length);
    set offset = offset + prefix.length;
    copy(native_pipeline_add_bytes(output, offset), first.as_ptr() as *const u8, first.length);
    set offset = offset + first.length;
    if both {
        copy(native_pipeline_add_bytes(output, offset), suffix.as_ptr() as *const u8, suffix.length);
        set offset = offset + suffix.length;
        copy(native_pipeline_add_bytes(output, offset), found.as_ptr() as *const u8, found.length);
        set offset = offset + found.length;
    }
    set output[offset] = 0;
    let rendered: string = string.from_bytes(output, length);
    deallocate(output);
    return rendered;
}

proc native_pipeline_argument_context(
    argument_index: usize,
    parameter_name: *const char,
    parameter_name_length: usize
) -> string {
    let prefix: string = "argument ";
    let middle: string = " / parameter `";
    let mut digit_count: usize = 1;
    let display_index: usize = argument_index + 1;
    let mut remaining: usize = display_index;
    while remaining >= 10 {
        set remaining = remaining / 10;
        set digit_count = digit_count + 1;
    }
    let length: usize = prefix.length + digit_count + middle.length +
        parameter_name_length + 1;
    let output: *mut u8 = allocate(length + 1);
    if output == null { return ""; }

    let mut offset: usize = 0;
    copy(native_pipeline_add_bytes(output, offset), prefix.as_ptr() as *const u8, prefix.length);
    set offset = offset + prefix.length;
    let mut divisor: usize = 1;
    while display_index / divisor >= 10 {
        set divisor = divisor * 10;
    }
    set remaining = display_index;
    while divisor != 0 {
        set output[offset] = (48 + (remaining / divisor)) as u8;
        set offset = offset + 1;
        set remaining = remaining % divisor;
        set divisor = divisor / 10;
    }
    copy(native_pipeline_add_bytes(output, offset), middle.as_ptr() as *const u8, middle.length);
    set offset = offset + middle.length;
    copy(native_pipeline_add_bytes(output, offset), parameter_name as *const u8, parameter_name_length);
    set offset = offset + parameter_name_length;
    set output[offset] = '`' as u8;
    set offset = offset + 1;
    set output[offset] = 0;

    let rendered: string = string.from_bytes(output, length);
    deallocate(output);
    return rendered;
}

proc native_pipeline_u64_to_string(value: u64) -> string {
    if value < 10 { return string.from_byte((48 + value) as u8); }
    return native_pipeline_u64_to_string(value / 10) +
        string.from_byte((48 + (value % 10)) as u8);
}

/// Copy parser and semantic diagnostic fields through the scalar host adapter.
/// C allocates and fills its own renderer records; no Vitte diagnostic layout
/// crosses the ABI boundary.
proc native_pipeline_export_diagnostics(
    parser: *const Parser,
    sema: *const Sema,
    codegen_output: *const NativePipelineEmitResult,
    file_id: u64,
    source_name: *const char,
    source: str,
    output: *mut *mut u8,
    output_count: *mut usize
) -> bool {
    if output != null { set *output = null; }
    if output_count != null { set *output_count = 0; }
    if output == null or output_count == null { return true; }

    let mut parser_count: usize = 0 as usize;
    if parser != null { set parser_count = vitte_parser_diagnostic_count(parser); }
    let mut sema_count: usize = 0 as usize;
    if sema != null { set sema_count = vitte_sema_diagnostic_count(sema); }
    let codegen_count: usize = if codegen_output != null and not (*codegen_output).success { 1 as usize } else { 0 as usize };
    if parser_count > 18446744073709551615 - sema_count { return false; }
    let frontend_count = parser_count + sema_count;
    if frontend_count > 18446744073709551615 - codegen_count { return false; }
    let count = frontend_count + codegen_count;
    if count == 0 { return true; }
    if count > 16777216 { return false; }
    let diagnostics = vitte_cli_diagnostic_transport_create(count);
    if diagnostics == null { return false; }

    let mut index: usize = 0;
    while index < parser_count {
        let source_diagnostic = vitte_parser_diagnostic_at(parser, index);
        if source_diagnostic == null {
            vitte_cli_diagnostic_transport_destroy(diagnostics);
            return false;
        }
        let mut expected: *const char = null;
        let mut found: *const char = null;
        if (*source_diagnostic).expected != TokenKind.Invalid {
            set expected = vitte_token_kind_name((*source_diagnostic).expected).as_ptr() as *const char;
        }
        if (*source_diagnostic).found != TokenKind.Invalid {
            set found = if (*source_diagnostic).found == TokenKind.Eof {
                native_pipeline_c_string("end of file")
            } else {
                vitte_token_kind_name((*source_diagnostic).found).as_ptr() as *const char
            };
        }
        let span = (*source_diagnostic).span;
        let reserved_word_as_name = (*source_diagnostic).expected == TokenKind.Identifier and
            vitte_token_kind_is_keyword((*source_diagnostic).found);
        let parser_code = if reserved_word_as_name {
            "VITTE_PARSER_E_RESERVED_WORD_AS_NAME"
        } else {
            native_pipeline_parser_code((*source_diagnostic).error)
        };
        let parser_severity: CliDiagnosticSeverity = if parser_code == "VITTE_INFRA_E_INTERNAL" or
           parser_code == "VITTE_INFRA_E_INVARIANT" or parser_code == "VITTE_INFRA_E_RESOURCE" {
            CliDiagnosticSeverity.Fatal
        } else {
            native_pipeline_parser_severity((*source_diagnostic).kind)
        };
        let mut parser_message = native_pipeline_parser_message((*source_diagnostic).error);
        let mut parser_help: string = "";
        let mut parser_details: string = "";
        let mut related_begin: usize = 0;
        let mut related_end: usize = 0;
        let mut related_start_line: usize = 0;
        let mut related_start_column: usize = 0;
        let mut related_end_line: usize = 0;
        let mut related_end_column: usize = 0;
        let mut related_label: string = "";
        let mut has_related = native_pipeline_parser_delimiter_related(
            parser, source_diagnostic, file_id, source,
            &mut related_begin, &mut related_end,
            &mut related_start_line, &mut related_start_column,
            &mut related_end_line, &mut related_end_column,
            &mut related_label
        );
        if not has_related and (*source_diagnostic).error == ParserError.DuplicatePickVariant {
            set has_related = native_pipeline_parser_duplicate_pick_variant_related(
                parser, source_diagnostic, file_id, source,
                &mut related_begin, &mut related_end,
                &mut related_start_line, &mut related_start_column,
                &mut related_end_line, &mut related_end_column
            );
            if has_related { set related_label = "first variant declared here"; }
        } elif not has_related {
            set has_related = native_pipeline_parser_duplicate_form_field_related(
                parser, source_diagnostic, file_id, source,
                &mut related_begin, &mut related_end,
                &mut related_start_line, &mut related_start_column,
                &mut related_end_line, &mut related_end_column
            );
            if has_related { set related_label = "first form field declared here"; }
        }
        native_pipeline_parser_advice(parser, source_diagnostic, &mut parser_message, &mut parser_help);
        if reserved_word_as_name {
            set parser_details = "reserved word `";
            set parser_details += source.slice(span.begin, span.end);
            set parser_details += "` cannot be used as a name";
        } elif (*source_diagnostic).expected != TokenKind.Invalid {
            set parser_details = "expected ";
            set parser_details += vitte_token_kind_name((*source_diagnostic).expected);
            if (*source_diagnostic).found != TokenKind.Invalid {
                set parser_details += ", found ";
                set parser_details += if (*source_diagnostic).found == TokenKind.Eof {
                    "end of file"
                } else {
                    vitte_token_kind_name((*source_diagnostic).found)
                };
            }
        } elif (*source_diagnostic).found != TokenKind.Invalid {
            set parser_details = "found ";
            set parser_details += if (*source_diagnostic).found == TokenKind.Eof {
                "end of file"
            } else {
                vitte_token_kind_name((*source_diagnostic).found)
            };
        }
        if not native_pipeline_export_cli_diagnostic(
            diagnostics,
            count,
            index,
            (index + 1) as u64,
            native_pipeline_c_string(parser_code),
            parser_severity,
            CliDiagnosticOrigin.Parser,
            native_pipeline_c_string(parser_message),
            if parser_details.length == 0 { null } else { native_pipeline_c_string(parser_details) },
            if parser_help.len() == 0 { null } else { native_pipeline_c_string(parser_help) },
            span.valid,
            span.file_id,
            file_id,
            source_name,
            span.begin,
            span.end,
            source,
            expected,
            found
        ) {
            vitte_cli_diagnostic_transport_destroy(diagnostics);
            return false;
        }
        if has_related and not vitte_cli_diagnostic_transport_set_semantic(
            diagnostics,
            count,
            index,
            null,
            null,
            null,
            true,
            file_id as u32,
            file_id,
            source_name,
            related_begin,
            related_end,
            related_start_line,
            related_start_column,
            related_end_line,
            related_end_column,
            native_pipeline_c_string(related_label)
        ) {
            vitte_cli_diagnostic_transport_destroy(diagnostics);
            return false;
        }
        set index += 1;
    }

    let mut sema_index: usize = 0;
    while sema_index < sema_count {
        let source_diagnostic = vitte_sema_diagnostic_at(sema, sema_index);
        if source_diagnostic == null {
            vitte_cli_diagnostic_transport_destroy(diagnostics);
            return false;
        }
        let span = (*source_diagnostic).span;
        let mut expected_type: string = "";
        let mut found_type: string = "";
        let mut details: string = "";
        if native_pipeline_sema_has_type_context((*source_diagnostic).code) {
            if (*source_diagnostic).expected_type != 0 {
                set expected_type = native_pipeline_sema_type_name(
                    sema,
                    (*source_diagnostic).expected_type
                );
            }
            if (*source_diagnostic).found_type != 0 {
                set found_type = native_pipeline_sema_type_name(
                    sema,
                    (*source_diagnostic).found_type
                );
            }
            if (*source_diagnostic).code == SemaDiagnosticCode.InvalidUnaryOperand and
               found_type.length != 0 {
                set details = native_pipeline_message3(
                    "operator does not support operand type ",
                    found_type,
                    ""
                );
            } elif (*source_diagnostic).code == SemaDiagnosticCode.InvalidBinaryOperands and
                   expected_type.length != 0 and found_type.length != 0 {
                set details = native_pipeline_message5(
                    "operator does not support operand types ",
                    expected_type,
                    " and ",
                    found_type,
                    ""
                );
            } else {
                set details = native_pipeline_type_details(expected_type, found_type);
            }
            if (*source_diagnostic).code == SemaDiagnosticCode.GenericBoundUnsatisfied and
               expected_type.len() != 0 and found_type.len() != 0 {
                set details = native_pipeline_message5(
                    "concrete type `",
                    found_type,
                    "` does not satisfy required bound `",
                    expected_type,
                    "`"
                );
            }
        }
        let origin: CliDiagnosticOrigin = if (*source_diagnostic).code == SemaDiagnosticCode.InvalidRequiresClause or
            (*source_diagnostic).code == SemaDiagnosticCode.InvalidEnsuresClause or
            (*source_diagnostic).code == SemaDiagnosticCode.OldValueUnavailable or
            (*source_diagnostic).code == SemaDiagnosticCode.ResultUnavailable {
            CliDiagnosticOrigin.Contract
        } elif (*source_diagnostic).code == SemaDiagnosticCode.ConstantNotConstant or
            (*source_diagnostic).code == SemaDiagnosticCode.ConstantOverflow or
            (*source_diagnostic).code == SemaDiagnosticCode.ConstantDivideByZero or
            (*source_diagnostic).code == SemaDiagnosticCode.ConstantRemainderByZero {
            CliDiagnosticOrigin.ConstantEval
        } elif (*source_diagnostic).code == SemaDiagnosticCode.UnresolvedName or
            (*source_diagnostic).code == SemaDiagnosticCode.AmbiguousName or
            (*source_diagnostic).code == SemaDiagnosticCode.PrivateSymbol or
            (*source_diagnostic).code == SemaDiagnosticCode.DuplicateDeclaration or
            (*source_diagnostic).code == SemaDiagnosticCode.DuplicateBinding or
            (*source_diagnostic).code == SemaDiagnosticCode.ShadowedDeclaration or
            (*source_diagnostic).code == SemaDiagnosticCode.InvalidScope or
            (*source_diagnostic).code == SemaDiagnosticCode.InvalidExport {
            CliDiagnosticOrigin.NameResolution
        } elif (*source_diagnostic).code == SemaDiagnosticCode.DuplicateImport {
            CliDiagnosticOrigin.Import
        } else {
            CliDiagnosticOrigin.TypeCheck
        };
        let mut message = native_pipeline_sema_message((*source_diagnostic).code);
        let mut message_owned = false;
        let mut subject: string = "";
        let mut subject_owned = false;
        if (*source_diagnostic).code == SemaDiagnosticCode.UnresolvedName or
            (*source_diagnostic).code == SemaDiagnosticCode.AmbiguousName or
            (*source_diagnostic).code == SemaDiagnosticCode.DuplicateImport or
            (*source_diagnostic).code == SemaDiagnosticCode.PrivateSymbol or
            (*source_diagnostic).code == SemaDiagnosticCode.DuplicateDeclaration or
            (*source_diagnostic).code == SemaDiagnosticCode.DuplicateBinding or
            (*source_diagnostic).code == SemaDiagnosticCode.InvalidExport or
            (*source_diagnostic).code == SemaDiagnosticCode.ShadowedDeclaration or
            (*source_diagnostic).code == SemaDiagnosticCode.UnknownType or
            (*source_diagnostic).code == SemaDiagnosticCode.UnknownMember {
            set subject = native_pipeline_sema_subject(source, span);
            set subject_owned = subject.length != 0;
        }
        if subject.len() != 0 {
            if (*source_diagnostic).code == SemaDiagnosticCode.UnresolvedName {
                set message = native_pipeline_message3("unknown symbol `", subject, "`");
                set message_owned = true;
            } elif (*source_diagnostic).code == SemaDiagnosticCode.PrivateSymbol {
                set message = native_pipeline_message3("symbol `", subject, "` is not visible here");
                set message_owned = true;
            } elif (*source_diagnostic).code == SemaDiagnosticCode.DuplicateDeclaration {
                set message = native_pipeline_message3("duplicate declaration of `", subject, "`");
                set message_owned = true;
            } elif (*source_diagnostic).code == SemaDiagnosticCode.DuplicateBinding {
                set message = native_pipeline_message3("duplicate binding of `", subject, "`");
                set message_owned = true;
            } elif (*source_diagnostic).code == SemaDiagnosticCode.InvalidExport {
                set message = native_pipeline_message3("invalid export target `", subject, "`");
                set message_owned = true;
            } elif (*source_diagnostic).code == SemaDiagnosticCode.ShadowedDeclaration {
                set message = native_pipeline_message3("declaration of `", subject, "` shadows an existing name");
                set message_owned = true;
            } elif (*source_diagnostic).code == SemaDiagnosticCode.UnknownType {
                set message = native_pipeline_message3("unknown type `", subject, "`");
                set message_owned = true;
            } elif (*source_diagnostic).code == SemaDiagnosticCode.UnknownMember {
                if found_type.len() != 0 {
                    set message = native_pipeline_message5("type `", found_type, "` has no member `", subject, "`");
                } else {
                    set message = native_pipeline_message3("unknown member `", subject, "`");
                }
                set message_owned = true;
            }
        }
        if (*source_diagnostic).code == SemaDiagnosticCode.InvalidRequiresClause and found_type.len() != 0 {
            set message = native_pipeline_message3(
                "requires clause has type `",
                found_type,
                "`; expected `bool`"
            );
            set message_owned = true;
        } elif (*source_diagnostic).code == SemaDiagnosticCode.InvalidEnsuresClause and found_type.len() != 0 {
            set message = native_pipeline_message3(
                "ensures clause has type `",
                found_type,
                "`; expected `bool`"
            );
            set message_owned = true;
        } elif (*source_diagnostic).code == SemaDiagnosticCode.NotCallable and found_type.len() != 0 {
            set message = native_pipeline_message3("value of type `", found_type, "` is not callable");
            set message_owned = true;
        } elif (*source_diagnostic).code == SemaDiagnosticCode.NotIndexable and found_type.len() != 0 {
            set message = native_pipeline_message3("value of type `", found_type, "` cannot be indexed");
            set message_owned = true;
        } elif (*source_diagnostic).code == SemaDiagnosticCode.ConditionNotBool and found_type.len() != 0 {
            set message = native_pipeline_message3("condition has type `", found_type, "`; expected `bool`");
            set message_owned = true;
        }
        let exported = native_pipeline_export_cli_diagnostic(
            diagnostics,
            count,
            parser_count + sema_index,
            (parser_count + sema_index + 1) as u64,
            native_pipeline_c_string(native_pipeline_sema_code((*source_diagnostic).code)),
            native_pipeline_sema_severity((*source_diagnostic).kind),
            origin,
            native_pipeline_c_string(message),
            if details.len() == 0 { null } else { details.as_ptr() as *const char },
            (&(*source_diagnostic).help[0]) as *const char,
            span.valid,
            span.file_id,
            file_id,
            source_name,
            span.begin,
            span.end,
            source,
            if expected_type.len() == 0 { null } else { expected_type.as_ptr() as *const char },
            if found_type.len() == 0 { null } else { found_type.as_ptr() as *const char }
        );
        if details.length != 0 {
            deallocate(details.as_ptr() as *mut u8);
        }
        if subject_owned {
            deallocate(subject.as_ptr() as *mut u8);
        }
        if message_owned and message.length != 0 {
            deallocate(message.as_ptr() as *mut u8);
        }
        if not exported {
            vitte_cli_diagnostic_transport_destroy(diagnostics);
            return false;
        }
        let mut symbol: *const char = null;
        let mut probable_cause: *const char = null;
        let mut context_text: string = "";
        let mut context_text_owned = false;
        let mut has_related = false;
        let mut related_file_id: u32 = 0;
        let mut related_source_id: u64 = 0;
        let mut related_start_offset: usize = 0;
        let mut related_end_offset: usize = 0;
        let mut related_start_line: usize = 0;
        let mut related_start_column: usize = 0;
        let mut related_end_line: usize = 0;
        let mut related_end_column: usize = 0;
        let mut related_label: *const char = null;
        if (*source_diagnostic).code == SemaDiagnosticCode.PrivateSymbol or
           (*source_diagnostic).code == SemaDiagnosticCode.AmbiguousName or
           (*source_diagnostic).code == SemaDiagnosticCode.DuplicateImport or
           (*source_diagnostic).code == SemaDiagnosticCode.DuplicateDeclaration or
           (*source_diagnostic).code == SemaDiagnosticCode.DuplicateBinding or
           (*source_diagnostic).code == SemaDiagnosticCode.InvalidExport or
           (*source_diagnostic).code == SemaDiagnosticCode.NotAType or
           (*source_diagnostic).code == SemaDiagnosticCode.NotAValue or
           (*source_diagnostic).code == SemaDiagnosticCode.CannotInfer or
           (*source_diagnostic).code == SemaDiagnosticCode.ShadowedDeclaration or
           (*source_diagnostic).code == SemaDiagnosticCode.ReferenceEscape or
           (*source_diagnostic).code == SemaDiagnosticCode.BorrowConflict or
           (*source_diagnostic).code == SemaDiagnosticCode.BorrowedMutation or
           (*source_diagnostic).code == SemaDiagnosticCode.MoveBorrowed or
           (*source_diagnostic).code == SemaDiagnosticCode.UseAfterMove {
            let diagnostic_symbol: *const Symbol = if (*source_diagnostic).symbol_id == 0 {
                null
            } else {
                vitte_scope_get_symbol((&((*sema).scopes)) as *const Scope, (*source_diagnostic).symbol_id)
            };
            if diagnostic_symbol != null {
                set symbol = (*diagnostic_symbol).name as *const char;
            }
            let related_symbol_id = if (*source_diagnostic).code == SemaDiagnosticCode.ShadowedDeclaration and
                diagnostic_symbol != null and (*diagnostic_symbol).shadowed_symbol != 0 {
                (*diagnostic_symbol).shadowed_symbol
            } else {
                (*source_diagnostic).symbol_id
            };
            let declaration_symbol: *const Symbol = if related_symbol_id == 0 {
                null
            } else {
                vitte_scope_get_symbol((&((*sema).scopes)) as *const Scope, related_symbol_id)
            };
            if declaration_symbol != null {
                let declaration_span = (*declaration_symbol).span;
                if declaration_span.valid and declaration_span.file_id == span.file_id and
                   declaration_span.end >= declaration_span.begin {
                    let mut scanner: Scanner;
                    if vitte_scanner_init(&mut scanner, source, source.length, declaration_span.file_id) {
                        let _ = vitte_scanner_set_strict_utf8(&mut scanner, false);
                        let mut related_start: ScannerPosition;
                        let mut related_end: ScannerPosition;
                        if vitte_scanner_position_at(&mut scanner, declaration_span.begin, &mut related_start) and
                           vitte_scanner_position_at(&mut scanner, declaration_span.end, &mut related_end) {
                            set has_related = true;
                            set related_file_id = declaration_span.file_id;
                            set related_source_id = file_id;
                            set related_start_offset = declaration_span.begin;
                            set related_end_offset = declaration_span.end;
                            set related_start_line = related_start.line - 1;
                            set related_start_column = related_start.column - 1;
                            set related_end_line = related_end.line - 1;
                            set related_end_column = related_end.column - 1;
                            match (*source_diagnostic).code {
                                case SemaDiagnosticCode.DuplicateDeclaration => {
                                    set related_label = native_pipeline_c_string("previous declaration is here");
                                },
                                case SemaDiagnosticCode.DuplicateBinding => {
                                    set related_label = native_pipeline_c_string("previous binding is here");
                                },
                                case SemaDiagnosticCode.InvalidExport => {
                                    if (*declaration_symbol).kind == SymbolKind.Space {
                                        set related_label = native_pipeline_c_string("imported module is bound here");
                                    } else {
                                        set related_label = native_pipeline_c_string("imported declaration originates here");
                                    }
                                },
                                case SemaDiagnosticCode.AmbiguousName => {
                                    set related_label = native_pipeline_c_string("other imported candidate is declared here");
                                },
                                case SemaDiagnosticCode.DuplicateImport => {
                                    set related_label = native_pipeline_c_string("earlier identical import is here");
                                },
                                case SemaDiagnosticCode.ShadowedDeclaration => {
                                    set related_label = native_pipeline_c_string("earlier shadowed declaration is here");
                                },
                                case SemaDiagnosticCode.BorrowConflict => {
                                    set related_label = native_pipeline_c_string("conflicting borrow belongs to this value");
                                },
                                case SemaDiagnosticCode.BorrowedMutation => {
                                    set related_label = native_pipeline_c_string("active borrow belongs to this value");
                                },
                                case SemaDiagnosticCode.MoveBorrowed => {
                                    set related_label = native_pipeline_c_string("borrowed value is declared here");
                                },
                                case SemaDiagnosticCode.UseAfterMove => {
                                    set related_label = native_pipeline_c_string("moved value is declared here");
                                },
                                case SemaDiagnosticCode.CannotInfer => {
                                    set related_label = native_pipeline_c_string("generic procedure declared here");
                                },
                                case SemaDiagnosticCode.ReferenceEscape => {
                                    set related_label = native_pipeline_c_string("referenced value is declared here");
                                },
                                else => {
                                    set related_label = native_pipeline_c_string("declaration is here");
                                }
                            }
                        }
                        vitte_scanner_destroy(&mut scanner);
                    }
                }
            }
        }
        if (*source_diagnostic).type_context == SemaTypeContextKind.Argument {
            probable_cause = native_pipeline_c_string("the argument does not satisfy the parameter type");
            let context_symbol: *const Symbol = if (*source_diagnostic).context_symbol_id == 0 {
                null
            } else {
                vitte_scope_get_symbol((&((*sema).scopes)) as *const Scope, (*source_diagnostic).context_symbol_id)
            };
            if context_symbol != null {
                symbol = (*context_symbol).name as *const char;
                set context_text = native_pipeline_argument_context(
                    (*source_diagnostic).context_index,
                    (*context_symbol).name as *const char,
                    (*context_symbol).name_length
                );
                set context_text_owned = true;
                let declaration_span = (*context_symbol).span;
                if declaration_span.valid and declaration_span.end >= declaration_span.begin {
                    let mut scanner: Scanner;
                    if vitte_scanner_init(&mut scanner, source, source.length, declaration_span.file_id) {
                        let _ = vitte_scanner_set_strict_utf8(&mut scanner, false);
                        let mut related_start: ScannerPosition;
                        let mut related_end: ScannerPosition;
                        if vitte_scanner_position_at(&mut scanner, declaration_span.begin, &mut related_start) and
                           vitte_scanner_position_at(&mut scanner, declaration_span.end, &mut related_end) {
                            set has_related = true;
                            set related_file_id = declaration_span.file_id;
                            set related_source_id = file_id;
                            set related_start_offset = declaration_span.begin;
                            set related_end_offset = declaration_span.end;
                            set related_start_line = related_start.line - 1;
                            set related_start_column = related_start.column - 1;
                            set related_end_line = related_end.line - 1;
                            set related_end_column = related_end.column - 1;
                            set related_label = native_pipeline_c_string("parameter declared here");
                        }
                        vitte_scanner_destroy(&mut scanner);
                    }
                }
            }
        } elif (*source_diagnostic).type_context == SemaTypeContextKind.Return {
            probable_cause = native_pipeline_c_string("the returned value does not satisfy the declared return type");
            set context_text = "return value / declared return type";
        } elif (*source_diagnostic).type_context == SemaTypeContextKind.Assignment {
            probable_cause = if (*source_diagnostic).code == SemaDiagnosticCode.NotAssignable {
                native_pipeline_c_string("the assignment target is immutable or not assignable")
            } else {
                native_pipeline_c_string("the assigned value does not satisfy the target type")
            };
            set context_text = "assignment / mutable binding";
            let assignment_symbol: *const Symbol = if (*source_diagnostic).context_symbol_id == 0 {
                null
            } else {
                vitte_scope_get_symbol(
                    (&((*sema).scopes)) as *const Scope,
                    (*source_diagnostic).context_symbol_id
                )
            };
            if assignment_symbol != null {
                set symbol = (*assignment_symbol).name as *const char;
                let declaration_span = (*assignment_symbol).span;
                if declaration_span.valid and declaration_span.end >= declaration_span.begin {
                    let mut scanner: Scanner;
                    if vitte_scanner_init(&mut scanner, source, source.length, declaration_span.file_id) {
                        let _ = vitte_scanner_set_strict_utf8(&mut scanner, false);
                        let mut related_start: ScannerPosition;
                        let mut related_end: ScannerPosition;
                        if vitte_scanner_position_at(&mut scanner, declaration_span.begin, &mut related_start) and
                           vitte_scanner_position_at(&mut scanner, declaration_span.end, &mut related_end) {
                            set has_related = true;
                            set related_file_id = declaration_span.file_id;
                            set related_source_id = file_id;
                            set related_start_offset = declaration_span.begin;
                            set related_end_offset = declaration_span.end;
                            set related_start_line = related_start.line - 1;
                            set related_start_column = related_start.column - 1;
                            set related_end_line = related_end.line - 1;
                            set related_end_column = related_end.column - 1;
                            set related_label = native_pipeline_c_string("binding declared here; make it mutable");
                        }
                        vitte_scanner_destroy(&mut scanner);
                    }
                }
            }
        } elif (*source_diagnostic).type_context == SemaTypeContextKind.Field {
            probable_cause = native_pipeline_c_string("the field value does not satisfy the declared field type");
            let field_declaration: *const ASTNode = vitte_parser_get_node(
                (*sema).parser,
                (*source_diagnostic).context_index as ASTNodeId
            );
            if field_declaration != null {
                if (*field_declaration).child_count != 0 and (*field_declaration).children != null {
                    let field_name_node: *const ASTNode = vitte_parser_get_node(
                        (*sema).parser,
                        (*field_declaration).children[0]
                    );
                    let field_name_token: *const ParserToken = vitte_parser_node_token(
                        (*sema).parser,
                        field_name_node
                    );
                    if field_name_token != null {
                        let field_name: string = string.from_bytes(
                            (*field_name_token).lexeme,
                            (*field_name_token).length
                        );
                        set symbol = (*field_name_token).lexeme.as_ptr() as *const char;
                        set context_text = native_pipeline_message3(
                            "field `",
                            field_name,
                            "` / value"
                        );
                        deallocate(field_name.as_ptr() as *mut u8);
                        set context_text_owned = true;
                    }
                }
                let declaration_span = (*field_declaration).span;
                if declaration_span.valid and declaration_span.end >= declaration_span.begin {
                    let mut scanner: Scanner;
                    if vitte_scanner_init(&mut scanner, source, source.length, declaration_span.file_id) {
                        let _ = vitte_scanner_set_strict_utf8(&mut scanner, false);
                        let mut related_start: ScannerPosition;
                        let mut related_end: ScannerPosition;
                        if vitte_scanner_position_at(&mut scanner, declaration_span.begin, &mut related_start) and
                           vitte_scanner_position_at(&mut scanner, declaration_span.end, &mut related_end) {
                            set has_related = true;
                            set related_file_id = declaration_span.file_id;
                            set related_source_id = file_id;
                            set related_start_offset = declaration_span.begin;
                            set related_end_offset = declaration_span.end;
                            set related_start_line = related_start.line - 1;
                            set related_start_column = related_start.column - 1;
                            set related_end_line = related_end.line - 1;
                            set related_end_column = related_end.column - 1;
                            set related_label = native_pipeline_c_string("field declared here");
                        }
                        vitte_scanner_destroy(&mut scanner);
                    }
                }
            }
        } elif (*source_diagnostic).type_context == SemaTypeContextKind.Condition {
            probable_cause = native_pipeline_c_string("the condition must evaluate to a boolean value");
            set context_text = "condition / expected `bool`";
        } elif (*source_diagnostic).type_context == SemaTypeContextKind.Cast {
            probable_cause = native_pipeline_c_string("the source type cannot be converted to the requested target type");
            set context_text = "cast expression / source and target types";
        } elif (*source_diagnostic).type_context == SemaTypeContextKind.Operands {
            probable_cause = native_pipeline_c_string("the operator does not support these operand types");
            set context_text = "operator operands";
        } elif (*source_diagnostic).type_context == SemaTypeContextKind.Call {
            probable_cause = native_pipeline_c_string("the call target does not have a callable type");
            set context_text = "call target / callable type";
        } elif (*source_diagnostic).type_context == SemaTypeContextKind.Index {
            probable_cause = if (*source_diagnostic).code == SemaDiagnosticCode.InvalidIndexType {
                native_pipeline_c_string("the index must have an integer type")
            } else {
                native_pipeline_c_string("the indexed value does not support indexing")
            };
            set context_text = "indexed value / index expression";
        } elif (*source_diagnostic).type_context == SemaTypeContextKind.Member {
            probable_cause = native_pipeline_c_string("the receiver type does not define this member");
            set context_text = "member access / receiver type";
        } elif (*source_diagnostic).type_context == SemaTypeContextKind.Type {
            probable_cause = if (*source_diagnostic).code == SemaDiagnosticCode.IncompleteType {
                native_pipeline_c_string("this operation requires a complete type definition")
            } elif (*source_diagnostic).code == SemaDiagnosticCode.RecursiveType {
                native_pipeline_c_string("the type alias expansion contains a recursive cycle")
            } else {
                native_pipeline_c_string("the name resolves to a value, which cannot be used as a type")
            };
            set context_text = if (*source_diagnostic).code == SemaDiagnosticCode.IncompleteType or
                (*source_diagnostic).code == SemaDiagnosticCode.RecursiveType {
                "type use / originating type declaration"
            } else {
                "type expression / resolved name"
            };
        } elif (*source_diagnostic).type_context == SemaTypeContextKind.Value {
            probable_cause = native_pipeline_c_string("the name resolves to a type, which cannot be evaluated as a value");
            set context_text = "value expression / type name";
        } elif (*source_diagnostic).type_context == SemaTypeContextKind.Inference {
            probable_cause = native_pipeline_c_string("available information does not determine a unique type");
            set context_text = "type inference / unresolved expression or binding";
        } elif (*source_diagnostic).type_context == SemaTypeContextKind.Bound {
            probable_cause = if (*source_diagnostic).code == SemaDiagnosticCode.InvalidWherePredicate {
                native_pipeline_c_string("the predicate does not refer to a declared type parameter and a valid trait bound")
            } else {
                native_pipeline_c_string("the concrete type does not implement the required trait bound")
            };
            set context_text = if (*source_diagnostic).code == SemaDiagnosticCode.InvalidWherePredicate {
                "where predicate / generic declaration"
            } else {
                "concrete type / required trait bound"
            };
        } elif (*source_diagnostic).type_context == SemaTypeContextKind.GenericArgument {
            probable_cause = if (*source_diagnostic).code == SemaDiagnosticCode.GenericInferenceConflict {
                native_pipeline_c_string("two arguments require incompatible substitutions for one generic parameter")
            } else {
                native_pipeline_c_string("generic arguments must match the declared parameter count, kinds and order")
            };
            set context_text = if (*source_diagnostic).code == SemaDiagnosticCode.GenericInferenceConflict {
                "conflicting arguments / inferred generic parameter"
            } else {
                "generic arguments / declaration parameters"
            };
        } elif (*source_diagnostic).type_context == SemaTypeContextKind.TraitMember {
            probable_cause = if (*source_diagnostic).code == SemaDiagnosticCode.MissingTraitMember {
                native_pipeline_c_string("the trait declares a required member with no default implementation")
            } elif (*source_diagnostic).code == SemaDiagnosticCode.AmbiguousMethod {
                native_pipeline_c_string("more than one visible implementation supplies this method")
            } elif (*source_diagnostic).code == SemaDiagnosticCode.AmbiguousImpl {
                native_pipeline_c_string("more than one implementation satisfies this trait relation")
            } elif (*source_diagnostic).code == SemaDiagnosticCode.ConflictingImpl {
                native_pipeline_c_string("this implementation overlaps an existing implementation")
            } elif (*source_diagnostic).code == SemaDiagnosticCode.TraitNotImplemented {
                native_pipeline_c_string("the concrete type has no implementation of the required trait")
            } elif (*source_diagnostic).code == SemaDiagnosticCode.InvalidImplTarget {
                native_pipeline_c_string("the impl header does not name a trait and target type in a supported form")
            } else {
                native_pipeline_c_string("the implementation member does not satisfy the trait declaration")
            };
            set context_text = "trait / implementation candidate";
        } elif (*source_diagnostic).type_context == SemaTypeContextKind.Expression {
            probable_cause = native_pipeline_c_string("the expression's actual type does not satisfy the expected type");
            set context_text = "expression / expected type";
        } elif (*source_diagnostic).code == SemaDiagnosticCode.UnresolvedName {
            probable_cause = native_pipeline_c_string("no declaration with this name is visible in the current scope");
            set context_text = "name resolution / visible declarations";
        } elif (*source_diagnostic).code == SemaDiagnosticCode.PrivateSymbol {
            probable_cause = native_pipeline_c_string("the declaration exists but is private to another module");
            set context_text = "visibility / module boundary";
        } elif (*source_diagnostic).code == SemaDiagnosticCode.DuplicateDeclaration {
            probable_cause = native_pipeline_c_string("another declaration with this name already exists in this scope");
            set context_text = "declaration / current scope";
        } elif (*source_diagnostic).code == SemaDiagnosticCode.DuplicateBinding {
            probable_cause = native_pipeline_c_string("another binding with this name already exists in this scope");
            set context_text = "binding / current scope";
        } elif (*source_diagnostic).code == SemaDiagnosticCode.InvalidExport {
            probable_cause = native_pipeline_c_string("the export target is missing or comes from an imported module");
            set context_text = "export / defining module";
        } elif (*source_diagnostic).code == SemaDiagnosticCode.NotCallable {
            probable_cause = native_pipeline_c_string("the expression does not have a procedure or callable type");
            set context_text = "call target / callable type";
        } elif (*source_diagnostic).code == SemaDiagnosticCode.NotIndexable {
            probable_cause = native_pipeline_c_string("the value's type does not provide indexing");
            set context_text = "indexed value / index operation";
        } elif (*source_diagnostic).code == SemaDiagnosticCode.InvalidIndexType {
            probable_cause = native_pipeline_c_string("the index expression must use an unsigned integer type");
            set context_text = "index expression / expected `u64`";
        } elif (*source_diagnostic).code == SemaDiagnosticCode.UnknownMember {
            probable_cause = native_pipeline_c_string("the requested field or member is not defined for this type");
            set context_text = "member lookup / receiver type";
        } elif (*source_diagnostic).code == SemaDiagnosticCode.UnknownType {
            probable_cause = native_pipeline_c_string("no visible type declaration has this name");
            set context_text = "type lookup / visible declarations";
        }
        if (*source_diagnostic).related_span.valid and
           (*source_diagnostic).related_span.file_id == file_id and
           (*source_diagnostic).related_span.end >= (*source_diagnostic).related_span.begin and
           (*source_diagnostic).related_span.end <= source.length {
            let mut scanner: Scanner;
            if vitte_scanner_init(
                &mut scanner,
                source,
                source.length,
                (*source_diagnostic).related_span.file_id
            ) {
                let _ = vitte_scanner_set_strict_utf8(&mut scanner, false);
                let mut related_start: ScannerPosition;
                let mut related_end: ScannerPosition;
                if vitte_scanner_position_at(
                       &mut scanner,
                       (*source_diagnostic).related_span.begin,
                       &mut related_start
                   ) and
                   vitte_scanner_position_at(
                       &mut scanner,
                       (*source_diagnostic).related_span.end,
                       &mut related_end
                   ) {
                    set has_related = true;
                    set related_file_id = (*source_diagnostic).related_span.file_id;
                    set related_source_id = file_id;
                    set related_start_offset = (*source_diagnostic).related_span.begin;
                    set related_end_offset = (*source_diagnostic).related_span.end;
                    set related_start_line = related_start.line - 1;
                    set related_start_column = related_start.column - 1;
                    set related_end_line = related_end.line - 1;
                    set related_end_column = related_end.column - 1;
                    set related_label = (&(*source_diagnostic).related_label[0]) as *const char;
                }
                vitte_scanner_destroy(&mut scanner);
            }
        }
        let semantic_exported = vitte_cli_diagnostic_transport_set_semantic(
            diagnostics,
            count,
            parser_count + sema_index,
            symbol,
            probable_cause,
            if context_text.len() == 0 { null } else { native_pipeline_c_string(context_text) },
            has_related,
            related_file_id,
            related_source_id,
            source_name,
            related_start_offset,
            related_end_offset,
            related_start_line,
            related_start_column,
            related_end_line,
            related_end_column,
            related_label
        );
        if context_text_owned and context_text.length != 0 {
            deallocate(context_text.as_ptr() as *mut u8);
        }
        if not semantic_exported {
            vitte_cli_diagnostic_transport_destroy(diagnostics);
            return false;
        }
        set sema_index += 1;
    }

    if codegen_count != 0 {
        let diagnostic_code = native_pipeline_cstring((*codegen_output).diagnostic_code);
        let severity: CliDiagnosticSeverity = if diagnostic_code == "VITTE_IR_E_VERIFY" or
           diagnostic_code == "VITTE_IR_E_INVALID" or diagnostic_code == "VITTE_HIR_E_INVALID" or
           diagnostic_code == "VITTE_INFRA_E_INTERNAL" or diagnostic_code == "VITTE_INFRA_E_INVARIANT" or
           diagnostic_code == "VITTE_INFRA_E_RESOURCE" {
            CliDiagnosticSeverity.Fatal
        } else {
            CliDiagnosticSeverity.Error
        };
        let mut codegen_message: string = if (*codegen_output).diagnostic_origin == CliDiagnosticOrigin.Ir {
            (*codegen_output).error
        } elif (*codegen_output).diagnostic_origin == CliDiagnosticOrigin.Hir {
            (*codegen_output).error
        } elif (*codegen_output).diagnostic_origin == CliDiagnosticOrigin.Internal {
            (*codegen_output).error
        } elif diagnostic_code == "VITTE_BACKEND_E_UNSUPPORTED" {
            "C17 backend does not support this source construct"
        } elif diagnostic_code == "VITTE_BACKEND_E_CONFIG" {
            "invalid C17 backend configuration"
        } elif (*codegen_output).has_source_span {
            "C17 code generation failed for this Vitte construct"
        } else {
            "C17 code generation failed"
        };
        let mut codegen_details: string = if (*codegen_output).diagnostic_origin == CliDiagnosticOrigin.Ir {
            ""
        } elif (*codegen_output).diagnostic_origin == CliDiagnosticOrigin.Hir {
            ""
        } elif (*codegen_output).diagnostic_origin == CliDiagnosticOrigin.Internal {
            ""
        } else {
            (*codegen_output).error
        };
        let mut codegen_has_span = false;
        let mut codegen_span_file_id: u32 = 0;
        let mut codegen_span_begin: usize = 0;
        let mut codegen_span_end: usize = 0;
        if (*codegen_output).has_source_span and
           (*codegen_output).source_span.valid and
           (*codegen_output).source_span.end >= (*codegen_output).source_span.begin and
           (*codegen_output).source_span.end <= source.length {
            set codegen_has_span = true;
            set codegen_span_file_id = (*codegen_output).source_span.file_id;
            set codegen_span_begin = (*codegen_output).source_span.begin;
            set codegen_span_end = (*codegen_output).source_span.end;
        }
        if parser != null and
           (*codegen_output).diagnostic_origin == CliDiagnosticOrigin.C17Backend and
           (*codegen_output).error == "macros must be expanded before C17 emission" {
            let mut node_index: usize = 0;
            while node_index < (*parser).node_count {
                let node = &(*parser).nodes[node_index];
                if (*node).kind == ASTNodeKind.MacroDecl {
                    codegen_message = "macro declarations cannot be emitted by the C17 backend";
                    codegen_details = "expand or remove the macro declaration before compiling with the C17 backend";
                    codegen_has_span = (*node).span.valid;
                    codegen_span_file_id = (*node).span.file_id;
                    codegen_span_begin = (*node).span.begin;
                    codegen_span_end = (*node).span.end;
                    break;
                }
                set node_index += 1;
            }
        }
        if not native_pipeline_export_cli_diagnostic(
            diagnostics,
            count,
            frontend_count,
            (frontend_count + 1) as u64,
            (*codegen_output).diagnostic_code,
            severity,
            (*codegen_output).diagnostic_origin,
            native_pipeline_c_string(codegen_message),
            if codegen_details.length == 0 { null } else { native_pipeline_c_string(codegen_details) },
            if (*codegen_output).help.length == 0 { null } else { native_pipeline_c_string((*codegen_output).help) },
            codegen_has_span,
            codegen_span_file_id,
            file_id,
            source_name,
            codegen_span_begin,
            codegen_span_end,
            source,
            null,
            null
        ) {
            vitte_cli_diagnostic_transport_destroy(diagnostics);
            return false;
        }
    }

    set *output = diagnostics;
    set *output_count = count;
    return true;
}

proc native_pipeline_lexer_hex_byte(byte: u8) -> string {
    let digits: string = "0123456789ABCDEF";
    return "\\x" + string.from_byte(digits[(byte >> 4) as usize] as u8) +
        string.from_byte(digits[(byte & 15) as usize] as u8);
}

proc native_pipeline_lexer_escape_byte(byte: u8, force_hex: bool) -> string {
    if byte == 92 { return "\\\\"; }
    if byte == 96 { return "\\`"; }
    if byte == 10 { return "\\n"; }
    if byte == 13 { return "\\r"; }
    if byte == 9 { return "\\t"; }
    if byte == 12 { return "\\f"; }
    if byte == 11 { return "\\v"; }
    if byte == 8 { return "\\b"; }
    if byte == 7 { return "\\a"; }
    if not force_hex and byte >= 32 and byte <= 126 {
        return string.from_byte(byte);
    }
    return native_pipeline_lexer_hex_byte(byte);
}

proc native_pipeline_lexer_escape_bytes(source: str, begin: usize, end: usize, force_hex: bool) -> string {
    let mut result: string = "";
    let mut index: usize = begin;
    while index < end {
        set result += native_pipeline_lexer_escape_byte(source[index] as u8, force_hex);
        set index += 1;
    }
    return result;
}

proc native_pipeline_unicode_encoding_context(error: UnicodeError) -> string {
    if error == UnicodeError.TruncatedUtf8 { return "truncated UTF-8 sequence"; }
    if error == UnicodeError.OverlongUtf8 { return "overlong UTF-8 encoding"; }
    if error == UnicodeError.Surrogate { return "UTF-8 sequence encodes a surrogate value"; }
    if error == UnicodeError.OutOfRange { return "UTF-8 sequence encodes a value above U+10FFFF"; }
    return "malformed UTF-8 sequence";
}

proc native_pipeline_u64_to_hex(value: u64) -> string {
    let digits: string = "0123456789ABCDEF";
    if value < 16 { return string.from_byte(digits[value as usize] as u8); }
    return native_pipeline_u64_to_hex(value / 16) +
        string.from_byte(digits[(value % 16) as usize] as u8);
}

proc native_pipeline_lexer_diagnostic_details(
    error: LexerError,
    source: str,
    begin: usize,
    end: usize
) -> string {
    if begin > end or end > source.length { return vitte_lexer_error_name(error); }
    if error == LexerError.InvalidUtf8 {
        let decoded = vitte_unicode_decode_utf8(source, begin, source.length);
        return native_pipeline_unicode_encoding_context(decoded.error) + " `" +
            native_pipeline_lexer_escape_bytes(source, begin, end, true) +
            "` at UTF-8 byte range [" + native_pipeline_u64_to_string(begin as u64) +
            ", " + native_pipeline_u64_to_string(end as u64) +
            "); UTF-8 must encode Unicode scalar values only";
    }
    if error == LexerError.InvalidIdentifier {
        let decoded = vitte_unicode_decode_utf8(source, begin, source.length);
        let mut hex = native_pipeline_u64_to_hex(decoded.codepoint);
        while hex.length < 4 { set hex = "0" + hex; }
        return "character U+" + hex +
            " is not allowed at identifier start; UTF-8 byte range [" +
            native_pipeline_u64_to_string(begin as u64) + ", " +
            native_pipeline_u64_to_string(end as u64) + ")";
    }
    if error == LexerError.InvalidCharacterLiteral {
        return "malformed character literal `" +
            native_pipeline_lexer_escape_bytes(source, begin, end, false) +
            "`; expected exactly one Unicode scalar value or one supported escape sequence at UTF-8 byte range [" +
            native_pipeline_u64_to_string(begin as u64) + ", " +
            native_pipeline_u64_to_string(end as u64) + ")";
    }
    if error == LexerError.InvalidInteger or error == LexerError.InvalidFloat or
       error == LexerError.InvalidNumericSeparator or error == LexerError.InvalidNumericBase or
       error == LexerError.InvalidNumericSuffix or error == LexerError.InvalidExponent {
        let mut reason: string = "invalid numeric literal";
        if error == LexerError.InvalidInteger { set reason = "malformed integer literal"; }
        elif error == LexerError.InvalidFloat { set reason = "malformed floating-point literal"; }
        elif error == LexerError.InvalidNumericSeparator { set reason = "invalid numeric separator in literal"; }
        elif error == LexerError.InvalidNumericBase { set reason = "invalid digit or missing digits in based integer literal"; }
        elif error == LexerError.InvalidNumericSuffix { set reason = "unsupported numeric suffix in literal"; }
        elif error == LexerError.InvalidExponent { set reason = "invalid exponent in literal"; }
        return reason + " `" +
            native_pipeline_lexer_escape_bytes(source, begin, end, false) +
            "` at UTF-8 byte range [" + native_pipeline_u64_to_string(begin as u64) +
            ", " + native_pipeline_u64_to_string(end as u64) + ")";
    }
    if error == LexerError.InvalidCharacter or error == LexerError.InvalidToken {
        return "invalid character `" +
            native_pipeline_lexer_escape_bytes(source, begin, end, false) +
            "` at UTF-8 byte range [" + native_pipeline_u64_to_string(begin as u64) +
            ", " + native_pipeline_u64_to_string(end as u64) + ")";
    }
    return vitte_lexer_error_name(error);
}

proc native_pipeline_lexer_code(error: LexerError) -> string {
    match error {
        case LexerError.InvalidUtf8 => return "VITTE_LEXER_E_INVALID_UNICODE";
        case LexerError.InvalidIdentifier => return "VITTE_LEXER_E_INVALID_IDENTIFIER";
        case LexerError.InvalidNumber => return "VITTE_LEXER_E_INVALID_NUMBER";
        case LexerError.InvalidInteger => return "VITTE_LEXER_E_INVALID_INTEGER";
        case LexerError.InvalidFloat => return "VITTE_LEXER_E_INVALID_FLOAT";
        case LexerError.InvalidCharacterLiteral => return "VITTE_LEXER_E_INVALID_CHARACTER_LITERAL";
        case LexerError.InvalidNumericSeparator => return "VITTE_LEXER_E_INVALID_NUMERIC_SEPARATOR";
        case LexerError.InvalidNumericBase => return "VITTE_LEXER_E_INVALID_NUMERIC_BASE";
        case LexerError.InvalidNumericSuffix => return "VITTE_LEXER_E_INVALID_NUMERIC_SUFFIX";
        case LexerError.InvalidExponent => return "VITTE_LEXER_E_INVALID_EXPONENT";
        case LexerError.InvalidOperator => return "VITTE_LEXER_E_INVALID_OPERATOR";
        case LexerError.InvalidEscape => return "VITTE_LEXER_E_INVALID_ESCAPE";
        case LexerError.UnterminatedString => return "VITTE_LEXER_E_UNTERMINATED_STRING";
        case LexerError.UnterminatedComment => return "VITTE_LEXER_E_UNTERMINATED_COMMENT";
        case LexerError.InvalidCharacter => return "VITTE_LEXER_E_INVALID_CHARACTER";
        case LexerError.InvalidToken => return "VITTE_LEXER_E_INVALID_CHARACTER";
        case LexerError.CommentDepth => return "VITTE_INFRA_E_LIMIT";
        case LexerError.TokenLimit => return "VITTE_INFRA_E_LIMIT";
        case LexerError.SourceTooLarge => return "VITTE_INFRA_E_LIMIT";
        case LexerError.NumberOverflow => return "VITTE_LEXER_E_NUMBER_OVERFLOW";
        case LexerError.Overflow => return "VITTE_INFRA_E_LIMIT";
        case LexerError.OutOfMemory => return "VITTE_INFRA_E_RESOURCE";
    }
}

proc native_pipeline_export_one_lexer_diagnostic(
    error: LexerError,
    span: LexerSpan,
    file_id: u64,
    source_name: *const char,
    source: str,
    batch: *mut u8,
    count: usize,
    index: usize
) -> bool {
    if batch == null { return false; }
    if error == LexerError.None { return true; }
    let mut primary_end = span.end;
    if span.valid and span.begin <= source.length {
        if error == LexerError.UnterminatedString and span.begin < source.length {
            set primary_end = span.begin + 1;
        } elif error == LexerError.UnterminatedComment and source.length - span.begin >= 2 {
            set primary_end = span.begin + 2;
        }
    }
    let mut details = native_pipeline_lexer_diagnostic_details(
        error,
        source,
        span.begin,
        span.end
    );
    if span.valid and span.begin <= span.end and span.end <= source.length {
        if error == LexerError.InvalidEscape {
            set details = "invalid escape sequence `";
            set details += source.slice(span.begin, span.end);
            set details += "`";
            set details += "; accepted forms: `\\\\`, `\\'`, `\\\"`, `\\0`, `\\a`, `\\b`, `\\f`, `\\n`, `\\r`, `\\t`, `\\v`, `\\xNN` (2 hex digits), `\\uNNNN` (4), and `\\UNNNNNNNN` (8)";
        } elif error == LexerError.InvalidNumber {
            set details = "invalid numeric literal `";
            set details += source.slice(span.begin, span.end);
            set details += "`";
        } elif error == LexerError.InvalidInteger {
            set details = "malformed integer literal `";
            set details += source.slice(span.begin, span.end);
            set details += "` at UTF-8 byte range [" + native_pipeline_u64_to_string(span.begin as u64) + ", " + native_pipeline_u64_to_string(span.end as u64) + ")";
        } elif error == LexerError.InvalidFloat {
            set details = "malformed floating-point literal `";
            set details += source.slice(span.begin, span.end);
            set details += "` at UTF-8 byte range [" + native_pipeline_u64_to_string(span.begin as u64) + ", " + native_pipeline_u64_to_string(span.end as u64) + ")";
        } elif error == LexerError.InvalidCharacterLiteral {
            set details = native_pipeline_lexer_diagnostic_details(error, source, span.begin, span.end);
        } elif error == LexerError.InvalidNumericSeparator {
            set details = "invalid numeric separator in literal `";
            set details += source.slice(span.begin, span.end);
            set details += "`; underscores must occur singly between digits at UTF-8 byte range [" + native_pipeline_u64_to_string(span.begin as u64) + ", " + native_pipeline_u64_to_string(span.end as u64) + ")";
        } elif error == LexerError.InvalidNumericBase {
            set details = "invalid digit or missing digits in based integer literal `";
            let mut expected: string = "`; expected digits valid for the literal's base";
            if span.end > span.begin + 1 {
                let base_prefix: u8 = source[span.begin + 1] as u8;
                if base_prefix == 98 or base_prefix == 66 {
                    set details = "invalid digit or missing digits in base-2 integer literal `";
                    set expected = "`; expected binary digits 0-1";
                } elif base_prefix == 111 or base_prefix == 79 {
                    set details = "invalid digit or missing digits in base-8 integer literal `";
                    set expected = "`; expected octal digits 0-7";
                } elif base_prefix == 120 or base_prefix == 88 {
                    set details = "invalid digit or missing digits in base-16 integer literal `";
                    set expected = "`; expected hexadecimal digits 0-9 or A-F";
                }
            }
            set details += source.slice(span.begin, span.end);
            set details += expected;
            set details += " at UTF-8 byte range [";
            set details += native_pipeline_u64_to_string(span.begin as u64);
            set details += ", ";
            set details += native_pipeline_u64_to_string(span.end as u64);
            set details += ")";
        } elif error == LexerError.InvalidNumericSuffix {
            set details = "unsupported numeric suffix in literal `";
            set details += source.slice(span.begin, span.end);
            set details += "`; Vitte numeric literals do not define suffixes at UTF-8 byte range [" + native_pipeline_u64_to_string(span.begin as u64) + ", " + native_pipeline_u64_to_string(span.end as u64) + ")";
        } elif error == LexerError.InvalidExponent {
            set details = "invalid exponent in literal `";
            set details += source.slice(span.begin, span.end);
            set details += "`; decimal exponents use `e` and hexadecimal exponents use `p`, followed by decimal digits at UTF-8 byte range [" + native_pipeline_u64_to_string(span.begin as u64) + ", " + native_pipeline_u64_to_string(span.end as u64) + ")";
        } elif error == LexerError.NumberOverflow {
            set details = "integer literal `";
            set details += source.slice(span.begin, span.end);
            set details += "` exceeds the supported unsigned 64-bit range [0, 18446744073709551615] (u64) at UTF-8 byte range [";
            set details += native_pipeline_u64_to_string(span.begin as u64);
            set details += ", ";
            set details += native_pipeline_u64_to_string(span.end as u64);
            set details += ")";
        } elif error == LexerError.InvalidOperator {
            set details = "invalid or incomplete operator/punctuation sequence `";
            set details += source.slice(span.begin, span.end);
            set details += "` is not a supported Vitte operator at UTF-8 byte range [";
            set details += native_pipeline_u64_to_string(span.begin as u64);
            set details += ", ";
            set details += native_pipeline_u64_to_string(span.end as u64);
            set details += ")";
        } elif error == LexerError.UnterminatedString {
            set details = "string opened with `\"` here is missing its closing `\"` delimiter";
        } elif error == LexerError.UnterminatedComment {
            set details = "block comment opened with `/*` here is missing its matching `*/` terminator";
        }
    }
    if not native_pipeline_export_cli_diagnostic(
        batch,
        count,
        index,
        (index + 1) as u64,
        native_pipeline_c_string(native_pipeline_lexer_code(error)),
        CliDiagnosticSeverity.Error,
        CliDiagnosticOrigin.Lexer,
        native_pipeline_c_string("lexical analysis failed"),
        native_pipeline_c_string(details),
        null,
        span.valid,
        span.file_id as u32,
        file_id,
        source_name,
        span.begin,
        primary_end,
        source,
        null,
        null
    ) {
        return false;
    }
    return true;
}

proc native_pipeline_export_lexer_diagnostic(
    lexer: ?&Lexer,
    file_id: u64,
    source_name: *const char,
    source: str,
    output: *mut *mut u8,
    output_count: *mut usize
) -> bool {
    if output != null { set *output = null; }
    if output_count != null { set *output_count = 0; }
    if output == null or output_count == null or lexer == null { return true; }
    let diagnostic_count: usize = vitte_lexer_diagnostic_count(lexer);
    if diagnostic_count == 0 {
        let error = vitte_lexer_last_error(lexer);
        if error == LexerError.None { return true; }
        let batch = vitte_cli_diagnostic_transport_create(1);
        if batch == null { return false; }
        if not native_pipeline_export_one_lexer_diagnostic(
            error,
            vitte_lexer_error_span(lexer),
            file_id,
            source_name,
            source,
            batch,
            1,
            0
        ) {
            vitte_cli_diagnostic_transport_destroy(batch);
            return false;
        }
        set *output = batch;
        set *output_count = 1;
        return true;
    }
    let batch = vitte_cli_diagnostic_transport_create(diagnostic_count);
    if batch == null { return false; }
    let mut index: usize = 0;
    while index < diagnostic_count {
        let item = vitte_lexer_diagnostic_at(lexer, index);
        if item == null {
            vitte_cli_diagnostic_transport_destroy(batch);
            return false;
        }
        let lexer_item = item?;
        if not native_pipeline_export_one_lexer_diagnostic(
            (*lexer_item).error,
            (*lexer_item).span,
            file_id,
            source_name,
            source,
            batch,
            diagnostic_count,
            index
        ) {
            vitte_cli_diagnostic_transport_destroy(batch);
            return false;
        }
        set index += 1;
    }
    set *output = batch;
    set *output_count = diagnostic_count;
    return true;
}

form NativePipelineC17Backend {
    output: NativePipelineEmitResult
}

form NativePipelineC17Input {
    parser: *const Parser,
    ir: *const IRContext,
    ast_fallback: bool
}

export proc native_pipeline_emit_c17_unit(
    codegen: *mut Codegen,
    unit: *const CodegenUnit,
    backend_data: *mut u8
) -> bool {
    if codegen == null or unit == null or backend_data == null or (*unit).input == null {
        return false;
    }
    let input: *const NativePipelineC17Input = (*unit).input as *const NativePipelineC17Input;
    let backend: *mut NativePipelineC17Backend = &mut *(backend_data as *mut NativePipelineC17Backend);
    if input == null or ((*input).parser == null and (*input).ast_fallback) or
       ((*input).ir == null and not (*input).ast_fallback) {
        return false;
    }

    let mut emitted_success = false;
    let mut emitted_source: string = "";
    let mut emitted_error: string = "";
    if (*input).ast_fallback {
        let emitted: C17AstEmitResult = c17_emit_ast(&*((*input).parser));
        set emitted_success = emitted.success;
        set emitted_source = emitted.source;
        set emitted_error = emitted.error;
    } else {
        let emitted = c17_emit_ir(&*((*input).ir));
        set emitted_success = emitted.success;
        set emitted_source = emitted.source;
        set emitted_error = emitted.error;
    }
    if not emitted_success {
        set backend.output = NativePipelineEmitResult {
            success: false,
            source: emitted_source,
            error: emitted_error,
            help: "",
            diagnostic_code: native_pipeline_c_string(native_pipeline_codegen_code(emitted_error)),
            diagnostic_origin: native_pipeline_codegen_origin(emitted_error),
            codegen_error: native_pipeline_codegen_error(emitted_error),
            has_source_span: (*input).ast_fallback and emitted.has_span,
            source_span: emitted.span
        };
        return false;
    }
    if not vitte_codegen_account_output(codegen, emitted_source.length) {
        set backend.output = native_pipeline_emit_failure(
            "generated C17 source exceeds the configured output limit",
            native_pipeline_c_string("VITTE_BACKEND_E_OUTPUT"),
            CliDiagnosticOrigin.Io,
            CodegenError.OutputLimit
        );
        return false;
    }
    set backend.output = NativePipelineEmitResult {
        success: true,
        source: emitted_source,
        error: "",
        help: "",
        diagnostic_code: null,
        diagnostic_origin: CliDiagnosticOrigin.Unknown,
        codegen_error: CodegenError.None,
        has_source_span: false,
        source_span: ParserSpan { file_id: 0, begin: 0, end: 0, line: 0, column: 0, valid: false }
    };
    return true;
}

proc native_pipeline_emit_c17(
    parser: &Parser,
    ir: ?&IRContext,
    ast_fallback: bool,
    config: &CodegenConfig
) -> NativePipelineEmitResult {
    if config.backend != CodegenBackendKind.C17 {
        return native_pipeline_emit_failure(
            "the native pipeline currently emits only the C17 backend",
            native_pipeline_c_string("VITTE_BACKEND_E_UNSUPPORTED"),
            CliDiagnosticOrigin.C17Backend,
            CodegenError.Unsupported
        );
    }

    let failed_output = native_pipeline_emit_failure(
        "native code generation orchestration failed",
        native_pipeline_c_string("VITTE_BACKEND_E_CODEGEN"),
        CliDiagnosticOrigin.C17Backend,
        CodegenError.Backend
    );
    let mut codegen: Codegen = Codegen {};
    if not vitte_codegen_init(&mut codegen, config, null) {
        return native_pipeline_emit_failure(
            "native code generation initialization failed",
            native_pipeline_c_string("VITTE_BACKEND_E_CONFIG"),
            CliDiagnosticOrigin.C17Backend,
            CodegenError.InvalidConfig
        );
    }

    let mut backend: NativePipelineC17Backend = NativePipelineC17Backend { output: failed_output };
    let input: NativePipelineC17Input = NativePipelineC17Input {
        parser: parser as *const Parser,
        ir: if ir == null { null } else { ir? as *const IRContext },
        ast_fallback: ast_fallback
    };
    let mut interface: CodegenBackendInterface = CodegenBackendInterface {};
    set interface.emit_unit = native_pipeline_emit_c17_unit;
    let unit: CodegenUnit = CodegenUnit {
        id: 1,
        name: native_pipeline_c_string("main"),
        input: (&input) as *const NativePipelineC17Input as *const u8,
        location: CodegenSourceLocation { file_id: 0, begin: 0, end: 0, valid: false }
    };

    let configured = vitte_codegen_set_backend(
        &mut codegen,
        &interface,
        (&mut backend) as *mut NativePipelineC17Backend as *mut u8
    ) and vitte_codegen_add_unit(&mut codegen, &unit);
    let generated = configured and vitte_codegen_generate(&mut codegen);
    let mut output = backend.output;
    if not generated and output.success { set output = failed_output; }
    if not generated and output.error == failed_output.error {
        set output.error = "native code generation orchestration failed (error " +
            (codegen.last_error as u32).to_string() + ")";
        set output.codegen_error = if codegen.last_error == CodegenError.None {
            CodegenError.Backend
        } else {
            codegen.last_error
        };
    }
    vitte_codegen_destroy(&mut codegen);
    return output;
}

/// Generic or unsupported form field types, reference operations, test
/// declarations, and non-range for loops still use compatibility lowering.
/// Keep these predicates aligned with the shapes handled by the HIR and IR
/// lowerers.
proc native_pipeline_form_supported(parser: &Parser, node: &ASTNode) -> bool {
    if node.child_count == 0 or parser.nodes == null { return false; }
    let form_name_node: *const ASTNode = vitte_parser_get_node(parser, node.children[0]);
    let form_name_token: *const ParserToken = if form_name_node == null { null } else { vitte_parser_node_token(parser, form_name_node) };
    if form_name_token == null { return false; }
    let mut index: usize = 1;
    while index < node.child_count {
        let part: *const ASTNode = vitte_parser_get_node(parser, node.children[index]);
        if part == null or part.kind == ASTNodeKind.GenericParam or part.kind == ASTNodeKind.WhereClause { return false; }
        if part.kind != ASTNodeKind.FieldDecl or part.child_count != 2 { return false; }
        if not native_pipeline_form_field_type_supported(
            parser,
            part.children[1],
            form_name_token
        ) { return false; }
        set index += 1;
    }
    return true;
}

proc native_pipeline_form_named_type_supported(
    parser: &Parser,
    node: *const ASTNode,
    owner_name: *const ParserToken
) -> bool {
    if node == null or owner_name == null or
       (node.kind != ASTNodeKind.Identifier and node.kind != ASTNodeKind.Path) or
       (node.kind == ASTNodeKind.Path and node.child_count != 1) { return false; }
    let named_token: *const ParserToken = vitte_parser_node_token(parser, node);
    if named_token == null { return false; }
    let builtin = named_token.lexeme == "i64" or named_token.lexeme == "i32" or
        named_token.lexeme == "u64" or named_token.lexeme == "usize" or
        named_token.lexeme == "u32" or named_token.lexeme == "u16" or
        named_token.lexeme == "u8" or named_token.lexeme == "bool" or
        named_token.lexeme == "f64" or named_token.lexeme == "double" or
        named_token.lexeme == "string" or named_token.lexeme == "str" or
        named_token.lexeme == "int";
    if builtin { return true; }
    if named_token.length == (*owner_name).length and named_token.lexeme == (*owner_name).lexeme {
        return false;
    }

    let mut declaration_index: usize = 0;
    while declaration_index < parser.node_count {
        let declaration = &parser.nodes[declaration_index];
        if (declaration.kind == ASTNodeKind.FormDecl or declaration.kind == ASTNodeKind.PickDecl) and declaration.child_count != 0 {
            let declaration_name: *const ASTNode = vitte_parser_get_node(parser, declaration.children[0]);
            let declaration_token: *const ParserToken = if declaration_name == null { null } else { vitte_parser_node_token(parser, declaration_name) };
            if declaration_token != null and declaration_token.length == named_token.length and declaration_token.lexeme == named_token.lexeme {
                let mut part_index: usize = 1;
                while part_index < declaration.child_count {
                    let part: *const ASTNode = vitte_parser_get_node(parser, declaration.children[part_index]);
                    if part == null or part.kind == ASTNodeKind.GenericParam or part.kind == ASTNodeKind.WhereClause {
                        return false;
                    }
                    set part_index += 1;
                }
                return true;
            }
        }
        set declaration_index += 1;
    }
    return false;
}

proc native_pipeline_form_field_type_supported(
    parser: &Parser,
    type_id: ASTNodeId,
    owner_name: *const ParserToken
) -> bool {
    let node: *const ASTNode = vitte_parser_get_node(parser, type_id);
    if node == null { return false; }
    if node.kind == ASTNodeKind.TypeExpr {
        return node.child_count == 1 and native_pipeline_form_field_type_supported(
            parser,
            node.children[0],
            owner_name
        );
    }
    if node.kind == ASTNodeKind.PointerType or node.kind == ASTNodeKind.ReferenceType {
        return node.child_count == 1 and native_pipeline_form_field_type_supported(
            parser,
            node.children[0],
            owner_name
        );
    }
    if node.kind == ASTNodeKind.ArrayType {
        if node.child_count != 2 { return false; }
        let length: *const ASTNode = vitte_parser_get_node(parser, node.children[0]);
        if length == null or length.kind != ASTNodeKind.IntegerLiteral { return false; }
        return native_pipeline_form_field_type_supported(
            parser,
            node.children[1],
            owner_name
        );
    }
    return native_pipeline_form_named_type_supported(parser, node, owner_name);
}

proc native_pipeline_requires_ast_codegen(parser: &Parser) -> bool {
    if parser.nodes == null { return false; }
    let mut index: usize = 0;
    while index < parser.node_count {
        let node = &parser.nodes[index];
        if node.attribute_count != 0 {
            return true;
        }
        // Function types are accepted by the parser and semantic analyzer, but
        // native HIR/IR lowering does not yet preserve callback parameter
        // values. The C17 AST backend supports these signatures and aliases.
        if node.kind == ASTNodeKind.TypeExpr and
           node.operator_kind == TokenKind.KwProc {
            return true;
        }
        if (node.node_flags & PARSER_AST_FLAG_COMPTIME) != 0 {
            return true;
        }
        if node.kind == ASTNodeKind.ExternProcDecl {
            let declaration_token = vitte_parser_node_token(parser, node);
            if declaration_token != null and
               (*declaration_token).lexeme == "intrinsic" {
                return true;
            }
        }
        if node.kind == ASTNodeKind.FormDecl and not native_pipeline_form_supported(parser, node) { return true; }
        if node.kind == ASTNodeKind.OpaqueDecl {
            let mut child_index: usize = 1;
            while child_index < node.child_count {
                let child = vitte_parser_get_node(parser, node.children[child_index]);
                if child != null and child.kind == ASTNodeKind.GenericParam {
                    return true;
                }
                set child_index += 1;
            }
        }
        if node.kind == ASTNodeKind.TestDecl { return true; }
        // The native semantic analyzer does not yet resolve macro declarations;
        // route them through the C17 AST emitter, which reports the unsupported
        // expansion at the construct's source span.
        if node.kind == ASTNodeKind.MacroDecl { return true; }
        if node.kind == ASTNodeKind.AwaitExpr { return true; }
        if (node.kind == ASTNodeKind.ProcDecl or node.kind == ASTNodeKind.ExternProcDecl) and
           (node.node_flags & PARSER_AST_FLAG_ASYNC) != 0 {
            return true;
        }
        if node.kind == ASTNodeKind.AssertStmt { return true; }
        if node.kind == ASTNodeKind.DeferStmt { return true; }
        if node.kind == ASTNodeKind.UnsafeBlock { return true; }
        if node.kind == ASTNodeKind.AsmStmt { return true; }
        set index += 1;
    }
    return false;
}

/// Module-qualified paths through an import alias are resolved by the C17 AST
/// emitter. HIR currently drops the import binding needed by native IR codegen.
proc native_pipeline_has_module_alias_import(parser: &Parser) -> bool {
    if parser.nodes == null { return false; }
    let mut index: usize = 0;
    while index < parser.node_count {
        let use_node = &parser.nodes[index];
        if use_node.kind == ASTNodeKind.UseDecl and use_node.child_count == 2 {
            let path = vitte_parser_get_node(parser, use_node.children[0]);
            let alias = vitte_parser_get_node(parser, use_node.children[1]);
            if path != null and path.kind == ASTNodeKind.Path and
               alias != null and alias.kind == ASTNodeKind.Identifier {
                return true;
            }
        }
        set index += 1;
    }
    return false;
}

proc native_pipeline_has_print_call(parser: &Parser) -> bool {
    if parser.nodes == null { return false; }
    let mut index: usize = 0;
    while index < parser.node_count {
        let node = &parser.nodes[index];
        if node.kind == ASTNodeKind.CallExpr and node.child_count != 0 {
            let callee = vitte_parser_get_node(parser, node.children[0]);
            let name_node = if callee != null and callee.kind == ASTNodeKind.Path and
                callee.child_count != 0 {
                vitte_parser_get_node(parser, callee.children[callee.child_count - 1])
            } else {
                callee
            };
            let name = vitte_parser_node_token(parser, name_node);
            if name != null and (*name).lexeme == "print" { return true; }
        }
        set index += 1;
    }
    return false;
}

/// These string helpers are emitted by the C17 AST backend but are not yet
/// registered as native semantic builtins. Keep their run/compile path on the
/// backend that provides their implementations until semantic registration is
/// complete.
proc native_pipeline_has_string_intrinsic_call(parser: &Parser) -> bool {
    if parser.nodes == null { return false; }
    let mut index: usize = 0;
    while index < parser.node_count {
        let node = &parser.nodes[index];
        if node.kind == ASTNodeKind.CallExpr and node.child_count != 0 {
            let callee = vitte_parser_get_node(parser, node.children[0]);
            let name_node = if callee != null and callee.kind == ASTNodeKind.Path and
                callee.child_count != 0 {
                vitte_parser_get_node(parser, callee.children[callee.child_count - 1])
            } else {
                callee
            };
            let name = vitte_parser_node_token(parser, name_node);
            if name != null and
               ((*name).lexeme == "trim" or
                (*name).lexeme == "starts_with" or
                (*name).lexeme == "ends_with") {
                return true;
            }
        }
        set index += 1;
    }
    return false;
}

proc native_pipeline_requires_generic_pick_ast_codegen(parser: &Parser) -> bool {
    if parser.nodes == null { return false; }
    let mut index: usize = 0;
    while index < parser.node_count {
        let node = &parser.nodes[index];
        if node.kind == ASTNodeKind.PickDecl {
            let mut child_index: usize = 1;
            while child_index < node.child_count {
                let child = vitte_parser_get_node(parser, node.children[child_index]);
                if child != null and
                   (child.kind == ASTNodeKind.GenericParam or
                    child.kind == ASTNodeKind.WhereClause) {
                    return true;
                }
                set child_index += 1;
            }
        }
        set index += 1;
    }
    return false;
}

proc native_pipeline_has_generic_form_declaration(parser: &Parser) -> bool {
    if parser.nodes == null { return false; }
    let mut node_index: usize = 0;
    while node_index < parser.node_count {
        let declaration = &parser.nodes[node_index];
        if declaration.kind == ASTNodeKind.FormDecl {
            let mut child_index: usize = 1;
            while child_index < declaration.child_count {
                let child: *const ASTNode = vitte_parser_get_node(parser, declaration.children[child_index]);
                if child != null and child.kind == ASTNodeKind.GenericParam { return true; }
                set child_index += 1;
            }
        }
        set node_index += 1;
    }
    return false;
}

/// References and optional operators use C17 AST code generation because
/// native HIR/IR lowering does not preserve their address and null-check
/// behavior. Keep this separate from the legacy semantic fallback so these
/// programs retain native type diagnostics.
proc native_pipeline_requires_reference_codegen(parser: &Parser) -> bool {
    if parser.nodes == null { return false; }
    let mut index: usize = 0;
    while index < parser.node_count {
        let node = &parser.nodes[index];
        if node.kind == ASTNodeKind.ReferenceType or node.kind == ASTNodeKind.TryExpr or
           (node.kind == ASTNodeKind.BinaryExpr and
            node.operator_kind == TokenKind.QuestionQuestion) {
            return true;
        }
        if node.kind == ASTNodeKind.UnaryExpr and node.operator_kind == TokenKind.Amp { return true; }
        set index += 1;
    }
    return false;
}

/// Procedure attributes are retained by the parser but are not represented in
/// HIR or IR yet. Route attributed declarations through the AST C17 backend so
/// supported code-generation attributes cannot disappear during lowering.
proc native_pipeline_requires_attribute_codegen(parser: &Parser) -> bool {
    if parser.nodes == null { return false; }
    let mut index: usize = 0;
    while index < parser.node_count {
        if parser.nodes[index].attribute_count != 0 { return true; }
        set index += 1;
    }
    return false;
}

/// Generic calls that the native IR cannot specialize yet are emitted through
/// the C17 AST monomorphizer. Match the terminal name of qualified calls too;
/// the AST emitter resolves those paths against module declarations and aliases.
proc native_pipeline_has_generic_proc_call(parser: &Parser) -> bool {
    if parser.nodes == null { return false; }
    let mut declaration_index: usize = 0;
    while declaration_index < parser.node_count {
        let declaration = &parser.nodes[declaration_index];
        if (declaration.kind == ASTNodeKind.ProcDecl or
            declaration.kind == ASTNodeKind.ExternProcDecl) and
           declaration.child_count != 0 {
            let mut has_generic_parameter = false;
            let mut child_index: usize = 1;
            while child_index < declaration.child_count {
                let child: *const ASTNode = vitte_parser_get_node(
                    parser,
                    declaration.children[child_index]
                );
                if child != null and child.kind == ASTNodeKind.GenericParam {
                    set has_generic_parameter = true;
                    break;
                }
                set child_index += 1;
            }
            if has_generic_parameter {
                let name: *const ASTNode = vitte_parser_get_node(parser, declaration.children[0]);
                let name_token: *const ParserToken = if name == null { null } else {
                    vitte_parser_node_token(parser, name)
                };
                if name_token != null {
                    let mut call_index: usize = 0;
                    while call_index < parser.node_count {
                        let call = &parser.nodes[call_index];
                        if call.kind == ASTNodeKind.CallExpr and call.child_count != 0 {
                            let callee: *const ASTNode = vitte_parser_get_node(parser, call.children[0]);
                            if callee != null and
                               (callee.kind == ASTNodeKind.Identifier or
                                (callee.kind == ASTNodeKind.Path and callee.child_count != 0)) {
                                let call_name_node = if callee.kind == ASTNodeKind.Path {
                                    vitte_parser_get_node(
                                        parser,
                                        callee.children[callee.child_count - 1]
                                    )
                                } else { callee };
                                let call_name: *const ParserToken = if call_name_node == null { null } else {
                                    vitte_parser_node_token(parser, call_name_node)
                                };
                                if call_name != null and
                                   name_token.length == call_name.length and
                                   name_token.lexeme == call_name.lexeme {
                                    return true;
                                }
                            }
                        }
                        set call_index += 1;
                    }
                }
            }
        }
        set declaration_index += 1;
    }
    return false;
}

proc native_pipeline_codegen_config(config: *const ConfigResolved) -> CodegenConfig {
    let mut codegen = vitte_codegen_config_default();
    if config == null { return codegen; }

    set codegen.max_errors = (*config).max_errors;
    set codegen.max_output_bytes = (*config).max_output_bytes;
    set codegen.deterministic = (*config).deterministic;
    set codegen.emit_debug_info = (*config).emit_debug_info;
    set codegen.emit_source_map = (*config).emit_source_map;
    set codegen.emit_comments = (*config).emit_comments;
    set codegen.runtime_checks = (*config).runtime_checks;
    set codegen.bounds_checks = (*config).bounds_checks;
    set codegen.null_checks = (*config).null_checks;
    set codegen.overflow_checks = (*config).overflow_checks;

    if (*config).backend == ConfigBackend.C17 {
        set codegen.backend = CodegenBackendKind.C17;
    } else if (*config).backend == ConfigBackend.Native {
        set codegen.backend = CodegenBackendKind.Native;
    } else if (*config).backend == ConfigBackend.Bytecode {
        set codegen.backend = CodegenBackendKind.Bytecode;
    }

    if (*config).optimization == ConfigOptimization.None {
        set codegen.optimization = CodegenOptimization.None;
    } else if (*config).optimization == ConfigOptimization.Debug {
        set codegen.optimization = CodegenOptimization.Debug;
    } else if (*config).optimization == ConfigOptimization.Balanced {
        set codegen.optimization = CodegenOptimization.Balanced;
    } else if (*config).optimization == ConfigOptimization.Speed {
        set codegen.optimization = CodegenOptimization.Speed;
    } else if (*config).optimization == ConfigOptimization.Size {
        set codegen.optimization = CodegenOptimization.Size;
    } else if (*config).optimization == ConfigOptimization.Aggressive {
        set codegen.optimization = CodegenOptimization.Aggressive;
    }
    return codegen;
}

proc native_pipeline_fingerprint(text: string) -> u64 {
    let mut hash: u64 = 14695981039346656037;
    let mut index: usize = 0;
    while index < text.length {
        set hash = (hash ^ (text[index] as u64)) * 1099511628211;
        set index += 1;
    }
    return hash;
}

proc native_pipeline_make_tokens(lexer: &Lexer, file_id: u32) -> [ParserToken] {
    let mut parser_tokens: [ParserToken] = [];
    let mut index: usize = 0;
    while index < lexer.token_count {
        let token = lexer.tokens[index];
        if not parser_tokens.push(ParserToken {
            kind: token.kind,
            span: ParserTokenSpan {
                file_id: file_id,
                begin: token.span.begin,
                end: token.span.end,
                valid: token.span.valid
            },
            line: token.line,
            column: token.column,
            lexeme: token.lexeme,
            length: token.length
        }) {
            return parser_tokens;
        }
        set index = index + 1;
    }

    return parser_tokens;
}

proc native_pipeline_parser_fingerprint(parser: &mut Parser) -> u64 {
    return vitte_parser_fingerprint(parser as *mut Parser);
}

proc native_pipeline_result(
    status: Status,
    phase: NativePipelinePhase,
    lexer_error: LexerError,
    token_count: usize,
    fingerprint: u64,
    succeeded: bool
) -> NativePipelineResult {
    return NativePipelineResult {
        status: status,
        last_completed_phase: phase,
        generated_source: "",
        lexer_error: lexer_error,
        parser_error: 0,
        parser_code: "",
        parser_detail: "",
        sema_error: 0,
        hir_error: 0,
        ir_error: 0,
        ir_diagnostic_code: "",
        codegen_error: 0,
        codegen_detail: "",
        codegen_help: "",
        token_count: token_count,
        parser_diagnostic_count: 0,
        sema_diagnostic_count: 0,
        sema_error_count: 0,
        hir_node_count: 0,
        ir_function_count: 0,
        generated_source_bytes: 0,
        lexer_fingerprint: fingerprint,
        parser_fingerprint: 0,
        hir_fingerprint: 0,
        ir_fingerprint: 0,
        codegen_fingerprint: 0,
        native_parser_attempted: false,
        native_parser_succeeded: false,
        native_ast_lowered: false,
        succeeded: succeeded
    };
}

/// Run the native lexer, parser, semantic analyzer, and C17 AST emitter.
/// The input must already be registered by the API owner. Generated C is
/// measured and optionally transferred to the API caller.
proc native_pipeline_run_with_config(
    source: ?str,
    source_length: usize,
    file_id: u64,
    action: u32,
    config: *const Config,
    generated_source: *mut *mut u8,
    generated_source_length: *mut usize,
    diagnostic_source_name: *const char,
    diagnostics: *mut *mut u8,
    diagnostic_count: *mut usize
) -> NativePipelineResult {
    if generated_source != null { set *generated_source = null; }
    if generated_source_length != null { set *generated_source_length = 0; }
    if diagnostics != null { set *diagnostics = null; }
    if diagnostic_count != null { set *diagnostic_count = 0; }
    if action > NATIVE_FRONTEND_ACTION_EMIT_AST_FINGERPRINT {
        return native_pipeline_result(Status.ErrorInvalidArgument, NativePipelinePhase.None, LexerError.InvalidArgument, 0, 0, false);
    }
    if config != null and not vitte_config_is_valid(config) {
        return native_pipeline_result(Status.ErrorInvalidArgument, NativePipelinePhase.None, LexerError.InvalidArgument, 0, 0, false);
    }
    let native_config: ConfigResolved = if config == null { vitte_config_resolved_default() } else { (*config).resolved };
    let native_codegen_config = native_pipeline_codegen_config(&native_config);

    if source == null and source_length != 0 {
        return native_pipeline_result(
            Status.ErrorInvalidArgument,
            NativePipelinePhase.None,
            LexerError.InvalidArgument,
            0,
            0,
            false
        );
    }

    let source_text: str = if source == null { "" } else { source? };
    if source_length > source_text.length {
        return native_pipeline_result(
            Status.ErrorInvalidArgument,
            NativePipelinePhase.SourceRegistered,
            LexerError.InvalidArgument,
            0,
            0,
            false
        );
    }

    // The bootstrap parser stores source file IDs as uint32_t.
    if file_id > 4294967295 {
        return native_pipeline_result(
            Status.ErrorInvalidArgument,
            NativePipelinePhase.SourceRegistered,
            LexerError.InvalidArgument,
            0,
            0,
            false
        );
    }

    let mut lexer: Lexer = Lexer {};
    if not vitte_lexer_init(
        &mut lexer,
        source_text,
        source_length,
        file_id
    ) {
        let lexer_error: LexerError = vitte_lexer_last_error(&lexer);
        let _ = native_pipeline_export_lexer_diagnostic(
            &lexer,
            file_id,
            diagnostic_source_name,
            source_text,
            diagnostics,
            diagnostic_count
        );
        vitte_lexer_destroy(&mut lexer);

        let status: Status = if lexer_error == LexerError.OutOfMemory {
            Status.ErrorOutOfMemory
        } else {
            Status.ErrorParse
        };

        return native_pipeline_result(
            status,
            NativePipelinePhase.SourceRegistered,
            lexer_error,
            0,
            0,
            false
        );
    }

    if not vitte_lexer_run(&mut lexer) {
        let lexer_error: LexerError = vitte_lexer_last_error(&lexer);
        let token_count: usize = vitte_lexer_token_count(&lexer);
        let _ = native_pipeline_export_lexer_diagnostic(
            &lexer,
            file_id,
            diagnostic_source_name,
            source_text,
            diagnostics,
            diagnostic_count
        );
        vitte_lexer_destroy(&mut lexer);

        let status: Status = if lexer_error == LexerError.OutOfMemory {
            Status.ErrorOutOfMemory
        } else {
            Status.ErrorParse
        };

        return native_pipeline_result(
            status,
            NativePipelinePhase.SourceRegistered,
            lexer_error,
            token_count,
            0,
            false
        );
    }

    if not vitte_lexer_validate(&mut lexer) {
        let lexer_error: LexerError = vitte_lexer_last_error(&lexer);
        let token_count: usize = vitte_lexer_token_count(&lexer);
        let _ = native_pipeline_export_lexer_diagnostic(
            &lexer,
            file_id,
            diagnostic_source_name,
            source_text,
            diagnostics,
            diagnostic_count
        );
        vitte_lexer_destroy(&mut lexer);

        return native_pipeline_result(
            Status.ErrorInternal,
            NativePipelinePhase.SourceRegistered,
            lexer_error,
            token_count,
            0,
            false
        );
    }

    let token_count: usize = vitte_lexer_token_count(&lexer);
    let lexer_hash: u64 = vitte_lexer_fingerprint(&mut lexer);
    let parser_tokens = native_pipeline_make_tokens(&lexer, file_id as u32);
    if parser_tokens.len() != token_count {
        deallocate(parser_tokens.as_ptr() as *mut u8);
        vitte_lexer_destroy(&mut lexer);
        return native_pipeline_result(Status.ErrorOutOfMemory, NativePipelinePhase.Lexed, LexerError.OutOfMemory, token_count, lexer_hash, false);
    }
    let mut parser: Parser = Parser {};
    if not vitte_parser_init(&mut parser, parser_tokens.as_ptr(), parser_tokens.len()) {
        let parser_error = parser.last_error as u32;
        let parser_code = native_pipeline_parser_code(parser.last_error);
        let parser_detail: string = "native parser initialization failed";
        vitte_parser_destroy(&mut parser);
        deallocate(parser_tokens.as_ptr() as *mut u8);
        vitte_lexer_destroy(&mut lexer);
        let mut result = native_pipeline_result(Status.ErrorParse, NativePipelinePhase.Lexed, LexerError.None, token_count, lexer_hash, false);
        set result.parser_error = parser_error;
        set result.parser_code = parser_code;
        set result.parser_detail = parser_detail;
        set result.native_parser_attempted = true;
        return result;
    }

    let parsed = vitte_parser_run_native(&mut parser);
    let parser_diagnostics = vitte_parser_diagnostic_count(&parser);
    let parser_error = parser.last_error as u32;
    let parser_error_kind = parser.last_error;
    let parser_hash = native_pipeline_parser_fingerprint(&mut parser);
    if not parsed {
        let parser_detail: string = "native parser rejected the source";
        let _ = native_pipeline_export_diagnostics(
            &parser,
            null,
            null,
            file_id,
            diagnostic_source_name,
            source_text,
            diagnostics,
            diagnostic_count
        );
        vitte_parser_destroy(&mut parser);
        deallocate(parser_tokens.as_ptr() as *mut u8);
        vitte_lexer_destroy(&mut lexer);
        let mut result = native_pipeline_result(Status.ErrorParse, NativePipelinePhase.Lexed, LexerError.None, token_count, lexer_hash, false);
        set result.parser_error = parser_error;
        set result.parser_code = native_pipeline_parser_code(parser_error_kind);
        set result.parser_detail = parser_detail;
        set result.parser_diagnostic_count = parser_diagnostics;
        set result.parser_fingerprint = parser_hash;
        set result.native_parser_attempted = true;
        return result;
    }

    if action == NATIVE_FRONTEND_ACTION_EMIT_AST_FINGERPRINT {
        let fingerprint_text: string = native_pipeline_u64_to_string(parser_hash);
        let mut result = native_pipeline_result(
            Status.Ok,
            NativePipelinePhase.Parsed,
            LexerError.None,
            token_count,
            lexer_hash,
            true
        );
        set result.parser_error = parser_error;
        set result.parser_diagnostic_count = parser_diagnostics;
        set result.parser_fingerprint = parser_hash;
        set result.native_parser_attempted = true;
        set result.native_parser_succeeded = true;
        set result.generated_source = fingerprint_text;
        if generated_source != null { set *generated_source = fingerprint_text.as_ptr() as *mut u8; }
        if generated_source_length != null { set *generated_source_length = fingerprint_text.length; }
        vitte_parser_destroy(&mut parser);
        deallocate(parser_tokens.as_ptr() as *mut u8);
        vitte_lexer_destroy(&mut lexer);
        return result;
    }

    let semantic_fallback = native_pipeline_requires_ast_codegen(&parser) or
        (action == NATIVE_FRONTEND_ACTION_COMPILE and
         native_pipeline_has_string_intrinsic_call(&parser));
    let print_ast_fallback = action == NATIVE_FRONTEND_ACTION_COMPILE and
        native_pipeline_has_print_call(&parser);
    let generic_pick_ast_fallback = action == NATIVE_FRONTEND_ACTION_COMPILE and
        native_pipeline_requires_generic_pick_ast_codegen(&parser);
    let ast_fallback = semantic_fallback or print_ast_fallback or
        native_pipeline_requires_reference_codegen(&parser) or
        native_pipeline_requires_attribute_codegen(&parser) or
        generic_pick_ast_fallback or
        (action == NATIVE_FRONTEND_ACTION_COMPILE and
         native_pipeline_has_module_alias_import(&parser));
    let generic_proc_c17_fallback = action == NATIVE_FRONTEND_ACTION_COMPILE and
        native_pipeline_has_generic_proc_call(&parser);

    let mut sema: Sema = Sema {};
    if not vitte_sema_init(&mut sema, &parser) {
        let sema_last_error = vitte_sema_last_error(&sema);
        let sema_error = sema_last_error as u32;
        let failure = native_pipeline_sema_failure(sema_last_error, true);
        let _ = native_pipeline_export_diagnostics(
            &parser,
            null,
            &failure,
            file_id,
            diagnostic_source_name,
            source_text,
            diagnostics,
            diagnostic_count
        );
        vitte_sema_destroy(&mut sema);
        vitte_parser_destroy(&mut parser);
        deallocate(parser_tokens.as_ptr() as *mut u8);
        vitte_lexer_destroy(&mut lexer);
        let mut result = native_pipeline_result(
            if failure.codegen_error == CodegenError.OutOfMemory { Status.ErrorOutOfMemory } else { Status.ErrorInternal },
            NativePipelinePhase.Parsed,
            LexerError.None,
            token_count,
            lexer_hash,
            false
        );
        set result.parser_error = parser_error;
        set result.parser_diagnostic_count = parser_diagnostics;
        set result.parser_fingerprint = parser_hash;
        set result.sema_error = sema_error;
        set result.native_parser_attempted = true;
        set result.native_parser_succeeded = true;
        set result.native_ast_lowered = true;
        return result;
    }

    let analyzed = vitte_sema_run(&mut sema);
    let sema_valid = vitte_sema_validate(&mut sema);
    let mut sema_diagnostics = vitte_sema_diagnostic_count(&sema);
    let sema_statistics: SemaStats = vitte_sema_stats(&sema);
    let mut sema_errors = sema_statistics.errors as usize;
    let sema_last_error = vitte_sema_last_error(&sema);
    let sema_error = sema_last_error as u32;
    let sema_ast_fallback = action == NATIVE_FRONTEND_ACTION_COMPILE and semantic_fallback and
        sema_errors != 0 and not native_pipeline_has_generic_form_declaration(&parser);
    if sema_ast_fallback {
        // The AST backend still covers aggregate and pattern programs whose
        // semantic rules are not implemented in the native analyzer yet.
        // Generic form diagnostics are authoritative and must not be discarded
        // before the AST backend emits a specialization.
        // Keep native diagnostics authoritative for checks and IR emission;
        // for other compatibility-only programs, let the AST backend validate.
        set sema_diagnostics = 0;
        set sema_errors = 0;
    }
    if (not sema_valid or sema_errors != 0 or not analyzed) and not sema_ast_fallback {
        let has_source_error = sema_errors != 0 and sema_diagnostics != 0;
        let failure = native_pipeline_sema_failure(sema_last_error, false);
        if has_source_error {
            let _ = native_pipeline_export_diagnostics(
                &parser,
                &sema,
                null,
                file_id,
                diagnostic_source_name,
                source_text,
                diagnostics,
                diagnostic_count
            );
        } else {
            let _ = native_pipeline_export_diagnostics(
                &parser,
                &sema,
                &failure,
                file_id,
                diagnostic_source_name,
                source_text,
                diagnostics,
                diagnostic_count
            );
        }
        vitte_sema_destroy(&mut sema);
        vitte_parser_destroy(&mut parser);
        deallocate(parser_tokens.as_ptr() as *mut u8);
        vitte_lexer_destroy(&mut lexer);
        let mut result = native_pipeline_result(
            if has_source_error { Status.ErrorParse } elif failure.codegen_error == CodegenError.OutOfMemory { Status.ErrorOutOfMemory } else { Status.ErrorInternal },
            NativePipelinePhase.Parsed,
            LexerError.None,
            token_count,
            lexer_hash,
            false
        );
        set result.parser_error = parser_error;
        set result.sema_error = sema_error;
        set result.parser_diagnostic_count = parser_diagnostics;
        set result.sema_diagnostic_count = sema_diagnostics;
        set result.sema_error_count = sema_errors;
        set result.parser_fingerprint = parser_hash;
        set result.native_parser_attempted = true;
        set result.native_parser_succeeded = true;
        set result.native_ast_lowered = true;
        return result;
    }

    if action == NATIVE_FRONTEND_ACTION_CHECK {
        if not native_pipeline_export_diagnostics(
            &parser,
            &sema,
            null,
            file_id,
            diagnostic_source_name,
            source_text,
            diagnostics,
            diagnostic_count
        ) {
            vitte_sema_destroy(&mut sema);
            vitte_parser_destroy(&mut parser);
            deallocate(parser_tokens.as_ptr() as *mut u8);
            vitte_lexer_destroy(&mut lexer);
            return native_pipeline_result(
                Status.ErrorOutOfMemory,
                NativePipelinePhase.Analyzed,
                LexerError.OutOfMemory,
                token_count,
                lexer_hash,
                false
            );
        }
        vitte_sema_destroy(&mut sema);
        vitte_parser_destroy(&mut parser);
        deallocate(parser_tokens.as_ptr() as *mut u8);
        vitte_lexer_destroy(&mut lexer);
        let mut result = native_pipeline_result(
            Status.Ok,
            NativePipelinePhase.Analyzed,
            LexerError.None,
            token_count,
            lexer_hash,
            true
        );
        set result.parser_error = parser_error;
        set result.parser_diagnostic_count = parser_diagnostics;
        set result.sema_diagnostic_count = sema_diagnostics;
        set result.parser_fingerprint = parser_hash;
        set result.native_parser_attempted = true;
        set result.native_parser_succeeded = true;
        set result.native_ast_lowered = true;
        return result;
    }

    if action == NATIVE_FRONTEND_ACTION_COMPILE and
       not vitte_codegen_config_validate(&native_codegen_config) {
        let failure = native_pipeline_emit_failure(
            "the backend received an invalid or incompatible compilation configuration",
            native_pipeline_c_string("VITTE_BACKEND_E_CONFIG"),
            CliDiagnosticOrigin.C17Backend,
            CodegenError.InvalidConfig
        );
        let diagnostics_exported = native_pipeline_export_diagnostics(
            &parser,
            &sema,
            &failure,
            file_id,
            diagnostic_source_name,
            source_text,
            diagnostics,
            diagnostic_count
        );
        vitte_sema_destroy(&mut sema);
        vitte_parser_destroy(&mut parser);
        deallocate(parser_tokens.as_ptr() as *mut u8);
        vitte_lexer_destroy(&mut lexer);
        let mut result = native_pipeline_result(
            if diagnostics_exported { Status.ErrorBackend } else { Status.ErrorOutOfMemory },
            NativePipelinePhase.Analyzed,
            LexerError.None,
            token_count,
            lexer_hash,
            false
        );
        set result.parser_error = parser_error;
        set result.sema_error = sema_error;
        set result.parser_diagnostic_count = parser_diagnostics;
        set result.sema_diagnostic_count = sema_diagnostics;
        set result.parser_fingerprint = parser_hash;
        set result.codegen_error = CodegenError.InvalidConfig as u32;
        set result.codegen_detail = failure.error;
        set result.native_parser_attempted = true;
        set result.native_parser_succeeded = true;
        set result.native_ast_lowered = true;
        return result;
    }

    let mut hir: HIR = HIR {};
    let mut ir: IRContext = IRContext {};
    let mut hir_initialized = false;
    let mut ir_initialized = false;
    let mut hir_error: u32 = 0;
    let mut ir_error: u32 = 0;
    let mut hir_node_count: usize = 0;
    let mut ir_function_count: usize = 0;
    let mut hir_hash: u64 = 0;
    let mut ir_hash: u64 = 0;
    let mut phase: NativePipelinePhase = NativePipelinePhase.Analyzed;
    let mut output = native_pipeline_emit_failure(
        "native HIR lowering could not start",
        native_pipeline_c_string("VITTE_HIR_E_LOWERING"),
        CliDiagnosticOrigin.Hir,
        CodegenError.Backend
    );
    if vitte_hir_init(&mut hir) {
        set hir_initialized = true;
        if not vitte_hir_lower_ast(&mut hir, &parser) {
            set hir_error = hir.last_error as u32;
            if action == NATIVE_FRONTEND_ACTION_COMPILE and
               (ast_fallback or generic_proc_c17_fallback) {
                set output = native_pipeline_emit_c17(&parser, null, true, &native_codegen_config);
            } else {
                set output = native_pipeline_hir_failure(hir.last_error, false);
            }
        } elif not vitte_hir_is_valid(&hir) or not vitte_hir_validate(&mut hir) or hir.state != HIRState.Validated {
            set hir_error = hir.last_error as u32;
            if action == NATIVE_FRONTEND_ACTION_COMPILE and
               (ast_fallback or generic_proc_c17_fallback) {
                set output = native_pipeline_emit_c17(&parser, null, true, &native_codegen_config);
            } else {
                set output = native_pipeline_hir_failure(hir.last_error, true);
            }
        } else {
            let hir_statistics: HIRStats = vitte_hir_stats(&hir);
            set hir_node_count = hir_statistics.nodes_created as usize;
            set hir_hash = vitte_hir_fingerprint(&mut hir);
            set phase = NativePipelinePhase.HirLowered;

            if not vitte_ir_init(&mut ir) {
                set ir_error = ir.last_error as u32;
                set output = native_pipeline_ir_failure(ir.last_error, false);
            } else {
                set ir_initialized = true;
                if not vitte_ir_lower_hir(&mut ir, &hir) {
                    set ir_error = ir.last_error as u32;
                    if action == NATIVE_FRONTEND_ACTION_COMPILE and
                       (ast_fallback or generic_proc_c17_fallback) {
                        set output = native_pipeline_emit_c17(&parser, null, true, &native_codegen_config);
                    } else {
                        set output = native_pipeline_ir_failure(ir.last_error, false);
                    }
                } elif not vitte_ir_is_valid(&ir) or not vitte_ir_validate(&mut ir) or ir.state != IRState.Sealed {
                    set ir_error = ir.last_error as u32;
                    if action == NATIVE_FRONTEND_ACTION_COMPILE and
                       (ast_fallback or generic_proc_c17_fallback) {
                        set output = native_pipeline_emit_c17(&parser, null, true, &native_codegen_config);
                    } else {
                        set output = native_pipeline_ir_failure(ir.last_error, true);
                    }
                } else {
                    let ir_statistics: IRStats = vitte_ir_stats(&ir);
                    set ir_function_count = ir_statistics.functions_created as usize;
                    set ir_hash = vitte_ir_fingerprint(&mut ir);
                    set phase = NativePipelinePhase.IrLowered;
                    if action == NATIVE_FRONTEND_ACTION_EMIT_IR {
                        set output = NativePipelineEmitResult {
                            success: true,
                            source: vitte_ir_dump_text(&ir),
                            error: "",
                            help: "",
                            diagnostic_code: null,
                            diagnostic_origin: CliDiagnosticOrigin.Unknown,
                            codegen_error: CodegenError.None,
                            has_source_span: false,
                            source_span: ParserSpan { file_id: 0, begin: 0, end: 0, line: 0, column: 0, valid: false }
                        };
                    } elif ast_fallback {
                        set output = native_pipeline_emit_c17(&parser, null, true, &native_codegen_config);
                    } else {
                        set output = native_pipeline_emit_c17(
                            &parser,
                            &ir,
                            false,
                            &native_codegen_config
                        );
                    }
                }
            }
        }
    } else {
        set hir_error = hir.last_error as u32;
        set output = native_pipeline_hir_failure(hir.last_error, false);
    }

    if not native_pipeline_export_diagnostics(
        &parser,
        if sema_ast_fallback { null } else { &sema },
        &output,
        file_id,
        diagnostic_source_name,
        source_text,
        diagnostics,
        diagnostic_count
    ) {
        if ir_initialized { vitte_ir_destroy(&mut ir); }
        if hir_initialized { vitte_hir_destroy(&mut hir); }
        vitte_sema_destroy(&mut sema);
        vitte_parser_destroy(&mut parser);
        deallocate(parser_tokens.as_ptr() as *mut u8);
        vitte_lexer_destroy(&mut lexer);
        return native_pipeline_result(Status.ErrorOutOfMemory, phase, LexerError.OutOfMemory, token_count, lexer_hash, false);
    }
    if ir_initialized { vitte_ir_destroy(&mut ir); }
    if hir_initialized { vitte_hir_destroy(&mut hir); }
    vitte_sema_destroy(&mut sema);
    vitte_parser_destroy(&mut parser);
    deallocate(parser_tokens.as_ptr() as *mut u8);
    vitte_lexer_destroy(&mut lexer);
    let mut result = native_pipeline_result(
        if output.success { Status.Ok } else { Status.ErrorBackend },
        if output.success { NativePipelinePhase.Generated } else { phase },
        LexerError.None,
        token_count,
        lexer_hash,
        output.success
    );
    set result.parser_error = parser_error;
    set result.hir_error = hir_error;
    set result.ir_error = ir_error;
    set result.parser_diagnostic_count = parser_diagnostics;
    set result.parser_fingerprint = parser_hash;
    set result.hir_node_count = hir_node_count;
    set result.ir_function_count = ir_function_count;
    set result.hir_fingerprint = hir_hash;
    set result.ir_fingerprint = ir_hash;
    set result.generated_source_bytes = if output.success { output.source.length } else { 0 as usize };
    set result.codegen_fingerprint = if output.success { native_pipeline_fingerprint(output.source) } else { 0 as u64 };
    set result.codegen_error = output.codegen_error as u32;
    set result.codegen_detail = output.error;
    set result.codegen_help = output.help;
    if ir_error != 0 and output.diagnostic_origin == CliDiagnosticOrigin.Ir {
        set result.ir_diagnostic_code = native_pipeline_cstring(output.diagnostic_code);
    }
    if output.success {
        set result.generated_source = output.source;
        if generated_source != null { set *generated_source = output.source.as_ptr() as *mut u8; }
        if generated_source_length != null { set *generated_source_length = output.source.length; }
    }
    set result.native_parser_attempted = true;
    set result.native_parser_succeeded = true;
    set result.native_ast_lowered = true;
    return result;
}

export proc native_pipeline_run(
    source: ?str,
    source_length: usize,
    file_id: u64
) -> NativePipelineResult {
    return native_pipeline_run_with_config(source, source_length, file_id, NATIVE_FRONTEND_ACTION_COMPILE, null, null, null, null, null, null);
}

/// Check a source file through parsing and semantic analysis without lowering
/// it into HIR or invoking a code generator.
export proc native_pipeline_check(
    source: ?str,
    source_length: usize,
    file_id: u64
) -> NativePipelineResult {
    return native_pipeline_run_with_config(source, source_length, file_id, NATIVE_FRONTEND_ACTION_CHECK, null, null, null, null, null, null);
}

export proc native_pipeline_emit_ir(
    source: ?str,
    source_length: usize,
    file_id: u64
) -> NativePipelineResult {
    return native_pipeline_run_with_config(source, source_length, file_id, NATIVE_FRONTEND_ACTION_EMIT_IR, null, null, null, null, null, null);
}

/// Run the native driver before the CLI compatibility backend. Return 1 when
/// the native path completed without frontend diagnostics, 2 when it
/// completed with non-error diagnostics, and 0 when the caller should fall
/// back to the diagnostic-preserving bootstrap path.
export proc vitte_native_frontend_run(
    source: ?str,
    source_length: usize,
    file_id: u64
) -> u32 {
    let result = native_pipeline_run_with_config(source, source_length, file_id, NATIVE_FRONTEND_ACTION_COMPILE, null, null, null, null, null, null);
    if not result.succeeded { return 0; }
    if result.parser_diagnostic_count != 0 or result.sema_diagnostic_count != 0 {
        return 2;
    }
    return 1;
}

export proc vitte_native_frontend_run_with_config(
    source: ?str,
    source_length: usize,
    file_id: u64,
    config_bytes: *const u8
) -> u32 {
    let mut copied_config: Config = Config {};
    let mut config: *const Config = null;
    if config_bytes != null {
        copy((&mut copied_config) as *mut u8, config_bytes, sizeof(Config));
        set config = &copied_config;
    }
    let result = native_pipeline_run_with_config(source, source_length, file_id, NATIVE_FRONTEND_ACTION_COMPILE, config, null, null, null, null, null);
    if not result.succeeded { return 0; }
    if result.parser_diagnostic_count != 0 or result.sema_diagnostic_count != 0 {
        return 2;
    }
    return 1;
}

/// Generate C17 source and transfer ownership of its buffer to the caller.
/// The caller must release a non-null buffer with vitte_native_frontend_release_output.
export proc vitte_native_frontend_generate_with_config(
    source: ?str,
    source_length: usize,
    file_id: u64,
    config_bytes: *const u8,
    generated_source: *mut *mut u8,
    generated_source_length: *mut usize
) -> u32 {
    if generated_source == null or generated_source_length == null { return 0; }
    set *generated_source = null;
    set *generated_source_length = 0;
    let mut copied_config: Config = Config {};
    let mut config: *const Config = null;
    if config_bytes != null {
        copy((&mut copied_config) as *mut u8, config_bytes, sizeof(Config));
        set config = &copied_config;
    }
    let result = native_pipeline_run_with_config(
        source,
        source_length,
        file_id,
        NATIVE_FRONTEND_ACTION_COMPILE,
        config,
        generated_source,
        generated_source_length,
        null,
        null,
        null
    );
    if not result.succeeded { return 0; }
    if result.parser_diagnostic_count != 0 or result.sema_diagnostic_count != 0 {
        return 2;
    }
    return 1;
}

/// Generate C17 and return native frontend diagnostics through the dedicated
/// CLI transport. Status values are 0=unavailable/internal failure,
/// 1=success without diagnostics, 2=success with warnings/notes, and
/// 3=source errors with diagnostics.
export proc vitte_native_frontend_generate_with_diagnostics(
    source: ?str,
    source_length: usize,
    file_id: u64,
    source_name: *const char,
    config_bytes: *const u8,
    generated_source: *mut *mut u8,
    generated_source_length: *mut usize,
    diagnostics: *mut *mut u8,
    diagnostic_count: *mut usize
) -> u32 {
    return vitte_native_frontend_execute_with_diagnostics(
        NATIVE_FRONTEND_ACTION_COMPILE,
        source,
        source_length,
        file_id,
        source_name,
        config_bytes,
        generated_source,
        generated_source_length,
        diagnostics,
        diagnostic_count
    );
}

/// Run the shared native compiler pipeline for CLI compile, check or IR dump.
/// The output buffer contains generated C17 for compile, no bytes for check,
/// and a textual serialization of validated native IR for --emit-ir.
export proc vitte_native_frontend_execute_with_diagnostics(
    action: u32,
    source: ?str,
    source_length: usize,
    file_id: u64,
    source_name: *const char,
    config_bytes: *const u8,
    generated_source: *mut *mut u8,
    generated_source_length: *mut usize,
    diagnostics: *mut *mut u8,
    diagnostic_count: *mut usize
) -> u32 {
    if generated_source == null or generated_source_length == null or
       diagnostics == null or diagnostic_count == null { return 0; }
    if action > NATIVE_FRONTEND_ACTION_EMIT_AST_FINGERPRINT { return 0; }
    set *generated_source = null;
    set *generated_source_length = 0;
    set *diagnostics = null;
    set *diagnostic_count = 0;
    let mut copied_config: Config = Config {};
    let mut config: *const Config = null;
    if config_bytes != null {
        copy((&mut copied_config) as *mut u8, config_bytes, sizeof(Config));
        set config = &copied_config;
    }
    let result = native_pipeline_run_with_config(
        source,
        source_length,
        file_id,
        action,
        config,
        generated_source,
        generated_source_length,
        source_name,
        diagnostics,
        diagnostic_count
    );
    if not result.succeeded {
        if *diagnostic_count != 0 { return 3; }
        return 0;
    }
    if *diagnostic_count != 0 { return 2; }
    return 1;
}

export proc vitte_native_frontend_release_output(generated_source: *mut u8) {
    if generated_source != null { deallocate(generated_source); }
}
