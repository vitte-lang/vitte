        case ParserError.InvalidModulePath => return "malformed module path";
        case ParserError.DuplicateModuleHeader => return "duplicate module header";
        case ParserError.MisplacedModuleHeader => return "module header must precede declarations";
        case ParserError.InvalidUseDeclaration => return "malformed use declaration";
