export pick NativePipelinePhase {
    None,
    SourceRegistered,
    Lexed,
    Parsed,
    Analyzed,
    HirLowered,
    IrLowered,
    Generated,
    Count
}

export const NATIVE_FRONTEND_ACTION_COMPILE: u32 = 0;
export const NATIVE_FRONTEND_ACTION_CHECK: u32 = 1;
export const NATIVE_FRONTEND_ACTION_EMIT_IR: u32 = 2;
export const NATIVE_FRONTEND_ACTION_EMIT_AST_FINGERPRINT: u32 = 3;

/// Expose host-tool orchestration through the native pipeline entrypoint.
/// The driver owns compile/link/run ordering; the CLI only supplies resolved
/// options and renders the returned stage failure.
export proc vitte_native_driver_run_host_toolchain(
    source: *const u8,
    source_length: usize,
    output_path: *const u8,
    emit_object: bool,
    run_program: bool,
    debug_info: bool,
    debug_runtime: bool,
    run_argc: i32,
    run_argv: *mut *mut u8,
    failed_stage: *mut u32
) -> u32 {
    return vitte_driver_run_host_toolchain(
        source,
        source_length,
        output_path,
        emit_object,
        run_program,
        debug_info,
        debug_runtime,
        run_argc,
        run_argv,
        failed_stage
    );
}

/// Convert generated C17 into textual LLVM IR through the configured Clang
/// toolchain. The frontend's supported C17 subset remains the feature boundary.
export proc vitte_native_driver_emit_llvm_ir(
    c17_source: *const u8,
    c17_source_length: usize,
    output_path: *const u8,
    debug_info: bool,
    failed_stage: *mut u32
) -> u32 {
    return vitte_driver_emit_llvm_ir(
        c17_source,
        c17_source_length,
        output_path,
        debug_info,
        failed_stage
    );
}

export form NativePipelineResult {
    status: Status,
    last_completed_phase: NativePipelinePhase,
    generated_source: string,
    lexer_error: LexerError,
    parser_error: u32,
    parser_code: string,
    parser_detail: string,
    sema_error: u32,
    hir_error: u32,
    ir_error: u32,
    ir_diagnostic_code: string,
    codegen_error: u32,
    codegen_detail: string,
    codegen_help: string,
    token_count: usize,
    parser_diagnostic_count: usize,
    sema_diagnostic_count: usize,
    sema_error_count: usize,
    hir_node_count: usize,
    ir_function_count: usize,
    generated_source_bytes: usize,
    lexer_fingerprint: u64,
    parser_fingerprint: u64,
    hir_fingerprint: u64,
    ir_fingerprint: u64,
    codegen_fingerprint: u64,
    native_parser_attempted: bool,
    native_parser_succeeded: bool,
    native_ast_lowered: bool,
    succeeded: bool
}

proc native_pipeline_parser_severity(kind: ParserDiagnosticKind) -> CliDiagnosticSeverity {
    match kind {
        case ParserDiagnosticKind.Note => return CliDiagnosticSeverity.Note;
        case ParserDiagnosticKind.Help => return CliDiagnosticSeverity.Help;
        case ParserDiagnosticKind.Warning => return CliDiagnosticSeverity.Warning;
        case ParserDiagnosticKind.Error => return CliDiagnosticSeverity.Error;
        else => return CliDiagnosticSeverity.Error;
    }
}

proc native_pipeline_sema_severity(kind: SemaDiagnosticKind) -> CliDiagnosticSeverity {
    match kind {
        case SemaDiagnosticKind.Note => return CliDiagnosticSeverity.Note;
        case SemaDiagnosticKind.Help => return CliDiagnosticSeverity.Help;
        case SemaDiagnosticKind.Warning => return CliDiagnosticSeverity.Warning;
        case SemaDiagnosticKind.Error => return CliDiagnosticSeverity.Error;
        else => return CliDiagnosticSeverity.Error;
    }
}

proc native_pipeline_parser_code(error: ParserError) -> string {
    match error {
        case ParserError.ExpectedToken => return "VITTE_PARSER_E_EXPECTED_TOKEN";
        case ParserError.ExpectedIdentifier => return "VITTE_PARSER_E_EXPECTED_TOKEN";
        case ParserError.ExpectedExpression => return "VITTE_PARSER_E_EXPECTED_EXPRESSION";
        case ParserError.ExpectedType => return "VITTE_PARSER_E_EXPECTED_TYPE";
        case ParserError.ExpectedDeclaration => return "VITTE_PARSER_E_EXPECTED_DECLARATION";
        case ParserError.UnexpectedToken => return "VITTE_PARSER_E_UNEXPECTED_TOKEN";
        case ParserError.ExpectedStatement => return "VITTE_PARSER_E_UNEXPECTED_TOKEN";
        case ParserError.Unsupported => return "VITTE_PARSER_E_UNSUPPORTED_SYNTAX";
        case ParserError.InvalidModulePath => return "VITTE_PARSER_E_INVALID_MODULE_PATH";
        case ParserError.DuplicateModuleHeader => return "VITTE_PARSER_E_DUPLICATE_MODULE_HEADER";
        case ParserError.MisplacedModuleHeader => return "VITTE_PARSER_E_MISPLACED_MODULE_HEADER";
        case ParserError.InvalidUseDeclaration => return "VITTE_PARSER_E_INVALID_USE_DECLARATION";
        case ParserError.InvalidUseAlias => return "VITTE_PARSER_E_INVALID_USE_ALIAS";
        case ParserError.InvalidImportGroup => return "VITTE_PARSER_E_INVALID_IMPORT_GROUP";
        case ParserError.InvalidGlobImport => return "VITTE_PARSER_E_INVALID_GLOB_IMPORT";
        case ParserError.InvalidExportClause => return "VITTE_PARSER_E_INVALID_EXPORT_CLAUSE";
        case ParserError.EmptyExportGroup => return "VITTE_PARSER_E_EMPTY_EXPORT_GROUP";
        case ParserError.InvalidExportAlias => return "VITTE_PARSER_E_INVALID_EXPORT_ALIAS";
        case ParserError.TrailingTokens => return "VITTE_PARSER_E_TRAILING_TOKENS";
        case ParserError.MissingModuleHeader => return "VITTE_PARSER_E_MISSING_MODULE_HEADER";
        case ParserError.InvalidValueDeclaration => return "VITTE_PARSER_E_INVALID_VALUE_DECLARATION";
        case ParserError.MissingValueInitializer => return "VITTE_PARSER_E_MISSING_VALUE_INITIALIZER";
        case ParserError.InvalidTypeDeclaration => return "VITTE_PARSER_E_INVALID_TYPE_DECLARATION";
        case ParserError.InvalidOpaqueDeclaration => return "VITTE_PARSER_E_INVALID_OPAQUE_DECLARATION";
        case ParserError.InvalidFormDeclaration => return "VITTE_PARSER_E_INVALID_FORM_DECLARATION";
        case ParserError.DuplicateFormField => return "VITTE_PARSER_E_DUPLICATE_FORM_FIELD";
        case ParserError.InvalidFormFieldSeparator => return "VITTE_PARSER_E_INVALID_FORM_FIELD_SEPARATOR";
        case ParserError.InvalidPickDeclaration => return "VITTE_PARSER_E_INVALID_PICK_DECLARATION";
        case ParserError.DuplicatePickVariant => return "VITTE_PARSER_E_DUPLICATE_PICK_VARIANT";
        case ParserError.InvalidPickVariantPayload => return "VITTE_PARSER_E_INVALID_PICK_VARIANT_PAYLOAD";
        case ParserError.InvalidTraitDeclaration => return "VITTE_PARSER_E_INVALID_TRAIT_DECLARATION";
        case ParserError.InvalidImplDeclaration => return "VITTE_PARSER_E_INVALID_IMPL_DECLARATION";
        case ParserError.MissingImplTargetType => return "VITTE_PARSER_E_MISSING_IMPL_TARGET_TYPE";
        case ParserError.InvalidImplForClause => return "VITTE_PARSER_E_INVALID_IMPL_FOR_CLAUSE";
        case ParserError.InvalidProcedureDeclaration => return "VITTE_PARSER_E_INVALID_PROCEDURE_DECLARATION";
        case ParserError.InvalidProcedureParameters => return "VITTE_PARSER_E_INVALID_PROCEDURE_PARAMETERS";
        case ParserError.InvalidProcedureReturnType => return "VITTE_PARSER_E_INVALID_PROCEDURE_RETURN_TYPE";
        case ParserError.InvalidProcedureModifier => return "VITTE_PARSER_E_INVALID_PROCEDURE_MODIFIER";
        case ParserError.InvalidProcedureBodyForm => return "VITTE_PARSER_E_INVALID_PROCEDURE_BODY_FORM";
        case ParserError.InvalidExternalProcedure => return "VITTE_PARSER_E_INVALID_EXTERNAL_PROCEDURE";
        case ParserError.InvalidIntrinsicDeclaration => return "VITTE_PARSER_E_INVALID_INTRINSIC_DECLARATION";
        case ParserError.InvalidAbiStringLiteral => return "VITTE_PARSER_E_INVALID_ABI_STRING_LITERAL";
        case ParserError.InvalidGenericParameterList => return "VITTE_PARSER_E_INVALID_GENERIC_PARAMETER_LIST";
        case ParserError.InvalidConstGenericParameter => return "VITTE_PARSER_E_INVALID_CONST_GENERIC_PARAMETER";
        case ParserError.InvalidGenericBound => return "VITTE_PARSER_E_INVALID_GENERIC_BOUND";
        case ParserError.InvalidWhereClause => return "VITTE_PARSER_E_INVALID_WHERE_CLAUSE";
        case ParserError.InvalidRequiresClause => return "VITTE_PARSER_E_INVALID_REQUIRES_CLAUSE";
        case ParserError.InvalidEnsuresClause => return "VITTE_PARSER_E_INVALID_ENSURES_CLAUSE";
        case ParserError.InvalidMacroDeclaration => return "VITTE_PARSER_E_INVALID_MACRO_DECLARATION";
        case ParserError.InvalidMacroParameters => return "VITTE_PARSER_E_INVALID_MACRO_PARAMETERS";
        case ParserError.InvalidTestDeclaration => return "VITTE_PARSER_E_INVALID_TEST_DECLARATION";
        case ParserError.InvalidDeclarationModifierOrder => return "VITTE_PARSER_E_INVALID_DECLARATION_MODIFIER_ORDER";
        case ParserError.InvalidAttribute => return "VITTE_PARSER_E_INVALID_ATTRIBUTE";
        case ParserError.InvalidAttributeName => return "VITTE_PARSER_E_INVALID_ATTRIBUTE_NAME";
        case ParserError.InvalidAttributeArguments => return "VITTE_PARSER_E_INVALID_ATTRIBUTE_ARGUMENTS";
        case ParserError.MissingAttributeValue => return "VITTE_PARSER_E_MISSING_ATTRIBUTE_VALUE";
        case ParserError.InvalidAttributeLiteral => return "VITTE_PARSER_E_INVALID_ATTRIBUTE_LITERAL";
        case ParserError.UnexpectedDeclaration => return "VITTE_PARSER_E_UNEXPECTED_DECLARATION";
        case ParserError.UnexpectedStatement => return "VITTE_PARSER_E_UNEXPECTED_STATEMENT";
        case ParserError.UnexpectedExpression => return "VITTE_PARSER_E_UNEXPECTED_EXPRESSION";
        case ParserError.InvalidProcedureType => return "VITTE_PARSER_E_INVALID_PROCEDURE_TYPE";
        case ParserError.InvalidReferenceType => return "VITTE_PARSER_E_INVALID_REFERENCE_TYPE";
        case ParserError.InvalidPointerType => return "VITTE_PARSER_E_INVALID_POINTER_TYPE";
        case ParserError.InvalidArrayType => return "VITTE_PARSER_E_INVALID_ARRAY_TYPE";
        case ParserError.InvalidSliceType => return "VITTE_PARSER_E_INVALID_SLICE_TYPE";
        case ParserError.InvalidOptionalType => return "VITTE_PARSER_E_INVALID_OPTIONAL_TYPE";
        case ParserError.InvalidTypePath => return "VITTE_PARSER_E_INVALID_TYPE_PATH";
        case ParserError.InvalidGenericArguments => return "VITTE_PARSER_E_INVALID_GENERIC_ARGUMENTS";
        case ParserError.InvalidLetStatement => return "VITTE_PARSER_E_INVALID_LET_STATEMENT";
        case ParserError.InvalidSetStatement => return "VITTE_PARSER_E_INVALID_SET_STATEMENT";
        case ParserError.InvalidAssignmentOperator => return "VITTE_PARSER_E_INVALID_ASSIGNMENT_OPERATOR";
        case ParserError.InvalidReturnStatement => return "VITTE_PARSER_E_INVALID_RETURN_STATEMENT";
        case ParserError.InvalidJumpStatement => return "VITTE_PARSER_E_INVALID_JUMP_STATEMENT";
        case ParserError.InvalidDeferStatement => return "VITTE_PARSER_E_INVALID_DEFER_STATEMENT";
        case ParserError.InvalidAssertStatement => return "VITTE_PARSER_E_INVALID_ASSERT_STATEMENT";
        case ParserError.InvalidUnsafeStatement => return "VITTE_PARSER_E_INVALID_UNSAFE_STATEMENT";
        case ParserError.InvalidAsmStatement => return "VITTE_PARSER_E_INVALID_ASM_STATEMENT";
        case ParserError.InvalidControlFlowStatement => return "VITTE_PARSER_E_INVALID_CONTROL_FLOW_STATEMENT";
        case ParserError.InvalidMatchStatement => return "VITTE_PARSER_E_INVALID_MATCH_STATEMENT";
        case ParserError.InvalidMatchArm => return "VITTE_PARSER_E_INVALID_MATCH_ARM";
        case ParserError.InvalidPattern => return "VITTE_PARSER_E_INVALID_PATTERN";
        case ParserError.InvalidRangePattern => return "VITTE_PARSER_E_INVALID_RANGE_PATTERN";
        case ParserError.InvalidAssignmentExpression => return "VITTE_PARSER_E_INVALID_ASSIGNMENT_EXPRESSION";
        case ParserError.InvalidCoalescingExpression => return "VITTE_PARSER_E_INVALID_COALESCING_EXPRESSION";
        case ParserError.InvalidLogicalExpression => return "VITTE_PARSER_E_INVALID_LOGICAL_EXPRESSION";
        case ParserError.InvalidBitwiseExpression => return "VITTE_PARSER_E_INVALID_BITWISE_EXPRESSION";
        case ParserError.InvalidComparisonExpression => return "VITTE_PARSER_E_INVALID_COMPARISON_EXPRESSION";
        case ParserError.InvalidShiftExpression => return "VITTE_PARSER_E_INVALID_SHIFT_EXPRESSION";
        case ParserError.InvalidArithmeticExpression => return "VITTE_PARSER_E_INVALID_ARITHMETIC_EXPRESSION";
        case ParserError.InvalidRangeExpression => return "VITTE_PARSER_E_INVALID_RANGE_EXPRESSION";
        case ParserError.InvalidUnaryExpression => return "VITTE_PARSER_E_INVALID_UNARY_EXPRESSION";
        case ParserError.InvalidCastExpression => return "VITTE_PARSER_E_INVALID_CAST_EXPRESSION";
        case ParserError.InvalidPostfixExpression => return "VITTE_PARSER_E_INVALID_POSTFIX_EXPRESSION";
        case ParserError.InvalidIfExpression => return "VITTE_PARSER_E_INVALID_IF_EXPRESSION";
        case ParserError.InvalidBlockExpression => return "VITTE_PARSER_E_INVALID_BLOCK_EXPRESSION";
        case ParserError.InvalidArrayExpression => return "VITTE_PARSER_E_INVALID_ARRAY_EXPRESSION";
        case ParserError.InvalidSizeofExpression => return "VITTE_PARSER_E_INVALID_SIZEOF_EXPRESSION";
        case ParserError.InvalidAlignofExpression => return "VITTE_PARSER_E_INVALID_ALIGNOF_EXPRESSION";
        case ParserError.InvalidNullConstruction => return "VITTE_PARSER_E_INVALID_NULL_CONSTRUCTION";
        case ParserError.InvalidExpressionList => return "VITTE_PARSER_E_INVALID_EXPRESSION_LIST";
        case ParserError.OutOfMemory => return "VITTE_INFRA_E_RESOURCE";
        case ParserError.Overflow => return "VITTE_INFRA_E_RESOURCE";
        case ParserError.NodeLimit => return "VITTE_INFRA_E_RESOURCE";
        case ParserError.DiagnosticLimit => return "VITTE_INFRA_E_RESOURCE";
        case ParserError.RecursionLimit => return "VITTE_INFRA_E_RESOURCE";
        case ParserError.InvalidToken => return "VITTE_INFRA_E_INVARIANT";
        case ParserError.InvalidNode => return "VITTE_INFRA_E_INVARIANT";
        case ParserError.Validation => return "VITTE_INFRA_E_INVARIANT";
        case ParserError.Corruption => return "VITTE_INFRA_E_INVARIANT";
        else => return "VITTE_INFRA_E_INTERNAL";
    }
}

proc native_pipeline_sema_code(code: SemaDiagnosticCode) -> string {
    match code {
        case SemaDiagnosticCode.UnresolvedName => return "VITTE_RESOLVE_E_UNKNOWN_SYMBOL";
        case SemaDiagnosticCode.AmbiguousName => return "VITTE_RESOLVE_E_AMBIGUOUS_SYMBOL";
        case SemaDiagnosticCode.DuplicateImport => return "VITTE_IMPORT_E_DUPLICATE";
        case SemaDiagnosticCode.PrivateSymbol => return "VITTE_RESOLVE_E_PRIVATE";
        case SemaDiagnosticCode.DuplicateDeclaration => return "VITTE_RESOLVE_E_REDECLARATION";
        case SemaDiagnosticCode.InvalidScope => return "VITTE_RESOLVE_E_INVALID_SCOPE";
        case SemaDiagnosticCode.DuplicateBinding => return "VITTE_RESOLVE_E_DUPLICATE_BINDING";
        case SemaDiagnosticCode.InvalidExport => return "VITTE_RESOLVE_E_INVALID_EXPORT";
        case SemaDiagnosticCode.ShadowedDeclaration => return "VITTE_WARNING_SHADOWING";
        case SemaDiagnosticCode.NotCallable => return "VITTE_TYPE_E_NOT_CALLABLE";
        case SemaDiagnosticCode.InvalidArgumentCount => return "VITTE_CALL_E_ARITY";
        case SemaDiagnosticCode.InvalidArgumentType => return "VITTE_CALL_E_ARGUMENT_TYPE";
        case SemaDiagnosticCode.UnknownType => return "VITTE_TYPE_E_UNKNOWN_TYPE";
        case SemaDiagnosticCode.NotAType => return "VITTE_TYPE_E_NOT_A_TYPE";
        case SemaDiagnosticCode.InvalidCast => return "VITTE_TYPE_E_INVALID_CAST";
        case SemaDiagnosticCode.NotAValue => return "VITTE_TYPE_E_NOT_A_VALUE";
        case SemaDiagnosticCode.IncompleteType => return "VITTE_TYPE_E_INCOMPLETE";
        case SemaDiagnosticCode.RecursiveType => return "VITTE_TYPE_E_RECURSIVE";
        case SemaDiagnosticCode.GenericBoundUnsatisfied => return "VITTE_GENERIC_E_BOUND";
        case SemaDiagnosticCode.GenericArgumentCount => return "VITTE_GENERIC_E_ARGUMENT_COUNT";
        case SemaDiagnosticCode.GenericArgumentKind => return "VITTE_GENERIC_E_ARGUMENT_KIND";
        case SemaDiagnosticCode.GenericInferenceConflict => return "VITTE_GENERIC_E_INFERENCE_CONFLICT";
        case SemaDiagnosticCode.TraitNotImplemented => return "VITTE_TRAIT_E_NOT_IMPLEMENTED";
        case SemaDiagnosticCode.AmbiguousImpl => return "VITTE_TRAIT_E_AMBIGUOUS_IMPL";
        case SemaDiagnosticCode.ConflictingImpl => return "VITTE_TRAIT_E_CONFLICTING_IMPL";
        case SemaDiagnosticCode.MissingTraitMember => return "VITTE_TRAIT_E_MISSING_MEMBER";
        case SemaDiagnosticCode.InvalidTraitMember => return "VITTE_TRAIT_E_INVALID_MEMBER";
        case SemaDiagnosticCode.InvalidImplTarget => return "VITTE_TRAIT_E_INVALID_IMPL_TARGET";
        case SemaDiagnosticCode.InvalidWherePredicate => return "VITTE_TRAIT_E_INVALID_WHERE_PREDICATE";
        case SemaDiagnosticCode.AmbiguousMethod => return "VITTE_TRAIT_E_AMBIGUOUS_METHOD";
        case SemaDiagnosticCode.InvalidRequiresClause => return "VITTE_CONTRACT_E_REQUIRES";
        case SemaDiagnosticCode.InvalidEnsuresClause => return "VITTE_CONTRACT_E_ENSURES";
        case SemaDiagnosticCode.OldValueUnavailable => return "VITTE_CONTRACT_E_OLD_VALUE";
        case SemaDiagnosticCode.ResultUnavailable => return "VITTE_CONTRACT_E_RESULT";
        case SemaDiagnosticCode.ConstantNotConstant => return "VITTE_CONST_E_NOT_CONSTANT";
        case SemaDiagnosticCode.ConstantOverflow => return "VITTE_CONST_E_OVERFLOW";
        case SemaDiagnosticCode.ConstantDivideByZero => return "VITTE_CONST_E_DIVIDE_BY_ZERO";
        case SemaDiagnosticCode.ConstantRemainderByZero => return "VITTE_CONST_E_REMAINDER_BY_ZERO";
        case SemaDiagnosticCode.InvalidUnaryOperand => return "VITTE_TYPE_E_INVALID_OPERAND";
        case SemaDiagnosticCode.InvalidBinaryOperands => return "VITTE_TYPE_E_INVALID_OPERAND";
        case SemaDiagnosticCode.NotAssignable => return "VITTE_TYPE_E_NOT_ASSIGNABLE";
        case SemaDiagnosticCode.NotIndexable => return "VITTE_TYPE_E_NOT_INDEXABLE";
        case SemaDiagnosticCode.InvalidIndexType => return "VITTE_TYPE_E_INVALID_INDEX";
        case SemaDiagnosticCode.UnknownMember => return "VITTE_TYPE_E_NO_MEMBER";
        case SemaDiagnosticCode.ConditionNotBool => return "VITTE_TYPE_E_CONDITION_NOT_BOOL";
        case SemaDiagnosticCode.ReturnTypeMismatch => return "VITTE_CALL_E_RETURN_TYPE";
        case SemaDiagnosticCode.InvalidProcedureParameter => return "VITTE_CALL_E_PARAMETER";
        case SemaDiagnosticCode.ReturnOutsideProc => return "VITTE_CALL_E_RETURN_OUTSIDE_PROC";
        case SemaDiagnosticCode.BreakOutsideLoop => return "VITTE_CONTROL_E_INVALID_BREAK";
        case SemaDiagnosticCode.ContinueOutsideLoop => return "VITTE_CONTROL_E_INVALID_CONTINUE";
        case SemaDiagnosticCode.UnreachableCode => return "VITTE_WARNING_UNREACHABLE_CODE";
        case SemaDiagnosticCode.MissingReturn => return "VITTE_CONTROL_E_MISSING_RETURN";
        case SemaDiagnosticCode.MatchNonExhaustive => return "VITTE_PATTERN_E_NON_EXHAUSTIVE";
        case SemaDiagnosticCode.MatchUnreachable => return "VITTE_PATTERN_E_UNREACHABLE";
        case SemaDiagnosticCode.MatchType => return "VITTE_PATTERN_E_TYPE";
        case SemaDiagnosticCode.InvalidDeferredControlFlow => return "VITTE_CONTROL_E_INVALID_DEFER";
        case SemaDiagnosticCode.OverlappingPattern => return "VITTE_WARNING_OVERLAPPING_PATTERN";
        case SemaDiagnosticCode.RecursionLimit => return "VITTE_INFRA_E_LIMIT";
        case SemaDiagnosticCode.TypeMismatch => return "VITTE_TYPE_E_MISMATCH";
        case SemaDiagnosticCode.InvalidType => return "VITTE_TYPE_E_MISMATCH";
        case SemaDiagnosticCode.InvalidPatternBindings => return "VITTE_PATTERN_E_BINDING";
        case SemaDiagnosticCode.ReferenceEscape => return "VITTE_MEMORY_E_REFERENCE_ESCAPE";
        case SemaDiagnosticCode.BorrowConflict => return "VITTE_MEMORY_E_BORROW_CONFLICT";
        case SemaDiagnosticCode.BorrowedMutation => return "VITTE_MEMORY_E_BORROWED_MUTATION";
        case SemaDiagnosticCode.MoveBorrowed => return "VITTE_MEMORY_E_MOVE_BORROWED";
        case SemaDiagnosticCode.UseAfterMove => return "VITTE_MEMORY_E_USE_AFTER_MOVE";
        case SemaDiagnosticCode.CannotInfer => return "VITTE_TYPE_E_CANNOT_INFER";
        case SemaDiagnosticCode.UnsafeRequired => return "VITTE_UNSAFE_E_REQUIRED";
        case SemaDiagnosticCode.InvalidAsm => return "VITTE_UNSAFE_E_INVALID_ASM";
        case SemaDiagnosticCode.FfiAbi => return "VITTE_FFI_E_ABI";
        case SemaDiagnosticCode.FfiType => return "VITTE_FFI_E_TYPE";
        else => return "VITTE_INFRA_E_FALLBACK";
    }
}

proc native_pipeline_codegen_code(error: string) -> string {
    if error == "generated C17 source exceeds the configured output limit" {
        return "VITTE_BACKEND_E_OUTPUT";
    }
    if error == "the native pipeline currently emits only the C17 backend" {
        return "VITTE_BACKEND_E_UNSUPPORTED";
    }
    if native_pipeline_string_contains(error, "unsupported") or
       native_pipeline_string_contains(error, "not supported") or
       native_pipeline_string_contains(error, "cannot be emitted") or
       native_pipeline_string_contains(error, "must be expanded") or
       native_pipeline_string_contains(error, "not implemented") or
       native_pipeline_string_contains(error, "monomorphized") or
       native_pipeline_string_contains(error, "must be lowered") or
       native_pipeline_string_contains(error, "cannot be lowered") or
       native_pipeline_string_contains(error, "needs task lowering") {
        return "VITTE_BACKEND_E_UNSUPPORTED";
    }
    return "VITTE_BACKEND_E_CODEGEN";
}

proc native_pipeline_string_contains(text: string, needle: string) -> bool {
    if needle.len() == 0 { return true; }
    if needle.len() > text.len() { return false; }
    let mut start: usize = 0;
    while start <= text.len() - needle.len() {
        let mut offset: usize = 0;
        while offset < needle.len() and text[start + offset] == needle[offset] {
            set offset += 1;
        }
        if offset == needle.len() { return true; }
        set start += 1;
    }
    return false;
}

proc native_pipeline_codegen_error(error: string) -> CodegenError {
    if error == "generated C17 source exceeds the configured output limit" {
        return CodegenError.OutputLimit;
    }
    if error == "the native pipeline currently emits only the C17 backend" {
        return CodegenError.Unsupported;
    }
    if native_pipeline_string_contains(error, "unsupported") or
       native_pipeline_string_contains(error, "not supported") or
       native_pipeline_string_contains(error, "cannot be emitted") or
       native_pipeline_string_contains(error, "must be expanded") or
       native_pipeline_string_contains(error, "not implemented") or
       native_pipeline_string_contains(error, "monomorphized") or
       native_pipeline_string_contains(error, "must be lowered") or
       native_pipeline_string_contains(error, "cannot be lowered") or
       native_pipeline_string_contains(error, "needs task lowering") {
        return CodegenError.Unsupported;
    }
    return CodegenError.Backend;
}

proc native_pipeline_codegen_origin(error: string) -> CliDiagnosticOrigin {
    if error == "generated C17 source exceeds the configured output limit" {
        return CliDiagnosticOrigin.Io;
    }
    return CliDiagnosticOrigin.C17Backend;
}

form NativePipelineEmitResult {
    success: bool,
    source: string,
    error: string,
    help: string,
    diagnostic_code: *const char,
    diagnostic_origin: CliDiagnosticOrigin,
    codegen_error: CodegenError,
    has_source_span: bool,
    source_span: ParserSpan
}

proc native_pipeline_emit_failure(
    error: string,
    code: *const char,
    origin: CliDiagnosticOrigin,
    codegen_error: CodegenError
) -> NativePipelineEmitResult {
    return NativePipelineEmitResult {
        success: false,
        source: "",
        error: error,
        help: "",
        diagnostic_code: code,
        diagnostic_origin: origin,
        codegen_error: codegen_error,
        has_source_span: false,
        source_span: ParserSpan { file_id: 0, begin: 0, end: 0, line: 0, column: 0, valid: false }
    };
}

proc native_pipeline_sema_failure(error: SemaError, initialization: bool) -> NativePipelineEmitResult {
    if initialization {
        return native_pipeline_emit_failure(
            "semantic analysis could not acquire required resources",
            native_pipeline_c_string("VITTE_INFRA_E_RESOURCE"),
            CliDiagnosticOrigin.Internal,
            CodegenError.OutOfMemory
        );
    }
    if error == SemaError.OutOfMemory or error == SemaError.Overflow or
       error == SemaError.TypeLimit or error == SemaError.DiagnosticLimit or
       error == SemaError.RecursionLimit {
        return native_pipeline_emit_failure(
            "compiler resource failure during semantic analysis",
            native_pipeline_c_string("VITTE_INFRA_E_RESOURCE"),
            CliDiagnosticOrigin.Internal,
            CodegenError.OutOfMemory
        );
    }
    if error == SemaError.InvalidAst or error == SemaError.InvalidScope or
       error == SemaError.InvalidType or error == SemaError.Validation or
       error == SemaError.Corruption {
        return native_pipeline_emit_failure(
            "compiler invariant failed during semantic analysis",
            native_pipeline_c_string("VITTE_INFRA_E_INVARIANT"),
            CliDiagnosticOrigin.Internal,
            CodegenError.Corruption
        );
    }
    return native_pipeline_emit_failure(
        "internal compiler failure during semantic analysis",
        native_pipeline_c_string("VITTE_INFRA_E_INTERNAL"),
        CliDiagnosticOrigin.Internal,
        CodegenError.Internal
    );
}

proc native_pipeline_ir_error_description(error: IRError) -> string {
    match error {
        case IRError.InvalidArgument => return "an IR operation received invalid arguments";
        case IRError.InvalidContext => return "the IR context is invalid or has been destroyed";
        case IRError.InvalidState => return "the IR context is in a state that does not allow this operation";
        case IRError.InvalidString => return "an IR string reference is invalid";
        case IRError.InvalidType => return "an IR type is invalid or unsupported by this operation";
        case IRError.InvalidValue => return "an IR value is missing or invalid";
        case IRError.InvalidInstruction => return "an instruction violates its opcode or operand contract";
        case IRError.InvalidBlock => return "a control-flow block is invalid";
        case IRError.InvalidFunction => return "a function signature, parameter, or body is invalid";
        case IRError.TypeMismatch => return "IR operand, result, or function types do not agree";
        case IRError.Duplicate => return "an IR entity or control-flow edge is duplicated";
        case IRError.TerminatedBlock => return "an instruction was added after the block terminator";
        case IRError.MissingTerminator => return "a completed basic block has no valid terminator";
        case IRError.InvalidCfg => return "control-flow targets and predecessor/successor edges do not agree";
        case IRError.InvalidPhi => return "a phi node does not match its block predecessors";
        case IRError.Limit => return "the configured IR resource limit was reached";
        case IRError.Overflow => return "an IR size or identifier calculation overflowed";
        case IRError.OutOfMemory => return "memory could not be allocated for IR construction";
        case IRError.Validation => return "the IR validator rejected the generated representation";
        case IRError.Corruption => return "an IR storage or ownership invariant is inconsistent";
        case IRError.Unsupported => return "this source construct has no implementation in native IR lowering";
        case IRError.Internal => return "an internal IR operation failed";
        case IRError.None => return "no IR error was recorded";
        case IRError.Count => return "the IR error value is outside the supported range";
    }
    return "an unknown IR failure occurred";
}

proc native_pipeline_ir_error_help(error: IRError, verification: bool) -> string {
    if error == IRError.Unsupported {
        return "This construct is not supported by native IR lowering yet. Use a supported construct, or report the missing feature with a minimal example."
    }
    if error == IRError.Limit or error == IRError.OutOfMemory or error == IRError.Overflow {
        return "Reduce the source size or compilation workload, then retry. If the input is small and reproducible, report the compiler version and this IR error."
    }
    if verification or error == IRError.InvalidCfg or error == IRError.InvalidPhi or
       error == IRError.InvalidInstruction or error == IRError.Corruption or
       error == IRError.MissingTerminator or error == IRError.TerminatedBlock {
        return "The compiler generated IR that failed an internal invariant. Report the smallest reproducing source, compiler version, and this error name."
    }
    if error == IRError.TypeMismatch or error == IRError.InvalidType or error == IRError.InvalidValue {
        return "Check that the source types and operations are valid. If they are, report the smallest reproducing source and this IR error as a compiler bug."
    }
    return "Report the smallest reproducing source, compiler version, and this IR error so the failing compiler phase can be diagnosed."
}

proc native_pipeline_hir_failure(error: HIRError, validation: bool) -> NativePipelineEmitResult {
    let effective_error: HIRError = if error == HIRError.None {
        if validation { HIRError.Validation } else { HIRError.Internal }
    } else { error };
    if effective_error == HIRError.Unsupported {
        return native_pipeline_emit_failure(
            "source construct is not supported by HIR lowering",
            native_pipeline_c_string("VITTE_HIR_E_UNSUPPORTED"),
            CliDiagnosticOrigin.Hir,
            CodegenError.Unsupported
        );
    }
    if effective_error == HIRError.OutOfMemory or effective_error == HIRError.Overflow or
       effective_error == HIRError.TooManyNodes or effective_error == HIRError.TooManySymbols or
       effective_error == HIRError.TooManyTypes or effective_error == HIRError.StringLimit or
       effective_error == HIRError.RecursionLimit {
        return native_pipeline_emit_failure(
            "compiler resource failure during HIR lowering",
            native_pipeline_c_string("VITTE_INFRA_E_RESOURCE"),
            CliDiagnosticOrigin.Internal,
            CodegenError.OutOfMemory
        );
    }
    if effective_error == HIRError.Internal or effective_error == HIRError.InvalidContext or
       effective_error == HIRError.InvalidState or effective_error == HIRError.InvalidArgument {
        return native_pipeline_emit_failure(
            "internal compiler failure during HIR lowering",
            native_pipeline_c_string("VITTE_INFRA_E_INTERNAL"),
            CliDiagnosticOrigin.Internal,
            CodegenError.Internal
        );
    }
    if validation or effective_error == HIRError.Validation or effective_error == HIRError.Corruption {
        return native_pipeline_emit_failure(
            "compiler produced invalid HIR",
            native_pipeline_c_string("VITTE_HIR_E_INVALID"),
            CliDiagnosticOrigin.Hir,
            CodegenError.Corruption
        );
    }
    return native_pipeline_emit_failure(
        "HIR lowering failed",
        native_pipeline_c_string("VITTE_HIR_E_LOWERING"),
        CliDiagnosticOrigin.Hir,
        CodegenError.Backend
    );
}

proc native_pipeline_ir_failure(error: IRError, verification: bool) -> NativePipelineEmitResult {
    let effective_error: IRError = if error == IRError.None {
        if verification { IRError.Validation } else { IRError.Internal }
    } else { error };
    if effective_error == IRError.Unsupported {
        return native_pipeline_emit_failure(
            "source construct is not supported by IR lowering",
            native_pipeline_c_string("VITTE_IR_E_UNSUPPORTED"),
            CliDiagnosticOrigin.Ir,
            CodegenError.Unsupported
        );
    }
    if effective_error == IRError.OutOfMemory or effective_error == IRError.Overflow or
       effective_error == IRError.Limit {
        return native_pipeline_emit_failure(
            "compiler resource failure during IR lowering",
            native_pipeline_c_string("VITTE_INFRA_E_RESOURCE"),
            CliDiagnosticOrigin.Internal,
            CodegenError.OutOfMemory
        );
    }
    if effective_error == IRError.Internal or effective_error == IRError.InvalidContext or
       effective_error == IRError.InvalidState or effective_error == IRError.InvalidArgument {
        return native_pipeline_emit_failure(
            "internal compiler failure during IR lowering",
            native_pipeline_c_string("VITTE_INFRA_E_INTERNAL"),
            CliDiagnosticOrigin.Internal,
            CodegenError.Internal
        );
    }
    if verification or effective_error == IRError.Validation or effective_error == IRError.Corruption or
       effective_error == IRError.InvalidCfg or effective_error == IRError.InvalidPhi or
       effective_error == IRError.InvalidInstruction or effective_error == IRError.MissingTerminator or
       effective_error == IRError.TerminatedBlock {
        let mut result = native_pipeline_emit_failure(
            "IR verification failed",
            native_pipeline_c_string("VITTE_IR_E_VERIFY"),
            CliDiagnosticOrigin.Ir,
            CodegenError.Corruption
        );
        set result.help = native_pipeline_ir_error_help(effective_error, true);
        return result;
    }
    let mut result = native_pipeline_emit_failure(
        "IR lowering failed",
        native_pipeline_c_string("VITTE_IR_E_LOWERING"),
        CliDiagnosticOrigin.Ir,
        CodegenError.Backend
    );
    set result.help = native_pipeline_ir_error_help(effective_error, false);
    return result;
}

proc native_pipeline_export_cli_diagnostic(
    batch: *mut u8,
    count: usize,
    index: usize,
    diagnostic_id: u64,
    code: *const char,
    severity: CliDiagnosticSeverity,
    origin: CliDiagnosticOrigin,
    message: *const char,
    details: *const char,
    help: *const char,
    has_span: bool,
    file_id: u32,
    source_id: u64,
    source_name: *const char,
    begin: usize,
    end: usize,
    source: str,
    expected: *const char,
    found: *const char
) -> bool {
    let mut start_line: usize = 0;
    let mut start_column: usize = 0;
    let mut end_line: usize = 0;
    let mut end_column: usize = 0;
    let mut location_valid = has_span and begin <= end and end <= source.length;
    if location_valid {
        let mut scanner: Scanner;
        if vitte_scanner_init(&mut scanner, source, source.length, file_id) {
            let _ = vitte_scanner_set_strict_utf8(&mut scanner, false);
            let mut start_position: ScannerPosition;
            let mut end_position: ScannerPosition;
            if vitte_scanner_position_at(&mut scanner, begin, &mut start_position) &&
               vitte_scanner_position_at(&mut scanner, end, &mut end_position) {
                set start_line = start_position.line - 1;
                set start_column = start_position.column - 1;
                set end_line = end_position.line - 1;
                set end_column = end_position.column - 1;
            } else {
                set location_valid = false;
            }
            vitte_scanner_destroy(&mut scanner);
        } else {
            set location_valid = false;
        }
    }
    return vitte_cli_diagnostic_transport_set(
        batch,
        count,
        index,
        diagnostic_id,
        code,
        severity as u32,
        origin as u32,
        message,
        details,
        help,
        location_valid,
        file_id,
        source_id,
        source_name,
        if location_valid { begin } else { 0 as usize },
        if location_valid { end } else { 0 as usize },
        start_line,
        start_column,
        end_line,
        end_column,
        expected,
        found
    );
}

