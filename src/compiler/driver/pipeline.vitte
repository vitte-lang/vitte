        case ParserError.MissingModuleHeader => return "missing module header";
        case ParserError.InvalidValueDeclaration => return "malformed const or static declaration";
        case ParserError.MissingValueInitializer => return "missing const or static initializer";
        case ParserError.InvalidTypeDeclaration => return "malformed type declaration";
        case ParserError.InvalidOpaqueDeclaration => return "malformed opaque declaration";
