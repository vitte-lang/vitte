/// Native, arena-backed abstract syntax tree primitives.
///
/// The parser's transitional node table remains in parser.vitte. This module
/// implements the standalone AST contract used by later native frontend
/// stages; its storage belongs to an externally owned arena context.

space compiler::ast::ast;

use compiler::arena::arena::{
    ArenaContext,
    arena_context_alloc_aligned,
    arena_context_is_valid,
};
use vitte::core::memory::{copy, fill};
use vitte::core::pointer;

export type ASTFlags = u32;
export type ASTNodeId = u64;
export type AstNodeFlags = u64;

/// Parser modifier flags retained for the current parser API.
pub const AST_FLAG_NONE: ASTFlags = 0 as ASTFlags;
pub const AST_FLAG_PUBLIC: ASTFlags = ((1 as ASTFlags) << 0) as ASTFlags;
pub const AST_FLAG_MUTABLE: ASTFlags = ((1 as ASTFlags) << 1) as ASTFlags;
pub const AST_FLAG_EXTERN: ASTFlags = ((1 as ASTFlags) << 2) as ASTFlags;
pub const AST_FLAG_ASYNC: ASTFlags = ((1 as ASTFlags) << 3) as ASTFlags;
pub const AST_FLAG_UNSAFE: ASTFlags = ((1 as ASTFlags) << 4) as ASTFlags;
pub const AST_FLAG_COMPTIME: ASTFlags = ((1 as ASTFlags) << 5) as ASTFlags;
pub const AST_FLAG_CONTRACT_REQUIRES: ASTFlags = ((1 as ASTFlags) << 6) as ASTFlags;
pub const AST_FLAG_CONTRACT_ENSURES: ASTFlags = ((1 as ASTFlags) << 7) as ASTFlags;
pub const AST_FLAG_GLOB_IMPORT: ASTFlags = ((1 as ASTFlags) << 8) as ASTFlags;
pub const AST_FLAG_HAS_ATTRIBUTES: ASTFlags = ((1 as ASTFlags) << 9) as ASTFlags;
pub const AST_FLAG_PATTERN_MUTABLE: ASTFlags = ((1 as ASTFlags) << 10) as ASTFlags;
pub const AST_FLAG_PATTERN_REFERENCE: ASTFlags = ((1 as ASTFlags) << 11) as ASTFlags;
pub const AST_FLAG_PATTERN_HEAD: ASTFlags = ((1 as ASTFlags) << 12) as ASTFlags;
pub const AST_FLAG_PATTERN_OR: ASTFlags = ((1 as ASTFlags) << 13) as ASTFlags;
pub const AST_FLAG_PATTERN_RANGE: ASTFlags = ((1 as ASTFlags) << 14) as ASTFlags;
pub const AST_FLAG_ALL_KNOWN: ASTFlags = (((1 as ASTFlags) << 15) - 1) as ASTFlags;

/// Flags stored on arena-backed AstNode values.
pub const AST_NODE_FLAG_NONE: AstNodeFlags = 0 as AstNodeFlags;
pub const AST_NODE_FLAG_INVALID: AstNodeFlags = ((1 as AstNodeFlags) << 0) as AstNodeFlags;
pub const AST_NODE_FLAG_SYNTHETIC: AstNodeFlags = ((1 as AstNodeFlags) << 1) as AstNodeFlags;
pub const AST_NODE_FLAG_PUBLIC: AstNodeFlags = ((1 as AstNodeFlags) << 2) as AstNodeFlags;
pub const AST_NODE_FLAG_EXPORT: AstNodeFlags = ((1 as AstNodeFlags) << 3) as AstNodeFlags;
pub const AST_NODE_FLAG_ASYNC: AstNodeFlags = ((1 as AstNodeFlags) << 4) as AstNodeFlags;
pub const AST_NODE_FLAG_UNSAFE: AstNodeFlags = ((1 as AstNodeFlags) << 5) as AstNodeFlags;
pub const AST_NODE_FLAG_COMPTIME: AstNodeFlags = ((1 as AstNodeFlags) << 6) as AstNodeFlags;
pub const AST_NODE_FLAG_MUTABLE: AstNodeFlags = ((1 as AstNodeFlags) << 7) as AstNodeFlags;
pub const AST_NODE_FLAG_EXTERN: AstNodeFlags = ((1 as AstNodeFlags) << 8) as AstNodeFlags;
pub const AST_NODE_FLAG_INTRINSIC: AstNodeFlags = ((1 as AstNodeFlags) << 9) as AstNodeFlags;
pub const AST_NODE_FLAG_TEST: AstNodeFlags = ((1 as AstNodeFlags) << 10) as AstNodeFlags;
pub const AST_NODE_FLAG_IMPLICIT: AstNodeFlags = ((1 as AstNodeFlags) << 11) as AstNodeFlags;
pub const AST_NODE_FLAG_RECOVERED: AstNodeFlags = ((1 as AstNodeFlags) << 12) as AstNodeFlags;
pub const AST_NODE_FLAG_GENERATED: AstNodeFlags = ((1 as AstNodeFlags) << 13) as AstNodeFlags;
pub const AST_NODE_FLAG_GLOB_IMPORT: AstNodeFlags = ((1 as AstNodeFlags) << 14) as AstNodeFlags;
pub const AST_NODE_FLAG_TYPE_ALIAS: AstNodeFlags = ((1 as AstNodeFlags) << 15) as AstNodeFlags;
pub const AST_NODE_FLAG_FUNCTION_TYPE_HAS_RETURN: AstNodeFlags = ((1 as AstNodeFlags) << 16) as AstNodeFlags;
pub const AST_NODE_FLAG_TYPE_QUERY_TYPE_OPERAND: AstNodeFlags = ((1 as AstNodeFlags) << 17) as AstNodeFlags;
pub const AST_NODE_FLAG_HAS_ATTRIBUTES: AstNodeFlags = ((1 as AstNodeFlags) << 18) as AstNodeFlags;
pub const AST_NODE_FLAG_CONTRACT_REQUIRES: AstNodeFlags = ((1 as AstNodeFlags) << 19) as AstNodeFlags;
pub const AST_NODE_FLAG_CONTRACT_ENSURES: AstNodeFlags = ((1 as AstNodeFlags) << 20) as AstNodeFlags;
pub const AST_NODE_FLAG_PATTERN_MUTABLE: AstNodeFlags = ((1 as AstNodeFlags) << 21) as AstNodeFlags;
pub const AST_NODE_FLAG_PATTERN_REFERENCE: AstNodeFlags = ((1 as AstNodeFlags) << 22) as AstNodeFlags;
pub const AST_NODE_FLAG_PATTERN_HEAD: AstNodeFlags = ((1 as AstNodeFlags) << 23) as AstNodeFlags;
pub const AST_NODE_FLAG_PATTERN_OR: AstNodeFlags = ((1 as AstNodeFlags) << 24) as AstNodeFlags;
pub const AST_NODE_FLAG_PATTERN_RANGE: AstNodeFlags = ((1 as AstNodeFlags) << 25) as AstNodeFlags;
pub const AST_NODE_FLAG_PATTERN_STRUCT: AstNodeFlags = ((1 as AstNodeFlags) << 26) as AstNodeFlags;
pub const AST_NODE_FLAG_ALL_KNOWN: AstNodeFlags = (((1 as AstNodeFlags) << 27) - 1) as AstNodeFlags;

const AST_MAGIC: u64 = 0x5649545445415354;
const AST_DEAD_MAGIC: u64 = 0x4445414441535421;
const AST_NODE_MAGIC: u64 = 0x56495454454E4F44;
const AST_NODE_DEAD_MAGIC: u64 = 0x444541444E4F4445;
const AST_INITIAL_CHILD_CAPACITY: usize = 4;
const AST_INITIAL_ATTRIBUTE_CAPACITY: usize = 2;
const AST_MAX_DEPTH: usize = 65536;

proc ast_configuration_valid() -> bool {
    return AST_INITIAL_CHILD_CAPACITY != 0 and
           AST_INITIAL_ATTRIBUTE_CAPACITY != 0 and
           AST_MAX_DEPTH != 0;
}

export form AstSpan {
    file_id: u32,
    begin: usize,
    end: usize,

    source_id: u64,
    source_name: string,

    start_offset: usize,
    end_offset: usize,
    start_line: u32,
    start_column: u32,
    end_line: u32,
    end_column: u32,

    valid: bool,
}

