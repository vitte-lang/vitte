/// Native Vitte configuration API with records compatible with the bootstrap C ABI.
space compiler::config::config;

use vitte::core::memory::{allocate, copy, deallocate, fill, cstring_length};
use vitte::core::pointer;
use compiler::filesystem::filesystem::{
    FilesystemBuffer,
    FilesystemError,
    vitte_filesystem_buffer_destroy,
    vitte_filesystem_read_file,
};

const VITTE_CONFIG_MAGIC: u64 = 0x564954434F4E4647;
const VITTE_CONFIG_DEAD_MAGIC: u64 = 0x44454144434F4E46;
const VITTE_CONFIG_FNV_OFFSET: u64 = 14695981039346656037;
const VITTE_CONFIG_FNV_PRIME: u64 = 1099511628211;
const VITTE_CONFIG_DEFAULT_MAX_ENTRIES: usize = 4096;
const VITTE_CONFIG_DEFAULT_INITIAL_CAPACITY: usize = 32;
const VITTE_CONFIG_DEFAULT_MAX_ERRORS: usize = 100;
const VITTE_CONFIG_DEFAULT_JOBS: usize = 1;
const VITTE_CONFIG_DEFAULT_MAX_OUTPUT_BYTES: usize = 0;
const VITTE_CONFIG_DEFAULT_MAX_STRING_BYTES: usize = 1048576;

export pick ConfigError {
    None,
    InvalidConfig,
    InvalidArgument,
    InvalidState,
    InvalidKey,
    InvalidValue,
    InvalidType,
    InvalidSource,
    UnknownKey,
    DuplicateValue,
    Conflict,
    LowerPrecedence,
    InvalidProfile,
    InvalidBackend,
    InvalidOptimization,
    InvalidDiagnosticFormat,
    InvalidColorMode,
    InvalidTarget,
    TooManyEntries,
    StringTooLong,
    Frozen,
    Overflow,
    OutOfMemory,
    Corruption,
    Count
}

export pick ConfigState {
    Invalid,
    Ready,
    Merging,
    Validated,
    Frozen,
    Failed,
    Destroyed,
    Count
}

export pick ConfigSource {
    Default,
    System,
    User,
    Project,
    Environment,
    CommandLine,
    Override,
    Count
}

export pick ConfigValueType {
    Invalid,
    Bool,
    Size,
    U64,
    String,
    Count
}

export pick ConfigProfile {
    Default,
    Debug,
    Release,
    Size,
    Sanitize,
    Freestanding,
    Count
}

export pick ConfigBackend {
    Default,
    C17,
    Native,
    Bytecode,
    Count
}

export pick ConfigOptimization {
    Default,
    None,
    Debug,
    Balanced,
    Speed,
    Size,
    Aggressive,
    Count
}

export pick ConfigDiagnosticFormat {
    Default,
    Terminal,
    Short,
    Json,
    Sarif,
    Lsp,
    Count
}

export pick ConfigColor {
    Auto,
    Always,
    Never,
    Count
}

export pick ConfigKey {
    Invalid,
    Profile,
    Backend,
    Optimization,
    Target,
    Output,
    ManifestPath,
    ProjectRoot,
    BuildDir,
    CacheDir,
    Sysroot,
    Registry,
    Jobs,
    MaxErrors,
    MaxOutputBytes,
    DiagnosticFormat,
    Color,
    Verbose,
    Quiet,
    WarningsAsErrors,
    EmitDebugInfo,
    EmitSourceMap,
    EmitComments,
    RuntimeChecks,
    BoundsChecks,
    NullChecks,
    OverflowChecks,
    Deterministic,
    Incremental,
    Offline,
    Locked,
    FrozenDependencies,
    Force,
    Count
}

export form ConfigValue {
    type_: ConfigValueType,
    // Mirrors the C union storage in vitte_config_value_t. The active member
    // is selected by type_; strings are stored as pointer bits.
    as_: u64
}

export form ConfigOrigin {
    source: ConfigSource,
    name: *const char,
    line: usize,
    column: usize
}

export form ConfigEntry {
    key: ConfigKey,
    value: ConfigValue,
    origin: ConfigOrigin,
    sequence: u64,
    explicitly_set: bool
}

export form ConfigResolved {
    profile: ConfigProfile,
    backend: ConfigBackend,
    optimization: ConfigOptimization,
    target: *const char,
    output: *const char,
    manifest_path: *const char,
    project_root: *const char,
    build_dir: *const char,
    cache_dir: *const char,
    sysroot: *const char,
    registry: *const char,
    jobs: usize,
    max_errors: usize,
    max_output_bytes: usize,
    diagnostic_format: ConfigDiagnosticFormat,
    color: ConfigColor,
    verbose: bool,
    quiet: bool,
    warnings_as_errors: bool,
    emit_debug_info: bool,
    emit_source_map: bool,
    emit_comments: bool,
    runtime_checks: bool,
    bounds_checks: bool,
    null_checks: bool,
    overflow_checks: bool,
    deterministic: bool,
    incremental: bool,
    offline: bool,
    locked: bool,
    frozen_dependencies: bool,
    force: bool
}

export form ConfigMessage {
    error: ConfigError,
    key: ConfigKey,
    origin: ConfigOrigin,
    detail: *const char
}

export form ConfigStats {
    entry_count: usize,
    explicit_entry_count: usize,
    overridden_entry_count: usize,
    ignored_lower_precedence_count: usize,
    string_entry_count: usize,
    boolean_entry_count: usize,
    numeric_entry_count: usize,
    fingerprint: u64,
    validation_count: usize,
    validated: bool,
    frozen: bool
}

export form Config {
    magic: u64,
    state: ConfigState,
    last_error: ConfigError,
    entries: *mut ConfigEntry,
    entry_count: usize,
    entry_capacity: usize,
    max_entries: usize,
    max_string_bytes: usize,
    resolved: ConfigResolved,
    message: ConfigMessage,
    stats: ConfigStats,
    owned_strings: **mut u8,
    owned_string_count: usize,
    owned_string_capacity: usize,
    next_sequence: u64,
    generation: u64
}

export proc vitte_config_error_name(error: ConfigError) -> string {
    match error {
        case ConfigError.None => return "none";
        case ConfigError.InvalidConfig => return "invalid-config";
        case ConfigError.InvalidArgument => return "invalid-argument";
        case ConfigError.InvalidState => return "invalid-state";
        case ConfigError.InvalidKey => return "invalid-key";
        case ConfigError.InvalidValue => return "invalid-value";
        case ConfigError.InvalidType => return "invalid-type";
        case ConfigError.InvalidSource => return "invalid-source";
        case ConfigError.UnknownKey => return "unknown-key";
        case ConfigError.DuplicateValue => return "duplicate-value";
        case ConfigError.Conflict => return "conflict";
        case ConfigError.LowerPrecedence => return "lower-precedence";
        case ConfigError.InvalidProfile => return "invalid-profile";
        case ConfigError.InvalidBackend => return "invalid-backend";
        case ConfigError.InvalidOptimization => return "invalid-optimization";
        case ConfigError.InvalidDiagnosticFormat => return "invalid-diagnostic-format";
        case ConfigError.InvalidColorMode => return "invalid-color-mode";
        case ConfigError.InvalidTarget => return "invalid-target";
        case ConfigError.TooManyEntries => return "too-many-entries";
        case ConfigError.StringTooLong => return "string-too-long";
        case ConfigError.Frozen => return "frozen";
        case ConfigError.Overflow => return "overflow";
        case ConfigError.OutOfMemory => return "out-of-memory";
        case ConfigError.Corruption => return "corruption";
        case ConfigError.Count => return "count"
    }
    return "invalid";
}

