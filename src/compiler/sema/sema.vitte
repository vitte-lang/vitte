    None,
    InvalidArgument,
    InvalidContext,
    InvalidState,
    InvalidAst,
    InvalidScope,
    InvalidType,
    TypeLimit,
    DiagnosticLimit,
    RecursionLimit,
    Overflow,
    OutOfMemory,
    Validation,
    Corruption,
    Internal,
    Count
}

