export pick SemaError {
    None,
    InvalidArgument,
    InvalidContext,
    InvalidState,
    InvalidAst,
    InvalidScope,
    InvalidType,
    TypeLimit,
    DiagnosticLimit,
    RecursionLimit,
    Overflow,
    OutOfMemory,
    Validation,
    Corruption,
    Internal,
    Count
}

export pick SemaState {
    Invalid,
    Ready,
    Analyzing,
    Done,
    Failed,
    Destroyed,
    Count
}

export pick SemaTypeKind {
    Invalid,
    Error,
    Void,
    Bool,
    I64,
    U64,
    U8,
    F32,
    F64,
    Char,
    String,
    Null,
    Pointer,
    Reference,
    Optional,
    Array,
    Slice,
    Range,
    Function,
    Named,
    Dyn,
    GenericParameter,
    Count
}

export pick SemaTypeConversionKind {
    Incompatible,
    Exact,
    Safe,
    Lossy,
    Count
}

export form SemaType {
    id: SemaTypeId,
    kind: SemaTypeKind,
    element_type: SemaTypeId,
    array_length: usize,
    symbol_id: SymbolId,
    return_type: SemaTypeId,
    is_mutable: bool,
    generic_arguments: *SemaTypeId,
    generic_argument_count: usize,
    function_parameter_types: *SemaTypeId,
    function_parameter_count: usize
}

export pick SemaConstantKind {
    None,
    Integer,
    UnsignedInteger,
    Float,
    Boolean,
    Character,
    String,
    Null,
    Count
}

export form SemaConstantValue {
    // Two words match the largest member of the C tagged union (string span).
    as_: [usize; 2]
}

export form SemaConstant {
    kind: SemaConstantKind,
    value: SemaConstantValue
}

export form SemaNodeInfo {
    node_id: ASTNodeId,
    type_id: SemaTypeId,
    symbol_id: SymbolId,
    scope_id: ScopeId,
    node_flags: SemaNodeFlags,
    constant: SemaConstant
}

export pick SemaDiagnosticKind {
    Note,
    Help,
    Warning,
    Error,
    KindCount
}

export pick SemaTypeContextKind {
    None,
    Expression,
    Argument,
    Field,
    Return,
    Assignment,
    Condition,
    Count
}

export pick SemaDiagnosticCode {
    None,
    UnresolvedName,
    PrivateSymbol,
    DuplicateDeclaration,
    ShadowedDeclaration,
    UnknownType,
    NotAType,
    TypeMismatch,
    InvalidUnaryOperand,
    InvalidBinaryOperands,
    NotAssignable,
    NotCallable,
    InvalidArgumentCount,
    InvalidArgumentType,
    NotIndexable,
    InvalidIndexType,
    UnknownMember,
    ConditionNotBool,
    ReturnOutsideProc,
    ReturnTypeMismatch,
    BreakOutsideLoop,
    ContinueOutsideLoop,
    UnreachableCode,
    RecursionLimit,
    InvalidType,
    InvalidPatternBindings,
    CodeCount
}

export form SemaDiagnostic {
    kind: SemaDiagnosticKind,
    code: SemaDiagnosticCode,
    span: ParserSpan,
    node_id: ASTNodeId,
    symbol_id: SymbolId,
    expected_type: SemaTypeId,
    found_type: SemaTypeId,
    type_context: SemaTypeContextKind,
    context_index: usize,
    context_symbol_id: SymbolId,
    help: [u8; 512]
}

export form SemaStats {
    runs: u64,
    failed_runs: u64,
    failures: u64,
    nodes_visited: u64,
    expressions_checked: u64,
    declarations: u64,
    names_resolved: u64,
    unresolved_names: u64,
    duplicate_declarations: u64,
    shadowing_declarations: u64,
    types_created: u64,
    type_intern_hits: u64,
    calls_checked: u64,
    unreachable_statements: u64,
    diagnostics: u64,
    errors: u64,
    warnings: u64,
    max_recursion_depth: u64,
    validation_runs: u64,
    validation_failures: u64,
    hash_runs: u64,
    allocations: u64,
    reallocations: u64,
    allocation_failures: u64
}

export form Sema {
    magic: u64,
    state: SemaState,
    last_error: SemaError,
    parser: *const Parser,
    scopes: ScopeContext,
    types: *SemaType,
    type_count: usize,
    type_capacity: usize,
    node_info: *SemaNodeInfo,
    node_info_count: usize,
    node_info_capacity: usize,
    diagnostics: *SemaDiagnostic,
    diagnostic_count: usize,
    diagnostic_capacity: usize,
    max_types: usize,
    max_diagnostics: usize,
    max_recursion_depth: usize,
    recursion_depth: usize,
    loop_depth: usize,
    current_return_type: SemaTypeId,
    current_self_type: SemaTypeId,
    current_proc_scope: ScopeId,
    current_contract_ensures: bool,
    type_error: SemaTypeId,
    type_void: SemaTypeId,
    type_bool: SemaTypeId,
    type_i64: SemaTypeId,
    type_u64: SemaTypeId,
    type_u8: SemaTypeId,
    type_f32: SemaTypeId,
    type_f64: SemaTypeId,
    type_char: SemaTypeId,
    type_string: SemaTypeId,
    type_null: SemaTypeId,
    stats: SemaStats,
    generation: u64
}

export type SemaTypeId = u64;

export type SemaNodeFlags = u32;

const SEMA_SIZE_MAX: usize = (0 as usize) - 1;

proc sema_sat_add(left: u64, right: u64) -> u64 {
    if left > 18446744073709551615 - right { return 18446744073709551615; }
    return left + right;
}

proc sema_scope_ptr(context: *mut Sema) -> *mut Scope {
    return (&((*context).scopes)) as *mut Scope;
}

proc sema_context_valid(context: *const Sema) -> bool {
    if context == null or (*context).magic != SEMA_MAGIC { return false; }
    if (*context).state <= SemaState.Invalid or (*context).state >= SemaState.Destroyed { return false; }
    if (*context).parser == null or (*context).max_types == 0 or (*context).max_diagnostics == 0 or (*context).max_recursion_depth == 0 { return false; }
    if (*context).type_count > (*context).type_capacity or (*context).node_info_count > (*context).node_info_capacity or (*context).diagnostic_count > (*context).diagnostic_capacity { return false; }
    if ((*context).type_count != 0 and (*context).types == null) or ((*context).node_info_count != 0 and (*context).node_info == null) or ((*context).diagnostic_count != 0 and (*context).diagnostics == null) { return false; }
    return (*context).type_count <= (*context).max_types and (*context).diagnostic_count <= (*context).max_diagnostics;
}

proc sema_fail(context: *mut Sema, error: SemaError) -> bool {
    if context != null and (*context).magic == SEMA_MAGIC {
        set (*context).last_error = error;
        set (*context).state = SemaState.Failed;
        set (*context).stats.failures = sema_sat_add((*context).stats.failures, 1);
    }
    return false;
}

proc sema_reserve_diagnostics(context: *mut Sema, required: usize) -> bool {
    if required <= (*context).diagnostic_capacity { return true; }
    if required > (*context).max_diagnostics { set (*context).last_error = SemaError.DiagnosticLimit; return false; }
    let mut capacity: usize = if (*context).diagnostic_capacity == 0 { SEMA_DEFAULT_INITIAL_DIAGNOSTIC_CAPACITY } else { (*context).diagnostic_capacity };
    while capacity < required {
        if capacity > SEMA_SIZE_MAX / 2 { set capacity = required; break; }
        set capacity *= 2;
    }
    if capacity > (*context).max_diagnostics { set capacity = (*context).max_diagnostics; }
    if capacity < required or capacity > SEMA_SIZE_MAX / sizeof(SemaDiagnostic) { set (*context).last_error = SemaError.Overflow; return false; }
    let replacement = allocate(capacity * sizeof(SemaDiagnostic));
    if replacement == null { set (*context).stats.allocation_failures = sema_sat_add((*context).stats.allocation_failures, 1); set (*context).last_error = SemaError.OutOfMemory; return false; }
    fill(replacement, 0, capacity * sizeof(SemaDiagnostic));
    if (*context).diagnostics != null and (*context).diagnostic_count != 0 { copy(replacement, (*context).diagnostics as *const u8, (*context).diagnostic_count * sizeof(SemaDiagnostic)); }
    if (*context).diagnostics == null { set (*context).stats.allocations = sema_sat_add((*context).stats.allocations, 1); }
    else { set (*context).stats.reallocations = sema_sat_add((*context).stats.reallocations, 1); }
    deallocate((*context).diagnostics as *mut u8);
    set (*context).diagnostics = replacement as usize as *SemaDiagnostic;
    set (*context).diagnostic_capacity = capacity;
    return true;
}

proc sema_add_type(context: *mut Sema, kind: SemaTypeKind, element: SemaTypeId, array_length: usize, symbol: SymbolId, is_mutable: bool, return_type: SemaTypeId, parameters: *const SemaTypeId, parameter_count: usize) -> SemaTypeId {
    if context == null or (*context).type_count >= (*context).max_types { if context != null { set (*context).last_error = SemaError.TypeLimit; } return 0; }
    let mut index: usize = 0;
    while index < (*context).type_count {
        let candidate = (&((*context).types[index])) as *const SemaType;
        if (*candidate).kind == kind and (*candidate).element_type == element and (*candidate).array_length == array_length and (*candidate).symbol_id == symbol and (*candidate).is_mutable == is_mutable and (*candidate).return_type == return_type and (*candidate).function_parameter_count == parameter_count {
            let mut same = true;
            let mut parameter_index: usize = 0;
            while parameter_index < parameter_count { if (*candidate).function_parameter_types[parameter_index] != parameters[parameter_index] { set same = false; break; } set parameter_index += 1; }
            if same { set (*context).stats.type_intern_hits = sema_sat_add((*context).stats.type_intern_hits, 1); return (*candidate).id; }
        }
        set index += 1;
    }
    if (*context).type_count == (*context).type_capacity {
        let mut capacity: usize = if (*context).type_capacity == 0 { SEMA_DEFAULT_INITIAL_TYPE_CAPACITY } else { (*context).type_capacity * 2 };
        if capacity < (*context).type_count + 1 or capacity > SEMA_SIZE_MAX / sizeof(SemaType) { set (*context).last_error = SemaError.Overflow; return 0; }
        let replacement = allocate(capacity * sizeof(SemaType));
        if replacement == null { set (*context).last_error = SemaError.OutOfMemory; set (*context).stats.allocation_failures = sema_sat_add((*context).stats.allocation_failures, 1); return 0; }
        fill(replacement, 0, capacity * sizeof(SemaType));
        if (*context).types != null { copy(replacement, (*context).types as *const u8, (*context).type_count * sizeof(SemaType)); deallocate((*context).types as *mut u8); set (*context).stats.reallocations = sema_sat_add((*context).stats.reallocations, 1); }
        else { set (*context).stats.allocations = sema_sat_add((*context).stats.allocations, 1); }
        set (*context).types = replacement as usize as *SemaType;
        set (*context).type_capacity = capacity;
    }
    let id = ((*context).type_count + 1) as SemaTypeId;
    let type_entry = (&((*context).types[(*context).type_count])) as *mut SemaType;
    fill(type_entry as *mut u8, 0, sizeof(SemaType));
    set (*type_entry).id = id; set (*type_entry).kind = kind; set (*type_entry).element_type = element; set (*type_entry).array_length = array_length; set (*type_entry).symbol_id = symbol; set (*type_entry).is_mutable = is_mutable; set (*type_entry).return_type = return_type;
    if parameter_count != 0 {
        if parameters == null or parameter_count > SEMA_SIZE_MAX / sizeof(SemaTypeId) { set (*context).last_error = SemaError.InvalidArgument; return 0; }
        let parameter_storage = allocate(parameter_count * sizeof(SemaTypeId));
        if parameter_storage == null { set (*context).last_error = SemaError.OutOfMemory; return 0; }
        copy(parameter_storage, parameters as *const u8, parameter_count * sizeof(SemaTypeId));
        set (*type_entry).function_parameter_types = parameter_storage as usize as *SemaTypeId;
        set (*type_entry).function_parameter_count = parameter_count;
    }
    set (*context).type_count += 1;
    set (*context).stats.types_created = sema_sat_add((*context).stats.types_created, 1);
    return id;
}

proc sema_builtin_types(context: *mut Sema) -> bool {
    set (*context).type_error = sema_add_type(context, SemaTypeKind.Error, 0, 0, 0, false, 0, null, 0);
    set (*context).type_u8 = sema_add_type(context, SemaTypeKind.U8, 0, 0, 0, false, 0, null, 0);
    set (*context).type_void = sema_add_type(context, SemaTypeKind.Void, 0, 0, 0, false, 0, null, 0);
    set (*context).type_bool = sema_add_type(context, SemaTypeKind.Bool, 0, 0, 0, false, 0, null, 0);
    set (*context).type_i64 = sema_add_type(context, SemaTypeKind.I64, 0, 0, 0, false, 0, null, 0);
    set (*context).type_u64 = sema_add_type(context, SemaTypeKind.U64, 0, 0, 0, false, 0, null, 0);
    set (*context).type_f32 = sema_add_type(context, SemaTypeKind.F32, 0, 0, 0, false, 0, null, 0);
    set (*context).type_f64 = sema_add_type(context, SemaTypeKind.F64, 0, 0, 0, false, 0, null, 0);
    set (*context).type_char = sema_add_type(context, SemaTypeKind.Char, 0, 0, 0, false, 0, null, 0);
    set (*context).type_string = sema_add_type(context, SemaTypeKind.String, 0, 0, 0, false, 0, null, 0);
    set (*context).type_null = sema_add_type(context, SemaTypeKind.Null, 0, 0, 0, false, 0, null, 0);
    return (*context).type_error != 0 and (*context).type_u8 != 0 and (*context).type_void != 0 and (*context).type_bool != 0 and (*context).type_i64 != 0 and (*context).type_u64 != 0 and (*context).type_f32 != 0 and (*context).type_f64 != 0 and (*context).type_char != 0 and (*context).type_string != 0 and (*context).type_null != 0;
}

proc sema_symbol_set_type(context: *mut Sema, symbol_id: SymbolId, type_id: SemaTypeId) {
    let symbol = vitte_scope_get_symbol_mut(sema_scope_ptr(context), symbol_id);
    if symbol != null { set (*symbol).payload = type_id as usize as *mut u8; }
}

proc sema_symbol_type(context: *mut Sema, symbol_id: SymbolId) -> SemaTypeId {
    let symbol = vitte_scope_get_symbol(sema_scope_ptr(context), symbol_id);
    if symbol == null { return 0; }
    let type_id = (*symbol).payload as usize as SemaTypeId;
    if type_id == 0 or type_id > (*context).type_count as SemaTypeId { return 0; }
    return type_id;
}

proc sema_symbol_flags(parser_flags: u32) -> u32 {
    let mut symbol_flags: u32 = 0;
    if (parser_flags & PARSER_AST_FLAG_MUTABLE) != 0 { set symbol_flags = symbol_flags | SYMBOL_FLAG_MUTABLE; }
    if (parser_flags & PARSER_AST_FLAG_EXTERN) != 0 { set symbol_flags = symbol_flags | SYMBOL_FLAG_EXTERN; }
    if (parser_flags & PARSER_AST_FLAG_ASYNC) != 0 { set symbol_flags = symbol_flags | SYMBOL_FLAG_ASYNC; }
    if (parser_flags & PARSER_AST_FLAG_UNSAFE) != 0 { set symbol_flags = symbol_flags | SYMBOL_FLAG_UNSAFE; }
    if (parser_flags & PARSER_AST_FLAG_COMPTIME) != 0 { set symbol_flags = symbol_flags | SYMBOL_FLAG_COMPTIME; }
    return symbol_flags;
}

proc sema_node_info_mut(context: *mut Sema, node_id: ASTNodeId) -> *mut SemaNodeInfo {
    if context == null or node_id == 0 or node_id > (*context).node_info_count as ASTNodeId { return null; }
    return (&((*context).node_info[(node_id - 1) as usize])) as *mut SemaNodeInfo;
}

proc sema_node(parser: *const Parser, node_id: ASTNodeId) -> *const ASTNode { return vitte_parser_get_node(parser, node_id); }
proc sema_child(parser: *const Parser, parent: *const ASTNode, index: usize) -> *const ASTNode {
    if parent == null or index >= (*parent).child_count or (*parent).children == null { return null; }
    return sema_node(parser, (*parent).children[index]);
}
proc sema_token(parser: *const Parser, node: *const ASTNode) -> *const ParserToken { return vitte_parser_node_token(parser, node); }
proc sema_name_is(token: *const ParserToken, name: string) -> bool { return token != null and (*token).length == name.length and (*token).lexeme == name; }
proc sema_token_name_node(parser: *const Parser, node: *const ASTNode) -> *const ParserToken {
    if node == null { return null; }
    let token = sema_token(parser, node);
    if token != null { return token; }
    if (*node).child_count != 0 { return sema_token(parser, sema_child(parser, node, 0)); }
    return null;
}

proc sema_integer_digit(byte: u8) -> u32 {
    if byte >= 48 and byte <= 57 { return (byte - 48) as u32; }
    if byte >= 65 and byte <= 90 { return (byte - 55) as u32; }
    if byte >= 97 and byte <= 122 { return (byte - 87) as u32; }
    return 255;
}

proc sema_integer_literal_value(parser: *const Parser, node: *const ASTNode, value: *mut u64) -> bool {
    if node == null or value == null { return false; }
    if (*node).kind == ASTNodeKind.GroupExpr {
        return sema_integer_literal_value(parser, sema_child(parser, node, 0), value);
    }
    if (*node).kind != ASTNodeKind.IntegerLiteral { return false; }
    let token = sema_token(parser, node);
    if token == null or (*token).length == 0 { return false; }
    let bytes = (*token).lexeme as *const u8;
    let length = (*token).length;
    if bytes == null { return false; }
    let mut base: u64 = 10;
    let mut index: usize = 0;
    if length >= 2 and bytes[0] == 48 {
        if bytes[1] == 120 or bytes[1] == 88 { set base = 16; set index = 2; }
        else if bytes[1] == 98 or bytes[1] == 66 { set base = 2; set index = 2; }
        else if bytes[1] == 111 or bytes[1] == 79 { set base = 8; set index = 2; }
    }
    let mut parsed: u64 = 0;
    let mut found_digit = false;
    while index < length {
        let byte = bytes[index];
        if byte == 95 { set index += 1; continue; }
        let digit = sema_integer_digit(byte) as u64;
        if digit >= base { return false; }
        found_digit = true;
        if parsed > (18446744073709551615 - digit) / base { return false; }
        set parsed = parsed * base + digit;
        set index += 1;
    }
    if not found_digit { return false; }
    set *value = parsed;
    return true;
}

proc sema_integer_literal_fits(context: *const Sema, destination: SemaTypeId, parser: *const Parser, node: *const ASTNode) -> bool {
    if context == null or destination == 0 or destination > (*context).type_count as SemaTypeId { return false; }
    let mut value: u64 = 0;
    if not sema_integer_literal_value(parser, node, &mut value) { return false; }
    let destination_kind: SemaTypeKind = (*context).types[(destination - 1) as usize].kind;
    if destination_kind == SemaTypeKind.U64 { return true; }
    if destination_kind == SemaTypeKind.U8 { return value <= 255; }
    if destination_kind == SemaTypeKind.I64 { return value <= 9223372036854775807; }
    return false;
}

proc sema_value_type(context: *const Sema, type_id: SemaTypeId) -> SemaTypeId {
    if context == null or type_id == 0 or type_id > (*context).type_count as SemaTypeId { return type_id; }
    let type_record = &(*context).types[(type_id - 1) as usize];
    if (*type_record).kind == SemaTypeKind.Reference { return (*type_record).element_type; }
    return type_id;
}

proc sema_expression_assignable(context: *const Sema, destination: SemaTypeId, source: SemaTypeId, source_node: *const ASTNode) -> bool {
    if vitte_sema_type_assignable(context, destination, source) { return true; }
    let destination_record: *const SemaType = if destination != 0 and destination <= (*context).type_count as SemaTypeId { &(*context).types[(destination - 1) as usize] } else { null };
    if destination_record == null or (*destination_record).kind != SemaTypeKind.Reference {
        let value_source = sema_value_type(context, source);
        if vitte_sema_type_assignable(context, destination, value_source) { return true; }
        if value_source == (*context).type_i64 and sema_integer_literal_fits(context, destination, (*context).parser, source_node) { return true; }
    }
    return false;
}

proc sema_name_distance(left: string, right: string) -> usize {
    let left_bytes: [u8] = left.bytes();
    let right_bytes: [u8] = right.bytes();
    let left_length: usize = left_bytes.len();
    let right_length: usize = right_bytes.len();
    if left_length < 3 or right_length < 3 or left_length > 64 or right_length > 64 {
        return 18446744073709551615 as usize;
    }
    let mut index: usize = 0;
    while index < left_length {
        if left_bytes[index] >= 128 { return 18446744073709551615 as usize; }
        set index += 1;
    }
    set index = 0;
    while index < right_length {
        if right_bytes[index] >= 128 { return 18446744073709551615 as usize; }
        set index += 1;
    }

    let mut previous_previous: [usize; 65];
    let mut previous: [usize; 65];
    let mut current: [usize; 65];
    let mut column: usize = 0;
    while column <= right_length {
        set previous_previous[column] = 0;
        set previous[column] = column;
        set current[column] = 0;
        set column += 1;
    }

    let mut row: usize = 1;
    while row <= left_length {
        set current[0] = row;
        set column = 1;
        while column <= right_length {
            let deletion: usize = previous[column] + 1 as usize;
            let insertion: usize = current[column - 1] + 1 as usize;
            let substitution: usize = previous[column - 1] +
                if left_bytes[row - 1] == right_bytes[column - 1] { 0 as usize } else { 1 as usize };
            let mut best = deletion;
            if insertion < best { set best = insertion; }
            if substitution < best { set best = substitution; }
            if row > 1 and column > 1 and
               left_bytes[row - 1] == right_bytes[column - 2] and
               left_bytes[row - 2] == right_bytes[column - 1] and
               previous_previous[column - 2] + 1 < best {
                set best = previous_previous[column - 2] + 1;
            }
            set current[column] = best;
            set column += 1;
        }
        set column = 0;
        while column <= right_length {
            set previous_previous[column] = previous[column];
            set previous[column] = current[column];
            set column += 1;
        }
        set row += 1;
    }
    return previous[right_length];
}

proc sema_help_similar_name(context: *mut Sema, scope_id: ScopeId, token: *const ParserToken) {
    if context == null or token == null or (*token).length < 3 or (*token).length > 64 { return; }
    let symbol_count: usize = vitte_scope_symbol_count(sema_scope_ptr(context));
    let mut candidate: *const Symbol = null;
    let mut best_distance: usize = 18446744073709551615 as usize;
    let mut tied = false;
    let mut index: usize = 0;
    while index < symbol_count {
        let symbol = vitte_scope_get_symbol(sema_scope_ptr(context), (index + 1) as SymbolId);
        if symbol != null and (*symbol).name != null and (*symbol).name_length >= 3 and (*symbol).name_length <= 64 and
           vitte_scope_lookup_visible_n(
               sema_scope_ptr(context), scope_id, scope_id,
               (*symbol).name as *const u8, (*symbol).name_length
           ) == (*symbol).id {
            let name: string = string.from_bytes((*symbol).name as *const u8, (*symbol).name_length);
            let distance: usize = sema_name_distance((*token).lexeme, name);
            let max_distance: usize = if (*token).length <= 5 { 1 as usize } else { 2 as usize };
            if distance != 0 and distance <= max_distance {
                if distance < best_distance {
                    set candidate = symbol;
                    set best_distance = distance;
                    set tied = false;
                } elif distance == best_distance {
                    set tied = true;
                }
            }
        }
        set index += 1;
    }
    if candidate == null or tied or (*context).diagnostic_count == 0 { return; }

    let candidate_name: string = string.from_bytes((*candidate).name as *const u8, (*candidate).name_length);
    let message = "Did you mean `" + candidate_name + "` instead of `" + (*token).lexeme +
        "`? `" + candidate_name + "` is visible in this scope; verify that it is the intended declaration.";
    let bytes: [u8] = message.bytes();
    let limit: usize = if bytes.len() < 511 { bytes.len() } else { 511 as usize };
    copy(
        (&mut (*context).diagnostics[(*context).diagnostic_count - 1].help[0]) as *mut u8,
        bytes.as_ptr(),
        limit
    );
}

proc sema_add_diagnostic(context: *mut Sema, kind: SemaDiagnosticKind, code: SemaDiagnosticCode, node: *const ASTNode, expected: SemaTypeId, found: SemaTypeId) -> bool {
    if context == null or (*context).diagnostic_count >= (*context).max_diagnostics { if context != null { set (*context).last_error = SemaError.DiagnosticLimit; } return false; }
    if not sema_reserve_diagnostics(context, (*context).diagnostic_count + 1) { return false; }
    let diag = (&((*context).diagnostics[(*context).diagnostic_count])) as *mut SemaDiagnostic;
    fill(diag as *mut u8, 0, sizeof(SemaDiagnostic));
    set (*diag).kind = kind; set (*diag).code = code; set (*diag).expected_type = expected; set (*diag).found_type = found; set (*diag).context_index = SEMA_SIZE_MAX;
    if node != null { set (*diag).span = (*node).span; set (*diag).node_id = (*node).id; }
    set (*context).diagnostic_count += 1;
    set (*context).stats.diagnostics = sema_sat_add((*context).stats.diagnostics, 1);
    if kind == SemaDiagnosticKind.Error { set (*context).stats.errors = sema_sat_add((*context).stats.errors, 1); }
    if kind == SemaDiagnosticKind.Warning { set (*context).stats.warnings = sema_sat_add((*context).stats.warnings, 1); }
    return true;
}

proc sema_set_argument_diagnostic_context(
    context: *mut Sema,
    function_symbol_id: SymbolId,
    argument_index: usize
) {
    if context == null or (*context).diagnostic_count == 0 { return; }
    let diag_ptr = (&mut (*context).diagnostics[(*context).diagnostic_count - 1]) as *mut SemaDiagnostic;
    set (*diag_ptr).type_context = SemaTypeContextKind.Argument;
    set (*diag_ptr).context_index = argument_index + 1;

    let mut function_declaration: *const ASTNode = null;
    let mut node_id: ASTNodeId = 1;
    let node_count = vitte_parser_node_count((*context).parser);
    while node_id <= node_count as ASTNodeId {
        let candidate = sema_node((*context).parser, node_id);
        let candidate_info = sema_node_info_mut(context, node_id);
        if candidate != null and candidate_info != null and
           ((*candidate).kind == ASTNodeKind.ProcDecl or (*candidate).kind == ASTNodeKind.ExternProcDecl) and
           (*candidate_info).symbol_id == function_symbol_id {
            set function_declaration = candidate;
            break;
        }
        set node_id += 1;
    }

    let mut param_decl: *const ASTNode = null;
    if function_declaration != null {
        let mut child_index: usize = 1;
        let mut parameter_index: usize = 0;
        while child_index < (*function_declaration).child_count {
            let child = sema_child((*context).parser, function_declaration, child_index);
            if child != null and (*child).kind == ASTNodeKind.Parameter {
                if parameter_index == argument_index {
                    set param_decl = child;
                    break;
                }
                set parameter_index += 1;
            }
            set child_index += 1;
        }
    }

    let mut parameter_name: string = "";
    let mut procedure_name: string = "";
    let mut parameter_symbol_id: SymbolId = 0;
    if param_decl != null and (*param_decl).child_count != 0 {
        let name_node = sema_child((*context).parser, param_decl, 0);
        let parameter_token = sema_token_name_node((*context).parser, name_node);
        if parameter_token != null {
            set parameter_name = string.from_bytes((*parameter_token).lexeme, (*parameter_token).length);
        }
        if name_node != null {
            let name_info = sema_node_info_mut(context, (*name_node).id);
            if name_info != null { set parameter_symbol_id = (*name_info).symbol_id; }
            if parameter_symbol_id == 0 {
                let symbol_count = vitte_scope_symbol_count(sema_scope_ptr(context));
                let mut symbol_index: usize = 0;
                while symbol_index < symbol_count {
                    let symbol = vitte_scope_get_symbol(sema_scope_ptr(context), (symbol_index + 1) as SymbolId);
                    if symbol != null and (*symbol).span.valid and
                       (*symbol).span.file_id == (*name_node).span.file_id and
                       (*symbol).span.begin == (*name_node).span.begin and
                       (*symbol).span.end == (*name_node).span.end {
                        set parameter_symbol_id = (*symbol).id;
                        break;
                    }
                    set symbol_index += 1;
                }
            }
        }
    }
    let function_symbol = if function_symbol_id == 0 { null } else { vitte_scope_get_symbol(sema_scope_ptr(context), function_symbol_id) };
    if function_symbol != null and (*function_symbol).name != null {
        set procedure_name = string.from_bytes((*function_symbol).name as *const u8, (*function_symbol).name_length);
    }
    set (*diag_ptr).context_symbol_id = parameter_symbol_id;

    let argument_number = sema_size_to_string(argument_index + 1);
    let mut help: string = "Argument " + argument_number;
    if parameter_name.len() != 0 {
        set help += " does not match parameter `" + parameter_name + "`";
        if procedure_name.len() != 0 {
            set help += " of procedure `" + procedure_name + "`";
        }
        set help += ".";
    } else {
        set help += " does not match this procedure's parameter type.";
    }
    let bytes: [u8] = help.bytes();
    let limit: usize = if bytes.len() < 511 { bytes.len() } else { 511 as usize };
    copy((&mut (*diag_ptr).help[0]) as *mut u8, bytes.as_ptr(), limit);
}

proc sema_set_argument_count_help(context: *mut Sema, expected_count: usize, actual_count: usize) {
    if context == null or (*context).diagnostic_count == 0 { return; }
    let difference: usize = if expected_count > actual_count { expected_count - actual_count } else { actual_count - expected_count };
    let mut message: string = "This call requires " + sema_size_to_string(expected_count) +
        " argument(s), but " + sema_size_to_string(actual_count) + " were supplied. ";
    if actual_count < expected_count {
        set message += "Add " + sema_size_to_string(difference);
    } else {
        set message += "Remove " + sema_size_to_string(difference);
    }
    set message += " argument(s) to match the declaration.";
    let bytes: [u8] = message.bytes();
    let limit: usize = if bytes.len() < 511 { bytes.len() } else { 511 as usize };
    let diag_ptr = (&mut (*context).diagnostics[(*context).diagnostic_count - 1]) as *mut SemaDiagnostic;
    copy((&mut (*diag_ptr).help[0]) as *mut u8, bytes.as_ptr(), limit);
}

proc sema_set_return_diagnostic_context(context: *mut Sema) {
    if context == null or (*context).diagnostic_count == 0 or (*context).current_proc_scope == 0 { return; }
    let diag_ptr = (&mut (*context).diagnostics[(*context).diagnostic_count - 1]) as *mut SemaDiagnostic;
    set (*diag_ptr).type_context = SemaTypeContextKind.Return;
    set (*diag_ptr).context_index = SEMA_SIZE_MAX;
    let procedure_scope = vitte_scope_get_scope(sema_scope_ptr(context) as *const Scope, (*context).current_proc_scope);
    let mut procedure_name: string = "";
    if procedure_scope != null {
        let node_count = vitte_parser_node_count((*context).parser);
        let mut node_id: ASTNodeId = 1;
        while node_id <= node_count as ASTNodeId {
            let candidate = sema_node((*context).parser, node_id);
            let candidate_info = sema_node_info_mut(context, node_id);
            if candidate != null and candidate_info != null and
               ((*candidate).kind == ASTNodeKind.ProcDecl or (*candidate).kind == ASTNodeKind.ExternProcDecl) and
               (*candidate).span.file_id == (*procedure_scope).span.file_id and
               (*candidate).span.begin == (*procedure_scope).span.begin and
               (*candidate).span.end == (*procedure_scope).span.end {
                let function_symbol = vitte_scope_get_symbol(sema_scope_ptr(context), (*candidate_info).symbol_id);
                if function_symbol != null and (*function_symbol).name != null {
                    set procedure_name = string.from_bytes((*function_symbol).name as *const u8, (*function_symbol).name_length);
                }
                break;
            }
            set node_id += 1;
        }
    }
    let mut help: string = "Return value";
    if procedure_name.len() != 0 {
        set help += " in procedure `" + procedure_name + "`";
    }
    set help += " does not match its declared return type.";
    let bytes: [u8] = help.bytes();
    let limit: usize = if bytes.len() < 511 { bytes.len() } else { 511 as usize };
    copy((&mut (*diag_ptr).help[0]) as *mut u8, bytes.as_ptr(), limit);
}

proc sema_size_to_string(value: usize) -> string {
    if value < 10 { return string.from_byte((48 + value) as u8); }
    return sema_size_to_string(value / 10) + string.from_byte((48 + (value % 10)) as u8);
}

proc sema_type_from_node(context: *mut Sema, node_id: ASTNodeId, scope_id: ScopeId) -> SemaTypeId {
    let node = sema_node((*context).parser, node_id);
    if node == null { return (*context).type_error; }
    if (*node).kind == ASTNodeKind.PointerType or (*node).kind == ASTNodeKind.ReferenceType or (*node).kind == ASTNodeKind.OptionalType or (*node).kind == ASTNodeKind.ArrayType {
        let element_node = sema_child((*context).parser, node, (*node).child_count - 1);
        if element_node == null { return (*context).type_error; }
        let element = sema_type_from_node(context, (*element_node).id, scope_id);
        let type_kind: SemaTypeKind = if (*node).kind == ASTNodeKind.PointerType { SemaTypeKind.Pointer } else if (*node).kind == ASTNodeKind.ReferenceType { SemaTypeKind.Reference } else if (*node).kind == ASTNodeKind.OptionalType { SemaTypeKind.Optional } else { SemaTypeKind.Array };
        let mut array_length: usize = 0;
        if (*node).kind == ASTNodeKind.ArrayType and (*node).child_count > 1 {
            let length_node = sema_child((*context).parser, node, 0);
            let mut parsed_length: u64 = 0;
            if not sema_integer_literal_value((*context).parser, length_node, &mut parsed_length) or parsed_length > usize.MAX {
                return (*context).type_error;
            }
            set array_length = parsed_length as usize;
        }
        return sema_add_type(context, type_kind, element, array_length, 0, ((*node).node_flags & 2) != 0, 0, null, 0);
    }
    let token = sema_token_name_node((*context).parser, node);
    if sema_name_is(token, "void") { return (*context).type_void; }
    if sema_name_is(token, "bool") { return (*context).type_bool; }
    if sema_name_is(token, "i64") or sema_name_is(token, "int") { return (*context).type_i64; }
    if sema_name_is(token, "u64") or sema_name_is(token, "usize") { return (*context).type_u64; }
    if sema_name_is(token, "u8") { return (*context).type_u8; }
    if sema_name_is(token, "f32") { return (*context).type_f32; }
    if sema_name_is(token, "f64") { return (*context).type_f64; }
    if sema_name_is(token, "char") { return (*context).type_char; }
    if sema_name_is(token, "string") { return (*context).type_string; }
    if sema_name_is(token, "null") { return (*context).type_null; }
    if token != null {
        let symbol = vitte_scope_lookup_n(sema_scope_ptr(context), scope_id, (*token).lexeme.as_ptr() as *const u8, (*token).length);
        if symbol != 0 {
            let record = vitte_scope_get_symbol(sema_scope_ptr(context), symbol);
            if record != null and ((*record).kind == SymbolKind.Type or (*record).kind == SymbolKind.Form or (*record).kind == SymbolKind.Pick or (*record).kind == SymbolKind.Trait or (*record).kind == SymbolKind.Opaque or (*record).kind == SymbolKind.GenericParameter) { let type_id = sema_symbol_type(context, symbol); if type_id != 0 { return type_id; } let kind: SemaTypeKind = if (*record).kind == SymbolKind.GenericParameter { SemaTypeKind.GenericParameter } else { SemaTypeKind.Named }; return sema_add_type(context, kind, 0, 0, symbol, false, 0, null, 0); }
        }
    }
    return (*context).type_error;
}

/// Resolve `Pick::Variant` paths, including nongeneric payload variants.
proc sema_pick_variant_type(
    context: *mut Sema,
    node: *const ASTNode,
    scope_id: ScopeId,
    is_pick_path: *mut bool
) -> SemaTypeId {
    if is_pick_path != null { set *is_pick_path = false; }
    if context == null or node == null or
       ((*node).kind != ASTNodeKind.Path and (*node).kind != ASTNodeKind.MemberExpr) or
       (*node).child_count < 2 {
        return 0;
    }
    let type_node = sema_child((*context).parser, node, (*node).child_count - 2);
    let variant_node = sema_child((*context).parser, node, (*node).child_count - 1);
    let type_id = if type_node == null { 0 as SemaTypeId } else { sema_type_from_node(context, (*type_node).id, scope_id) };
    if type_id == 0 or type_id > (*context).type_count as SemaTypeId { return 0; }
    let type_record = &(*context).types[(type_id - 1) as usize];
    if (*type_record).kind != SemaTypeKind.Named or (*type_record).symbol_id == 0 { return 0; }
    let type_symbol = vitte_scope_get_symbol(sema_scope_ptr(context), (*type_record).symbol_id);
    if type_symbol == null or (*type_symbol).kind != SymbolKind.Pick { return 0; }
    if is_pick_path != null { set *is_pick_path = true; }
    let variant_token = sema_token_name_node((*context).parser, variant_node);
    if variant_token == null { return 0; }

    let mut node_id: ASTNodeId = 1;
    let node_count = vitte_parser_node_count((*context).parser);
    while node_id <= node_count as ASTNodeId {
        let declaration = sema_node((*context).parser, node_id);
        let info = sema_node_info_mut(context, node_id);
        if declaration != null and (*declaration).kind == ASTNodeKind.PickDecl and
           info != null and (*info).symbol_id == (*type_record).symbol_id {
            let mut child_index: usize = 1;
            while child_index < (*declaration).child_count {
                let variant = sema_child((*context).parser, declaration, child_index);
                if variant != null and (*variant).kind == ASTNodeKind.VariantDecl {
                    let candidate = sema_token_name_node((*context).parser, sema_child((*context).parser, variant, 0));
                    if candidate != null and (*candidate).length == (*variant_token).length and
                       (*candidate).lexeme == (*variant_token).lexeme {
                        return type_id;
                    }
                }
                set child_index += 1;
            }
            return 0;
        }
        set node_id += 1;
    }
    return 0;
}

proc sema_pick_variant_payload_at(
    context: *mut Sema,
    node: *const ASTNode,
    scope_id: ScopeId,
    payload_index: usize
) -> SemaTypeId {
    if context == null or node == null or
       ((*node).kind != ASTNodeKind.Path and (*node).kind != ASTNodeKind.MemberExpr) or
       (*node).child_count < 2 { return 0; }
    let mut is_pick_path = false;
    let pick_type = sema_pick_variant_type(context, node, scope_id, &mut is_pick_path);
    if not is_pick_path or pick_type == 0 or pick_type > (*context).type_count as SemaTypeId { return 0; }
    let type_record = &(*context).types[(pick_type - 1) as usize];
    let variant_node = sema_child((*context).parser, node, (*node).child_count - 1);
    let variant_token = sema_token_name_node((*context).parser, variant_node);
    if variant_token == null { return 0; }
    let mut node_id: ASTNodeId = 1;
    let node_count = vitte_parser_node_count((*context).parser);
    while node_id <= node_count as ASTNodeId {
        let declaration = sema_node((*context).parser, node_id);
        let info = sema_node_info_mut(context, node_id);
        if declaration != null and (*declaration).kind == ASTNodeKind.PickDecl and
           info != null and (*info).symbol_id == (*type_record).symbol_id {
            let mut child_index: usize = 1;
            while child_index < (*declaration).child_count {
                let variant = sema_child((*context).parser, declaration, child_index);
                if variant != null and (*variant).kind == ASTNodeKind.VariantDecl and
                   (*variant).child_count > payload_index + 1 {
                    let candidate = sema_token_name_node((*context).parser, sema_child((*context).parser, variant, 0));
                    if candidate != null and (*candidate).length == (*variant_token).length and
                       (*candidate).lexeme == (*variant_token).lexeme {
                        let payload = sema_child((*context).parser, variant, payload_index + 1);
                        return if payload == null { 0 as SemaTypeId } else { sema_type_from_node(context, (*payload).id, scope_id) };
                    }
                }
                set child_index += 1;
            }
            return 0;
        }
        set node_id += 1;
    }
    return 0;
}

proc sema_pick_variant_payload(
    context: *mut Sema,
    node: *const ASTNode,
    scope_id: ScopeId,
    payload_count: *mut usize
) -> SemaTypeId {
    if payload_count != null { set *payload_count = 0; }
    if context == null or node == null or payload_count == null or
       ((*node).kind != ASTNodeKind.Path and (*node).kind != ASTNodeKind.MemberExpr) or
       (*node).child_count < 2 { return 0; }
    let mut is_pick_path = false;
    let pick_type = sema_pick_variant_type(context, node, scope_id, &mut is_pick_path);
    if not is_pick_path or pick_type == 0 or pick_type > (*context).type_count as SemaTypeId { return 0; }
    let type_record = &(*context).types[(pick_type - 1) as usize];
    let variant_node = sema_child((*context).parser, node, (*node).child_count - 1);
    let variant_token = sema_token_name_node((*context).parser, variant_node);
    if variant_token == null { return 0; }
    let mut node_id: ASTNodeId = 1;
    let node_count = vitte_parser_node_count((*context).parser);
    while node_id <= node_count as ASTNodeId {
        let declaration = sema_node((*context).parser, node_id);
        let info = sema_node_info_mut(context, node_id);
        if declaration != null and (*declaration).kind == ASTNodeKind.PickDecl and
           info != null and (*info).symbol_id == (*type_record).symbol_id {
            let mut child_index: usize = 1;
            while child_index < (*declaration).child_count {
                let variant = sema_child((*context).parser, declaration, child_index);
                if variant != null and (*variant).kind == ASTNodeKind.VariantDecl {
                    let candidate = sema_token_name_node((*context).parser, sema_child((*context).parser, variant, 0));
                    if candidate != null and (*candidate).length == (*variant_token).length and
                       (*candidate).lexeme == (*variant_token).lexeme {
                        set *payload_count = (*variant).child_count - 1;
                        if *payload_count != 0 { return sema_pick_variant_payload_at(context, node, scope_id, 0); }
                        return 0;
                    }
                }
                set child_index += 1;
            }
        }
        set node_id += 1;
    }
    return 0;
}

proc sema_pick_type_has_payload(context: *mut Sema, type_id: SemaTypeId) -> bool {
    if context == null or type_id == 0 or type_id > (*context).type_count as SemaTypeId { return false; }
    let type_record = &(*context).types[(type_id - 1) as usize];
    if (*type_record).kind != SemaTypeKind.Named or (*type_record).symbol_id == 0 { return false; }
    let mut node_id: ASTNodeId = 1;
    let node_count = vitte_parser_node_count((*context).parser);
    while node_id <= node_count as ASTNodeId {
        let declaration = sema_node((*context).parser, node_id);
        let info = sema_node_info_mut(context, node_id);
        if declaration != null and (*declaration).kind == ASTNodeKind.PickDecl and
           info != null and (*info).symbol_id == (*type_record).symbol_id {
            let mut child_index: usize = 1;
            while child_index < (*declaration).child_count {
                let variant = sema_child((*context).parser, declaration, child_index);
                if variant != null and (*variant).kind == ASTNodeKind.VariantDecl and (*variant).child_count > 1 {
                    return true;
                }
                set child_index += 1;
            }
            return false;
        }
        set node_id += 1;
    }
    return false;
}

proc sema_check_pick_pattern(context: *mut Sema, pattern: *const ASTNode, scope_id: ScopeId, subject_type: SemaTypeId) -> bool {
    if context == null or pattern == null { return true; }
    if (*pattern).kind == ASTNodeKind.Pattern and (*pattern).child_count == 0 { return true; }
    let mut candidate = pattern;
    if (*candidate).kind == ASTNodeKind.Pattern and
       ((*candidate).node_flags & PARSER_AST_FLAG_PATTERN_HEAD) != 0 and (*candidate).child_count != 0 {
        set candidate = sema_child((*context).parser, candidate, 0);
    } else if (*candidate).kind == ASTNodeKind.Pattern and (*candidate).child_count == 1 {
        set candidate = sema_child((*context).parser, candidate, 0);
    }
    if candidate == null or (*candidate).kind != ASTNodeKind.Path { return true; }
    let mut is_pick_path = false;
    let variant_type = sema_pick_variant_type(context, candidate, scope_id, &mut is_pick_path);
    if not is_pick_path { return true; }
    if variant_type == 0 {
        let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.UnknownMember, candidate, 0, subject_type);
        return false;
    }
    if variant_type != subject_type {
        let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.TypeMismatch, candidate, subject_type, variant_type);
        return false;
    }
    let mut payload_count: usize = 0;
    let _ = sema_pick_variant_payload(context, candidate, scope_id, &mut payload_count);
    let pattern_payload_count: usize = if pattern == candidate { 0 as usize } else if (*pattern).kind == ASTNodeKind.Pattern and ((*pattern).node_flags & PARSER_AST_FLAG_PATTERN_HEAD) != 0 { (*pattern).child_count - 1 } else { 0 as usize };
    if payload_count != pattern_payload_count {
        let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidArgumentCount, pattern, 0, 0);
        return false;
    }
    return true;
}

proc sema_type_numeric(context: *const Sema, type_id: SemaTypeId) -> bool {
    if context == null or type_id == 0 or type_id > (*context).type_count as SemaTypeId { return false; }
    let kind: SemaTypeKind = (*context).types[(type_id - 1) as usize].kind;
    return kind == SemaTypeKind.I64 or kind == SemaTypeKind.U64 or kind == SemaTypeKind.U8 or kind == SemaTypeKind.Char or kind == SemaTypeKind.F32 or kind == SemaTypeKind.F64;
}

proc sema_type_integer(context: *const Sema, type_id: SemaTypeId) -> bool {
    if context == null or type_id == 0 or type_id > (*context).type_count as SemaTypeId { return false; }
    let kind: SemaTypeKind = (*context).types[(type_id - 1) as usize].kind;
    return kind == SemaTypeKind.I64 or kind == SemaTypeKind.U64 or kind == SemaTypeKind.U8 or kind == SemaTypeKind.Char;
}

proc sema_common_numeric_type(
    context: *const Sema,
    left_id: SemaTypeId,
    right_id: SemaTypeId
) -> SemaTypeId {
    if not sema_type_numeric(context, left_id) or
       not sema_type_numeric(context, right_id) {
        return (*context).type_error;
    }
    let left_kind: SemaTypeKind = (*context).types[(left_id - 1) as usize].kind;
    let right_kind: SemaTypeKind = (*context).types[(right_id - 1) as usize].kind;
    if left_kind == SemaTypeKind.F64 or right_kind == SemaTypeKind.F64 {
        return (*context).type_f64;
    }
    if left_kind == SemaTypeKind.F32 or right_kind == SemaTypeKind.F32 {
        return (*context).type_f32;
    }
    if left_kind == SemaTypeKind.U64 and right_kind == SemaTypeKind.U64 {
        return (*context).type_u64;
    }
    if left_kind == SemaTypeKind.U8 and right_kind == SemaTypeKind.U8 {
        return (*context).type_u8;
    }
    if (left_kind == SemaTypeKind.U64 and right_kind == SemaTypeKind.U8) or
       (right_kind == SemaTypeKind.U64 and left_kind == SemaTypeKind.U8) {
        return (*context).type_u64;
    }
    return (*context).type_i64;
}

proc sema_declare_node(context: *mut Sema, node: *const ASTNode, scope_id: ScopeId, kind: SymbolKind) -> SymbolId {
    let name_node = sema_child((*context).parser, node, 0);
    let token = sema_token_name_node((*context).parser, name_node);
    if token == null { return 0; }
    let visibility: SymbolVisibility = if ((*node).node_flags & 1) != 0 { SymbolVisibility.Public } else { SymbolVisibility.Private };
    let span: ParserSpan = (*node).span;
    let scope_span: ScopeSpan = ScopeSpan { file_id: span.file_id, begin: span.begin, end: span.end, line: span.line, column: span.column, valid: span.valid };
    return vitte_scope_declare(sema_scope_ptr(context), scope_id, (*token).lexeme.as_ptr() as *const u8, (*token).length, kind, visibility, sema_symbol_flags((*node).node_flags), scope_span, null);
}

form SemaPatternBinding {
    token: *const ParserToken,
    binding_flags: u32
}

proc sema_pattern_binding_count(
    parser: *const Parser,
    node: *const ASTNode,
    inherited_flags: u32,
    depth: usize
) -> usize {
    if node == null or depth > SEMA_DEFAULT_MAX_RECURSION_DEPTH { return 0; }
    let binding_flags = inherited_flags | (*node).node_flags;
    if (*node).kind == ASTNodeKind.Identifier or (*node).kind == ASTNodeKind.Path {
        if (*node).kind == ASTNodeKind.Path and (*node).child_count > 1 { return 0; }
        return 1;
    }
    if (*node).kind != ASTNodeKind.Pattern or
       (binding_flags & PARSER_AST_FLAG_PATTERN_RANGE) != 0 { return 0; }
    if (binding_flags & PARSER_AST_FLAG_PATTERN_OR) != 0 {
        if (*node).child_count == 0 { return 0; }
        return sema_pattern_binding_count(parser, sema_child(parser, node, 0), binding_flags, depth + 1);
    }
    let mut index: usize = if (binding_flags & PARSER_AST_FLAG_PATTERN_HEAD) != 0 { 1 as usize } else { 0 as usize };
    let mut count: usize = 0;
    while index < (*node).child_count {
        let child = sema_child(parser, node, index);
        let child_count = sema_pattern_binding_count(parser, child, binding_flags, depth + 1);
        if child_count > usize.MAX - count { return usize.MAX; }
        set count += child_count;
        set index += 1;
    }
    return count;
}

proc sema_pattern_binding_at(
    parser: *const Parser,
    node: *const ASTNode,
    wanted: usize,
    inherited_flags: u32,
    depth: usize
) -> SemaPatternBinding {
    if node == null or depth > SEMA_DEFAULT_MAX_RECURSION_DEPTH {
        return SemaPatternBinding { token: null, binding_flags: 0 };
    }
    let binding_flags = inherited_flags | (*node).node_flags;
    if (*node).kind == ASTNodeKind.Identifier or (*node).kind == ASTNodeKind.Path {
        if ((*node).kind == ASTNodeKind.Path and (*node).child_count > 1) or wanted != 0 {
            return SemaPatternBinding { token: null, binding_flags: 0 };
        }
        return SemaPatternBinding {
            token: sema_token_name_node(parser, node),
            binding_flags: binding_flags & (PARSER_AST_FLAG_PATTERN_MUTABLE | PARSER_AST_FLAG_PATTERN_REFERENCE)
        };
    }
    if (*node).kind != ASTNodeKind.Pattern or
       (binding_flags & PARSER_AST_FLAG_PATTERN_RANGE) != 0 {
        return SemaPatternBinding { token: null, binding_flags: 0 };
    }
    if (binding_flags & PARSER_AST_FLAG_PATTERN_OR) != 0 {
        if (*node).child_count == 0 { return SemaPatternBinding { token: null, binding_flags: 0 }; }
        return sema_pattern_binding_at(parser, sema_child(parser, node, 0), wanted, binding_flags, depth + 1);
    }
    let mut remaining = wanted;
    let mut index: usize = if (binding_flags & PARSER_AST_FLAG_PATTERN_HEAD) != 0 { 1 as usize } else { 0 as usize };
    while index < (*node).child_count {
        let child = sema_child(parser, node, index);
        let child_count = sema_pattern_binding_count(parser, child, binding_flags, depth + 1);
        if remaining < child_count {
            return sema_pattern_binding_at(parser, child, remaining, binding_flags, depth + 1);
        }
        set remaining -= child_count;
        set index += 1;
    }
    return SemaPatternBinding { token: null, binding_flags: 0 };
}

proc sema_pattern_alternatives_valid(
    context: *mut Sema,
    node: *const ASTNode,
    inherited_flags: u32,
    depth: usize
) -> bool {
    if node == null { return true; }
    if depth > (*context).max_recursion_depth { return false; }
    let binding_flags = inherited_flags | (*node).node_flags;
    let mut valid = true;
    if (*node).kind == ASTNodeKind.Pattern and (binding_flags & PARSER_AST_FLAG_PATTERN_OR) != 0 {
        if (*node).child_count < 2 {
            let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidPatternBindings, node, 0, 0);
            return false;
        }
        let first = sema_child((*context).parser, node, 0);
        let first_count = sema_pattern_binding_count((*context).parser, first, binding_flags, depth + 1);
        let mut alternative_index: usize = 1;
        while alternative_index < (*node).child_count {
            let alternative = sema_child((*context).parser, node, alternative_index);
            let alternative_count = sema_pattern_binding_count((*context).parser, alternative, binding_flags, depth + 1);
            if alternative_count != first_count {
                set valid = false;
            } else {
                let mut binding_index: usize = 0;
                while binding_index < first_count {
                    let first_binding = sema_pattern_binding_at((*context).parser, first, binding_index, binding_flags, depth + 1);
                    let alternative_binding = sema_pattern_binding_at((*context).parser, alternative, binding_index, binding_flags, depth + 1);
                    if first_binding.token == null or alternative_binding.token == null or
                       (*first_binding.token).length != (*alternative_binding.token).length or
                       (*first_binding.token).lexeme != (*alternative_binding.token).lexeme or
                       first_binding.binding_flags != alternative_binding.binding_flags {
                        set valid = false;
                    }
                    set binding_index += 1;
                }
            }
            set alternative_index += 1;
        }
        if not valid {
            let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidPatternBindings, node, 0, 0);
        }
    }
    let mut index: usize = 0;
    while index < (*node).child_count {
        if not sema_pattern_alternatives_valid(
            context,
            sema_child((*context).parser, node, index),
            binding_flags,
            depth + 1
        ) { set valid = false; }
        set index += 1;
    }
    return valid;
}

proc sema_bind_pattern(
    context: *mut Sema,
    node: *const ASTNode,
    scope_id: ScopeId,
    type_id: SemaTypeId,
    inherited_flags: u32
) -> bool {
    if node == null { return true; }
    let pattern_flags = inherited_flags | (*node).node_flags;
    if (*node).kind == ASTNodeKind.Identifier or (*node).kind == ASTNodeKind.Path {
        if (*node).kind == ASTNodeKind.Path and (*node).child_count > 1 { return true; }
        let token = sema_token_name_node((*context).parser, node);
        if token == null { return true; }
        if sema_name_is(token, "_") { return true; }
        let mut bound_type = type_id;
        if (pattern_flags & PARSER_AST_FLAG_PATTERN_REFERENCE) != 0 {
            set bound_type = sema_add_type(context, SemaTypeKind.Reference, type_id, 0, 0, (pattern_flags & PARSER_AST_FLAG_PATTERN_MUTABLE) != 0, 0, null, 0);
        }
        let declaration_flags = if (pattern_flags & PARSER_AST_FLAG_PATTERN_MUTABLE) != 0 { SYMBOL_FLAG_MUTABLE } else { 0 as u32 };
        let symbol = vitte_scope_declare(
            sema_scope_ptr(context), scope_id,
            (*token).lexeme.as_ptr() as *const u8, (*token).length,
            SymbolKind.Local, SymbolVisibility.Private, declaration_flags,
            ScopeSpan { file_id: (*node).span.file_id, begin: (*node).span.begin, end: (*node).span.end, line: (*node).span.line, column: (*node).span.column, valid: (*node).span.valid },
            null
        );
        if symbol == 0 {
            let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.DuplicateDeclaration, node, 0, 0);
            return false;
        }
        sema_symbol_set_type(context, symbol, bound_type);
        let info = sema_node_info_mut(context, (*node).id);
        if info != null { set (*info).symbol_id = symbol; set (*info).type_id = bound_type; set (*info).scope_id = scope_id; set (*info).node_flags = (*info).node_flags | SEMA_NODE_FLAG_DECLARATION; }
        return true;
    }
    if (*node).kind != ASTNodeKind.Pattern { return true; }
    if ((*node).node_flags & (PARSER_AST_FLAG_PATTERN_RANGE | PARSER_AST_FLAG_PATTERN_HEAD)) != 0 {
        if ((*node).node_flags & PARSER_AST_FLAG_PATTERN_STRUCT) != 0 {
            let head = sema_child((*context).parser, node, 0);
            let aggregate_type = if head == null { (*context).type_error } else { sema_type_from_node(context, (*head).id, scope_id) };
            let mut field_index: usize = 1;
            while field_index < (*node).child_count {
                let field = sema_child((*context).parser, node, field_index);
                if field != null {
                    let mut field_name_node = field;
                    let mut binding_node = field;
                    if (*field).kind == ASTNodeKind.Pattern and
                       ((*field).node_flags & PARSER_AST_FLAG_PATTERN_HEAD) != 0 and
                       (*field).child_count >= 2 {
                        set field_name_node = sema_child((*context).parser, field, 0);
                        set binding_node = sema_child((*context).parser, field, 1);
                    }
                    let field_name = sema_token_name_node((*context).parser, field_name_node);
                    let field_type = sema_form_field_type(context, aggregate_type, field_name, scope_id);
                    if field_type == 0 {
                        if aggregate_type != (*context).type_error {
                            let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.UnknownMember, field_name_node, 0, aggregate_type);
                        }
                        let _ = sema_bind_pattern(context, binding_node, scope_id, (*context).type_error, pattern_flags);
                    } else {
                        let _ = sema_bind_pattern(context, binding_node, scope_id, field_type, pattern_flags);
                    }
                }
                set field_index += 1;
            }
            return true;
        }
        let head = sema_child((*context).parser, node, 0);
        if head != null and (*head).kind == ASTNodeKind.Path {
            let mut is_pick_path = false;
            let pick_type = sema_pick_variant_type(context, head, scope_id, &mut is_pick_path);
            if is_pick_path and pick_type != 0 {
                let mut payload_count: usize = 0;
                let _ = sema_pick_variant_payload(context, head, scope_id, &mut payload_count);
                if payload_count == (*node).child_count - 1 {
                    let mut payload_index: usize = 0;
                    while payload_index < payload_count {
                        let payload_type = sema_pick_variant_payload_at(context, head, scope_id, payload_index);
                        if payload_type == 0 or not sema_bind_pattern(context, sema_child((*context).parser, node, payload_index + 1), scope_id, payload_type, pattern_flags) {
                            return false;
                        }
                        set payload_index += 1;
                    }
                    return true;
                }
            }
        }
        let mut index: usize = 1;
        while index < (*node).child_count {
            if not sema_bind_pattern(context, sema_child((*context).parser, node, index), scope_id, type_id, pattern_flags) { return false; }
            set index += 1;
        }
        return true;
    }
    if ((*node).node_flags & PARSER_AST_FLAG_PATTERN_OR) != 0 {
        if (*node).child_count == 0 { return true; }
        if not sema_pattern_alternatives_valid(context, node, pattern_flags, 0) { return false; }
        return sema_bind_pattern(context, sema_child((*context).parser, node, 0), scope_id, type_id, pattern_flags);
    }
    let mut index: usize = 0;
    while index < (*node).child_count {
        if not sema_bind_pattern(context, sema_child((*context).parser, node, index), scope_id, type_id, pattern_flags) { return false; }
        set index += 1;
    }
    return true;
}

proc sema_form_field_declaration(
    context: *mut Sema,
    aggregate_type: SemaTypeId,
    field_name: *const ParserToken
) -> *const ASTNode {
    if field_name == null or aggregate_type == 0 or aggregate_type > (*context).type_count as SemaTypeId { return null; }
    let aggregate = &(*context).types[(aggregate_type - 1) as usize];
    if (*aggregate).kind != SemaTypeKind.Named or (*aggregate).symbol_id == 0 { return null; }
    let node_count = vitte_parser_node_count((*context).parser);
    let mut node_id: ASTNodeId = 1;
    while node_id <= node_count as ASTNodeId {
        let declaration = sema_node((*context).parser, node_id);
        let info = sema_node_info_mut(context, node_id);
        if declaration != null and (*declaration).kind == ASTNodeKind.FormDecl and
           info != null and (*info).symbol_id == (*aggregate).symbol_id {
            let mut child_index: usize = 1;
            while child_index < (*declaration).child_count {
                let field = sema_child((*context).parser, declaration, child_index);
                if field != null and (*field).kind == ASTNodeKind.FieldDecl {
                    let name_node = sema_child((*context).parser, field, 0);
                    let token = sema_token_name_node((*context).parser, name_node);
                    if token != null and (*token).length == (*field_name).length and (*token).lexeme == (*field_name).lexeme {
                        return field;
                    }
                }
                set child_index += 1;
            }
            return null;
        }
        set node_id += 1;
    }
    return null;
}

proc sema_form_field_type(
    context: *mut Sema,
    aggregate_type: SemaTypeId,
    field_name: *const ParserToken,
    scope_id: ScopeId
) -> SemaTypeId {
    let field = sema_form_field_declaration(context, aggregate_type, field_name);
    if field == null { return 0; }
    let type_node = sema_child((*context).parser, field, 1);
    if type_node == null { return 0; }
    return sema_type_from_node(context, (*type_node).id, scope_id);
}

proc sema_set_field_diagnostic_context(
    context: *mut Sema,
    field_declaration: *const ASTNode
) {
    if context == null or field_declaration == null or (*context).diagnostic_count == 0 { return; }
    let diag_ptr = (&mut (*context).diagnostics[(*context).diagnostic_count - 1]) as *mut SemaDiagnostic;
    set (*diag_ptr).type_context = SemaTypeContextKind.Field;
    set (*diag_ptr).context_index = (*field_declaration).id as usize;
    let name_node = sema_child((*context).parser, field_declaration, 0);
    let name_token = sema_token_name_node((*context).parser, name_node);
    let mut help: string = "The field value does not satisfy its declared type.";
    if name_token != null {
        let name = string.from_bytes((*name_token).lexeme, (*name_token).length);
        set help = "Value for field `" + name + "` does not match its declared type.";
    }
    let bytes: [u8] = help.bytes();
    let limit: usize = if bytes.len() < 511 { bytes.len() } else { 511 as usize };
    copy((&mut (*diag_ptr).help[0]) as *mut u8, bytes.as_ptr(), limit);
}

proc sema_set_assignment_diagnostic_context(
    context: *mut Sema,
    target: *const ASTNode,
    show_mutability_help: bool
) {
    if context == null or target == null or (*context).diagnostic_count == 0 { return; }
    let diag_ptr = (&mut (*context).diagnostics[(*context).diagnostic_count - 1]) as *mut SemaDiagnostic;
    set (*diag_ptr).type_context = SemaTypeContextKind.Assignment;
    set (*diag_ptr).context_index = SEMA_SIZE_MAX;
    let target_info = sema_node_info_mut(context, (*target).id);
    if target_info != null {
        set (*diag_ptr).context_symbol_id = (*target_info).symbol_id;
    }
    if show_mutability_help {
        let help = "Assignment target is immutable or does not designate a writable location.";
        let bytes: [u8] = help.bytes();
        let limit: usize = if bytes.len() < 511 { bytes.len() } else { 511 as usize };
        copy((&mut (*diag_ptr).help[0]) as *mut u8, bytes.as_ptr(), limit);
    }
}

proc sema_register_generic_parameters(
    context: *mut Sema,
    owner: *const ASTNode,
    scope_id: ScopeId,
    reuse_existing_types: bool
) -> bool {
    let mut child_index: usize = 1;
    while child_index < (*owner).child_count {
        let generic = sema_child((*context).parser, owner, child_index);
        if generic != null and (*generic).kind == ASTNodeKind.GenericParam {
            let name_node = sema_child((*context).parser, generic, 0);
            let token = sema_token_name_node((*context).parser, name_node);
            if token == null { return false; }
            let symbol = vitte_scope_declare(
                sema_scope_ptr(context), scope_id,
                (*token).lexeme.as_ptr() as *const u8, (*token).length,
                SymbolKind.GenericParameter, SymbolVisibility.Private, 0,
                ScopeSpan { file_id: (*generic).span.file_id, begin: (*generic).span.begin, end: (*generic).span.end, line: (*generic).span.line, column: (*generic).span.column, valid: (*generic).span.valid },
                null
            );
            if symbol == 0 {
                let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.DuplicateDeclaration, generic, 0, 0);
                return false;
            }
            let generic_info = sema_node_info_mut(context, (*generic).id);
            let mut type_id: SemaTypeId = 0;
            if reuse_existing_types and generic_info != null {
                set type_id = (*generic_info).type_id;
            }
            if type_id == 0 {
                set type_id = sema_add_type(context, SemaTypeKind.GenericParameter, 0, 0, symbol, false, 0, null, 0);
                if generic_info != null { set (*generic_info).type_id = type_id; }
            }
            if type_id == 0 { return false; }
            sema_symbol_set_type(context, symbol, type_id);
            if generic_info != null {
                set (*generic_info).symbol_id = symbol;
                set (*generic_info).scope_id = scope_id;
                set (*generic_info).node_flags = (*generic_info).node_flags | SEMA_NODE_FLAG_DECLARATION;
            }
        }
        set child_index += 1;
    }
    return true;
}

proc sema_predeclare(context: *mut Sema, root: *const ASTNode, scope_id: ScopeId) -> bool {
    let mut pass: usize = 0;
    while pass < 2 {
        let mut index: usize = 0;
        while index < (*root).child_count {
            let node = sema_child((*context).parser, root, index);
            if node != null {
                let is_type = (*node).kind == ASTNodeKind.FormDecl or (*node).kind == ASTNodeKind.PickDecl or (*node).kind == ASTNodeKind.TypeDecl or (*node).kind == ASTNodeKind.OpaqueDecl or (*node).kind == ASTNodeKind.TraitDecl;
                let is_proc = (*node).kind == ASTNodeKind.ProcDecl or (*node).kind == ASTNodeKind.ExternProcDecl;
                if (pass == 0 and is_type) or (pass == 1 and is_proc) {
                    let symbol_kind: SymbolKind = if (*node).kind == ASTNodeKind.ProcDecl or (*node).kind == ASTNodeKind.ExternProcDecl { SymbolKind.Proc } else if (*node).kind == ASTNodeKind.FormDecl { SymbolKind.Form } else if (*node).kind == ASTNodeKind.PickDecl { SymbolKind.Pick } else if (*node).kind == ASTNodeKind.TypeDecl { SymbolKind.Type } else if (*node).kind == ASTNodeKind.TraitDecl { SymbolKind.Trait } else { SymbolKind.Opaque };
                    let symbol = sema_declare_node(context, node, scope_id, symbol_kind);
                    if symbol == 0 { let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.DuplicateDeclaration, node, 0, 0); }
                    else {
                        let info = sema_node_info_mut(context, (*node).id);
                        if info != null { set (*info).symbol_id = symbol; set (*info).node_flags = (*info).node_flags | SEMA_NODE_FLAG_DECLARATION | SEMA_NODE_FLAG_PREDECLARED; }
                        if is_type { let type_id = sema_add_type(context, SemaTypeKind.Named, 0, 0, symbol, false, 0, null, 0); sema_symbol_set_type(context, symbol, type_id); if info != null { set (*info).type_id = type_id; } }
                    }
                }
            }
            set index += 1;
        }
        set pass += 1;
    }
    let mut index: usize = 0;
    while index < (*root).child_count {
        let node = sema_child((*context).parser, root, index);
        if node != null and ((*node).kind == ASTNodeKind.ProcDecl or (*node).kind == ASTNodeKind.ExternProcDecl) {
            let info = sema_node_info_mut(context, (*node).id);
            if info != null and (*info).symbol_id != 0 {
                let signature_scope = vitte_scope_create(
                    sema_scope_ptr(context), scope_id, ScopeKind.Proc,
                    ScopeSpan { file_id: (*node).span.file_id, begin: (*node).span.begin, end: (*node).span.end, line: (*node).span.line, column: (*node).span.column, valid: (*node).span.valid },
                    null
                );
                if signature_scope == 0 or not sema_register_generic_parameters(context, node, signature_scope, false) {
                    set (*context).last_error = SemaError.InvalidScope;
                    return false;
                }
                let mut parameter_types: [SemaTypeId] = [];
                let mut return_type: SemaTypeId = (*context).type_void;
                let mut saw_return = false;
                let mut child_index: usize = 1;
                while child_index < (*node).child_count {
                    let child = sema_child((*context).parser, node, child_index);
                    if child != null and (*child).kind == ASTNodeKind.Parameter {
                        let parameter_type = sema_child((*context).parser, child, 1);
                        let type_id: SemaTypeId = if parameter_type == null { (*context).type_error } else { sema_type_from_node(context, (*parameter_type).id, signature_scope) };
                        if not parameter_types.push(type_id) { set (*context).last_error = SemaError.OutOfMemory; return false; }
                    } else if child != null and not saw_return and ((*child).kind == ASTNodeKind.TypeExpr or (*child).kind == ASTNodeKind.PointerType or (*child).kind == ASTNodeKind.ReferenceType or (*child).kind == ASTNodeKind.ArrayType or (*child).kind == ASTNodeKind.OptionalType) {
                        set return_type = sema_type_from_node(context, (*child).id, signature_scope);
                        set saw_return = true;
                    }
                    set child_index += 1;
                }
                let function_type = sema_add_type(context, SemaTypeKind.Function, 0, 0, (*info).symbol_id, false, return_type, parameter_types.as_ptr(), parameter_types.len());
                set (*info).type_id = function_type;
                sema_symbol_set_type(context, (*info).symbol_id, function_type);
            }
        }
        set index += 1;
    }
    return (*context).last_error == SemaError.None;
}

proc sema_analyze_expression(context: *mut Sema, node: *const ASTNode, scope_id: ScopeId) -> SemaTypeId {
    if node == null { return (*context).type_error; }
    set (*context).stats.expressions_checked = sema_sat_add((*context).stats.expressions_checked, 1);
    let mut result: SemaTypeId = (*context).type_error;
    match (*node).kind {
        case ASTNodeKind.IntegerLiteral => set result = (*context).type_i64,
        case ASTNodeKind.FloatLiteral => set result = (*context).type_f64,
        case ASTNodeKind.StringLiteral => set result = (*context).type_string,
        case ASTNodeKind.CharacterLiteral => set result = (*context).type_char,
        case ASTNodeKind.BoolLiteral => set result = (*context).type_bool,
        case ASTNodeKind.NullLiteral => set result = (*context).type_null,
        case ASTNodeKind.Identifier | ASTNodeKind.Path => {
            let mut pick_path_handled = false;
            if (*node).kind == ASTNodeKind.Path and (*node).child_count > 1 {
                let mut is_pick_path = false;
                let pick_type = sema_pick_variant_type(context, node, scope_id, &mut is_pick_path);
                if is_pick_path {
                    set pick_path_handled = true;
                    if pick_type != 0 {
                        let mut payload_count: usize = 0;
                        let _ = sema_pick_variant_payload(context, node, scope_id, &mut payload_count);
                        if payload_count == 0 {
                            set result = pick_type;
                            let info = sema_node_info_mut(context, (*node).id);
                            if info != null {
                                set (*info).type_id = pick_type;
                                set (*info).node_flags = (*info).node_flags | SEMA_NODE_FLAG_RESOLVED;
                            }
                        } else {
                            let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidArgumentCount, node, 0, 0);
                        }
                    } else {
                        let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.UnknownMember, node, 0, 0);
                    }
                }
            }
            if not pick_path_handled {
                let token = sema_token_name_node((*context).parser, node);
                let symbol: SymbolId = if token == null { 0 as SymbolId } else { vitte_scope_lookup_n(sema_scope_ptr(context), scope_id, (*token).lexeme.as_ptr() as *const u8, (*token).length) };
                if symbol == 0 {
                    if sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.UnresolvedName, node, 0, 0) and token != null {
                        sema_help_similar_name(context, scope_id, token);
                    }
                    set (*context).stats.unresolved_names = sema_sat_add((*context).stats.unresolved_names, 1);
                }
                else {
                    let record = vitte_scope_get_symbol(sema_scope_ptr(context), symbol);
                    if record != null {
                        let info = sema_node_info_mut(context, (*node).id);
                        if info != null {
                            set (*info).symbol_id = symbol;
                            set (*info).node_flags = (*info).node_flags | SEMA_NODE_FLAG_RESOLVED;
                            if (*record).kind == SymbolKind.Local or (*record).kind == SymbolKind.Parameter or (*record).kind == SymbolKind.Static {
                                set (*info).node_flags = (*info).node_flags | SEMA_NODE_FLAG_LVALUE | SEMA_NODE_FLAG_ADDRESSABLE;
                                if ((*record).declaration_flags & SYMBOL_FLAG_MUTABLE) != 0 {
                                    set (*info).node_flags = (*info).node_flags | SEMA_NODE_FLAG_MUTABLE;
                                }
                            }
                        }
                        set (*context).stats.names_resolved = sema_sat_add((*context).stats.names_resolved, 1);
                        set result = sema_symbol_type(context, symbol);
                        if result == 0 { set result = (*context).type_error; }
                        if result == (*context).type_error and (*record).kind == SymbolKind.Proc { let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidType, node, 0, 0); }
                    }
                }
            }
        },
        case ASTNodeKind.TypeExpr => set result = sema_type_from_node(context, (*node).id, scope_id),
        case ASTNodeKind.PointerType | ASTNodeKind.ReferenceType | ASTNodeKind.ArrayType | ASTNodeKind.OptionalType => set result = sema_type_from_node(context, (*node).id, scope_id),
        case ASTNodeKind.GroupExpr => {
            let child = sema_child((*context).parser, node, 0);
            if child != null {
                set result = sema_analyze_expression(context, child, scope_id);
                let child_info = sema_node_info_mut(context, (*child).id);
                let info = sema_node_info_mut(context, (*node).id);
                if child_info != null and info != null {
                    set (*info).symbol_id = (*child_info).symbol_id;
                    set (*info).node_flags = (*info).node_flags |
                        ((*child_info).node_flags &
                         (SEMA_NODE_FLAG_LVALUE | SEMA_NODE_FLAG_MUTABLE | SEMA_NODE_FLAG_ADDRESSABLE));
                }
            }
        },
        case ASTNodeKind.BlockExpr => if (*node).child_count != 0 { set result = sema_analyze_expression(context, sema_child((*context).parser, node, 0), scope_id); },
        case ASTNodeKind.UnaryExpr => {
            let operand_node = sema_child((*context).parser, node, 0);
            let operand = sema_analyze_expression(context, operand_node, scope_id);
            let op = (*node).operator_kind;
            let operand_record: *const SemaType = if operand != 0 and operand <= (*context).type_count as SemaTypeId { &(*context).types[(operand - 1) as usize] } else { null };
            if operand == (*context).type_error {
                set result = (*context).type_error;
            } else if op == TokenKind.Bang or op == TokenKind.KwNot {
                let value_operand = sema_value_type(context as *const Sema, operand);
                if value_operand == (*context).type_bool { set result = (*context).type_bool; }
                else { let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidUnaryOperand, node, (*context).type_bool, value_operand); }
            } else if op == TokenKind.Tilde {
                if sema_type_integer(context as *const Sema, operand) { set result = operand; }
                else { let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidUnaryOperand, node, (*context).type_i64, operand); }
            } else if op == TokenKind.Amp or op == TokenKind.KwRef {
                let operand_info = if operand_node == null { null } else { sema_node_info_mut(context, (*operand_node).id) };
                let is_mutable_reference = ((*node).node_flags & PARSER_AST_FLAG_MUTABLE) != 0;
                if operand_info != null and ((*operand_info).node_flags & SEMA_NODE_FLAG_ADDRESSABLE) != 0 and
                   (not is_mutable_reference or ((*operand_info).node_flags & SEMA_NODE_FLAG_MUTABLE) != 0) {
                    set result = sema_add_type(context, SemaTypeKind.Reference, operand, 0, 0, is_mutable_reference, 0, null, 0);
                } else {
                    let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidUnaryOperand, node, 0, operand);
                }
            } else if op == TokenKind.Star {
                if operand_record != null and ((*operand_record).kind == SemaTypeKind.Pointer or (*operand_record).kind == SemaTypeKind.Reference) {
                    set result = (*operand_record).element_type;
                    let info = sema_node_info_mut(context, (*node).id);
                    if info != null {
                        set (*info).node_flags = (*info).node_flags | SEMA_NODE_FLAG_LVALUE | SEMA_NODE_FLAG_ADDRESSABLE;
                        if (*operand_record).is_mutable { set (*info).node_flags = (*info).node_flags | SEMA_NODE_FLAG_MUTABLE; }
                    }
                } else {
                    let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidUnaryOperand, node, 0, operand);
                }
            } else if op == TokenKind.Plus or op == TokenKind.Minus {
                let value_operand = sema_value_type(context as *const Sema, operand);
                if sema_type_numeric(context as *const Sema, value_operand) { set result = value_operand; }
                else { let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidUnaryOperand, node, 0, value_operand); }
            } else {
                let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidUnaryOperand, node, 0, operand);
            }
        },
        case ASTNodeKind.BinaryExpr | ASTNodeKind.AssignExpr => {
            let left_node = sema_child((*context).parser, node, 0);
            let right_node = sema_child((*context).parser, node, 1);
            let mut left = sema_analyze_expression(context, left_node, scope_id);
            let mut right = sema_analyze_expression(context, right_node, scope_id);
            let op = (*node).operator_kind;
            let is_logical = op == TokenKind.AmpAmp or op == TokenKind.PipePipe or op == TokenKind.KwAnd or op == TokenKind.KwOr;
            let is_equality = op == TokenKind.EqualEqual or op == TokenKind.BangEqual;
            let is_ordering = op == TokenKind.Less or op == TokenKind.LessEqual or op == TokenKind.Greater or op == TokenKind.GreaterEqual;
            let is_assignment = (*node).kind == ASTNodeKind.AssignExpr;
            if is_equality and sema_value_type(context as *const Sema, left) != left and sema_value_type(context as *const Sema, right) == right {
                set left = sema_value_type(context as *const Sema, left);
            } else if is_equality and sema_value_type(context as *const Sema, right) != right and sema_value_type(context as *const Sema, left) == left {
                set right = sema_value_type(context as *const Sema, right);
            }
            if is_logical or is_ordering or op == TokenKind.DotDot or op == TokenKind.DotDotEqual or op == TokenKind.Plus or op == TokenKind.Minus or op == TokenKind.Star or op == TokenKind.Slash or op == TokenKind.Percent or op == TokenKind.Amp or op == TokenKind.Pipe or op == TokenKind.Caret or op == TokenKind.ShiftLeft or op == TokenKind.ShiftRight {
                set left = sema_value_type(context as *const Sema, left);
                set right = sema_value_type(context as *const Sema, right);
            }
            if left != right and sema_integer_literal_fits(context as *const Sema, left, (*context).parser, right_node) { set right = left; }
            else if left != right and sema_integer_literal_fits(context as *const Sema, right, (*context).parser, left_node) { set left = right; }
            if is_equality and sema_pick_type_has_payload(context, left) {
                let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidBinaryOperands, node, left, right);
            } else if left == (*context).type_error or right == (*context).type_error {
                set result = (*context).type_error;
            } else if op == TokenKind.DotDot or op == TokenKind.DotDotEqual {
                if sema_type_integer(context as *const Sema, left) and vitte_sema_type_assignable(context as *const Sema, left, right) {
                    set result = sema_add_type(context, SemaTypeKind.Range, left, 0, 0, false, 0, null, 0);
                } else {
                    let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidBinaryOperands, node, left, right);
                }
            } else if is_assignment {
                let left_info = if left_node == null { null } else { sema_node_info_mut(context, (*left_node).id) };
                let left_symbol = if left_info == null or (*left_info).symbol_id == 0 { null } else { vitte_scope_get_symbol(sema_scope_ptr(context), (*left_info).symbol_id) };
                let left_is_lvalue = left_info != null and ((*left_info).node_flags & SEMA_NODE_FLAG_LVALUE) != 0;
                let left_is_direct_binding = left_node != null and
                    ((*left_node).kind == ASTNodeKind.Identifier or (*left_node).kind == ASTNodeKind.Path);
                let left_symbol_requires_mutability = left_is_direct_binding and left_symbol != null and
                    ((*left_symbol).kind == SymbolKind.Local or (*left_symbol).kind == SymbolKind.Parameter or (*left_symbol).kind == SymbolKind.Static);
                let left_symbol_is_immutable = left_symbol_requires_mutability and
                    ((*left_symbol).declaration_flags & SYMBOL_FLAG_MUTABLE) == 0;
                let left_place_is_immutable: bool = if left_is_direct_binding {
                    left_symbol_is_immutable
                } else {
                    left_info == null or ((*left_info).node_flags & SEMA_NODE_FLAG_MUTABLE) == 0
                };
                if not left_is_lvalue or left_place_is_immutable {
                    if sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.NotAssignable, node, left, right) {
                        sema_set_assignment_diagnostic_context(context, left_node, true);
                    }
                } else if op == TokenKind.Equal {
                    if sema_expression_assignable(context as *const Sema, left, right, right_node) { set result = left; }
                    else if sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.TypeMismatch, node, left, right) {
                        sema_set_assignment_diagnostic_context(context, left_node, false);
                    }
                } else {
                    let is_numeric_compound = op == TokenKind.PlusEqual or op == TokenKind.MinusEqual or op == TokenKind.StarEqual or op == TokenKind.SlashEqual;
                    let is_integer_compound = op == TokenKind.PercentEqual or op == TokenKind.AmpEqual or op == TokenKind.PipeEqual or op == TokenKind.CaretEqual or op == TokenKind.ShiftLeftEqual or op == TokenKind.ShiftRightEqual;
                    let compound_type = if is_numeric_compound { sema_common_numeric_type(context as *const Sema, left, right) } else { (*context).type_error };
                    let integer_operands = sema_type_integer(context as *const Sema, left) and sema_type_integer(context as *const Sema, right);
                    let mut valid_compound = false;
                    if is_numeric_compound { set valid_compound = compound_type != (*context).type_error; }
                    else if is_integer_compound { set valid_compound = integer_operands; }
                    let compound_result_type = if is_numeric_compound { compound_type } else if is_integer_compound and integer_operands { sema_common_numeric_type(context as *const Sema, left, right) } else { (*context).type_error };
                    if not valid_compound {
                        let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidBinaryOperands, node, left, right);
                    } else if not vitte_sema_type_assignable(context as *const Sema, left, compound_result_type) {
                        let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.TypeMismatch, node, left, compound_result_type);
                    } else {
                        set result = left;
                    }
                }
            } else if is_logical {
                if left == (*context).type_bool and right == (*context).type_bool { set result = (*context).type_bool; }
                else { let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidBinaryOperands, node, (*context).type_bool, if left != (*context).type_bool { left } else { right }); }
            } else if is_equality {
                if sema_expression_assignable(context as *const Sema, left, right, right_node) or sema_expression_assignable(context as *const Sema, right, left, left_node) { set result = (*context).type_bool; }
                else { let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidBinaryOperands, node, left, right); }
            } else if is_ordering {
                if sema_type_numeric(context as *const Sema, left) and sema_type_numeric(context as *const Sema, right) { set result = (*context).type_bool; }
                else { let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidBinaryOperands, node, left, right); }
            } else if op == TokenKind.Plus and left == (*context).type_string and right == (*context).type_string {
                set result = (*context).type_string;
            } else if op == TokenKind.Plus or op == TokenKind.Minus or op == TokenKind.Star or op == TokenKind.Slash {
                set result = sema_common_numeric_type(context as *const Sema, left, right);
                if result == (*context).type_error { let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidBinaryOperands, node, left, right); }
            } else if op == TokenKind.Percent or op == TokenKind.Amp or op == TokenKind.Pipe or op == TokenKind.Caret or op == TokenKind.ShiftLeft or op == TokenKind.ShiftRight {
                if sema_type_integer(context as *const Sema, left) and sema_type_integer(context as *const Sema, right) { set result = sema_common_numeric_type(context as *const Sema, left, right); }
                else { let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidBinaryOperands, node, left, right); }
            } else {
                let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidBinaryOperands, node, left, right);
            }
        },
        case ASTNodeKind.CastExpr => if (*node).child_count > 1 { set result = sema_type_from_node(context, (*node).children[1], scope_id); let _ = sema_analyze_expression(context, sema_child((*context).parser, node, 0), scope_id); },
        case ASTNodeKind.CallExpr => {
            let callee_node = sema_child((*context).parser, node, 0);
            let callee_token = sema_token_name_node((*context).parser, callee_node);
            let builtin: *const BuiltinDescriptor = if callee_token == null { null } else { vitte_builtin_find((*callee_token).lexeme) };
            let argument_count: usize = if (*node).child_count == 0 { 0 as usize } else { (*node).child_count - 1 };
            set (*context).stats.calls_checked = sema_sat_add((*context).stats.calls_checked, 1);
            let mut is_pick_path = false;
            let pick_type = if callee_node == null { 0 as SemaTypeId } else { sema_pick_variant_type(context, callee_node, scope_id, &mut is_pick_path) };
            if is_pick_path {
                if pick_type == 0 {
                    let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.UnknownMember, callee_node, 0, 0);
                } else {
                    let mut payload_count: usize = 0;
                    let _ = sema_pick_variant_payload(context, callee_node, scope_id, &mut payload_count);
                    if payload_count != argument_count {
                        let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidArgumentCount, node, 0, 0);
                    } else if payload_count == 0 {
                        set result = pick_type;
                    } else {
                        let mut arguments_valid = true;
                        let mut payload_index: usize = 0;
                        while payload_index < payload_count {
                            let payload_type = sema_pick_variant_payload_at(context, callee_node, scope_id, payload_index);
                            let argument_node = sema_child((*context).parser, node, payload_index + 1);
                            let argument_type = sema_analyze_expression(context, argument_node, scope_id);
                            if payload_type == 0 or not sema_expression_assignable(context as *const Sema, payload_type, argument_type, argument_node) {
                                let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidArgumentType, argument_node, payload_type, argument_type);
                                set arguments_valid = false;
                            }
                            set payload_index += 1;
                        }
                        if arguments_valid { set result = pick_type; }
                    }
                }
            } else if sema_name_is(callee_token, "len") {
                if argument_count != 1 and
                   sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidArgumentCount, node, 0, 0) {
                    sema_set_argument_count_help(context, 1, argument_count);
                }
                let mut argument_index: usize = 0;
                while argument_index < argument_count {
                    let argument_node = sema_child((*context).parser, node, argument_index + 1);
                    let argument_type = sema_analyze_expression(context, argument_node, scope_id);
                    if argument_index == 0 {
                        let argument_record: *const SemaType = if argument_type != 0 and argument_type <= (*context).type_count as SemaTypeId { &(*context).types[(argument_type - 1) as usize] } else { null };
                        if argument_type != (*context).type_string and
                           (argument_record == null or ((*argument_record).kind != SemaTypeKind.Array and (*argument_record).kind != SemaTypeKind.Slice)) and
                           argument_type != (*context).type_error {
                            if sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidArgumentType, argument_node, (*context).type_string, argument_type) {
                                let diag_ptr = (&mut (*context).diagnostics[(*context).diagnostic_count - 1]) as *mut SemaDiagnostic;
                                set (*diag_ptr).type_context = SemaTypeContextKind.Argument;
                                set (*diag_ptr).context_index = 1;
                                let help = "Argument 1 to builtin `len` has an incompatible type.";
                                let bytes: [u8] = help.bytes();
                                let limit: usize = if bytes.len() < 511 { bytes.len() } else { 511 as usize };
                                copy((&mut (*diag_ptr).help[0]) as *mut u8, bytes.as_ptr(), limit);
                            }
                        }
                    }
                    set argument_index += 1;
                }
                set result = (*context).type_u64;
            } else if builtin != null {
                let descriptor = *builtin;
                if not vitte_builtin_accepts_arity(builtin, argument_count) {
                    if sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidArgumentCount, node, 0, 0) {
                        sema_set_argument_count_help(context, descriptor.minimum_arity, argument_count);
                    }
                }
                let mut argument_index: usize = 0;
                let mut first_argument_type: SemaTypeId = 0;
                while argument_index < argument_count {
                    let argument_node = sema_child((*context).parser, node, argument_index + 1);
                    let argument_type = sema_analyze_expression(context, argument_node, scope_id);
                    if argument_index == 0 { set first_argument_type = argument_type; }
                    set argument_index += 1;
                }
                if descriptor.id == BuiltinId.PtrIsNull or descriptor.id == BuiltinId.Isnan or descriptor.id == BuiltinId.Isinf or descriptor.id == BuiltinId.Isfinite or descriptor.id == BuiltinId.Assume {
                    set result = if descriptor.id == BuiltinId.Assume { (*context).type_void } else { (*context).type_bool };
                } else if descriptor.id == BuiltinId.Memcmp or descriptor.id == BuiltinId.PtrDiff or descriptor.id == BuiltinId.Clz or descriptor.id == BuiltinId.Ctz or descriptor.id == BuiltinId.Popcount or descriptor.id == BuiltinId.Bswap or descriptor.id == BuiltinId.Rotl or descriptor.id == BuiltinId.Rotr or descriptor.id == BuiltinId.TargetPointerBits {
                    set result = (*context).type_u64;
                } else if descriptor.id == BuiltinId.Memcpy or descriptor.id == BuiltinId.Memmove or descriptor.id == BuiltinId.Memset or descriptor.id == BuiltinId.AtomicStore or descriptor.id == BuiltinId.AtomicFence or descriptor.id == BuiltinId.Unreachable or descriptor.id == BuiltinId.Trap or descriptor.id == BuiltinId.DebugBreak {
                    set result = (*context).type_void;
                } else if descriptor.id == BuiltinId.AtomicLoad or descriptor.id == BuiltinId.AtomicExchange or descriptor.id == BuiltinId.AtomicCompareExchange or descriptor.id == BuiltinId.AtomicFetchAdd or descriptor.id == BuiltinId.AtomicFetchSub or descriptor.id == BuiltinId.PtrOffset {
                    let pointer_type: *const SemaType = if first_argument_type != 0 and first_argument_type <= (*context).type_count as SemaTypeId { &(*context).types[(first_argument_type - 1) as usize] } else { null };
                    if pointer_type != null and ((*pointer_type).kind == SemaTypeKind.Pointer or (*pointer_type).kind == SemaTypeKind.Reference) { set result = (*pointer_type).element_type; }
                    else { set result = first_argument_type; }
                } else if descriptor.id == BuiltinId.CompilerVersion or descriptor.id == BuiltinId.TargetEndian {
                    set result = (*context).type_string;
                } else if descriptor.id == BuiltinId.AddOverflow or descriptor.id == BuiltinId.SubOverflow or descriptor.id == BuiltinId.MulOverflow {
                    set result = (*context).type_bool;
                } else {
                    set result = first_argument_type;
                }
                let info = sema_node_info_mut(context, (*node).id);
                if info != null { set (*info).node_flags = (*info).node_flags | SEMA_NODE_FLAG_BUILTIN; }
            } else {
                let callee = sema_analyze_expression(context, callee_node, scope_id);
                let type_: *const SemaType = if callee != 0 and callee <= (*context).type_count as SemaTypeId { (&((*context).types[(callee - 1) as usize])) as *const SemaType } else { null };
                if type_ != null and (*type_).kind == SemaTypeKind.Function {
                    let function_signature: SemaType = *type_;
                    set result = function_signature.return_type;
                    if argument_count != function_signature.function_parameter_count and
                       sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidArgumentCount, node, 0, 0) {
                        sema_set_argument_count_help(context, function_signature.function_parameter_count, argument_count);
                    }
                    let mut return_generic_id: SemaTypeId = 0;
                    if function_signature.return_type != 0 and function_signature.return_type <= (*context).type_count as SemaTypeId {
                        let return_type_record = &(*context).types[(function_signature.return_type - 1) as usize];
                        if (*return_type_record).kind == SemaTypeKind.GenericParameter { set return_generic_id = function_signature.return_type; }
                    }
                    let mut inferred_return_type: SemaTypeId = 0;
                    let mut argument_index: usize = 0;
                    while argument_index < argument_count {
                        let argument_node = sema_child((*context).parser, node, argument_index + 1);
                        let argument_type = sema_analyze_expression(context, argument_node, scope_id);
                        if argument_index < function_signature.function_parameter_count {
                            let expected_type = function_signature.function_parameter_types[argument_index];
                            let expected_is_generic = expected_type != 0 and expected_type <= (*context).type_count as SemaTypeId and (*context).types[(expected_type - 1) as usize].kind == SemaTypeKind.GenericParameter;
                            if expected_is_generic {
                                if expected_type == return_generic_id {
                                    if inferred_return_type == 0 { set inferred_return_type = argument_type; }
                                    else if not vitte_sema_type_assignable(context as *const Sema, inferred_return_type, argument_type) { let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidArgumentType, argument_node, inferred_return_type, argument_type); }
                                }
                            } else if not sema_expression_assignable(context as *const Sema, expected_type, argument_type, argument_node) {
                                if sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidArgumentType, argument_node, expected_type, argument_type) {
                                    sema_set_argument_diagnostic_context(context, function_signature.symbol_id, argument_index);
                                }
                            }
                        }
                        set argument_index += 1;
                    }
                    if return_generic_id != 0 and inferred_return_type != 0 { set result = inferred_return_type; }
                } else { let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.NotCallable, node, 0, callee); }
            }
        },
        case ASTNodeKind.ArrayExpr => {
            let mut element_type: SemaTypeId = (*context).type_error;
            let mut index: usize = 0;
            while index < (*node).child_count {
                let child = sema_child((*context).parser, node, index);
                let child_type = sema_analyze_expression(context, child, scope_id);
                if index == 0 { set element_type = child_type; }
                else if element_type != (*context).type_error and not vitte_sema_type_assignable(context as *const Sema, element_type, child_type) {
                    let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.TypeMismatch, child, element_type, child_type);
                }
                set index += 1;
            }
            set result = sema_add_type(context, SemaTypeKind.Array, element_type, (*node).child_count, 0, false, 0, null, 0);
        },
        case ASTNodeKind.IndexExpr => {
            let object_node = sema_child((*context).parser, node, 0);
            let index_node = sema_child((*context).parser, node, 1);
            let object_type = sema_analyze_expression(context, object_node, scope_id);
            let index_type = sema_analyze_expression(context, index_node, scope_id);
            if not sema_type_integer(context as *const Sema, index_type) and index_type != (*context).type_error {
                let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidIndexType, index_node, (*context).type_u64, index_type);
            }
            let object_record: *const SemaType = if object_type != 0 and object_type <= (*context).type_count as SemaTypeId { &(*context).types[(object_type - 1) as usize] } else { null };
            if object_type == (*context).type_string { set result = (*context).type_char; }
            else if object_record != null and ((*object_record).kind == SemaTypeKind.Array or (*object_record).kind == SemaTypeKind.Slice or (*object_record).kind == SemaTypeKind.Pointer or (*object_record).kind == SemaTypeKind.Reference) { set result = (*object_record).element_type; }
            else if object_type != (*context).type_error { let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.NotIndexable, node, 0, object_type); }
            if result != (*context).type_error and object_type != (*context).type_string and object_node != null {
                let object_info = sema_node_info_mut(context, (*object_node).id);
                let index_info = sema_node_info_mut(context, (*node).id);
                if object_info != null and index_info != null and ((*object_info).node_flags & SEMA_NODE_FLAG_LVALUE) != 0 {
                    set (*index_info).node_flags = (*index_info).node_flags | SEMA_NODE_FLAG_LVALUE | SEMA_NODE_FLAG_ADDRESSABLE;
                    set (*index_info).symbol_id = (*object_info).symbol_id;
                    if ((*object_info).node_flags & SEMA_NODE_FLAG_MUTABLE) != 0 or
                       (object_record != null and
                        ((*object_record).kind == SemaTypeKind.Pointer or (*object_record).kind == SemaTypeKind.Reference) and
                        (*object_record).is_mutable) {
                        set (*index_info).node_flags = (*index_info).node_flags | SEMA_NODE_FLAG_MUTABLE;
                    }
                }
            }
        },
        case ASTNodeKind.MemberExpr => {
            let mut is_pick_path = false;
            let pick_type = sema_pick_variant_type(context, node, scope_id, &mut is_pick_path);
            if is_pick_path {
                if pick_type == 0 {
                    let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.UnknownMember, node, 0, 0);
                } else {
                    let mut payload_count: usize = 0;
                    let _ = sema_pick_variant_payload(context, node, scope_id, &mut payload_count);
                    if payload_count == 0 {
                        set result = pick_type;
                        let info = sema_node_info_mut(context, (*node).id);
                        if info != null {
                            set (*info).type_id = pick_type;
                            set (*info).node_flags = (*info).node_flags | SEMA_NODE_FLAG_RESOLVED;
                        }
                    } else {
                        let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidArgumentCount, node, 0, 0);
                    }
                }
            } else {
                let object_node = sema_child((*context).parser, node, 0);
                let member_node = sema_child((*context).parser, node, 1);
                let mut object_type = sema_analyze_expression(context, object_node, scope_id);
                let mut object_reference_mutable = false;
                let member_token = sema_token_name_node((*context).parser, member_node);
                if object_type != 0 and object_type <= (*context).type_count as SemaTypeId {
                    let object_record = &(*context).types[(object_type - 1) as usize];
                    if (*object_record).kind == SemaTypeKind.Pointer or (*object_record).kind == SemaTypeKind.Reference {
                        set object_reference_mutable = (*object_record).is_mutable;
                        set object_type = (*object_record).element_type;
                    }
                }
                let field_type = sema_form_field_type(context, object_type, member_token, scope_id);
                if field_type == 0 {
                    let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.UnknownMember, member_node, 0, object_type);
                } else {
                    set result = field_type;
                    let object_info = if object_node == null { null } else { sema_node_info_mut(context, (*object_node).id) };
                    let member_info = sema_node_info_mut(context, (*node).id);
                    if object_info != null and member_info != null and ((*object_info).node_flags & SEMA_NODE_FLAG_LVALUE) != 0 {
                        set (*member_info).node_flags = (*member_info).node_flags | SEMA_NODE_FLAG_LVALUE | SEMA_NODE_FLAG_ADDRESSABLE;
                        set (*member_info).symbol_id = (*object_info).symbol_id;
                        if ((*object_info).node_flags & SEMA_NODE_FLAG_MUTABLE) != 0 or object_reference_mutable {
                            set (*member_info).node_flags = (*member_info).node_flags | SEMA_NODE_FLAG_MUTABLE;
                        }
                    }
                }
            }
        },
        case ASTNodeKind.FieldInit => {
            let value = sema_child((*context).parser, node, 1);
            if value != null { set result = sema_analyze_expression(context, value, scope_id); }
        },
        case ASTNodeKind.FormExpr => {
            let type_node = sema_child((*context).parser, node, 0);
            set result = sema_analyze_expression(context, type_node, scope_id);
            let mut index: usize = 1;
            while index < (*node).child_count {
                let field = sema_child((*context).parser, node, index);
                if field != null and (*field).kind == ASTNodeKind.FieldInit {
                    let field_name = sema_token_name_node((*context).parser, sema_child((*context).parser, field, 0));
                    let field_type = sema_form_field_type(context, result, field_name, scope_id);
                    let value_node = sema_child((*context).parser, field, 1);
                    let value_type = sema_analyze_expression(context, value_node, scope_id);
                    if field_type == 0 { let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.UnknownMember, field, 0, result); }
                    else if not sema_expression_assignable(context as *const Sema, field_type, value_type, value_node) and
                            sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.TypeMismatch, value_node, field_type, value_type) {
                        sema_set_field_diagnostic_context(
                            context,
                            sema_form_field_declaration(context, result, field_name)
                        );
                    }
                }
                set index += 1;
            }
        },
        case ASTNodeKind.IfExpr => {
            let condition_node = sema_child((*context).parser, node, 0);
            let condition_type = sema_analyze_expression(context, condition_node, scope_id);
            let value_condition_type = sema_value_type(context as *const Sema, condition_type);
            if value_condition_type != (*context).type_bool and value_condition_type != (*context).type_error { let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.ConditionNotBool, condition_node, (*context).type_bool, value_condition_type); }
            let then_node = sema_child((*context).parser, node, 1);
            let else_node = sema_child((*context).parser, node, 2);
            let then_type = if then_node == null { (*context).type_void } else { sema_analyze_expression(context, then_node, scope_id) };
            if else_node != null {
                let else_type = sema_analyze_expression(context, else_node, scope_id);
                if vitte_sema_type_assignable(context as *const Sema, then_type, else_type) { set result = then_type; }
                else if vitte_sema_type_assignable(context as *const Sema, else_type, then_type) { set result = else_type; }
                else { let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.TypeMismatch, node, then_type, else_type); }
            } else { set result = (*context).type_void; }
        },
        case ASTNodeKind.AwaitExpr => if (*node).child_count != 0 { set result = sema_analyze_expression(context, sema_child((*context).parser, node, 0), scope_id); },
        case ASTNodeKind.TryExpr => {
            let inner = sema_analyze_expression(context, sema_child((*context).parser, node, 0), scope_id);
            let inner_type: *const SemaType = if inner != 0 and inner <= (*context).type_count as SemaTypeId { &(*context).types[(inner - 1) as usize] } else { null };
            if inner_type != null and (*inner_type).kind == SemaTypeKind.Optional { set result = (*inner_type).element_type; }
            else if inner != (*context).type_error { let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.InvalidType, node, 0, inner); }
        },
        case ASTNodeKind.SizeofExpr | ASTNodeKind.AlignofExpr => {
            if (*node).child_count != 0 { let _ = sema_analyze_expression(context, sema_child((*context).parser, node, 0), scope_id); }
            set result = (*context).type_u64;
        },
        case _ => {
            let mut index: usize = 0;
            while index < (*node).child_count { let child = sema_child((*context).parser, node, index); if child != null { let _ = sema_analyze_node(context, (*child).id, scope_id); } set index += 1; }
            set result = (*context).type_void;
        }
    }
    let info = sema_node_info_mut(context, (*node).id);
    if info != null { set (*info).type_id = result; set (*info).scope_id = scope_id; }
    return result;
}

proc sema_analyze_node(context: *mut Sema, node_id: ASTNodeId, scope_id: ScopeId) -> SemaTypeId {
    let node = sema_node((*context).parser, node_id);
    if node == null { set (*context).last_error = SemaError.InvalidAst; return (*context).type_error; }
    if (*context).recursion_depth >= (*context).max_recursion_depth { set (*context).last_error = SemaError.RecursionLimit; return (*context).type_error; }
    set (*context).recursion_depth += 1;
    if (*context).recursion_depth as u64 > (*context).stats.max_recursion_depth { set (*context).stats.max_recursion_depth = (*context).recursion_depth as u64; }
    set (*context).stats.nodes_visited = sema_sat_add((*context).stats.nodes_visited, 1);
    let info = sema_node_info_mut(context, node_id);
    if info != null { set (*info).scope_id = scope_id; }
    let mut result: SemaTypeId = (*context).type_void;
    match (*node).kind {
        case ASTNodeKind.TranslationUnit => {
            if not sema_predeclare(context, node, scope_id) { set (*context).last_error = SemaError.Validation; }
            let mut index: usize = 0;
            while index < (*node).child_count { let child = sema_child((*context).parser, node, index); if child != null { let _ = sema_analyze_node(context, (*child).id, scope_id); } set index += 1; }
        },
        case ASTNodeKind.FormDecl => {
            let mut index: usize = 1;
            while index < (*node).child_count {
                let field = sema_child((*context).parser, node, index);
                if field != null and (*field).kind == ASTNodeKind.FieldDecl and (*field).child_count > 1 {
                    let field_type = sema_child((*context).parser, field, 1);
                    if field_type != null {
                        let _ = sema_type_from_node(context, (*field_type).id, scope_id);
                    }
                }
                set index += 1;
            }
        },
        case ASTNodeKind.PickDecl => {
            // Variant names are declarations owned by the pick and are not
            // ordinary expressions. Only payload types need semantic visits.
            let mut index: usize = 1;
            while index < (*node).child_count {
                let variant = sema_child((*context).parser, node, index);
                if variant != null and (*variant).kind == ASTNodeKind.VariantDecl {
                    let mut payload_index: usize = 1;
                    while payload_index < (*variant).child_count {
                        let payload_type = sema_child((*context).parser, variant, payload_index);
                        if payload_type != null {
                            let _ = sema_type_from_node(context, (*payload_type).id, scope_id);
                        }
                        set payload_index += 1;
                    }
                }
                set index += 1;
            }
        },
        case ASTNodeKind.ProcDecl | ASTNodeKind.ExternProcDecl => {
            let procedure_scope = vitte_scope_create(sema_scope_ptr(context), scope_id, ScopeKind.Proc, ScopeSpan { file_id: (*node).span.file_id, begin: (*node).span.begin, end: (*node).span.end, line: (*node).span.line, column: (*node).span.column, valid: (*node).span.valid }, null);
            if procedure_scope == 0 { set (*context).last_error = SemaError.InvalidScope; }
            else {
                if not sema_register_generic_parameters(context, node, procedure_scope, true) {
                    set (*context).last_error = SemaError.InvalidScope;
                }
                let previous_return: SemaTypeId = (*context).current_return_type;
                let previous_proc_scope: ScopeId = (*context).current_proc_scope;
                let own_info = sema_node_info_mut(context, node_id);
                let mut function_signature: SemaType = SemaType {};
                let mut has_function_signature = false;
                if own_info != null and (*own_info).type_id != 0 { set function_signature = (*context).types[((*own_info).type_id - 1) as usize]; set has_function_signature = function_signature.kind == SemaTypeKind.Function; }
                set (*context).current_return_type = if not has_function_signature { (*context).type_void } else { function_signature.return_type };
                set (*context).current_proc_scope = procedure_scope;
                let mut index: usize = 1;
                let mut parameter_index: usize = 0;
                while index < (*node).child_count {
                    let child = sema_child((*context).parser, node, index);
                    if child != null and (*child).kind == ASTNodeKind.Parameter {
                        let name_node = sema_child((*context).parser, child, 0);
                        let parameter_type_id: SemaTypeId = if has_function_signature and parameter_index < function_signature.function_parameter_count { function_signature.function_parameter_types[parameter_index] } else { (*context).type_error };
                        let binding_flags: u32 = if ((*child).node_flags & PARSER_AST_FLAG_MUTABLE) != 0 { PARSER_AST_FLAG_PATTERN_MUTABLE } else { 0 as u32 };
                        if name_node != null { let _ = sema_bind_pattern(context, name_node, procedure_scope, parameter_type_id, binding_flags); }
                        set parameter_index += 1;
                    } else if child != null and (*child).kind == ASTNodeKind.Block { let _ = sema_analyze_node(context, (*child).id, procedure_scope); }
                    set index += 1;
                }
                set (*context).current_return_type = previous_return;
                set (*context).current_proc_scope = previous_proc_scope;
            }
        },
        case ASTNodeKind.LetStmt | ASTNodeKind.ConstDecl | ASTNodeKind.StaticDecl => {
            let name_node = sema_child((*context).parser, node, 0);
            let mut inferred: SemaTypeId = (*context).type_error;
            let mut initializer: *const ASTNode = null;
            let mut explicit_type: *const ASTNode = null;
            let mut index: usize = 1;
            while index < (*node).child_count { let child = sema_child((*context).parser, node, index); if child != null { if (*child).kind == ASTNodeKind.TypeExpr or (*child).kind == ASTNodeKind.PointerType or (*child).kind == ASTNodeKind.ReferenceType or (*child).kind == ASTNodeKind.ArrayType or (*child).kind == ASTNodeKind.OptionalType { set explicit_type = child; } else { set initializer = child; } } set index += 1; }
            if initializer != null { set inferred = sema_analyze_expression(context, initializer, scope_id); }
            if explicit_type != null { let declared = sema_type_from_node(context, (*explicit_type).id, scope_id); if inferred != (*context).type_error and not sema_expression_assignable(context as *const Sema, declared, inferred, initializer) { let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.TypeMismatch, node, declared, inferred); } set inferred = declared; }
            let kind: SymbolKind = if (*node).kind == ASTNodeKind.ConstDecl { SymbolKind.Const } else if (*node).kind == ASTNodeKind.StaticDecl { SymbolKind.Static } else { SymbolKind.Local };
            if (*node).kind == ASTNodeKind.LetStmt {
                let binding_flags: u32 = if ((*node).node_flags & PARSER_AST_FLAG_MUTABLE) != 0 { PARSER_AST_FLAG_PATTERN_MUTABLE } else { 0 as u32 };
                if name_node != null { let _ = sema_bind_pattern(context, name_node, scope_id, inferred, binding_flags); }
            } else {
                let token = sema_token_name_node((*context).parser, name_node);
                if token != null { let symbol = vitte_scope_declare(sema_scope_ptr(context), scope_id, (*token).lexeme.as_ptr() as *const u8, (*token).length, kind, SymbolVisibility.Private, sema_symbol_flags((*node).node_flags), ScopeSpan { file_id: (*node).span.file_id, begin: (*node).span.begin, end: (*node).span.end, line: (*node).span.line, column: (*node).span.column, valid: (*node).span.valid }, null); if symbol == 0 { let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.DuplicateDeclaration, node, 0, 0); } else { sema_symbol_set_type(context, symbol, inferred); if info != null { set (*info).symbol_id = symbol; set (*info).node_flags = (*info).node_flags | SEMA_NODE_FLAG_DECLARATION; } } }
            }
            set result = inferred;
        },
        case ASTNodeKind.Block => {
            let block_scope = vitte_scope_create(sema_scope_ptr(context), scope_id, ScopeKind.Block, ScopeSpan { file_id: (*node).span.file_id, begin: (*node).span.begin, end: (*node).span.end, line: (*node).span.line, column: (*node).span.column, valid: (*node).span.valid }, null);
            let active_scope: ScopeId = if block_scope == 0 { scope_id } else { block_scope };
            let mut index: usize = 0;
            while index < (*node).child_count { let child = sema_child((*context).parser, node, index); if child != null { let _ = sema_analyze_node(context, (*child).id, active_scope); } set index += 1; }
        },
        case ASTNodeKind.IfStmt => {
            let condition = sema_analyze_expression(context, sema_child((*context).parser, node, 0), scope_id);
            let value_condition_type = sema_value_type(context as *const Sema, condition);
            if value_condition_type != (*context).type_bool and value_condition_type != (*context).type_error {
                let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.ConditionNotBool, sema_child((*context).parser, node, 0), (*context).type_bool, value_condition_type);
            }
            let mut index: usize = 1;
            while index < (*node).child_count {
                let child = sema_child((*context).parser, node, index);
                if child != null { let _ = sema_analyze_node(context, (*child).id, scope_id); }
                set index += 1;
            }
        },
        case ASTNodeKind.WhileStmt => {
            let condition_node = sema_child((*context).parser, node, 0);
            let condition = sema_analyze_expression(context, condition_node, scope_id);
            let value_condition_type = sema_value_type(context as *const Sema, condition);
            if value_condition_type != (*context).type_bool and value_condition_type != (*context).type_error {
                let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.ConditionNotBool, condition_node, (*context).type_bool, value_condition_type);
            }
            set (*context).loop_depth += 1;
            let body = sema_child((*context).parser, node, 1);
            if body != null { let _ = sema_analyze_node(context, (*body).id, scope_id); }
            set (*context).loop_depth -= 1;
        },
        case ASTNodeKind.LoopStmt => {
            set (*context).loop_depth += 1;
            let body = sema_child((*context).parser, node, 0);
            if body != null { let _ = sema_analyze_node(context, (*body).id, scope_id); }
            set (*context).loop_depth -= 1;
        },
        case ASTNodeKind.ForStmt => {
            let binding = sema_child((*context).parser, node, 0);
            let iterable_node = sema_child((*context).parser, node, 1);
            let iterable_type = sema_analyze_expression(context, iterable_node, scope_id);
            let iterable_record: *const SemaType = if iterable_type != 0 and iterable_type <= (*context).type_count as SemaTypeId { &(*context).types[(iterable_type - 1) as usize] } else { null };
            let mut element_type: SemaTypeId = (*context).type_error;
            if iterable_record != null and ((*iterable_record).kind == SemaTypeKind.Array or (*iterable_record).kind == SemaTypeKind.Slice or (*iterable_record).kind == SemaTypeKind.Range or (*iterable_record).kind == SemaTypeKind.Pointer) {
                set element_type = (*iterable_record).element_type;
            } else if iterable_type == (*context).type_string {
                set element_type = (*context).type_char;
            } else if iterable_type != (*context).type_error {
                let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.NotIndexable, iterable_node, 0, iterable_type);
            }
            let loop_scope = vitte_scope_create(sema_scope_ptr(context), scope_id, ScopeKind.Loop, ScopeSpan { file_id: (*node).span.file_id, begin: (*node).span.begin, end: (*node).span.end, line: (*node).span.line, column: (*node).span.column, valid: (*node).span.valid }, null);
            let active_scope: ScopeId = if loop_scope == 0 { scope_id } else { loop_scope };
            if binding != null { let _ = sema_bind_pattern(context, binding, active_scope, element_type, 0); }
            set (*context).loop_depth += 1;
            let body = sema_child((*context).parser, node, 2);
            if body != null { let _ = sema_analyze_node(context, (*body).id, active_scope); }
            set (*context).loop_depth -= 1;
        },
        case ASTNodeKind.BreakStmt => {
            if (*context).loop_depth == 0 { let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.BreakOutsideLoop, node, 0, 0); }
        },
        case ASTNodeKind.ContinueStmt => {
            if (*context).loop_depth == 0 { let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.ContinueOutsideLoop, node, 0, 0); }
        },
        case ASTNodeKind.MatchStmt => {
            let subject_node = sema_child((*context).parser, node, 0);
            let subject_type = sema_analyze_expression(context, subject_node, scope_id);
            let mut arm_index: usize = 1;
            while arm_index < (*node).child_count {
                let arm = sema_child((*context).parser, node, arm_index);
                if arm != null and (*arm).kind == ASTNodeKind.MatchArm {
                    let arm_scope = vitte_scope_create(sema_scope_ptr(context), scope_id, ScopeKind.MatchArm, ScopeSpan { file_id: (*arm).span.file_id, begin: (*arm).span.begin, end: (*arm).span.end, line: (*arm).span.line, column: (*arm).span.column, valid: (*arm).span.valid }, null);
                    let active_scope: ScopeId = if arm_scope == 0 { scope_id } else { arm_scope };
                    let pattern = sema_child((*context).parser, arm, 0);
                    if pattern != null {
                        sema_check_pick_pattern(context, pattern, scope_id, subject_type);
                        sema_bind_pattern(context, pattern, active_scope, subject_type, 0);
                    }
                    let body_index: usize = (*arm).child_count - 1;
                    if (*arm).child_count == 3 {
                        let guard = sema_child((*context).parser, arm, 1);
                        let guard_type = sema_analyze_expression(context, guard, active_scope);
                        let value_guard_type = sema_value_type(context as *const Sema, guard_type);
                        if value_guard_type != (*context).type_bool and value_guard_type != (*context).type_error {
                            let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.ConditionNotBool, guard, (*context).type_bool, value_guard_type);
                        }
                    }
                    let body = sema_child((*context).parser, arm, body_index);
                    if body != null { let _ = sema_analyze_node(context, (*body).id, active_scope); }
                }
                set arm_index += 1;
            }
        },
        case ASTNodeKind.ReturnStmt => {
            if (*node).child_count != 0 { set result = sema_analyze_expression(context, sema_child((*context).parser, node, 0), scope_id); }
            else { set result = (*context).type_void; }
            if (*context).current_proc_scope == 0 { let _ = sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.ReturnOutsideProc, node, 0, result); }
            else if not sema_expression_assignable(context as *const Sema, (*context).current_return_type, result, sema_child((*context).parser, node, 0)) and
                    sema_add_diagnostic(context, SemaDiagnosticKind.Error, SemaDiagnosticCode.ReturnTypeMismatch, node, (*context).current_return_type, result) {
                sema_set_return_diagnostic_context(context);
            }
        },
        case ASTNodeKind.ExprStmt => if (*node).child_count != 0 { set result = sema_analyze_expression(context, sema_child((*context).parser, node, 0), scope_id); },
        case ASTNodeKind.UseDecl => {},
        case _ => {
            if (*node).kind == ASTNodeKind.Identifier or (*node).kind == ASTNodeKind.Path or (*node).kind == ASTNodeKind.TypeExpr or (*node).kind == ASTNodeKind.IntegerLiteral or (*node).kind == ASTNodeKind.FloatLiteral or (*node).kind == ASTNodeKind.StringLiteral or (*node).kind == ASTNodeKind.CharacterLiteral or (*node).kind == ASTNodeKind.BoolLiteral or (*node).kind == ASTNodeKind.NullLiteral or (*node).kind == ASTNodeKind.BinaryExpr or (*node).kind == ASTNodeKind.UnaryExpr or (*node).kind == ASTNodeKind.AssignExpr or (*node).kind == ASTNodeKind.CallExpr or (*node).kind == ASTNodeKind.MemberExpr or (*node).kind == ASTNodeKind.IndexExpr or (*node).kind == ASTNodeKind.GroupExpr or (*node).kind == ASTNodeKind.BlockExpr or (*node).kind == ASTNodeKind.ArrayExpr or (*node).kind == ASTNodeKind.FormExpr or (*node).kind == ASTNodeKind.FieldInit or (*node).kind == ASTNodeKind.IfExpr or (*node).kind == ASTNodeKind.AwaitExpr or (*node).kind == ASTNodeKind.TryExpr or (*node).kind == ASTNodeKind.SizeofExpr or (*node).kind == ASTNodeKind.AlignofExpr or (*node).kind == ASTNodeKind.CastExpr { set result = sema_analyze_expression(context, node, scope_id); }
            else { let mut index: usize = 0; while index < (*node).child_count { let child = sema_child((*context).parser, node, index); if child != null { let _ = sema_analyze_node(context, (*child).id, scope_id); } set index += 1; } }
        }
    }
    if info != null { set (*info).type_id = result; }
    set (*context).recursion_depth -= 1;
    return result;
}

export proc vitte_sema_error_name(error: SemaError) -> string {
    match error { case SemaError.None => return "none"; case SemaError.InvalidArgument => return "invalid_argument"; case SemaError.InvalidContext => return "invalid_context"; case SemaError.InvalidState => return "invalid_state"; case SemaError.InvalidAst => return "invalid_ast"; case SemaError.InvalidScope => return "invalid_scope"; case SemaError.InvalidType => return "invalid_type"; case SemaError.TypeLimit => return "type_limit"; case SemaError.DiagnosticLimit => return "diagnostic_limit"; case SemaError.RecursionLimit => return "recursion_limit"; case SemaError.Overflow => return "overflow"; case SemaError.OutOfMemory => return "out_of_memory"; case SemaError.Validation => return "validation"; case SemaError.Corruption => return "corruption"; case SemaError.Internal => return "internal"; case SemaError.Count => return "count"; }
}
export proc vitte_sema_state_name(state: SemaState) -> string { match state { case SemaState.Invalid => return "invalid"; case SemaState.Ready => return "ready"; case SemaState.Analyzing => return "analyzing"; case SemaState.Done => return "done"; case SemaState.Failed => return "failed"; case SemaState.Destroyed => return "destroyed"; case SemaState.Count => return "count"; } }
export proc vitte_sema_type_kind_name(kind: SemaTypeKind) -> string { match kind { case SemaTypeKind.Invalid => return "invalid"; case SemaTypeKind.Error => return "error"; case SemaTypeKind.Void => return "void"; case SemaTypeKind.Bool => return "bool"; case SemaTypeKind.I64 => return "i64"; case SemaTypeKind.U64 => return "u64"; case SemaTypeKind.U8 => return "u8"; case SemaTypeKind.F32 => return "f32"; case SemaTypeKind.F64 => return "f64"; case SemaTypeKind.Char => return "char"; case SemaTypeKind.String => return "string"; case SemaTypeKind.Null => return "null"; case SemaTypeKind.Pointer => return "pointer"; case SemaTypeKind.Reference => return "reference"; case SemaTypeKind.Optional => return "optional"; case SemaTypeKind.Array => return "array"; case SemaTypeKind.Slice => return "slice"; case SemaTypeKind.Range => return "range"; case SemaTypeKind.Function => return "function"; case SemaTypeKind.Named => return "named"; case SemaTypeKind.Dyn => return "dyn"; case SemaTypeKind.GenericParameter => return "generic_parameter"; case SemaTypeKind.Count => return "count"; } }
export proc vitte_sema_type_conversion_kind_name(kind: SemaTypeConversionKind) -> string { match kind { case SemaTypeConversionKind.Incompatible => return "incompatible"; case SemaTypeConversionKind.Exact => return "exact"; case SemaTypeConversionKind.Safe => return "safe"; case SemaTypeConversionKind.Lossy => return "lossy"; case SemaTypeConversionKind.Count => return "count"; } }
export proc vitte_sema_diagnostic_kind_name(kind: SemaDiagnosticKind) -> string { match kind { case SemaDiagnosticKind.Note => return "note"; case SemaDiagnosticKind.Help => return "help"; case SemaDiagnosticKind.Warning => return "warning"; case SemaDiagnosticKind.Error => return "error"; case SemaDiagnosticKind.KindCount => return "count"; } }
export proc vitte_sema_diagnostic_code_name(code: SemaDiagnosticCode) -> string { match code { case SemaDiagnosticCode.None => return "none"; case SemaDiagnosticCode.UnresolvedName => return "unresolved_name"; case SemaDiagnosticCode.PrivateSymbol => return "private_symbol"; case SemaDiagnosticCode.DuplicateDeclaration => return "duplicate_declaration"; case SemaDiagnosticCode.ShadowedDeclaration => return "shadowed_declaration"; case SemaDiagnosticCode.UnknownType => return "unknown_type"; case SemaDiagnosticCode.NotAType => return "not_a_type"; case SemaDiagnosticCode.TypeMismatch => return "type_mismatch"; case SemaDiagnosticCode.InvalidUnaryOperand => return "invalid_unary_operand"; case SemaDiagnosticCode.InvalidBinaryOperands => return "invalid_binary_operands"; case SemaDiagnosticCode.NotAssignable => return "not_assignable"; case SemaDiagnosticCode.NotCallable => return "not_callable"; case SemaDiagnosticCode.InvalidArgumentCount => return "invalid_argument_count"; case SemaDiagnosticCode.InvalidArgumentType => return "invalid_argument_type"; case SemaDiagnosticCode.NotIndexable => return "not_indexable"; case SemaDiagnosticCode.InvalidIndexType => return "invalid_index_type"; case SemaDiagnosticCode.UnknownMember => return "unknown_member"; case SemaDiagnosticCode.ConditionNotBool => return "condition_not_bool"; case SemaDiagnosticCode.ReturnOutsideProc => return "return_outside_proc"; case SemaDiagnosticCode.ReturnTypeMismatch => return "return_type_mismatch"; case SemaDiagnosticCode.BreakOutsideLoop => return "break_outside_loop"; case SemaDiagnosticCode.ContinueOutsideLoop => return "continue_outside_loop"; case SemaDiagnosticCode.UnreachableCode => return "unreachable_code"; case SemaDiagnosticCode.RecursionLimit => return "recursion_limit"; case SemaDiagnosticCode.InvalidType => return "invalid_type"; case SemaDiagnosticCode.InvalidPatternBindings => return "invalid_pattern_bindings"; case SemaDiagnosticCode.CodeCount => return "count"; } }

export proc vitte_sema_init(context: *mut Sema, parser: *const Parser) -> bool {
    if context == null or parser == null or vitte_parser_root(parser) == 0 { return false; }
    fill(context as *mut u8, 0, sizeof(Sema));
    set (*context).magic = SEMA_MAGIC; set (*context).state = SemaState.Ready; set (*context).parser = parser;
    set (*context).max_types = SEMA_DEFAULT_MAX_TYPES; set (*context).max_diagnostics = SEMA_DEFAULT_MAX_DIAGNOSTICS; set (*context).max_recursion_depth = SEMA_DEFAULT_MAX_RECURSION_DEPTH; set (*context).generation = 1;
    if not vitte_scope_init(sema_scope_ptr(context)) { set (*context).state = SemaState.Failed; set (*context).last_error = SemaError.OutOfMemory; return false; }
    if not sema_builtin_types(context) { vitte_scope_destroy(sema_scope_ptr(context)); set (*context).state = SemaState.Failed; return false; }
    let count = vitte_parser_node_count(parser);
    if count != 0 {
        if count > SEMA_SIZE_MAX / sizeof(SemaNodeInfo) { vitte_scope_destroy(sema_scope_ptr(context)); return sema_fail(context, SemaError.Overflow); }
        let storage = allocate(count * sizeof(SemaNodeInfo));
        if storage == null { vitte_scope_destroy(sema_scope_ptr(context)); return sema_fail(context, SemaError.OutOfMemory); }
        fill(storage, 0, count * sizeof(SemaNodeInfo));
        set (*context).node_info = storage as usize as *SemaNodeInfo; set (*context).node_info_count = count; set (*context).node_info_capacity = count;
        let mut index: usize = 0; while index < count { set (*context).node_info[index].node_id = (index + 1) as ASTNodeId; set index += 1; }
    }
    return true;
}

export proc vitte_sema_reset(context: *mut Sema, parser: *const Parser) -> bool {
    if not sema_context_valid(context as *const Sema) or parser == null { if context != null { set (*context).last_error = SemaError.InvalidState; } return false; }
    let generation = (*context).generation;
    let max_types = (*context).max_types;
    let max_diagnostics = (*context).max_diagnostics;
    let max_recursion_depth = (*context).max_recursion_depth;
    vitte_sema_destroy(context);
    if not vitte_sema_init(context, parser) { return false; }
    if not vitte_sema_set_limits(context, max_types, max_diagnostics, max_recursion_depth) { return false; }
    set (*context).generation = if generation == 18446744073709551615 { generation } else { generation + 1 };
    return true;
}

export proc vitte_sema_destroy(context: *mut Sema) {
    if context == null { return; }
    if (*context).magic == SEMA_MAGIC {
        let mut index: usize = 0; while index < (*context).type_count { deallocate((*context).types[index].generic_arguments as *mut u8); deallocate((*context).types[index].function_parameter_types as *mut u8); set index += 1; }
        vitte_scope_destroy(sema_scope_ptr(context as *mut Sema)); deallocate((*context).types as *mut u8); deallocate((*context).node_info as *mut u8); deallocate((*context).diagnostics as *mut u8);
    }
    fill(context as *mut u8, 0, sizeof(Sema)); set (*context).magic = SEMA_DEAD_MAGIC; set (*context).state = SemaState.Destroyed;
}

export proc vitte_sema_is_valid(context: *const Sema) -> bool { return sema_context_valid(context); }
export proc vitte_sema_last_error(context: *const Sema) -> SemaError { if context == null or (*context).magic != SEMA_MAGIC { return SemaError.InvalidContext; } return (*context).last_error; }
export proc vitte_sema_generation(context: *const Sema) -> u64 { if not sema_context_valid(context) { return 0; } return (*context).generation; }
export proc vitte_sema_set_limits(context: *mut Sema, max_types: usize, max_diagnostics: usize, max_recursion_depth: usize) -> bool {
    if not sema_context_valid(context as *const Sema) { return false; }
    if (*context).state != SemaState.Ready or max_types == 0 or max_diagnostics == 0 or max_recursion_depth == 0 or max_types < (*context).type_count or max_diagnostics < (*context).diagnostic_count { set (*context).last_error = SemaError.InvalidArgument; return false; }
    set (*context).max_types = max_types; set (*context).max_diagnostics = max_diagnostics; set (*context).max_recursion_depth = max_recursion_depth; set (*context).last_error = SemaError.None; return true;
}

export proc vitte_sema_run(context: *mut Sema) -> bool {
    if not sema_context_valid(context as *const Sema) { return false; }
    if (*context).state != SemaState.Ready { return sema_fail(context, SemaError.InvalidState); }
    let root_id = vitte_parser_root((*context).parser);
    let root = sema_node((*context).parser, root_id);
    if root == null or sema_node_info_mut(context, root_id) == null { return sema_fail(context, SemaError.InvalidAst); }
    set (*context).state = SemaState.Analyzing; set (*context).last_error = SemaError.None; set (*context).stats.runs = sema_sat_add((*context).stats.runs, 1);
    let root_scope = vitte_scope_root(&(*context).scopes);
    let _ = sema_analyze_node(context, root_id, root_scope);
    if (*context).last_error == SemaError.RecursionLimit or (*context).last_error == SemaError.OutOfMemory or (*context).last_error == SemaError.TypeLimit or (*context).last_error == SemaError.DiagnosticLimit or (*context).last_error == SemaError.Overflow { set (*context).stats.failed_runs = sema_sat_add((*context).stats.failed_runs, 1); return sema_fail(context, (*context).last_error); }
    if not vitte_scope_seal(sema_scope_ptr(context)) { return sema_fail(context, SemaError.Validation); }
    set (*context).state = SemaState.Done; set (*context).last_error = SemaError.None;
    return true;
}

export proc vitte_sema_get_type(context: *const Sema, type_id: SemaTypeId) -> *const SemaType { if not sema_context_valid(context) or type_id == 0 or type_id > (*context).type_count as SemaTypeId { return null; } return &(*context).types[(type_id - 1) as usize]; }
proc sema_type_identical(context: *const Sema, left_id: SemaTypeId, right_id: SemaTypeId, depth: usize) -> bool {
    if left_id == right_id { return left_id != 0; }
    if context == null or left_id == 0 or right_id == 0 or left_id > (*context).type_count as SemaTypeId or right_id > (*context).type_count as SemaTypeId or depth >= SEMA_DEFAULT_MAX_RECURSION_DEPTH { return false; }
    let left: &SemaType = &(*context).types[(left_id - 1) as usize];
    let right: &SemaType = &(*context).types[(right_id - 1) as usize];
    if left.kind != right.kind or left.is_mutable != right.is_mutable or left.array_length != right.array_length or left.generic_argument_count != right.generic_argument_count or left.function_parameter_count != right.function_parameter_count { return false; }
    if left.kind == SemaTypeKind.Named or left.kind == SemaTypeKind.Dyn or left.kind == SemaTypeKind.GenericParameter {
        if left.symbol_id != right.symbol_id { return false; }
    }
    if left.element_type != 0 or right.element_type != 0 { if not sema_type_identical(context, left.element_type, right.element_type, depth + 1) { return false; } }
    if left.return_type != 0 or right.return_type != 0 { if not sema_type_identical(context, left.return_type, right.return_type, depth + 1) { return false; } }
    let mut index: usize = 0;
    while index < left.generic_argument_count { if not sema_type_identical(context, left.generic_arguments[index], right.generic_arguments[index], depth + 1) { return false; } set index += 1; }
    set index = 0;
    while index < left.function_parameter_count { if not sema_type_identical(context, left.function_parameter_types[index], right.function_parameter_types[index], depth + 1) { return false; } set index += 1; }
    return true;
}
export proc vitte_sema_type_conversion(context: *const Sema, destination: SemaTypeId, source: SemaTypeId) -> SemaTypeConversionKind {
    if not sema_context_valid(context) or destination == 0 or source == 0 or destination > (*context).type_count as SemaTypeId or source > (*context).type_count as SemaTypeId { return SemaTypeConversionKind.Incompatible; }
    if destination == source { return SemaTypeConversionKind.Exact; }
    let destination_type: &SemaType = &(*context).types[(destination - 1) as usize];
    let source_type: &SemaType = &(*context).types[(source - 1) as usize];
    let destination_kind: SemaTypeKind = (*destination_type).kind; let source_kind: SemaTypeKind = (*source_type).kind;
    if destination_kind == SemaTypeKind.Error or source_kind == SemaTypeKind.Error { return SemaTypeConversionKind.Safe; }
    if sema_type_identical(context, destination, source, 0) { return SemaTypeConversionKind.Exact; }
    if destination_kind == SemaTypeKind.Optional and source_kind == SemaTypeKind.Null { return SemaTypeConversionKind.Safe; }
    if destination_kind == SemaTypeKind.Optional { return vitte_sema_type_conversion(context, (*destination_type).element_type, source); }
    if destination_kind == SemaTypeKind.Array and source_kind == SemaTypeKind.Array and ((*destination_type).array_length == 0 or (*destination_type).array_length == (*source_type).array_length) { return vitte_sema_type_conversion(context, (*destination_type).element_type, (*source_type).element_type); }
    if destination_kind == SemaTypeKind.Slice and source_kind == SemaTypeKind.Array and not (*destination_type).is_mutable and sema_type_identical(context, (*destination_type).element_type, (*source_type).element_type, 0) { return SemaTypeConversionKind.Safe; }
    if destination_kind == SemaTypeKind.Pointer and source_kind == SemaTypeKind.String and not (*destination_type).is_mutable and
       (*destination_type).element_type != 0 and (*destination_type).element_type <= (*context).type_count as SemaTypeId {
        let pointee_kind: SemaTypeKind = (*context).types[((*destination_type).element_type - 1) as usize].kind;
        if pointee_kind == SemaTypeKind.U8 or pointee_kind == SemaTypeKind.Char { return SemaTypeConversionKind.Safe; }
    }
    if (destination_kind == SemaTypeKind.Pointer or destination_kind == SemaTypeKind.Reference) and source_kind == SemaTypeKind.Null { return SemaTypeConversionKind.Safe; }
    if destination_kind == SemaTypeKind.Pointer and source_kind == SemaTypeKind.Reference and sema_type_identical(context, (*destination_type).element_type, (*source_type).element_type, 0) and (not (*destination_type).is_mutable or (*source_type).is_mutable) { return SemaTypeConversionKind.Safe; }
    if (destination_kind == SemaTypeKind.Pointer or destination_kind == SemaTypeKind.Reference) and destination_kind == source_kind and sema_type_identical(context, (*destination_type).element_type, (*source_type).element_type, 0) and (not (*destination_type).is_mutable or (*source_type).is_mutable) { return if (*destination_type).is_mutable == (*source_type).is_mutable { SemaTypeConversionKind.Exact } else { SemaTypeConversionKind.Safe }; }
    if destination_kind == SemaTypeKind.I64 or destination_kind == SemaTypeKind.U64 or destination_kind == SemaTypeKind.U8 or destination_kind == SemaTypeKind.F32 or destination_kind == SemaTypeKind.F64 {
        if source_kind == SemaTypeKind.U8 or source_kind == SemaTypeKind.Char { if destination_kind == SemaTypeKind.I64 or destination_kind == SemaTypeKind.U64 or destination_kind == SemaTypeKind.F32 or destination_kind == SemaTypeKind.F64 { return SemaTypeConversionKind.Safe; } }
        if source_kind == SemaTypeKind.F32 and destination_kind == SemaTypeKind.F64 { return SemaTypeConversionKind.Safe; }
        if source_kind == SemaTypeKind.F64 and destination_kind == SemaTypeKind.F32 { return SemaTypeConversionKind.Lossy; }
        if (source_kind == SemaTypeKind.I64 or source_kind == SemaTypeKind.U64) and destination_kind == SemaTypeKind.F32 { return SemaTypeConversionKind.Lossy; }
        if (source_kind == SemaTypeKind.I64 or source_kind == SemaTypeKind.U64) and destination_kind == SemaTypeKind.F64 { return SemaTypeConversionKind.Lossy; }
        if (source_kind == SemaTypeKind.I64 and destination_kind == SemaTypeKind.U64) or (source_kind == SemaTypeKind.U64 and destination_kind == SemaTypeKind.I64) { return SemaTypeConversionKind.Lossy; }
    }
    return SemaTypeConversionKind.Incompatible;
}
export proc vitte_sema_type_assignable(context: *const Sema, destination: SemaTypeId, source: SemaTypeId) -> bool { let conversion = vitte_sema_type_conversion(context, destination, source); return conversion == SemaTypeConversionKind.Exact or conversion == SemaTypeConversionKind.Safe; }
export proc vitte_sema_type_is_numeric(context: *const Sema, type_id: SemaTypeId) -> bool { return sema_type_numeric(context, type_id); }
export proc vitte_sema_type_is_integer(context: *const Sema, type_id: SemaTypeId) -> bool { return sema_type_integer(context, type_id); }
export proc vitte_sema_type_is_pointer_like(context: *const Sema, type_id: SemaTypeId) -> bool { if context == null or type_id == 0 or type_id > (*context).type_count as SemaTypeId { return false; } let kind: SemaTypeKind = (*context).types[(type_id - 1) as usize].kind; return kind == SemaTypeKind.Pointer or kind == SemaTypeKind.Reference or kind == SemaTypeKind.Optional; }
export proc vitte_sema_get_node_info(context: *const Sema, node_id: ASTNodeId) -> *const SemaNodeInfo { if not sema_context_valid(context) or node_id == 0 or node_id > (*context).node_info_count as ASTNodeId { return null; } return &(*context).node_info[(node_id - 1) as usize]; }
export proc vitte_sema_node_type(context: *const Sema, node_id: ASTNodeId) -> SemaTypeId { let info = vitte_sema_get_node_info(context, node_id); if info == null { return 0; } return (*info).type_id; }
export proc vitte_sema_node_symbol(context: *const Sema, node_id: ASTNodeId) -> SymbolId { let info = vitte_sema_get_node_info(context, node_id); if info == null { return 0; } return (*info).symbol_id; }
export proc vitte_sema_node_scope(context: *const Sema, node_id: ASTNodeId) -> ScopeId { let info = vitte_sema_get_node_info(context, node_id); if info == null { return 0; } return (*info).scope_id; }
export proc vitte_sema_diagnostic_count(context: *const Sema) -> usize { if not sema_context_valid(context) { return 0; } return (*context).diagnostic_count; }
export proc vitte_sema_diagnostic_at(context: *const Sema, index: usize) -> *const SemaDiagnostic { if not sema_context_valid(context) or index >= (*context).diagnostic_count { return null; } return &(*context).diagnostics[index]; }
export proc vitte_sema_has_errors(context: *const Sema) -> bool { if not sema_context_valid(context) { return true; } return (*context).stats.errors != 0; }
export proc vitte_sema_validate(context: *mut Sema) -> bool {
    if not sema_context_valid(context as *const Sema) { return false; }
    set (*context).stats.validation_runs = sema_sat_add((*context).stats.validation_runs, 1);
    if not vitte_scope_is_valid(&(*context).scopes) or (*context).type_count < 11 or (*context).type_count > (*context).max_types { set (*context).stats.validation_failures = sema_sat_add((*context).stats.validation_failures, 1); return false; }
    let mut index: usize = 0; while index < (*context).type_count { if (*context).types[index].id != (index + 1) as SemaTypeId or (*context).types[index].kind <= SemaTypeKind.Invalid or (*context).types[index].kind >= SemaTypeKind.Count { set (*context).stats.validation_failures = sema_sat_add((*context).stats.validation_failures, 1); return false; } set index += 1; }
    if (*context).state == SemaState.Done and not vitte_scope_validate(sema_scope_ptr(context)) { set (*context).stats.validation_failures = sema_sat_add((*context).stats.validation_failures, 1); return false; }
    return true;
}
export proc vitte_sema_fingerprint(context: *mut Sema) -> u64 {
    if not sema_context_valid(context as *const Sema) { return 0; }
    let mut hash = SEMA_FNV_OFFSET;
    hash = (hash ^ (*context).state as u64) * SEMA_FNV_PRIME; hash = (hash ^ (*context).type_count as u64) * SEMA_FNV_PRIME; hash = (hash ^ (*context).node_info_count as u64) * SEMA_FNV_PRIME; hash = (hash ^ (*context).diagnostic_count as u64) * SEMA_FNV_PRIME;
    let mut index: usize = 0; while index < (*context).type_count { hash = (hash ^ (*context).types[index].kind as u64) * SEMA_FNV_PRIME; hash = (hash ^ (*context).types[index].element_type) * SEMA_FNV_PRIME; hash = (hash ^ (*context).types[index].symbol_id) * SEMA_FNV_PRIME; set index += 1; }
    set (*context).stats.hash_runs = sema_sat_add((*context).stats.hash_runs, 1);
    return hash;
}
export proc vitte_sema_stats(context: *const Sema) -> SemaStats { let mut stats: SemaStats = SemaStats {}; if context == null or (*context).magic != SEMA_MAGIC { return stats; } return (*context).stats; }
export proc vitte_sema_translation_unit_anchor() {}

/// C-header inline API, implemented in Vitte and kept allocation-free.
export proc vitte_sema_api_version_major() -> u32 { return SEMA_API_VERSION_MAJOR; }
export proc vitte_sema_api_version_minor() -> u32 { return SEMA_API_VERSION_MINOR; }
export proc vitte_sema_api_version_patch() -> u32 { return SEMA_API_VERSION_PATCH; }
export proc vitte_sema_api_version() -> u32 { return SEMA_API_VERSION; }

export proc vitte_sema_error_is_valid(error: SemaError) -> bool { return error >= SemaError.None and error < SemaError.Count; }
export proc vitte_sema_state_is_valid(state: SemaState) -> bool { return state > SemaState.Invalid and state < SemaState.Count; }
export proc vitte_sema_type_kind_is_valid(kind: SemaTypeKind) -> bool { return kind > SemaTypeKind.Invalid and kind < SemaTypeKind.Count; }
export proc vitte_sema_constant_kind_is_valid(kind: SemaConstantKind) -> bool { return kind >= SemaConstantKind.None and kind < SemaConstantKind.Count; }
export proc vitte_sema_diagnostic_kind_is_valid(kind: SemaDiagnosticKind) -> bool { return kind >= SemaDiagnosticKind.Note and kind < SemaDiagnosticKind.KindCount; }
export proc vitte_sema_diagnostic_code_is_valid(code: SemaDiagnosticCode) -> bool { return code >= SemaDiagnosticCode.None and code < SemaDiagnosticCode.CodeCount; }

export proc vitte_sema_is_ready(context: *const Sema) -> bool {
    return context != null and (*context).magic == SEMA_MAGIC and (*context).state == SemaState.Ready;
}
export proc vitte_sema_is_analyzing(context: *const Sema) -> bool {
    return context != null and (*context).magic == SEMA_MAGIC and (*context).state == SemaState.Analyzing;
}
export proc vitte_sema_is_done(context: *const Sema) -> bool {
    return context != null and (*context).magic == SEMA_MAGIC and (*context).state == SemaState.Done;
}
export proc vitte_sema_has_failed(context: *const Sema) -> bool {
    return context != null and (*context).magic == SEMA_MAGIC and (*context).state == SemaState.Failed;
}
export proc vitte_sema_is_destroyed(context: *const Sema) -> bool {
    return context != null and (*context).magic == SEMA_DEAD_MAGIC and (*context).state == SemaState.Destroyed;
}

export proc vitte_sema_type_count(context: *const Sema) -> usize { if context == null { return 0; } return (*context).type_count; }
export proc vitte_sema_node_info_count(context: *const Sema) -> usize { if context == null { return 0; } return (*context).node_info_count; }
export proc vitte_sema_error_count(context: *const Sema) -> usize { if context == null { return 0; } return (*context).stats.errors as usize; }
export proc vitte_sema_warning_count(context: *const Sema) -> usize { if context == null { return 0; } return (*context).stats.warnings as usize; }

export proc vitte_sema_error_type(context: *const Sema) -> SemaTypeId { if context == null { return 0; } return (*context).type_error; }
export proc vitte_sema_void_type(context: *const Sema) -> SemaTypeId { if context == null { return 0; } return (*context).type_void; }
export proc vitte_sema_bool_type(context: *const Sema) -> SemaTypeId { if context == null { return 0; } return (*context).type_bool; }
export proc vitte_sema_i64_type(context: *const Sema) -> SemaTypeId { if context == null { return 0; } return (*context).type_i64; }
export proc vitte_sema_u64_type(context: *const Sema) -> SemaTypeId { if context == null { return 0; } return (*context).type_u64; }
export proc vitte_sema_u8_type(context: *const Sema) -> SemaTypeId { if context == null { return 0; } return (*context).type_u8; }
export proc vitte_sema_f32_type(context: *const Sema) -> SemaTypeId { if context == null { return 0; } return (*context).type_f32; }
export proc vitte_sema_f64_type(context: *const Sema) -> SemaTypeId { if context == null { return 0; } return (*context).type_f64; }
export proc vitte_sema_char_type(context: *const Sema) -> SemaTypeId { if context == null { return 0; } return (*context).type_char; }
export proc vitte_sema_string_type(context: *const Sema) -> SemaTypeId { if context == null { return 0; } return (*context).type_string; }
export proc vitte_sema_null_type(context: *const Sema) -> SemaTypeId { if context == null { return 0; } return (*context).type_null; }

export proc vitte_sema_type_id_is_valid(type_id: SemaTypeId) -> bool { return type_id != SEMA_INVALID_TYPE_ID; }
export proc vitte_sema_type_is_error(context: *const Sema, type_id: SemaTypeId) -> bool { return context != null and type_id != 0 and type_id <= (*context).type_count as SemaTypeId and (*context).types[(type_id - 1) as usize].kind == SemaTypeKind.Error; }
export proc vitte_sema_type_is_void(context: *const Sema, type_id: SemaTypeId) -> bool { return context != null and type_id == (*context).type_void; }
export proc vitte_sema_type_is_bool(context: *const Sema, type_id: SemaTypeId) -> bool { return context != null and type_id == (*context).type_bool; }
export proc vitte_sema_type_is_string(context: *const Sema, type_id: SemaTypeId) -> bool { return context != null and type_id == (*context).type_string; }
export proc vitte_sema_type_is_null(context: *const Sema, type_id: SemaTypeId) -> bool { return context != null and type_id == (*context).type_null; }
export proc vitte_sema_type_is_function(type_: *const SemaType) -> bool { return type_ != null and (*type_).kind == SemaTypeKind.Function; }
export proc vitte_sema_type_is_named(type_: *const SemaType) -> bool { return type_ != null and (*type_).kind == SemaTypeKind.Named; }
export proc vitte_sema_type_is_reference(type_: *const SemaType) -> bool { return type_ != null and (*type_).kind == SemaTypeKind.Reference; }
export proc vitte_sema_type_is_pointer(type_: *const SemaType) -> bool { return type_ != null and (*type_).kind == SemaTypeKind.Pointer; }
export proc vitte_sema_type_is_array(type_: *const SemaType) -> bool { return type_ != null and (*type_).kind == SemaTypeKind.Array; }
export proc vitte_sema_type_is_range(type_: *const SemaType) -> bool { return type_ != null and (*type_).kind == SemaTypeKind.Range; }
export proc vitte_sema_type_is_dyn(type_: *const SemaType) -> bool { return type_ != null and (*type_).kind == SemaTypeKind.Dyn; }

export proc vitte_sema_node_is_resolved(info: *const SemaNodeInfo) -> bool { return info != null and ((*info).node_flags & SEMA_NODE_FLAG_RESOLVED) != 0; }
export proc vitte_sema_node_is_declaration(info: *const SemaNodeInfo) -> bool { return info != null and ((*info).node_flags & SEMA_NODE_FLAG_DECLARATION) != 0; }
export proc vitte_sema_node_is_lvalue(info: *const SemaNodeInfo) -> bool { return info != null and ((*info).node_flags & SEMA_NODE_FLAG_LVALUE) != 0; }
export proc vitte_sema_node_is_constant(info: *const SemaNodeInfo) -> bool { return info != null and ((*info).node_flags & SEMA_NODE_FLAG_CONSTANT) != 0; }
export proc vitte_sema_node_is_mutable(info: *const SemaNodeInfo) -> bool { return info != null and ((*info).node_flags & SEMA_NODE_FLAG_MUTABLE) != 0; }
export proc vitte_sema_node_is_addressable(info: *const SemaNodeInfo) -> bool { return info != null and ((*info).node_flags & SEMA_NODE_FLAG_ADDRESSABLE) != 0; }
export proc vitte_sema_node_diverges(info: *const SemaNodeInfo) -> bool { return info != null and ((*info).node_flags & SEMA_NODE_FLAG_DIVERGES) != 0; }
export proc vitte_sema_node_is_unreachable(info: *const SemaNodeInfo) -> bool { return info != null and ((*info).node_flags & SEMA_NODE_FLAG_UNREACHABLE) != 0; }

export proc vitte_sema_constant_is_valid(constant: *const SemaConstant) -> bool {
    return constant != null and (*constant).kind > SemaConstantKind.None and (*constant).kind < SemaConstantKind.Count;
}
export proc vitte_sema_constant_is_integer(constant: *const SemaConstant) -> bool {
    return constant != null and ((*constant).kind == SemaConstantKind.Integer or (*constant).kind == SemaConstantKind.UnsignedInteger);
}
export proc vitte_sema_constant_is_numeric(constant: *const SemaConstant) -> bool {
    return constant != null and ((*constant).kind == SemaConstantKind.Integer or
        (*constant).kind == SemaConstantKind.UnsignedInteger or (*constant).kind == SemaConstantKind.Float);
}
export proc vitte_sema_diagnostic_is_error(diag: *const SemaDiagnostic) -> bool {
    return diag != null and (*diag).kind == SemaDiagnosticKind.Error;
}
export proc vitte_sema_diagnostic_is_warning(diag: *const SemaDiagnostic) -> bool {
    return diag != null and (*diag).kind == SemaDiagnosticKind.Warning;
}
export proc vitte_sema_diagnostic_has_symbol(diag: *const SemaDiagnostic) -> bool {
    return diag != null and (*diag).symbol_id != 0;
}
export proc vitte_sema_diagnostic_has_expected_type(diag: *const SemaDiagnostic) -> bool {
    return diag != null and (*diag).expected_type != SEMA_INVALID_TYPE_ID;
}
export proc vitte_sema_diagnostic_has_found_type(diag: *const SemaDiagnostic) -> bool {
    return diag != null and (*diag).found_type != SEMA_INVALID_TYPE_ID;
}
