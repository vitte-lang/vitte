/// Vitte API mirror of `src/bootstrap/sema/sema.h`.
space compiler::sema::sema;

/// Native semantic analysis over the parser's AST representation.
export const SEMA_API_VERSION_MAJOR: u32 = 1;
export const SEMA_API_VERSION_MINOR: u32 = 0;
export const SEMA_API_VERSION_PATCH: u32 = 0;
export const SEMA_API_VERSION: u32 = 10000;
export const SEMA_MAGIC: u64 = 0x5649545453454d41;
export const SEMA_DEAD_MAGIC: u64 = 0x4445414453454d41;
export const SEMA_FNV_OFFSET: u64 = 14695981039346656037;
export const SEMA_FNV_PRIME: u64 = 1099511628211;
export const SEMA_DEFAULT_INITIAL_TYPE_CAPACITY: usize = 64;
export const SEMA_DEFAULT_INITIAL_NODE_CAPACITY: usize = 128;
export const SEMA_DEFAULT_INITIAL_DIAGNOSTIC_CAPACITY: usize = 32;
export const SEMA_DEFAULT_MAX_TYPES: usize = 1048576;
export const SEMA_DEFAULT_MAX_DIAGNOSTICS: usize = 16384;
export const SEMA_DEFAULT_MAX_RECURSION_DEPTH: usize = 4096;
export const SEMA_INVALID_TYPE_ID: u64 = 0;

export const SEMA_NODE_FLAG_NONE: u32 = 0;
export const SEMA_NODE_FLAG_RESOLVED: u32 = (1 as u32) << 0;
export const SEMA_NODE_FLAG_DECLARATION: u32 = (1 as u32) << 1;
export const SEMA_NODE_FLAG_LVALUE: u32 = (1 as u32) << 2;
export const SEMA_NODE_FLAG_CONSTANT: u32 = (1 as u32) << 3;
export const SEMA_NODE_FLAG_MUTABLE: u32 = (1 as u32) << 4;
export const SEMA_NODE_FLAG_ADDRESSABLE: u32 = (1 as u32) << 5;
export const SEMA_NODE_FLAG_DIVERGES: u32 = (1 as u32) << 6;
export const SEMA_NODE_FLAG_UNREACHABLE: u32 = (1 as u32) << 7;
export const SEMA_NODE_FLAG_IMPLICIT_CONVERSION: u32 = (1 as u32) << 8;
export const SEMA_NODE_FLAG_UNSAFE: u32 = (1 as u32) << 9;
export const SEMA_NODE_FLAG_BUILTIN: u32 = (1 as u32) << 10;
export const SEMA_NODE_FLAG_PREDECLARED: u32 = (1 as u32) << 11;

