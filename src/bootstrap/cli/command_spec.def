/*
 * Canonical bootstrap CLI table.
 *
 * This file is consumed by command_spec.h, command_spec.c and by
 * scripts/generate-bootstrap-cli.py. Keep one command or option per line so
 * documentation and shell completion generation remain deterministic.
 */
VITTE_CLI_COMMAND("compile", "Analyze and compile a source file", true, false, COMPILE)
VITTE_CLI_COMMAND("check", "Validate UTF-8, syntax and semantics", true, false, CHECK)
VITTE_CLI_COMMAND("run", "Compile and run a program", true, true, RUN)
VITTE_CLI_COMMAND("lex", "Tokenize a source file", true, false, LEX)
VITTE_CLI_COMMAND("parse", "Parse a source file", true, false, PARSE)
VITTE_CLI_COMMAND("explain", "Explain a public diagnostic code", true, false, EXPLAIN)
VITTE_CLI_COMMAND("completion", "Generate shell completion scripts", true, false, COMPLETION)
VITTE_CLI_COMMAND("help", "Display compiler help", false, false, HELP)
VITTE_CLI_COMMAND("version", "Display compiler version", false, false, VERSION)

VITTE_CLI_OPTION("-h, --help", NULL, "Display help", HELP)
VITTE_CLI_OPTION("-V, --version", NULL, "Display compiler version", VERSION)
VITTE_CLI_OPTION("-q, --quiet", NULL, "Suppress non-error output", QUIET)
VITTE_CLI_OPTION("-v, --verbose", NULL, "Enable verbose output", VERBOSE)
VITTE_CLI_OPTION("--color", NULL, "Force colored diagnostics", COLOR)
VITTE_CLI_OPTION("--no-color", NULL, "Disable colored diagnostics", NO_COLOR)
VITTE_CLI_OPTION("--diagnostic=FMT, --diagnostic-format=FMT", "FMT", "Diagnostic format: terminal, json, sarif or lsp", DIAGNOSTIC)
VITTE_CLI_OPTION("--profile=PROFILE", "PROFILE", "Build profile: default, debug, release, size, sanitize or freestanding", PROFILE)
VITTE_CLI_OPTION("--backend=BACKEND", "BACKEND", "Code-generation backend: default, c17, native or bytecode", BACKEND)
VITTE_CLI_OPTION("--optimization=LEVEL, --opt=LEVEL", "LEVEL", "Optimization level", OPTIMIZATION)
VITTE_CLI_OPTION("--target=TARGET", "TARGET", "Target triple or platform", TARGET)
VITTE_CLI_OPTION("--jobs=N", "N", "Maximum parallel jobs", JOBS)
VITTE_CLI_OPTION("--max-errors=N", "N", "Maximum diagnostics", MAX_ERRORS)
VITTE_CLI_OPTION("--max-output-bytes=N", "N", "Maximum diagnostic/output bytes", MAX_OUTPUT_BYTES)
VITTE_CLI_OPTION("--warnings-as-errors", NULL, "Treat warnings as errors", WARNINGS_AS_ERRORS)
VITTE_CLI_OPTION("--emit-debug-info", NULL, "Emit debug information", EMIT_DEBUG_INFO)
VITTE_CLI_OPTION("--emit-source-map", NULL, "Emit source maps", EMIT_SOURCE_MAP)
VITTE_CLI_OPTION("--no-emit-source-map", NULL, "Disable source maps", NO_EMIT_SOURCE_MAP)
VITTE_CLI_OPTION("--emit-comments", NULL, "Keep generated comments", EMIT_COMMENTS)
VITTE_CLI_OPTION("--runtime-checks", NULL, "Enable runtime checks", RUNTIME_CHECKS)
VITTE_CLI_OPTION("--no-runtime-checks", NULL, "Disable runtime checks", NO_RUNTIME_CHECKS)
VITTE_CLI_OPTION("--bounds-checks", NULL, "Enable bounds checks", BOUNDS_CHECKS)
VITTE_CLI_OPTION("--no-bounds-checks", NULL, "Disable bounds checks", NO_BOUNDS_CHECKS)
VITTE_CLI_OPTION("--null-checks", NULL, "Enable null checks", NULL_CHECKS)
VITTE_CLI_OPTION("--no-null-checks", NULL, "Disable null checks", NO_NULL_CHECKS)
VITTE_CLI_OPTION("--overflow-checks", NULL, "Enable overflow checks", OVERFLOW_CHECKS)
VITTE_CLI_OPTION("--no-overflow-checks", NULL, "Disable overflow checks", NO_OVERFLOW_CHECKS)
VITTE_CLI_OPTION("--deterministic", NULL, "Enable deterministic builds", DETERMINISTIC)
VITTE_CLI_OPTION("--no-deterministic", NULL, "Disable deterministic builds", NO_DETERMINISTIC)
VITTE_CLI_OPTION("--incremental", NULL, "Enable incremental compilation", INCREMENTAL)
VITTE_CLI_OPTION("--no-incremental", NULL, "Disable incremental compilation", NO_INCREMENTAL)
VITTE_CLI_OPTION("--offline", NULL, "Disable network access", OFFLINE)
VITTE_CLI_OPTION("--locked", NULL, "Require locked dependencies", LOCKED)
VITTE_CLI_OPTION("--frozen-dependencies", NULL, "Require frozen dependencies", FROZEN_DEPENDENCIES)
VITTE_CLI_OPTION("--force", NULL, "Force the requested operation", FORCE)
VITTE_CLI_OPTION("--manifest-path=PATH", "PATH", "Use a manifest at PATH", MANIFEST_PATH)
VITTE_CLI_OPTION("--project-root=PATH", "PATH", "Set project root", PROJECT_ROOT)
VITTE_CLI_OPTION("--build-dir=PATH", "PATH", "Set build directory", BUILD_DIR)
VITTE_CLI_OPTION("--cache-dir=PATH", "PATH", "Set cache directory", CACHE_DIR)
VITTE_CLI_OPTION("--sysroot=PATH", "PATH", "Set sysroot", SYSROOT)
VITTE_CLI_OPTION("--registry=URL", "URL", "Set package registry", REGISTRY)
VITTE_CLI_OPTION("--timings", NULL, "Display compiler phase timings", TIMINGS)
VITTE_CLI_OPTION("--emit-tokens", NULL, "Print lexer tokens", EMIT_TOKENS)
VITTE_CLI_OPTION("--emit-ast", NULL, "Print an AST summary", EMIT_AST)
VITTE_CLI_OPTION("--emit-hir", NULL, "Print the lowered HIR", EMIT_HIR)
VITTE_CLI_OPTION("--emit-ir", NULL, "Print the lowered IR", EMIT_IR)
VITTE_CLI_OPTION("--emit-c", NULL, "Emit generated C17", EMIT_C)
VITTE_CLI_OPTION("-c, --emit-object", NULL, "Compile to a relocatable object", EMIT_OBJECT)
VITTE_CLI_OPTION("--stop-after-lexer", NULL, "Stop after lexing", STOP_AFTER_LEXER)
VITTE_CLI_OPTION("--stop-after-parser", NULL, "Stop after parsing", STOP_AFTER_PARSER)
VITTE_CLI_OPTION("--stop-after-sema", NULL, "Stop after semantic analysis", STOP_AFTER_SEMA)
VITTE_CLI_OPTION("--validate-utf8", NULL, "Validate source UTF-8", VALIDATE_UTF8)
VITTE_CLI_OPTION("--no-validate-utf8", NULL, "Skip source UTF-8 validation", NO_VALIDATE_UTF8)
VITTE_CLI_OPTION("--debug-info, --debug", NULL, "Emit debug information", DEBUG_INFO)
VITTE_CLI_OPTION("--debug-probes", NULL, "Enable compiler probe runtime", DEBUG_PROBES)
VITTE_CLI_OPTION("--line-directives", NULL, "Emit #line directives in generated C", LINE_DIRECTIVES)
VITTE_CLI_OPTION("-o PATH, --output PATH, --output=PATH", "PATH", "Write compiler output to PATH", OUTPUT)
VITTE_CLI_OPTION("-- ARGS", "ARGS", "Forward remaining arguments to `run`", FORWARD_ARGS)
