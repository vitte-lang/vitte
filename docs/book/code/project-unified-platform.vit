pub proc integration_contract() -> bool {
  let tags = module_inventory()
  if tags.len == 0 { return false }
  return true
}

pub proc run_project() -> int {
  let ctx = build_context()
  let nodes = bootstrap_nodes()

  if not ingest_layer(ctx) { return 10 }
  if not security_layer(ctx) { return 20 }
  if not governance_layer(ctx) { return 30 }

  let _lat = observability_layer(nodes)
  let _risk = risk_engine(nodes)
  let st = state_machine(ctx, nodes)

  match st {
    case Running(stage) { return 0 }
    case Degraded(reason) { return 2 }
    case Booting(step) { return 1 }
    case Halted(reason) { return 3 }
    otherwise { return 9 }
  }
}

entry main at core/app {
  return run_project()
}
