{
  "space declaration": {
    "scope": "vit,vitte",
    "prefix": "space",
    "body": ["space ${1:package/module}"],
    "description": "Declare the canonical Vitte module path"
  },
  "use declaration": {
    "scope": "vit,vitte",
    "prefix": "use",
    "body": ["use ${1:package/module}.${2:{Symbol}}"],
    "description": "Import a Vitte module or symbol"
  },
  "use alias": {
    "scope": "vit,vitte",
    "prefix": "useas",
    "body": ["use ${1:package/module} as ${2:alias}"],
    "description": "Import a Vitte module with an alias"
  },
  "share symbols": {
    "scope": "vit,vitte",
    "prefix": "share",
    "body": ["share ${1:symbol}"],
    "description": "Publish symbols from the current module"
  },
  "export symbols": {
    "scope": "vit,vitte",
    "prefix": "export",
    "body": ["export { ${1:Symbol} }"],
    "description": "Export an explicit symbol set"
  },
  "procedure": {
    "scope": "vit,vitte",
    "prefix": "proc",
    "body": [
      "proc ${1:name}(${2})${3: -> ${4:int}} {",
      "\t${0}",
      "}"
    ],
    "description": "Declare a canonical Vitte procedure"
  },
  "public procedure": {
    "scope": "vit,vitte",
    "prefix": "pubproc",
    "body": [
      "pub proc ${1:name}(${2})${3: -> ${4:int}} {",
      "\t${0}",
      "}"
    ],
    "description": "Declare a public Vitte procedure"
  },
  "async procedure": {
    "scope": "vit,vitte",
    "prefix": "asyncproc",
    "body": [
      "async proc ${1:name}(${2})${3: -> ${4:int}} {",
      "\t${0}",
      "}"
    ],
    "description": "Declare an asynchronous Vitte procedure"
  },
  "procedure with effects": {
    "scope": "vit,vitte",
    "prefix": "proceffects",
    "body": [
      "proc ${1:name}(${2}) -> ${3:int} effects(${4:io}) requires(${5:capability}) {",
      "\t${0}",
      "}"
    ],
    "description": "Declare a procedure with effects and capabilities"
  },
  "form declaration": {
    "scope": "vit,vitte",
    "prefix": "form",
    "body": [
      "form ${1:Name} {",
      "\t${2:field}: ${3:Type},",
      "\t${0}",
      "}"
    ],
    "description": "Declare a canonical Vitte form with bare typed fields"
  },
  "pick declaration": {
    "scope": "vit,vitte",
    "prefix": "pick",
    "body": [
      "pick ${1:Name} {",
      "\tcase ${2:Variant}(${3:value}: ${4:Type}),",
      "\t${0}",
      "}"
    ],
    "description": "Declare a canonical Vitte pick"
  },
  "trait declaration": {
    "scope": "vit,vitte",
    "prefix": "trait",
    "body": [
      "trait ${1:Name} {",
      "\tproc ${2:method}(self) -> ${3:Type};",
      "\t${0}",
      "}"
    ],
    "description": "Declare a Vitte trait"
  },
  "impl declaration": {
    "scope": "vit,vitte",
    "prefix": "impl",
    "body": [
      "impl ${1:Trait} for ${2:Type} {",
      "\t${0}",
      "}"
    ],
    "description": "Implement a trait for a type"
  },
  "type alias": {
    "scope": "vit,vitte",
    "prefix": "type",
    "body": ["type ${1:Alias} = ${2:ExistingType}"],
    "description": "Declare a Vitte type alias"
  },
  "constant": {
    "scope": "vit,vitte",
    "prefix": "const",
    "body": ["const ${1:NAME}: ${2:Type} = ${3:value}"],
    "description": "Declare a typed constant"
  },
  "local binding": {
    "scope": "vit,vitte",
    "prefix": "let",
    "body": ["let ${1:name}${2: : ${3:Type}} = ${4:value};"],
    "description": "Declare an initialized local binding"
  },
  "mutable local binding": {
    "scope": "vit,vitte",
    "prefix": "letmut",
    "body": ["let mut ${1:name}${2: : ${3:Type}} = ${4:value};"],
    "description": "Declare an initialized mutable binding"
  },
  "assignment": {
    "scope": "vit,vitte",
    "prefix": "set",
    "body": ["set ${1:target} = ${2:value};"],
    "description": "Assign through a Vitte place expression"
  },
  "give value": {
    "scope": "vit,vitte",
    "prefix": "give",
    "body": ["give ${1:value};"],
    "description": "Return a value from a procedure"
  },
  "if expression": {
    "scope": "vit,vitte",
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t${2}",
      "} else {",
      "\t${0}",
      "}"
    ],
    "description": "Insert an if/else expression"
  },
  "match expression": {
    "scope": "vit,vitte",
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "\tcase ${2:Pattern} {",
      "\t\t${3}",
      "\t}",
      "\telse {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Insert a canonical match expression"
  },
  "for loop": {
    "scope": "vit,vitte",
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:items} {",
      "\t${0}",
      "}"
    ],
    "description": "Iterate over an expression"
  },
  "while loop": {
    "scope": "vit,vitte",
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t${0}",
      "}"
    ],
    "description": "Insert a while loop"
  },
  "extern C block": {
    "scope": "vit,vitte",
    "prefix": "extern",
    "body": [
      "extern C {",
      "\tproc ${1:name}(${2}) -> ${3:c_int};",
      "\t${0}",
      "}"
    ],
    "description": "Declare an extern C block"
  },
  "test block": {
    "scope": "vit,vitte",
    "prefix": "test",
    "body": [
      "test \"${1:name}\" {",
      "\t${0}",
      "}"
    ],
    "description": "Declare a Vitte test"
  },
  "outer attribute": {
    "scope": "vit,vitte",
    "prefix": "attr",
    "body": ["#[${1:name}(${2})]"],
    "description": "Insert an outer Vitte attribute"
  },
  "documentation comment": {
    "scope": "vit,vitte",
    "prefix": "doc",
    "body": ["/// ${1:Summary}", "///", "/// ${0:Details}"],
    "description": "Insert Vitte documentation comments"
  },
  "zone comment": {
    "scope": "vit,vitte",
    "prefix": "zone",
    "body": ["<<<", "${1:comment}", ">>>"],
    "description": "Insert a Vitte zone comment"
  }
}
