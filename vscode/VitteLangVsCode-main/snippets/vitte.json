    "scope": "vit,vitte",
    "prefix": "doc",
    "body": [
      "/// ${1:Summary}",
      "///",
      "/// ${2:Details}"
    ],
    "description": "Documentation comment"
  },
  "Else if branch": {
    "scope": "vit,vitte",
    "prefix": "elif",
    "body": [
      "elif ${1:true} {",
      "    $0",
      "}"
