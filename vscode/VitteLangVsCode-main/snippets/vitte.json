{
  "Async procedure": {
    "scope": "vit,vitte",
    "prefix": "aproc",
    "body": [
      "async proc ${1:name}() {",
      "    $0",
      "}"
    ],
    "description": "Async procedure"
  },
  "Assembly": {
    "scope": "vit,vitte",
    "prefix": "asm",
    "body": [
      "asm(\"${1:nop}\");"
    ],
    "description": "Assembly"
  },
  "Assertion": {
    "scope": "vit,vitte",
    "prefix": "assert",
    "body": [
      "assert(${1:true});"
    ],
    "description": "Assertion"
  },
  "Outer attribute": {
    "scope": "vit,vitte",
    "prefix": "attr",
    "body": [
      "#[${1:feature}]"
    ],
    "description": "Outer attribute"
  },
  "Block comment": {
    "scope": "vit,vitte",
    "prefix": "blockcomment",
    "body": [
      "/* ${1:comment} */"
    ],
    "description": "Block comment"
  },
  "Break loop": {
    "scope": "vit,vitte",
    "prefix": "break",
    "body": [
