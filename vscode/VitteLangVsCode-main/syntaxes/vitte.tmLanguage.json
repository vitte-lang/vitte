{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vitte",
  "scopeName": "source.vitte",
  "fileTypes": ["vit", "vitl", "vitte"],
  "patterns": [
    { "include": "#shebang" },
    { "include": "#doc-comments" },
    { "include": "#attributes" },
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#deprecated" },
    { "include": "#literals" },
    { "include": "#types" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#operators" },
    { "include": "#identifiers" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "shebang": {
      "name": "comment.line.shebang.vitte",
      "match": "^(#!)(?!\\[).*$",
      "captures": {
        "1": { "name": "punctuation.definition.comment.vitte" }
      }
    },
    "todo": {
      "name": "keyword.other.todo.vitte",
      "match": "\\b(?:TODO|FIXME|NOTE|XXX|BUG|HACK)\\b"
    },
    "doc-comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.vitte",
          "begin": "///",
          "end": "$",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.documentation.vitte" }
          },
          "patterns": [{ "include": "#todo" }]
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.inner.vitte",
          "begin": "#!\\[",
          "end": "\\]",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.annotation.begin.vitte" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.annotation.end.vitte" }
          },
          "patterns": [
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#literals" },
            { "include": "#types" },
            { "include": "#keywords" }
          ]
        },
        {
          "name": "meta.attribute.outer.vitte",
          "begin": "#\\[",
          "end": "\\]",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.annotation.begin.vitte" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.annotation.end.vitte" }
          },
          "patterns": [
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#literals" },
            { "include": "#types" },
            { "include": "#keywords" }
          ]
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.vitte",
          "begin": "#(?!\\[|!\\[)",
          "end": "$",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.vitte" }
          },
          "patterns": [{ "include": "#todo" }]
        },
        {
          "name": "comment.line.double-slash.vitte",
          "begin": "//(?!/)",
          "end": "$",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.vitte" }
          },
          "patterns": [{ "include": "#todo" }]
        },
        {
          "name": "comment.block.zone.vitte",
          "begin": "<<<",
          "end": ">>>",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.vitte" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.vitte" }
          },
          "patterns": [{ "include": "#todo" }]
        },
        {
          "name": "comment.block.vitte",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.vitte" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.vitte" }
          },
          "patterns": [{ "include": "#todo" }]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.vitte",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.vitte" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.vitte" }
          }
        },
        {
          "name": "string.quoted.raw.vitte",
          "begin": "\\br\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.vitte" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.vitte" }
          }
        },
        {
          "name": "string.quoted.double.vitte",
          "begin": "(?:\\bb)?\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.vitte" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.vitte" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.vitte",
              "match": "\\\\(?:[\"'\\\\nrt0]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\})"
            }
          ]
        },
        {
          "name": "string.quoted.single.vitte",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.vitte" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.vitte" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.vitte",
              "match": "\\\\(?:[\"'\\\\nrt0]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\})"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.vitte",
          "match": "(?<![A-Za-z0-9_])-?\\b[0-9](?:[0-9_]*[0-9])?\\.[0-9](?:[0-9_]*[0-9])?(?:[eE][+-]?[0-9](?:[0-9_]*[0-9])?)?(?:[A-Za-z][A-Za-z0-9]*)?\\b"
        },
        {
          "name": "constant.numeric.hex.vitte",
          "match": "(?<![A-Za-z0-9_])-?\\b0x[0-9A-Fa-f](?:[0-9A-Fa-f_]*[0-9A-Fa-f])?(?:[A-Za-z][A-Za-z0-9]*)?\\b"
        },
        {
          "name": "constant.numeric.binary.vitte",
          "match": "(?<![A-Za-z0-9_])-?\\b0b[01](?:[01_]*[01])?(?:[A-Za-z][A-Za-z0-9]*)?\\b"
        },
        {
          "name": "constant.numeric.octal.vitte",
          "match": "(?<![A-Za-z0-9_])-?\\b0o[0-7](?:[0-7_]*[0-7])?(?:[A-Za-z][A-Za-z0-9]*)?\\b"
        },
        {
          "name": "constant.numeric.integer.vitte",
          "match": "(?<![A-Za-z0-9_])-?\\b[0-9](?:[0-9_]*[0-9])?(?:[A-Za-z][A-Za-z0-9]*)?\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.namespace.declaration.vitte",
          "match": "\\b(space)\\s+([.]*[A-Za-z_][A-Za-z0-9_]*(?:(?:/|\\.|::)[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": { "name": "keyword.declaration.namespace.vitte" },
            "2": { "name": "entity.name.namespace.vitte" }
          }
        },
        {
          "name": "meta.import.declaration.vitte",
          "match": "\\b(use)\\s+([.]*[A-Za-z_][A-Za-z0-9_]*(?:(?:/|\\.|::)[A-Za-z_][A-Za-z0-9_]*)*)(?:\\s+(as)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.control.import.vitte" },
            "2": { "name": "entity.name.namespace.vitte" },
            "3": { "name": "keyword.operator.word.vitte" },
            "4": { "name": "entity.name.namespace.vitte" }
          }
        },
        {
          "name": "meta.function.declaration.vitte",
          "match": "\\b(proc|intrinsic|query)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.vitte" },
            "2": { "name": "entity.name.function.vitte" }
          }
        },
        {
          "name": "meta.type.declaration.vitte",
          "match": "\\b(form|pick|trait|type|opaque)\\s+(?:type\\s+)?([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.vitte" },
            "2": { "name": "entity.name.type.vitte" }
          }
        },
        {
          "name": "meta.impl.declaration.vitte",
          "match": "\\b(impl)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.vitte" },
            "2": { "name": "entity.name.type.vitte" }
          }
        },
        {
          "name": "meta.meta.declaration.vitte",
          "match": "\\b(compiler|pass|backend|diagnostic|macro|entry|region)\\s+(?:\"[^\"]*\"|([A-Za-z_][A-Za-z0-9_]*))",
          "captures": {
            "1": { "name": "keyword.declaration.vitte" },
            "2": { "name": "entity.name.function.vitte" }
          }
        },
        {
          "name": "meta.constant.declaration.vitte",
          "match": "\\b(const|static|global)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.vitte" },
            "2": { "name": "variable.other.constant.vitte" }
          }
        },
        {
          "name": "meta.variable.declaration.vitte",
          "match": "\\b(let)\\s+(?:mut\\s+)?([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.vitte" },
            "2": { "name": "variable.other.readwrite.vitte" }
          }
        },
        {
          "name": "meta.field.declaration.vitte",
          "match": "^\\s*(?:pub(?:\\s*\\([^)]*\\))?\\s+|priv\\s+)?([A-Za-z_][A-Za-z0-9_]*)\\s*(?=:)",
          "captures": {
            "1": { "name": "variable.other.member.vitte" }
          }
        },
        {
          "name": "meta.variant.declaration.vitte",
          "match": "^\\s*(?:case\\s+)?([A-Z][A-Za-z0-9_]*)\\s*(?=(?:\\(|=|,|$))",
          "captures": {
            "1": { "name": "constant.other.variant.vitte" }
          }
        }
      ]
    },
    "deprecated": {
      "patterns": [
        {
          "name": "invalid.deprecated.keyword.vitte",
          "match": "\\b(?:class|union|bits|flags)\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.language.boolean.vitte",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.null.vitte",
          "match": "\\bnull\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.vitte",
          "match": "\\b(?:void|never|unit|bool|char|rune|str|string|bytes|cstr|int|i8|i16|i32|i64|i128|u8|u16|u32|u64|u128|usize|isize|intptr|uintptr|f16|f32|f64|f128|c_char|c_int|c_uint|c_long|c_ulong|c_void|TokenId|NodeId|DefId|HirId|MirId|TypeId|SymbolId|ScopeId|BlockId|ValueId|InstrId|Self)\\b"
        },
        {
          "name": "entity.name.type.vitte",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.vitte",
          "match": "\\b(?:space|use|export|share|const|static|global|region|type|opaque|extern|form|pick|trait|impl|proc|intrinsic|compiler|query|pass|backend|diagnostic|macro|comptime|static_assert|test|bench|entry|pub|priv)\\b"
        },
        {
          "name": "storage.modifier.vitte",
          "match": "\\b(?:unsafe|async|inline|noinline|naked|interrupt|mut|owned|borrow|move|volatile|atomic|user|kernel|phys|mmio|dma)\\b"
        },
        {
          "name": "keyword.control.vitte",
          "match": "\\b(?:let|set|give|try|defer|asm|emit|assert|panic|unreachable|if|elif|else|while|loop|for|in|break|continue|select|when|match|case|with|critical|await)\\b"
        },
        {
          "name": "keyword.operator.word.vitte",
          "match": "\\b(?:as|not|and|or|is|ref|dyn|where|effects|requires|operator|noexcept|self|at)\\b"
        },
        {
          "name": "support.function.language.vitte",
          "match": "\\b(?:sizeof|alignof|offsetof|typeof|nameof)\\b"
        },
        {
          "name": "storage.modifier.contextual.vitte",
          "match": "\\b(?:C|sysv64|win64|package|module|super|stack|heap|arena)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.vitte",
          "match": "\\b(?:print|println|len|size|range|slice|as_bytes|push|pop|clear|iter|filter|reduce|open|read|write|close)\\b(?=\\s*\\()"
        },
        {
          "name": "support.type.collection.vitte",
          "match": "\\b(?:map|resource)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.symbol.vitte",
          "match": "<<=|>>=|\\.\\.=|\\.\\.|\\?\\?|&&|\\|\\||==|!=|<=|>=|<<|>>|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|->|=>|::|=|\\+|-|\\*|/|%|<|>|&|\\||\\^|~|\\?|\\."
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.function.call.vitte",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.vitte" }
          }
        },
        {
          "name": "variable.other.property.vitte",
          "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        {
          "name": "constant.other.vitte",
          "match": "\\b[A-Z][A-Z0-9_]{2,}\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.statement.vitte", "match": ";" },
        { "name": "punctuation.separator.comma.vitte", "match": "," },
        { "name": "punctuation.separator.colon.vitte", "match": ":(?!:)" },
        { "name": "punctuation.section.group.begin.vitte", "match": "\\(" },
        { "name": "punctuation.section.group.end.vitte", "match": "\\)" },
        { "name": "punctuation.section.brackets.begin.vitte", "match": "\\[" },
        { "name": "punctuation.section.brackets.end.vitte", "match": "\\]" },
        { "name": "punctuation.section.block.begin.vitte", "match": "\\{" },
        { "name": "punctuation.section.block.end.vitte", "match": "\\}" }
      ]
    }
  }
}
