/*! advanced.vitte — generic forms, traits, imports and diagnostics */

#![feature(patterns)]
space demo::advanced
use std::cli::{args, usage}
use std::fs::Reader as FileReader
use std::math::pow

pub const MAX_ITERS: u32 = 0b1010_1100;
type Coord = i64;

form Point<T> where T: Copy {
    pub x: T,
    pub y: T,
}

pick Shape {
    case Circle(Point<f64>),
    case Rect { width: f64, height: f64 },
    case Empty,
}

trait Area<T> where T: Copy {
    proc area(self) -> T;
}

impl Point<f64> {
    proc area(self) -> f64 {
        return pow(self.x, 2.0) + pow(self.y, 2.0);
    }
}

proc normalize<T>(point: Point<T>) -> Point<T> where T: Copy {
    return Point { x: point.x, y: point.y };
}

proc inspect(shape: Shape) -> string {
    match shape {
        case Shape::Circle(point) => return point.x as string;
        case Shape::Rect { width, height } => return (width + height) as string;
        else => return "empty";
    }
}

test "patterns" {
    let point = Point { x: 1, y: 2 };
    let shape = Shape::Circle(point);
    assert inspect(shape) is string;
}

entry main {
    let args_value = args();
    if args_value is not null {
        usage();
    }
    return;
}
