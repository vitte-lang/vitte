{
  "comments": {
    "lineComment": "//",
    "blockComment": [
      "/*",
      "*/"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "/*",
      "close": "*/",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "\"\"\"",
      "close": "\"\"\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "/*",
      "close": "*/"
    },
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "'",
      "close": "'"
    }
  ],
  "indentationRules": {
    "increaseIndentPattern": "^.*\\{\\s*(?://.*)?$",
    "decreaseIndentPattern": "^\\s*\\}"
  },
  "wordPattern": "(-?\\d+(?:\\.\\d+)?)|([A-Za-z_][A-Za-z0-9_]*)",
  "onEnterRules": [
    {
      "beforeText": "^\\s*.*\\{\\s*$",
      "afterText": "^\\s*\\}.*$",
      "action": {
        "indentAction": "IndentOutdent"
      }
    },
    {
      "beforeText": "^\\s*(?:(?:pub|export|async|unsafe|comptime)\\s+)*(?:space|proc|form|pick|trait|impl|macro|test|match|if|elif|else|while|loop|for|defer)\\b.*\\{\\s*$",
      "action": {
        "indentAction": "Indent"
      }
    }
  ]
}
