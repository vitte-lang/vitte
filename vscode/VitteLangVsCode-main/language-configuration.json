{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "<<<", "close": ">>>", "notIn": ["string"] },
    { "open": "\"\"\"", "close": "\"\"\"", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "indentationRules": {
    "increaseIndentPattern": "^.*\\{\\s*(?://.*|#.*)?$",
    "decreaseIndentPattern": "^\\s*\\}"
  },
  "wordPattern": "(-?\\d+(?:\\.\\d+)?)|([A-Za-z_][A-Za-z0-9_]*)",
  "onEnterRules": [
    {
      "beforeText": "^\\s*.*\\{\\s*$",
      "afterText": "^\\s*\\}.*$",
      "action": { "indentAction": "IndentOutdent" }
    },
    {
      "beforeText": "^\\s*.*<<<\\s*$",
      "afterText": "^\\s*>>>.*$",
      "action": { "indentAction": "IndentOutdent" }
    },
    {
      "beforeText": "^\\s*(?:proc|entry|form|pick|trait|impl|extern|compiler|query|pass|backend|diagnostic|macro|comptime|test|bench|match|select|if|elif|else|while|loop|for|when|with|critical|unsafe|defer)\\b.*\\{\\s*$",
      "action": { "indentAction": "Indent" }
    }
  ]
}
