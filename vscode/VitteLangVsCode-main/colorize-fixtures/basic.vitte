/*! basic.vitte — fixture de colorisation pour la grammaire canonique */

space demo::basic
use std::io::println
use std::math::{sqrt as math_sqrt, abs}
share Point, distance

const PI: f64 = 3.141_592_653_589;
static VERSION: string = "0.2.0";

type Coord = i32;
form Point {
    x: Coord,
    y: Coord,
}

pick Color {
    case Red,
    case Green,
    case Blue(u8),
}

proc distance(left: Point, right: Point) -> f64 {
    let dx = left.x - right.x;
    let dy = left.y - right.y;
    return math_sqrt((dx * dx + dy * dy) as f64);
}

proc main() -> int {
    let mut sum: i64 = 0xFF + 0b1010 + 1_000_000;
    let truth: bool = true and not false;
    if sum > 42 or truth {
        println("big");
    } else {
        println("small");
    }
    for i in 0..10 {
        set sum += i as i64;
        if i == 2 { continue; }
        if i > 7 { break; }
    }
    let point = Point { x: 1, y: -2 };
    let color = Color::Blue(128);
    match color {
        case Color::Blue(value) => println(value as string);
        else => println(point.x as string);
    }
    return 0;
}
