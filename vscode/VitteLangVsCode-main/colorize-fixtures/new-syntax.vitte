#! /usr/bin/env vitte
// Canonical Vitte syntax fixture: imports, generics, attributes, patterns and recovery.

#![no_std]
space colorize::core
use std::math::sqrt as math_sqrt
use std::io::{println, read}
export { Point, distance }

type Scalar = f64
opaque type Handle<T>

form Point<T> where T: Copy {
    x: T,
    y: T,
}

pick Color {
    case Red,
    case Green,
    case Blue(u8),
}

trait Norm<T> where T: Copy {
    proc norm(self) -> T;
}

impl Point<f64> {
    proc norm(self) -> f64 {
        let sum = self.x * self.x + self.y * self.y;
        return math_sqrt(sum);
    }
}

proc distance<T>(left: Point<T>, right: Point<T>) -> T where T: Copy {
    let dx = left.x - right.x;
    let dy = left.y - right.y;
    return dx * dx + dy * dy;
}

proc describe(color: Color) -> string {
    match color {
        case Color::Blue(value) => return "blue";
        case Color::Red => return "red";
        else => return "green";
    }
}

proc main() -> int {
    let mut value: i32 = 0;
    while value < 3 and not false {
        print("value");
        set value += 1;
    }
    let point = Point<f64> { x: 3.0, y: 4.0 };
    let answer = point.norm();
    if answer > 0.0 {
        println(describe(Color::Blue(1)));
    } else {
        return 1;
    }
    return 0;
}
